    <div class="printButtonClass"
        style="position: fixed; top: 10px; font-size: 11px; z-index: 1000000000000000; right: 5px; width: auto;">
        Government Property Not For Sale</div>

    <!--title-->
    <img class="printButtonClass" id="bg" src="../img/bg_n.png" height="100%" align="top" />
    <!--watermark-->

    <style>
        .atcNames {
            font-weight: bold;
        }

        tr.atc td {
            border-bottom: 1px #e1e1e1 solid;
        }

        tr.atc:hover td {
            background: #FFC;
        }

        td.atc {
            padding: 4px;
        }

        #header,
        .menu {
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            height: 25px;
            background: #fefefe;
            white-space: nowrap;
