            border: 1px #ccc solid;
            visibility: hidden;
            z-index: 3000;
        }

        .menu {
            visibility: visible;
        }

        #header input {
            background: none;
            border: none;
            pointer: cursor;
            font-weight: bolder;
            height: 25px;
