                                allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
                                p3TPZip = elem[i].value;
                            }
                            else if (elem[i].id == 'frm2000:txtOtherName') {
                                allXML += "<div>"+elem[i].id+"=" +escape(elem[i].value);
                            }
                            else if (elem[i].id == 'frm2000:txtOtherName2') {
                                allXML += escape(elem[i].value)+"frm2000:txtOtherName=</div>"+tab;
                            }
                            //set page to 1
                            else if (elem[i].id == 'frm2000:txtCurrentPage') {
                                allXML += "<div>" + elem[i].id + "=" + "1" + elem[i].id + "=</div>" + tab;
                            }
