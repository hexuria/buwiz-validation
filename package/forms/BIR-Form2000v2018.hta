    /*----------Computation----------*/

   function computeTax15D() {
    var tax15A = NumWithComma(d.getElementById("frm2000:txtTax15A").value) * 1;
    var tax15B = NumWithComma(d.getElementById("frm2000:txtTax15B").value) * 1;
    var tax15C = NumWithComma(d.getElementById("frm2000:txtTax15C").value) * 1;
    var tax15D = tax15A + tax15B + tax15C;
    
    d.getElementById("frm2000:txtTax15D").value = formatCurrency(tax15D);
    
    computeTax16(); // Calculate item 16 based on updated tax15D value
}

function computeTax16() {
    var constructiveAffixture = NumWithComma(d.getElementById("frm2000:txtTax14").value) * 1;
    var edst = NumWithComma(d.getElementById("frm2000:txtTax15A").value) * 1;
    var loosestamps = NumWithComma(d.getElementById("frm2000:txtTax15B").value) * 1;
    var otherContributions = NumWithComma(d.getElementById("frm2000:txtTax15C").value) * 1;
    
    var modeOfAffixture = getSelectedModeOfAffixture(); // Get selected mode of affixture
    
    var item16Value = 0;

    // Calculate item 16 based on conditions
    if (modeOfAffixture === "frm2000:optMode_2") {
        // For optMode_2, ensure positive value for item 16
        item16Value = Math.max(constructiveAffixture - (edst + loosestamps), 0);
    } else {
        // For optMode_1 and optMode_3, ensure negative value for item 16 if needed
        item16Value = constructiveAffixture - edst - loosestamps - otherContributions;
        if (item16Value > 0) {
            item16Value = -item16Value; // Make it negative if it's positive
        }
    }

    d.getElementById("frm2000:txtTax16").value = formatCurrency(item16Value);
    
    computeTotalAmtPayable();
}

function getSelectedModeOfAffixture() {
    var modes = document.getElementsByName("frm2000:optMode");
    for (var i = 0; i < modes.length; i++) {
        if (modes[i].checked) {
            return modes[i].id;
        }
    }
    return ""; // Return default if no mode is selected (though should be handled in UI)
}


    function computePenalties()
    {        
        d.getElementById("frm2000:txtTax17D").value = formatCurrency(NumWithComma(d.getElementById("frm2000:txtTax17A").value)*1 + NumWithComma(d.getElementById("frm2000:txtTax17B").value)*1 + NumWithComma(d.getElementById("frm2000:txtTax17C").value)*1);
        computeTotalAmtPayable();
    }

    function computeTotalAmtPayable() {
        d.getElementById("frm2000:txtTax18").value = formatCurrency(NumWithComma(d.getElementById("frm2000:txtTax16").value)*1 + NumWithComma(d.getElementById("frm2000:txtTax17D").value)*1);
    }

   function newRate(i) {
    switch (d.getElementById('drpATCCode' + i).value) {
         case "DS106":
				 d.getElementById("frm2000:numOfDays").value = 0;
				d.getElementById("frm2000:cmdValidate").disabled = true;
                d.getElementById("btnSave").disabled = true;
                $('#ds106modal').show('fade');
				d.getElementById("frm2000:rowLocation").value=i;
			    break;
        
        case "DS130":
            d.getElementById("frm2000:numOfMonths").value = 0;
            d.getElementById("frm2000:cmdValidate").disabled = true;
            d.getElementById('frm2000:sched1:txtTaxDue'+i).value= "0.00";
            d.getElementById("frm2000:sched1:txtTaxRate"+i).value = "1ST 6 MONTHS P,1000 IN EXCESS + P100";
            d.getElementById("btnSave").disabled = true;
            $('#ds130modal').show('fade');
            d.getElementById("frm2000:rowLocation").value = i;
            break;

        case "DS131":
            d.getElementById("frm2000:numOfMonths").value = 0;
            d.getElementById("frm2000:cmdValidate").disabled = true;
            d.getElementById('frm2000:sched1:txtTaxDue'+i).value= "0.00";
            d.getElementById("frm2000:sched1:txtTaxRate"+i).value = "1ST 6 MONTHS P,2000 IN EXCESS + P200";
            d.getElementById("btnSave").disabled = true;
            $('#ds131modal').show('fade');
            d.getElementById("frm2000:rowLocation").value = i;
            break;

case "DS132":
            d.getElementById("frm2000:numOfMonths").value = 0;
            d.getElementById("frm2000:cmdValidate").disabled = true;
            d.getElementById('frm2000:sched1:txtTaxDue'+i).value= "0.00";
            d.getElementById("frm2000:sched1:txtTaxRate"+i).value = "1ST 6 MONTHS P,3000 IN EXCESS + P300";
            d.getElementById("btnSave").disabled = true;
            $('#ds132modal').show('fade');
            d.getElementById("frm2000:rowLocation").value = i;
            break;

        default:
            break;
    }
}



