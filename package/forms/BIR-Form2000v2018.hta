function ds130CloseModal() {
    var j = d.getElementById("frm2000:rowLocation").value;

    if (d.getElementById('ds130modYes').checked || d.getElementById('ds130modNo').checked) {
        d.getElementById('frm2000:numOfMonths').style.display = "inline";
        d.getElementById('frm2000:modLabel').style.display = "inline";
        d.getElementById('frm2000:btnClose').style.display = "inline";

        if (d.getElementById('ds130modYes').checked && d.getElementById('frm2000:numOfMonths').value > 0) {
            var newds130rate = "P1.5/200 * " + d.getElementById('frm2000:numOfMonths').value + "/12 months";
            d.getElementById('frm2000:sched1:txtTaxRate' + j).value = newds130rate;
        }

        $('#ds130modal').hide('fade');

        d.getElementById("frm2000:cmdValidate").disabled = false;
        d.getElementById("btnSave").disabled = false;

        computeSched1TaxDue(j);
    } else if (d.getElementById('ds130modNo').checked) {
        d.getElementById('frm2000:numOfMonths').style.display = "inline"; // Ensure the input is visible
        d.getElementById('frm2000:modLabel').style.display = "inline";
        d.getElementById('frm2000:btnClose').style.display = "inline";
        d.getElementById("frm2000:numOfMonths").disabled = false; // Enable the input field

        $('#ds130modal').hide('fade');

        d.getElementById("frm2000:cmdValidate").disabled = false;
        d.getElementById("btnSave").disabled = false;

        computeSched1TaxDue(j);
    } else if (d.getElementById('ds130modYes').checked && d.getElementById('frm2000:numOfMonths').value == 0) {
        alert("Number of months should be from 1 to 12 only.");
    } else {
        alert("Please select an option.");
    }
}


