 function ds130InputMonths() {
    var numOfMonthsInput130 = d.getElementById('frm2000:numOfMonths');
    var ds130modNoChecked = d.getElementById('ds130modNo').checked; // Check if "No" option is checked
    var numOfMonths = parseInt(numOfMonthsInput130.value);
  

    if (ds130modNoChecked) {
        numOfMonthsInput130.disabled = false; // Keep the input field enabled if "No" is selected
    }

    if (numOfMonths <= 0 || numOfMonths > 12) {
        alert("Number of months should be from 1 to 12 only.");
        numOfMonthsInput130.value = ""; // Clear invalid input
        numOfMonthsInput130.focus(); // Set focus back to the input field
    }
}


