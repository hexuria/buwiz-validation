                                p3TotalAmountPayable = elem[i].value;
                            } else if (elem[i].id == 'frm2000:txtTIN1') {
                                allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
                                p3TPTIN1 = elem[i].value;
                            } else if (elem[i].id == 'frm2000:txtTIN2') {
                                allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
                                p3TPTIN2 = elem[i].value;
                            } else if (elem[i].id == 'frm2000:txtTIN3') {
                                allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
                                p3TPTIN3 = elem[i].value;
                            } else if (elem[i].id == 'frm2000:txtBranchCode') {
                                allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
                                p3TPBranchCode = elem[i].value;
                            } else if (elem[i].id == 'frm2000:txtRDOCode') {
                                allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
                                p3TPRDOCode = elem[i].value;
                            } 
                            /*else if (elem[i].id == 'frm2000:txtLineBus') {
                                p3TPLineBus = escape(elem[i].value);
                            } else if (elem[i].id == 'frm2000:txtTaxpayerName') {
                                p3TPName = escape(elem[i].value);
                            }*/
                            else if (elem[i].id == 'frm2000:txtTelNum') {
                                allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
                                p3TPTelNum = elem[i].value;
                            } 
                            /*else if (elem[i].id == 'frm2000:txtAddress') {
                                p3TPAddress = escape(elem[i].value);
                            }*/
