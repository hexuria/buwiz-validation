        // PART 2, ITEM 19 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeIncomeTaxDueNo19a(){
            var isSpecial       = document.getElementById('frm1701MS:txtTaxpayerNo12e');
            var isExempt        = document.getElementById('frm1701MS:txtTaxpayerNo12d');
            var valPart4Item17  = document.getElementById('frm1701MS:txtTaxDueSpeciala');
            var valPart4Item18A = document.getElementById('frm1701MS:TotalTaxDueCompensationATP');
            var valPart2Item19  = document.getElementById('frm1701MS:txtIncomeTaxDueNo19a');

            if (isSpecial.checked) {
                valPart2Item19.value = formatCurrencyWithComma(NumWithComma(valPart4Item17.value)) ;
            } else if (isExempt.checked) {
                valPart2Item19.value = formatCurrencyWithComma(0);
            } else {
                valPart2Item19.value = formatCurrencyWithComma(NumWithComma(valPart4Item18A.value));
            }

            toggleShareOfOtherNo20a();
            calculateSpecialRateNo21a();

        }
        
        //enable disable item 20a
        function toggleShareOfOtherNo20a() 
        {
            
            var valP2I19 = NumWithComma(document.getElementById('frm1701MS:txtIncomeTaxDueNo19a').value);
            valP2I19 = Number(valP2I19);
                
            if (isNaN(valP2I19) || valP2I19 <= 0) {
                document.getElementById('frm1701MS:txtShareOfOtherNo20a').disabled = true;
                document.getElementById('frm1701MS:txtShareOfOtherNo20a').value = "0";
            } else {
                document.getElementById('frm1701MS:txtShareOfOtherNo20a').disabled = false;
            }

        }

        function computeIncomeTaxDueNo19b(){
            var isSpecial       = document.getElementById('frm1701MS:txtTaxpayerNo12e1');
            var isExempt        = document.getElementById('frm1701MS:txtTaxpayerNo12d1');
            var valPart4Item17  = document.getElementById('frm1701MS:txtTaxDueSpecialb');
            var valPart4Item18A = document.getElementById('frm1701MS:TotalTaxDueCompensationASP');
            var valPart2Item19  = document.getElementById('frm1701MS:txtIncomeTaxDueNo19b');

            if (isSpecial.checked) {
                valPart2Item19.value = formatCurrencyWithComma(NumWithComma(valPart4Item17.value));
            } else if (isExempt.checked) {
                valPart2Item19.value = formatCurrencyWithComma(0);
            } else {
                valPart2Item19.value = formatCurrencyWithComma(NumWithComma(valPart4Item18A.value));
            }
            
            toggleShareOfOtherNo20b() ;
            calculateSpecialRateNo21b();


        }

        //enable disable item 20b
        function toggleShareOfOtherNo20b() 
        {
            var valP2I19 = NumWithComma(document.getElementById('frm1701MS:txtIncomeTaxDueNo19b').value);
            valP2I19 = Number(valP2I19);

            if (isNaN(valP2I19) || valP2I19 <= 0) {
                document.getElementById('frm1701MS:txtShareOfOtherNo20b').disabled = true;
                document.getElementById('frm1701MS:txtShareOfOtherNo20b').value = "0";
            } else {
                document.getElementById('frm1701MS:txtShareOfOtherNo20b').disabled = false;
            }

        }

        // PART 2, ITEM 21 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function calculateSpecialRateNo21a() {

            var valueOfItem21 = document.getElementById('frm1701MS:txtNetSpecialRateNo21a');
            var valueOfItem19 = document.getElementById('frm1701MS:txtIncomeTaxDueNo19a');
            var valueOfItem20 = document.getElementById('frm1701MS:txtShareOfOtherNo20a');

            valueOfItem21.value = formatCurrencyWithComma(NumWithComma(valueOfItem19.value) - NumWithComma(valueOfItem20.value));

            computeP2No23TP();
        }

        function calculateSpecialRateNo21b() {
            var el = document.getElementById;

            var valueOfItem21 = document.getElementById('frm1701MS:txtNetSpecialRateNo21b');
            var valueOfItem19 = document.getElementById('frm1701MS:txtIncomeTaxDueNo19b');
            var valueOfItem20 = document.getElementById('frm1701MS:txtShareOfOtherNo20b');

            valueOfItem21.value = formatCurrencyWithComma(NumWithComma(valueOfItem19.value) - NumWithComma(valueOfItem20.value));

            computeP2No23SP();
        }

        // PART 2, ITEM 22 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeP2No22TP() {

            var isExempt           = document.getElementById('frm1701MS:txtTaxpayerNo12d');
            var isSpecial          = document.getElementById('frm1701MS:txtTaxpayerNo12e');
            var isGraduated        = document.getElementById('frm1701MS:txtTaxpayerNo12b');

            var valuePart2Item22   = document.getElementById('frm1701MS:txtIncomeTaxRegularNo22a');

            var valuePart4Item4    = document.getElementById('frm1701MS:txtTaxpayerNo4a');
            var valuePart4Item18B  = document.getElementById('frm1701MS:TotalTaxDueCompensationBTP');
            
            if (isExempt.checked || isSpecial.checked) {
                valuePart2Item22.value = formatCurrencyWithComma(stringToNum(valuePart4Item4.value));
            } 
            
            if (isGraduated.checked) {
                valuePart2Item22.value = formatCurrencyWithComma(stringToNum(valuePart4Item18B.value));
            }

            computeP2No23TP();
        }

        function computeP2No22SP() {

            var isCompensationIncome = document.getElementById('frm1701MS:txtTaxpayerNo11d1');

            var isExempt     = document.getElementById('frm1701MS:txtTaxpayerNo12d1');
            var isSpecial    = document.getElementById('frm1701MS:txtTaxpayerNo12e1');
            var isGraduated = document.getElementById('frm1701MS:txtTaxpayerNo12b1');

            var valuePart2Item22   = document.getElementById('frm1701MS:txtIncomeTaxRegularNo22b');

            var valuePart4Item3    = document.getElementById('frm1701MS:txtTaxableCompensationIncomeb');
            var valuePart4Item4    = document.getElementById('frm1701MS:txtTaxpayerNo4b');
            var valuePart4Item18B  = document.getElementById('frm1701MS:TotalTaxDueCompensationBSP');

            if (isExempt.checked || isSpecial.checked) {
                valuePart2Item22.value = formatCurrencyWithComma(stringToNum(valuePart4Item4.value));
            } 
            
            if (isGraduated.checked) {
                valuePart2Item22.value = formatCurrencyWithComma(stringToNum(valuePart4Item18B.value));
            }

            // If Compensation Income is selected
            if (isCompensationIncome.checked && isGraduated.checked) {
                valuePart2Item22.value = formatCurrencyWithComma(stringToNum(valuePart4Item4.value));
            }
            
            computeP2No23SP();
        }

        // PART 2, ITEM 23 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeP2No23TP() {
            // document.getElementById('frm1701MS:txtTotalIncomeTaxDueNo23a123').value = formatCurrencyWithComma(123123);
            document.getElementById('frm1701MS:txtTotalIncomeTaxDueNo23a').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtNetSpecialRateNo21a').value) +
                NumWithComma(document.getElementById('frm1701MS:txtIncomeTaxRegularNo22a').value));
            computeP2No25TP();
        }

