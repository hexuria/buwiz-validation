        // CALCULATE PART V
        function computeCreditsPaymentsPartVNo10a() {
        var total = (NumWithComma(document.getElementById('frm1701MS:txtPriorYearsNo1a').value) || 0) +
        (NumWithComma(document.getElementById('frm1701MS:txtTaxPaymentsNo2a').value) || 0) + (NumWithComma(document.getElementById('frm1701MS:txtCreditableTaxNo3a').value) || 0) +
        (NumWithComma(document.getElementById('frm1701MS:txtCreditableFourthQuarterNo4a').value) || 0) + (NumWithComma(document.getElementById('frm1701MS:txtCreditableForm2316No5a').value) || 0) +
        (NumWithComma(document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6a').value) || 0) + (NumWithComma(document.getElementById('frm1701MS:txtForeignTaxCreditsNo7a').value) || 0) +
        (NumWithComma(document.getElementById('frm1701MS:txtSpecialTaxCreditsNo8a').value) || 0) + (NumWithComma(document.getElementById('frm1701MS:txtOtherCreditsPaymentsNo9a').value) || 0);
        
        document.getElementById('frm1701MS:txtTotalTaxCreditsPaymentsPartVNo10a').value = formatCurrencyWithComma(total);
        computeP2No24TP();
        }


        function computeCreditsPaymentsPartVNo10b() {
        var total = (NumWithComma(document.getElementById('frm1701MS:txtPriorYearsNo1b').value) || 0) +
        (NumWithComma(document.getElementById('frm1701MS:txtTaxPaymentsNo2b').value) || 0) + (NumWithComma(document.getElementById('frm1701MS:txtCreditableTaxNo3b').value) || 0) +
        (NumWithComma(document.getElementById('frm1701MS:txtCreditableFourthQuarterNo4b').value) || 0) + (NumWithComma(document.getElementById('frm1701MS:txtCreditableForm2316No5b').value) || 0) +
        (NumWithComma(document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6b').value) || 0) + (NumWithComma(document.getElementById('frm1701MS:txtForeignTaxCreditsNo7b').value) || 0) +
        (NumWithComma(document.getElementById('frm1701MS:txtSpecialTaxCreditsNo8b').value) || 0) + (NumWithComma(document.getElementById('frm1701MS:txtOtherCreditsPaymentsNo9b').value) || 0);
        
        document.getElementById('frm1701MS:txtTotalTaxCreditsPaymentsPartVNo10b').value = formatCurrencyWithComma(total);
        computeP2No24SP();
        }

        // TAXPAYER ATC
        function creditableTaxWithheldForm2316() {
            var selectedTaxCode = document.getElementById('taxCodeDropdown').value;

            // --- Form 2316 fields (5a) ---
            if (selectedTaxCode === 'II013' || selectedTaxCode === 'II011') {

                // Part 4B2 - Disabled
                setFieldTPPart4B2Enabled(false);

                // Part 5 Item 5 - Enabled
                document.getElementById('frm1701MS:txtCreditableForm2316No5a').disabled = false;
            }

            // --- ENABLE LINK ONLY for II015, II017 ---
            else if (selectedTaxCode === 'II015' || selectedTaxCode === 'II017') {

                // Part 4B2 - Enabled
                setFieldTPPart4B2Enabled(true);

                // --- DEFAULT FOR ITEM 22 ---
                document.getElementById('frm1701MS:txtLess22A').value = formatCurrencyWithComma('250000');
                document.getElementById('frm1701MS:txtLess22A').disabled = true;

                // Part 5 Item 5 - Disabled
                document.getElementById('frm1701MS:txtCreditableForm2316No5a').disabled = true;

                totalTaxDueCompensationAndBusinessIncome25TP();
            }

            else if (selectedTaxCode === 'II016') {
                
                // Part 4B2 - Enabled
                setFieldTPPart4B2Enabled(true);

                // NOT editable for II016
                document.getElementById('frm1701MS:txtLess22A').disabled = true;

                // Part 5 Item 5 - Disabled
                document.getElementById('frm1701MS:txtCreditableForm2316No5a').disabled = true;
            }

            else if (selectedTaxCode === 'II012' || selectedTaxCode === 'II014') {
                
                // Part 4B2 - Disabled
                setFieldTPPart4B2Enabled(false);

                // Part 5 Item 5 - Disabled
                document.getElementById('frm1701MS:txtCreditableForm2316No5a').disabled = true;
            }
        }

