        // Function to refresh the table for the spouse
        function refreshTableSched410A() {
        $('#tbodySched410A').html(""); // Clear existing rows

        for (var i = 0; i < specifyToCommit10A.length; i++) {
            $('#tbodySched410A').append(
                "<tr>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px'>10A." + (i + 1) + "</td>" +
                "<td width='50%' style='border: 1px solid black; padding: 2px'>" +
                    "<input type='text' id='frm1701MS:sched410A:Description" + i + "' style='width: 450px;' " +
                    "value='" + (specifyToCommit10A[i].txtSpecifySched410ADescription || '') + "' maxlength='50'>" +
                "</td>" +
                "<td width='30%' style='border: 1px solid black; padding: 2px'>" +
                    "<input type='text' id='frm1701MS:sched410A:Amount" + i + "' style='width: 150px; text-align: right;' " +
                    "value='" + (specifyToCommit10A[i].txtSpecifySched410AAmount || '0') + "' onblur='removeDecimal(this); updateSpecifyToCommit10A(" + i + "); computeOtherSched410A();' onkeydown='if(event.keyCode==13){removeDecimal(this); updateSpecifyToCommit10A(" + i + "); computeOtherSched410A();}' onkeypress='return wholenumber(this, event)' " +
                    "maxlength='25'>" +
                "</td>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px'>" +
                    "<button id='deleteIdSpouse" + i + "' onclick='deleteRowSched410A(" + i + ")' style='padding: 2px'>Remove</button>" +
                "</td>" +
                "</tr>"
            );
        }

        computeOtherSched410A(); 
        }
        function savingSched410A() {

            var tableBody = document.getElementById('tbodySched410A');
            var rows = tableBody.getElementsByTagName('tr');
            var specifyToCommit410A = [];
            var specifyToCommit410ASpouse = [];
            var count = 0;

            function manualTrim(str) {
                return str.replace(/^\s+|\s+$/g, '');
            }

            for (var i = 0; i < rows.length; i++) {
                var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
                var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

                var description = manualTrim(descriptionInput.value);
                var amount = manualTrim(amountInput.value);

                if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                    count += 1; // Increment count for invalid rows
                } else {
                    specifyToCommit410A && specifyToCommit410ASpouse .push({
                        txtSpecifySched410ADescription: description,
                        txtSpecifySched410AAmount: Math.round(parseFloat(amount))
                    });
                }
            }  
            alert('Data has been saved successfully!');
            document.getElementById('frm1701MS:txtAllowableItemizedDeductionsNo10a').readOnly = true;
            
            totalTaxDue18ATP();
            totalTaxDue18BTP();

        }

        function cancelSched410A() {
            // Function to manually trim whitespace
            function manualTrim(str) {
                return str.replace(/^\s+|\s+$/g, '');
            }

            // Get the table body element
            var tableBody = document.getElementById('tbodySched410A');
            if (!tableBody) {
                alert("Table body element not found.");
                return;
            }

            var rows = tableBody.getElementsByTagName('tr');
            var specifyToCommit410A = [];
                var specifyToCommit410ASpouse = [];
            var count = 0;

            // Iterate over each row in the table body
            for (var i = 0; i < rows.length; i++) {
                // Skip empty rows or rows that don't have the correct structure
                if (rows[i].cells.length < 3) continue;

                var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
                var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

                if (!descriptionInput || !amountInput) {
                    alert("Input elements not found in row " + i);
                    continue;
                }

                var description = manualTrim(descriptionInput.value);
                var amount = manualTrim(amountInput.value);

                // Validate the inputs
                if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                    count += 1; // Increment count for invalid rows
                } else {
                    // Add valid rows to specifyToCommit array
                    specifyToCommit410A && specifyToCommit410ASpouse.push({
                        txtSpecifySched410ADescription: description,
                        txtSpecifySched410AAmount: Math.round(parseFloat(amount))
                        
                    });
                }
                deleteAllRow410A();
            }

        }
        function saveAndCloseSched410A() {
            function manualTrim(str) {
                return str.replace(/^\s+|\s+$/g, '');
            }

            var tableBody = document.getElementById('tbodySched410A');
            var rows = tableBody.getElementsByTagName('tr');
            var specifyToCommit410A = [];
            var specifyToCommit410ASpouse = [];
            var count = 0;

            for (var i = 0; i < rows.length; i++) {
                if (rows[i].cells.length < 3) continue;

                var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
                var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

                var description = manualTrim(descriptionInput.value);
                var amount = manualTrim(amountInput.value);

                if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                    count += 1; // Increment count for invalid rows
                } else {
                    specifyToCommit410A && specifyToCommit410ASpouse.push({
                        txtSpecifySched410ADescription: description,
                        txtSpecifySched410AAmount: Math.round(parseFloat(amount))
                    });
                }
            }

            if (count === 0) {
                alert('Data has been saved successfully!');

                closeModalSched410A();
            } else {
                alert('Please fill up all required fields and ensure amounts are greater than zero.');
            }

            document.getElementById('frm1701MS:txtAllowableItemizedDeductionsNo10a').readOnly = true;

            totalTaxDue18ATP();
            totalTaxDue18BTP();     

        }


        // Function to update specifyToCommit array for the spouse
        function updateSpecifyToCommit10A(index) {
        var description = document.getElementById('frm1701MS:sched410A:Description' + index).value;
        var amount = document.getElementById('frm1701MS:sched410A:Amount' + index).value;
        specifyToCommit10A[index].txtSpecifySched410ADescription = description;
        specifyToCommit10A[index].txtSpecifySched410AAmount = Math.round(parseFloat(amount) || 0);
        }


