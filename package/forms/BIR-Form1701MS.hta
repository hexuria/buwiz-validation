        // COMPUTE SCHED 5 No9 (Taxpayer Subtotal)
        function computeOtherSpecify() {

        var totalTaxpayer = 0;
        for (var i = 0; i < specifyToCommitSched5No9.length; i++) {
            totalTaxpayer += NumWithComma(document.getElementById('frm1701MS:sched5No9:Amount' + i).value);
        }

        // Update the Taxpayer subtotal field
        document.getElementById('resultOtherSpecifyTaxpayer').value = formatCurrencyWithComma(totalTaxpayer);
        document.getElementById('frm1701MS:txtOtherCreditsPaymentsNo9a').value = formatCurrencyWithComma(totalTaxpayer);
        document.getElementById('frm1701MS:txtTotalTaxCreditsPaymentsPartVNo10a').value = formatCurrencyWithComma(totalTaxpayer);

        }

        // COMPUTE SCHED 5 No9 (Spouse Subtotal)
        function computeOtherSpecifySpouse() {
        var totalSpouse = 0;
        for (var i = 0; i < specifyToCommitSched5No9.length; i++) {
            totalSpouse += NumWithComma(document.getElementById('frm1701MS:sched5No9:Spouse' + i).value);
        }
        // Update the Spouse subtotal field
        document.getElementById('resultOtherSpecifySpouse').value = formatCurrencyWithComma(totalSpouse);
        document.getElementById('frm1701MS:txtOtherCreditsPaymentsNo9b').value = formatCurrencyWithComma(totalSpouse);
        document.getElementById('frm1701MS:txtTotalTaxCreditsPaymentsPartVNo10b').value = formatCurrencyWithComma(totalSpouse);
        }

        // Helper function to format currency with commas
        function formatCurrencyWithComma(amount) {
        if (isNaN(amount)) return '0';
        return amount.replace(/\d(?=(\d{3})+\.)/g, '$&,');  // Format with commas and two decimal places
        }

        // Helper function to format numbers with commas for input fields
        function formatCurrencyWithComma(amount) {
        return amount.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

