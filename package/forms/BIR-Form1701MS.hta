                document.getElementById('frm1701MS:txtCreditableForm2316No5b').disabled = true;
            }
        }

        // CALCULATE PART VI
        function computeRegularIncomeTax(taxableIncome) {

            var B1 = 250000;
            var B2 = 400000;
            var B3 = 800000;
            var B4 = 2000000;
            var B5 = 8000000;

            var taxDue = 0;

            if (taxableIncome <= B1) {
                taxDue = 0;
            } else if (taxableIncome <= B2) {
                taxDue = 0.15 * (taxableIncome - B1);
            } else if (taxableIncome <= B3) {
                taxDue = 22500 + (0.20 * (taxableIncome - B2));
            } else if (taxableIncome <= B4) {
                taxDue = 102500 + (0.25 * (taxableIncome - B3));
            } else if (taxableIncome <= B5) {
                taxDue = 402500 + (0.30 * (taxableIncome - B4));
            } else {
                taxDue = 2202500 + (0.35 * (taxableIncome - B5));
            }

            return taxDue;
        }

