        // FUNCTION SLEEP time
        function sleeptime() {
            isReload = true;
            init();

            var bgFileName = qs('xmlBGInfoFileName');
            if (bgFileName != null && bgFileName.indexOf('.xml') > -1) 
            {
                loadBGXML(bgFileName);
            }

            fileName = qs('xmlFileName');
            if (fileName != null && fileName.indexOf('.xml') > -1) 
            {
                var tin = fileName.split("/")[1].split("-");
                loadBGXML("profile/" + tin[0] + ".xml");
                loadXML(fileName);

                existingXMLFileName = fileName;
                if (gIsReadOnly) 
                {
                    window.setTimeout("disableAllElementIDs(); d.getElementById('frm1701MS:btnFinalCopy').disabled = false; d.getElementById('frm1701MS:btnNextPage').disabled = false; d.getElementById('frm1701MS:btnPrevPage').disabled = false;", 1000);
                }
            } 
            else
            {
                window.setTimeout("$('#loader').hide('blind');", 100);
            }

            if ($('#printMenu').css('display') != 'none') {
                $('#printMenu').hide('blind');
            }

            document.getElementById('frm1701MS:txtPg1TIN1').disabled = true; 
            document.getElementById('frm1701MS:txtPg1TIN2').disabled = true; 
            document.getElementById('frm1701MS:txtPg1TIN3').disabled = true; 
            document.getElementById('frm1701MS:txtPg1BranchCode').disabled = true;
        }

