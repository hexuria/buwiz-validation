        // Final Copy Button:
        function openAlertEmail() {


            var tinNumber = $('#frm1701MS\\:txtPg1TIN1').val() + $('#frm1701MS\\:txtPg1TIN2').val() + $('#frm1701MS\\:txtPg1TIN3').val();
            conService.initConConfig(tinNumber, '1701MS');

            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFileNameValidate = "";

            if (document.getElementById('txtFinalFlag').value == '2') {
                reSendEmail();
                return;
            }

            var xmlFileName = createXMLFileName("savefile/");
            var isFileExists = doesFileExists(xmlFileName);
            var isAmendedReturn = isItAnAmendedReturn();

            if (isAmendedReturn == false) {

                if (xmlFileName.indexOf('V') == -1) 
                {
                    xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/') + 1, xmlFileName.indexOf('.xml'));
                } 
                else 
                {
                    xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/') + 1, xmlFileName.indexOf('V'));
                }

                var hasVersion = false;
                var objEnum = new Enumerator(fileSys.GetFolder("savefile/").Files);
                
                for (i = 0; !objEnum.atEnd(); objEnum.moveNext()) 
                {
                    if (objEnum.item().name.indexOf(xmlFileNameValidate) > -1 && objEnum.item().name.indexOf("V") > -1) 
                    {
                        hasVersion = true;
                    }
                }

                if (hasVersion) 
                {
                    if (!onExit)
                    alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save'or 'Final Copy' or 'Submit'.");
                    return false;
                }
            }

            if (isFileExists) 
            {
                isAFinalCopy = isItAFinalCopy(xmlFileName); if (document.getElementById('txtFinalFlag').value == '2') 
                { 
                    isAFinalCopy = false; 
                }
            }

            if (isFileExists && isAFinalCopy && isAmendedReturn == false && document.getElementById('txtFinalFlag').value != '3') 
            {
                alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'."); ShowContainer('container');
                return false;
            }

            else {
                if (confirm("Please ensure that you have INTERNET access and a VALID email address is indicated in your tax return.\n\n" + 
                    "Are you sure you want to submit?") === true) 
                {
                    if (checkNetConnection() === true) 
                    {
                        HideContainer("container"); 
                        if (document.getElementById('txtFinalFlag').value == "3") 
                        { 
                            
                            document.getElementById('txtFinalFlag').value = "2" 
                        } 
                        else 
                        { 
                            
                            document.getElementById('txtFinalFlag').value = "0" 
                        }; 
            
                        ShowContainer("ebirEnroll");
                    }
                    else 
                    {
                    
                        alert("The system detected that you have no internet connection.\nPlease contact your internet service provider."); 
                        document.getElementById('txtFinalFlag').value = "3"; 
                        saveEncryptedProfile(); 
                        checkFinalCopyBtn('1701MS');
                        ShowContainer('container');
                    }
                }
            }
        }

        function sendEmail(sourceElement) {


            var isRegisteredTP = (sourceElement.id !== "ebirOnlineConfirmSubmit") ? "N" : "Y"; if (isRegisteredTP == "Y" && (ValidateConfirm() == false)) { return; }
            var isAutoEnroll = (sourceElement.id == "ebirEnrollYes") ? "Y" : "N";
            
            if (isAutoEnroll == "Y") 
            {
                document.getElementById("txtEnroll").value = "Y";
            }

            document.getElementById("ebirOnlineSecret").value = document.getElementById("ebirOnlinePassword").value;
            var emailFilePath = saveEncryptedProfile(true);

            var dateSubmitted = new Date();

            var tpRDOCode = document.getElementById('frm1701MS:txtRDOCode').value;
            var formType = "1701MS";

            var tpTIN = document.getElementById('frm1701MS:txtPg1TIN1').value + document.getElementById('frm1701MS:txtPg1TIN2').value + document.getElementById('frm1701MS:txtPg1TIN3').value + document.getElementById('frm1701MS:txtPg1BranchCode').value;

            var tpMonth = document.getElementById('frm1701MS:txtMonthNo1').value;
            var tpYear = document.getElementById('frm1701MS:txtYearNo1').value;

            var fileNameEmail = emailFilePath.substring(emailFilePath.lastIndexOf("\\") + 1, emailFilePath.length);
            var versionNumber = fileNameEmail.lastIndexOf("V") > -1 ? fileNameEmail.substring(fileNameEmail.lastIndexOf("V"), fileNameEmail.lastIndexOf(".")) : "";
            
            var emailTaxPayer = document.getElementById('frm1701MS:txtEmaila').value;
            var emailSubject = tpRDOCode + "_" + formType + "_" + tpTIN + "_" + tpMonth + tpYear + versionNumber;

            var emailBody = "Received Email subject to validation of BIR. <br> With attachment '" + fileNameEmail + "' <br> Date and time submitted: " + dateSubmitted +
                " <br><br> TIN: " + tpTIN +
                " <br> Name: " + document.getElementById("frm1701MS:txtTaxpayerNo8a").value +
                " <br> Tax Type: Income Tax" +
                " <br> Form Type: " + formType +
                " <br> Return Period: " + tpMonth + "/" + tpYear +
                " <br> <br> Penalties may be imposed for any violation to the provisions of the NIRC and issuances thereof." +
                " <br> <br> FOR RETURNS WITH PAYMENT" +
                " <br> Please print the said email together with the Income Tax Return and then Proceed to Pay in the Authorized Agent Bank / Collection Agent under RDO where registered following existing issuances.";
            
            // Display loader to show that an email is being sent
            $('#loader').css('background', 'transparent'); disableDropDown("before");
            $('#loader').show('blind');

            try
            {
                var ftpFolder = enviService.getFtpFolder('1701MS');
                var wsData = conService.getConConfig();
                var returnCode = RenameAndSendFile(emailFilePath, emailTaxPayer, ftpFolder, wsData.mode, wsData.srv, wsData.sslport, wsData.port, wsData.usr, wsData.pass); clearFileNameWOemail();

                $('#container').hide();
                if (returnCode == 0) {
                    document.getElementById('txtFinalFlag').value = "1"; 
                        document.getElementById('txtFinalFlag').value = "1";updateFinalFlagOnSaveFile(fileNameEmail);alert("Submit Successful. Subject to validation by BIR.\n\n" +      "A notification will be sent to your email (" + emailTaxPayer + "). Please print or save the email as an evidence of efiled return.\n\n" +      "Note: There will be some delays on email sending of confirmation, please bear with us.\n\n" +      "In case of delay or non-receipt of system generated email confirmation from eBirforms, please check on the following possible reasons:\n\n" +      "1. Invalid email address / Inactive email account\n" +      "2. Email account quota exceeded\n" +      "3. Email confirmation is diverted to Spam and/or Junk emails folder\n" +      "4. Company firewall policy restricts receipt of email from ebirforms-noreply@bir.gov.ph");
                    $('#paymentOption').show();
                    $('#paymentOptionCloseBtn').on('click', function () {
                        $('#paymentOption').hide();
                        $('#container').show();
                    });
                }
                else {
                    document.getElementById('txtFinalFlag').value = "2"; 
                    alert('Your Tax Return was not submitted online due to any of the \n following reasons that may interrupt the submission process: \n - No internet connection \n - Slow internet connection \n - Overly restrictive firewall');
                    $('#container').show();
                }
            }
            catch(e) 
            {
                document.getElementById('txtFinalFlag').value = "2"; 
                alert('Your Tax Return was not submitted online due to any of the \n following reasons that may interrupt the submission process: \n - No internet connection \n - Slow internet connection \n - Overly restrictive firewall');
                $('#container').show();
            }
            finally 
            {
            }

            $('#loader').hide('blind');
            $('#ebirEnroll').hide('blind');
            $('#loader').css('background', '#FFF'); checkFinalCopyBtn('1701MS'); disableDropDown("after");
            HideContainer('ebirConfirmOnline');
            $('#containerPage').show();
            
            $('#wrapper').show();
            $('#PageFooter').show();
        }

        function createXMLFileName(subFolder) {
            var xmlFileName = "";
            var titleTin1 = d.getElementById('frm1701MS:txtPg1TIN1');
            var titleTin2 = d.getElementById('frm1701MS:txtPg1TIN2');
            var titleTin3 = d.getElementById('frm1701MS:txtPg1TIN3');
            var titleBranchCode = d.getElementById('frm1701MS:txtPg1BranchCode');
            var titleTPName = d.getElementById('frm1701MS:txtTaxpayerNo8a');

            var returnPeriod = d.getElementById('frm1701MS:txtMonthNo1').value + d.getElementById('frm1701MS:txtYearNo1').value;

            if (existingXMLFileName != null && existingXMLFileName.length > 0) 
            {
                xmlFileName = existingXMLFileName;
            } 
            else 
            {
                xmlFileName = subFolder + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + "-1701MS-" + returnPeriod + ".xml";
            }

            fileName = titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + "-1701MS-" + returnPeriod + ".xml";

            return xmlFileName;
        }

        function saveEncryptedProfile(isFromSubmit) {

            var isSaveSuccessful = saveXML(true);
            var fnNew = "";

            if (isSaveSuccessful) 
            {
                // Means existingXMLFileName is the same as the preloaded file yyy
                if (existingXMLFileName.indexOf('/') > -1) 
                { 
                    fnNew = existingXMLFileName.substring(existingXMLFileName.indexOf('/') + 1, existingXMLFileName.length);
                } 
                else 
                {
                    //Means fileName is the same as the preloaded file
                
                    if (fileName.indexOf('/') > -1) 
                    { 
                        fnNew = fileName.substring(fileName.indexOf('/') + 1, fileName.length);
                    } 
                    else 
                    {
                        
                        fnNew = fileName;
                    }
                }
            }
            else 
            {
                return;
            }

            if (document.getElementById('txtFinalFlag').value == "3") { fnNew = fnNew.split(".xml")[0] + "#" + globalEmail + "#.xml"; } var xmlFileName = "IAF_RDO_Copy/" + fnNew; //createXMLFileName("IAF_RDO_Copy/");//
            msg.innerHTML = 'Generating File...';
            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFile = "";

            if (doesFileExists(xmlFileName)) 
            {
                //alert("File '"+xmlFileName+"' already exists!\n\nThis will overwrite existing data.");				
            }

            xmlFile = fileSys.CreateTextFile(xmlFileName);
            fileNameToExport = fnNew;
            var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break

            /*--------------------- follow this format for parsing --------------------------- */
            var elem = document.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {
                if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
                    if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                        allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab; //all select-one and text values
                    }
                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        allXML += "<div>" + elem[i].id + "=" + elem[i].checked + elem[i].id + "=</div>" + tab; //all radio and checkbox values			
                    }

                }
            }
            /*--------------------- follow this format for parsing --------------------------- */
            allXML += tab + d.getElementById('xmlClose').innerHTML + "0";

            xmlFile.write(allXML);
            xmlFile.close();
            var succ = EncryptFile(xmlFileName);

            msg.innerHTML = '';
            if (typeof (isFromSubmit) === "undefined") 
            {
                if (confirm('File saved and encrypted.\nDo you want to save this in USB flash drive or CD-RW?')) 
                {
                    showModalExport();
                } 
                else 
                { 
                    disableAllElementIDs();
                    d.getElementById('frm1701MS:btnFinalCopy').disabled = false;
                    d.getElementById('frm1701MS:btnNextPage').disabled = false; 
                    d.getElementById('frm1701MS:btnPrevPage').disabled = false;
                }
            }
            else 
            {
                disableAllElementIDs();
                d.getElementById('frm1701MS:btnFinalCopy').disabled = false;
                d.getElementById('frm1701MS:btnNextPage').disabled = false; 
                d.getElementById('frm1701MS:btnPrevPage').disabled = false;
            }
            return fileSys.GetAbsolutePathName(xmlFileName);
        }

        function saveXML(isFinalCopy) {



            var isFileExists = false;
            var isAmendedReturn = false;
            var isAFinalCopy = false;

            if (gIsReadOnly && document.getElementById("txtFinalFlag").value != "2") 
            {
                if (confirm('You will no longer be allowed to modify since this is already the final copy.\nDo you want to save this in USB flash drive or CD-RW instead?')) 
                {
                    var xmlFileName = createEncXMLFileName("IAF_RDO_Copy/");
                    msg.innerHTML='Generating File...';
                    var fileSys = new ActiveXObject("Scripting.FileSystemObject");
                    var xmlFile=fileSys.CreateTextFile(xmlFileName); 
                    fileNameToExport = fileName;
                    var allXML = "<?xml version='1.0'?>",tab=d.getElementById('xmlFormat').innerHTML;
                    allXML += tab; //adds line break
                    /*--------------------- follow this format for parsing --------------------------- */
                    var elem = document.getElementById('frmMain').elements;
                    for(var i = 0; i < elem.length; i++)
                    {
                        if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') 
                        {				
                            if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                                if(elem[i].id == 'frm1701MS:txtTaxpayerNo8a')
                                {
                                    allXML += "<div>"+elem[i].id+"=" +escape(elem[i].value)+elem[i].id+"=</div>"+tab;
                                }
                                else
                                {
                                    allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab; //all select-one and text values
                                }
                            }
                            if (elem[i].type == 'radio' || elem[i].type == 'checkbox') 
                            {
                                allXML += "<div>"+elem[i].id+"=" +elem[i].checked+elem[i].id+"=</div>"+tab; //all radio and checkbox values			
                            }	
                            
                        }
                    } 				
                    /*--------------------- follow this format for parsing --------------------------- */
                    allXML += tab+d.getElementById('xmlClose').innerHTML+"0";
                    
                    xmlFile.write(allXML); 
                    xmlFile.close();
                    var succ = EncryptFile(xmlFileName);
                
                    msg.innerHTML = '';
                    showModalExport();
                    saveXMLProfile(true);		
                } 
                else 
                {
                    return false;
                }
            }
            else
            {
                var valid = initialValidateBeforeSave();

                if (valid == true) 
                {
                    var xmlFileNameValidate = "";
                    var isFinalFlag2 = false; 
                
                    var xmlFileName = createXMLFileName("savefile/");
                    msg.innerHTML='Generating File...';
                    var fileSys = new ActiveXObject("Scripting.FileSystemObject");
                    var xmlFile = "";

                    //---------------------------------------------------------------
                    //START:  New logic in handling amended returns	
                    isFileExists = doesFileExists(xmlFileName);	
                    isAmendedReturn = isItAnAmendedReturn();

                    if (isAmendedReturn == false)
                    {
                        if (xmlFileName.indexOf('V') == -1) 
                        {
                            xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/')+1,xmlFileName.indexOf('.xml'));			
                        } 
                        else 
                        {
                            xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/')+1,xmlFileName.indexOf('V'));			
                        }

                        var hasVersion = false;
                        var objEnum = new Enumerator(fileSys.GetFolder("savefile/").Files);

                        for(i=0;!objEnum.atEnd();objEnum.moveNext()) 
                        {
                            if (objEnum.item().name.indexOf(xmlFileNameValidate) > -1 && objEnum.item().name.indexOf("V") > -1) 
                            {
                                hasVersion = true;
                            }
                        }

                        if (hasVersion) 
                        {
                            if (!onExit) 
                            {
                                alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'.");
                                return false;
                            }
                        }
                    }

                    if (isFileExists) 
                    {
                        isAFinalCopy = isItAFinalCopy(xmlFileName);
                        if (document.getElementById('txtFinalFlag').value == '2') 
                        {
                            isAFinalCopy = false;
                            isFinalFlag2 = true;
                        }
                    }

                    // 1. 
                    if (isFileExists  == false) 
                    {
                        if (isAmendedReturn) 
                        {
                                var fn = createNewXMLFileName("savefile/", xmlFileName);
                                xmlFile = fileSys.CreateTextFile(fn);
                                xmlFileName = fn;
                                existingXMLFileName = fn;
                        }
                        else
                        xmlFile = fileSys.CreateTextFile(xmlFileName);
                    }

                    // 2. 
                    else if (isFileExists && isAFinalCopy && isAmendedReturn) 
                    {
                        if (existingXMLFileName != null && existingXMLFileName.length > 0) 
                        {
                            xmlFile = fileSys.CreateTextFile(xmlFileName);
                        } 
                        else 
                        {
                            var fn = createNewXMLFileName("savefile/", xmlFileName);
                            xmlFile = fileSys.CreateTextFile(fn);
                            xmlFileName = fn;
                            existingXMLFileName = fn;
                        }
                    }

                    // 3.
                    else if (isFileExists && isAFinalCopy && isAmendedReturn == false && document.getElementById('txtFinalFlag').value != '3') 
                    {
                        if (!onExit) 
                        {
                            alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'.");
                            return false;
                        }
                    }

                    // 4.
                    else if (isFileExists && isAFinalCopy == false) 
                    {
                        if (existingXMLFileName != null && existingXMLFileName.length > 0) 
                        {
                            xmlFile = fileSys.CreateTextFile(xmlFileName);
                        } 
                        else 
                        {
                            if (isAmendedReturn && isFinalFlag2 == false) 
                            {
                                var fn = createNewXMLFileName("savefile/", xmlFileName);
                                xmlFile = fileSys.CreateTextFile(fn);
                                xmlFileName = fn;
                                existingXMLFileName = fn;
                            } 
                            else 
                            {
                                xmlFile = fileSys.CreateTextFile(xmlFileName);
                            }
                        }
                    }

                    // 5.
                    else 
                    {
                        xmlFile = fileSys.CreateTextFile(xmlFileName);
                    }
                    //END:  New logic in handling amended returns	
                    //---------------------------------------------------------------

                    var allXML = "<?xml version='1.0'?>",tab=d.getElementById('xmlFormat').innerHTML;
                    allXML += tab; //adds line break

                    /*--------------------- follow this format for parsing --------------------------- */
                    var elem = document.getElementById('frmMain').elements;

                    for (var i = 0; i < elem.length; i++) 
                    {
                        if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') 
                        {
                            if (elem[i].type == 'text' || elem[i].type == 'select-one') 
                            {
                                if (elem[i].id == 'frm1701MS:txtTaxpayerNo8a') 
                                {
                                    allXML += "<div>" + elem[i].id + "=" + escape(elem[i].value) +elem[i].id + "=</div>" + "\n";
                                    p3TPName = escape(elem[i].value);
                                }

                                else if (elem[i].id == 'frm2550qv2024:txtTIN1') 
                                {
                                    allXML += "<div>" + elem[i].id + "=" + elem[i].value +elem[i].id + "=</div>" + "\n";
                                    p3TPTIN1 = elem[i].value;
                                } 
                                    
                                else if (elem[i].id == 'frm2550qv2024:txtTIN2') 
                                {
                                    allXML += "<div>" + elem[i].id + "=" + elem[i].value +  elem[i].id + "=</div>" + "\n";
                                    p3TPTIN2 = elem[i].value;
                                } 
                                    
                                else if (elem[i].id == 'frm2550qv2024:txtTIN3') 
                                {
                                    allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + "\n";
                                    p3TPTIN3 = elem[i].value;
                                } 

                                else if (elem[i].id == 'frm1701MS:txtPg1BranchCode') 
                                {
                                    allXML += "<div>" + elem[i].id + "=" + elem[i].value +  elem[i].id + "=</div>" + "\n";
                                    p3TPBranchCode = elem[i].value;
                                } 

                                else
                                {
                                    // Include only IDs not matching the pattern
                                    allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + "\n"; 
                                }
                            }

                            if (elem[i].type == 'radio' || elem[i].type == 'checkbox') 
                            {
                                // All radio and checkbox values
                                allXML += "<div>" + elem[i].id + "=" + elem[i].checked +elem[i].id + "=</div>" + "\n"; 	
                                if (document.getElementById('frm1701MS:txtAmendedYesNo2').checked == true) 
                                {
                                    p3IsAmended = "Yes";
                                } 
                                else if (document.getElementById('frm1701MS:txtAmendedNoNo2').checked == true) 
                                {
                                    p3IsAmended = "No";
                                }
                            }
                        }
                        p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;
                    }

                    /*--------------------- follow this format for parsing --------------------------- */
                    if (isFinalCopy) 
                    {
                        allXML += tab+d.getElementById('xmlClose').innerHTML+"0";
                        gIsReadOnly = true;
                    } 
                    else
                    {	
                        allXML += tab+d.getElementById('xmlClose').innerHTML;
                    }

                    //Phase 3: This 'savefile' will be uploaded to IAF Infra for DI processing
                    savedReturn = allXML;

                    xmlFile.write(allXML);
                    xmlFile.close();
                    msg.innerHTML = '';

                    if (isFinalCopy == false) 
                    {
                        alert('BIR Form saved successfully as : '+xmlFileName);
                    }
                    saveXMLProfile(false);
                    return true;
                }
            }
            return true;
        }

        function getRawFile() {
            var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break
            /*--------------------- follow this format for parsing --------------------------- */
            var elem = document.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {
                if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
                    if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                        allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab; //all select-one and text values
                    }
                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        allXML += "<div>" + elem[i].id + "=" + elem[i].checked + elem[i].id + "=</div>" + tab; //all radio and checkbox values			
                    }

                }
            }
            /*--------------------- follow this format for parsing --------------------------- */
            allXML += tab + d.getElementById('xmlClose').innerHTML + "0";
            return allXML;
        }

        function doesFileExists(xmlFile) {
            var fileSysObj = new ActiveXObject("Scripting.FileSystemObject");
            if (fileSysObj.FileExists(xmlFile)) {
                return true;
            } else {
                return false;
            }
        }

        function isItAnAmendedReturn(xmlFile) {
            if (document.getElementById('frm1701MS:txtAmendedYesNo2').checked) {
                return true;
            } else {
                return false;
            }
        }

        function isItAFinalCopy(xmlFile) {
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            fn = fsoXML.OpenTextFile(xmlFile, 1);
            var fnContent = fn.ReadAll();
            fn.Close();

            if (fnContent.indexOf("All Rights Reserved BIR 2012.0") >= 0) {
                return true;
            } else {
                return false;
            }
        }

        function createNewXMLFileName(subFolder, xmlFileName) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            var fileNm = "";
            var newFileNm = "";
            var subFileName = "";
            var version = 0;

            if (xmlFileName.indexOf('V') == -1) {
                fileNm = xmlFileName.substring(xmlFileName.indexOf('/') + 1, xmlFileName.indexOf('.xml'));
            } else {
                fileNm = xmlFileName.substring(xmlFileName.indexOf('/') + 1, xmlFileName.indexOf('V'));
            }

            var sameFileNameCtr = 0;
            if (subFolder.length > 0 && fso.FolderExists(subFolder)) {
                var objEnum = new Enumerator(fso.GetFolder(subFolder).Files);
                for (i = 0; !objEnum.atEnd(); objEnum.moveNext()) {
                    if (objEnum.item().name.indexOf(fileNm) > -1 && objEnum.item().name.indexOf('V') > -1) {

                        var isAFinalCopy = isItAFinalCopy(subFolder + objEnum.item().name);
                        subFileName = objEnum.item().name.substring(objEnum.item().name.indexOf('V') + 1, objEnum.item().name.indexOf('.xml'));
                        version = parseInt(subFileName);
                        if (version >= sameFileNameCtr) {
                            sameFileNameCtr = version + 1;
                        }
                    }
                }
                if (sameFileNameCtr > 0) {
                    newFileNm = subFolder + fileNm + "V" + sameFileNameCtr + ".xml";
                } else {
                    newFileNm = subFolder + fileNm + "V1.xml";
                }
                return newFileNm;
            }
        }

        var XMLrdoFile = '';
        function loadXMLrdo(fileLocation) {
            try {
                //This will load the Region file with filename 'fileLocation' if it exists
                var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
                XMLrdoFile = fsoXML.OpenTextFile(fileLocation, 1);

                if (XMLrdoFile.AtEndOfStream)
                    data = "";
                else {
                    var responseRdo = d.getElementById('responseRdo'); //render file and write to hidden div
                    responseRdo.innerHTML = XMLrdoFile.ReadAll(); //remove XML tag
                    //responseRdo = replaceHtml(responseRdo, XMLrdoFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
                }
                XMLrdoFile.Close(); //alert( responseRdo.innerHTML ); //Debug   
                loadRdo(); /*This will load ATC onto an array*/
            } catch (e) {
                msg.innerHTML = ""; //"Region File not Found.";
            } //this will Alert File not Found if it doesn't exist
        }

        var rdoCount = 0;
        function loadRdo() {
            /*This will load data onto an array*/
            var response = d.getElementById("responseRdo");

            var rdoCnt = String(response.innerHTML).split('rdoCount=');
            rdoCount = rdoCnt[1];

            var k = 0;
            //loads rdoList from xml
            for (var i = 1; i <= rdoCount; i++) {

                var rdo = String(response.innerHTML).split('rdo' + i + ':');
                var rdoStr = rdo[1];

                //Ensure that before writing to rdoPropertyJS the formType 1701MS is traceable in rdoStr
                if (rdoStr.indexOf('frm1701MS') >= 0) {
                    var rdoValues = rdoStr.split('~');
                    var rdoCode = rdoValues[0];
                    var description = rdoValues[1];

                    var objRdo = new rdoPropertyJS(rdoCode, description);
                    rdoList[k] = objRdo;
                    k++;
                    //alert('1701MS successfully created array #'+i);

                } else {
                    //alert('1701MS not found in array #'+i);
                    continue;
                }
            }
        }

        function loadDataATCRow() {
            /*This will load data onto fields*/
            var response = d.getElementById("response");
            var elem = document.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {

                if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {
                    if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                        var fieldVal = String($("#response").html()).split(elem[i].id + '=');
                        if (fieldVal != null && fieldVal.length > 1) {
                            elem[i].value = '';
                            elem[i].selectedIndex = 0;
                            if (elem[i].id == 'frm1701MS:txtTaxpayerNo8a') {
                                elem[i].value = unescape(fieldVal[1]);
                            }
                            else {
                                elem[i].value = fieldVal[1]; //all select-one and text values		 		
                            }

                        }
                    }
                }
            }
        }

        function loadWFDataATCRow(){  
            /*This will load data onto fields*/
            var response = document.getElementById("response");
            var elem = document.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {
            
                if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {
                    if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                        var fieldVal = String(response.innerHTML).split(elem[i].id + '>');
                        if (fieldVal != null && fieldVal.length > 1) {
                            elem[i].value = '';
                            elem[i].selectedIndex = 0;
                            elem[i].value = fieldVal[1].substring(0, fieldVal[1].indexOf("</")); //all select-one and text values

                        }
                    }
                }
            }
        }


        function loadWFDataWithATC() {
            var response = d.getElementById("response");

            var elem = d.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {

                if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&  			
                    if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                        var fieldVal = String(response.innerHTML).split(elem[i].id + '>');
                        if (fieldVal != null && fieldVal.length > 1) {
                            elem[i].value = fieldVal[1].substring(0, fieldVal[1].indexOf("</")); //all select-one and text values		  
                        }
                    }
                    if (elem[i].type == 'radio') {
                        var rdoVal = String(response.innerHTML).split(elem[i].id + '>');
                        if (rdoVal[1].substring(0, rdoVal[1].indexOf("</")) == 'true') {
                            elem[i].checked = rdoVal[1].substring(0, rdoVal[1].indexOf("</"));
                        }
                    }
                    if (elem[i].type == 'checkbox') {
                        var chkboxVal = String(response.innerHTML).split(elem[i].id + '>');

                        if (chkboxVal[1].substring(0, chkboxVal[1].indexOf("</")) == 'true') {
                            elem[i].checked = chkboxVal[1].substring(0, chkboxVal[1].indexOf("</"));
                        }
                    }
                }

            }
        }

        function loadDataWithATC() {
            /*This will load data onto fields*/
            var response = document.getElementById("response");

            var elem = document.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {

                if (elem[i].type !== 'hidden' && elem[i].type !== 'undefined') {
                    var fieldVal = String(response.innerHTML).split(elem[i].id + '=');
                    if (fieldVal.length > 1) {
                        var decodedValue = decodeURIComponent(fieldVal[1]);

                        if (elem[i].type === 'text' || elem[i].type === 'select-one') {
                            if (elem[i].id === 'txtTaxpayerNo8a:TaxPayer') {
                                elem[i].value = decodedValue;
                            } else {
                                elem[i].value = decodedValue;
                            }
                        }
                        if (elem[i].type === 'radio') {
                            if (decodedValue === 'true') {
                                elem[i].checked = true;
                            }
                        }
                        if (elem[i].type === 'checkbox') {
                            if (decodedValue === 'true') {
                                elem[i].checked = true;
                            }
                        }
                    }
                }
            }
        }

        function loadWFData() {
            /*This will load data onto fields*/
            var response = d.getElementById("response");

            var elem = document.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {

                try {
                    if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&  			
                        if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                            var fieldVal = String(response.innerHTML).split(elem[i].id + '>');
                            //elem[i].value = fieldVal[1]; //all select-one and text values		 		
                            if (fieldVal != null && fieldVal.length > 1) {
                                elem[i].value = fieldVal[1].substring(0, fieldVal[1].indexOf("</"));
                            }
                        }

                        if (elem[i].type == 'radio') {
                            var rdoVal = String(response.innerHTML).split(elem[i].id + '>');
                            if (rdoVal[1].substring(0, rdoVal[1].indexOf("</")) == 'true') {
                                elem[i].checked = rdoVal[1].substring(0, rdoVal[1].indexOf("</"));
                            }
                        }
                        if (elem[i].type == 'checkbox') {
                            var chkboxVal = String(response.innerHTML).split(elem[i].id + '>');
                            if (chkboxVal[1].substring(0, chkboxVal[1].indexOf("</")) == 'true') {
                                elem[i].checked = chkboxVal[1].substring(0, chkboxVal[1].indexOf("</"));
                            }
                        }

                    }
                } catch (e) {
                    //alert('exception thrown : e : '+e.description);
                }

            }
        }    



        //--------------------------START:  Rollbase REST API using 'create2' and 'setBinaryData' --------------------------
        var sessionId;
        var respMsg;
        var create2Id;

        xmlHttp = new XMLHttpRequest(), loginXML = new XMLHttpRequest(), binReturnsUploadXML = new XMLHttpRequest();



            var api, x, gRBSessionId;
        function openLogin() {
            document.getElementById('txtFinalFlag').value = '3'
            isSubmit = true;
            isSubmitFinal = true;
            if (gIsReadOnly) {
                isSubmitFinal = false;
            }
            var hasSavedReturn = saveXMLsubmit(true);
            if (hasSavedReturn) {
                var loginURL = geteBIRFormsOnlineLoginURL();
                x = window.open(loginURL, 'Login_Screen', 'resizable=1,scrollbars=1,height=850,width=900');
                api = window.setInterval(getAPI, 500);
            }
        }

            function getAPI() {
            try {
                if (x.closed) {
                    if (api) {
                        if (isSubmitFinal) {
                            window.clearInterval(api);
                            api = null;
                            saveXMLsubmit(false);
                        }
                        else {
                            window.clearInterval(api);
                            api = null;
                            saveXMLsubmit(true);
                        }
                    }
                    return;
                }

                if ($("#response", x.document).length > 0)
                    $("#responsetext").val($("#response", x.document).val());
                else return;
                var response = String($("#responsetext").val());
                gRBSessionId = response;

                sessionId = gRBSessionId.split('<sessionId>');
                sessionId = String(sessionId[1]);
                sessionId = sessionId.split('</sessionId>');
                sessionId = String(sessionId[0]);
                //alert('sessionId = '+sessionId);

                if (response.length != 0 && (sessionId != 'undefined' || sessionId != '<?xml ver')) {
                    createRecord();
                    window.clearInterval(api);
                }
            }
            catch (e) {
                return;
            }
        }

        xmlFileForCreate2X = new Date();
        var rbURL = getURL();
        function createRecord() {
            createURL = rbURL + "/rest/api/create2?sessionId=" + sessionId + "&objName=upload1&tax_due=" + p3BasicTax + "&total_penalties=" + p3TotalPenalties + "&total_amount_payable=" + p3TotalAmountPayable + "&tp_zip=" + p3TPZip + "&tp_addr=" + p3TPAddress + "&tp_telnum=" + p3TPTelNum + "&tp_name=" + p3TPName + "&tp_lob=" + p3TPLineBus + "&tp_rdo_code=" + p3TPRDOCode + "&tp_branch_code=" + p3TPBranchCode + "&tp_tin=" + p3TPTIN + "&surcharge=" + p3Surcharge + "&compromise=" + p3Compromise + "&interest=" + p3Interest + "&is_amended_return=" + p3IsAmended + "&return_period=" + p3ReturnPeriod + "&return_period_end=" + p3ReturnPeriodEnd + "&useIds=false&form_type_text=2550Qv2024-Feb2007&load=" + xmlFileForCreate2X; //FOR create2
            xmlHttp.open("POST", createURL, false);
            xmlHttp.send();
            var respXMLMsg = xmlHttp.responseText;
            create2Id = respXMLMsg;
            create2Id = create2Id.split('id=');
            create2Id = String(create2Id[1]).replace(/"/gi, '');
            create2Id = String(parseInt(create2Id)).replace(/ /, '');
            x.document.theForm.submit();
            uploadXMLFile();
        }


        function uploadXMLFile() {
            var binDataURL;
            //Dev Note: frmMainSrc contains the HTML and content of the form
            //frmMainSrc should get the print preview version
            // $('#frmMain').html(); //content of the loop
            printme();
            if (savedReturn != null && savedReturn.length > 0) {
                var intervalCnt = 1000;

                var xmlFileForUpload = savedReturn.replace(/&nbsp;/g, "<span style='padding-left:0.25em'> </span>");
                xmlFileForUpload = xmlFileForUpload.replace(/&amp;/g, "AND");
                xmlFileForUpload = xmlFileForUpload.replace(/&/g, "_AND_");
                xmlFileForUpload = xmlFileForUpload.replace(/\+/g, "_PLUS_");
                var savedReturnLen = xmlFileForUpload.length;

                //Loop Begin - create submit_return_data records, related to Created Upload File - 		
                var numOfSRLoops = Math.ceil(savedReturnLen * 1 / intervalCnt);
                var loopSRCnt = numOfSRLoops + 1;
                var startSRPost = 0;
                var endSRPost = intervalCnt;
                var partSRCnt = 1;

                for (var i = 0; i < numOfSRLoops; i++) {

                    binDataURL = rbURL + "/rest/api/create2?sessionId=" + sessionId + "&objName=submit_return_data&useIds=false&index_=" + partSRCnt + "&name=2550Q_part" + partSRCnt + "&R95607586=" + create2Id + "&content=" + xmlFileForUpload.substring(startSRPost, endSRPost);
                    var binDataUploadXML = new XMLHttpRequest();
                    binDataUploadXML.open("POST", encodeURI(binDataURL), false);
                    binDataUploadXML.send();

                    //xmlFn.writeLine(xmlFileInBase64.substring(startSRPost, endSRPost)+"\n\ncompleted\n\n");			
                    //alert('i = '+i+' startSRPost = '+startSRPost+' endSRPost = '+endSRPost);	

                    startSRPost = startSRPost + intervalCnt;
                    if (i == numOfSRLoops - 1) {
                        endSRPost = savedReturnLen;
                    } else {
                        endSRPost = endSRPost + intervalCnt;
                    }
                    partSRCnt++;
                }
                //alert("A total of "+loopSRCnt+" iterations are uploaded in 'submit_return_data' object for this form!");	
                cancel();
                disableAllElementIDs();
                d.getElementById('frm1701MS:btnNextPage').disabled = false; 
                d.getElementById('frm1701MS:btnPrevPage').disabled = false;
                //Open a new page, displaying the created form
                //alert("Finished Loading REST 'create2' request for FORMS object.");

                //getDisplayPageURL() is defined in string-util2014.js
                var redirectURL = x.window.location.href;
                var formURL = getDisplayPageURL(redirectURL, create2Id);
                if (parseInt(create2Id) > 0) window.open(formURL, 'Login_Screen', 'resizable=1,scrollbars=1,height=850,width=900');
            } else {
                alert("Tax Return file does not exists.  Cannot proceed with submission.");
                return;
            }

            //xmlFn.close();		
        }

        function saveXMLsubmit(submit) {
            var valid = initialValidateBeforeSave();
            var isBFinalCopy = false;
            var isFinalCopy = false;

            if (valid == true) {
                //Added 10/21/2016
                var xmlFileNameValidate = "";

                var xmlFileName = createXMLFileName("savefile/");
                msg.innerHTML = 'Generating File...';
                var fileSys = new ActiveXObject("Scripting.FileSystemObject");
                var xmlFile = "";

                //---------------------------------------------------------------
                //START:  New logic in handling amended returns			
                isFileExists = doesFileExists(xmlFileName);
                isAmendedReturn = isItAnAmendedReturn();

                //as of 10/21/2016
                //if there is already amended filed and will file a not amended,
                //it will restrict it
                if (isAmendedReturn == false) {
                    if (xmlFileName.indexOf('V') == -1) {
                        xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/') + 1, xmlFileName.indexOf('.xml'));
                    } else {
                        xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/') + 1, xmlFileName.indexOf('V'));
                    }

                    var hasVersion = false;
                    var objEnum = new Enumerator(fileSys.GetFolder("savefile/").Files);
                    for (i = 0; !objEnum.atEnd(); objEnum.moveNext()) {
                        if (objEnum.item().name.indexOf(xmlFileName) > -1 && objEnum.item().name.indexOf("V") > -1) {
                            hasVersion = true;
                        }
                    }
                    if (hasVersion) {
                        if (!onExit && !isSubmit)
                            alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'.");
                        return false;
                    }
                }

                if (isFileExists) {
                    if (document.getElementById('txtFinalFlag').value == '2') { 
                        isAFinalCopy = false; 
                    }
                }

                // 1 check if fileExists, if not regular routine
                if (isFileExists == false) {

                    xmlFile = fileSys.CreateTextFile(xmlFileName); //xmlFileName should be the newly created xml filename here.
                }
                // 2 if (fileExists && FinalCopy  && Amended) {versionFile} 
                else if (isFileExists && isBFinalCopy && isAmendedReturn) {
                    //versionFile xxx

                    var fn = createNewXMLFileName("savefile/", xmlFileName);
                    xmlFile = fileSys.CreateTextFile(fn);
                    xmlFileName = fn;
                    existingXMLFileName = fn;
                }
                // 3 if (fileExists && FinalCopy  && Not Amended) {throw error message: "If your intention is to make an amended return, kindly tick Amended Return to 'Yes'".} 
                else if (isFileExists && isBFinalCopy && isAmendedReturn == false && document.getElementById('txtFinalFlag').value != '3') {
                    if (!onExit && !isSubmit) {
                        alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'.");
                        return false;
                    }
                    else {
                        xmlFile = fileSys.CreateTextFile(xmlFileName);
                    }
                }
                //4  if (fileExists && Not FinalCopy  && Not Amended/Amended) {regular routine} 				
                else if (isFileExists && isBFinalCopy == false) {

                    xmlFile = fileSys.CreateTextFile(xmlFileName); //xmlFileName should be the preloaded xml filename here.
                }
                else {
                    xmlFile = fileSys.CreateTextFile(xmlFileName);
                }
                //END:  New logic in handling amended returns						
                //---------------------------------------------------------------

                //
                var allXML = "<?xml version='1.0'?>" + "\n", tab = d.getElementById('xmlFormat').innerHTML;
                allXML += tab;

                /*--------------------- follow this format for parsing --------------------------- */
                var elem = document.getElementById('frmMain').elements;
                for (var i = 0; i < elem.length; i++) {
                    if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
                        if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                            if (elem[i].id == 'frm1701MS:txtTaxpayerNo8a') {
                                allXML += "<div>" + elem[i].id + "=" + escape(elem[i].value) +elem[i].id + "=</div>" + "\n";
                                p3TPName = escape(elem[i].value);
                            }
                            
                        }
                        if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].checked +elem[i].id + "=</div>" + "\n"; //all radio and checkbox values	
                            if (document.getElementById('frm1701MS:txtAmendedYesNo2').checked == true) {
                                p3IsAmended = "Yes";
                            } else if (document.getElementById('frm1701MS:txtAmendedNoNo2').checked == true) {
                                p3IsAmended = "No";
                            }
                        }
                    }
                    p3ReturnPeriodEnd = p3ReturnPeriod;
                    p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;				
                }
                /*--------------------- follow this format for parsing --------------------------- */
                if (submit) {
                    allXML += tab + d.getElementById('xmlClose').innerHTML + "0";
                } else {
                    allXML += tab + d.getElementById('xmlClose').innerHTML;
                }

                //Phase 3: This 'savefile' will be uploaded to IAF Infra for DI processing
                savedReturn = allXML;

                xmlFile.write(allXML);
                xmlFile.close();
                msg.innerHTML = '';


                if (isFinalCopy == false) {
                        alert('BIR Form saved successfully as : ' + xmlFileName);
                            alert('Background information saved/updated successfully as : ' + xmlFileName);
                    }

            }
            return true;
        }   

        function validate() {

        var checkbox = document.getElementById('frm1701MS:perjuryClause');
        var civilStatus = document.getElementById('frm1701MS:civilStatus').value;



        var year = document.getElementById('frm1701MS:txtYearNo1').value;
        var month = document.getElementById('frm1701MS:txtMonthNo1').value;

        var currentYear = new Date().getFullYear();
            var currentDate = new Date(); // Get the current date
        var currentMonth = ("0" + (new Date().getMonth() + 1)).slice(-2);


        //validate item 1
        if (document.getElementById('frm1701MS:txtReturnPeriodYesNo3').checked == false){
            if (year >= currentYear){
                alert("Future filing is not allowed. Please input correct year on Item 1");
                return;
            }
        }
        else if (document.getElementById('frm1701MS:txtReturnPeriodYesNo3').checked == true){
            if (month > currentMonth && year >= currentYear){
                alert("Future filing is not allowed. Please input correct year on Item 1");
                return;
            }
        }
        
        


        if (civilStatus == 'Married') {
            if (
            document.getElementById('frm1701MS:txtIfMarriedJointlyNo5').checked == false &&
            document.getElementById('frm1701MS:txtIfMarriedSeparatelyNo5').checked == false &&
            document.getElementById('frm1701MS:txtIfMarriedNotApplicableNo5').checked == false
            ) {
            alert("Item 5 is required if Item 4 is marked as Married.");
            return;
            }
        }



        if(document.getElementById('frm1701MS:txtIfMarriedJointlyNo5').checked)
        {
                // Check TIN fields
            if (document.getElementById('frm1701MS:txtPg2TIN1Spouse').value == "" || 
                document.getElementById('frm1701MS:txtPg2TIN2Spouse').value == "" || 
                document.getElementById('frm1701MS:txtPg2TIN3Spouse').value == "" || 
                document.getElementById('frm1701MS:txtPg2BranchCodeSpouse').value == "") {
                alert("Please enter a valid TIN number on Item 6 for Spouse");
                return;
            }
                if (document.getElementById('frm1701MS:txtRDOCodeb').value == "") {
                alert("Please enter a valid RDO code for Spouse on Item 7");
                return;
            }
                if (document.getElementById('frm1701MS:txtTaxpayerNo8b').value == "") {
                alert("Please enter a valid Name for Spouse on Item 8");
                return;
            }
                // Check Email Address
            if (document.getElementById('frm1701MS:txtEmailb').value == "") {
                alert("Please enter a valid Email Address for Spouse on Item 9");
                return;
            }

            // Check Contact Number
            if (document.getElementById('frm1701MS:txtTelNum10b').value == "") {
                alert("Please enter a valid Contact Number for Spouse on Item 10");
                return;
            }

            //Check Source of Income of Taxpayer
            if (document.getElementById('frm1701MS:txtTaxpayerNo11a').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo11b').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo11c').checked == false
            ){
                alert ("Please select an option on Item 11 for Taxpayer");
                return;
            }

            //Check Source of Income of Taxpayer Spouse
            if (document.getElementById('frm1701MS:txtTaxpayerNo11a1').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo11b1').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo11c1').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo11d1').checked == false
            ){
                alert ("Please select an option on Item 11 for Spouse");
                return;
            }

            //Check Item 12
            if (document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo12c1').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo12b1').checked == false
            ){
                alert("Item 12 is required if Item 5 is marked as Jointly.");
                return;
            }

            //validate Item 16

            if ((document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked == true) || (document.getElementById('frm1701MS:txtTaxpayerNo12e1') == true)){
                if (!validateEffectivityDateSpouse16()) {
                    return;
                }
            }

            //Check Item 17
            if (((document.getElementById('frm1701MS:txtTaxpayerNo11a1').checked == true) || (document.getElementById('frm1701MS:txtTaxpayerNo11b1').checked == true) || (document.getElementById('frm1701MS:txtTaxpayerNo11c1').checked == true)) && (document.getElementById('frm1701MS:txtTaxpayerNo12b1').checked == true))
            {
                if((document.getElementById('frm1701MS:txtSpouseNo17a').checked == false) && (document.getElementById('frm1701MS:txtSpouseNo17b').checked == false)){
                alert ("Item 17 is mandatory if Item 11 is Income from Business, Mixed Income and Income from Profession and Item 12 is Graduated Income Tax Rates.");
                return;
                }
            }
            
            //validate 31
            var item30 = NumWithComma(document.getElementById("frm1701MS:txtAggregateAmountPayable30a").value);

            //item 27a and 27b
            var item27A = NumWithComma(document.getElementById("frm1701MS:txtAmountPayableNo27a").value);
            var item27B = NumWithComma(document.getElementById("frm1701MS:txtAmountPayableNo27b").value);
            var item27Total = Math.abs(item27A + item27B);

            //checkboxes
            var toBeRefundedCheckbox     = document.getElementById("frm1701MS:txtToBeRefunded");
            var txtToBeIssuedCheckbox    = document.getElementById("frm1701MS:txtToBeIssued");
            var txtToBeCarriedCheckbox   = document.getElementById("frm1701MS:txtToBeCarried");

            //textfields
            var toBeRefundedText   = document.getElementById("frm1701MS:txtToBeRefunded1");
            var txtToBeIssuedText  = document.getElementById("frm1701MS:txtToBeIssued1");
            var txtToBeCarriedText = document.getElementById("frm1701MS:txtToBeCarried1");

            // if item 30 is negative, item 31 is mandatory
            if (item30 < 0) {

                if (
                    !toBeRefundedCheckbox.checked &&
                    !txtToBeIssuedCheckbox.checked &&
                    !txtToBeCarriedCheckbox.checked
                ) {
                    alert("Item 31 is mandatory because Item 30 is has negative value.");
                    return;
                }

                // total of item 31 amounts must equal 27A + 27B

                var total31 =
                    (toBeRefundedCheckbox.checked     ? NumWithComma(toBeRefundedText.value)   : 0) +
                    (txtToBeIssuedCheckbox.checked    ? NumWithComma(txtToBeIssuedText.value)  : 0) +
                    (txtToBeCarriedCheckbox.checked   ? NumWithComma(txtToBeCarriedText.value) : 0);

                if (total31 !== item27Total) {
                    alert("The total amount in Item 31 must equal the sum of Item 27A and Item 27B (" 
                        + formatCurrencyWithComma(item27Total) + ").");
                    return;
                }
            }





            // validate PART V Item 7B (Spouse)
            // var elFTNo = getEl('frm1701MS:addForeignTaxCredits');      // Foreign Tax No.
            // var el7b   = getEl('frm1701MS:txtForeignTaxCreditsNo7b');  // Amount 7B

            // if (!elFTNo || !el7b) { return true; }

            // var ftNoPresent = hasText(elFTNo);
            // var amt7bPresent = hasNonZeroAmount(el7b);

            // // CASE 1: Amount present but no Foreign Tax Credits
            // if (amt7bPresent && !ftNoPresent) {
            //     alert("Part V - Item 7 Foreign Tax Credits is mandatory if the amount column has value.");
            //     try { elFTNo.focus(); } catch (e) {}
            //     return false;
            // }
            // // CASE 2: Foreign Tax Credits present but amount missing/zero
            // else if (ftNoPresent && !amt7bPresent) {
            //     alert("Part V - Item 7B Foreign Tax Amount is mandatory if Foreign Tax Credits field has value.");
            //     try { el7b.focus(); } catch (e) {}
            //     return false;
            // }

            // validate PART V Item 9B (Spouse)
            // var elText = getEl('frm1701MS:addOtherCreditsPayments');      // Text (reference/number)
            // var el9b   = getEl('frm1701MS:txtOtherCreditsPaymentsNo9b');  // Amount 9B (Spouse)

            // if (!elText || !el9b) { return true; }

            // var tcNoPresent = hasText(elText);
            // var amt9bPresent = hasNonZeroAmount(el9b);

            // // CASE 1: Amount present but Other Tax Credits is missing
            // if (amt9bPresent && !tcNoPresent) {
            //     alert("Part V - Item 9 Other Credits/Payments is mandatory if the Amount column has value.");
            //     try { elText.focus(); } catch (e) {}
            //     return false;
            // }
            // // CASE 2: Other Tax Credits present but Amount is missing/zero
            // else if (tcNoPresent && !amt9bPresent) {
            //     alert("Part V - Item 9B Amount is mandatory if the Other Credits/Payments field has value.");
            //     try { el9b.focus(); } catch (e) {}
            //     return false;
            // }
    }
        

        //validate Item 16

        if ((document.getElementById('frm1701MS:txtTaxpayerNo12d').checked == true) || (document.getElementById('frm1701MS:txtTaxpayerNo12e').checked == true)){
            if (!validateEffectivityDateTaxpayer16()) {
                return;
            }
        }

        // validate PART V Item 7 (Taxpayer and Spouse)
        var elFTNo = getEl('frm1701MS:addForeignTaxCredits');      // Foreign Tax No.
        var el7a   = getEl('frm1701MS:txtForeignTaxCreditsNo7a');  // Amount 7A
        var el7b   = getEl('frm1701MS:txtForeignTaxCreditsNo7b');  // Amount 7B

        //if (!elFTNo || !el7a) { return true; }

        var ftNoPresent = hasText(elFTNo);
        var amt7aPresent = hasNonZeroAmount(el7a);
        var amt7bPresent = hasNonZeroAmount(el7b);

        // CASE 1: Amount present but no Foreign Tax Credits
        if ((amt7aPresent || amt7bPresent) && !ftNoPresent) {
            alert("Part V - Item 7 Foreign Tax Credits is mandatory if the amount column has value.");
            try { elFTNo.focus(); } catch (e) {}
            return false;
        } 
        // CASE 2: Foreign Tax Credits present but amount missing/zero
        else if (ftNoPresent && (!amt7aPresent && !amt7bPresent)) {
            alert("Part V - Item 7 Foreign Tax Amount is mandatory if Foreign Tax Credits field has value.");
            try { el7a.focus(); } catch (e) {}
            return false;
        }

        // validate PART V Item 9 (Taxpayer and Spouse)
        var elText = getEl('frm1701MS:addOtherCreditsPayments');      // Text (reference/number)
        var el9a   = getEl('frm1701MS:txtOtherCreditsPaymentsNo9a');  // Amount 9A (Taxpayer)
        var el9b   = getEl('frm1701MS:txtOtherCreditsPaymentsNo9b')  // Amount 9B (Spouse)

        //if (!elText || !el9a) { return true; }

        var tcNoPresent = hasText(elText);
        var amt9aPresent = hasNonZeroAmount(el9a);
        var amt9bPresent = hasNonZeroAmount(el9b)

        // CASE 1: Amount present but Other Tax Credits is missing
        if ((amt9aPresent || amt9bPresent) && !tcNoPresent) {
            alert("Part V - Item 9 Other Credits/Payments is mandatory if the Amount column has value.");
            try { elText.focus(); } catch (e) {}
            return false;
        }
       // CASE 2: Other Tax Credits present but Amount is missing/zero
        else if (tcNoPresent && (!amt9aPresent && !amt9bPresent)) {
            alert("Part V - Item 9 Amount is mandatory if the Other Credits/Payments field has value.");
            try { el9a.focus(); } catch (e) {}
            return false;
        }
            
        /*
        if(document.getElementById('frm1701MS:txtIfMarriedJointlyNo5').checked) {

        {
        if (
            document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked == false &&
                document.getElementById('frm1701MS:txtTaxpayerNo12c1').checked == false &&
            document.getElementById('frm1701MS:txtTaxpayerNo12b1').checked == false
        ) {
            alert("Item 12 is required if Item 5 is marked as Jointly.");
            return;
        }

        }}

        */


        // Ensure the input year is not a future year
        if (isNaN(year) || isNaN(month)) {
            alert("Please enter a valid year and month.");
            return;
        }

        // Ensure the input year is not a future year
        if (year > currentYear) {
            alert("Future filing is not allowed. Please enter a valid year.");
            return;
        }

        // Ensure month is valid only for the current year
        if (year === currentYear && month > currentMonth) {
            alert("Future filing is not allowed. Please enter a valid month.");
            return;
        }


        // Check TIN fields
        if (document.getElementById('frm1701MS:txtPg2TIN1').value == "" || 
            document.getElementById('frm1701MS:txtPg2TIN2').value == "" || 
            document.getElementById('frm1701MS:txtPg2TIN3').value == "" || 
            document.getElementById('frm1701MS:txtPg2BranchCode').value == "") {
            alert("Please enter a valid TIN number on Item 6");
            return;
        }
                    


        if (document.getElementById('frm1701MS:txtMonthNo1').value == "" ||
            document.getElementById('frm1701MS:txtYearNo1').value == "")
            {
                alert("Item 1 is a required field.")
                return;
            }

        // Check RDO Code
        if (document.getElementById('frm1701MS:txtRDOCodea').value == "") {
            alert("Please enter a valid RDO code on Item 7");
            return;
        }

        // Check Taxpayer Name
        if (document.getElementById('frm1701MS:txtTaxpayerNo8a').value == "") {
            alert("Please enter a valid Taxpayer Name on Item 8");
            return;
        }



        // Check Email Address
        if (document.getElementById('frm1701MS:txtEmaila').value == "") {
            alert("Please enter a valid Email Address on Item 9");
            return;
        }

        // Check Contact Number
        if (document.getElementById('frm1701MS:txtTelNum10a').value == "") {
            alert("Please enter a valid Contact Number on Item 10");
            return;
        }

            

        if ((document.getElementById('frm1701MS:txtTaxpayerNo12b').checked == false) && (document.getElementById('frm1701MS:txtTaxpayerNo12c').checked == false ) && (document.getElementById('frm1701MS:txtTaxpayerNo12d').checked == false ) && (document.getElementById('frm1701MS:txtTaxpayerNo12e').checked == false ) ){
            alert("Taxpayer Item 12 is a required field ");
                return;
        }



        if((document.getElementById('frm1701MS:txtTaxpayerNo12d').checked || document.getElementById('frm1701MS:txtTaxpayerNo12e').checked) && (document.getElementById('frm1701MS:txtTaxpayerNo13a').value == "" || document.getElementById('frm1701MS:txtTaxpayerNo14a').value == "" || document.getElementById('frm1701MS:txtTaxpayerNo15a').value == "" || document.getElementById('frm1701MS:txtTaxpayerNo16a').value == "" || document.getElementById('frm1701MS:txtTaxpayerNo16a1').value == ""))
        {
            alert("Please make sure to enter details on Item 13 to 16 on Taxpayer");
            return;
        }

        if((document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked || document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked) && (document.getElementById('frm1701MS:txtTaxpayerNo13b').value == "" || document.getElementById('frm1701MS:txtTaxpayerNo14b').value == "" || document.getElementById('frm1701MS:txtTaxpayerNo15b').value == "" || document.getElementById('frm1701MS:txtTaxpayerNo16b').value == "" || document.getElementById('frm1701MS:txtTaxpayerNo16b1').value == ""))
        {
            alert("Please make sure to enter details on Item 13 to 16 on Spouse");
            return;
        }

        if (((document.getElementById('frm1701MS:txtTaxpayerNo11a').checked == true) || (document.getElementById('frm1701MS:txtTaxpayerNo11b').checked == true) || (document.getElementById('frm1701MS:txtTaxpayerNo11c').checked == true)) && (document.getElementById('frm1701MS:txtTaxpayerNo12b').checked == true))
        {
            if((document.getElementById('frm1701MS:txtTaxpayerNo17a').checked == false) && (document.getElementById('frm1701MS:txtTaxpayerNo17b').checked == false)){
                alert ("Item 17 is mandatory if Item 11 is Income from Business, Mixed Income and Income from Profession and Item 12 is Graduated Income Tax Rates.");
                return;
            }
        }




            // Check if the checkbox is not checked

        if (!checkbox.checked) {

            alert("You need to agree to the Perjury Clause.");

            return false;

        }






        // Additional checks for other mandatory fields can be added here

        disabledAllFields();
        alert("Validation successful. Click on Edit if you wish to modify your entries.");
        return;
        }

