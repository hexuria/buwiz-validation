        function shortPeriodReturn(answer) {
            var monthField = document.getElementById('frm1701MS:txtMonthNo1');
            if (answer == "yes")  {
                if (confirm("Choosing ‘YES’ means you are filing for a short period \n" +
                        "return. You are required to edit the MM/YYYY field in Item 1\n" +
                        "to correspond with your New Return Period.")) {

                }

                d.getElementById('frm1701MS:txtMonthNo1').disabled = false;
                
                document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6a').disabled = false
                document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6b').disabled = false
                document.getElementById('frm1701MS:txtMonthNo1').disabled = false
            } else {
                d.getElementById('frm1701MS:txtMonthNo1').disabled = true;
                document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6a').disabled = true
                document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6b').disabled = true
                document.getElementById('frm1701MS:txtMonthNo1').disabled = true
                monthField.value = "12"; 
            }
        }

