        // Reset:
        //  - text → blank
        //  - textarea → blank
        //  - select → default/first option
        //  - radio → unchecked
        function resetFieldsOthersOnDisable(fieldIds, enable) {
            if (enable) { return; }

            for (var i = 0; i < fieldIds.length; i++) {
                var el = document.getElementById(fieldIds[i]);
                if (!el) { continue; }

                var tag = (el.tagName || "").toLowerCase();
                var type = (el.type || "").toLowerCase();

                // text input
                if (tag === "input" && type === "text") {
                    el.value = "";
                }

                // textarea
                else if (tag === "textarea") {
                    el.value = "";
                }

                // select dropdown
                else if (tag === "select") {
                    var usedPlaceholder = false;

                    for (var j = 0; j < el.options.length; j++) {
                        var opt = el.options[j];
                        if (opt && (opt.value === "" || opt.value === null)) {
                            el.selectedIndex = j;
                            usedPlaceholder = true;
                            break;
                        }
                    }
                    if (!usedPlaceholder && el.options.length > 0) {
                        el.selectedIndex = 0;
                    }
                }

                // radio buttons
                else if (tag === "input" && type === "radio") {
                    el.checked = false;
                }
            }
        }

        /**
         * Same as above, but the trigger→targets mapping lives inside the function.
         */

        // Reset number inputs to "0"
        function resetFieldsToZeroOnDisable(fieldIds, enable) {
            if (enable) { return; } // do nothing when enabling

            for (var i = 0; i < fieldIds.length; i++) {
                var id = fieldIds[i];
                var el = document.getElementById(id);

                if (el && typeof el.value !== "undefined") {

                    // Special case: fields that need "0.00%" instead of "0"
                    if (
                        id === "frm1701MS:txtTaxRatea" || // Taxpayer Part 4B1 Item 16
                        id === "frm1701MS:txtTaxRateb"    // Spouse Part 4B1 Item 16
                    ) {
                        el.value = "0.0%";
                    } else {
                        // Default reset
                        el.value = "0";
                    }
                }
            }
        }

