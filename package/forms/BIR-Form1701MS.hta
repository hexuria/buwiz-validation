        // Function to compute the total amount in Schedule 4 for the spouse
        function computeOtherSched410A() {
        var total = 0;
        var tableBody = document.getElementById('tbodySched410A');
        if (tableBody) {
            var rows = tableBody.getElementsByTagName('tr');
            for (var i = 0; i < rows.length; i++) {
                var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];
                if (amountInput) {
                    var currentAmount = amountInput.value.replace(/,/g, '') || '0';
                    var amount = parseFloat(currentAmount) || 0;
                    total += amount;
                }
            }
        }
        document.getElementById('resultSched410A').value = formatCurrencyWithComma(Math.round(total));
        document.getElementById('frm1701MS:txtAllowableItemizedDeductionsNo10a').value = formatCurrencyWithComma(Math.round(total));
        }
        function NewSpecifySched410A() {
        this.txtSpecifySched410ADescription = '';
        this.txtSpecifySched10AAmount = '0';
        }

        function addColSched410A() {

        if (validationSpecify10A()){
        // Create a new entry
        var newEntry = new NewSpecifySched410A();
        specifyToCommit10A.push(newEntry); // Add new entry to the array

        // Update specifyToCommit10A with the current input values before clearing the table
        for (var i = 0; i < specifyToCommit10A.length; i++) {
            if (document.getElementById('frm1701MS:sched410A:Description' + i)) {
                specifyToCommit10A[i].txtSpecifySched410ADescription = document.getElementById('frm1701MS:sched410A:Description' + i).value;
            }
            if (document.getElementById('frm1701MS:sched410A:Amount' + i)) {
                specifyToCommit10A[i].txtSpecifySched410AAmount = document.getElementById('frm1701MS:sched410A:Amount' + i).value;
                
            }
        }

        // Clear the existing rows in the tbody
        $('#tbodySched410A').html(""); // Ensure this matches your HTML ID

        // Populate the table with updated entries
        for (var i = 0; i < specifyToCommit10A.length; i++) {
            $('#tbodySched410A').append(
                "<tr>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px'>10A." + (i + 1) + "</td>" +
                "<td width='50%' style='border: 1px solid black; padding: 2px'>" +
                    "<input type='text' id='frm1701MS:sched410A:Description" + i + "' style='width: 450px;' " +
                    "value='" + (specifyToCommit10A[i].txtSpecifySched410ADescription || '') + "' maxlength='50'>" +
                "</td>" +
                "<td width='30%' style='border: 1px solid black; padding: 2px'>" +
                    "<input type='text' id='frm1701MS:sched410A:Amount" + i + "' style='width: 150px; text-align: right;' " +
                    "value='" + (specifyToCommit10A[i].txtSpecifySched410AAmount || '0') + "' onchange='updateSpecifyToCommit10A(" + i + "); removeDecimal(this); computeOtherSched410A();' onkeypress='return wholenumber (this, event)' " +
                    "maxlength='25'>" +
                "</td>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px'>" +
                    "<button id='deleteIdSpouse" + i + "' onclick='deleteRowSched410A(" + i + ")' style='padding: 2px'>Remove</button>" +
                "</td>" +
                "</tr>"
            );
        }

        // Optionally, compute totals or perform other actions here
            computeOtherSched410A(); 
        }
        }




        function validationSpecify10A() {
            var size = specifyToCommit10A.length;
            for (var i = 0; i < size; i++) {
                if (document.getElementById('frm1701MS:sched410A:Description' + i).value == "" || 
                    document.getElementById('frm1701MS:sched410A:Amount' + i).value == "0") {
                    alert("Empty fields are not allowed"); 
                    return;
                }
            }
            return true;
        }




