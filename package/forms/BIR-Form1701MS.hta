        // Function to update specifyToCommit array for the spouse
        function updateSpecifyToCommit20B(index) {
        var description = document.getElementById('frm1701MS:sched42OB:Description' + index).value;
        var amount = document.getElementById('frm1701MS:sched420B:Amount' + index).value;
