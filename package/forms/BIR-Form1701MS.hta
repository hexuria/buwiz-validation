        // COMPUTE SCHED 4



        function computeOtherSched413B() {
        var total = 0;
        for (var i = 0; i < specifyToCommit.length; i++) {
        var currentAmount= specifyToCommit[i].txtSpecifySched413BAmount || '0';
        if(currentAmount === '0')
        {
            var amount = 0;
        }
        else
        {
            var convertedAmount = currentAmount.toString().replace(/,/g, '') || '0';

            var amount = parseFloat(convertedAmount) || 0; // Handle NaN
        }
            total += amount;
            
            
        }

        document.getElementById('resultSched413B').value = formatCurrencyWithComma(Math.round(total)); // Format to 2 decimal places
        document.getElementById('frm1701MS:txtNonOperatingIncomeNo13b').value = formatCurrencyWithComma(Math.round(total));
        }










