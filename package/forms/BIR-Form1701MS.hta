            document.getElementById('frm1701MS:txtTotalIncomeTaxDueNo23b').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtNetSpecialRateNo21b').value) +
                NumWithComma(document.getElementById('frm1701MS:txtIncomeTaxRegularNo22b').value));
            computeP2No25SP();
        }

        // PART 2, ITEM 24 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
