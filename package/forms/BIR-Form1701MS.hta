        // Function to compute the total amount in Schedule 4 for the spouse


        function computeOthersched410A2() {
        var total = 0;
        for (var i = 0; i < specifyToCommit10A2.length; i++) {
        var currentAmount= specifyToCommit10A2[i].txtSpecifysched410A2Amount || '0';
        if(currentAmount === '0')
        {
            var amount = 0;
        }
        else
        {
            var convertedAmount = currentAmount.toString().replace(/,/g, '') || '0';

            var amount = parseFloat(convertedAmount) || 0; // Handle NaN
        }
            total += amount;
            
            
        }

        document.getElementById('resultsched410A2').value = formatCurrencyWithComma(Math.round(total)); // Format to 2 decimal places
        document.getElementById('frm1701MS:txtSpecialAllowableNo10b').value = formatCurrencyWithComma(Math.round(total));
        }













