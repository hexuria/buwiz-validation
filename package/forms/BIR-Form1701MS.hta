        function enableMonth(elem) {
            var month = d.getElementById('frm1701MS:txtMonthNo1');

        var currentMonth = ("0" + (new Date().getMonth() + 1)).slice(-2);
            if (elem.id == "frm1701MS:txtReturnPeriodNoNo3") {
                month.value = "12";
                month.disabled = true;
            } else {
                month.value = currentMonth;
                month.disabled = false;
            }
        }
        function enableYear(elem)
        {
        var year = d.getElementById('frm1701MS:txtYearNo1');
        var currentYear = new Date().getFullYear();
            if (elem.id == "frm1701MS:txtReturnPeriodNoNo3") {
                year.value = currentYear - 1;
                year.disabled = false;
            } else {
                year.value = currentYear - 1;
                year.disabled = false;
            }
        } 

        function checkNumberTP() {
            var checkRange = 3000000;
            var value1 = parseFloat(document.getElementById('frm1701MS:txtSalesRevenuesFeesANo19a').value.replace(/,/g, '')) || 0;
            var value2 = parseFloat(document.getElementById('frm1701MS:txtOtherNonOperatingIncomeNo20a').value.replace(/,/g, '')) || 0;
            var salesRevenuesTP = value1 + value2;
            
        if (salesRevenuesTP > checkRange && document.getElementById('frm1701MS:txtTaxpayerNo12b').checked == false) {
            resetFieldsToZeroOnDisable(
                // add specific fields here
                [
                "frm1701MS:txtSalesRevenuesFeesANo19a",
                "frm1701MS:txtOtherNonOperatingIncomeNo20a",
                "frm1701MS:txtTotalIncomeNo21a"
                ],
                false
            );

            // Recompute TP Part 4B2 Items 23, 24 and 25
            computeIncomeLoss();
            computeBusinessIncome();
            totalTaxDueCompensationAndBusinessIncome25TP();
            alert(' Your Gross Sales/Receipts and Other Non-Operating Income exceeds VAT Threshold (P3M), thus, not qualified to 8% tax rate and shall be subjected to graduated rates. Please choose Graduated Income Tax Rates in Part I Item 12 and fill out Part IV.B1.');
        }

        }


        function checkNumberSP() {
            var checkRangeSP = 3000000;
            var value1 = parseFloat(document.getElementById('frm1701MS:txtSalesRevenuesFeesANo19b').value.replace(/,/g, '')) || 0;
            var value2 = parseFloat(document.getElementById('frm1701MS:txtOtherNonOperatingIncomeNo20b').value.replace(/,/g, '')) || 0;
            var salesRevenuesSP = value1 + value2;
            
        if (salesRevenuesSP > checkRangeSP&& document.getElementById('frm1701MS:txtTaxpayerNo12b1').checked == false) {
            resetFieldsToZeroOnDisable(
                // add specific fields here
                [
                "frm1701MS:txtSalesRevenuesFeesANo19b",
                "frm1701MS:txtOtherNonOperatingIncomeNo20b",
                "frm1701MS:txtTotalIncomeNo21b"
                ],
                false
            );

            // Recompute SP Part 4B2 Items 23, 24 and 25
            computeIncomeLossb();
            computeBusinessIncomeb();
            totalTaxDueCompensationAndBusinessIncome25SP();
            alert(' Your Gross Sales/Receipts and Other Non-Operating Income exceeds VAT Threshold (P3M), thus, not qualified to 8% tax rate and shall be subjected to graduated rates. Please choose Graduated Income Tax Rates in Part I Item 12 and fill out Part IV.B1.');
            
        }
        } 

        function taxRateTP(){
            if (document.getElementById('frm1701MS:txtTaxpayerNo12b').checked || document.getElementById('frm1701MS:txtTaxpayerNo12c').checked || document.getElementById('frm1701MS:txtTaxpayerNo12d').checked) {
                document.getElementById('frm1701MS:txtTaxRatea'). disabled  = true;
            }
        }



        function taxRateSP(){
            if (document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked || document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked || document.getElementById('frm1701MS:txtTaxpayerNo12b1').checked) {
                document.getElementById('frm1701MS:txtTaxRateb'). disabled  = true;
            }
        }



        function toBeCarried() {

        var toBeCarriedTP = document.getElementById('frm1701MS:txtToBeCarried1');

        var priorYearsTP = document.getElementById('frm1701MS:txtPriorYearsNo1a');

        var priorYearsSP = document.getElementById('frm1701MS:txtPriorYearsNo1b');



        // Get the values as numbers (parse to float or integer depending on your needs)

        var toBeCarriedValue = parseFloat(toBeCarriedTP.value);

        var priorYearsValue = parseFloat(priorYearsTP.value);

        var priorYearsSPValue = parseFloat(priorYearsSP.value);



        // Find the maximum value between txtPriorYearsNo1a and txtPriorYearsNo1b

        var maxPriorYears = Math.max(priorYearsValue, priorYearsSPValue);



        // Check if the value of txtToBeCarried1 exceeds the maximum of the two prior years

        if (toBeCarriedValue > maxPriorYears) {

            alert("The value of 'To Be Carried' cannot be higher than the maximum of 'Prior Years No 1a' and 'Prior Years No 1b'.");

            

            // Reset the value of txtToBeCarried1 to 0.00

            toBeCarriedTP.value = "0"; // Reset to 0.00 if the condition is met

        }

        }


        function clearFieldsOnRadioChange() {
        // Array of field ids to clear
        var fieldsToClear = [
            'frm1701MS:txtAllowableItemizedDeductionsNo10a',
            'frm1701MS:txtSpecialAllowableNo10a',
            'frm1701MS:txtNetOperatingLossNo10a',
            'frm1701MS:txtTotalAllowableItemixedDeductionsNo10a',
            'frm1701MS:txtNetIncomeLossNo12a',
            'frm1701MS:txtNonOperatingIncomeNo13a',
            'frm1701MS:txtTaxableIncomeBusinesNo14a',
            'frm1701MS:txtCompensationBusinessNo15a',
            'frm1701MS:txtOptionalDeductionNo11a'


        ];

        // Loop through the fields and clear each value
        for (var i = 0; i < fieldsToClear.length; i++) {
            var field = document.getElementById(fieldsToClear[i]);
            if (field) {
                field.value = ''; // Clear the field value
            
            }
        }

        //clear modal
        resetModalTP();
        resetModalOtherTax();
        }


        function clearFieldsOnRadioChangeSpouse() {
        // Array of field ids to clear
        var fieldsToClear = [
            // 'frm1701MS:txtAllowableItemizedDeductionsNo10aSpouse',
            // 'frm1701MS:txtSpecialAllowableNo10b',
            'frm1701MS:txtNetOperatingLossNo10b',
            // 'frm1701MS:txtTotalAllowableItemixedDeductionsNo10b',
            // 'frm1701MS:txtNetIncomeLossNo12b',
            // 'frm1701MS:txtNonOperatingIncomeNo13b',
            // 'frm1701MS:txtTaxableIncomeBusinesNo14b',
            // 'frm1701MS:txtCompensationBusinessNo15b',
            // 'frm1701MS:txtOptionalDeductionNo11b'


        ];

        // Loop through the fields and clear each value
        for (var i = 0; i < fieldsToClear.length; i++) {
            var field = document.getElementById(fieldsToClear[i]);
            if (field) {
                field.value = ''; // Clear the field value
                field.disabled = false;
            }
        }

         //clear modal
        resetModalSP();
        resetModalOtherTax();
        }



