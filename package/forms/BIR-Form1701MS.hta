        // ==========START HELPERS==========
        // Set inputs enable/disable
        function setFieldsEnabled(fieldIds, enable) {
            if (!fieldIds || !fieldIds.length) { return; }
            for (var i = 0; i < fieldIds.length; i++) {
                var el = document.getElementById(fieldIds[i]);
                if (el) {
                    el.disabled = !enable;
                }
            }
        }

        // Set links enable/disable
        function setLinkEnabled(el, enable, defaultHandler) {
            // Cache original onclick only once
            if (typeof el._originalOnClick === 'undefined') {
                el._originalOnClick = el.onclick || null;
            }

            if (enable) {
                el.style.pointerEvents = 'auto';
                el.style.cursor = 'pointer';
                el.style.color = '';
                // el.style.removeProperty('color');
                el.removeAttribute('aria-disabled');
                el.setAttribute('tabindex', '0');

                // Restore original or supplied handler
                el.onclick = el._originalOnClick || defaultHandler;

                if (typeof el.disabled !== 'undefined') {
                    el.disabled = false;
                }
            } else {
                el.onclick = null;
                el.style.pointerEvents = 'none';
                el.style.cursor = 'not-allowed';
                el.style.color = '#999';
                el.setAttribute('aria-disabled', 'true');
                el.setAttribute('tabindex', '-1');

                if (typeof el.disabled !== 'undefined') {
                    el.disabled = true;
                }
            }
        }

