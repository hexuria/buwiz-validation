        // PART 1, ITEM 18 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function checkButtons() {
            var btn11IncomeBusiness = document.getElementById("frm1701MS:txtTaxpayerNo11a");
            var btn11IncomeProfession = document.getElementById("frm1701MS:txtTaxpayerNo11c");
            var btn11mixedIncome = document.getElementById("frm1701MS:txtTaxpayerNo11b");
            var btn12graduatedIncome = document.getElementById("frm1701MS:txtTaxpayerNo12b");
            var btn12exempt = document.getElementById("frm1701MS:txtTaxpayerNo12d");
            var btn12special = document.getElementById("frm1701MS:txtTaxpayerNo12e");
            var btn12incomeTax = document.getElementById("frm1701MS:txtTaxpayerNo12c");
            var btn12graduatedIncome = document.getElementById("frm1701MS:txtTaxpayerNo12b");
            var taxCodeDropdown = document.getElementById("taxCodeDropdown");

            // Check if both buttons btn11IncomeBusiness and btn12graduatedIncome are selected (checked)
            if (btn11IncomeBusiness.checked && btn12graduatedIncome.checked) {
                // Select "II012" Business Income- Graduated IT Rates in the dropdown
                taxCodeDropdown.value = "II012";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
                enableFieldsII012();
            }
            // Check if both buttons btn11IncomeBusiness and btn12exempt are selected (checked)
            else if (btn11IncomeBusiness.checked && btn12exempt.checked) {
                // Select "II012" Business Income- Graduated IT Rates in the dropdown
                taxCodeDropdown.value = "II012";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
                enableFieldsII012();
            } else if (btn11IncomeBusiness.checked && btn12special.checked) {
                // Select "II012" Business Income- Graduated IT Rates in the dropdown
                taxCodeDropdown.value = "II012";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
                enableFieldsII012();
            } else if (btn11IncomeBusiness.checked && btn12incomeTax.checked) {
                // Select "II015" Business Income-8% IT Rate in the dropdown
                taxCodeDropdown.value = "II015";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
            } else if (btn11IncomeProfession.checked && btn12graduatedIncome.checked) {
                // Select "II015" II014 Income from Profession - Graduated IT Rates in the dropdown
                taxCodeDropdown.value = "II014";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
            } else if (btn11IncomeProfession.checked && btn12exempt.checked) {
                // Select "II015" II014 Income from Profession - Graduated IT Rates in the dropdown
                taxCodeDropdown.value = "II014";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
            } else if  (btn11IncomeProfession.checked && btn12special.checked) {
                // Select "II015" II014 Income from Profession - Graduated IT Rates in the dropdown
                taxCodeDropdown.value = "II014";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
            } else if (btn11IncomeProfession.checked && btn12incomeTax.checked) {
                // Select "II015" II017 Income from Profession – 8% IT Rate in the dropdown
                taxCodeDropdown.value = "II017";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
            } else if (btn11mixedIncome.checked && btn12graduatedIncome.checked) {
                // Select "II013" II013 Mixed Income – Graduated IT Rates in the dropdown
                taxCodeDropdown.value = "II013";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
            } else if  (btn11mixedIncome.checked && btn12incomeTax.checked) {
                // Select "II016" II016 Mixed Income – 8% IT Rate in the dropdown
                taxCodeDropdown.value = "II016";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
            }  else if  (btn11mixedIncome.checked && btn12exempt || btn12special.checked) {
                // Select "II013" II013 Mixed Income – 8% IT Rate in the dropdown
                taxCodeDropdown.value = "II013";
                taxCodeDropdown.disabled = true;
                creditableTaxWithheldForm2316();
            } else {
                // Optionally, clear the selection if neither condition is met
                taxCodeDropdown.value = "";
                creditableTaxWithheldForm2316();
            }
        }

