            <!-- START - OF FORM ===================== ===================== ===================== -->
            <form id="frmMain" name="frmMain">
                <div id="container">
                    <div id="wrapper" style="margin: 0 auto; position: relative; width:1020px; ">
                        <table border="0" width="850" cellspacing="0" cellpadding="0" align="center" style="background-image: url(../img/frmbg.png); background-repeat: repeat-x;">
                            <tr>
                                <td>
                                    <div id="formPaper">
                                        <div id="mainContent">
                                            <!-- START - PAGE 1 ===================== ===================== ===================== -->
                                            <div id="Page1Content" style="margin: 0; display: block; position: relative; width: 850px;" class="noCellSpace">
                                                <table width="850" border="0" cellspacing="0" cellpadding="0">
                                                    <!-- LOGO ===================== ===================== ===================== -->
                                                    <tr>
                                                        <td>
                                                            <table border="0" cellspacing="0" cellpadding="0" margin="0" style="height: 0px;">
                                                                <tr>
                                                                    <td width="200" valign="bottom">
                                                                        <p><img src="../img/bcs_new.png" width="80" /> </p>
                                                                    </td>
                                                                    <td align="center" v-align="top">
                                                                        <p><img src="../img/header_logo1.png" width="210" height="50px" /> </p>
                                                                    </td>
                                                                    <td width="300">
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                    <!-- HEADER ===================== ===================== ===================== -->
                                                    <tr>
                                                        <td>
                                                            <table border="1" cellspacing="0" cellpadding="0">
                                                                <tr>
                                                                    <td width="145" valign="center" align="center">
                                                                        <font face="Arial" size="1px">BIR Form No.</font>
                                                                        <br/><font size="5px" style="font-weight:bold;">1701-MS</font>
                                                                        <br/><font face="Arial" size="1px">August 2024</font>
                                                                        <br/><font face="Arial" size="1px" style="font-weight:bold;">Page 1</font>
                                                                    </td>
                                                                    <td width="0" align="center" v-align="top">
                                                                        <span style="font-weight: bold; font-size: 25px; ">Annual Income Tax Return</span>
                                                                        <br/><font face="Arial" size="1px" style="font-weight:bold; font-size: 12px;">For Individuals Classified as MICRO or SMALL Taxpayers</font>
                                                                        <br/><font face="Arial" size="1px" style="font-size: 11px; font-style: italic;">Enter all required information in CAPITAL LETTERS using black ink. Mark applicable boxes with an "X".</font>
                                                                    </td>
                                                                    <td width="200" valign="center">
                                                                        <p><img src="../img/1701MS_BarCode/1701MS_P1.jpg" width="220" height="75px" /> </p>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                    <!-- ITEMS 1 - 5 ===================== ===================== ===================== -->
                                                    <tr>
                                                        <td>
                                                            <table border="0" cellspacing="0" cellpadding="0" class="tblForm" style="border: #000000 1px solid;">
                                                                <tr>
                                                                    <!-- NUMBER 1 ===================== ===================== ===================== -->
                                                                    <td class="tblFormTd" height="20px" width="30%">
                                                                        <span class="smallBold">&nbsp;1&nbsp;</span>
                                                                        <span class="small">For the Year</span>
                                                                        <span class="xsmallItalic">(MM/YYYY)</span>
                                                                        <select 
                                                                            id="frm1701MS:txtMonthNo1" 
                                                                            name="frm1701MS:txtMonthNo1"
                                                                                size="1">
                                                                            <option value="01">01</option>
                                                                            <option value="02">02</option>
                                                                            <option value="03">03</option>
                                                                            <option value="04">04</option>
                                                                            <option value="05">05</option>
                                                                            <option value="06">06</option>
                                                                            <option value="07">07</option>
                                                                            <option value="08">08</option>
                                                                            <option value="09">09</option>
                                                                            <option value="10">10</option>
                                                                            <option value="11">11</option>
                                                                            <option value="12" selected disabled>12</option>
                                                                        </select>
                                                                        <input 
                                                                            id="frm1701MS:txtYearNo1" 
                                                                            name="frm1701MS:txtYearNo1"
                                                                            maxlength="4" 
                                                                            size="2" 
                                                                            type="text" 
                                                                            value="" 
                                                                            onkeypress="return wholenumber(this, event)" 
                                                                        
                                                                        
                                                                        />
                                                                    </td>
                                                                    <!-- NUMBER 2 ===================== ===================== ===================== -->
                                                                    <td class="tblFormTd" height="20px">
                                                                        <span class="smallBold">&nbsp;2&nbsp;</span>
                                                                        <span class="small">Amended Return</span>
                                                                        <input 
                                                                            
                                                                            id="frm1701MS:txtAmendedYesNo2" 
                                                                            name="frm1701MS:txtAmended" 
                                                                            type="radio"
                                                                            value="Y" 
                                                                            class="styled" 
                                                                            onclick='validateAmendedReturn("yes");' 
                                                                            
                                                                        />
                                                                        <span class="small">Yes</span>&nbsp;&nbsp;&nbsp;&nbsp;
                                                                        <input 
                                                                            id="frm1701MS:txtAmendedNoNo2" 
                                                                            name="frm1701MS:txtAmended" 
                                                                            type="radio"
                                                                            value="N" 
                                                                            class="styled" 
                                                                            checked="checked"
                                                                            onclick='validateAmendedReturn("no");' 
                                                                        />
                                                                        <span class="small">No</span>
                                                                    </td>
                                                                    <!-- NUMBER 3 ===================== ===================== ===================== -->
                                                                    <td class="tblFormTd" height="20px">
                                                                        <span class="smallBold">&nbsp;3&nbsp;</span>
                                                                        <span class="small">Short Period Return</span>
                                                                        <input 
                                                                            onclick='shortPeriodReturn("yes");enableMonth(this);enableYear(this);limitMonthOptions()' 
                                                                            id="frm1701MS:txtReturnPeriodYesNo3" 
                                                                            name="frm1701MS:txtReturnPeriod" 
                                                                            type="radio"
                                                                            value="Y" 
                                                                            class="styled" 
                                                                            
                                                                        />
                                                                        <span class="small">Yes</span>&nbsp;&nbsp;&nbsp;&nbsp;
                                                                        <input 
                                                                            onclick='shortPeriodReturn("no");enableMonth(this);enableYear(this);limitMonthOptions()'
                                                                            onchange='shortPeriodReturn("no");enableMonth(this);enableYear(this);limitMonthOptions()'
                                                                            id="frm1701MS:txtReturnPeriodNoNo3" 
                                                                            name="frm1701MS:txtReturnPeriod" 
                                                                            type="radio"
                                                                            value="N" 
                                                                            class="styled" 
                                                                            checked="checked"
                                                                            
                                                                        />
                                                                        <span class="small">No</span>
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <!-- NUMBER 4 ===================== ===================== ===================== -->
                                                                    <td class="tblFormTd" height="20px" width="30%">
                                                                        <span class="smallBold">&nbsp;4&nbsp;</span>
                                                                        <span class="small">Civil Status</span>&nbsp;&nbsp;&nbsp;

                                                                        <select id="frm1701MS:civilStatus" name="frm1701MS:civilStatus" onchange="toggleLine5()">
                                                                            <option value="Single">Single</option>
                                                                            <option value="Married">Married</option>
                                                                            <option value="Widowed">Widow/er</option>
                                                                            <option value="Separated">Legally Separated</option>
                                                                                <option value="Not Applicable">Not Applicable</option>
                                                                        </select>
                                                                    </td>
                                                                    <!-- NUMBER 5 ===================== ===================== ===================== -->
                                                                    <td class="tblFormTd" height="20px" colspan="2">
                                                                        <span class="smallBold">&nbsp;5&nbsp;</span>
                                                                        <span class="small">If married, you are filling &nbsp;</span>
                                                                        <input 
                                                                            onclick='marriedJointly("jointly");' 
                                                                            id="frm1701MS:txtIfMarriedJointlyNo5" 
                                                                            name="frm1701MS:txtIfMarried" 
                                                                            type="radio"
                                                                            value="1" 
                                                                            class="styled" 
                                                                            disabled
                                                                        />
                                                                        <span class="small">Jointly</span>&nbsp;&nbsp;
                                                                        <input 
                                                                            onclick='marriedJointly("separately");' 
                                                                            id="frm1701MS:txtIfMarriedSeparatelyNo5" 
                                                                            name="frm1701MS:txtIfMarried" 
                                                                            type="radio"
                                                                            value="2" 
                                                                            class="styled" 
                                                                            disabled
                                                                        />
                                                                        <span class="small">Separately</span>&nbsp;&nbsp;
                                                                        <input 
                                                                                onclick='marriedJointly("notApplicable");' 
                                                                            id="frm1701MS:txtIfMarriedNotApplicableNo5" 
                                                                            name="frm1701MS:txtIfMarried" 
                                                                            type="radio"
                                                                            value="3" 
                                                                            class="styled" 
                                                                            disabled
                                                                        />
                                                                        <span class="small">Not applicable, spouse has no income</span>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                    <!-- ITEMS 6 - 19 ===================== ===================== ===================== -->
                                                    <tr>
                                                        <td>
                                                            <table class="tblForm" border="0" cellspacing="0" cellpadding="0" style="border: #000000 1px solid;">
                                                                <!-- PART I - TAXPAYER / FILER AND SPOUSE INFORMATION ===================== ===================== ===================== -->
                                                                <tr align="center">
                                                                    <td class="tblFormTd" height="20px" colspan="3">
                                                                        <span class="smallBold">Part I - Taxpayer/Filer and Spouse Information</span>
                                                                    </td>
                                                                </tr>
                                                                <!-- PART I - HEADER ===================== ===================== ===================== -->
                                                                <tr align="center">
                                                                    <td class="tblFormTd" height="20px">
                                                                        <span class="smallBold">Particulars</span>
