        // Function to compute the total amount in Schedule 4 for the spouse

        function computeOthersched410A1() {
        var total = 0;
        for (var i = 0; i < specifyToCommit10A1.length; i++) {
        var currentAmount= specifyToCommit10A1[i].txtSpecifysched410A1Amount || '0';
        if(currentAmount === '0')
        {
            var amount = 0;
        }
        else
        {
            var convertedAmount = currentAmount.toString().replace(/,/g, '') || '0';

            var amount = parseFloat(convertedAmount) || 0; // Handle NaN
        }
            total += amount;
            
            
        }

        document.getElementById('resultsched410A1').value = formatCurrencyWithComma(Math.round(total)); // Format to 2 decimal places
        document.getElementById('frm1701MS:txtSpecialAllowableNo10a').value = formatCurrencyWithComma(Math.round(total));
        }



