        function validationSpecify10BSpouse() {
            var size = specifyToCommit10A2.length;
            for (var i = 0; i < size; i++) {
                if (document.getElementById('frm1701MS:sched410A2:Description' + i).value == "" || 
                    document.getElementById('frm1701MS:sched410A2:LegalBasis' + i).value == "" ||
                    document.getElementById('frm1701MS:sched410A2:Amount' + i).value == "0") {
                    alert("Empty fields are not allowed"); 
                    return;
                }
            }
            return true;
        }



