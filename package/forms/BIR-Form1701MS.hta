                "frm1701MS:txtIfMarriedSeparatelyNo5",          // item 5 - Separately
                "frm1701MS:txtIfMarriedNotApplicableNo5",       // item 5 - Not Applicable
                "frm1701MS:perjuryClause",                      // Perjury Clause
                "frm1701MS:printedName",                        // Taxpayer Name Representative
                "frm1701MS:authorizeRepresentative",            // Taxpayer TIN Representative
                "frm1701MS:txtPg1I33NumberOfAttachments"        // item 35
                ], 
                true
            );
            
            d.getElementById('frm1701MS:btnValidate').disabled = false;
            d.getElementById('frm1701MS:btnEdit').disabled = true;
            d.getElementById('btnSave').disabled = true;
            d.getElementById('frm1701MS:btnFinalCopy').disabled = true;
            d.getElementById('btnPrint').disabled = true;

            disableElem;
            enableElem;
        }

        function roundupdown(num){
            var x = Math.round(NumWithComma(num.value));
            num.value = formatCurrencyWithComma(NumWithComma(x.toString()));
        }

        // NUMBER 2 - AMENDED RETURN 
        function validateAmendedReturn() {
            if (document.getElementById('frm1701MS:txtAmendedYesNo2').checked) {
                document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6a').disabled = false;

                if (document.getElementById('frm1701MS:txtIfMarriedJointlyNo5').checked) {
                    document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6b').disabled = false;
                } else {
                    document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6b').disabled = true;
                   
                    resetFieldsToZeroOnDisable(
                        // add specific fields here
                        [
                        "frm1701MS:txtTaxPaidPreviouslyFiledNo6b"
                        ],
                        false
                    );

                    computeCreditsPaymentsPartVNo10b();computeP2No25SP();
                    computeAggregateAmountNo30();
                }
            } 
            
            else if (document.getElementById('frm1701MS:txtAmendedNoNo2').checked) {
                document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6a').disabled = true;
                document.getElementById('frm1701MS:txtTaxPaidPreviouslyFiledNo6b').disabled = true;

                resetFieldsToZeroOnDisable(
                    // add specific fields here
                    [
                    "frm1701MS:txtTaxPaidPreviouslyFiledNo6a",
                    "frm1701MS:txtTaxPaidPreviouslyFiledNo6b"
                    ],
                    false
                );

                computeCreditsPaymentsPartVNo10a();computeP2No25TP();
                computeCreditsPaymentsPartVNo10b();computeP2No25SP();
                computeAggregateAmountNo30();
            }
        }

        function AllControlDisabled(state){
            documentary.getElementById('frm1701MS:txtAmendedYesNo2'). disabled = state;
            document.getElementById('frm1701MS:txtAmendedNoNo2'). disabled= state;
        }

        function isItAnAmendedReturn(xmlFile) {
            if (document.getElementById('frm1701MS:txtAmendedYesNo2').checked) {
                return true;
            } else {
                return false;
            }
        }



        function validateCurrentYear() {

        var month = document.getElementById('frm1701MS:txtMonthNo1').value;
        var year = document.getElementById('frm1701MS:txtYearNo1').value;

        var currentYear = new Date().getFullYear();
        var currentMonth = ("0" + (new Date().getMonth() + 1)).slice(-2);

        // Ensure the input year is not a future year
        if (parseInt(year) > currentYear) {
            alert("Future filing is not allowed. Please enter a valid year.");
            return;
            
        }

        // Ensure the input month is not in the future of the current year
        if (parseInt(year) === currentYear && parseInt(month) > parseInt(currentMonth)) {
            alert("Future filing is not allowed. Please enter a valid month.");
            return false;
        }

        if (document.getElementById('frm1701MS:txtReturnPeriodYesNo3').checked) {
            if (month == "00" || year == "") {
                alert("Please enter a valid month and year for Item 1.");
                return false;
            }
            if (year != currentYear.toString() || month != currentMonth) {
                alert("For short period return, the month should be the current month and the year should be the current year.");
                return false;
            }
        } else {
            if (month != "12" || year != (currentYear - 1).toString()) {
                return false;
            }
        }
        return true;
        }

        function marriedJointly(jointly) {

            // item 5 has 3 options, "jointly", "separately", "notapplicable". 
