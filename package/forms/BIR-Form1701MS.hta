        // Function to compute the total amount in Schedule 4 for the spouse

        function computeOtherSched420B() {
        var total = 0;
        for (var i = 0; i < specifyToCommit20B.length; i++) {
        var currentAmount= specifyToCommit20B[i].txtSpecifySched420BAmount || '0';
        if(currentAmount === '0')
        {
            var amount = 0;
        }
        else
        {
            var convertedAmount = currentAmount.toString().replace(/,/g, '') || '0';

            var amount = parseFloat(convertedAmount) || 0; // Handle NaN
        }
            total += amount;
            
            
        }

        document.getElementById('resultSched420B').value = formatCurrencyWithComma(Math.round(total));
        document.getElementById('frm1701MS:txtOtherNonOperatingIncomeNo20b').value = formatCurrencyWithComma(Math.round(total));
        }














