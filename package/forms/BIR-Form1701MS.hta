        //NUMBER 16 EFFECTIVITY DATE OF TAX/RELIEF EXEMPTION
        function validateEffectivityDateTaxpayer16(){

            var monthFiled = document.getElementById('frm1701MS:txtMonthNo1').value;
            var yearFiled = document.getElementById('frm1701MS:txtYearNo1').value;
            var filingDate = new Date(yearFiled, monthFiled - 1, 1);

            var taxpayerDateFrom = new Date(document.getElementById('frm1701MS:txtTaxpayerNo16a').value);
            var taxpayerDateTo = new Date(document.getElementById('frm1701MS:txtTaxpayerNo16a1').value);

            if(document.getElementById('frm1701MS:txtReturnPeriodYesNo3').checked == true){
                var lastDayOfMonth = new Date(yearFiled, monthFiled, 0);
                if (taxpayerDateFrom >= lastDayOfMonth){
                    alert("Invalid date. Taxpayer Item 16 From date must be earlier than " + monthFiled + "/" + lastDayOfMonth.getDate() + "/" + yearFiled + ".");
                    return false;
                }
                if (taxpayerDateTo && taxpayerDateTo < lastDayOfMonth){
                    alert("Invalid date. Taxpayer Item 16 To date must be " + monthFiled + "/" + lastDayOfMonth.getDate() + "/" + yearFiled + " and onwards.");
                    return false;
                }

                return true;
            }
            else {
                var monthFiled = document.getElementById('frm1701MS:txtMonthNo1').value;
                var yearFiled = document.getElementById('frm1701MS:txtYearNo1').value;
                var taxpayerDateFrom = new Date(document.getElementById('frm1701MS:txtTaxpayerNo16a').value);
                var taxpayerDateTo = new Date(document.getElementById('frm1701MS:txtTaxpayerNo16a1').value);
                var lastDayOfMonth = new Date(yearFiled, monthFiled, 0);

                if (taxpayerDateFrom >= lastDayOfMonth){
                    alert("Invalid date. Taxpayer Item 16 From date must be earlier than " + monthFiled + "/" + lastDayOfMonth.getDate() + "/" + yearFiled + ".");
                    return false;
                }
                if (taxpayerDateTo && taxpayerDateTo < lastDayOfMonth){
                    alert("Invalid date. Taxpayer Item 16 To date must be " + monthFiled + "/" + lastDayOfMonth.getDate() + "/" + yearFiled + " and onwards.");
                    return false;
                }

                return true;
            }
        }

        function validateEffectivityDateSpouse16(){
            var monthFiled = document.getElementById('frm1701MS:txtMonthNo1').value;
            var yearFiled = document.getElementById('frm1701MS:txtYearNo1').value;
            var filingDate = new Date(yearFiled, monthFiled - 1, 1);

            var taxpayerDateFrom = new Date(document.getElementById('frm1701MS:txtTaxpayerNo16b').value);
            var taxpayerDateTo = new Date(document.getElementById('frm1701MS:txtTaxpayerNo16b1').value);

            if(document.getElementById('frm1701MS:txtReturnPeriodYesNo3').checked == true){
                var lastDayOfMonth = new Date(yearFiled, monthFiled, 0);
                if (taxpayerDateFrom >= lastDayOfMonth){
                    alert("Invalid date. Spouse Item 16 From date must be earlier than " + monthFiled + "/" + lastDayOfMonth.getDate() + "/" + yearFiled + ".");
                    return false;
                }
                if (taxpayerDateTo && taxpayerDateTo < lastDayOfMonth){
                    alert("Invalid date. Spouse Item 16 To date must be " + monthFiled + "/" + lastDayOfMonth.getDate() + "/" + yearFiled + " and onwards.");
                    return false;
                }

                return true;
            }
            else {
                var monthFiled = document.getElementById('frm1701MS:txtMonthNo1').value;
                var yearFiled = document.getElementById('frm1701MS:txtYearNo1').value;
                var taxpayerDateFrom = new Date(document.getElementById('frm1701MS:txtTaxpayerNo16b').value);
                var taxpayerDateTo = new Date(document.getElementById('frm1701MS:txtTaxpayerNo16b1').value);
                var lastDayOfMonth = new Date(yearFiled, monthFiled, 0);

                if (taxpayerDateFrom >= lastDayOfMonth){
                    alert("Invalid date. Spouse Item 16 From date must be earlier than " + monthFiled + "/" + lastDayOfMonth.getDate() + "/" + yearFiled + ".");
                    return false;
                }
                if (taxpayerDateTo && taxpayerDateTo < lastDayOfMonth){
                    alert("Invalid date. Spouse Item 16 To date must be " + monthFiled + "/" + lastDayOfMonth.getDate() + "/" + yearFiled + " and onwards.");
                    return false;
                }

                return true;
            }
        }

