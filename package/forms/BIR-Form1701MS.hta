        // PART 2, ITEM 26 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function validateInput26a() {

            var el26 = document.getElementById('frm1701MS:txtTaxDueAllowedNo26a');
            var el23 = document.getElementById('frm1701MS:txtTotalIncomeTaxDueNo23a');
            var el25 = document.getElementById('frm1701MS:txtTaxPayableNo25a');

            if (!el26 || !el23 || !el25) { return; }

            // Convert all fields to clean numbers (comma-safe)
            var input26  = NumWithComma(el26.value);    // Item 26a (user input)
            var item23   = NumWithComma(el23.value);    // Item 23a
            var item25   = NumWithComma(el25.value);    // Item 25a
            var half23   = item23 / 2;                  // 50% of item 23a

            // 3️⃣ Rule: If item 25 < 0 → disable item 26 and reset
            if (item25 < 0) {
                el26.disabled = true;
                el26.value = "0";
                return;
            } else {
                // Ensure enabled when item 25 is valid
                el26.disabled = false;
            }

            // 1️⃣ Must not exceed 50% of Item 23
            if (input26 > half23) {
                alert("The amount exceeds the allowed input based on the requirements");
                el26.value = "0";
                el26.focus();
                return;
            }

            // 2️⃣ Must not exceed Item 25
            if (input26 > item25) {
                alert("The amount exceeds the allowed input based on the requirements");
                el26.value = "0";
                el26.focus();
                return;
            }
        }

        function validateInput26b() {

            var el26 = document.getElementById('frm1701MS:txtTaxDueAllowedNo26b');
            var el23 = document.getElementById('frm1701MS:txtTotalIncomeTaxDueNo23b');
            var el25 = document.getElementById('frm1701MS:txtTaxPayableNo25b');

            if (!el26 || !el23 || !el25) { return; }

            // Convert to numeric (comma-safe)
            var input26 = NumWithComma(el26.value);     // Item 26b user input
            var item23  = NumWithComma(el23.value);     // Item 23b
            var item25  = NumWithComma(el25.value);     // Item 25b
            var half23 = item23 / 2;                    // 50% of item 23b

            // 3️⃣ Rule: If item 25 < 0 → disable item 26 and reset
            if (item25 < 0) {
                el26.disabled = true;
                el26.value = "0";
                return;
            } else {
                // Ensure enabled when item 25 is valid
                el26.disabled = false;
            }

            // 1️⃣ Must not exceed 50% of Item 23
            if (input26 > half23) {
                alert("The amount exceeds the allowed input based on the requirements");
                el26.value = "0";
                el26.focus();
                return;
            }

            // 2️⃣ Must not exceed Item 25
            if (input26 > item25) {
                alert("The amount exceeds the allowed input based on the requirements");
                el26.value = "0";
                el26.focus();
                return;
            }
        }

        // PART 2, ITEM 27 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function calculateP2No27TP() {
            document.getElementById('frm1701MS:txtAmountPayableNo27a').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtTaxPayableNo25a').value) - 
                NumWithComma(document.getElementById('frm1701MS:txtTaxDueAllowedNo26a').value));
            computeTotalAmountPayableNo29a();
        }

        function calculateP2No27SP() {
            document.getElementById('frm1701MS:txtAmountPayableNo27b').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtTaxPayableNo25b').value) - 
                NumWithComma(document.getElementById('frm1701MS:txtTaxDueAllowedNo26b').value));
            computeTotalAmountPayableNo29b();
        }

        // PART 2, ITEM 28 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeTotalPenaltiesNo28a() {
            document.getElementById('frm1701MS:txtTotalPenaltiesNo28a').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtSurchangeNo28a').value) + 
            NumWithComma(document.getElementById('frm1701MS:txtInterestNo28a').value) + NumWithComma(document.getElementById('frm1701MS:txtCompromise28a').value))
        }

        function computeTotalPenaltiesNo28b() {
            document.getElementById('frm1701MS:txtTotalPenaltiesNo28b').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtSurchangeNo28b').value) + 
            NumWithComma(document.getElementById('frm1701MS:txtInterestNo28b').value) + NumWithComma(document.getElementById('frm1701MS:txtCompromise28b').value))
        }

        // PART 2, ITEM 29 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeTotalAmountPayableNo29a() {
        //  If Item 27 < 0 AND Item 28D > 0, Item 29 must be equal to Item 28D.
        if(NumWithComma(document.getElementById('frm1701MS:txtAmountPayableNo27a').value) < 0 && NumWithComma(document.getElementById('frm1701MS:txtTotalPenaltiesNo28a').value) > 0 )
        {
            document.getElementById('frm1701MS:txtTotalAmountPayableNo29a').value =  formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtTotalPenaltiesNo28a').value));
        }
        
        // Normal computation:
        // Item 29 = Item 27 + Item 28D
        else{
            document.getElementById('frm1701MS:txtTotalAmountPayableNo29a').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtAmountPayableNo27a').value) +
                NumWithComma(document.getElementById('frm1701MS:txtTotalPenaltiesNo28a').value));
        }
            
            computeAggregateAmountNo30();
        }

        function computeTotalAmountPayableNo29b() {
            //  If Item 27 < 0 AND Item 28D > 0, Item 29 must be equal to Item 28D.
            if(NumWithComma(document.getElementById('frm1701MS:txtAmountPayableNo27b').value) < 0 && NumWithComma(document.getElementById('frm1701MS:txtTotalPenaltiesNo28b').value) > 0 )
            {
            document.getElementById('frm1701MS:txtTotalAmountPayableNo29b').value =  formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtTotalPenaltiesNo28b').value));

            }
            // Normal computation:
            // Item 29 = Item 27 + Item 28D
            else{
                document.getElementById('frm1701MS:txtTotalAmountPayableNo29b').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtAmountPayableNo27b').value) +
                NumWithComma(document.getElementById('frm1701MS:txtTotalPenaltiesNo28b').value));
            }
            computeAggregateAmountNo30();
        }

        // PART 2, ITEM 230 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeAggregateAmountNo30() {

            // initiate value
                var item29A = NumWithComma(document.getElementById('frm1701MS:txtTotalAmountPayableNo29a').value);
                var item29B = NumWithComma(document.getElementById('frm1701MS:txtTotalAmountPayableNo29b').value);
                var item30 = 0;  // final computed amount

                // If either 29A or 29B is negative
                if (item29A < 0 || item29B < 0) {

                    //if 29A negative and 29B positive use 29B
                    if (item29A < 0 && item29B > 0) {
                        item30 = item29B;
                    }

                    //if 29B negative and 29A positive use 29A
                    else if (item29B < 0 && item29A > 0) {
                        item30 = item29A;
                    }

                    // if both negative add 
                    else {
                        item30 = item29A + item29B;
                    }
                }
                // If both values are positive add
                else {
                    item30 = item29A + item29B;
                }

                
                // if Item 30 becomes positive or zero disable & clear Item 31
                var refundChk  = document.getElementById("frm1701MS:txtToBeRefunded");
                var issuedChk  = document.getElementById("frm1701MS:txtToBeIssued");
                var carriedChk = document.getElementById("frm1701MS:txtToBeCarried");

                var refundTxt  = document.getElementById("frm1701MS:txtToBeRefunded1");
                var issuedTxt  = document.getElementById("frm1701MS:txtToBeIssued1");
                var carriedTxt = document.getElementById("frm1701MS:txtToBeCarried1");

                if (item30 >= 0) {

                    // disable & clear everything
                    disable(refundChk, refundTxt);
                    disable(issuedChk, issuedTxt);
                    disable(carriedChk, carriedTxt);

                    // uncheck checkboxes
                    refundChk.checked  = false;
                    issuedChk.checked  = false;
                    carriedChk.checked = false;

                }


                document.getElementById('frm1701MS:txtAggregateAmountPayable30a').value =
                    formatCurrencyWithComma(item30);

                
                updateItem31Fields(item30)

        }

        //enable if item 30 has negative value, disable if item 31 has positive value
        function updateItem31Fields(item30) {

            var refundChk = document.getElementById('frm1701MS:txtToBeRefunded');
            var issuedChk = document.getElementById('frm1701MS:txtToBeIssued');
            var carriedChk = document.getElementById('frm1701MS:txtToBeCarried');

            if (item30 < 0) {
                // enable all three choices
                enable(refundChk, null);
                enable(issuedChk, null);
                enable(carriedChk, null);
            }
            else {
                // disable all three choices
                disable(refundChk, null);
                disable(issuedChk, null);
                disable(carriedChk, null);
            }
        }

        
        // PART 4, SCHEDULE A, ITEM 3 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function calculateNo3TP() {
            
            var isMixedIncome = document.getElementById('frm1701MS:txtTaxpayerNo11b');

            var isGraduated   = document.getElementById('frm1701MS:txtTaxpayerNo12b');
            var isExempt      = document.getElementById('frm1701MS:txtTaxpayerNo12d');
            var isSpecial     = document.getElementById('frm1701MS:txtTaxpayerNo12e');
            var is8Percent    = document.getElementById('frm1701MS:txtTaxpayerNo12c');

            var valueP2Item22 = document.getElementById('frm1701MS:txtIncomeTaxRegularNo22a');

            var valueItem1    = stringToNum(document.getElementById("frm1701MS:txtGrossa").value);
            var valueItem2    = stringToNum(document.getElementById('frm1701MS:txtLessNonTaxablea').value);
            var valueItem3    = document.getElementById('frm1701MS:txtTaxableCompensationIncomea');
            var valueItem4    = document.getElementById('frm1701MS:txtTaxpayerNo4a');

            // Set value for Item 3
            valueItem3.value = formatCurrencyWithComma(valueItem1 - valueItem2);

            // Calculate the Applicable Income Tax Rate for Item 4 and display in field
            valueItem4.value = formatCurrencyWithComma(Math.round(computeRegularIncomeTax(stringToNum(valueItem3.value))));

            // Item 15 update: Gets the sum of Item 3 and Item 14 to update Item 15
            computeTaxableIncome15TP();

            if (isMixedIncome.checked && (isSpecial.checked || isExempt.checked)) {
                valueP2Item22.value = formatCurrencyWithComma(valueItem4.value);
                totalTaxDue18ATP();
                computeP2No23TP();
            } else {
                totalTaxDue18ATP();
            }

            if (isGraduated.checked) {
                totalTaxDue18BTP();
                computeP2No22TP();
            }

            if (is8Percent.checked) {
                totalTaxDueCompensationAndBusinessIncome25TP();
            }
        }

        function calculateNo3SP() {

            var isMixedIncome = document.getElementById('frm1701MS:txtTaxpayerNo11b1');
            var isCompensationIncome = document.getElementById('frm1701MS:txtTaxpayerNo11d1');

            var isGraduated   = document.getElementById('frm1701MS:txtTaxpayerNo12b1');
            var isExempt      = document.getElementById('frm1701MS:txtTaxpayerNo12d1');
            var isSpecial     = document.getElementById('frm1701MS:txtTaxpayerNo12e1');
            var is8Percent    = document.getElementById('frm1701MS:txtTaxpayerNo12c1');

            var valueP2Item22 = document.getElementById('frm1701MS:txtIncomeTaxRegularNo22b');

            var valueItem1    = stringToNum(document.getElementById("frm1701MS:txtGrossb").value);
            var valueItem2    = stringToNum(document.getElementById("frm1701MS:txtLessNonTaxableb").value);
            var valueItem3    = document.getElementById("frm1701MS:txtTaxableCompensationIncomeb");
            var valueItem4    = document.getElementById("frm1701MS:txtTaxpayerNo4b");

            /// Set value for Item 3
            valueItem3.value = formatCurrencyWithComma(valueItem1 - valueItem2);

            // Calculate the Applicable Income Tax Rate for Item 4 and display in field
            valueItem4.value = formatCurrencyWithComma(Math.round(computeRegularIncomeTax(stringToNum(valueItem3.value))));
            
            // Item 15 update: Gets the sum of Item 3 and Item 14 to update Item 15
            computeTaxableIncome15SP();

            // If Compensation Income is selected
            if (isCompensationIncome.checked) {
                valueP2Item22.value = formatCurrencyWithComma(stringToNum(valueItem4.value));
                computeP2No22SP();
            }

            if (isMixedIncome.checked && (isSpecial.checked || isExempt.checked)) {
                valueP2Item22.value = formatCurrencyWithComma(stringToNum(valueItem4.value));
                totalTaxDue18ASP();
                computeP2No23SP();
            } else {
                totalTaxDue18ASP();
            }

            if (isGraduated.checked) {
                totalTaxDue18BSP();
                computeP2No22SP();
            }

            if (is8Percent.checked) {
                totalTaxDueCompensationAndBusinessIncome25SP();
            }
        }

        // PART 4, SCHEDULE B1, ITEM 7 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function calculateNo7a() {
            var result = getValue('frm1701MS:txtSalesRevenueNo5a') - getValue('frm1701MS:txtSalesReturnsNo6a');
            document.getElementById('frm1701MS:txtTaxableCompensationIncomeNo7a').value = formatCurrencyWithComma(result);
            calculateNo3TP();
            computeNo9(); 
            computeTaxableIncome15TP();
            computeTaxDueNo17TP();
        }

        function calculateNo7b() {
            var result = getValue('frm1701MS:txtSalesRevenueNo5b') - getValue('frm1701MS:txtSalesReturnsNo6b');
            document.getElementById('frm1701MS:txtTaxableCompensationIncomeNo7b').value = formatCurrencyWithComma(result);
            calculateNo3SP();
            computeNo9b();
            computeTaxableIncome15SP();
            computeTaxDueNo17SP();
        }

        // PART 4, SCHEDULE B1, ITEM 9 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeNo9() {
            var result = NumWithComma(document.getElementById('frm1701MS:txtTaxableCompensationIncomeNo7a').value) - NumWithComma(document.getElementById('frm1701MS:txtCostofSalesNo8a').value);
            if (!isNaN(result)) {
                document.getElementById('frm1701MS:txtGrossIncomeNo9a').value = formatCurrencyWithComma(result);
            }
            computeNetIncomeLossNo12TP();

            //for enable disable of field
            toggleShareOfOtherNo20a();
        }
            
        function computeNo9b() {
            var result = NumWithComma(document.getElementById('frm1701MS:txtTaxableCompensationIncomeNo7b').value) - NumWithComma(document.getElementById('frm1701MS:txtCostofSalesNo8b').value);
            if (!isNaN(result)) {
                document.getElementById('frm1701MS:txtGrossIncomeNo9b').value = formatCurrencyWithComma(result);
            }
            computeNetIncomeLossNo12SP();

            //for enable disable of field
            toggleShareOfOtherNo20b();
        }

        // PART 4, SCHEDULE B1, ITEM 10A TO 10D - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeTotalAllowableDeductionsNo10a() {
            var result = getValue('frm1701MS:txtAllowableItemizedDeductionsNo10a') + 
                getValue('frm1701MS:txtSpecialAllowableNo10a') + getValue('frm1701MS:txtNetOperatingLossNo10a');
            document.getElementById('frm1701MS:txtTotalAllowableItemixedDeductionsNo10a').value = formatCurrencyWithComma(result);
            computeNetIncomeLossNo12TP();
        }

        function computeTotalAllowableDeductionsNo10b() {
            var result = getValue('frm1701MS:txtAllowableItemizedDeductionsNo10aSpouse') + 
                getValue('frm1701MS:txtSpecialAllowableNo10b') + getValue('frm1701MS:txtNetOperatingLossNo10b');
            document.getElementById('frm1701MS:txtTotalAllowableItemixedDeductionsNo10b').value = formatCurrencyWithComma(result);
            computeNetIncomeLossNo12SP();
        }

        // PART 4, SCHEDULE B1, ITEM 11 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeOptionalDeductionNo11a() {
            if(document.getElementById('frm1701MS:txtTaxpayerNo17b').checked) {
                var val7 = NumWithComma(document.getElementById('frm1701MS:txtTaxableCompensationIncomeNo7a').value);
                var percentage = 0.40;
                var result = Math.round(val7 * percentage);
                document.getElementById('frm1701MS:txtOptionalDeductionNo11a').value = formatCurrencyWithComma(result)
            }
            computeNetIncomeLossNo12TP();
        }

        function computeOptionalDeductionNo11b() {
            if(document.getElementById('frm1701MS:txtSpouseNo17b').checked) {
                var val7 = NumWithComma(document.getElementById('frm1701MS:txtTaxableCompensationIncomeNo7b').value);
                var percentage = 0.40;
                var result = Math.round(val7 * percentage);
                document.getElementById('frm1701MS:txtOptionalDeductionNo11b').value = formatCurrencyWithComma(result)
            }
            computeNetIncomeLossNo12SP();
        }  

        // PART 4, SCHEDULE B1, ITEM 12 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeNetIncomeLossNo12TP() {
            // If ITEMIZED DEDUCTION is checked in TP (item9 minus item10D)
            if (document.getElementById('frm1701MS:txtTaxpayerNo17a').checked) {
                var val9 = NumWithComma(document.getElementById('frm1701MS:txtGrossIncomeNo9a').value);
                var val10d = NumWithComma(document.getElementById('frm1701MS:txtTotalAllowableItemixedDeductionsNo10a').value);
                var result = val9 - val10d;
                document.getElementById('frm1701MS:txtNetIncomeLossNo12a').value = formatCurrencyWithComma(result);
                computeTotalIncomeBusinessNo14TP();
            }
            // If OPTIONAL STANDARD DEDUCTION is checked in TP (item9 minus item11)
            else if (document.getElementById('frm1701MS:txtTaxpayerNo17b').checked) {
                var val9 = NumWithComma(document.getElementById('frm1701MS:txtGrossIncomeNo9a').value);
                var val11 = NumWithComma(document.getElementById('frm1701MS:txtOptionalDeductionNo11a').value);
                var result = val9 - val11;
                document.getElementById('frm1701MS:txtNetIncomeLossNo12a').value = formatCurrencyWithComma(result);
                computeTotalIncomeBusinessNo14TP();
            } 
            else {
                return;
            }
        }

        function computeNetIncomeLossNo12SP() {
            // If ITEMIZED DEDUCTION is checked in SP (item9 minus item10D)
            if (document.getElementById('frm1701MS:txtSpouseNo17a').checked) {
                var val9 = NumWithComma(document.getElementById('frm1701MS:txtGrossIncomeNo9b').value);
                var val10d = NumWithComma(document.getElementById('frm1701MS:txtTotalAllowableItemixedDeductionsNo10b').value);
                var result = val9 - val10d;
                document.getElementById('frm1701MS:txtNetIncomeLossNo12b').value = formatCurrencyWithComma(result);
                computeTotalIncomeBusinessNo14SP();
            } 
            // If OPTIONAL STANDARD DEDUCTION is checked in SP (item9 minus item11)
            else if (document.getElementById('frm1701MS:txtSpouseNo17b').checked) {
                var val9 = NumWithComma(document.getElementById('frm1701MS:txtGrossIncomeNo9b').value);
                var val11 = NumWithComma(document.getElementById('frm1701MS:txtOptionalDeductionNo11b').value);
                var result = val9 - val11;
                document.getElementById('frm1701MS:txtNetIncomeLossNo12b').value = formatCurrencyWithComma(result);
                computeTotalIncomeBusinessNo14SP();
            }
        }

        // PART 4, SCHEDULE B1, ITEM 14 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeTotalIncomeBusinessNo14TP() {
            var result = NumWithComma(document.getElementById('frm1701MS:txtNetIncomeLossNo12a').value) +
            NumWithComma(document.getElementById('frm1701MS:txtNonOperatingIncomeNo13a').value);
            
            if (!isNaN(result)) {
                document.getElementById('frm1701MS:txtTaxableIncomeBusinesNo14a').value = formatCurrencyWithComma(result);
            }

            computeTaxableIncome15TP();
            computeTaxDueNo17TP();
            computeTaxAvailmentTP();

            //for enable disable of field
            toggleShareOfOtherNo20a();

        }

        function computeTotalIncomeBusinessNo14SP () {
            var result = NumWithComma(document.getElementById('frm1701MS:txtNetIncomeLossNo12b').value) +
            NumWithComma(document.getElementById('frm1701MS:txtNonOperatingIncomeNo13b').value);
            
            if (!isNaN(result)) {
                document.getElementById('frm1701MS:txtTaxableIncomeBusinesNo14b').value = formatCurrencyWithComma(result);
            }
            computeTaxableIncome15SP();
            computeTaxDueNo17SP();
            computeTaxAvailmentSP();

            //for enable disable of field
            toggleShareOfOtherNo20b();
        }

        // PART 4, SCHEDULE B1, ITEM 15 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeTaxableIncome15TP() {

            var isMixedIncome = document.getElementById('frm1701MS:txtTaxpayerNo11b').checked;

            var isExempt      = document.getElementById('frm1701MS:txtTaxpayerNo12d').checked;
            var isSpecial     = document.getElementById('frm1701MS:txtTaxpayerNo12e').checked;
            var is8Percent    = document.getElementById('frm1701MS:txtTaxpayerNo12c').checked;
            var isGraduated   = document.getElementById('frm1701MS:txtTaxpayerNo12b').checked;

            var valueItem3    = document.getElementById('frm1701MS:txtTaxableCompensationIncomea');
            var valueItem14   = document.getElementById('frm1701MS:txtTaxableIncomeBusinesNo14a');
            var valueItem15   = document.getElementById('frm1701MS:txtCompensationBusinessNo15a');

            //var sum = NumWithComma(valueItem3.value) + NumWithComma(valueItem14.value);
            
            // ternary operator: condition ? valueIfTrue : valueIfFalse
            sum = (NumWithComma(valueItem3.value) > 0 ? NumWithComma(valueItem3.value) : 0) + 
                    (NumWithComma(valueItem14.value) > 0 ? NumWithComma(valueItem14.value) : 0);

            // if Part 1 Item 11 is Mixed Income and Part 1 Item 12 is Exempt from ITR
            if (isMixedIncome && (isExempt || isSpecial)) {
                valueItem15.value = formatCurrencyWithComma(sum);
                // Continue downstream computation
                totalTaxDue18BTP();
                return;
            }

            // If Graduated Income is check in Item 12, resume calculation
            if (isGraduated) {
                valueItem15.value = formatCurrencyWithComma(sum);
                return;
            }

            // If 8% Income is selected in Item 12, Item 15 should not compute. (Tester condition; Not in FSR)
            if (is8Percent) {
                return;
            }
        }

        function computeTaxableIncome15SP() {

            var isMixedIncome        = document.getElementById('frm1701MS:txtTaxpayerNo11b1').checked;
            var isCompensationIncome = document.getElementById('frm1701MS:txtTaxpayerNo11d1').checked;

            var isExempt             = document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked;
            var isSpecial            = document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked;
            var is8Percent           = document.getElementById('frm1701MS:txtTaxpayerNo12c1').checked;
            var isGraduated          = document.getElementById('frm1701MS:txtTaxpayerNo12b1').checked;

            var valueItem3           = document.getElementById('frm1701MS:txtTaxableCompensationIncomeb');
            var valueItem14          = document.getElementById('frm1701MS:txtTaxableIncomeBusinesNo14b');
            var valueItem15          = document.getElementById('frm1701MS:txtCompensationBusinessNo15b');

            //var sum = NumWithComma(valueItem3.value) + NumWithComma(valueItem14.value);
            
            // ternary operator: condition ? valueIfTrue : valueIfFalse
            sum = (NumWithComma(valueItem3.value) > 0 ? NumWithComma(valueItem3.value) : 0) + 
                    (NumWithComma(valueItem14.value) > 0 ? NumWithComma(valueItem14.value) : 0);

            // if Part 1 Item 11 is Compensation Income - test this first, so i would not bypass the condition for isGraduated
            if (isCompensationIncome) {
                valueItem15.value = formatCurrencyWithComma(NumWithComma(valueItem14.value));
                return;
            }

            // if Part 1 Item 11 is Mixed Income and Part 1 Item 12 is Exempt from ITR
            if (isMixedIncome && (isExempt || isSpecial)) {
                valueItem15.value = formatCurrencyWithComma(sum);
                // Continue downstream computation
                totalTaxDue18BSP();
                return;
            }
 
            if (isGraduated) {
                valueItem15.value = formatCurrencyWithComma(sum);
                return;
            } 

            if (is8Percent) {
                return;
            }

        }

        // PART 4, SCHEDULE B1, ITEM 17 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 

        function computeTaxDueNo17TP() {
            /* 
            USECASE: Tax Due - Special/Preferential Rate or Exempt from Income Tax
            (If Exempt: Item 14 x Item 16; If Special: Item 9 x Item 16)
            */

            var isMixedIncome    = document.getElementById('frm1701MS:txtTaxpayerNo11b');
            var isExempt         = document.getElementById('frm1701MS:txtTaxpayerNo12d');
            var isSpecial        = document.getElementById('frm1701MS:txtTaxpayerNo12e');

            var valuePart2Item19 = document.getElementById('frm1701MS:txtIncomeTaxDueNo19a');

            var valuePart4Item9  = document.getElementById('frm1701MS:txtGrossIncomeNo9a');
            var valuePart4Item14 = document.getElementById('frm1701MS:txtTaxableIncomeBusinesNo14a');
            var valuePart4Item16 = document.getElementById('frm1701MS:txtTaxRatea');
            var valuePart4Item17 = document.getElementById('frm1701MS:txtTaxDueSpeciala');

            // CASE: EXEMPT FROM INCOME TAX (Item 12)
            if (isExempt.checked) {
                valuePart4Item17.value = formatCurrencyWithComma(Math.round(NumWithComma(valuePart4Item14.value) * (stringToNum(valuePart4Item16.value) / 100)));
                totalTaxDue18ATP();
                computeTaxAvailmentTP();
                return;
            }

            // CASE: SPECIAL / PREFERENTIAL RATE (Item 12)
            else if (isSpecial.checked) {
                var baseAmount = Math.max(0, NumWithComma(valuePart4Item9.value));
                valuePart4Item17.value = formatCurrencyWithComma(Math.round(baseAmount * (stringToNum(valuePart4Item16.value) / 100)));
                // CASE: MIXED INCOME (Item 11)
                if (isMixedIncome.checked) {
                    valuePart2Item19.value = formatCurrencyWithComma(NumWithComma(valuePart4Item17.value));
                }
                // Run ONCE after all values are finalized
                calculateSpecialRateNo21a();
                return;
            }
        }


        function computeTaxDueNo17SP() {
            /* 
            USECASE: Tax Due - Special/Preferential Rate or Exempt from Income Tax
            (If Exempt: Item 14 x Item 16; If Special: Item 9 x Item 16)
            */

            var isMixedIncome    = document.getElementById('frm1701MS:txtTaxpayerNo11b1');
            var isExempt         = document.getElementById('frm1701MS:txtTaxpayerNo12d1');
            var isSpecial        = document.getElementById('frm1701MS:txtTaxpayerNo12e1');

            var valuePart2Item19 = document.getElementById('frm1701MS:txtIncomeTaxDueNo19b');

            var valuePart4Item9  = document.getElementById('frm1701MS:txtGrossIncomeNo9b');
            var valuePart4Item14 = document.getElementById('frm1701MS:txtTaxableIncomeBusinesNo14b');
            var valuePart4Item16 = document.getElementById('frm1701MS:txtTaxRateb');
            var valuePart4Item17 = document.getElementById('frm1701MS:txtTaxDueSpecialb');

            // CASE: EXEMPT FROM INCOME TAX (Item 12)
            if (isExempt.checked) {
                valuePart4Item17.value = formatCurrencyWithComma(Math.round(NumWithComma(valuePart4Item14.value) * (stringToNum(valuePart4Item16.value) / 100)));
                totalTaxDue18ASP();
                computeTaxAvailmentSP();
                return;
            }

            // CASE: SPECIAL / PREFERENTIAL RATE (Item 12)
            else if (isSpecial.checked) {
                var baseAmount = Math.max(0, NumWithComma(valuePart4Item9.value));
                valuePart4Item17.value = formatCurrencyWithComma(Math.round(baseAmount * (stringToNum(valuePart4Item16.value) / 100)));
                // CASE: MIXED INCOME (Item 11)
                if (isMixedIncome.checked) {
                    valuePart2Item19.value = formatCurrencyWithComma(NumWithComma(valuePart4Item17.value));
                }
                // Run ONCE after all values are finalized
                calculateSpecialRateNo21b();
                return;
            }
        }

