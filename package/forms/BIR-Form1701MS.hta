        // Utility functions
        // function NumWithComma(num) {
        // return parseFloat(num.replace(/,/g, ''));
        // }

        // function formatCurrencyWithComma(num) {
        //     return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        // }

        function getValue(id) {
            var el = document.getElementById(id);
            if (!el || el.value === "") return 0;

            var num = NumWithComma(el.value);
            return isNaN(num) ? 0 : num;
        }

        function getEl(id) {
            return document.getElementById(id);
        }

        // IE-safe trim (avoid String.prototype.trim for old IE)
        function trimIE(s) {
            return (s || '').replace(/^\s+|\s+$/g, '');
        }

        // Remove commas + trim + parse to number (empty/invalid => 0)
        function parseAmount(el) {
            if (!el) { return 0; }
            var raw = el.value || '';
            var cleaned = trimIE(raw.replace(/,/g, ''));
            if (cleaned === '') { return 0; }
            var n = parseFloat(cleaned);
            return isNaN(n) ? 0 : n;
        }

        // True if element has non-whitespace value
        function hasText(el) {
            if (!el) { return false; }
            return trimIE(el.value).length > 0;
        }

        // True if element's numeric value !== 0
        function hasNonZeroAmount(el) {
            return parseAmount(el) !== 0;
        }
