        // Function to enforce selection rules
        function enforceSelectionRules() {
        var toBeRefundedCheckbox = document.getElementById("frm1701MS:txtToBeRefunded");
        var txtToBeIssuedCheckbox = document.getElementById("frm1701MS:txtToBeIssued");
        var txtToBeCarriedCheckbox = document.getElementById("frm1701MS:txtToBeCarried");

        var toBeRefundedText = document.getElementById("frm1701MS:txtToBeRefunded1");
        var txtToBeIssuedText = document.getElementById("frm1701MS:txtToBeIssued1");
        var txtToBeCarriedText = document.getElementById("frm1701MS:txtToBeCarried1");

        
        //If Item 30 is not negative disable Item 31 fully
        var item30 = NumWithComma(document.getElementById("frm1701MS:txtAggregateAmountPayable30a").value);

        if (item30 >= 0) {

            disable(toBeRefundedCheckbox, toBeRefundedText);
            disable(txtToBeIssuedCheckbox, txtToBeIssuedText);
            disable(txtToBeCarriedCheckbox, txtToBeCarriedText);
            //return if the value is not negative
            return;
        }


        var selectedCount = 0;

            if (toBeRefundedCheckbox.checked) selectedCount++;
            if (txtToBeIssuedCheckbox.checked) selectedCount++;
            if (txtToBeCarriedCheckbox.checked) selectedCount++;

            if (toBeRefundedCheckbox.checked && txtToBeIssuedCheckbox.checked) {
                alert("You cannot select BOTH 'To be refunded' and 'To be issued a Tax Credit Certificate'.");
                txtToBeIssuedCheckbox.checked = false;
                disable(null, txtToBeIssuedText); 
                selectedCount--;
            }

            //enable textbox ONLY when checkbox is checked
            if (toBeRefundedCheckbox.checked) enable(null, toBeRefundedText);
            else disable(null, toBeRefundedText);

            if (txtToBeIssuedCheckbox.checked) enable(null, txtToBeIssuedText);
            else disable(null, txtToBeIssuedText);

            if (txtToBeCarriedCheckbox.checked) enable(null, txtToBeCarriedText);
            else disable(null, txtToBeCarriedText);

            //user can select ONLY up to 2 choices
            if (selectedCount >= 2) {
                // Disable only the unchecked options
                if (!toBeRefundedCheckbox.checked) disable(toBeRefundedCheckbox, toBeRefundedText);
                if (!txtToBeIssuedCheckbox.checked) disable(txtToBeIssuedCheckbox, txtToBeIssuedText);
                if (!txtToBeCarriedCheckbox.checked) disable(txtToBeCarriedCheckbox, txtToBeCarriedText);
            }
            else {
                // Re-enable choice checkboxes
                enable(toBeRefundedCheckbox, null);
                enable(txtToBeIssuedCheckbox, null);
                enable(txtToBeCarriedCheckbox, null);
            }


        }

        // Helper function to clear and disable a checkbox and its text field
        function clearAndDisable(checkbox, textField) {
        checkbox.checked = false;
        checkbox.disabled = true;
        textField.value = ""; // Clear the text field
        textField.disabled = true;
        }

        // Helper function to disable a checkbox and its text field
        function disable(checkbox, textField) {
            if (checkbox) 
            {
                checkbox.disabled = true;
            }
            if (textField) 
            {
                textField.disabled = true;
                textField.value = "";
            }
        }

        // Helper function to enable a checkbox and its text field
        function enable(checkbox, textField) {
            
            if (checkbox) 
            {
                checkbox.disabled = false;
            }
            if (textField) 
            {         
                textField.disabled = false;
            }
        }

        // Attach `onclick` handlers for the checkboxes
        document.getElementById("frm1701MS:txtToBeRefunded").onclick = function() {
        enforceSelectionRules();
        if (!this.checked) document.getElementById("frm1701MS:txtToBeRefunded1").value = ""; // Clear text if unchecked
        };
        document.getElementById("frm1701MS:txtToBeIssued").onclick = function() {
        enforceSelectionRules();
        if (!this.checked) document.getElementById("frm1701MS:txtToBeIssued1").value = ""; // Clear text if unchecked
        };
        document.getElementById("frm1701MS:txtToBeCarried").onclick = function() {
        enforceSelectionRules();
        if (!this.checked) document.getElementById("frm1701MS:txtToBeCarried1").value = ""; // Clear text if unchecked
        };



