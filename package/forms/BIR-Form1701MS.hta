        }

        // PART 2, ITEM 25 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeP2No25TP() {
            
            document.getElementById('frm1701MS:txtTaxPayableNo25a').value = formatCurrencyWithComma(NumWithComma(document.getElementById("frm1701MS:txtTotalIncomeTaxDueNo23a").value) - 
                NumWithComma(document.getElementById('frm1701MS:txtTotalTaxCreditsPartIINo24a').value));

            setP2No25TPStatus();
            calculateP2No27TP();
        }

        function setP2No25TPStatus(){
            if(NumWithComma(document.getElementById("frm1701MS:txtTotalIncomeTaxDueNo23a").value) - 
                NumWithComma(document.getElementById('frm1701MS:txtTotalTaxCreditsPartIINo24a').value) < 0)
                {
                document.getElementById('frm1701MS:txtTaxDueAllowedNo26a').disabled = true;
                document.getElementById('frm1701MS:txtTaxDueAllowedNo26a').value = "0";
                } 
            else 
                {
                document.getElementById('frm1701MS:txtTaxDueAllowedNo26a').disabled = false;
                }
        }
        function computeP2No25SP() {

            document.getElementById('frm1701MS:txtTaxPayableNo25b').value = formatCurrencyWithComma(NumWithComma(document.getElementById("frm1701MS:txtTotalIncomeTaxDueNo23b").value) - 
                NumWithComma(document.getElementById('frm1701MS:txtTotalTaxCreditsPartIINo24b').value));    

            setP2No25SPStatus();
            calculateP2No27SP();
        }
        function setP2No25SPStatus()
        {
            if(NumWithComma(document.getElementById("frm1701MS:txtTotalIncomeTaxDueNo23b").value) - 
                NumWithComma(document.getElementById('frm1701MS:txtTotalTaxCreditsPartIINo24b').value) < 0)
             {
