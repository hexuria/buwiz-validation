        function computeTotalTaxDue() {
                var item4a = document.getElementById('frm1701MS:txtTaxpayerNo4a').value;
            
                var item4b = document.getElementById('frm1701MS:txtTaxpayerNo4b').value;
                var item17a = document.getElementById('frm1701MS:txtTaxDueSpeciala').value;
                var item17b = document.getElementById('frm1701MS:txtTaxDueSpecialb').value;
                var totalTaxDue = Math.round(parseFloat(item4a) || 0);
                if(document.getElementById('frm1701MS:txtTaxpayerNo12d').checked || document.getElementById('frm1701MS:txtTaxpayerNo12e').checked)
                {
                var taxdue = document.getElementById('frm1701MS:TotalTaxDueCompensationATP');
                taxdue.value= totalTaxDue;
                    
                }
                else
                {
                        var taxdue = document.getElementById('frm1701MS:TotalTaxDueCompensationBTP');
                taxdue.value= totalTaxDue;
                document.getElementById('frm1701MS:txtIncomeTaxRegularNo22a').value = taxdue.value;
                }
                //  document.getElementById('f').value = totalTaxDue;
            calculateSpecialRateNo21a();
            totalTaxDueCompensationAndBusinessIncome25TP();
            }
        function computeTotalTaxDueSpouse() {
                var item4a = document.getElementById('frm1701MS:txtTaxpayerNo4a').value;
            
                var item4b = document.getElementById('frm1701MS:txtTaxpayerNo4b').value;
                var item17a = document.getElementById('frm1701MS:txtTaxDueSpeciala').value;
                var item17b = document.getElementById('frm1701MS:txtTaxDueSpecialb').value;
                var totalTaxDue = Math.round(parseFloat(item4b) || 0);

                if (document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked || document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked) {
                    var taxdue = document.getElementById('frm1701MS:TotalTaxDueCompensationASP');
                    taxdue.value= totalTaxDue;   
                } else {
                    var taxdue = document.getElementById('frm1701MS:TotalTaxDueCompensationBSP');
                    
                    if (!(document.getElementById('frm1701MS:txtTaxpayerNo11d1').checked)) {
                        taxdue.value= totalTaxDue;
                    }

                    document.getElementById('frm1701MS:txtIncomeTaxRegularNo22b').value = taxdue.value;
                }
                //  document.getElementById('f').value = totalTaxDue;
            calculateSpecialRateNo21b();
            totalTaxDueCompensationAndBusinessIncome25SP();
            }

