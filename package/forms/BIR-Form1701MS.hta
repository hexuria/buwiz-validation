                <script>
                function limitMonthOptions() {
                    var shortPeriodYes = document.getElementById('frm1701MS:txtReturnPeriodYesNo3');
                    var monthSelect = document.getElementById('frm1701MS:txtMonthNo1');
                    
                    if (shortPeriodYes.checked) {
                        if (monthSelect.value === '12') {
                            monthSelect.value = '11';
                        }
                        monthSelect.remove(11);
                    } else {
                        if (monthSelect.options.length === 11) {
                            var option12 = document.createElement('option');
                            option12.value = '12';
                            option12.text = '12';
                            monthSelect.add(option12);
                        }
                        monthSelect.value = '12';
                    }
                }

                function restoreOriginalState() {
                    document.getElementById('Page1Content').style.display = 'block';
                    document.getElementById('Page2Content').style.display = 'none';
                }

                function printPages() {
                    showAllPages();
                    window.print();
                    restoreOriginalState();
                }
                </script> 

                <title>BIR Form No. 1701MS</title>
        </head>

