        // CLOSE MODAL SCHED 5 NO9
        function closeModalSched5No9() {
        if (validationSpecify()) {
            // Show the main content when closing the modal
            document.getElementById('mainContent').style.display = 'block';

            // Close the modal with a "blind" effect if it's open
            if ($('#modalSched5No9').css('display') != 'none') {
                $('#modalSched5No9').hide('blind');
            }

            var size = specifyToCommitSched5No9.length;
            for (var i = 0; i < size; i++) {
                specifyToCommitSched5No9[i].txtSpecifySched5No9Description = document.getElementById('frm1701MS:sched5No9:Description' + i).value;
                specifyToCommitSched5No9[i].txtSpecifySched5No9Amount = document.getElementById('frm1701MS:sched5No9:Amount' + i).value;
                specifyToCommitSched5No9[i].txtSpecifySched5No9Spouse = document.getElementById('frm1701MS:sched5No9:Spouse' + i).value;
            }

            if (size > 1) {
                $('#frm1701MS\\:addOtherCreditsPayments').val('VARIOUS').prop('disabled', true);
                document.getElementById('frm1701MS:txtOtherCreditsPaymentsNo9a').disabled = true
                document.getElementById('frm1701MS:txtOtherCreditsPaymentsNo9b').disabled = true
            }

            if (size < 1) {
                document.getElementById('frm1701MS:addOtherCreditsPayments').value = ""
                $('#frm1701MS\\:txtOtherCreditsPaymentsNo9a').val('0').prop('disabled', false)
                $('#frm1701MS\\:txtOtherCreditsPaymentsNo9b').val('0').prop('disabled', false)
            }

            computeOtherSpecify();
            computeOtherSpecifySpouse(); 
        }
        }


        function savingSched5No9() {

            var tableBody = document.getElementById('tbodySched5No9');
            var rows = tableBody.getElementsByTagName('tr');
            var specifyToCommitSched5No9 = [];
            var specifyToCommitSched5No9Spouse = [];
            var count = 0;

            function manualTrim(str) {
                return str.replace(/^\s+|\s+$/g, '');
            }

            for (var i = 0; i < rows.length; i++) {
                var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
                var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

                var description = manualTrim(descriptionInput.value);
                var amount = manualTrim(amountInput.value);

                if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                    count += 1; // Increment count for invalid rows
                } else {
                    specifyToCommitSched5No9 && specifyToCommitSched5No9Spouse .push({
                        txtSpecifySched5No9Description: description,
                        txtSpecifySched5No9Amount: Math.round(parseFloat(amount))
                    });
                }
            }
        }


        function cancelSched5No9() {
            // Function to manually trim whitespace
            function manualTrim(str) {
                return str.replace(/^\s+|\s+$/g, '');
            }

            // Get the table body element
            var tableBody = document.getElementById('tbodySched5No9');
            if (!tableBody) {
                alert("Table body element not found.");
                return;
            }

            var rows = tableBody.getElementsByTagName('tr');
            var specifyToCommitSched5No9 = [];
                var specifyToCommitSched5No9Spouse = [];
            var count = 0;

            // Iterate over each row in the table body
            for (var i = 0; i < rows.length; i++) {
                // Skip empty rows or rows that don't have the correct structure
                if (rows[i].cells.length < 3) continue;

                var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
                var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

                if (!descriptionInput || !amountInput) {
                    alert("Input elements not found in row " + i);
                    continue;
                }

                var description = manualTrim(descriptionInput.value);
                var amount = manualTrim(amountInput.value);

                // Validate the inputs
                if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                    count += 1; // Increment count for invalid rows
                } else {
                    // Add valid rows to specifyToCommit array
                    specifyToCommitSched5No9 && specifyToCommitSched5No9Spouse.push({
                        txtSpecifySched5No9Description: description,
                        txtSpecifySched5No9Amount: Math.round(parseFloat(amount))
                        
                    });
                }
                deleteRowSched5No9();
            }
        }

        function saveAndCloseSched5No9() {
            function manualTrim(str) {
                return str.replace(/^\s+|\s+$/g, '');
            }

            var tableBody = document.getElementById('tbodySched5No9');
            var rows = tableBody.getElementsByTagName('tr');
            var specifyToCommitSched5No9 = [];
            var specifyToCommitSched5No9Spouse = [];
            var validEntries = 0;

            for (var i = 0; i < rows.length; i++) {
                if (rows[i].cells.length < 3) continue;

                var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
                var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

                var description = manualTrim(descriptionInput.value);
                var amount = manualTrim(amountInput.value);

                if (description !== "" && amount !== "" && parseFloat(amount) > 0) {
                    validEntries++;
                    specifyToCommitSched5No9 && specifyToCommitSched5No9Spouse.push({
                        txtSpecifySched5No9Description: description,
                        txtSpecifySched5No9Amount: Math.round(parseFloat(amount))
                    });
                }
            }

            if (validEntries > 0) {
                alert('Data has been saved successfully!');
                closeModalSched5No9();
            } else {
                alert('Please enter at least one valid entry with description and amount greater than zero.');
            }
        }




            

