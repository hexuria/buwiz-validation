                            "frm1701MS:txtTaxpayerNo16b",       // item 16 - From
                            "frm1701MS:txtTaxpayerNo16b1",      // item 16 - To
                            // Spouse Part 2
                            //"frm1701MS:txtShareOfOtherNo20b",    // item 20
                            // Spouse Part 4
                            "frm1701MS:txtTaxRateb"             // item 16
                            ], 
                            true
                        );

                        setFieldsEnabled(
                            // add specific fields here
                            [
                            // Spouse Part 1
                            "frm1701MS:txtSpouseNo17a",                 // item 17 - Itemized
                            "frm1701MS:txtSpouseNo17b"                  // item 17 - OSD
                            ], 
                            false
                        );

                        incomeIsSubjectToOptionExemptSP();
                    }
                } 
                // Item 11 - compensation
                else if (document.getElementById('frm1701MS:txtTaxpayerNo11d1').checked) {
                    setFieldSPPart4AEnabled(true);
                    setFieldSPPart5Enabled(true);

                    setFieldSPPart4B1Enabled(false);
                    setFieldSPPart4B2Enabled(false);

                    setFieldsEnabled(
                        // add specific fields here
                        [
                        // Spouse Part 1
                        "frm1701MS:txtTaxpayerNo12b1",              // item 12 - Graduated Income Tax Rates
                        "frm1701MS:txtTaxpayerNo12c1",              // item 12 - 8% Income Tax Rates
                        "frm1701MS:txtTaxpayerNo12d1",              // item 12 - Exempt from Income Tax (IT)
                        "frm1701MS:txtTaxpayerNo12e1",              // item 12 - Special/Preferential Rate
                        "frm1701MS:txtSpouseNo17a",                 // item 17 - Itemized
                        "frm1701MS:txtSpouseNo17b"                  // item 17 - OSD
                        ], 
                        false
                    );
                } else {
                    setFieldSPPart4AEnabled(false);
                    setFieldSPPart4B1Enabled(false);
                    setFieldSPPart4B1IDEnabled(false);
                    setFieldSPPart4B1OSDEnabled(false);
                    setFieldSPPart4B2Enabled(false);
                    setFieldSPPart5Enabled(false);
                }
            } else {
                setFieldSPPart1Enabled(false);
                setFieldSPPart2Enabled(false);
                setFieldSPPart4AEnabled(false);
                setFieldSPPart4B1Enabled(false);
                setFieldSPPart4B1IDEnabled(false);
                setFieldSPPart4B1OSDEnabled(false);
                setFieldSPPart4B2Enabled(false);
                setFieldSPPart5Enabled(false);
            }

            // Common Fields
            setFieldsEnabled(
                // add specific fields here
                [
                // "frm1701MS:txtMonthNo1",                     // item 1 - Month (permanent disabled)
                "frm1701MS:txtYearNo1",                         // item 1 - Year
