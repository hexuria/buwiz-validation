        // PART 4, SCHEDULE B1, ITEM 18A - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function totalTaxDue18ATP(){
            if (document.getElementById('frm1701MS:txtTaxpayerNo12e').checked || document.getElementById('frm1701MS:txtTaxpayerNo12d').checked) {
                // if mixed income AND special/preferential
                if (document.getElementById('frm1701MS:txtTaxpayerNo11b').checked && document.getElementById('frm1701MS:txtTaxpayerNo12e').checked) {
                    document.getElementById('frm1701MS:txtIncomeTaxDueNo19a').value = formatCurrencyWithComma(document.getElementById('frm1701MS:txtTaxDueSpeciala').value);
                    computeP2No23TP();
                    toggleShareOfOtherNo20a();
                } else {
                    document.getElementById('frm1701MS:TotalTaxDueCompensationATP').value = formatCurrencyWithComma(Math.round((NumWithComma(document.getElementById('frm1701MS:txtTaxDueSpeciala').value) +
                    NumWithComma(document.getElementById('frm1701MS:txtTaxpayerNo4a').value))));
                    document.getElementById('frm1701MS:txtIncomeTaxDueNo19a').value = document.getElementById('frm1701MS:TotalTaxDueCompensationATP').value;
                    computeIncomeTaxDueNo19a();
                }
            } else {
                return;
            }
        }

        function totalTaxDue18ASP(){
            if (document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked || document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked) {
                // if mixed income AND special/preferential
                if (document.getElementById('frm1701MS:txtTaxpayerNo11b1').checked && document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked) {
                    document.getElementById('frm1701MS:txtIncomeTaxDueNo19b').value = formatCurrencyWithComma(document.getElementById('frm1701MS:txtTaxDueSpecialb').value);
                    computeP2No23SP();
                    toggleShareOfOtherNo20b(); 
                } else {
                    document.getElementById('frm1701MS:TotalTaxDueCompensationASP').value = formatCurrencyWithComma(Math.round((NumWithComma(document.getElementById('frm1701MS:txtTaxDueSpecialb').value) +
                    NumWithComma(document.getElementById('frm1701MS:txtTaxpayerNo4b').value))));
                    document.getElementById('frm1701MS:txtIncomeTaxDueNo19b').value = document.getElementById('frm1701MS:TotalTaxDueCompensationASP').value;
                    computeIncomeTaxDueNo19b();
                }
            } else {
                return;
            }
        }

        // PART 4, SCHEDULE B1, ITEM 18B - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 

        // For 18B  Total Tax Due- Compensation & Business Income (under graduated rates) (Item 15 x applicable Income Tax Rate from Table 2 ) (Part II Item 22)      
        function totalTaxDue18BTP() {

            var isGraduated  = document.getElementById('frm1701MS:txtTaxpayerNo12b');

            var valuePart4Item15  = document.getElementById('frm1701MS:txtCompensationBusinessNo15a');
            var valuePart4Item18B = document.getElementById('frm1701MS:TotalTaxDueCompensationBTP');

            if (isGraduated.checked) {

                // Remove commas and convert string to number
                var taxableIncome = stringToNum(valuePart4Item15.value);

                // Checked whether taxableIncome is a finite number and not negative
                if (!isFinite(taxableIncome) || taxableIncome < 0) {
                    valuePart4Item18B.value = formatCurrencyWithComma(0);
                    return;
                }

                // Compute Applicable Income Tax Rate, round off, and format with comma
                valuePart4Item18B.value = formatCurrencyWithComma(Math.round(computeRegularIncomeTax(taxableIncome)));

                // Run computation for Part2 Item22
                computeP2No22TP();
                //alert("totalTaxDue18BTP lumagpas sa computeP2No22TP");
            }
        }

        function totalTaxDue18BSP() {

            var isGraduated  = document.getElementById('frm1701MS:txtTaxpayerNo12b1');

            var valuePart4Item15  = document.getElementById('frm1701MS:txtCompensationBusinessNo15b');
            var valuePart4Item18B = document.getElementById('frm1701MS:TotalTaxDueCompensationBSP');

            if (isGraduated.checked) {

                // Remove commas and convert string to number
                var taxableIncome = stringToNum(valuePart4Item15.value);

                // Checked whether taxableIncome is a finite number and not negative
                if (!isFinite(taxableIncome) || taxableIncome < 0) {
                    valuePart4Item18B.value = formatCurrencyWithComma(0);
                    return;
                }

                // Compute Applicable Income Tax Rate, round off, and format with comma
                valuePart4Item18B.value = formatCurrencyWithComma(Math.round(computeRegularIncomeTax(taxableIncome)));

                // Run computation for Part2 Item22
                computeP2No22SP();
                //alert("totalTaxDue18BSP lumagpas sa computeP2No22TP");
            }
        }

        // PART 4, SCHEDULE B2, ITEM 21 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeTotalIncomeNo21a() {
            document.getElementById('frm1701MS:txtTotalIncomeNo21a').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtSalesRevenuesFeesANo19a').value) + 
                NumWithComma(document.getElementById('frm1701MS:txtOtherNonOperatingIncomeNo20a').value))
            computeIncomeLoss();
            computeBusinessIncome();
        }

        function computeTotalIncomeNo21b() {
            document.getElementById('frm1701MS:txtTotalIncomeNo21b').value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtSalesRevenuesFeesNo19b').value) + 
                NumWithComma(document.getElementById('frm1701MS:txtOtherNonOperatingIncomeNo20b').value))
            computeIncomeLossb();
            computeBusinessIncomeb();
        }

        // PART 4, SCHEDULE B2, ITEM 23 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeIncomeLoss(){
            document.getElementById('frm1701MS:txtTaxableIncomeLoss23A'). value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtTotalIncomeNo21a').value) -
                NumWithComma(document.getElementById('frm1701MS:txtLess22A').value))  
            computeBusinessIncome();
        }

        // Number 23 Spouse
        function computeIncomeLossb(){
            document.getElementById('frm1701MS:txtTaxableIncomeLoss23B'). value = formatCurrencyWithComma(NumWithComma(document.getElementById('frm1701MS:txtTotalIncomeNo21b').value) -
                NumWithComma(document.getElementById('frm1701MS:txtLess22B').value))
            computeBusinessIncomeb();
        }

        // PART 4, SCHEDULE B2, ITEM 24 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeBusinessIncome() {
            var taxableIncome = NumWithComma(document.getElementById('frm1701MS:txtTaxableIncomeLoss23A').value);
            if (taxableIncome >= 1) {
                // Calculate and round off the tax due
                var taxDue = Math.round(taxableIncome * 0.08);
                // Format the rounded value and set it as the field's value
                document.getElementById('frm1701MS:txtTaxDueBusinessIncome24A').value = formatCurrencyWithComma(taxDue);
                totalTaxDueCompensationAndBusinessIncome25TP();
            } else {
                // Set value to 0.00 if taxable income is less than 1
                document.getElementById('frm1701MS:txtTaxDueBusinessIncome24A').value = '0';
            }
        }

        // NUMBER 24 SPOUSE
        function computeBusinessIncomeb() {
            var taxableIncome = NumWithComma(document.getElementById('frm1701MS:txtTaxableIncomeLoss23B').value);
            if (taxableIncome >= 1) {
                // Calculate and round off the tax due
                var taxDue = Math.round(taxableIncome * 0.08);
                // Format the rounded value and set it as the field's value
                document.getElementById('frm1701MS:txtTaxDueBusinessIncome24B').value = formatCurrencyWithComma(taxDue);
                totalTaxDueCompensationAndBusinessIncome25SP();
            } else {
                // Set value to 0.00 if taxable income is less than 1
                document.getElementById('frm1701MS:txtTaxDueBusinessIncome24B').value = '0';
            }
        }

        // PART 4, SCHEDULE B2, ITEM 25 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        // NUMBER 25 TAXPAYER
        function totalTaxDueCompensationAndBusinessIncome25TP(){
            var value1 = NumWithComma(document.getElementById('frm1701MS:txtTaxpayerNo4a').value);
            var value2 = NumWithComma(document.getElementById('frm1701MS:txtTaxDueBusinessIncome24A').value);
            var totalTaxDueCBITP = value1 + value2;
            if (document.getElementById('frm1701MS:txtTaxpayerNo12c').checked) {
                document.getElementById('frm1701MS:txtCompensationBusinessNo25a').value = formatCurrencyWithComma(totalTaxDueCBITP);
                document.getElementById('frm1701MS:txtIncomeTaxRegularNo22a').value = formatCurrencyWithComma(totalTaxDueCBITP);
                computeP2No23TP();
            } else {
                document.getElementById('frm1701MS:txtCompensationBusinessNo25a').value = '0';
            }
        }

        //NUMBER 25 SPOUSE
        function totalTaxDueCompensationAndBusinessIncome25SP(){
            var value1 = NumWithComma(document.getElementById('frm1701MS:txtTaxpayerNo4b').value);
            var value2 = NumWithComma(document.getElementById('frm1701MS:txtTaxDueBusinessIncome24B').value);
            var totalTaxDueCBITP = value1 + value2;
            if (document.getElementById('frm1701MS:txtTaxpayerNo12c1').checked) {
                document.getElementById('frm1701MS:txtCompensationBusinessNo25b').value = formatCurrencyWithComma(totalTaxDueCBITP);
                document.getElementById('frm1701MS:txtIncomeTaxRegularNo22b').value = formatCurrencyWithComma(totalTaxDueCBITP);
                computeP2No23SP();
            } else {
                document.getElementById('frm1701MS:txtCompensationBusinessNo25b').value = '0';
            }
        }

        // PART 6, ITEM 1 - TAXPAYER AND SPOUSE COLUMN ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function computeTaxAvailmentTP() {
            // CONDITION: Only compute if Item12 is Special/Preferential Rate OR Exempt from IT
            if (document.getElementById('frm1701MS:txtTaxpayerNo12e').checked ||
                document.getElementById('frm1701MS:txtTaxpayerNo12d').checked) {

                var val10B = NumWithComma(document.getElementById('frm1701MS:txtSpecialAllowableNo10a').value);
                var val14  = NumWithComma(document.getElementById('frm1701MS:txtTaxableIncomeBusinesNo14a').value);
                var val17  = NumWithComma(document.getElementById('frm1701MS:txtTaxDueSpeciala').value);
                var valV8  = NumWithComma(document.getElementById('frm1701MS:txtSpecialTaxCreditsNo8a').value);

                var taxableIncome = val10B + val14;
                var computedTax = computeRegularIncomeTax(taxableIncome);

                var finalAmount = (computedTax - val17) + valV8;

                if (finalAmount < 0) {
                    finalAmount = 0;
                }

                document.getElementById('frm1701MS:totalTaxReliefAvailmentA').value =
                    formatCurrencyWithComma(Math.round(finalAmount));
            }
        }

        function computeTaxAvailmentSP() {
            // CONDITION: Only compute if Item12 is Special/Preferential Rate OR Exempt from IT
            if (document.getElementById('frm1701MS:txtTaxpayerNo12e1').checked ||
                document.getElementById('frm1701MS:txtTaxpayerNo12d1').checked) {

                var val10B = NumWithComma(document.getElementById('frm1701MS:txtSpecialAllowableNo10b').value);
                var val14  = NumWithComma(document.getElementById('frm1701MS:txtTaxableIncomeBusinesNo14b').value);
                var val17  = NumWithComma(document.getElementById('frm1701MS:txtTaxDueSpecialb').value);
                var valV8  = NumWithComma(document.getElementById('frm1701MS:txtSpecialTaxCreditsNo8b').value);

                var taxableIncome = val10B + val14;
                var computedTax = computeRegularIncomeTax(taxableIncome);

                var finalAmount = (computedTax - val17) + valV8;

                if (finalAmount < 0) {
                    finalAmount = 0;
                }

                document.getElementById('frm1701MS:totalTaxReliefAvailmentB').value =
                    formatCurrencyWithComma(Math.round(finalAmount));
            }
        }

        // UTILITY FUNCTIONS ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== ========== 
        function safePositiveNum(id) {
            var el = document.getElementById(id);
            if (!el) return 0;
            var val = el.value;
            // handle null or empty
            if (!val) return 0;
            // manual trim alternative: remove spaces using regex
            val = val.replace(/^\s+|\s+$/g, ""); // removes leading/trailing spaces
            if (val === "") return 0;
            var num = NumWithComma(val); // parse number
            // ensure finite & non‑negative
            if (!isFinite(num) || num < 0) return 0;
            return num;
        }

        function formatCurrencyWithComma(value) {
            // Normalize null/undefined/empty
            if (value === null || value === undefined || value === '') { return '0'; }
            // Convert to string and remove existing commas
            var s = String(value).replace(/,/g, '');
            // Trim spaces (simple ES3-safe trim)
            s = s.replace(/^\s+|\s+$/g, '');
            // Detect sign
            var negative = false;
            if (s.charAt(0) === '-') { negative = true; s = s.substring(1); }
            // Validate numeric (allow digits and one dot)
            if (!/^\d*\.?\d*$/.test(s) || s === '' || s === '.') { return '0'; }
            // Split integer/decimal parts
            var parts = s.split('.');
            var intPart = parts[0];
            var decPart = parts.length > 1 ? parts[1] : '';
            // Add thousand separators to integer part
            intPart = addThousandsSeparator(intPart);
            // Rebuild number string
            var formatted = decPart.length > 0 ? (intPart + '.' + decPart) : intPart;
            // Reapply sign if needed
            if (negative && formatted !== '0') { formatted = '-' + formatted; }
            return formatted;
        }

        // Helper: insert commas into integer part only (ES3-safe)
        function addThousandsSeparator(intStr) {
            // Handle leading zeros consistently (except when the whole value is zero)
            // Keep "0", but turn "" into "0"
            if (intStr === '') { intStr = '0'; }
            var out = '';
            var count = 0;
            // Walk from right to left
            for (var i = intStr.length - 1; i >= 0; i--) {
                var ch = intStr.charAt(i);
                out = ch + out;
                count++;
                if (count === 3 && i !== 0) {
                    out = ',' + out;
                    count = 0;
                }
            }
            return out;
        }

        // USECASE: For getting values from input fields (returns a Number)
        // - Removes commas
        // - Returns 0 on invalid input
        function NumWithComma(value) {
            if (value === null || value === undefined) {
                return 0;
            }
            // Normalize to string, remove commas, trim
            var s = String(value).replace(/,/g, '');
            s = s.replace(/^\s+|\s+$/g, '');
            // Quick numeric check (allow optional leading '-', digits, optional one dot)
            if (!/^-?\d*\.?\d*$/.test(s) || s === '' || s === '-' || s === '.' || s === '-.') {
                return 0;
            }
            var num = parseFloat(s);
            return isNaN(num) ? 0 : num;
        }

        function appendPercentSymbol(inputElement){
            var val = inputElement.value;
            if(val && val.indexOf('%') === -1){
                inputElement.value += '%';
            }
        }

        function stringToNum(v, fallback) {
            if (fallback === undefined) fallback = 0;

            if (v === null || v === undefined) return fallback;

            // Already a number? Return it.
            if (typeof v === "number") return isFinite(v) ? v : fallback;

            // 1) Convert to string so we can clean it
            var s = String(v);

            // 2) Remove formatting like %, spaces, commas
            s = s.replace(/\s+/g, "").replace(/%/g, "").replace(/,/g, "");

            // 3) If nothing left, invalid → fallback
            if (s === "") return fallback;

            // 4) Convert cleaned string to NUMBER
            var n = parseFloat(s);

            // 5) Return a NUMBER (or fallback NUMBER)
            return isNaN(n) ? fallback : n;
        }


