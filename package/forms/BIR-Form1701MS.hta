        function sendRequest(data, fileNameEmail, emailTaxPayer, formType, url, emailFilePath, emailTaxPayer, ftpFolder, wsData) {
            $('#container').hide();

            if (url == undefined) {
                sendThroughFTP(formType, emailFilePath, fileNameEmail, emailTaxPayer, ftpFolder, wsData);
                return;
            }

            //carlo
            alert("sending via API")
            var requestBody = JSON.stringify({ "sourceId": "AGI", "value": data });
            var xhr = new XMLHttpRequest();
            xhr.withCredentials = true;

            xhr.onreadystatechange = function () {
                if (xhr.readyState == 4) {
                    // Hide loader
                    $('#loader').hide('blind');
                    $('#loader').css('background', '#FFF');
                    checkFinalCopyBtn(formType);
                    disableDropDown("after");
                    HideContainer('ebirConfirmOnline');
                    ShowContainer('container');
                }

                if (xhr.readyState == 4 && xhr.status == 200) {
                    document.getElementById('txtFinalFlag').value = "1";
                    updateFinalFlagOnSaveFile(fileNameEmail);
                    var responseJSON = JSON.parse(xhr.responseText);
                    alert(buildSuccessMessage(responseJSON.referenceNumber, responseJSON.converted.transaction.tin,
                        responseJSON.converted.transaction.branchCode, responseJSON.formType, responseJSON.converted.transaction.retrnPeriod,
                        responseJSON.converted.transaction.dateFiled));
                    // alert("Submit Successful. Subject to validation by BIR. \n\n A notification will be sent to your email ("+ emailTaxPayer +"). Please print or save the email as an evidence of efiled return.");
                    $('#paymentOption').show();
                    $('#paymentOptionCloseBtn').on('click', function () {
                        $('#paymentOption').hide();
                        $('#container').show();
                    });
                } else if (xhr.readyState == 4) {
                    if (xhr.status == 12029) {
                        alert(xhr.status.toString() + ': Your Tax Return was not submitted online due to any of the \n following reasons: Cannot connect to server');
                    }
                    else if (xhr.responseText == "") {
                        alert(xhr.status.toString() + ': Errors occured while sending your form. Click OK to  try sending through FTP');
                        sendThroughFTP(formType, emailFilePath, fileNameEmail, emailTaxPayer, ftpFolder, wsData);
                    } else {
                        try {
                            var responseJSON = JSON.parse(xhr.responseText);

                            var errorMessage = responseJSON.erroMessage;
                            var shortMessage = errorMessage[0].shortMessage;
                            var errorDescription = errorMessage[0].description;
                            if (xhr.status == 400) {
                                alert('\n Your Tax Return was not submitted online due to any of the \n following reasons: \n' + shortMessage);
                            } else {
                                alert(shortMessage + '\n Your Tax Return was not submitted online due to any of the \n following reasons: \n' + errorDescription);
                            }
                        } catch (e) {
                            var responseJSON = JSON.parse(xhr.responseText);
                            var errorMessage = responseJSON.error;

                            alert('Your Tax Return was not submitted online due to any of the \n following reasons: ' +
                                errorMessage);
                        } finally {
                            sendThroughFTP(formType, emailFilePath, fileNameEmail, emailTaxPayer, ftpFolder, wsData);
                        }
                    }

                    document.getElementById('txtFinalFlag').value = "2";
                    updateFinalFlagOnSaveFile(fileNameEmail);
                    $('#container').show();
                }
            }

            //xhr.open("POST", url + APIENV.getRoute("SEND_COMPRESSED_FORM") + "F" + formType, false);
            xhr.open("POST", url + "/F2550Qv2018/form", false);
            xhr.setRequestHeader("Content-Type", "application/json");
            xhr.timeout = 30000;
            xhr.send(requestBody);
        }

        function sendThroughFTP(formType, emailFilePath, fileNameEmail, emailTaxPayer, ftpFolder, wsData) {
            try {
                //BIRSendEmail('1701MS@birgovph.org', '1701MS@bir.gov.ph', emailTaxPayer, emailSubject, emailBody, emailFilePath, 'frm1701MS', 'smtp1.birgovph.org', '25', isRegisteredTP);
                var ftpFolder = enviService.getFtpFolder('1701MS');
                var returnCode = RenameAndSendFile(emailFilePath, emailTaxPayer, ftpFolder, wsData.mode, wsData.srv, wsData.sslport, wsData.port, wsData.usr, wsData.pass); clearFileNameWOemail();
                $('#container').hide();
                if (returnCode == 0) {
                        document.getElementById('txtFinalFlag').value = "1";updateFinalFlagOnSaveFile(fileNameEmail);alert("Submit Successful. Subject to validation by BIR.\n\n" +      "A notification will be sent to your email (" + emailTaxPayer + "). Please print or save the email as an evidence of efiled return.\n\n" +      "Note: There will be some delays on email sending of confirmation, please bear with us.\n\n" +      "In case of delay or non-receipt of system generated email confirmation from eBirforms, please check on the following possible reasons:\n\n" +      "1. Invalid email address / Inactive email account\n" +      "2. Email account quota exceeded\n" +      "3. Email confirmation is diverted to Spam and/or Junk emails folder\n" +      "4. Company firewall policy restricts receipt of email from ebirforms-noreply@bir.gov.ph");
                    $('#paymentOption').show();
                    $('#paymentOptionCloseBtn').on('click', function () {
                        $('#paymentOption').hide();
                        $('#container').show();
                    });
                }
                else {
                    document.getElementById('txtFinalFlag').value = "2"; updateFinalFlagOnSaveFile(fileNameEmail); alert('Your Tax Return was not submitted online due to any of the \n following reasons that may interrupt the submission process: \n - No internet connection \n - Slow internet connection \n - Overly restrictive firewall');
                    $('#container').show();
                }
            }
            catch (e) {
                document.getElementById('txtFinalFlag').value = "2"; updateFinalFlagOnSaveFile(fileNameEmail); alert('Your Tax Return was not submitted online due to any of the \n following reasons that may interrupt the submission process: \n - No internet connection \n - Slow internet connection \n - Overly restrictive firewall');
                $('#container').show();
            }
            finally {
            }
            // Hide loader
            $('#loader').hide('blind');
            $('#loader').css('background', '#FFF'); checkFinalCopyBtn(formType); disableDropDown("after");
            HideContainer('ebirConfirmOnline');
            ShowContainer('container');
        }

