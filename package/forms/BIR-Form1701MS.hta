        function loadBGXML(loadWhere) {
            try {
                //This will load the file with filename loadWhere if it exists
                var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
                XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);

                if (XMLBGFile.AtEndOfStream) 
                {
                    data = "";
                } 
                else 
                {
                    var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
                    responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag			
                }
                
                XMLBGFile.Close();

                // Debug
                // alert( responseBG.innerHTML );
                // This will load data onto fields
                loadBGData();	
            } 
            catch (e) 
            {
                msg.innerHTML = "";
            }
        }

        function loadBGData() {
            /* This will load data onto Background Information fields */
            var responseBG = document.getElementById("responseBG");
            
            // This is the data came from
            var formTypeVal = String(responseBG.innerHTML).split('formType=');

            if (formTypeVal.length > 1 && formTypeVal[1] == '1701MS') {
                
                var tin1Val = String(responseBG.innerHTML).split('tin1=');
                if (tin1Val.length > 1) {
                    var tin1 = tin1Val[1].split('&')[0];
                    document.getElementById('frm1701MS:txtPg1TIN1').value = tin1;
                    document.getElementById('frm1701MS:txtPg2TIN1').value = tin1;
                
                }

                // TIN 2
                var tin2Val = String(responseBG.innerHTML).split('tin2=');
                if (tin2Val.length > 1) {
                    var tin2 = tin2Val[1].split('&')[0];
                    document.getElementById('frm1701MS:txtPg1TIN2').value = tin2;
                document.getElementById('frm1701MS:txtPg2TIN2').value = tin2;
                }

                // TIN 3
                var tin3Val = String(responseBG.innerHTML).split('tin3=');
                if (tin3Val.length > 1) {
                    var tin3 = tin3Val[1].split('&')[0];
                    document.getElementById('frm1701MS:txtPg1TIN3').value = tin3;
                    document.getElementById('frm1701MS:txtPg2TIN3').value = tin3;
                
                }

                // Branch Code
                var tin4Val = String(responseBG.innerHTML).split('tin4=');
                if (tin4Val.length > 1) {
                    var branchCode = tin4Val[1].split('&')[0];
                    document.getElementById('frm1701MS:txtPg1BranchCode').value = branchCode;
                    document.getElementById('frm1701MS:txtPg2BranchCode').value = branchCode;
                
                }

                
            var rdoCodeVal = String(responseBG.innerHTML).split('rdo=');
                if (rdoCodeVal.length > 1) {
                    var rdoCode = rdoCodeVal[1].split('&')[0];
                    document.getElementById('frm1701MS:txtRDOCode').value = rdoCode;
                }
                    var taxpayerNoVal = String(responseBG.innerHTML).split('fn=');
                if (taxpayerNoVal.length > 1) {
                    var taxpayerNo = taxpayerNoVal[1].split('&')[0];
                    document.getElementById('frm1701MS:txtTaxpayerNo8a').value = unescape(taxpayerNoVal[1]).toUpperCase();
                    document.getElementById('frm1701MS:Pg2TaxPayer').value = unescape(taxpayerNoVal[1]).split(',')[0].toUpperCase();

                }
                    var emailVal = String(responseBG.innerHTML).split('email=');
                if (emailVal.length > 1) {
                    var email = emailVal[1].split('&')[0];
                    document.getElementById('frm1701MS:txtEmaila').value = email;
                }
                var telNumVal = String(responseBG.innerHTML).split('telNo=');
                if (telNumVal.length > 1) {
                    var telNum = telNumVal[1].split('&')[0];
                    document.getElementById('frm1701MS:txtTelNum10a').value = telNum;
                }
            }
        }

        function createXMLProfileName() {
            try
            {
                var xmlFileName = "";	

                var titleTin1 = d.getElementById('frm1701MS:txtPg1TIN1');
                var titleTin2 = d.getElementById('frm1701MS:txtPg1TIN2');
                var titleTin3 = d.getElementById('frm1701MS:txtPg1TIN3');
                var titleBranchCode = d.getElementById('frm1701MS:txtPg1BranchCode');	
                var titleTPName = d.getElementById('frm1701MS:txtTaxpayerNo8a');	
                var formType = "1701MS";		
                
                xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";		
            
                return xmlFileName;
            } 
            catch(e) 
            {
                alert('Exception : '+e.description);
            }	
        }

        function loadData() {

            /*This will load data onto fields*/
            var response = d.getElementById("response");

            var elem = document.getElementById('frmMain').elements;  

            for (var i = 0; i < elem.length; i++) {
                try {
                    if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {			
                        if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                            var fieldVal = String($("#response").html()).split(elem[i].id + '=');

                            if (elem[i].id == 'frm1701MS:txtTaxpayerNo8a') {
                                elem[i].value = unescape(fieldVal[1]);
                            }

                            else if (elem[i].className.indexOf("FinalFlag") > -1) {
                                elem[i].value = typeof (fieldVal[1]) === "undefined" ? "3" : fieldVal[1];
                            }

                            else {
                                elem[i].value = fieldVal[1];
                            }
                            
                        }

                        if (elem[i].type == 'radio') {
                            var rdoVal = String($("#response").html()).split(elem[i].id + '=');
                            if (rdoVal[1] == 'true') {
                                elem[i].checked = rdoVal[1];
                                
                            }
                        }

                        if (elem[i].type == 'checkbox') {
                            var chkboxVal = String($("#response").html()).split(elem[i].id + '=');
                            if (chkboxVal[1] == 'true') {
                                elem[i].checked = chkboxVal[1];
                            }
                        }
                    }
                } catch (e) {
                    alert('exception thrown : e : '+e.description);
                }

            }
            document.getElementById('txtEmail').value = globalEmail;
        }
            
        function createEncXMLFileName(subFolder) {
            var xmlFileName = "";
            var titleTin1 = d.getElementById('frm1701MS:txtPg1TIN1');
            var titleTin2 = d.getElementById('frm1701MS:txtPg1TIN2');
            var titleTin3 = d.getElementById('frm1701MS:txtPg1TIN3');
            var titleBranchCode = d.getElementById('frm1701MS:txtPg1BranchCode');
            var titleTPName = d.getElementById('frm1701MS:txtTaxpayerNo8a');
            var returnPeriod = d.getElementById('frm1701MS:txtMonthNo1').value + d.getElementById('frm1701MS:txtYearNo1').value;



            xmlFileName = subFolder + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
                "-1701MS-" +
                returnPeriod +
                ".xml";


            fileName = titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
                "-1701MS-" +
                returnPeriod +
                ".xml";

            return xmlFileName;
        }

        function saveXMLProfile(isFinalCopy) {

            if (gIsReadOnly == false) {
                var xmlFileName = createXMLProfileName();
                msg.innerHTML = 'Generating File...';
                var fileSys = new ActiveXObject("Scripting.FileSystemObject");
                var xmlFile = fileSys.CreateTextFile(xmlFileName); //(saveWhere);
                
                var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
                allXML += tab; //adds line break			
            
                allXML += "<div>fn=" + escape(d.getElementById('frm1701MS:txtTaxpayerNo8a').value) + "fn=</div>" + tab;
                
                allXML += "<div>tin1=" + d.getElementById('frm1701MS:txtPg1TIN1').value + "tin1=</div>" + tab;
                
                allXML += "<div>tin2=" + d.getElementById('frm1701MS:txtPg1TIN2').value + "tin2=</div>" + tab;
                
                allXML += "<div>tin3=" + d.getElementById('frm1701MS:txtPg1TIN3').value + "tin3=</div>" + tab;
            
                allXML += "<div>tin4=" + d.getElementById('frm1701MS:txtPg1BranchCode').value + "tin4=</div>" + tab;

                allXML += "<div>rdo=" + d.getElementById('frm1701MS:txtRDOCode').value + "rdo=</div>" + tab;           
            
                allXML += "<div>telNo=" + d.getElementById('frm1701MS:txtTelNum10a').value + "telNo=</div>" + tab;
            
                allXML += "<div>email=" + document.getElementById('frm1701MS:txtEmaila').value + "email=</div>" + tab; 
                
                allXML += "<div>confirmemail=" + document.getElementById('frm1701MS:txtEmaila').value + "confirmemail=</div>" + tab;
            
                allXML += "<div>confirmtin1=" + d.getElementById('frm1701MS:txtPg1TIN1').value + "confirmtin1=</div>" + tab;
                
                allXML += "<div>confirmtin2=" + d.getElementById('frm1701MS:txtPg1TIN2').value + "confirmtin2=</div>" + tab;
            
                allXML += "<div>confirmtin3=" + d.getElementById('frm1701MS:txtPg1TIN3').value + "confirmtin3=</div>" + tab;
                
                allXML += "<div>confirmtin4=" + d.getElementById('frm1701MS:txtPg1BranchCode').value + "confirmtin4=</div>" + tab;
                
                allXML += "<div>formType=1701MS=</div>" + tab;

                allXML += tab + d.getElementById('xmlClose').innerHTML;

                xmlFile.write(allXML);
                xmlFile.close();
                msg.innerHTML = '';

                if (isFinalCopy == false) 
                {
                    alert('Background information saved/updated successfully as : ' + xmlFileName);
                }
            }
        }

        function goToPage() {
            var newVal = document.getElementById("frm1701MS:txtCurrentPage").value;
            var printType = !isFromPrint ? "Page" : "Print";
            var printType = "Page";

            if ((newVal <= MaxPage) && (newVal > 0) && (newVal !== currentPage.toString())) {
                $('#' + printType + currentPage + 'Content').hide('blind');
                $('#' + printType + newVal + 'Content').show('blind');
                currentPage = (document.getElementById("frm1701MS:txtCurrentPage").value) * 1;
            }
            else if ((newVal > MaxPage) || (newVal <= 0)) {
                alert("Invalid page");

                document.getElementById("frm1701MS:txtCurrentPage").value = currentPage;
            }

            if (isFromPrint) {
                //printOCR();
            }
        }

        // BUTTON FOR PREV
        function processPrev() {
            if (currentPage == 1)
                currentPage = 1;
            else {
                currentPage--;
                $('#Page' + currentPage + 'Content').show('blind');
                $('#Page' + (currentPage + 1) + 'Content').hide('blind');
                document.getElementById('frm1701MS:txtCurrentPage').value = currentPage;
            }
        }

        // BUTTON FOR NEXT PAGE
        function processNext() {
            if (currentPage == MaxPage) {
            }
            else {
                currentPage++;
                $('#Page' + currentPage + 'Content').show('blind');
                $('#Page' + (currentPage - 1) + 'Content').hide('blind');
                document.getElementById('frm1701MS:txtCurrentPage').value = currentPage;
            }
        }

        function cancel() {
            $('#bg').show();
            $('.printSignFooterClass').hide();
            $('.imgClass').hide();
            $('body').css('background', '#FFF');

            $('#formPaper').css({ 'border': '#CCC 1px solid', 'margin': '0 auto', 'background': '#FFF' });
            $('#wrapper').css({ 'padding': '1%', 'margin': '0 auto' });
            $('#container').css({ 'padding': '1%', 'margin': '0 auto' });
            $('.labels').remove();

            var elem = document.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {
                if (elem[i].type != 'hidden') { // && elem[i].type != 'undefined' 
                    if (elem[i].type == 'text') {
                        document.getElementById(elem[i].id).readOnly = false;
                        document.getElementById(elem[i].id).style.height = "15px";
                        document.getElementById(elem[i].id).style.fontSize = "13px";
                        if (d.getElementById('frm1701MS:btnValidate').disabled == false) {
                            if (disabledItems.contains(elem[i].id)) {
                                document.getElementById(elem[i].id).disabled = true;
                            }
                            else {
                                document.getElementById(elem[i].id).disabled = false;
                            }
                        }
                        else {
                            if (disabledItems.contains(elem[i].id)) {
                                document.getElementById(elem[i].id).disabled = true;
                            }
                            else {
                                document.getElementById(elem[i].id).disabled = false;
                            }
                        }
                    }
                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        if (d.getElementById('frm1701MS:btnValidate').disabled == false) {
                            if (disabledItems.contains(elem[i].id)) {
                                document.getElementById(elem[i].id).disabled = true;
                            }
                            else {
                                document.getElementById(elem[i].id).disabled = false;
                            }
                        }
                        else {
                            if (disabledItems.contains(elem[i].id)) {
                                document.getElementById(elem[i].id).disabled = true;
                            }
                            else {
                                document.getElementById(elem[i].id).disabled = false;
                            }
                        }
                        document.getElementById(elem[i].id).style.height = "15px";
                        document.getElementById(elem[i].id).style.fontSize = "11px";
                    }
                    if (elem[i].type == 'select-one') {
                        $(elem[i]).show();
                    }
                }
            }

            $('input').each(function () {
                if (this.type == 'button') {
                    if (this.id != 'test') {
                        $(this).removeClass('previewButtonClass');
                    }
                }
            });

            $('a').each(function () {
                if (this.id.length > 1) {
                    if (d.getElementById('frm1701MS:btnValidate').disabled == false) {
                        if (enableElem) {
                            d.getElementById(this.id).disabled = true;
                        }
                        else if (disableElem) {
                            d.getElementById(this.id).disabled = false;
                        }
                    }
                    else {
                        if (disableElem) {
                            d.getElementById(this.id).disabled = true;
                        }
                        else if (enableElem) {
                            d.getElementById(this.id).disabled = false;
                        }
                    }
                }
            });

            $('#formMenu').show('blind');
            if ($('#printMenu').css('display') != 'none') {
                $('#printMenu').hide('blind');
            }
            isFromPrint = false;
        }

        Array.prototype.contains = Array.prototype.indexOf ?
            function (val) {
                return this.indexOf(val) > -1;
            } :
            function (val) {
                var i = this.length;
                while (i--) {
                    if (this[i] === val) {
                        return true;
                    }
                }
                return false;
            };

        disabledItems = new Array();
        isFromPrint = false;
        function printme() {
            
            var inputs = document.getElementsByTagName("input");

            var elements = document.getElementById("formPaper").getElementsByTagName("*");

            for (var i = 0; i < elements.length; i++) {
                var el = elements[i];
                var size = el.currentStyle ? el.currentStyle.fontSize : null;

                if (size) {
                    var px = parseFloat(size);   
                    if (px >= 10 && px <= 16) {
                        el.setAttribute("data-original-font", el.style.fontSize);
                        el.style.fontSize = "8px";   
                    }
                    
                }
            }
            


            $('#formPaper').css({ 'width': '99.5%', 'max-height': '14in !important', 'border': '#000 2px solid', 'margin': '0' });
            $('#wrapper').css({ 'width': '8.3in', 'max-height': '14in !important', 'margin': '0' });
            $('#container').css({ 'width': '8.3in', 'max-height': '14in !important', 'margin': '0' });

            $('#bg').hide();
            $('.printSignFooterClass').css({ 'max-width': '80%', 'margin': '30px auto 0 auto', 'display': 'block', 'position': 'relative', 'overflow': 'visible', 'background': '#ffffff' });
            $('.imgClass').css({ 'margin': 'auto', 'display': 'block', 'position': 'relative', 'overflow': 'visible' });
            $('body').css('background', '#FFF');

            $('#tblsched410A1 td input').css({'width':'100%'});
            $('#tblsched410A2 td input').css({'width':'100%'});

            $('.printSignFooterClass table th:last-child, .printSignFooterClass table td:last-child').hide();

            var elem = document.getElementById('frmMain').elements;
            var x = 0;
            disabledItems = new Array();
            for (var i = 0; i < elem.length; i++) {
                if (elem[i].type != 'hidden') {
                    if (elem[i].type == 'text') {
                        if (document.getElementById(elem[i].id).disabled) {
                            disabledItems[x] = elem[i].id;
                            x++;
                        }
                        document.getElementById(elem[i].id).disabled = false;
                        document.getElementById(elem[i].id).readOnly = true;
                        document.getElementById(elem[i].id).style.backgroundColor = '#FFFFFF';
                        document.getElementById(elem[i].id).style.color = '#000000';
                        document.getElementById(elem[i].id).style.height = "12px";
                        document.getElementById(elem[i].id).style.fontSize = "8px";
                    }
                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        if (document.getElementById(elem[i].id).disabled) {
                            disabledItems[x] = elem[i].id;
                            x++;
                        }
                        document.getElementById(elem[i].id).disabled = true;
                        document.getElementById(elem[i].id).style.height = "12px";
                        document.getElementById(elem[i].id).style.fontSize = "8px";
                    }
                }
            }

            

            $('input').each(function () {
                if (this.type == 'button') {
                    if (this.id != 'test') {
                        $(this).addClass('previewButtonClass');
                    }
                }
            });

            $('a').each(function () {
                if (this.id.length > 1) {
                    document.getElementById(this.id).disabled = true;
                }
            });

            $('#printMenu').show('blind');
            if ($('#formMenu').css('display') != 'none') {
                $('#formMenu').hide('blind');
            }

            document.getElementById('frm1701MS:txtCurrentPage').disabled = false;
            document.getElementById('frm1701MS:txtCurrentPage').readOnly = false;
            alert("This form must be printed on a Legal Size Paper. If you are going to save this to a file, saving as PDF or XPS is allowed.");

            // Print the document
            window.print();

            // Restore the original state after printing
            // restoreOriginalState();
            var elements = document.getElementById("formPaper").getElementsByTagName("*");

            for (var i = 0; i < elements.length; i++) {
                var el = elements[i];
                var original = el.getAttribute("data-original-font");

                if (original !== null) {
                    el.style.fontSize = original;   // restore exact previous value
                    el.removeAttribute("data-original-font");
                }
            }
            $('.printSignFooterClass table th:last-child, .printSignFooterClass table td:last-child').show();
        }
        function printModal(modalId) {
            var modal = document.getElementById(modalId);

            // Save original page
            var originalBody = document.body.innerHTML;

            //To avoid the modal from overlapping the page
            $('#tblsched410A1 td input').css({'width':'100%'});
            $('#tblsched410A2 td input').css({'width':'100%'});
            $('#modalSched5No9 td input').css({'width':'100%'});

            //hide the action column
            $('.printSignFooterClass table th:last-child, .printSignFooterClass table td:last-child').hide();

            // Replace body with modal only
            document.body.innerHTML = modal.outerHTML;

            // Print
            window.print();

            // Restore page AFTER printing
            document.body.innerHTML = originalBody;

            //Restore the action column
             $('.printSignFooterClass table th:last-child, .printSignFooterClass table td:last-child').show();

            // Re-initialize menus after restoring the page
            initMenus();
        }

        

        function initMenus() {
            // Avoid duplicate spans
            $("ul.subnav").parent().not(":has(span)").append("<span></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)  
            $("ul.topnav li span").off('click').off('mouseenter').off('mouseleave').click(function () { //When trigger is clicked...            
                //Following events are applied to the subnav itself (moving subnav up and down)  
                $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
                $(this).parent().hover(function () {
                }, function () {
                    $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
                });
                //Following events are applied to the trigger (Hover events for the trigger)  
            }).hover(function () {
                $(this).addClass("subhover"); //On hover over, add class "subhover"  
            }, function () {  //On Hover Out  
                $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
            });
            $("ul.topnav .toplevel").off('click').off('mouseenter').off('mouseleave').click(function () { //When trigger is clicked...            
                //Following events are applied to the subnav itself (moving subnav up and down)  
                $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
                $(this).parent().hover(function () {
                }, function () {
                    $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
                });
                //Following events are applied to the trigger (Hover events for the trigger)  
            }).hover(function () {
                $(this).addClass("subhover"); //On hover over, add class "subhover"  
            }, function () {  //On Hover Out  
                $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
            });

            // Avoid duplicate spans for asubnav
            $("ul.asubnav").parent().not(":has(span)").append("<span style='display:none;'></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)  
            $("ul.atopnav li span").off('click').off('mouseenter').off('mouseleave').click(function () { //When trigger is clicked...            
                //Following events are applied to the subnav itself (moving subnav up and down)  
                $(this).parent().find("ul.asubnav").slideDown('fast').show(); //Drop down the subnav on click    
                $(this).parent().hover(function () {
                }, function () {
                    $(this).parent().find("ul.asubnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
                });
                //Following events are applied to the trigger (Hover events for the trigger)  
            }).hover(function () {
                $(this).addClass("subhover"); //On hover over, add class "subhover"  
            }, function () {  //On Hover Out  
                $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
            });
            $("ul.atopnav .atoplevel").off('click').off('mouseenter').off('mouseleave').click(function () { //When trigger is clicked...            
                //Following events are applied to the subnav itself (moving subnav up and down)  
                $(this).parent().find("ul.asubnav").slideDown('fast').show(); //Drop down the subnav on click    
                $(this).parent().hover(function () {
                }, function () {
                    $(this).parent().find("ul.asubnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
                });
                //Following events are applied to the trigger (Hover events for the trigger)  
            }).hover(function () {
                $(this).addClass("subhover"); //On hover over, add class "subhover"  
            }, function () {  //On Hover Out  
                $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
            });
        }

        $(document).ready(function () {
