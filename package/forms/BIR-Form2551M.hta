            "<td width='13%' id='tdtxtIncomePayments:" + counter + "'><input style='font-size:9px; text-align: right' type='text' size='9' value='0.00' id='frm2551m:txtIncomePayments" + counter + "' onblur = 'round(this,2)' onkeypress='return numbersonly(this, event)' /></td>" +
            "<td width='18%' id='tdtxtTaxWithheld:" + counter + "'><input style='font-size:9px; text-align: right' type='text' size='14' value='0.00' id='frm2551m:txtTaxWithheld" + counter + "' onblur = 'round(this,2)' onkeypress='return numbersonly(this, event)' /></td>" +
            "<td width='16%' id='tdtxtApplied:" + counter + "'><input style='font-size:9px; text-align: right' type='text'  size='14' value='0.00' id='frm2551m:txtApplied" + counter + "' onblur = 'getRowInTable(); round(this,2)' onkeypress='return numbersonly(this, event)' /></td></tr>";

        //waitstr = setTimeout("setInputTextControl_NumberFormatter('frm2551m:txtIncomePayments" + counter + "', 12, 2);", 100);
        //waitstr = setTimeout("setInputTextControl_NumberFormatter('frm2551m:txtTaxWithheld" + counter + "', 12, 2);", 100);
        //waitstr = setTimeout("setInputTextControl_NumberFormatter('frm2551m:txtApplied" + counter + "', 12, 2);", 100);

        waitstr = setTimeout("TaxCreditAlignment()",100);
