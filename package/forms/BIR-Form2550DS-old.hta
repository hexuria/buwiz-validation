    <!-- MODAL - Payment Option  -->
    <div id="paymentOption" class="payment-option" style="margin-top:20% !important;">
        <div align="center">
            <img src="../img/bir_broadcast_logo.png" alt="bir logo" class="payment-option-content" />
            <img src="../img/epay_logo.png" alt="bir logo" class="payment-option-content" />
            <br /><br />
            <span class="payment-option-content">You can now pay electronically through the following channels</span>
            <br /><br />
            <span class="payment-option-content">
                <a href="https://www.bir.gov.ph/index.php/eservices/epay.html"
                    target="_blank">https://www.bir.gov.ph/index.php/eservices/epay.html</a>
            </span>
            <br /><br />
        </div>
        <div id="paymentOptionFooter" class="payment-option-footer">
            <input id="paymentOptionCloseBtn" type="button" style="width:120px; height:30px;" value="Close" />
        </div>
    </div>
    <form id="frmMain" name="frmMain">
        <div id="container">
            <div id="wrapper" style="margin: 0 auto; position: relative; width: 850px;">
                <table border="0" width="800" cellspacing="0" cellpadding="0" align="center"
                    style="background-image: url(../img/frmbg.png); background-repeat: repeat-x;">
                    <tr>
                        <td>
                            <div id="formPaper">
                                <div id="mainContent">
                                   
                                
                                    <table width="800" border="0" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td>
                                                    <table width="800" border="0" cellspacing="0" cellpadding="0">
                                                        <tr>
                                                            <td width="300" valign="bottom">
                                                                <p><img src="../img/bcs_new.png" width="80" /> </p>
                                                            </td>
                                                            <td>
                                                                <p><img src="../img/header_logo.png" width="210"
                                                                        height:"50px" /> </p>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                            <!-- HEADER -->
                                            <tr>
                                                <td>
                                                    <table width="741" border="1" cellspacing="0" cellpadding="0">
                                                        <tr>
                                                            <td width="120" valign="middle" style="text-align: center;">
                                                                <font face="Arial" size="1px">BIR Form No.</font>
                                                                <br />
                                                                <font size="5px" style="font-weight:bold;">2550-DS
                                                                </font>
                                                                <br />
                                                                <font face="Arial" size="1px">January 2025</font>
                                                                <br />
                                                            </td>
                                                            <td width="0" valign="center"
                                                                style="text-align: center; width: 55%;">
                                                                <font size="5px" style="font-weight:bold;">Value-Added
                                                                    Tax (VAT) Return</font>
                                                                <br />
                                                                <font size="3px" style="font-weight:bold;">For
                                                                    Nonresident Digital Service Provider</font><br>
                                                                <font size="1px"
                                                                    style="font-weight:normal; font-size: largerBold; ">
                                                                    <em>
                                                                        Enter all required information in CAPITAL
                                                                        LETTERS using black ink. Mark applicable boxes
                                                                        with an "X". Two copies MUST be filed with the
                                                                        BIR and one held by the Taxpayer.
                                                                    </em>
                                                                </font>
                                                            </td>
                                                            <td width="200" valign="center">
                                                                <p style="text-align: center;"><img src="../img/2550DS_BarCode/2550DS.png"
                                                                        width="220" height:"75px" /> </p> 
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                            <!-- Items 1 - 2 -->
                                            <tr>
                                                <td>
                                                    <table width="741" border="0" cellspacing="0" cellpadding="0"
                                                        class="tblForm">
                                                        <tr>
                                                            <!-- NUMBER 1 =============================================== =============================================== =============================================== -->
                                                            <td valign="center" class="tblFormTd" style="height: 30px;">
                                                                <font size="1.5" style="font-weight: bold;">
                                                                    &nbsp;1&nbsp;</font>
                                                                <font size="0.75">Type of payment</font>
                                                                <input id="frm2550ds:paymentValueAddedTax"
                                                                    name="frm2550ds:optTypeOfPayment" value="Y"
                                                                    type="radio" onclick="disableAdvancePaymentAmount(this);" />
                                                                  
                                                                <label for="frm2550ds:paymentValueAddedTax"
                                                                    style="font-size: 10px;">Payment of Value-Added Tax
                                                                    Due&nbsp;&nbsp;</label>
                                                                <input id="frm2550ds:paymentAdvanceDeposit"
                                                                    name="frm2550ds:optTypeOfPayment" value="N"
                                                                    type="radio" onclick="disableAdvancePaymentAmount(this);" />
                                                                    <!-- onclick="changeMonth(); RtnPeriodFromNo4(this);"  -->
                                                                <label for="frm2550ds:paymentAdvanceDeposit"
                                                                    style="font-size: 10px;">Advance
                                                                    Payment/Deposit</label>
                                                            </td>                                                           
