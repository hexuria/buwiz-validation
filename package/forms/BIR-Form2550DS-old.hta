    // NUMBER 2 - YEAR MUST NOT BE BELLOW CURRENT YEAR
    function validateCurrentYear() {
        var year = new Date();
        var currentYear = year.getFullYear();
        if (d.getElementById('frm2550ds:txtYearNo2').value < 2025) {
            alert('Year must be 2025 onwards.');

            d.getElementById('frm2550ds:txtYearNo2').value = currentYear;

            return;
        }
    }

