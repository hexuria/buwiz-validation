            specify22DToCommit[i].txtSpecifyNo22DAmount = d.getElementById('frm2550ds:totalTaxPayableNo22DAmount' + i).value;
        }

        if (size < 1) {
            specify22DToCommit[size] = new NewSpecifyNo22D();
            specify22DToCommit[size].txtSpecifyNo22DDescription = externalInputValueDescription;
            specify22DToCommit[size].txtSpecifyNo22DAmount = externalInputValueTotal
        } 


