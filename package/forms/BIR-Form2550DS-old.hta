    function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = "";
            } else {
                var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag			
            }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug				
            loadBGData();	/*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = "";
        }
    }

    function loadBGData() {
        /*This will load data onto Background Information fields*/

        var responseBG = d.getElementById("responseBG");                   

        // This is the data came from
        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type
        
        if (formTypeVal[1] == '2550DS') {
           
            // TIN 1 ======================== ======================== ========================
            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            d.getElementById('frm2550ds:txtTIN1').value = tin1Val[1];     
            //d.getElementById('frm2550ds:txtTIN1_2').value = tin1Val[1];       
            // TIN 2 ======================== ======================== ========================
            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            d.getElementById('frm2550ds:txtTIN2').value = tin2Val[1];  
            //d.getElementById('frm2550ds:txtTIN2_2').value = tin2Val[1];          
            // TIN 3 ======================== ======================== ========================
            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            d.getElementById('frm2550ds:txtTIN3').value = tin3Val[1];  
            //d.getElementById('frm2550ds:txtTIN3_2').value = tin3Val[1];  
            // TIN 1 ======================== ======================== ========================
            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            d.getElementById('frm2550ds:branchCode').value = tin4Val[1];
            //d.getElementById('frm2550ds:branchCode_2').value = tin4Val[1];
            // RDO ======================== ======================== ========================
            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm2550ds:rdoCode').value = rdoVal[1];
            // TAX PAYER NAME ======================== ======================== ========================
            var fnVal = String(responseBG.innerHTML).split('fn=');
            d.getElementById('frm2550ds:taxpayerName').value = unescape(fnVal[1]); 
            //d.getElementById('frm2550ds:taxpayerName_2').value = unescape(fnVal[1]);         
            // ADDRESS ======================== ======================== ========================
            var regAddress = String(responseBG.innerHTML).split('regAddr=');
            d.getElementById('frm2550ds:address').value = unescape(regAddress[1]);

            // CONTACT NUMBER ======================== ======================== ========================
            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            //d.getElementById('frm2550ds:telephoneNum').value = telNoVal[1];
        }

        var emailVal = String(responseBG.innerHTML).split('email=');
        if (emailVal[1] === undefined) {
            document.getElementById('frm2550ds:emailAddress').value = "";
            document.getElementById('frm2550ds:emailAddress_2').value = "";
        }
        else {
            document.getElementById('frm2550ds:emailAddress').value = emailVal[1];
            //document.getElementById('frm2550ds:emailAddress_2').value = emailVal[1];
            globalEmail = emailVal[1];
        }      
    }

    function createXMLProfileName() {
        try {
            var xmlFileName = "";

            var titleTin1 = d.getElementById('frm2550ds:txtTIN1');
            var titleTin2 = d.getElementById('frm2550ds:txtTIN2');
            var titleTin3 = d.getElementById('frm2550ds:txtTIN3');
            var titleBranchCode = d.getElementById('frm2550ds:branchCode');
            var titleTPName = d.getElementById('frm2550ds:TaxPayer');
            var formType = "2550DS";

            xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";

            return xmlFileName;
        } catch (e) {
            alert('Exception : ' + e.description);
        }
    }

    function saveXMLProfile(isFinalCopy) {
        if (gIsReadOnly == false) {
            var xmlFileName = createXMLProfileName();

            msg.innerHTML = 'Generating File...';
            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFile = fileSys.CreateTextFile(xmlFileName); //(saveWhere);

            var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break			

            allXML += "<div>fn=" + escape(d.getElementById('frm2550ds:taxpayerName').value) + "fn=</div>" + tab;
            allXML += "<div>tin1=" + d.getElementById('frm2550ds:txtTIN1').value + "tin1=</div>" + tab;
            allXML += "<div>tin2=" + d.getElementById('frm2550ds:txtTIN2').value + "tin2=</div>" + tab;
            allXML += "<div>tin3=" + d.getElementById('frm2550ds:txtTIN3').value + "tin3=</div>" + tab;
            allXML += "<div>tin4=" + d.getElementById('frm2550ds:branchCode').value + "tin4=</div>" + tab;
            allXML += "<div>rdo=" + d.getElementById('frm2550ds:rdoCode').value + "rdo=</div>" + tab;
            allXML += "<div>regAddr=" + escape(d.getElementById('frm2550ds:address').value) + "regAddr=</div>" + tab;            
            allXML += "<div>telNo=" + d.getElementById('frm2550ds:telephoneNum').value + "telNo=</div>" + tab;
            allXML += "<div>email=" + document.getElementById('frm2550ds:emailAddress').value + "email=</div>" + tab; allXML += "<div>confirmemail=" + document.getElementById('frm2550ds:emailAddress').value + "confirmemail=</div>" + tab;
            allXML += "<div>confirmtin1=" + d.getElementById('frm2550ds:txtTIN1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm2550ds:txtTIN2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm2550ds:txtTIN3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm2550ds:branchCode').value + "confirmtin4=</div>" + tab;
            allXML += "<div>formType=2550DS=</div>" + tab;

            allXML += tab + d.getElementById('xmlClose').innerHTML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (isFinalCopy == false) {
                alert('Background information saved/updated successfully as : ' + xmlFileName);
            }
        }
    }

   

