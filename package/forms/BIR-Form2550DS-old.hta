        // var today = new Date();
        // var currentYear = today.getFullYear();
        // var currentMonth = today.getMonth() + 1; // JS months are 0-based (0 = Jan, 11 = Dec)
        // var currentDay = today.getDate();

        // // Convert return period and current date to JavaScript Date objects
        // var returnPeriodDate = new Date(rtnPeriodYear, rtnPeriodMonth - 1, rtnPeriodDay);
        // var currentDate = new Date(currentYear, currentMonth - 1, currentDay);

        // var lateFilingDate = new Date();
        // lateFilingDate.setDate(returnPeriodDate.getDate()+25);
      
        // if ((d.getElementById('frm2550ds:vatStillPayable').value) <0) {
        //     d.getElementById('frm2550ds:addPenaltiesInterest').value=0;
        // }

        // if (lateFilingDate >  currentDate) {
        //     const diffTime = Math.abs(lateFilingDate - currentDate);
        //     const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24)); 
        //     d.getElementById('frm2550ds:addPenaltiesTotal').value = formatCurrency((NumWithComma(d.getElementById('frm2550ds:vatStillPayable').value ) * .25) + (NumWithComma(d.getElementById('frm2550ds:addPenaltiesInterest').value) * .12 * (diffDays/365)));
        // }
        // else {
        //      d.getElementById('frm2550ds:addPenaltiesTotal').value = formatCurrency(NumWithComma(d.getElementById('frm2550ds:addPenaltiesSurcharge').value) + NumWithComma(d.getElementById('frm2550ds:addPenaltiesInterest').value));
        // }
                
        d.getElementById('frm2550ds:addPenaltiesTotal').value = formatCurrency(NumWithComma(d.getElementById('frm2550ds:addPenaltiesSurcharge').value) + NumWithComma(d.getElementById('frm2550ds:addPenaltiesInterest').value));
         d.getElementById('frm2550ds:totalAmountPayable').value = formatCurrency(NumWithComma(d.getElementById('frm2550ds:vatStillPayable').value) + NumWithComma(d.getElementById('frm2550ds:addPenaltiesTotal').value));
    }

   
