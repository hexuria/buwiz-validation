    <style>
        #loader,
        #text {
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            position: fixed;
            background: #FFF;
            z-index: 5000;
        }

        #text {
            background: none;
            top: 50%;
            left: 50%;
            right: 68%;
            left: 32%;
            width: 440px;
            overflow: hidden;
        }
    </style>

    <style>
        .atcNames {
            font-weight: bold;
        }

        tr.atc td {
            border-bottom: 1px #e1e1e1 solid;
        }

