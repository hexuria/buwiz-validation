    function validate() {
        var d = document;
        var rtnPeriodItem4 = d.getElementById('frm2550ds:RtnPeriodToNo4').value; // Return period (MM/DD/YYYY)
        var yearEnded = parseInt(d.getElementById('frm2550ds:txtYearNo2').value, 10); // Year ended
       
       


        //ITEM 23
        var numero23 = d.getElementById('frm2550ds:vatStillPayable').value;
        if(numero23 < 0){
            alert("Excess payment shall be carried over for the next quarter/period.");   
        }

        // Split the return period into year, month, and day
        var rtnPeriodParts = rtnPeriodItem4.split("/");
        var rtnPeriodYear = parseInt(rtnPeriodParts[2], 10);
        var rtnPeriodMonth = parseInt(rtnPeriodParts[0], 10);
        var rtnPeriodDay = parseInt(rtnPeriodParts[1], 10);

        // Get today's date for comparison
        var today = new Date();
        var currentYear = today.getFullYear();
        var currentMonth = today.getMonth() + 1; // JS months are 0-based (0 = Jan, 11 = Dec)
        var currentDay = today.getDate();

        // Convert return period and current date to JavaScript Date objects
        var returnPeriodDate = new Date(rtnPeriodYear, rtnPeriodMonth - 1, rtnPeriodDay);
        var currentDate = new Date(currentYear, currentMonth - 1, currentDay);

        // ITEM 3 Validation (Year type selection)
        if (!d.getElementById('frm2550ds:paymentValueAddedTax').checked &&
            !d.getElementById('frm2550ds:paymentAdvanceDeposit').checked) {
            alert("Please choose  either Payment of Value Added Tax Due or Advance Payment/Deposit on Item 1.");
            return;
        }

        // ITEM 3 Validation (Year type selection)
        if (!d.getElementById('frm2550ds:calendarNo1').checked &&
            !d.getElementById('frm2550ds:fiscalNo1').checked) {
            alert("Please choose  either Calendar or Fiscal on Item 3.");
            return;
        }

        // ITEM 5 Validation (Quarter selection)
        if (!d.getElementById('frm2550ds:OptQuarter1').checked &&
            !d.getElementById('frm2550ds:OptQuarter2').checked &&
            !d.getElementById('frm2550ds:OptQuarter3').checked &&
            !d.getElementById('frm2550ds:OptQuarter4').checked) {
            alert("Item 5 is a required field.");
            return;
        }

        // ITEM 4 Validation: Prevent advance filing but allow valid return periods
        if (returnPeriodDate > currentDate) {
            // Exception: Allow 4th Quarter 2024 (Nov 2024 - Jan 2025) for year-ended 2025
            if (yearEnded === 2025 && ((rtnPeriodMonth === 11 && rtnPeriodYear === 2024) ||
                (rtnPeriodMonth === 12 && rtnPeriodYear === 2024) ||
                (rtnPeriodMonth === 1 && rtnPeriodYear === 2025))) {
                // Allowed filing
            } else {
                alert("Should not accept advance filing.");
                return;
            }
        }

        // ITEM 7
        if (d.getElementById('frm2550ds:txtTIN1').value == "" || d.getElementById('frm2550ds:txtTIN2').value == "" || d.getElementById('frm2550ds:txtTIN3').value == "" || d.getElementById('frm2550ds:branchCode').value == "") {
            alert("Please enter a valid TIN number on Item 8.");
            return;
        }
      
        // ITEM 10 and 13
        if ((d.getElementById('frm2550ds:taxpayerName').value == "")) {
            alert("Please enter a valid Taxpayer Name on Item 10.");
            return;
        }
        // ITEM 11
        if ((d.getElementById('frm2550ds:address').value == "")) {
            alert("Please enter a valid Taxpayer's Registered Address on Item 11.");
            return;
        }
       
      
        // ITEM 15
        /*
        if (d.getElementById('frm2550ds:telephoneNum').value == "") {
            alert("Please enter a valid Taxpayer's Contact Number on Item 15.");
            return;
        }
        */

       // ITEM 16
        if (d.getElementById('frm2550ds:emailAddress').value == "") {
            alert("Please enter a valid Taxpayer's Email Address on Item 12.");
            return;
        }


          // ITEM 22D
        if (d.getElementById('frm2550ds:otherPaymentCreditAmount').value > 0) {
             if (d.getElementById('frm2550ds:otherPaymentCreditSpecify').value.length ==0) {
                    alert("Please enter a valid Other Payment/Credit description on Item 22D.");
                    return;
             }         
        }


       // ITEM 27
        if (!d.getElementById('frm2550ds:agree').checked) {
            alert("Please choose Agree on Item 27.");
            return;
        }

        //mrprgrmr

        if(d.getElementById('frm2550ds:otherPaymentCreditSpecify').value.length > 0){

            if(d.getElementById('frm2550ds:otherPaymentCreditAmount').value == 0){
                alert("Please enter amount on item 22D.");
                return;
            }
        }

        if(d.getElementById('frm2550ds:RtnPeriodFromNo4').value == ""){

            alert("Please enter date on item 6 Return Period.");
            return;
        }

        if(d.getElementById('frm2550ds:RtnPeriodToNo4').value == ""){

            alert("Please enter date on item 6 Return Period.");
            return;
        }

        if(d.getElementById('frm2550ds:selectedMonthNo2').value == ""){
            alert("Please enter date on item 4 Year Ended.");
            return;
        }
        


        




        AllControlDisabled(true);

        alert("Validation successful. Click on Edit if you wish to modify your entries.");
        return;
    }

