    function validateAmendedReturn() {
        if (d.getElementById('frm2550ds:amendedReturnYesNo5').checked == false) {
            
            d.getElementById('frm2550ds:vatPaidInReturn').value = "0.00";
            d.getElementById('frm2550ds:vatPaidInReturn').disabled = true;

        } else  {           
           d.getElementById('frm2550ds:vatPaidInReturn').disabled = false;

        }
    }

    function RtnPeriodFromNo4(elem) {
        var month = d.getElementById('frm2550ds:selectedMonthNo2');

        if (elem.id == "frm2550ds:calendarNo1") {
            month.value = "12";
            month.disabled = true;
            d.getElementById('frm2550ds:RtnPeriodFromNo4').disabled = true;
            d.getElementById('frm2550ds:RtnPeriodToNo4').disabled = true;
        } else {
            month.value = "0";
            month.disabled = false;
        }
    }

    function validateReturnPeriodFormat(retVal){

        var retPer = retVal.value;

        var mm = retPer.substring(0, 2);
        var d1 = retPer.substring(3, 2);
        var dd = retPer.substring(3, 5);
        var d2 = retPer.substring(6, 5);
        var yyyy = retPer.substring(6, 10);

        var dt = new Date();

        if(isNaN(new Date(yyyy + d1 + mm + d2 + dd))){
            alert("Invalid date format! Please follow MM/DD/YYYY");    

            retVal.value = "";
            return;
        }

        if(mm.length < 2 || dd.length < 2){
            alert("Invalid date format! Please follow MM/DD/YYYY"); 
            retVal.value = "";
            return;
        }

        if(Number(mm) > 12 || Number(dd) > 31){
            alert("Invalid date format! Please follow MM/DD/YYYY"); 
            retVal.value = "";

            return;
        }

        

        if(!d1==="/" || !d2 === "/"){
            alert("Invalid date format! Please follow MM/DD/YYYY"); 
            retVal.value = "";
            return;
        }

        if(yyyy.length < 4){
            alert("Invalid date format! Please follow MM/DD/YYYY"); 
            retVal.value = "";
            return;
        }

        if(Number(yyyy) > 2100){
            alert("Invalid date format! Please follow MM/DD/YYYY"); 
            retVal.value = "";

            return;
        }

        
    }

