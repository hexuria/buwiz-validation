    // NEW VARIABLES - ================================
    var specify22DToCommit = new Array();

    function NewSpecifyNo22D() {
        this.txtSpecifyNo22DDescription = '';
        this.txtSpecifyNo22DAmount = '0.00';
    }


    function addTblSpecifyNo22D() {
        d.getElementById('mainContent').style.display = "none";
        var rowCount = d.getElementById('tblSpecifyNo22D').rows.length
        showModalNo22D();
    }

   // SHOW MODAL NUMBER 22D
    function showModalNo22D() {
        d.getElementById('mainContent').style.display = 'none';
    
        
        // Clear existing table content
        $('#tbodyNo22D').html("");
        
        // Initialize array if it doesn't exist
        if (!specify22DToCommit) {
            specify22DToCommit = [];
        }
        
        // If array is empty, add one empty row
        if (specify22DToCommit.length === 0) {
            specify22DToCommit[0] = new NewSpecifyNo22D();
            specify22DToCommit[0].txtSpecifyNo22DDescription = "";
            specify22DToCommit[0].txtSpecifyNo22DAmount = "0.00";
        }
        if(document.getElementById('frm2550ds:otherPaymentCreditSpecify').value != "" && document.getElementById('frm2550ds:otherPaymentCreditAmount').value != "0.00" && document.getElementById('frm2550ds:otherPaymentCreditSpecify').value != "VARIOUS")
        {
        
                specify22DToCommit[0] = new NewSpecifyNo22D();
                specify22DToCommit[0].txtSpecifyNo22DDescription = document.getElementById('frm2550ds:otherPaymentCreditSpecify').value;
                specify22DToCommit[0].txtSpecifyNo22DAmount = document.getElementById('frm2550ds:otherPaymentCreditAmount').value;
        }
        // Populate table with data
        for(var i = 0; i < specify22DToCommit.length; i++) {
            $('#tbodyNo22D').append(
                "<tr>" +
                "<td width='25%' style='border: 1px solid black; padding: 2px'>22D-" + (i + 1) + "</td>" +
                "<td width='35%' style='border: 1px solid black; padding: 2px font-size: 20px'> <input type='text' id='frm2550ds:totalTaxPayableNo22DDescription" + i + "' style='width: 300px;' value='" + specify22DToCommit[i].txtSpecifyNo22DDescription + "' maxlength='50'> </td>" +
                "<td width='30%' style='border: 1px solid black; padding: 2px font-size: 20px'> <input type='text' id='frm2550ds:totalTaxPayableNo22DAmount" + i + "' style='width: 150px; text-align: right;' value='" + specify22DToCommit[i].txtSpecifyNo22DAmount + "' onblur='round(this,2); computeOtherCreditsNo22D();' maxlength='25'> </td>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px;'> <button id='deleteId1" + i + "' onclick='deleteRowNo22D(" + i + ")' style='padding: 2px'>Remove</button> </td>" +
                "</tr>"
            );
        }
        $('#modalNo22D').show('blind');
        

       computeOtherCreditsNo22D();
    }


      // COMPUTE NUMBER 19
    // Function to compute and update fields
    function computeOtherCreditsNo22D() {
        var inputField = d.getElementById('frm2550ds:otherPaymentCreditAmount');
        var resultField = d.getElementById('resultOtherCreditsNo22D');

        // Update resultField immediately with inputField value
        resultField.value = inputField.value;

        // Call calculation logic to handle additional items if needed
        var size = specify22DToCommit.length;
        var otherCredits = 0;

        if (size === 0) {
            inputField.value = "0.00";
            resultField.value = "0.00";
        } else {
            for (var i = 0; i < size; i++) {
                otherCredits += NumWithComma(d.getElementById('frm2550ds:totalTaxPayableNo22DAmount' + i).value);
            }
            var formattedOtherCredits = formatCurrency(otherCredits);
            inputField.value = formattedOtherCredits;
            resultField.value = formattedOtherCredits;
            
        }
        compute22E();
    }

 

