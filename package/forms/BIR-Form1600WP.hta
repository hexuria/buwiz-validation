	function getRdo()
    {
        var data = "<select class='iceSelOneMnu' id='frm1600WP:txtRDOCode' name='frm1600WP:txtRDOCode' size='1' ><option value='000'> </option>";
		
		for(var i = 0; i < rdoList.length; i++) {
            var rdo = rdoList[i];
            data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";
			
        }
		data = data + "</select>"
		
		$('#rdoSelect').html(data);		
		
    }
	
