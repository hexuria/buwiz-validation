					$_Id("frm1702MX:txtPg2" + attachNum + "ScF1I7year").value ='';
					$_Id("frm1702MX:txtPg4IShed8_7Year").value = '';}
		}
	
		//to compute Schedule F Item 2 to Main
		computeToMainScF('ScII2','AttM');
		
		//to Compute for Schedule F Item 3
		//computePg2mAttachScDI18(attachNum);
		computePg1AttachScBI11(attachNum);
    }
	
