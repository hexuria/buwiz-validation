		product2('txtPg2Sc2Itm7C','.02','txtPg2Sc2It18C');
		computePg2Sc2It19C();
	}
	
	//Page 2 Schedule 2 Item 19C - based on Item 15C & 18C   
	function computePg2Sc2It19C() {
		var amt1 =  NumWithComma(d.getElementById("frm1702MX:txtPg2Sc2It15C").value);
		var amt2 =  NumWithComma(d.getElementById("frm1702MX:txtPg2Sc2It18C").value);
		if (amt1 > amt2){
				allFormat('txtPg2Sc2It15C', 'txtPg2Sc2It19C');
			}
		else if (amt1 <= amt2){
				allFormat('txtPg2Sc2It18C', 'txtPg2Sc2It19C');

			}

		}
	
