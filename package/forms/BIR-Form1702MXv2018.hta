	function computePg2mAttachScDI18(attachNum) {
        summation('txtPg1' + attachNum + 'ScDI1,txtPg1' + attachNum + 'ScDI2,txtPg1' + attachNum + 'ScDI3,txtPg1' + attachNum + 'ScDI4,txtPg1' + attachNum + 'ScDI5,txtPg1' + attachNum + 'ScDI6,txtPg1' + attachNum + 'ScDI7,txtPg1' + attachNum + 'ScDI8,txtPg2' + attachNum + 'ScDI9,txtPg2' + attachNum + 'ScDI10,txtPg2' + attachNum + 'ScDI11,txtPg2' + attachNum + 'ScDI12,txtPg2' + attachNum + 'ScDI13,txtPg2' + attachNum + 'ScDI14,txtPg2' + attachNum + 'ScDI15,txtPg2' + attachNum + 'ScDI16,txtPg2' + attachNum + 'ScDI17,txtPg2' + attachNum + 'ScDI18,txtPg2' + attachNum + 'ScDI19,txtPg2' + attachNum + 'ScDI20,txtPg2' + attachNum + 'ScDI21,txtPg2' + attachNum + 'ScDI22,txtPg2' + attachNum + 'ScDI23,txtPg2' + attachNum + 'ScDI24,txtPg2' + attachNum + 'ScDI25', 'txtPg4' + attachNum + 'ScGI40');
		summation('txtPg1' + attachNum + 'ScDI1,txtPg1' + attachNum + 'ScDI2,txtPg1' + attachNum + 'ScDI3,txtPg1' + attachNum + 'ScDI4,txtPg1' + attachNum + 'ScDI5,txtPg1' + attachNum + 'ScDI6,txtPg1' + attachNum + 'ScDI7,txtPg1' + attachNum + 'ScDI8,txtPg2' + attachNum + 'ScDI9,txtPg2' + attachNum + 'ScDI10,txtPg2' + attachNum + 'ScDI11,txtPg2' + attachNum + 'ScDI12,txtPg2' + attachNum + 'ScDI13,txtPg2' + attachNum + 'ScDI14,txtPg2' + attachNum + 'ScDI15,txtPg2' + attachNum + 'ScDI16,txtPg2' + attachNum + 'ScDI17,txtPg2' + attachNum + 'ScDI18,txtPg2' + attachNum + 'ScDI19,txtPg2' + attachNum + 'ScDI20,txtPg2' + attachNum + 'ScDI21,txtPg2' + attachNum + 'ScDI22,txtPg2' + attachNum + 'ScDI23,txtPg2' + attachNum + 'ScDI24,txtPg2' + attachNum + 'ScDI25', 'txtPg1' + attachNum + 'ScBI8');
		var item5 =removeCommaParenthesis($_Id("frm1702MX:txtPg1" + attachNum + "ScBI5").value);
		var item7 =  removeCommaParenthesis($_Id("frm1702MX:txtPg1" + attachNum + "ScBI57").value);
		var item8 = removeCommaParenthesis($_Id("frm1702MX:txtPg4" + attachNum + "ScGI40").value);
				
		if (d.getElementById("frm1702MX:rdoPg1"+attachNum+"SpecialRate").checked == true){
			if(item7 >= 0){
				if(item8>item7){
					item7A =(item7-item8)*-1;
					allFormat("txtPg1"+attachNum+"ScBI57", "txtPg2"+attachNum+"ScFI1");
					allFormat("txtPg4"+attachNum+"ScGI40", "txtPg2"+attachNum+"ScFI2");
					getDifference('txtPg2'+attachNum+'ScFI1','txtPg2'+attachNum+'ScFI2', 'txtPg2'+attachNum+'ScFI3');
					//getDifference('txtPg2'+attachNum+'ScFI1', 'txtPg2'+attachNum+'ScFI2', 'txtPg2'+attachNum+'ScF1I7A');
						
					$_Id("frm1702MX:txtPg2" + attachNum + "ScF1I7A").value = NegativeValue(formatCurrencyWOC( item7A));
					$_Id("frm1702MX:txtPg2" + attachNum + "ScF1I7E").value = NegativeValue(formatCurrencyWOC( item7A));
					//$_Id("frm1702MX:txtPg2" + attachNum + "ScF1I7A").value = $_Id("frm1702MX:txtPg2" + attachNum + "ScFI3").value *1;
					var filingYear = 2000 + ($_Id("frm1702MX:txtPg1I2YearEnd").value * 1);
					$_Id("frm1702MX:txtPg2" + attachNum + "ScF1I7year").value = filingYear;
					computeToMainScF1('ScF1I7A',attachNum);
					computeToMainScF1('ScF1I7E',attachNum);
					computeToMainScF('ScFI1',attachNum);
					computeToMainScF('ScFI2',attachNum);
					computeToMainScF('ScFI3',attachNum);

					}
				else{
					$_Id("frm1702MX:txtPg2" + attachNum + "ScFI1").value = 0;
					$_Id("frm1702MX:txtPg2" + attachNum + "ScFI2").value = 0;
					$_Id("frm1702MX:txtPg2" + attachNum + "ScFI3").value = 0;
					$_Id('frm1702MX:txtPg2' + attachNum +'ScF1I7A').value =0;
					$_Id("frm1702MX:txtPg2" + attachNum + "ScF1I7year").value ='';
					$_Id("frm1702MX:txtPg4IShed8_7Year").value = '';
					computeToMainScF('ScFI1',attachNum);
					computeToMainScF('ScFI2',attachNum);
					computeToMainScF('ScFI3',attachNum);

				}
			
					

		
			}else{
			$_Id("frm1702MX:txtPg2" + attachNum + "ScFI1").value = 0;
					$_Id("frm1702MX:txtPg2" + attachNum + "ScFI2").value = 0;
