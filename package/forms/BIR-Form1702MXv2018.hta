	function submitOnline(){
		if(confirm("You will now be redirected to eFPS Online.")){
			SubmitToEfps();
		}
	}

	//Added as of 03/29/2017
	function returnPeriod() {
        var yyyyR = '20' + getVal('txtPg1I2YearEnd');
        var mmR = getVal('ddlPg1I2Date');
        var ddR = new Date(yyyyR, mmR, 0).getDate();
        var returnPeriodFormat = yyyyR + "-" + (mmR) + "-" + ddR;
        return returnPeriodFormat;
    }
	
    function SubmitToEfps() {
        var formVersion = Form1702MX.version;
        var atc2SelectedIndex = $_Id('frm1702MX:drpPg1I5ATCR2').selectedIndex;
        var atc2SelectedOption = $_Id('frm1702MX:drpPg1I5ATCR2').options[atc2SelectedIndex].innerHTML.split(' - ');
        //var returnPeriod = '20' + getVal('txtPg1I2YearEnd') + '-' + getVal('ddlPg1I2Date') + '-31';
		//returnPeriod();

        populateTaxpayer(getVal('txtPg1Pt1I6TINC1') + getVal('txtPg1Pt1I6TINC2') + getVal('txtPg1Pt1I6TINC3'), getVal('txtPg1Pt1I6TINC4'), 'industryTypeCode', 'industryTypeMitCode', 'description',
                            'barangayAddress', 'districtAddress', getVal('txtPg1Pt1I8'), '2', getVal('txtPg1Pt1I8'),
                            '1994-01-28', getVal('txtZIP'), 'Male', getVal('txtPg1Pt1I6TINC1'), getVal('txtPg1Pt1I6TINC2'), getVal('txtPg1Pt1I6TINC3'), getVal('txtPg1Pt1I10RegisteredAddress'),
                            '2014/03/13', '2014/03/13', returnPeriod(), getVal('txtPg1Pt1I12Email'), '', 'ammendedYN', '1234',
                            $_Id('frm1702MX:rdoPg1I3AmendedYes').checked ? 'Y' : 'N', $_Id('frm1702MX:rdoPg1I4ShortPeriodYes').checked ? 'Y' : 'N', 'IC011', getVal('txtPg1Pt2NumberofPagesFiled'), getVal('txtPg1Pt1I11ContactNumber'),
                            getVal('txtPg1Pt1I13MainLine'), 'methodOfDeduction', getVal('txtPg1Pt1I13MainLine'), $_Id('frm1702MX:rdoPg1I1Calendar').checked ? 'C' : 'F', getVal('ddlPg1I2Date'),
                            getVal('txtPg1I2YearEnd'), getVal('txtPg1Pt1I7RDO'), 'registeredActivity', 'lastName', 'firstName', getVal('txtPg1Pt1I9RegisteredName'),
                            $_Id('frm1702MX:rdoPg1Pt2I22CTC').checked ? 'C' : 'S', 'IC 055', 'Minimum Corporate Income Tax (MCIT)', atc2SelectedOption[1], atc2SelectedOption[0], $_Id('frm1702MX:chkPg1I5ATCR1').checked, $_Id('frm1702MX:chkPg1I5ATCR2').checked, '01/01/2011',
                            '01/01/2016', 'subStreet', 'street', 'City', formVersion);

        populateTotalTaxPayable(getValAmount('txtPg1Pt2I14TotalIncome'), getValAmount('txtPg1Pt2I20TotalPenalties'), getValAmount('txtPg1Pt2I16NetTaxPayable'), getValAmount('txtPg1Pt2I15LessTotalTax'),
                                getVal('txtPg1Pt2I22'), getVal('txtPg1Pt2I23Date'), getVal('txtPg1Pt2I24PlaceofIssue'), getValAmount('txtPg1Pt2I25AmountCTC'),
                                $_Id('frm1702MX:rdoPg1Pt2I21Refund').checked ? 'R' : ($_Id('frm1702MX:rdoPg1Pt2I21IssueTCC').checked ? 'T' : ($_Id('frm1702MX:rdoPg1Pt2I21CarriedOver').checked ? 'C' : '')), getValAmount('txtPg1Pt2I21TotalAmount'), $_Id('frm1702MX:rdoPg1Pt2I22CTC').checked ? 'C' : 'S');

        populateTaxPayerActivityForTaxReliefsExempt(getVal('txtPg2Pt4I31CA'), getVal('txtPg2Pt4I32CA'),
                                                    getVal('txtPg2Pt4I33CA'), '',
                                                    '',
                                                    getVal('txtPg2Pt4I35CA'), getVal('txtPg2Pt4I36CA'));

        populateTaxPayerActivityForTaxReliefsSpecial(getVal('txtPg2Pt4I31CB'), getVal('txtPg2Pt4I32CB'),
                                                    getVal('txtPg2Pt4I33CB'), getValAmount('txtPg2Pt4I34SpecialTaxRate'),
                                                    getVal('txtPg2Pt4I35CB'), getVal('txtPg2Pt4I36CB'));

        populateTaxPayerActivityForTaxReliefsSpecialTaxRelief(getVal('txtPg2Pt4I31CC'), getVal('txtPg2Pt4I32CC'),
                                                            getVal('txtPg2Pt4I33CC'),
                                                            getVal('txtPg2Pt4I35CC'), getVal('txtPg2Pt4I36CC'));

        populateComputationOfAmountPayablePerTaxRegime( getValAmount('txtPg2Pt5I37CB'),
                                                       getValAmount('txtPg2Pt5I39CC'),
                                                       getValAmount('txtPg1Pt2I17'), getValAmount('txtPg1Pt2I18'), getValAmount('txtPg1Pt2I19'),
                                                       getValAmount('txtPg2Pt5I43'), getValAmount('txtPg2Pt5I44'));

        populateExternalAuditorAccreditedTaxAgent(getVal('txtPg2Pt6I45External'), getVal('txtPg2Pt6I46TIN1') + getVal('txtPg2Pt6I46TIN2') + getVal('txtPg2Pt6I46TIN3') + getVal('txtPg2Pt6I46TIN4'),
                                                  getVal('txtPg2Pt6I47Partner'), getVal('txtPg2Pt6I48TIN1') + getVal('txtPg2Pt6I48TIN2') + getVal('txtPg2Pt6I48TIN3') + getVal('txtPg2Pt6I48TIN4'),
                                                  getVal('txtPg2Pt6I49BIRAccreditation'), getVal('txtPg2Pt6I50IssueDate'), getVal('txtPg2Pt6I51ExpiryDate'),
                                                  getVal('txtPg2Pt6I46TIN4'), getVal('txtPg2Pt6I48TIN4'));



        populateSalesRevenueExempt(getValAmount('txtPg4Sc3I1CA'), getValAmount('txtPg4Sc3I2CA'), getValAmount('txtPg4Sc3I3CA'),
                                   getValAmount('txtPg4Sc3I4CA'), getValAmount('txtPg4Sc3I5CA'), getValAmount('txtPg4Sc3I6CA'));

        populateSalesRevenueSpecial(getValAmount('txtPg4Sc3I1CB'), getValAmount('txtPg4Sc3I2CB'), getValAmount('txtPg4Sc3I3CB'),
                                    getValAmount('txtPg4Sc3I4CB'), getValAmount('txtPg4Sc3I5CB'), getValAmount('txtPg4Sc3I6CB'));

        populateSalesRevenueRegular(getValAmount('txtPg4Sc3I1CC'), getValAmount('txtPg4Sc3I2CC'), getValAmount('txtPg4Sc3I3CC'),
                                    getValAmount('txtPg4Sc3I4CC'), getValAmount('txtPg4Sc3I5CC'), getValAmount('txtPg4Sc3I6CC'));

        populateSalesRevenueTotal(getValAmount('txtPg4Sc3I1CD'), getValAmount('txtPg4Sc3I2CD'), getValAmount('txtPg4Sc3I3CD'),
                                  getValAmount('txtPg4Sc3I4CD'), getValAmount('txtPg4Sc3I5CD'), getValAmount('txtPg4Sc3I6CD'));

        // Schedule 3A - 3C START
        populateCostOfSalesExempt();

        populateCostOfSalesSpecial();

        populateCostOfSalesRegular(getValAmount('txtPg4Sc3AI1CC'), getValAmount('txtPg4Sc3AI2CC'), getValAmount('txtPg4Sc3AI3CC'), getValAmount('txtPg4Sc3AI4CC'),
