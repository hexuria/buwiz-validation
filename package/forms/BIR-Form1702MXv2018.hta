                                                  (getValAmount('txtCtrmodalPg6Sc6') > 1) ? '' : getVal('txtPg3Sc6I4legal'),
                                                  (getValAmount('txtCtrmodalPg6Sc6') > 1) ? 0 : getValAmount('txtPg3Sc6I4CA'),
                                                  (getValAmount('txtCtrmodalPg6Sc6') > 1) ? 0 : getValAmount('txtPg3Sc6I4CB'),
                                                  (getValAmount('txtCtrmodalPg6Sc6') > 1) ? 0 : getValAmount('txtPg3Sc6I4CC'));

        //Page 6 Schedule 6
        var TablePg6Sc6 = document.getElementById("modalTablePg3Sc6");

        if (getValAmount('txtCtrmodalPg6Sc6') > 1) {
            for (x = 0; x < getValAmount('txtCtrmodalPg6Sc6') ; x++) {

                populateOtherSpecialDeduction(TablePg6Sc6.rows[x].cells[0].children[1].value,
