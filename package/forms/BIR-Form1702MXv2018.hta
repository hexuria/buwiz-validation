	function validateTaxtRelief(){
			isValid = true;
			
			
			if( (NumWithComma(d.getElementById('frm1702MX:txtPg2Sc4Itm2A').value) === 0) && (NumWithComma(d.getElementById('frm1702MX:txtPg2Sc2Itm9A').value) > 0) ){
				 isValid = false;
				  alert("Please provide value on Page 3 Schedule 4 Item 2A.") ;
			}
			else if((NumWithComma(d.getElementById('frm1702MX:txtPg2Sc4Itm2B').value) === 0) && (NumWithComma(d.getElementById('frm1702MX:txtPg2Sc2Itm9B').value) > 0 )){
				 isValid = false;
				alert("Please provide value on Page 3 Schedule 4 Item 2B.") ; 
			}
			else if( (NumWithComma(d.getElementById('frm1702MX:txtPg2Sc4Itm2C').value) === 0) && (NumWithComma(d.getElementById('frm1702MX:txtPg2Sc2Itm9C').value) > 0)){
				 isValid = false;
					alert("Please provide value on Page 3 Schedule 4 Item 2C.") ; 
			}
			return isValid;
	}


    function validate(){
	     // Call initialValidateBeforeSave() function to ensure that data saved in profile.xml is not empty
		 if(validateBasistTaxtRelief() === false){
			changeCurrentPage(2);
            return ;
		 }

		 if(validateTaxtRelief() === false){
			changeCurrentPage(3);
            return ;
		 
		 }
		 
        if (initialValidateBeforeSave() === false) {
            changeCurrentPage(1);
            return;
        }
		
		if (validateAttachments() === false) {
	
            return;
        }
		
	
        // Calendar or Fiscal
        if ($_Id('frm1702MX:rdoPg1I1Calendar').checked === false && $_Id('frm1702MX:rdoPg1I1Fiscal').checked === false) {
            alert("Please select if filing for Calendar or Fiscal Year (Page 1 Item 1).");
            changeCurrentPage(1);
            return;
        }
        // Validate Filing Year
        if (($_Id("frm1702MX:ddlPg1I2Date").value === "") || ($_Id("frm1702MX:txtPg1I2YearEnd").value === "")) {
            alert("Please select Month and Year for Year Ended (Page 1 Item 2).");
            changeCurrentPage(1);
            return;
        }
        if (validateYearEnd() === false) {
            changeCurrentPage(1);
            return;
        }
        // Validate that at least one ATC is ticked
