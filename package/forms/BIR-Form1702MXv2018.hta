 	function page4Sched7Item7GetValue(){

			var total = Math.abs(WholeNumWithComma(NumWithParenthesis(d.getElementById("frm1702MX:txtPg6Sc7I3").value)));
			var filingYear = 2000 + ($_Id("frm1702MX:txtPg1I2YearEnd").value * 1);
			d.getElementById("frm1702MX:txtPg3IShed7_7Year").value = filingYear;
			d.getElementById("frm1702MX:txtPg3IShed7_7A").value = NegativeValue(formatCurrencyWOC( total));
			d.getElementById("frm1702MX:txtPg3IShed7_7E").value = NegativeValue(formatCurrencyWOC( total));
			d.getElementById("frm1702MX:txtPg3IShed7_7Year").disabled= true;
			d.getElementById("frm1702MX:txtPg3IShed7_7A").disabled= true;
			d.getElementById("frm1702MX:txtPg3IShed7_7B").disabled= true;
			d.getElementById("frm1702MX:txtPg3IShed7_7C").disabled= true;
			d.getElementById("frm1702MX:txtPg3IShed7_7D").disabled= true;
			d.getElementById("frm1702MX:txtPg3IShed7_7E").disabled= true;
			computeP4Sc7AI7E(d.getElementById("frm1702MX:txtPg3IShed7_7E"));	
			
		
	}	
		
 
	//Page 4 Schedule 8 Computation of Net Operating Loss Carry Over (NOLCO) for Special Rate
	function computePg4Sc8It3() {
		computeNolco('B');
		if (getValAmount('txtPg2Sc2Itm7B') < getValAmount('txtPg2Sc2Itm8B') ){
			computetxtPg4IShed8_7A();
		}
		else if(getValAmount('txtPg2Sc2Itm7B') >= getValAmount('txtPg2Sc2Itm8B')){
			page4Sch8item3IsNegative();

		}
	
    }
	
