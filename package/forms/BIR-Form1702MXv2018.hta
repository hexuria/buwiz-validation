    function checkNullRow_OnClick_modalTablePg3Sc5I17i() {
        params = 'txtPg3Sc5It17i,txtPg3Sc5Itm17iA,txtPg3Sc5Itm17iB,txtPg3Sc5Itm17iC';
        buttonModalID = 'btnModalPg3Sc5I17i';
        var str = "";
        var str2 = 0;
        var array = params.split(',');
       
		if (main_modalTablePg3Sc5I17i_Col1.length > 1) {
            openDialog('modalDivPg3Sc5I17i');
			
            Load_modalTablePg3Sc5I17i();
        }
        else if (main_modalTablePg3Sc5I17i_Col1.length <= 1) {
            str = document.getElementById('frm1702MX:' + array[0]).value;
            str2 = document.getElementById('frm1702MX:txtPg3Sc5Itm17iD').value;
			
