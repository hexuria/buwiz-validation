    // ========================= GENERAL FUNCTIONS START =========================
    function addCommas1702MX(elem) {
        elem.value = NegativeValue(formatCurrencyWOC(NumWithComma(NumWithParenthesis(elem.value))));//(NumWithComma(NumWithParenthesis(elem.value)) + "").replace(/(\d)(?=(\d{3})+$)/g, '$1,');
    }

    function getSum(params, output) {
        var total = 0;
        var array1 = params.split(',');
        var array2 = output.split(',');
        for (var i = 0; i < array1.length; i++) {
            total += (isNaN(NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array1[i]).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array1[i]).value)));
        }

        for (var i = 0; i < array2.length; i++) {
            $_Id('frm1702MX:' + array2[i]).value = NegativeValue(formatCurrencyWOC(total));
        }

        return total;
    }

    function getDifference(minuend, subtrahend, output) {
        var total = 0, total2 = 0;
        var min = minuend.split(',');
        var sub = subtrahend.split(',');
        for (var i = 0; i < min.length; i++) {
            total += (isNaN(NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + min[i]).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + min[i]).value)));
        }
        for (var i = 0; i < sub.length; i++) {
            total2 += (isNaN(NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + sub[i]).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + sub[i]).value)));
        }

        $_Id('frm1702MX:' + output).value = NegativeValue(formatCurrencyWOC(total - total2));

        return total;
    }

    //summation
    //params collection of textBox Name seperate by comma
    //outputSum is name of textbox where the sum will be populated
    function summation(params, outputSum) {
        var total = 0;
        var array = params.split(',');
        for (var i = 0; i < array.length; i++) {
            total += (isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + array[i]).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array[i]).value)));
        }

        document.getElementById('frm1702MX:' + outputSum).value = NegativeValue(formatCurrencyWOC(total));
    }

    //summation then subtract, with two output fields
    //params collection of textBox Name seperate by comma
    //subtrahend is where the sum will be deducted
    //outputSum is name of textbox where the sum will be populated
    //outputDifference is name of textbox where the difference will be populated
    function summationThenDifference(params, subtrahend, outputSum, outputDifference) {
        var total = 0;
        var difference = 0;

        // if (parseInt(document.getElementById('frm1702MX:' + subtrahend).value, 10) === 0) 
        var array = params.split(',');
        for (var i = 0; i < array.length; i++) {
            total += (isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + array[i]).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array[i]).value)));
        }

        //Get the output of summation
        document.getElementById('frm1702MX:' + outputSum).value = NegativeValue(formatCurrencyWOC(total));
        //Get the output difference
        difference = total
					 - (isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + subtrahend).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + subtrahend).value)));
        document.getElementById('frm1702MX:' + outputDifference).value = NegativeValue(formatCurrencyWOC(difference));
    }

    //summation then subtract, with two output fields
    //params collection of textBox Name seperate by comma
    //minued is where the sum will be deducted
    //outputSum is name of textbox where the sum will be populated
    //outputDifference is name of textbox where the difference will be populated
    function summationThenDifferenceM(params, minuend, outputSum, outputDifference) {
        var total = 0;
        var difference = 0;

        // if (parseInt(document.getElementById('frm1702MX:' + subtrahend).value, 10) === 0) 
        var array = params.split(',');
        for (var i = 0; i < array.length; i++) {
            total += (isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + array[i]).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array[i]).value)));
        }

        //Get the output of summation
        document.getElementById('frm1702MX:' + outputSum).value = NegativeValue(formatCurrencyWOC(total).slice(0, -3));
        //Get the output difference
        difference = (isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + minuend).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + minuend).value)))
					 - total;

        document.getElementById('frm1702MX:' + outputDifference).value = NegativeValue(formatCurrencyWOC(difference));

    }

    //Multiplication one output two parameter
    function product(param1, param2, outputProduct) {
        var product = 0;
        //multiply
        product = (isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + param1).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + param1).value)))
				  * (isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + param2).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + param2).value)));
        //Get the output product

        if (product < 0) {
            product = 0;
        }

        document.getElementById('frm1702MX:' + outputProduct).value = NegativeValue(formatCurrencyWOC(Math.round(product)));
    }
	
    function product1(param1, param2, outputProduct) {
        var product = 0;
        //multiply
        product = (isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + param1).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + param1).value)))
				  * (((isNaN(NumWithComma(NumWithParenthesis(document.getElementById('frm1702MX:' + param2).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + param2).value))))/100);
        //Get the output product

        if (product < 0) {
            product = 0;
        }

        document.getElementById('frm1702MX:' + outputProduct).value = NegativeValue(formatCurrencyWOC(Math.round(product)));
    }
	
	function product2(param1, param2, outputProduct) {
        
        //multiply
           var  product = (isNaN(NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + param1).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + param1).value))) * NumWithComma(NumWithParenthesis(param2));
   
        //Get the output product

        if (product < 0) {
            product = 0;
        }
		$_Id('frm1702MX:' + outputProduct).value = NegativeValue(formatCurrency(Math.round(product)).slice(0, -3));
    //    document.getElementById('frm1702MX:' + outputProduct).value = NegativeValue(formatCurrencyWOC(Math.round(product)));
    }
	
	  function allFormat(param, output) {
        $_Id('frm1702MX:' + output).value = NegativeValue(formatCurrency(NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + param).value))).slice(0, -3));
    }
    // ========================== GENERAL FUNCTIONS END ==========================

    //Attachments Page 1m to 4m
    //Begin===================================================================================================================
    //Schedule B ===========================================Begin||

	function initialAmount(amountCall,attachNum) {
		if (amountCall == "forPt5SchBI3"){
			getDifference('txtPg1'+attachNum+'ScBI1', 'txtPg1'+attachNum+'ScBI2', 'txtPg1'+attachNum+'ScBI3');
		}
		
		getDifference('txtPg1'+attachNum+'ScBI3', 'txtPg1'+attachNum+'ScBI4', 'txtPg1'+attachNum+'ScBI5');
		
		summation('txtPg1' + attachNum + 'ScBI5,txtPg1' + attachNum + 'ScBI56', 'txtPg1' + attachNum + 'ScBI57');
		
		//From Schedule B Item 7 to Schedule F Item 3
		if (d.getElementById("frm1702MX:rdoPg1"+attachNum+"SpecialRate").checked === true){
			var item7 =  removeCommaParenthesis($_Id("frm1702MX:txtPg1" + attachNum + "ScBI57").value);
			if( item7 < 0){
				summation('txtPg1' + attachNum + 'ScBI5,txtPg1' + attachNum + 'ScBI56', 'txtPg2' + attachNum + 'ScFI1');
				
			}
			else if(item7 >= 0){
				$_Id("frm1702MX:txtPg2" + attachNum + "ScFI1").value = 0;
				$_Id("frm1702MX:txtPg2" + attachNum + "ScFI2").value = 0;
				$_Id("frm1702MX:txtPg2" + attachNum + "ScFI3").value = 0;
				d.getElementById('frm1702MX:txtPg2'+attachNum+'ScF1I7A').value =0;
				d.getElementById('frm1702MX:txtPg2'+attachNum+'ScF1I7year').value ="";
				d.getElementById('frm1702MX:txtPg2'+attachNum+'ScF1I7E').value =0;
				
				
			}
		
		}
		//to compute Schedule F Item 1 to Main
		computeToMain('ScBI10',attachNum);
		computeToMain('ScBI11',attachNum);
		computeToMainScF('ScII1','AttM');
		computeToMainScF1('ScF1I7E','AttM');
		//computeToMainScF1('ScF1I8D','AttM');
		computeToMainScF1('ScF1I7A','AttM');
		getDifference('txtPg1'+attachNum+'ScBI57', 'txtPg1'+attachNum+'ScBI11', 'txtPg1'+attachNum+'ScBI12');
		//to Compute for Schedule F Item 3
		
		computePg2mAttachScDI18(attachNum);
		computePg1AttachScBI12(attachNum);
		computePg1AttachScCItm1(attachNum);
		computePg1AttachScBI14(attachNum);

	}
	
   function computePg1AttachScBI3(attachNum) {
		summation('txtPg1' + attachNum + 'ScBI1,txtPg1' + attachNum + 'ScBI2', 'txtPg1' + attachNum + 'ScBI3');
		computePg1AttachScBI5(attachNum);
		computePg1AttachScBI7(attachNum);
		computePg1AttachScBI12(attachNum);
		computePg1AttachScCItm1(attachNum);
		computePg1AttachScBI14(attachNum);
	}
	
    function computePg1AttachScBI5(attachNum) {
        //Schedule B
        //perfrom difference in Item 3 and 4
        //populate sum in item 5
        summationThenDifference('txtPg1' + attachNum + 'ScBI3', 'txtPg1' + attachNum + 'ScBI4', 'hidden', 'txtPg1' + attachNum + 'ScBI5');
		//perform computePg1AttachScBI7(attachNum) function
		computePg1AttachScBI7(attachNum);
		computePg1AttachScBI12(attachNum);
		computePg1AttachScCItm1(attachNum);
		computePg1AttachScBI14(attachNum);
		computePg1AttachScCItm4(attachNum);
		computePg2mAttachScDI18(attachNum);
    }
	
    function computePg1AttachScBI7(attachNum) {
        //Schedule B
        //perfrom addition in Item 5 and 6
        //populate sum in item 7
        summation('txtPg1' + attachNum + 'ScBI5,txtPg1' + attachNum + 'ScBI56', 'txtPg1' + attachNum + 'ScBI57');
        //perfrom computePg1AttachScBI10(attachNum) function
        computePg1AttachScBI10(attachNum);

        //perform computePg1AttachScBI12(attachNum)function
        computePg1AttachScBI12(attachNum);
		computePg1AttachScCItm1(attachNum);
		computePg1AttachScBI14(attachNum);
		
    }

	
	/*function computePg1AttachScBI7(attachNum) {
		getSum('txtPg1' + attachNum + 'ScBI5,txtPg1' + attachNum + 'ScBI6', 'txtPg1' + attachNum + 'ScBI7');
		computePg1AttachScBI11(attachNum);
	}*/
	
    function computePg1AttachScBI11(attachNum) {
        //Schedule B
        //perfrom summation in item 8 9 10
        //populate sum in item 11
        summation('txtPg1' + attachNum + 'ScBI8,txtPg1' + attachNum + 'ScBI9,txtPg1' + attachNum + 'ScBI10', 'txtPg1' + attachNum + 'ScBI11');
        //perform computePg1AttachScBI14(attachNum) function
        //computePg1AttachScBI14(attachNum);
		computePg1AttachScBI12(attachNum);
    }
	
	function computePg1AttachScBI12(attachNum) {
		getDifference('txtPg1'+attachNum+'ScBI57', 'txtPg1'+attachNum+'ScBI11', 'txtPg1'+attachNum+'ScBI12');
	computePg1AttachScBI14(attachNum);
	}
	
	function computePg1AttachScBI14(attachNum) {
		
        var attachType = $_Id("attachTypeView").value;

        if (attachType === "EX") {
			product1('txtPg1' + attachNum + 'ScBI12', 'txtPg1' + attachNum + 'ScBI13', 'txtPg1' + attachNum + 'ScBI14');
        }
		
        else if (attachType === "SP") {
			var taxRate = $_Id("frm1702MX:txtPg1"+  attachNum + "ScBI13").value;
			
			var amount1sp = NumWithComma($_Id("frm1702MX:txtPg1" + attachNum + "ScBI3").value).toFixed(0) * 1;
			var amount2sp = NumWithComma($_Id("frm1702MX:txtPg1" + attachNum + "ScBI57").value).toFixed(0) * 1;
			
			
			if (taxRate == 10.0 ){
				product1('txtPg1' + attachNum + 'ScBI12', 'txtPg1' + attachNum + 'ScBI13', 'txtPg1' + attachNum + 'ScBI14');
				}
			else if (taxRate ==  5.0 ){
				product1('txtPg1' + attachNum + 'ScBI57', 'txtPg1' + attachNum + 'ScBI13', 'txtPg1' + attachNum + 'ScBI14');
				}
			else if (taxRate ==2.0 || amount1sp >= amount2sp){
				product1('txtPg1' + attachNum + 'ScBI1', 'txtPg1' + attachNum + 'ScBI13', 'txtPg1' + attachNum + 'ScBI14');
			}else {
				product1('txtPg1' + attachNum + 'ScBI57', 'txtPg1' + attachNum + 'ScBI13', 'txtPg1' + attachNum + 'ScBI14');
			}
				//d.getElementById("frm1702MX:txtPg1" + attachNum + "ScCItm4").value = d.getElementById("frm1702MX:txtPg1" + attachNum + "ScCI14").value
				//}
        }
		computePg1AttachScCItm4(attachNum);
		computeToMainI14(attachNum);
    }
//owaj computeToMainI14
	function computeToMainI14(attachNum) {
		var currTaxReg = attachNum.substring(0,2);
		var countTaxReg = attachNum.substring(2,3);
		if (currTaxReg == 'SP') {
			var totalAmt = 0;
			var currAmt = 0;
			currAmt = NumWithComma($_Id("frm1702MX:txtPg1"+attachNum+"ScBI14").value).toFixed(0) * 1;
			arrSpclSchBI14.splice(countTaxReg-1, 1, currAmt);
	
			for(var x = 0; x < arrSpclSchBI14.length; x++){
				totalAmt = totalAmt + arrSpclSchBI14[x];
			}
	
			$_Id("frm1702MX:txtPg2Sc2It15B").value = NegativeValue(formatCurrencyWOC(totalAmt));
			$_Id("frm1702MX:txtPg2Sc4Itm4B").value =  NegativeValue(formatCurrencyWOC(totalAmt));
		}
		computePg2Sc2It17B();
		computePg3Sc4Itm5();
	}
//Compute for Schedule C - Tax Relief Availment

	//To compute for Schedule C Item 1 jawow
   function computePg1AttachScCItm1(attachNum) {
		if (attachNum.substring(0,2)=== 'SP'){
		//alert(attachNum.substring(0,2) );
		product1('txtPg1' + attachNum + 'ScBI12', 'txtPg1' + attachNum + 'ScBI13', 'txtPg1' + attachNum + 'ScCI1');
		}
		computePg1AttachScCItm3(attachNum);
	}
	
		//To compute for Schedule C Item 1 jawow
   function computePg1AttachScCItm2(attachNum) {
		if (attachNum.substring(0,2)=== 'SP'){
			product1('txtPg1' + attachNum + 'ScBI9', 'txtPg1' + attachNum + 'ScBI13', 'txtPg1' + attachNum + 'ScCI2');
		}
	computePg1AttachScCItm3(attachNum);
	}
	
   function computePg1AttachScCItm3(attachNum) {
		summation('txtPg1' + attachNum + 'ScCI1,txtPg1' + attachNum + 'ScCI2', 'txtPg1' + attachNum + 'ScCI3');
		computePg1AttachScCItm5(attachNum);
	}
	
   function computePg1AttachScCItm4(attachNum) {
		if(d.getElementById("frm1702MX:txtPg1" + attachNum + "ScDI1").value == 0){
			(d.getElementById("frm1702MX:txtPg1" + attachNum + "ScCI4").value) = (d.getElementById("frm1702MX:txtPg1" + attachNum + "ScBI14").value)
		}
		computePg1AttachScCItm5(attachNum);
	}
	
   function computePg1AttachScCItm5(attachNum) {
		summationThenDifference('txtPg1' + attachNum + 'ScCI3', 'txtPg1' + attachNum + 'ScCI4', 'hidden', 'txtPg1' + attachNum + 'ScCI5');
		//computePg1AttachScCItm6(attachNum);
		computePg1AttachScCItm7(attachNum);
	}
	
