	   function check_MethodOfDeduction() {
        if (d.getElementById('frm1702MX:rdoPg1Pt1I13MethodOfDeducItemized').checked == false
         && d.getElementById('frm1702MX:rdoPg1Pt1I13MethodOfDeducOptional').checked == false) {
            alert("Please select a Method of Deduction in page 1 Item 13."); 
            return false;
        }
        else {
            return true;
        }

