    function Save_modalTablePg4Sc10I6() {
        var str = "";
        var count = 0;
        var numRows = document.getElementById("modalTablePg4Sc10I6").rows.length;
        var table = document.getElementById("modalTablePg4Sc10I6");

        main_modalTablePg4Sc10I6_Col1 = new Array();
        main_modalTablePg4Sc10I6_Col2 = new Array();
        main_modalTablePg4Sc10I6_Col3 = new Array();
        main_modalTablePg4Sc10I6_Col4 = new Array();

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                main_modalTablePg4Sc10I6_Col1.push(table.rows[x].cells[0].children[1].value);
                main_modalTablePg4Sc10I6_Col2.push(table.rows[x].cells[1].children[0].value);
                main_modalTablePg4Sc10I6_Col3.push(table.rows[x].cells[2].children[0].value);
                main_modalTablePg4Sc10I6_Col4.push(table.rows[x].cells[3].children[0].value);
                count += 1;
            }
        }


        if (count == 0) {
            enableField('txtPg4Sc10Itm6,txtPg4Sc10Itm6A,txtPg4Sc10Itm6B,txtPg4Sc10Itm6C');
            disableField('btnModalPg4Sc10I6');
            setValuesTo('txtPg4Sc10Itm6', '');
            setValuesTo('txtPg4Sc10Itm6A,txtPg4Sc10Itm6B,txtPg4Sc10Itm6C', '0');
        }
        else if (count == 1) {
            enableField('txtPg4Sc10Itm6,txtPg4Sc10Itm6A,txtPg4Sc10Itm6B,txtPg4Sc10Itm6C');
            //disableField('btnModalPg5Sc4I3');

            setValuesTo('txtPg4Sc10Itm6', table.rows[0].cells[0].children[1].value);
            setValuesTo('txtPg4Sc10Itm6A', table.rows[0].cells[1].children[0].value);
            setValuesTo('txtPg4Sc10Itm6B', table.rows[0].cells[2].children[0].value);
            setValuesTo('txtPg4Sc10Itm6C', table.rows[0].cells[3].children[0].value);
            main_modalTablePg4Sc10I6_Col1 = new Array();
            main_modalTablePg4Sc10I6_Col2 = new Array();
            main_modalTablePg4Sc10I6_Col3 = new Array();
            main_modalTablePg4Sc10I6_Col4 = new Array();

        }
        else {
            Load_modalTablePg4Sc10I6();
            document.getElementById("frm1702MX:txtPg4Sc10Itm6").value = 'OTHERS';
            document.getElementById("frm1702MX:txtPg4Sc10Itm6A").value = document.getElementById("frm1702MX:txtPg4Sc10Itm6_SubTotalCA").value;
            document.getElementById("frm1702MX:txtPg4Sc10Itm6B").value = document.getElementById("frm1702MX:txtPg4Sc10Itm6_SubTotalCB").value;
            document.getElementById("frm1702MX:txtPg4Sc10Itm6C").value = document.getElementById("frm1702MX:txtPg4Sc10Itm6_SubTotalCC").value;
            document.getElementById("frm1702MX:txtPg4Sc10Itm6D").value = document.getElementById("frm1702MX:txtPg4Sc10Itm6_SubTotalCD").value;
            disableField('txtPg4Sc10Itm6,txtPg4Sc10Itm6A,txtPg4Sc10Itm6B,txtPg4Sc10Itm6C');

        }
        document.getElementById("frm1702MX:txtCtrmodalPg7Sc10I6").value = count;
        getSum('txtPg4Sc10Itm6A,txtPg4Sc10Itm6B,txtPg4Sc10Itm6C', 'txtPg4Sc10Itm6D');
        computePg4Sc10I9();
        //alert("Saved!");
    }

