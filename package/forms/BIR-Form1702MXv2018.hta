                                                       getValAmount('txtPg6Sc7AI4CB'), getValAmount('txtPg6Sc7AI5CB'), getValAmount('txtPg6Sc7AI6CB'), getValAmount('txtPg6Sc7AI7CB'),
                                                       getValAmount('txtPg6Sc7AI4CC'), getValAmount('txtPg6Sc7AI5CC'), getValAmount('txtPg6Sc7AI6CC'), getValAmount('txtPg6Sc7AI7CC'),
                                                       getValAmount('txtPg6Sc7AI4CD'), getValAmount('txtPg6Sc7AI5CD'), getValAmount('txtPg6Sc7AI6CD'), getValAmount('txtPg6Sc7AI7CD'),
                                                       getValAmount('txtPg6Sc7AI4CE'), getValAmount('txtPg6Sc7AI5CE'), getValAmount('txtPg6Sc7AI6CE'), getValAmount('txtPg6Sc7AI7CE'));

        // Schedule 8
        populateTaxCreditPaymentExempt();

        populateTaxCreditPaymentSpecial();

        populateTaxCreditPaymentRegular();

        populateTaxCreditPaymentTotal(getValAmount('txtPg6Sc8I1CD'),
                                      getValAmount('txtPg6Sc8I2CD'),
                                      getValAmount('txtPg6Sc8I3CD'),
                                      getValAmount('txtPg6Sc8I5CD'),
                                      getValAmount('txtPg6Sc8I6CD'),
                                      getValAmount('txtPg7Sc8I7CD'), getValAmount('txtPg7Sc8I8CD'), getValAmount('txtPg7Sc8I9CD'),
                                      getValAmount('txtPg7Sc8I10CD'),
                                      getValAmount('txtPg7Sc8I11CD'),
                                      (getValAmount('txtCtrmodalPg7Sc8') > 1) ? 0 : getValAmount('txtPg2Sc3It31CD'));
        //Iterating row Item 12
        var TablePg7Sc8 = document.getElementById("modalTablePg2Sc3");
        if (getValAmount('txtCtrmodalPg7Sc8') > 1) {
            for (x = 0; x < getValAmount('txtCtrmodalPg7Sc8') ; x++) {

                populateOtherCreditsList(TablePg7Sc8.rows[x].cells[0].children[1].value,
