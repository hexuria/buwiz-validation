function isVarious(cnt){

	var isVarious = false;
	isVarious = (cnt > 0);
	return isVarious; 
	

}

//Schedule F jawowo
	function computeToMainScF(currField,attachNum) {

		var currTaxReg = attachNum.substring(0,2);
