    function removeSaveTemp_modalTablePg4MScGI39(attachNum) {
        temp_Array_Col1 = new Array();
        temp_Array_Col2 = new Array();
        var str = "";
        var numRows = document.getElementById("modalTablePg4" + attachNum + "ScGI39").rows.length;
