                                                            NumWithComma(NumWithParenthesis(TablePg5Sc5I39.rows[x].cells[4].children[0].value)));
            }
        }
        //iterating row Item 39

        // Schedule 6
        populateSpecialAllowableItemizedDeduction(getVal('txtPg6Sc6I1description'), getVal('txtPg6Sc6I1legal'),
                                                  getValAmount('txtPg6Sc6I1CA'), getValAmount('txtPg3Sc6I1CB'),
                                                  getValAmount('txtPg6Sc6I1CC'), getValAmount('txtPg6Sc6I1CD'),
                                                  getVal('txtPg6Sc6I2description'),
                                                  getVal('txtPg6Sc6I2legal'), getValAmount('txtPg6Sc6I2CA'),
                                                  getValAmount('txtPg3Sc6I2CB'), getValAmount('txtPg6Sc6I2CC'),
                                                  getValAmount('txtPg6Sc6I2CD'), getVal('txtPg6Sc6I3description'),
