<script type="text/javascript" name="validationsJavascript">
    function validateMonth(elem) {
        if ((elem.value !== "") && (((elem.value * 1) < 1) || ((elem.value * 1) > 12))) {
            alert("Please provide a valid date.");
            elem.value = "";
            elem.focus();
        }
    }

    function validatePg1Pt2I22(isFromLoad) {
