        str2 = document.getElementById('frm1702MX:' + textbox2).value;
        if ($.trim(str1) != "" && $.trim(str2) != "") {
            enableField(buttonModalID);
        }
        else if ($.trim(str1) == "" || $.trim(str2) == "") {
            disableField(buttonModalID);
        }
			methodOfDeductionsOptional();
    }
