        main_modalTablePg4Sc10I8_Col3 = new Array();
        main_modalTablePg4Sc10I8_Col4 = new Array();

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                main_modalTablePg4Sc10I8_Col1.push(table.rows[x].cells[0].children[1].value);
                main_modalTablePg4Sc10I8_Col2.push(table.rows[x].cells[1].children[0].value);
                main_modalTablePg4Sc10I8_Col3.push(table.rows[x].cells[2].children[0].value);
                main_modalTablePg4Sc10I8_Col4.push(table.rows[x].cells[3].children[0].value);
                count += 1;
            }
        }


        if (count == 0) {
            enableField('txtPg4Sc10Itm8,txtPg4Sc10Itm8A,txtPg4Sc10Itm8B,txtPg4Sc10Itm8C');
            disableField('btnModalPg4Sc10I8');
            setValuesTo('txtPg4Sc10Itm8', '');
            setValuesTo('txtPg4Sc10Itm8A,txtPg4Sc10Itm8B,txtPg4Sc10Itm8C', '0');
        }
        else if (count == 1) {
            enableField('txtPg4Sc10Itm8,txtPg4Sc10Itm8A,txtPg4Sc10Itm8B,txtPg4Sc10Itm8C');
            //disableField('btnModalPg5Sc4I3');

            setValuesTo('txtPg4Sc10Itm8', table.rows[0].cells[0].children[1].value);
            setValuesTo('txtPg4Sc10Itm8A', table.rows[0].cells[1].children[0].value);
            setValuesTo('txtPg4Sc10Itm8B', table.rows[0].cells[2].children[0].value);
            setValuesTo('txtPg4Sc10Itm8C', table.rows[0].cells[3].children[0].value);
            main_modalTablePg4Sc10I8_Col1 = new Array();
            main_modalTablePg4Sc10I8_Col2 = new Array();
            main_modalTablePg4Sc10I8_Col3 = new Array();
            main_modalTablePg4Sc10I8_Col4 = new Array();

        }
        else {
            Load_modalTablePg4Sc10I8();
            document.getElementById("frm1702MX:txtPg4Sc10Itm8").value = 'OTHERS';
            document.getElementById("frm1702MX:txtPg4Sc10Itm8A").value = document.getElementById("frm1702MX:txtPg4Sc10Itm8_SubTotalCA").value;
            document.getElementById("frm1702MX:txtPg4Sc10Itm8B").value = document.getElementById("frm1702MX:txtPg4Sc10Itm8_SubTotalCB").value;
            document.getElementById("frm1702MX:txtPg4Sc10Itm8C").value = document.getElementById("frm1702MX:txtPg4Sc10Itm8_SubTotalCC").value;
            document.getElementById("frm1702MX:txtPg4Sc10Itm8D").value = document.getElementById("frm1702MX:txtPg4Sc10Itm8_SubTotalCD").value;
            disableField('txtPg4Sc10Itm8,txtPg4Sc10Itm8A,txtPg4Sc10Itm8B,txtPg4Sc10Itm8C');

        }
        document.getElementById("frm1702MX:txtCtrmodalPg7Sc10I8").value = count;
        getSum('txtPg4Sc10Itm8A,txtPg4Sc10Itm8B,txtPg4Sc10Itm8C', 'txtPg4Sc10Itm8D');
        computePg4Sc10I9();
        //alert("Saved!");
    }

    function Load_modalTablePg4Sc10I8() {
        $("#modalTablePg4Sc10I8 tr").remove();
        var i = main_modalTablePg4Sc10I8_Col1.length;
        if (main_modalTablePg4Sc10I8_Col1.length != 0) {
            for (x = 0; x < i; x++) {
                AddRow_modalTablePg4Sc10I8();
                document.getElementById("frm1702MX:txtPg4Sc10Itm8_" + (x + 1) + "Col1").value = main_modalTablePg4Sc10I8_Col1[x];
                document.getElementById("frm1702MX:txtPg4Sc10Itm8_" + (x + 1) + "Col2").value = main_modalTablePg4Sc10I8_Col2[x];
                document.getElementById("frm1702MX:txtPg4Sc10Itm8_" + (x + 1) + "Col3").value = main_modalTablePg4Sc10I8_Col3[x];
                document.getElementById("frm1702MX:txtPg4Sc10Itm8_" + (x + 1) + "Col4").value = main_modalTablePg4Sc10I8_Col4[x];
            }
        }

        summationmodalTablePg4Sc10I8();
    }

    function AddRow_modalTablePg4Sc10I8() {
        var i = document.getElementById("modalTablePg4Sc10I8").rows.length;
        var table = document.getElementById("modalTablePg4Sc10I8");

        var disabledAttribute2 = (!!isValidated) ? "disabled=\"disabled\"" : "";

        var row = table.insertRow(i);
        var cell1 = row.insertCell(0);
        var cell2 = row.insertCell(1);
        var cell3 = row.insertCell(2);
        var cell4 = row.insertCell(3);
        var cell5 = row.insertCell(4);
        var cell6 = row.insertCell(5);

        cell1.className = "tblFormTd";
        cell2.className = "tblFormTd"; cell2.style.width = "15%"; cell2.style.textAlign = "center";
        cell3.className = "tblFormTd"; cell3.style.width = "15%"; cell3.style.textAlign = "center";
        cell4.className = "tblFormTd"; cell4.style.width = "15%"; cell4.style.textAlign = "center";
        cell5.className = "tblFormTd"; cell5.style.width = "15%"; cell5.style.textAlign = "center";
        cell6.className = "tblFormTd"; cell6.style.width = "10%"; cell6.style.textAlign = "center";

        cell1.innerHTML = '<span style="font-weight: bold; font-size: small;">&nbsp;8.' + (i + 1) + '</span> <input type="text" size="25" maxlength="18" ' + disabledAttribute2 + ' id="frm1702MX:txtPg4Sc10Itm8_' + (i + 1) + 'Col1"  onkeypress="return Name(this);" onblur="capitalize(this);" />';
        cell2.innerHTML = '<input type="text" id="frm1702MX:txtPg4Sc10Itm8_' + (i + 1) + 'Col2" class="numbertext" value="0" size="14" ' + disabledAttribute2 + ' onchange="setToZeroIfEmpty(this)" onblur="summationmodalTablePg4Sc10I8(); addCommas1702MX(this);" onkeypress="return wholenumber(this, event)"  maxlength="12" />';
        cell3.innerHTML = '<input type="text" id="frm1702MX:txtPg4Sc10Itm8_' + (i + 1) + 'Col3" class="numbertext" value="0" size="14" ' + disabledAttribute2 + ' onchange="setToZeroIfEmpty(this)" onblur="summationmodalTablePg4Sc10I8(); addCommas1702MX(this);" onkeypress="return wholenumber(this, event)"  maxlength="12" />';
        cell4.innerHTML = '<input type="text" id="frm1702MX:txtPg4Sc10Itm8_' + (i + 1) + 'Col4" class="numbertext" value="0" size="14" ' + disabledAttribute2 + ' onchange="setToZeroIfEmpty(this)" onblur="summationmodalTablePg4Sc10I8(); addCommas1702MX(this);" onkeypress="return wholenumber(this, event)"  maxlength="12" />';
        cell5.innerHTML = '<input type="text" id="frm1702MX:txtPg4Sc10Itm8_' + (i + 1) + 'Col5" class="numbertext" value="0" size="14" ' + disabledAttribute2 + ' disabled="disabled" /></td>';
        cell6.innerHTML = '<input type="button" value="Remove" onclick="deleteRow(this),removeSaveTemp_modalTablePg4Sc10I8()" ' + disabledAttribute2 + ' />';

        $('input[type="text"]').focus(function () {
            $(this).css({ 'background': '#ffffcc' });
            this.select();
        });

        $('input[type="text"]').blur(function () {
            $(this).css({ 'background': '#ffffff' });
        });

        $(".numbertext").focus(function () {
            $(this).val("" + NumWithComma(NumWithParenthesis($(this).val())));
            $(this).css({ 'background': '#ffffcc' });
            this.select();
        });
    }
    function removeSaveTemp_modalTablePg4Sc10I8() {
        temp_Array_Col1 = new Array();
        temp_Array_Col2 = new Array();
        temp_Array_Col3 = new Array();
        temp_Array_Col4 = new Array();
        var str = "";
        var numRows = document.getElementById("modalTablePg4Sc10I8").rows.length;
        var table = document.getElementById("modalTablePg4Sc10I8");

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            //  if ($.trim(str) != "") {
            temp_Array_Col1.push(table.rows[x].cells[0].children[1].value);
            temp_Array_Col2.push(table.rows[x].cells[1].children[0].value);
            temp_Array_Col3.push(table.rows[x].cells[2].children[0].value);
            temp_Array_Col4.push(table.rows[x].cells[3].children[0].value);
            //  }
        }

        $("#modalTablePg4Sc10I8 tr").remove();
        var i = temp_Array_Col1.length;
        if (temp_Array_Col1.length != 0) {
            for (x = 0; x < i; x++) {
                AddRow_modalTablePg4Sc10I8();
                document.getElementById("frm1702MX:txtPg4Sc10Itm8_" + (x + 1) + "Col1").value = temp_Array_Col1[x];
                document.getElementById("frm1702MX:txtPg4Sc10Itm8_" + (x + 1) + "Col2").value = temp_Array_Col2[x];
                document.getElementById("frm1702MX:txtPg4Sc10Itm8_" + (x + 1) + "Col3").value = temp_Array_Col3[x];
                document.getElementById("frm1702MX:txtPg4Sc10Itm8_" + (x + 1) + "Col4").value = temp_Array_Col4[x];
            }
        }
        summationmodalTablePg4Sc10I8();

        alert("Removed!");
    }
    function Cancel_modalTablePg4Sc10I8() {
        Load_modalTablePg4Sc10I8();
        alert("Canceled!");
    }
    //Summation
    function summationmodalTablePg4Sc10I8() {
        var totalA = 0;
        var totalB = 0;
        var totalC = 0;
        var totalD = 0;
        var totalperRow = 0;
        numRows = document.getElementById("modalTablePg4Sc10I8").rows.length;
        table = document.getElementById("modalTablePg4Sc10I8");

        for (x = 0; x < numRows; x++) {

            totalA += NumWithComma(NumWithParenthesis(table.rows[x].cells[1].children[0].value));
            totalB += NumWithComma(NumWithParenthesis(table.rows[x].cells[2].children[0].value));
            totalC += NumWithComma(NumWithParenthesis(table.rows[x].cells[3].children[0].value));
            totalperRow = NumWithComma(NumWithParenthesis(table.rows[x].cells[1].children[0].value))
							+ NumWithComma(NumWithParenthesis(table.rows[x].cells[2].children[0].value))
							+ NumWithComma(NumWithParenthesis(table.rows[x].cells[3].children[0].value));
            table.rows[x].cells[4].children[0].value = NegativeValue(formatCurrencyWOC(totalperRow));

        }
        totalD = totalA + totalB + totalC;
        document.getElementById("frm1702MX:txtPg4Sc10Itm8_SubTotalCA").value = NegativeValue(formatCurrencyWOC(totalA));
        document.getElementById("frm1702MX:txtPg4Sc10Itm8_SubTotalCB").value = NegativeValue(formatCurrencyWOC(totalB));
        document.getElementById("frm1702MX:txtPg4Sc10Itm8_SubTotalCC").value = NegativeValue(formatCurrencyWOC(totalC));
        document.getElementById("frm1702MX:txtPg4Sc10Itm8_SubTotalCD").value = NegativeValue(formatCurrencyWOC(totalD));
    }
