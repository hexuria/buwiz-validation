    function Save_modalTablePg3Sc6() {
        var str1 = "";
        var str2 = "";
        var count = 0;
        var numRows = document.getElementById("modalTablePg3Sc6").rows.length;
        var table = document.getElementById("modalTablePg3Sc6");

        main_modalTablePg3Sc6_Col1 = new Array();
        main_modalTablePg3Sc6_Col2 = new Array();
        main_modalTablePg3Sc6_Col3 = new Array();
        main_modalTablePg3Sc6_Col4 = new Array();
        main_modalTablePg3Sc6_Col5 = new Array();

        for (x = 0; x < numRows; x++) {
            str1 = table.rows[x].cells[0].children[1].value;
            str2 = table.rows[x].cells[1].children[0].value;
            if ($.trim(str1) != "" || $.trim(str2) != "") {
                main_modalTablePg3Sc6_Col1.push(table.rows[x].cells[0].children[1].value);
                main_modalTablePg3Sc6_Col2.push(table.rows[x].cells[1].children[0].value);
                main_modalTablePg3Sc6_Col3.push(table.rows[x].cells[2].children[0].value);
                main_modalTablePg3Sc6_Col4.push(table.rows[x].cells[3].children[0].value);
                main_modalTablePg3Sc6_Col5.push(table.rows[x].cells[4].children[0].value);
                count += 1;
            }
        }

        if (count == 0) {
            enableField('txtPg3Sc6I4description,txtPg3Sc6I4legal,txtPg3Sc6I4CA,txtPg3Sc6I4CB,txtPg3Sc6I4CC');
            disableField('btnModalPg3Sc6');
            setValuesTo('txtPg3Sc6I4description,txtPg3Sc6I4legal', '');
            setValuesTo('txtPg3Sc6I4CA,txtPg3Sc6I4CB,txtPg3Sc6I4CC', '0');
        }
        else if (count == 1) {
            enableField('txtPg3Sc6I4description,txtPg3Sc6I4legal,txtPg3Sc6I4CA,txtPg3Sc6I4CB,txtPg3Sc6I4CC');
            //disableField('btnModalPg5Sc4I3');

            setValuesTo('txtPg3Sc6I4description', table.rows[0].cells[0].children[1].value);
            setValuesTo('txtPg3Sc6I4legal', table.rows[0].cells[1].children[0].value);
            setValuesTo('txtPg3Sc6I4CA', table.rows[0].cells[2].children[0].value);
            setValuesTo('txtPg3Sc6I4CB', table.rows[0].cells[3].children[0].value);
            setValuesTo('txtPg3Sc6I4CC', table.rows[0].cells[4].children[0].value);
            main_modalTablePg3Sc6_Col1 = new Array();
            main_modalTablePg3Sc6_Col2 = new Array();
            main_modalTablePg3Sc6_Col3 = new Array();
            main_modalTablePg3Sc6_Col4 = new Array();
            main_modalTablePg3Sc6_Col5 = new Array();

        }
        else {
            Load_modalTablePg3Sc6();
            document.getElementById("frm1702MX:txtPg3Sc6I4description").value = 'OTHERS';
            document.getElementById("frm1702MX:txtPg3Sc6I4legal").value = 'OTHERS';
            document.getElementById("frm1702MX:txtPg3Sc6I4CA").value = document.getElementById("frm1702MX:txtPg6Sc6_SubTotalCA").value;
            document.getElementById("frm1702MX:txtPg3Sc6I4CB").value = document.getElementById("frm1702MX:txtPg6Sc6_SubTotalCB").value;
            document.getElementById("frm1702MX:txtPg3Sc6I4CC").value = document.getElementById("frm1702MX:txtPg6Sc6_SubTotalCC").value;
            document.getElementById("frm1702MX:txtPg3Sc6I4CD").value = document.getElementById("frm1702MX:txtPg6Sc6_SubTotalCD").value;
            disableField('txtPg3Sc6I4description,txtPg3Sc6I4legal,txtPg3Sc6I4CA,txtPg3Sc6I4CB,txtPg3Sc6I4CC');
            //document.getElementById("frm1702MX:txtCtrmodalPg6Sc6").value = count;

        }

        document.getElementById("frm1702MX:txtCtrmodalPg6Sc6").value = count;
        getSum('txtPg3Sc6I4CA,txtPg3Sc6I4CB,txtPg3Sc6I4CC', 'txtPg3Sc6I4CD');
        computePg6Sc6I5();
        //alert("Saved!");
    }

