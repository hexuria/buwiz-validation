	}
	
	//Page 2 Schedule 2 Item 12 & 13 - Method of Deduction if OSD
	function computePg2Sc2It12() {
		if (d.getElementById("frm1702MX:rdoPg1Pt1I13MethodOfDeducOptional").checked == true){

			product2('txtPg2Sc2Itm7C','0.4','txtPg2Sc2It12C');
			getSum('txtPg2Sc2It12C','txtPg2Sc2It12D');

			d.getElementById("frm1702MX:txtPg2Sc2It11C").value = 0;
			d.getElementById("frm1702MX:txtPg2Sc2It11D").value = 0;
			getDifference('txtPg2Sc2Itm7C','txtPg2Sc2It12C','txtPg2Sc2It13C');
			getSum('txtPg2Sc2It13C','txtPg2Sc2It13D');
				d.getElementById("frm1702MX:txtPg2Sc2Itm9C").value = 0;
			d.getElementById("frm1702MX:txtPg2Sc2Itm9D").value = 0;
			}	
	}
	
	//Page 2 Schedule 2 Item 15 - based on Item 14
	function computePg2Sc2It15()	{
	
			var taxRate = $_Id("frm1702MX:txtPg2Sc2It14B").value;
			
			var amount1 = NumWithComma($_Id("frm1702MX:txtPg2Sc2Itm3B").value).toFixed(0) * 1;
			var amount2 = NumWithComma($_Id("frm1702MX:txtPg2Sc2Itm7B").value).toFixed(0) * 1;
			
			
			if (taxRate == 10.0 ){

				product1('txtPg2Sc2It13B', 'txtPg2Sc2It14B', 'txtPg2Sc2It15B');
			}
			else if (taxRate ==  5.0 ){
				product1('txtPg2Sc2Itm7B', 'txtPg2Sc2It14B', 'txtPg2Sc2It15B');
				}
			else if (taxRate ==2.0 || amount1 >= amount2){
				product1('txtPg2Sc2Itm1B','txtPg2Sc2It14B', 'txtPg2Sc2It15B');
			}else {
				product1('txtPg2Sc2Itm7B', 'txtPg2Sc2It14B', 'txtPg2Sc2It15B');
			}

			d.getElementById("frm1702MX:txtPg2Sc4Itm4B").value = d.getElementById("frm1702MX:txtPg2Sc2It15B").value;
				computePg2Sc2Itm3();
				computePg2Sc2Itm5();
				computePg2Sc2Itm7();
	}

	//Page 2 Schedule 2 Item 15 & Item 17C- based on Item 14
	function computePg2Sc2It15C() {
		product1('txtPg2Sc2It13C','txtPg2Sc2It14C','txtPg2Sc2It15C');

		d.getElementById("frm1702MX:txtPg2Sc2It17C").value = d.getElementById("frm1702MX:txtPg2Sc2It15C").value;
		computePg2Sc2It19C();
