	//Page 4 Schedule 8 Item 3 to Sched 8.1 Item 7A
	function computetxtPg4IShed8_7A() {
			page4Item7GetValue();
    }
	
	function page4Item7GetValue(){
			
			if (getValAmount('txtPg2Sc2Itm7B') < getValAmount('txtPg2Sc2Itm8B')  ){
		
			//computetxtPg4Shed81ColE();
			var total = Math.abs(WholeNumWithComma(NumWithParenthesis(d.getElementById("frm1702MX:txtPg4Sc8It3").value)));
			var filingYear = 2000 + ($_Id("frm1702MX:txtPg1I2YearEnd").value * 1);
			d.getElementById("frm1702MX:txtPg4IShed8_7Year").value = filingYear;
			d.getElementById("frm1702MX:txtPg4IShed8_7A").value = NegativeValue(formatCurrencyWOC( total));
			d.getElementById("frm1702MX:txtPg4IShed8_7E").value = NegativeValue(formatCurrencyWOC( total));
			d.getElementById("frm1702MX:txtPg4IShed8_7Year").disabled= true;
			d.getElementById("frm1702MX:txtPg4IShed8_7A").disabled= true;
			d.getElementById("frm1702MX:txtPg4IShed8_7B").disabled= true;
			d.getElementById("frm1702MX:txtPg4IShed8_7C").disabled= true;
			d.getElementById("frm1702MX:txtPg4IShed8_7D").disabled= true;
			d.getElementById("frm1702MX:txtPg4IShed8_7E").disabled= true;
			computeP4Sc8AI7E(d.getElementById("frm1702MX:txtPg4IShed8_7E"));	
			
		}
		
	}
		
    // ========================== NOLCO MAIN PAGE ==========================

      function computeNolco(type){
		
		switch(type){
			case 'B':
				if (getValAmount('txtPg2Sc2Itm7B') < getValAmount('txtPg2Sc2Itm8B') ){
					d.getElementById("frm1702MX:txtPg4Sc8It1").value = d.getElementById("frm1702MX:txtPg2Sc2Itm7B").value;
					d.getElementById("frm1702MX:txtPg4Sc8It2").value = d.getElementById("frm1702MX:txtPg3Sc5Itm18B").value;
					getDifference('txtPg4Sc8It1', 'txtPg4Sc8It2', 'txtPg4Sc8It3');
					computetxtPg4IShed8_7A();
				}
				else if(getValAmount('txtPg2Sc2Itm7B') >= 0){
					page4Sch8item3IsNegative();
				}
			case 'C':
			
			var totalItem18 = getValAmount('txtPg3Sc5Itm18C')
			var totalItem33 = getValAmount('txtPg2Sc2Itm7C');
			if(totalItem18 > totalItem33){
				
					d.getElementById("frm1702MX:txtPg6Sc7I1").value = d.getElementById("frm1702MX:txtPg2Sc2Itm7C").value;
					d.getElementById("frm1702MX:txtPg6Sc7I2").value = d.getElementById("frm1702MX:txtPg3Sc5Itm18C").value;
					getDifference('txtPg6Sc7I1', 'txtPg6Sc7I2', 'txtPg6Sc7I3');
					computetxtPg3IShed7_7A();
				}
				else if(totalItem18 <= totalItem33){
					page4Sch7item3IsNegative();
				}
	
		
		}
		
		}

