                                              NumWithComma(NumWithParenthesis(TablePg6Sc6.rows[x].cells[5].children[0].value)));
            }
        }

        // Schedule 7
        populateComputationOfNetOperatingLossCarryOver(getValAmount('txtPg6Sc7I1'), getValAmount('txtPg6Sc7I2'), getValAmount('txtPg6Sc7I3'),
                                                       getVal('txtPg6Sc7AI4year'), getVal('txtPg6Sc7AI5year'), getVal('txtPg6Sc7AI6year'), getVal('txtPg6Sc7AI7year'),
