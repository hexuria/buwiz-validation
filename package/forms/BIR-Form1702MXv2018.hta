    // load profile.xml
    function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = ""
            } else {
                var responseBG = document.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag			
            }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug				
            loadBGData(); /*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = ""
        }
    }

    // load data on controls based on profile.xml
    function loadBGData() {
        /*This will load data onto Background Information fields*/
        var responseBG = document.getElementById("responseBG");

        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '1702MXv2018') {
            var fnVal = String(responseBG.innerHTML).split('fn=');
            //document.getElementById('frm1702MX:txtPg1Pt1I9RegisteredName').value = unescape(fnVal[1]);

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            //document.getElementById('frm1702MX:txtPg1Pt1I6TINC1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            //document.getElementById('frm1702MX:txtPg1Pt1I6TINC2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            //document.getElementById('frm1702MX:txtPg1Pt1I6TINC3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            //document.getElementById('frm1702MX:txtPg1Pt1I6TINC4').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            document.getElementById('frm1702MX:txtPg1Pt1I7RDO').value = rdoVal[1];
            $('select[id="frm1702MX:drpPg1Pt1I7RDO"] option[value = ' + rdoVal[1] + ']').attr("selected", "selected");
            //var data = "<select id='frm1702MX:drpPg1Pt1I7RDO' name='frm1702MX:drpPg1Pt1I7RDO' disabled='disabled' size='1'><option value='" + rdoVal[1] + "' selected>" + rdoVal[1] + "</option>"
            //$('#rdoContainer').html(data);

            var lobVal = String(responseBG.innerHTML).split('lob=');
            document.getElementById('frm1702MX:txtPg1Pt1I13MainLine').value = unescape(lobVal[1].toUpperCase());

            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
            document.getElementById('frm1702MX:txtPg1Pt1I10RegisteredAddress').value = unescape(regAddrVal[1].toUpperCase());

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            document.getElementById('frm1702MX:txtPg1Pt1I11ContactNumber').value = telNoVal[1];

            //No Zip for 1702MX, just store in a hidden element
            var zipVal = String(responseBG.innerHTML).split('zip=');
            document.getElementById('frm1702MX:txtZIP').value = zipVal[1];
            p3TPZip = zipVal[1];

            //set TIN & TaxFiler's Name across the whole form
            var TIN1 = d.getElementsByName('frm1702MX:txtTIN1');
            var TIN2 = d.getElementsByName('frm1702MX:txtTIN2');
            var TIN3 = d.getElementsByName('frm1702MX:txtTIN3');
            var TIN4 = d.getElementsByName('frm1702MX:txtTIN4');
            var TaxFiler = d.getElementsByName('frm1702MX:txtRegisteredName');

            for (var i = 0; i < TIN1.length; i++) {
                TIN1[i].value = tin1Val[1];
                TIN2[i].value = tin2Val[1];
                TIN3[i].value = tin3Val[1];
                TIN4[i].value = tin4Val[1];
                TaxFiler[i].value = unescape(fnVal[1].toUpperCase());
            }
        }
        var emailVal = String(responseBG.innerHTML).split('email=');
        if (emailVal[1] === undefined) {
            document.getElementById('frm1702MX:txtPg1Pt1I12Email').value = "";
        }
        else {
            document.getElementById('frm1702MX:txtPg1Pt1I12Email').value = emailVal[1];
            globalEmail = emailVal[1];
        }
    }

  
     function loadData() {
        /*This will load data onto fields*/
        var response = document.getElementById("response");
        var modalCounter = document.getElementById('modalCounter').getElementsByTagName('input');
        var counter = 0;
		
   
        for (var i = 0; i < modalCounter.length; i++) {
		
            //locate modal for row iteration and do conditions
			
			
			if ((response.innerHTML).indexOf(modalCounter[0].id) != -1 && i == 0) { // 0 txtCtrmodalPg7Sc8
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
                for (var k = 0; k < counter; k++) {
                    disableField('txtPg2Sc3It31,txtPg2Sc3It31A,txtPg2Sc3It31B,txtPg2Sc3It31C');
                    enableField('btnModalPg2Sc3');
                    AddRow_modalTablePg2Sc3();
					
                }
            }
			
			else if ((response.innerHTML).indexOf(modalCounter[1].id) != -1 && i == 1) {  //1 <input type="text" size="10" id="frm1702MX:txtCtrmodalPg3Sc5I17i" value="0" />
			
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
                for (var k = 0; k < counter; k++) {
                    disableField('txtPg3Sc5It17i,txtPg3Sc5Itm17iA,txtPg3Sc5Itm17iB,txtPg3Sc5Itm17iC');
                    enableField('btnModalPg3Sc5I17i');
                    AddRow_modalTablePg3Sc5I17i();
                }
            }
	
			
			else if ((response.innerHTML).indexOf(modalCounter[2].id) != -1 && i ==2) {   // <input type="text" size="10" id="frm1702MX:txtCtrmodalPg6Sc6" value="0" />   -- 4
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
                for (var k = 0; k < counter; k++) {
                    disableField('txtPg3Sc6I4description,txtPg3Sc6I4legal,txtPg3Sc6I4CA,txtPg3Sc6I4CB,txtPg3Sc6I4CC');
                    enableField('btnModalPg3Sc6');
                    AddRow_modalTablePg3Sc6();
                }
            }
			
			
			else if ((response.innerHTML).indexOf(modalCounter[3].id) != -1 && i == 3) {  // <input type="text" size="10" id="frm1702MX:txtCtrmodalPg7Sc10I3" value="0" />
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
                for (var k = 0; k < counter; k++) {
                    disableField('txtPg4Sc10Itm3B,txtPg4Sc10Itm3C');
                    enableField('btnModalPg4Sc10I3');
                    AddRow_modalTablePg4Sc10I3();
                }
            }
            else if ((response.innerHTML).indexOf(modalCounter[4].id) != -1 && i == 4) {  //  <input type="text" size="10" id="frm1702MX:txtCtrmodalPg7Sc10I6" value="0" />
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
                for (var k = 0; k < counter; k++) {
                    disableField('txtPg4Sc10Itm6,txtPg4Sc10Itm6A,txtPg4Sc10Itm6B,txtPg4Sc10Itm6C');
                    enableField('btnModalPg4Sc10I6');
                    AddRow_modalTablePg4Sc10I6();
                }
            }
            else if ((response.innerHTML).indexOf(modalCounter[5].id) != -1 && i == 5) {  //  <input type="text" size="10" id="frm1702MX:txtCtrmodalPg7Sc10I8" value="0" />
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
                for (var k = 0; k < counter; k++) {
                    disableField('txtPg4Sc10Itm8,txtPg4Sc10Itm8A,txtPg4Sc10Itm8B,txtPg4Sc10Itm8C');
                    enableField('btnModalPg4Sc10I8');
                    AddRow_modalTablePg4Sc10I8();
                }
            }
		
		
		
           
                // EX attachments
            else if ((response.innerHTML).indexOf(modalCounter[6].id) != -1 && i == 6) {  // <input type="text" size="10" id="frm1702MX:totalEXAttach" value="0" />  -- 15
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
                if (counter > 0) {
					
                    for (var k = 0; k < counter; k++) {
                        addAttachment("EX");
                    }

                   disableAttachColumns(true, 'EX');
                }
                //totalEX = isNan(parseInt(counter)) ? 0 : parseInt(counter);
                changeView(false);
            }
                // SP attachments 
            else if ((response.innerHTML).indexOf(modalCounter[7].id) != -1 && i == 7) {  //    <input type="text" size="10" id="frm1702MX:totalSPAttach" value="0" />  -- 16
               
				counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
				
                if (counter > 0) {
                  	for (var k = 0; k < counter; k++) {  
                        addAttachment("SP");
                    }

                    disableAttachColumns(true, 'SP');
                }
                //totalSP = isNan(parseInt(counter)) ? 0 : parseInt(counter);
                changeView(false);
            }
        }
	

        loadAttachmentIterationData();

        var elem = document.getElementById('frmMain').elements;
        for (var i = 0; i < elem.length; i++) {
            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&  			
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String($("#response").html()).split(elem[i].id + '=');
                    if (elem[i].id == 'frm1702MX:txtPg1Pt1I9RegisteredName' || elem[i].id == 'frm1702MX:txtPg1Pt1I13MainLine' || elem[i].id == 'frm1702MX:txtPg1Pt1I10RegisteredAddress') {
                        elem[i].value = unescape(fieldVal[1]);
                    }
                    else if (elem[i].id == 'frm1702MX:txtPg1Pt1I12Email') {
                        elem[i].value = unescape(fieldVal[1]);
                    }
                    else if (elem[i].className.indexOf("numbertext") > -1) {
						
                        elem[i].value = typeof (fieldVal[1]) === "undefined" ? "0" : fieldVal[1];
						
                    }
					else if (elem[i].className.indexOf("FinalFlag") > -1) {
                        elem[i].value = typeof (fieldVal[1]) === "undefined" ? "3" : fieldVal[1];
                    }
                    else {
                        elem[i].value = fieldVal[1]; //all select-one and text values		 		
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String($("#response").html()).split(elem[i].id + '=');
                    if (rdoVal[1] == 'true') {
                        elem[i].checked = rdoVal[1];
                        //elem[i].onclick(); dgarfin: commented since it hinders the rest of the elements to load its values 
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String($("#response").html()).split(elem[i].id + '=');
                    if (chkboxVal[1] == 'true') {
                        elem[i].checked = chkboxVal[1];
                    }
					

                }
				
				
                /*dgarfin: temporarily commented until modalAtc popup show/hide	
                if (elem[i].type == 'button' && elem[i].id == 'btnOkPop') {
                	elem[i].onclick();				
                */
            }
        }
        document.getElementById('frm1702MX:txtPg1Pt1I12Email').value = globalEmail;
    }
    function loadXMLWellFormed(loadWhere) {
        try {

            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLFile.AtEndOfStream)
                data = ""
            else {
                var response = document.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug				
            loadWFData(); /*This will load data onto fields*/
            if (response.innerHTML.indexOf("All Rights Reserved BIR 2014.0") >= 0) {
                gIsReadOnly = true;
            }

            if (gIsReadOnly) {
                document.getElementById('frm1702MX:cmdValidate').disabled = true;
                document.getElementById('btnSave').disabled = true;

                callWhenFinalCopy();
            }
            window.setTimeout("$('#loader').hide('blind');", 2000);
        } catch (e) {
            //msg.innerHTML = "Save File not Found."
        } //this will Alert File not Found if it doesn't exist
    }

    function loadWFData() {
        /*This will load data onto fields*/
        var response = document.getElementById("response");
        var elem = document.getElementById('frmMain').elements;
        for (var i = 0; i < elem.length; i++) {
            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&  			
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String(response.innerHTML).split(elem[i].id + '>');
                    // elem[i].value = fieldVal[1]; //all select-one and text values		 
                    if (fieldVal != null && fieldVal.length > 1) {
                        elem[i].value = fieldVal[1].substring(0, fieldVal[1].indexOf("</"));
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String(response.innerHTML).split(elem[i].id + '>');
                    if (rdoVal[1] == 'true') {
                        // elem[i].checked = rdoVal[1];
                        if (rdoVal != null && rdoVal.length > 1) {
                            elem[i].value = rdoVal[1].substring(0, rdoVal[1].indexOf("</"));
                        }
                        //elem[i].onclick(); dgarfin: commented since it hinders the rest of the elements to load its values 
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String(response.innerHTML).split(elem[i].id + '>');
				
                    if (chkboxVal[1] == 'true') {
                        // elem[i].checked = chkboxVal[1];
                        if (chkboxVal != null && chkboxVal.length > 1) {
                            elem[i].value = chkboxVal[1].substring(0, chkboxVal[1].indexOf("</"));
							
                        }
                    }
                }
                /*dgarfin: temporarily commented until modalAtc popup show/hide	
                if (elem[i].type == 'button' && elem[i].id == 'btnOkPop') {
                	elem[i].onclick();				
                }*/
            }
        }
    }

    // if file is already existing
    function loadXML(loadWhere) {
        try {

            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLFile.AtEndOfStream)
                data = "";
            else {
                var response = document.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug				
            loadData(); /*This will load data onto fields*/
            if (response.innerHTML.indexOf("All Rights Reserved BIR 2014.0") >= 0) { 
                gIsReadOnly = true;
            }
            if (gIsReadOnly) {
                document.getElementById('frm1702MX:cmdValidate').disabled = true;
                document.getElementById('btnSave').disabled = true;

                callWhenFinalCopy();
            }
            window.setTimeout("$('#loader').hide('blind');", 2000);
        } catch (e) {
            //msg.innerHTML = "Save File not Found."
        } //this will Alert File not Found if it doesn't exist
    }

    function createEncXMLFileName(subFolder) {
        /// <summary>Creates XML FileName to folder [/IAF_RDO_Copy]</summary>
        /// <param name="subFolder" type="String">folder of saved files.</param>
        /// <returns type="String">xmlFileName</returns>

        var xmlFileName = "";
        var titleTin1 = document.getElementById('frm1702MX:txtPg1Pt1I6TINC1');
        var titleTin2 = document.getElementById('frm1702MX:txtPg1Pt1I6TINC2');
        var titleTin3 = document.getElementById('frm1702MX:txtPg1Pt1I6TINC3');
        var titleBranchCode = document.getElementById('frm1702MX:txtPg1Pt1I6TINC4');
        var titleTPName = document.getElementById('frm1702MX:txtPg1Pt1I9RegisteredName').value;

        //change if there is Quarter option
        var ddlPg1I2Date = document.getElementById("frm1702MX:ddlPg1I2Date");
        var selectedMonth = ddlPg1I2Date.options[ddlPg1I2Date.selectedIndex].value;
        var selectedYear = document.getElementById('frm1702MX:txtPg1I2YearEnd').value;

        var returnPeriod = selectedMonth + selectedYear;

        //xmlFileName = "profile/1702MX-" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + "-" +
        //( (titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').length > 12) ? titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').substring(0,12).toLowerCase() : titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').toLowerCase() ) + 
        //"-" + dtFormatted +
        //".xml"	

        xmlFileName = subFolder + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
  			"-1702MXv2018-" +
  			returnPeriod +
  			".xml"

        fileName = titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
    		"-1702MXv2018-" +
    		returnPeriod +
    		".xml"

        return xmlFileName;
    }

    function createXMLFileName(subFolder) {
