                                   getValAmount('txtPg4Sc3BI13CC'), getValAmount('txtPg4Sc3BI14CC'), getValAmount('txtPg4Sc3BI15CC'),
                                   getValAmount('txtPg4Sc3BI16CC'), getValAmount('txtPg4Sc3BI17CC'), getValAmount('txtPg4Sc3BI18CC'),
                                   getValAmount('txtPg4Sc3BI19CC'), getValAmount('txtPg4Sc3CI20CC'), getValAmount('txtPg4Sc3CI21CC'),
                                   getValAmount('txtPg4Sc3CI22CC'), getValAmount('txtPg4Sc3CI23CC'), getValAmount('txtPg4Sc3CI24CC'), getValAmount('txtPg4Sc3CI25CC'),
                                   getValAmount('txtPg4Sc3CI26CC'), getValAmount('txtPg4Sc3CI27CC'));

        populateCostOfSalesTotal(getValAmount('txtPg4Sc3AI1CD'), getValAmount('txtPg4Sc3AI2CD'), getValAmount('txtPg4Sc3AI3CD'), getValAmount('txtPg4Sc3AI4CD'),
                                 getValAmount('txtPg4Sc3AI5CD'), getValAmount('txtPg4Sc3BI6CD'), getValAmount('txtPg4Sc3BI7CD'), getValAmount('txtPg4Sc3BI8CD'),
                                 getValAmount('txtPg4Sc3BI9CD'), getValAmount('txtPg4Sc3BI10CD'), getValAmount('txtPg4Sc3BI11CD'), getValAmount('txtPg4Sc3BI12CD'),
                                 getValAmount('txtPg4Sc3BI13CD'), getValAmount('txtPg4Sc3BI14CD'), getValAmount('txtPg4Sc3BI15CD'),
                                 getValAmount('txtPg4Sc3BI16CD'), getValAmount('txtPg4Sc3BI17CD'), getValAmount('txtPg4Sc3BI18CD'),
                                 getValAmount('txtPg4Sc3BI19CD'), getValAmount('txtPg4Sc3CI20CD'), getValAmount('txtPg4Sc3CI21CD'),
                                 getValAmount('txtPg4Sc3CI22CD'), getValAmount('txtPg4Sc3CI23CD'), getValAmount('txtPg4Sc3CI24CD'), getValAmount('txtPg4Sc3CI25CD'),
                                 getValAmount('txtPg4Sc3CI26CD'), getValAmount('txtPg4Sc3CI27CD'));
        // Schedule 3A - 3C END

        //Schedule 4


        //modal Page 5 Sched 4		
        var TablePg5Sc4I3 = document.getElementById("modalTablePg5Sc4I3");
        if (getValAmount('txtCtrmodalPg5Sc4I3') > 1) {
            for (x = 0; x < getValAmount('txtCtrmodalPg5Sc4I3') ; x++) {

                populateOtherTaxableIncomeNotSubjectToFinalTaxValue(TablePg5Sc4I3.rows[x].cells[0].children[1].value,
