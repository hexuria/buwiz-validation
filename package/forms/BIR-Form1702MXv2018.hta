            }
        }

        return isValid;
    }
    function validate_nullDescription(param1, param2, paramAlert) {
        var array1 = param1.split(',');
        var array2 = param2.split(',');
        var counter1 = 0;

        var isValid = true;

        if (array1.length > 0) {
            for (var j = 0; j < array1.length; j++) {
                if (NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array1[j]).value)) > 0) {
                    counter1++;
                }
            }
        }

        if (array2.length > 0) {
            for (var i = 0; i < array2.length; i++) {
                // If description is empty and there are amounts with values
                if (($.trim($_Id('frm1702MX:' + array2[i]).value) === '') && (counter1 > 0)) {
                    isValid = false;
                    break;
                }
                    // If description is not empty and there are amounts without values
                else if (($.trim($_Id('frm1702MX:' + array2[i]).value) !== '') && (counter1 === 0)) {
                    isValid = false;
                    break;
                }
            }
        }

        if (!isValid) {
            alert('Please provide complete data on ' + paramAlert + '.\n(Amount cannot be zero [0] if Description is not empty and vice versa).');
        }

        return isValid;
    }

  function validate_nullDescription1(param1, param2, paramAlert) {
        var array1 = param1.split(',');
        var array2 = param2.split(',');
        var counter1 = 0;

        var isValid = true;

        if (array1.length > 0) {
            for (var j = 0; j < array1.length; j++) {
                if (NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array1[j]).value)) > 0) {
                    counter1++;
                }
            }
        }

        if (array2.length > 0) {
            for (var i = 0; i < array2.length; i++) {
                // If description is empty and there are amounts with values
                if (($.trim($_Id('frm1702MX:' + array2[i]).value) === '') && (counter1 > 0)) {
                    isValid = false;
                    break;
                }
                    // If description is not empty and there are amounts without values
                else if (($.trim($_Id('frm1702MX:' + array2[i]).value) !== '') && (counter1 === 0)) {
                    isValid = false;
                    break;
                }
            }
        }

        if (!isValid  && ((totalEX+totalSP )== 0)) {
            alert('Please provide complete data on ' + paramAlert + '.\n(Amount cannot be zero [0] if Description is not empty and vice versa).');
			isValid = false;
        }

        return isValid;
    }

 
	
      function validate_nullDescription2(param1, param2, paramAlert) {
        var array1 = param1.split(',');
        var array2 = param2.split(',');
        var counter1 = 0;

        var isValid = true;

        if (array1.length > 0) {
            for (var j = 0; j < array1.length; j++) {
                if (NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array1[j]).value)) > 0 || NumWithComma(NumWithParenthesis($_Id('frm1702MX:' + array1[j]).value)) > 0.00) {
                    counter1++;
                }
            }
        }

        if (array2.length > 0) {
            for (var i = 0; i < array2.length; i++) {
                // If description is empty and there are amounts with values
      
                 if (($.trim($_Id('frm1702MX:' + array2[i]).value) === '')  && (counter1 > 0)) {
                    isValid = false;
                    break;
                }
                    // If description is not empty and there are amounts without values
                else if (($.trim($_Id('frm1702MX:' + array2[i]).value) !== '') &&($.trim($_Id('frm1702MX:' + array2[i]).value) !== '0') &&  ($.trim($_Id('frm1702MX:' + array2[i]).value) !== 0 )&& (counter1 === 0)) {
                 
					isValid = false;
                    break;
                }

            }
        }



        if (!isValid) {
            alert('Please provide complete data on ' + paramAlert + '.\n(Amount cannot be zero [0] if Description is not empty and vice versa).');
        }

        return isValid;
    }


