    function AddrowChecking_ModalTable(modalTable, paramFunction, init) {
        var str = "";
        var count = 0;
        var str2 = 0;
        var table = document.getElementById(modalTable);
        var numRows = document.getElementById(modalTable).rows.length;
        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if (init == 0) {
                str2 = table.rows[x].cells[4].children[0].value;
                if ($.trim(str) == "" || str2 == 0) {
                    count += 1;
                }
            }
            else if (init == 1) {
                str2 = table.rows[x].cells[1].children[0].value;
                if ($.trim(str) == "" || str2 == 0) {
                    count += 1;
                }
            }
        }
        if (count != 0) {
            alert("Please fill up Description and Amount for A or B or C before you can add");
        }
        else if (count == 0) {
            paramFunction();
        }

    }
