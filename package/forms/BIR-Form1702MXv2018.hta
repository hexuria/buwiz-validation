    function computePg2Pt5I44() {
        var item39 = NumWithComma(NumWithParenthesis($_Id("frm1702MX:txtPg2Pt5I39CD").value));

        if (item39 >= 0) {
            getSum('txtPg2Pt5I43', 'txtPg2Pt5I44,txtPg1Pt2I21TotalAmount');
        }
        else {
            getSum('txtPg2Pt5I44,txtPg1Pt2I21TotalAmount');
        }

        computePg1Pt2I21();
    }

