    <form id="frmMain" name="frmMain">
    <div id="container">
        <div id="wrapper" style="margin: 0 auto; position: relative; width: 826px;">
            <table class="frm1702MX" style="width: 826px; margin: 0px auto; background-image: url(../img/frmbg.png); background-repeat: repeat-x; border: 0;">
                <tr>
                    <td>
                        <div id="formPaper">
                            <div id="containerPage">
                                <div id="mainPages">
                                    <div id="Page1Content" style="display: block; width: 100%;">
										<table class="frm1702MX">
											<tr style="background-color: white;">
												<td width="300" valign="bottom">
												    <p><img src="../img/bcs_new.png" width="80" /> </p>
												</td>
												<td>
												    <p><img src="../img/header_logo.png" width="210" height="50px" /> </p>
												</td>
											</tr>
										</table>
										<div style="border: solid 2px black;">
											<table class="frm1702MX">
												<tr>
													<td style="text-align: center; width: 15%; border-right: solid 1px black;">
														<span class="FormHeader2">BIR Form No.<br />
														</span><span class="FormHeader1" style="font-weight: bold;">1702-MX</span><br />
														<span class="FormHeader2">January 2018 (ENCS)</span><br />
														<span class="FormHeader2" style="font-weight: bold;">Page 1</span>
													</td>
													<td style="text-align: center; border-right: solid 1px black; width: 55%;">
														<span class="FormHeader1" style="font-weight: bold;">Annual Income Tax Return</span><br />
														<span class="FormHeader2" style="font-weight: bold;">Corporation, Partnership and Other Non-Individual<br />
															with MIXED Income Subject to Multiple Income Tax Rates or<br />
															with Income Subject to SPECIAL/PREFERENTIAL RATE</span><br />
														<span class="FormHeader4" style="font-style: italic;">Enter all required information in CAPITAL LETTERS using BLACK ink. Mark applicable boxes with an “X”.<br />
															Two copies MUST be filed with the BIR and one held by the taxpayer.</span>
													</td>
													<td style="text-align: right;">
														<!--<img style="height:35px;" src="http://220.5.13.161:8080/efps-war/page?pageId=1702-MX06/13P1" alt="barcode" />-->
														<img src="../img/1702MXv2018_BarCode/1v2018.png" style="width: 250px; height: 70px;" alt="Barcode 1" />
														1702-MX 01/18ENCS P1
													</td>
												</tr>
											</table>
											<table class="tblForm frm1702MX">
												<tr>
													<td style="vertical-align: top; border-top: solid 1px black; border-right: solid 1px black;">
														<table class="RowSubTable frm1702MX">
															<tr style="height: 20px;">
																<td style="width: 15px; padding-left: 5px;">
																	<span class="ContentBold">1</span>
																</td>
																<td>For
																</td>
																<td>
																	<input id="frm1702MX:rdoPg1I1Calendar" name="frm1702MX:rdoPg1I1" type="radio" class="styled"
																		checked="checked" value="C" onclick="checkFilingYear();" />
																	<label for="frm1702MX:rdoPg1I1Calendar" class="small">
																		Calendar</label>
																</td>
																<td>
																	<input id="frm1702MX:rdoPg1I1Fiscal" name="frm1702MX:rdoPg1I1" type="radio" class="styled"
																		value="F" onclick="checkFilingYear();" />
																	<label for="frm1702MX:rdoPg1I1Fiscal" class="small">
																		Fiscal</label>
																</td>
															</tr>
															<tr style="height: 20px;">
																<td style="width: 15px; vertical-align: top; padding-left: 5px;" rowspan="2">
																	<span class="ContentBold">2</span>
																</td>
																<td colspan="3">
																	<span class="small">Year Ended (MM/20YY)</span>
																</td>
															</tr>
															<tr>
																<td colspan="3" style="vertical-align: top;">
																	<select id="frm1702MX:ddlPg1I2Date" name="frm1702MX:ddlPg1I2Date"
																		onchange="validateYearEnd();">
																		<option value=""></option>
																		<option value="01">01</option>
																		<option value="02">02</option>
																		<option value="03">03</option>
																		<option value="04">04</option>
																		<option value="05">05</option>
																		<option value="06">06</option>
																		<option value="07">07</option>
																		<option value="08">08</option>
																		<option value="09">09</option>
																		<option value="10">10</option>
																		<option value="11">11</option>
																		<option selected="selected" value="12">12</option>
																	</select>
																	<span class="mediumBold">/20</span>
																	<input id="frm1702MX:txtPg1I2YearEnd" maxlength="2" name="frm1702MX:txtPg1I2YearEnd"
																		size="1" type="text" onkeypress="return wholenumber(this, event)" onblur="validateYearEnd();" />
																</td>
															</tr>
														</table>
													</td>
													<td style="vertical-align: top; border-top: solid 1px black; border-right: solid 1px black;">
														<table class="RowSubTable frm1702MX">
															<tr>
																<td style="padding-left: 5px;" style="height: 20px;" colspan="2" class="Content">
																	<span class="ContentBold">3</span> <span class="small">Amended Return?</span>
																</td>
															</tr>
															<tr>
																<td>
																	<input id="frm1702MX:rdoPg1I3AmendedYes" name="frm1702MX:rdoPg1I3Amended" type="radio"
																		class="styled" value="Y" onclick="checkFilingYear();" />
																	<label for="frm1702MX:rdoPg1I3AmendedYes" class="medium">
																		Yes</label>
																</td>
																<td>
																	<input checked="checked" id="frm1702MX:rdoPg1I3AmendedNo" name="frm1702MX:rdoPg1I3Amended"
																		type="radio" class="styled" value="N" onclick="checkFilingYear();" />
																	<label for="frm1702MX:rdoPg1I3AmendedNo" class="medium">
																		No</label>
																</td>
															</tr>
														</table>
													</td>
													<td style="vertical-align: top; border-top: solid 1px black; border-right: solid 1px black;">
														<table class="RowSubTable frm1702MX">
															<tr>
																<td style="padding-left: 5px;" colspan="2" class="Content">
																	<span class="ContentBold">4</span> <span class="small">Short Period Return?</span>
																</td>
															</tr>
															<tr>
																<td>
																	<input id="frm1702MX:rdoPg1I4ShortPeriodYes" name="frm1702MX:rdoPg1I4ShortPeriod"
																		type="radio" class="styled" value="Y" onclick="displayShortPeriodMessage();" />
																	<label for="frm1702MX:rdoPg1I4ShortPeriodYes" class="medium">
																		Yes</label>
																</td>
																<td>
																	<input checked="checked" id="frm1702MX:rdoPg1I4ShortPeriodNo" name="frm1702MX:rdoPg1I4ShortPeriod"
																		type="radio" class="styled" value="N" onclick="checkFilingYear();" />
																	<label for="frm1702MX:rdoPg1I4ShortPeriodNo" class="medium">
																		No</label>
																</td>
															</tr>
														</table>
													</td>
													<td style="vertical-align: top; border-top: solid 1px black;">
														<table class="RowSubTable frm1702MX">
															<tr>
																<td style="width: 15px; vertical-align: top; text-align: center;" rowspan="3" class="Content">
																	<span class="ContentBold">5</span>
																</td>
																<td colspan="2">
																	<span class="small">Alphanumeric Tax Code (ATC)</span>
																</td>
															</tr>
															<tr>
																<td>
																	<label for="frm1702MX:chkPg1I5ATCR1">
																		IC 055 – Minimum Corporate Income Tax (MCIT)</label>
																</td>
																<td>
																	<input id="frm1702MX:chkPg1I5ATCR1" name="frm1702MX:chkPg1I5ATC" value="IC055" type="radio"
																		class="styled" onclick="checkDateOfIncorporation();" onblur="checkDateOfIncorporation();" />
																</td>
															</tr>
															<tr>
																<td>
