    function checkNullRow_OnClick_modalTablePg2MScDI17i(attachNum) {
        params = "txtPg2" + attachNum + "ScDI17iother,txtPg2" + attachNum + "ScDI25";
        buttonModalID = "btnModalPg2" + attachNum + "ScDI17i";

        if ((typeof (main_modalTablePg2MScDI17i_Col1[attachNum]) && typeof (main_modalTablePg2MScDI17i_Col2[attachNum])) === "undefined") {
            main_modalTablePg2MScDI17i_Col1[attachNum] = [];
            main_modalTablePg2MScDI17i_Col2[attachNum] = [];
        }

        var str = "";
        var str2 = 0;
        var array = params.split(",");
		
        if (main_modalTablePg2MScDI17i_Col1[attachNum].length > 1) {
            openDialog2("modalDivPg2" + attachNum + "ScDI17i");
            Load_modalTablePg2MScDI17i(attachNum);
        }
        else if (main_modalTablePg2MScDI17i_Col1[attachNum].length <= 1) {
            str = document.getElementById("frm1702MX:" + array[0]).value;
            str2 = document.getElementById("frm1702MX:" + array[1]).value;
			
            if ($.trim(str) != "" && str2 != 0) {
                document.getElementById("frm1702MX:" + buttonModalID).disabled = false;
                //disableField(params);

                main_modalTablePg2MScDI17i_Col1[attachNum][0] = document.getElementById("frm1702MX:" + array[0]).value;
                //alert(main_modalTablePg2MScDI17i_Col1[attachNum][0]);

                main_modalTablePg2MScDI17i_Col2[attachNum][0] = document.getElementById("frm1702MX:" + array[1]).value;
                //alert(main_modalTablePg2MScDI17i_Col2[attachNum][0]);

                //setValuesTo(array[0], "SubTotal");
                //setValuesTo(array[0], "OTHERS");
				
                openDialog2("modalDivPg2" + attachNum + "ScDI17i");
                Load_modalTablePg2MScDI17i(attachNum);
                //Save_modalTablePg2MScDI17i(attachNum);
            }
            else if ($.trim(str) == "") {
                document.getElementById("frm1702MX:" + buttonModalID).disabled = true;
                //alert("User must fill item 4 to add modal");
            }
        }
    }

    function Save_modalTablePg2MScDI17i(attachNum) {
        var str = "";
        var count = 0;
        numRows = document.getElementById("modalTablePg2" + attachNum + "ScDI17i").rows.length;
        table = document.getElementById("modalTablePg2" + attachNum + "ScDI17i");
		
        //main_modalTablePg2MScDI17i_Col1[attachNum] = new Array();
        main_modalTablePg2MScDI17i_Col1[attachNum] = [];
        //main_modalTablePg2MScDI17i_Col2[attachNum] = new Array();
        main_modalTablePg2MScDI17i_Col2[attachNum] = [];

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                main_modalTablePg2MScDI17i_Col1[attachNum].push(table.rows[x].cells[0].children[1].value);
                main_modalTablePg2MScDI17i_Col2[attachNum].push(table.rows[x].cells[1].children[0].value);
                count += 1;
            }
        }

        if (count == 0) {
            enableField("txtPg2" + attachNum + "ScDI17iother,txtPg2" + attachNum + "ScDI25");
            disableField("btnModalPg2" + attachNum + "ScDI17i");
            setValuesTo("txtPg2" + attachNum + "ScDI17iother", "");
            setValuesTo("txtPg2" + attachNum + "ScDI25", "0");
        }
        else if (count == 1) {
            enableField("txtPg2" + attachNum + "ScDI17iother,txtPg2" + attachNum + "ScDI25");
            //disableField('btnModalPg5Sc4I3');

            setValuesTo("txtPg2" + attachNum + "ScDI17iother", table.rows[0].cells[0].children[1].value);
            setValuesTo("txtPg2" + attachNum + "ScDI25", table.rows[0].cells[1].children[0].value);
            main_modalTablePg2MScDI17i_Col1[attachNum] = new Array();
            main_modalTablePg2MScDI17i_Col2[attachNum] = new Array();


        }
        else {
            Load_modalTablePg2MScDI17i(attachNum);
            document.getElementById("frm1702MX:txtPg2" + attachNum + "ScDI17iother").value = 'OTHERS';
			document.getElementById("frm1702MX:txtPg2" + attachNum + "ScDI25").value = document.getElementById("frm1702MX:txtPg2" + attachNum + "ScDI17i_SubTotal").value;
			
			disableField("txtPg2" + attachNum + "ScDI17iother,txtPg2" + attachNum + "ScDI25");

        }
	
        $_Id("frm1702MX:txt" + attachNum + "CtrPg2MScDI17i").value = count;
    	
		//alert("Saved!");
    }

