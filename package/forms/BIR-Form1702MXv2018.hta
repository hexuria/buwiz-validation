        $("#tempModalDivPg9Sc14II").html(function () {
            return $("#mainModalDivPg9Sc14II").html();
        });


    }
    function Cancel_modalDivPg9Sc14II() {
        $("#tempModalDivPg9Sc14II").html(function () {
            return $("#mainModalDivPg9Sc14II").html();
        });

    }
