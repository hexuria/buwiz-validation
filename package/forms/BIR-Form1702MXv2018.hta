        populateOtherTaxableIncomeNotSubjectedToFinalTaxRegular(getValAmount('txtPg5Sc4I1CC'), getValAmount('txtPg5Sc4I2CC'),
                                                                (getValAmount('txtCtrmodalPg5Sc4I3') > 1) ? 0 : getValAmount('txtPg5Sc4I3CC'), getValAmount('txtPg5Sc4I4CC'));

        populateOtherTaxableIncomeNotSubjectedToFinalTaxTotal(getValAmount('txtPg5Sc4I1CD'), getValAmount('txtPg5Sc4I2CD'),
                                                              (getValAmount('txtCtrmodalPg5Sc4I3') > 1) ? 0 : getValAmount('txtPg5Sc4I3CC'), getValAmount('txtPg5Sc4I4CD'));


        //Schedule 5
        populateExemptOrdinaryAllowableItemizedDeductions();

        populateSpecialOrdinaryAllowableItemizedDeductions();

        populateRegularOrdinaryAllowableItemizedDeductions();

        populateTotalOrdinaryAllowableItemizedDeductions(getValAmount('txtPg5Sc5I1CD'),
                                                         getValAmount('txtPg5Sc5I2CD'), getValAmount('txtPg5Sc5I3CD'),
                                                         (getValAmount('txtCtrmodalPg5Sc5I4') > 1) ? 0 : getValAmount('txtPg5Sc5I4CD'), getValAmount('txtPg5Sc5I5CD'), getValAmount('txtPg5Sc5I6CD'),
                                                         getValAmount('txtPg5Sc5I7CD'), getValAmount('txtPg5Sc5I8CD'), getValAmount('txtPg5Sc5I8CD'),
                                                         getValAmount('txtPg5Sc5I9CD'), getValAmount('txtPg5Sc5I10CD'), getValAmount('txtPg5Sc5I11CD'), getValAmount('txtPg5Sc5I12CD'),
                                                         getValAmount('txtPg5Sc5I13CD'), getValAmount('txtPg5Sc5I14CD'), getValAmount('txtPg5Sc5I15CD'), getValAmount('txtPg5Sc5I16CD'),
                                                         getValAmount('txtPg5Sc5I17CD'), getValAmount('txtPg5Sc5I18CD'), getValAmount('txtPg5Sc5I19CD'), getValAmount('txtPg5Sc5I20CD'),
                                                         getValAmount('txtPg5Sc5I21CD'), getValAmount('txtPg5Sc5I22CD'), getValAmount('txtPg5Sc5I23CD'),
                                                         getValAmount('txtPg5Sc5I24CD'), getValAmount('txtPg5Sc5I25CD'), getValAmount('txtPg5Sc5I26CD'),
                                                         getValAmount('txtPg5Sc5I27CD'), getValAmount('txtPg5Sc5I28CD'), getValAmount('txtPg5Sc5I29CD'),
                                                         getValAmount('txtPg5Sc5I30CD'), getValAmount('txtPg5Sc5I31CD'), getValAmount('txtPg5Sc5I32CD'),
                                                         getValAmount('txtPg5Sc5I33CD'), getValAmount('txtPg5Sc5I34CD'), getValAmount('txtPg5Sc5I35CD'),
                                                         getValAmount('txtPg6Sc5I36CD'), getValAmount('txtPg6Sc5I37CD'), getValAmount('txtPg6Sc5I38CD'),
                                                         (getValAmount('txtCtrmodalPg6Sc5I39') > 1) ? 0 : getValAmount('txtPg6Sc5I39CD'));

        //modal Page 5 Sched 5	Item 4
        var TablePg5Sc5I4 = document.getElementById("modalTablePg5Sc5I4");

        if (getValAmount('txtCtrmodalPg5Sc5I4') > 1) {
            for (x = 0; x < getValAmount('txtCtrmodalPg5Sc5I4') ; x++) {

                populateListAmortizations(TablePg5Sc5I4.rows[x].cells[0].children[1].value,
                                          NumWithComma(NumWithParenthesis(TablePg5Sc5I4.rows[x].cells[1].children[0].value)),
