                                          NumWithComma(NumWithParenthesis(TablePg5Sc5I4.rows[x].cells[4].children[0].value)));
            }
        }
        //iterating row Item 4 

        //modal Page 6 Sched 5		Item 39
        var TablePg5Sc5I39 = document.getElementById("modalTablePg6Sc5I39");

        if (getValAmount('txtCtrmodalPg6Sc5I39') > 1) {
            for (x = 0; x < getValAmount('txtCtrmodalPg6Sc5I39') ; x++) {

                populateListOtherOrdinaryItemizedDeductions(TablePg5Sc5I39.rows[x].cells[0].children[1].value,
