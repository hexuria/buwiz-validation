	function computePg2Sch2Items(){
			getSum('txtPg2Sc2Itm8A,txtPg2Sc2Itm9A','txtPg2Sc2It11A');
			getSum('txtPg2Sc2Itm8B,txtPg2Sc2Itm9B,txtPg2Sc2It10B','txtPg2Sc2It11B');
			getSum('txtPg2Sc2It11A,txtPg2Sc2It11B,txtPg2Sc2It11C','txtPg2Sc2It11D');
			getDifference('txtPg2Sc2Itm7A','txtPg2Sc2It11A','txtPg2Sc2It13A');
			getDifference('txtPg2Sc2Itm7B','txtPg2Sc2It11B','txtPg2Sc2It13B');
			getDifference('txtPg2Sc2Itm7D','txtPg2Sc2It11D','txtPg2Sc2It13D');
		}
	function computePg2Sc2It8to10() {
		getSum('txtPg2Sc2Itm8A,txtPg2Sc2Itm9A','txtPg2Sc2It11A');
		getSum('txtPg2Sc2Itm8B,txtPg2Sc2Itm9B,txtPg2Sc2It10B','txtPg2Sc2It11B');
		getSum('txtPg2Sc2Itm8C,txtPg2Sc2Itm9C,txtPg2Sc2It10C','txtPg2Sc2It11C');
