				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5")).prop('disabled', true);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5")).prop('disabled', true);
                $(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5")).prop('disabled', true);
                $(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxDue5")).prop('disabled', true);
				$('#btnPg2Pt5'+ schd + 'More').prop('disabled', false);
            }

            d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxDue5").value = formatCurrency(NumWithComma(d.getElementById("Pg2Pt5"+ schd + "SubTotal").value).toFixed(0));
			totTaxDueComp(schd);

