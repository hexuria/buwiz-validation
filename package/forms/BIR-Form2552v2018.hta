<script>

    //after xml populate

    //on validation click
    function validateAll() {
        //empty mandatory
		if (!checkDatePage1()) return false;
		
        if (d.getElementById('frm2552:txtPg1I5RDO').value === "000") { alert("Please enter a valid RDO Code on Page 1 Item 5."); return false; }
        if (!checkMandatory("frm2552:txtPg1Pt1I6Name", "Name field on Page 1 Item 6 is required.")) return false;
        if (!checkMandatory("frm2552:txtPg1Pt1I7RegisteredAddress", "Registered Address field on Page 1 Item 7 is required.")) return false;
        if (!checkMandatory("frm2552:txPg1I7ZipCode", "Zip Code field on Page 1 Item 7A is required.")) return false;
        if (!checkMandatory("frm2552:txtPg1Pt1I8ContactNumber", "Contact Number field on Page 1 Item 8 is required.")) return false;
        if (!checkMandatory("frm2552:txtPg1Pt1I9Email", "E-mail address on page 1 item 9 is required.")) return false;

		if (d.getElementById('frm2552:rdoPg1I10TaxReliefYes').checked == true &&
			d.getElementById('frm2552:txtPg1Pt1I10TaxReliefSpec').value == ''){
			alert("Specify Tax Relief field on Page 1 Item 10A is required."); 
			return false;
		}

		if (!kindOfTransaction()){
			alert("Select an option for Page 1 Item 11 Kind of Transaction.");
			return false;
		}
		else if ((d.getElementById('frm2552:rdoPg1I11TransactionPrimary').checked == true || 
			d.getElementById('frm2552:rdoPg1I11TransactionSecondary').checked == true) &&
			(d.getElementById('frm2552:txtPg1Pt1I12NumOfShare').value == '' ||
			d.getElementById('frm2552:txtPg1Pt1I12TotShare').value == '')){
			alert("Page 1 Item 12A and 12B cannot not be empty."); 
			return false;
		}
		
		if (NumWithComma(d.getElementById('frm2552:txtPg1P2I20TotTaxStllDueOvrPmnt').value) < 0 &&
			d.getElementById('frm2552:rdoPg1OverpaymentRefund').checked == false &&
			d.getElementById('frm2552:rdoPg1OverpaymentTaxCredCert').checked == false){
			alert("Select an Overpayment option in Page 1 after Item 25."); 
			return false;
		}

		if (!checkPartIVFields()) return false;
		if (!checkPartVSchFields('1')) return false;
		if (!checkPartVSchFields('2')) return false;
		if (!checkPartVSchFields('3')) return false;
		if (!checkPartVIFields()) return false;

        return true;
    }

	function checkDatePage1(){
		var dateOkay = false;
        
        if (d.getElementById('frm2552:txtPg1I1Month').value == '00'){
			alert("Month field on Page 1 Item 1 is required.");
			dateOkay = false;
			return false;
		}
		else dateOkay = true;
		
		if (!checkMandatory("frm2552:txtPg1I1Day", "Day field on Page 1 Item 1 is required.")){
			dateOkay = false;
			return false;
		}
		else dateOkay = true;
		
		if (!checkMandatory("frm2552:txtPg1I1Year", "Year field on Page 1 Item 1 is required.")){
			dateOkay = false;
			return false;
		}
		else dateOkay = true;

		if (dateOkay && !dateInPage1Item1()) return false;
		
		return true;
	}


