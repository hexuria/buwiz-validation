	function enablePartIVRow(element){
		var index = element.name.substring(17, 18);
		
		var transaction = d.getElementById('frm2552:txtPg2P4I' +index +'TransClass').value;
		var amount = NumWithComma(d.getElementById('frm2552:txtPg2P4I' +index +'Amount').value) * 1;
		
		if (transaction != '' && amount != 0.00 && index != 5){
			index++;
			d.getElementById('frm2552:txtPg2P4I' +index +'TransClass').disabled = false;
			d.getElementById('frm2552:txtPg2P4I' +index +'Amount').disabled = false;
			d.getElementById('frm2552:txtPg2P4I' +index +'TransClass').focus();
		}
	}

	function enablePartVIRow(element){
		var elemLength = element.name.length;
		var row = element.name.substring(elemLength-1, elemLength);

		var date = d.getElementById('frm2552:txtPg2Pt6Date' +row).value;
		var seller = d.getElementById('frm2552:txtPg2Pt6Seller' +row).value;
		var buyer = d.getElementById('frm2552:txtPg2Pt6Buyer' +row).value;
		var issueCorp = d.getElementById('frm2552:txtPg2Pt6Corp' +row).value;
		var numOfShare = NumWithComma(d.getElementById('frm2552:txtPg2Pt6NumShares' +row).value) * 1;
		
		if (date != '' && seller != '' && buyer != '' && issueCorp != '' && numOfShare != 0.00 && row != 5){
			row++;
			d.getElementById('frm2552:txtPg2Pt6Date' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt6Seller' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt6Buyer' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt6Corp' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt6NumShares' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt6Date' +row).focus();
		}
	}

	$(document).ready(function(){
		$('.schedOne').blur(function(){
            Check_Pg2Pt5AddMore('Sch1');
        })

		$('.schedTwo').blur(function(){
            Check_Pg2Pt5AddMore('Sch2');
        })	

		$('.schedThree').blur(function(){
            Check_Pg2Pt5AddMore('Sch3');
        })

		$('.partIV').blur(function(){
            enablePartIVRow(this);
        })

		$('.checkRowPartFive').blur(function(){
            enablePageTwoScheduleRow(this);
        })

		$('.partVI').blur(function(){
            enablePartVIRow(this);
        })
	})

</script>

<!--to eFPS-->
<script>
    function submitOnline(){
        if(confirm("You will now be redirected to eFPS Online.")){
            submitToEFPS();
        }
    }

    function checkconnection() {
        var status = navigator.onLine;
        if (status) {
            return true;
        } else {
            return false;
        }
    }

    function submitToEFPS() {

        if (checkconnection()) {
            var formVersion = Form2200C.version;
            function getValue(stringId) {
                
                var alpha = document.getElementById(stringId).value;
                
                alpha = alpha.replace(/&/g, '&amp;');
                alpha = alpha.replace(/</g, '&lt;');
                alpha = alpha.replace(/>/g, '&gt;');
                
                return alpha;
                //if (!document.getElementById(stringId)) {
                //  console.error(stringId);
                //}
            }

            function convertDateXML(element) {
                //alert(d.getElementById('frm2552:'+element).value);
                var date = '';
                var dateSplit = d.getElementById('frm2552:' + element).value.split('/');
                var date = dateSplit[2] + '-' + dateSplit[0] + '-' + dateSplit[1];

                return date;
            }

            function getAmount(stringId) {
                return ((document.getElementById(stringId).value.indexOf(')') > 0 ? "-" : "") + document.getElementById(stringId).value.replace(/[\(\)\,]/gi, "")) * 1;
                //if (!document.getElementById(stringId)) {
                //  console.error(stringId);
                //  }
            }

            function fixAmount(elemValue) {
                return ((elemValue.indexOf(')') > 0 ? "-" : "") + elemValue.replace(/[\(\)\,]/gi, "")) * 1;
            }

            function returnPeriod() {
                var yyyyR = "20" + d.getElementById('frm2552:txtPg1I1Year').value;
                var mmR = (d.getElementById('frm2552:txtPg1I1Month').value.toString());
                var ddR = new Date(yyyyR, mmR, 0).getDate();
                var returnPeriodFormat = yyyyR + "-" + (mmR) + "-" + ddR;

