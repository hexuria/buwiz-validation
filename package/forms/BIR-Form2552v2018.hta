            //loadXMLWellFormed() to mimic loadXML()
            //loadWFData()  to mimic loadData()
            //This is the original XML formatter per row with <div> </div> separator                    
            for (var i = 0; i < elem.length; i++)
            /*{
            if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {      
            if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    
            //With this well-formed XML, we need to validate field content if it has '>'  and '<'
            //if so, then replace it with : '&gt;' and '&lt;' respectively.                         
            if (elem[i].value.indexOf('>') >= 0 && elem[i].value.indexOf('<') < 0) {
            elemVal = elem[i].value.replace(/[>]+/g, '&gt;');
            } 
            if (elem[i].value.indexOf('<') >= 0 && elem[i].value.indexOf('>') < 0) {
            elemVal = elem[i].value.replace(/[<]+/g, '&lt;');
            } 
            if (elem[i].value.indexOf('<') >= 0 && elem[i].value.indexOf('>') >= 0) {
            elemVal = elem[i].value.replace(/[<]+/g, '&lt;');
            elemVal = elemVal.replace(/[>]+/g, '&gt;');
            }                           
            else {
            elemVal = elem[i].value;
            }                       
                        
            allXML += "<"+elem[i].id+">"+elemVal+"</"+elem[i].id+">"+tab; //all select-one and text values
            }
            if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
            allXML += "<"+elem[i].id+">"+elem[i].checked+"</"+elem[i].id+">"+tab; //all radio and checkbox values           
            }                           
            }
            //END: Dev Note         
            }*/
            {
                if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
                    if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                        if (elem[i].id == 'frm2552:txtPg1Pt1I6Name') {
                            allXML += "<div>" + elem[i].id + "=" + escape(elem[i].value) + elem[i].id + "=</div>" + tab;
                            p3TPName = escape(elem[i].value);
                        }
                        else if (elem[i].id == 'frm2552:txtPg1Pt1I13MainLine') {
                            allXML += "<div>" + elem[i].id + "=" + escape(elem[i].value) + elem[i].id + "=</div>" + tab;
                            p3TPLineBus = escape(elem[i].value);
                        }
                        else if (elem[i].id == 'frm2552:txtPg1Pt1I7RegisteredAddress') {
                            allXML += "<div>" + elem[i].id + "=" + escape(elem[i].value) + elem[i].id + "=</div>" + tab;
                            p3TPAddress = escape(elem[i].value);
                        }
                        
                        //TIN, branchCode, rdoCode, TPClass, LOB, TPName, TelNo, Addr, Zip
                        else if (elem[i].id == 'frm2552:txtPg1Pt1I8ContactNumber') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTelNum = elem[i].value;
                        } else if (elem[i].id == 'frm2552:txtPg1TIN1') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN1 = elem[i].value;
                        } else if (elem[i].id == 'frm2552:txtPg1TIN2') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN2 = elem[i].value;
                        } else if (elem[i].id == 'frm2552:txtPg1TIN3') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN3 = elem[i].value;
                        } else if (elem[i].id == 'frm2552:txtPg1TIN4') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPBranchCode = elem[i].value;
                        }
                        else if (elem[i].id == 'frm2552:txtPg1I5RDO') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPRDOCode = elem[i].value;
                        }
                        else if (elem[i].id == 'frm2552:txPg1I7ZipCode') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPZip = elem[i].value;
                            //alert("3==" + p3TPZip);
                        }
                        else if (elem[i].maxLength == '12' || elem[i].maxLength == '15') {
                            var elemValue = elem[i].value;
                               
                            if (elem[i].value.toString().indexOf('(') != -1 && elem[i].value.toString().indexOf(')') != -1) {
                                elemValue = NumWithParenthesis(elemValue);
                                    
                                if (elem[i].value.toString().indexOf(',') != -1) {
                                elemValue = elemValue.replace(/,/g, '');
                                }
                            }
                            else if (elem[i].value.toString().indexOf(',') != -1) {
                                elemValue = elemValue.replace(/,/g, '');
                            }

                            if (elem[i].id == 'frm2552:txtPg1Pt2I21AddPenalty') {
                                p3Compromise = elemValue;
                            } else if (elem[i].id == 'frm2552:txtPg1Pt2I20TotalIncome') {
                                p3BasicTax = elemValue;
                            } else if (elem[i].id == 'frm2552:txtPg1Pt2I21AddPenalty') {
                                p3TotalPenalties = elemValue;
                            } else if (elem[i].id == 'frm2552:txtPg1Pt2I22TotalAmount') {
                                p3TotalAmountPayable = elemValue;
                            } else if (elem[i].id == 'frm2552:txtPg2Pt4I31NetSales') {
                                //alert("p3GrossSales >>> " + elemValue + " \r\n p3BasicTax >>> " + p3BasicTax);
                                p3GrossSales = elemValue;
                            }

                            allXML += "<div>" + elem[i].id + "=" + elemValue + elem[i].id + "=</div>" + tab; //all numeric text values
                        }
                        else {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab; //all select-one and text values
                        }
                    }
                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        allXML += "<div>" + elem[i].id + "=" + elem[i].checked + elem[i].id + "=</div>" + tab; //all radio and checkbox values          
                        
                        if (d.getElementById('frm2552:rdoPg1I2AmendedYes').checked == true) {
                            p3IsAmended = "Yes";
                        } else if (d.getElementById('frm2552:rdoPg1I2AmendedNo').checked == true) {
                            p3IsAmended = "No";
                        }
                    }
                }
            }
            p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;
            /*--------------------- follow this format for parsing --------------------------- */

            if (submit) {
                allXML += tab + d.getElementById('xmlClose').innerHTML + "0";
            } else {
                allXML += tab + d.getElementById('xmlClose').innerHTML;
            }

            //Phase 3: This 'savefile' will be uploaded to IAF Infra for DI processing
            savedReturn = allXML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (submit == false) {
                alert('BIR Form saved successfully as : ' + xmlFileName);
            }
        }
        return true;
    }

    function validate() {

        if (validateAll()) {
            alert("Validation successful. Click on Edit if you wish to modify your entries.");
            getDisabledText();
            disableAllControl();
            document.getElementById("frm2552:btnEdit").disabled = false;
            document.getElementById("btnUpload").disabled = false;
            document.getElementById("frm2552:btnFinalCopy").disabled = false;
            document.getElementById("frm2552:btnValidate").disabled = true;
            document.getElementById("frm2552:btnPrevPage").disabled = false;
            document.getElementById("frm2552:btnNextPage").disabled = false;
            document.getElementById("btnSave").disabled = false;
            document.getElementById("btnPrint").disabled = false;
            document.getElementById("btnCancelSubmit").disabled = false;
            document.getElementById("CloseGuidlinesPage").disabled = false;    
            d.getElementById('mnuPrint').disabled = false;
            document.getElementById("ebironline").disabled = false;
            document.getElementById("efps").disabled = false;
            //document.onmouseup();
            return;
        }
        else {
            document.getElementById("frm2552:btnEdit").disabled = true;
            document.getElementById("btnUpload").disabled = true;
            document.getElementById("frm2552:btnFinalCopy").disabled = true;
            document.getElementById("btnPrint").disabled = true;
            d.getElementById('mnuPrint').disabled = true;
        };
        
    }

    function initialValidateBeforeSave() {
        //validation here
        //return true to save
		if (!checkDatePage1()) return false;
		
        if (d.getElementById('frm2552:rdoPg1Pt1I5RDO').value === "000") { alert("Please enter a valid RDO Code on Item 7."); return false; }
        if (!checkMandatory("frm2552:txtPg1Pt1I6Name", "Please enter a valid name on Page 1 Item 8")) return false;
        if (!checkMandatory("frm2552:txtPg1Pt1I7RegisteredAddress", "Please enter a valid Registered Address on Page 1 Item 9.")) return false;
        if (!checkMandatory("frm2552:txtPg1Pt1I8ContactNumber", "Please enter a valid Contact Number on Page 1 Item 11")) return false;

        return true;
    }

    //topNav
    $(document).ready(function () {

        $("ul.subnav").parent().append("<span></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)  
        $("ul.topnav li span").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
        $("ul.topnav .toplevel").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
    });


    function createXMLProfileName() {
        try {
            var xmlFileName = "";

            var titleTin1 = d.getElementById('frm2552:txtPg1TIN1');
            var titleTin2 = d.getElementById('frm2552:txtPg1TIN2');
            var titleTin3 = d.getElementById('frm2552:txtPg1TIN3');
            var titleBranchCode = d.getElementById('frm2552:txtPg1TIN4');
            var titleTPName = d.getElementById('frm2552:txtPg1Pt1I6Name');
            var formType = "2552v2018";

            xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";

            return xmlFileName;
        } catch (e) {
            alert('Exception : ' + e.description);
        }
    }

    function saveXMLProfile(isFinalCopy) {
        if (gIsReadOnly == false) {
            var xmlFileName = createXMLProfileName();

            msg.innerHTML = 'Generating File...';
            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFile = fileSys.CreateTextFile(xmlFileName); //(saveWhere);

            var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break            

            allXML += "<div>fn=" + escape(d.getElementById('frm2552:txtPg1Pt1I6Name').value) + "fn=</div>" + tab;
            allXML += "<div>tin2=" + d.getElementById('frm2552:txtPg1TIN2').value + "tin2=</div>" + tab;
            allXML += "<div>tin3=" + d.getElementById('frm2552:txtPg1TIN3').value + "tin3=</div>" + tab;
            allXML += "<div>tin1=" + d.getElementById('frm2552:txtPg1TIN1').value + "tin1=</div>" + tab;
            allXML += "<div>tin4=" + d.getElementById('frm2552:txtPg1TIN4').value + "tin4=</div>" + tab;
            allXML += "<div>rdo=" + d.getElementById('frm2552:txtPg1I5RDO').value + "rdo=</div>" + tab;
            allXML += "<div>lob=" + d.getElementById('frm2552:txtLOB').value + "lob=</div>" + tab;
            allXML += "<div>regAddr=" + escape(d.getElementById('frm2552:txtPg1Pt1I7RegisteredAddress').value)
                                      //+ escape(d.getElementById('frm2552:txtPg1Pt1I7RegisteredAddress2').value)
                                      + escape(d.getElementById('frm2552:txtPg1Pt1I7RegisteredAddress2').value)+ "regAddr=</div>" + tab;

            //No Zip for 2200C, just get it from var p3TPZip
            allXML += "<div>zip=" + p3TPZip + "zip=</div>" + tab;

            allXML += "<div>telNo=" + d.getElementById('frm2552:txtPg1Pt1I8ContactNumber').value + "telNo=</div>" + tab;
            allXML += "<div>email="+document.getElementById('frm2552:txtPg1Pt1I9Email').value+"email=</div>"+tab;allXML += "<div>confirmemail="+document.getElementById('frm2552:txtPg1Pt1I9Email').value+"confirmemail=</div>"+tab;
            allXML += "<div>confirmtin1=" + d.getElementById('frm2552:txtPg1TIN1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm2552:txtPg1TIN2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm2552:txtPg1TIN3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm2552:txtPg1TIN4').value + "confirmtin4=</div>" + tab;
            allXML += "<div>formType=2200Cv2018formType=</div>" + tab;

            allXML += tab + d.getElementById('xmlClose').innerHTML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (isFinalCopy == false) {
                alert('Background information saved/updated successfully as : ' + xmlFileName);
            }
        }
    }
