        }
    }

    // load data on controls based on profile.xml
    function loadBGData() {
        /*This will load data onto Background Information fields*/
        var responseBG = d.getElementById("responseBG");

        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '2552v2018') {
            var fnVal = String(responseBG.innerHTML).split('fn=');
            d.getElementById('frm2552:txtPg1Pt1I6Name').value = unescape(fnVal[1]).toUpperCase();

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            //d.getElementById('frm2552:txtPg1TIN1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            // d.getElementById('frm2552:txtPg1TIN2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            //d.getElementById('frm2552:txtPg1TIN3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            //d.getElementById('frm2552:txtPg1TIN4').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm2552:txtPg1I5RDO').value = rdoVal[1];

            if (rdoVal != "") {
                $('select[id="frm2552:rdoPg1Pt1I5RDO"] option[value = ' + rdoVal[1] + ']').attr("selected", "selected");
                document.getElementById("frm2552:rdoPg1Pt1I5RDO").disabled = true;
            }

            //            var data = "<select id='frm2552:rdoPg1Pt1I5RDO' name='frm2552:rdoPg1Pt1I5RDO' disabled='disabled' size='1'><option value='" + rdoVal[1] + "' selected>" + rdoVal[1] + "</option>";
            //            $('#rdoContainer').html(data);
            //if(rdoVal != "")
            //d.getElementById('frm2552:rdoPg1Pt1I5RDO').value = rdoVal;

            // Store the value of Main Line of Business for the parent window (frm2552:txtPg1Pt1I13MainLine)
            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm2552:txtLOB').value = unescape(lobVal[1]);

            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
            regAddrVal[1] = unescape(regAddrVal[1].substring(0, regAddrVal[1].length));
            //if (regAddrVal[1].length > 80 && regAddrVal[1].length <= 160) {
			if (regAddrVal[1].length > 80) {
                d.getElementById('frm2552:txtPg1Pt1I7RegisteredAddress').value = regAddrVal[1].substring(0, 80);
                //d.getElementById('frm2552:txtPg1Pt1I7RegisteredAddress2').value = regAddrVal[1].substring(80, regAddrVal[1].length);
				d.getElementById('frm2552:txtPg1Pt1I7RegisteredAddress2').value = regAddrVal[1].substring(80, 160);
            }
            else if (regAddrVal[1].length <= 80) {
                d.getElementById('frm2552:txtPg1Pt1I7RegisteredAddress').value = regAddrVal[1];   
                d.getElementById('frm2552:txtPg1Pt1I7RegisteredAddress2').value = "";
            }

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            d.getElementById('frm2552:txtPg1Pt1I8ContactNumber').value = telNoVal[1];

            var zipVal = String(responseBG.innerHTML).split('zip=');
            document.getElementById('frm2552:txPg1I7ZipCode').value = zipVal[1];
            p3TPZip = zipVal[1];

            if (rdoVal[1] == "000") {
                d.getElementById('frm2552:rdoPg1Pt1I5RDO').disabled = false;
            }
                        
            //set TIN & TaxFiler's Name across the page
            var TIN1 = d.getElementsByName('frm2552:TIN1');
            var TIN2 = d.getElementsByName('frm2552:TIN2');
            var TIN3 = d.getElementsByName('frm2552:TIN3');
            var TIN4 = d.getElementsByName('frm2552:TIN4');
            TaxFiler = d.getElementsByName('frm2552:RegName');

            for (var i = 0; i < TIN1.length; i++) {
                TIN1[i].value = tin1Val[1];
                TIN2[i].value = tin2Val[1];
                TIN3[i].value = tin3Val[1];
                TIN4[i].value = tin4Val[1];
               // TaxFiler[i].value = fnVal[1].toUpperCase();
            }
        }
        var emailVal = String(responseBG.innerHTML).split('email=');
            if(emailVal[1] === undefined)
            {
                document.getElementById('frm2552:txtPg1Pt1I9Email').value = "";
            }
            else
            {
                document.getElementById('frm2552:txtPg1Pt1I9Email').value = emailVal[1];
                globalEmail = emailVal[1];
            }
    }

    // if file is already existing
    function loadData() {
        /*This will load data onto fields*/
        var response = d.getElementById("response");
        var elem = d.getElementById('frmMain').elements;

        if ((response.innerHTML).indexOf('Pg2Pt5Sch1PopLength') != -1) {
            counter = (response.innerHTML).split('Pg2Pt5Sch1PopLength=')[1];
            // alert(counter);
            for (var i = 0; i < counter; i++) {
                AddRow_Pg2Pt5AddMorePopTable('Sch1');
            }
        }

		if ((response.innerHTML).indexOf('Pg2Pt5Sch2PopLength') != -1) {
            counter = (response.innerHTML).split('Pg2Pt5Sch2PopLength=')[1];
            // alert(counter);
            for (var i = 0; i < counter; i++) {
                AddRow_Pg2Pt5AddMorePopTable('Sch2');
            }
        }

		if ((response.innerHTML).indexOf('Pg2Pt5Sch3PopLength') != -1) {
            counter = (response.innerHTML).split('Pg2Pt5Sch3PopLength=')[1];
            // alert(counter);
            for (var i = 0; i < counter; i++) {
                AddRow_Pg2Pt5AddMorePopTable('Sch3');
            }
        }

        var rdoCode;
        for (var i = 0; i < elem.length; i++) {

            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {  //elem[i].type != 'button' &&           
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String($("#response").html()).split(elem[i].id + '=');
                    if (elem[i].id == 'frm2552:txtPg1Pt1I6Name' || elem[i].id == 'frm2552:txtPg1Pt1I13MainLine' || elem[i].id == 'frm2552:txtPg1Pt1I7RegisteredAddress') {
                        elem[i].value = unescape(fieldVal[1]);
                    }
                    else if (elem[i].className.indexOf("FinalFlag") > -1) {
                        elem[i].value = typeof (fieldVal[1]) === "undefined" ? "3" : fieldVal[1];
                    }  else if (elem[i].id == 'frm2552:txPg1I7ZipCode') {
                        p3TPZip = fieldVal[1];
                        elem[i].value = fieldVal[1];
                        //alert("2==" + p3TPZip);
                    }
                    else {
                        elem[i].value = fieldVal[1]; //all select-one and text values               
                    }

                    if (elem[i].id == 'frm2552:rdoPg1Pt1I5RDO') {
                        rdoCode = fieldVal[1];
                    }

					if (String(elem[i].id).indexOf('frm2552:txtPg1Pt1I11Region') != -1 || String(elem[i].id).indexOf('frm2552:txtPg1Pt1I11Province') != -1) {
                        elem[i].onchange();
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String($("#response").html()).split(elem[i].id + '=');
                    if (rdoVal[1] == 'true') {
                        elem[i].checked = rdoVal[1];
                        //elem[i].onclick(); dgarfin: commented since it hinders the rest of the elements to load its values 
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String($("#response").html()).split(elem[i].id + '=');
                    if (chkboxVal[1] == 'true') {
                        elem[i].checked = chkboxVal[1];
                    }
                }
                //dgarfin: temporarily commented until modalAtc popup show/hide 
                //if (elem[i].type == 'button' && elem[i].id == 'btnOkPop') {
                //  elem[i].onclick();              
                //}                 
            }

        }

        var data = "<select id='frm2552:rdoPg1Pt1I5RDO' name='frm2552:rdoPg1Pt1I5RDO' disabled='disabled' size='1'><option value='" + rdoCode + "' selected>" + rdoCode + "</option>";
        $('#rdoContainer').html(data);

        document.getElementById('frm2552:txtPg1Pt1I9Email').value = globalEmail;
        document.getElementById('frm2552:txtPg1Pt1I9Email').disabled = true;
		
		isAmended();
		availTaxRelief();
    }

    function loadXMLWellFormed(loadWhere) {
        try {

            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLFile.AtEndOfStream)
                data = "";
            else {
                var response = d.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug             
            loadWFData(); /*This will load data onto fields*/
            if (response.innerHTML.indexOf("All Rights Reserved BIR 2014.0") >= 0) {
                gIsReadOnly = true;
            }

            if (gIsReadOnly) {
                d.getElementById('frm2552:btnValidate').disabled = true;
                d.getElementById('btnSave').disabled = true;
            }
            window.setTimeout("$('#loader').hide('blind');", 2000);
        } catch (e) {
            //msg.innerHTML = "Save File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadWFData() {
        /*This will load data onto fields*/
        var response = d.getElementById("response");
        var elem = d.getElementById('frmMain').elements;
        for (var i = 0; i < elem.length; i++) {

            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {  //elem[i].type != 'button' &&           
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String(response.innerHTML).split(elem[i].id + '>');
                    // elem[i].value = fieldVal[1]; //all select-one and text values         
                    if (fieldVal != null && fieldVal.length > 1) {
                        elem[i].value = fieldVal[1].substring(0, fieldVal[1].indexOf("</"));
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String(response.innerHTML).split(elem[i].id + '>');
                    if (rdoVal[1] == 'true') {
                        // elem[i].checked = rdoVal[1];
                        if (rdoVal != null && rdoVal.length > 1) {
                            elem[i].value = rdoVal[1].substring(0, rdoVal[1].indexOf("</"));
                        }
                        //elem[i].onclick(); dgarfin: commented since it hinders the rest of the elements to load its values 
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String(response.innerHTML).split(elem[i].id + '>');
                    if (chkboxVal[1] == 'true') {
                        // elem[i].checked = chkboxVal[1];
                        if (chkboxVal != null && chkboxVal.length > 1) {
                            elem[i].value = chkboxVal[1].substring(0, chkboxVal[1].indexOf("</"));
                        }
                    }
                }
                //dgarfin: temporarily commented until modalAtc popup show/hide 
                //if (elem[i].type == 'button' && elem[i].id == 'btnOkPop') {
                //  elem[i].onclick();              
                //}                 
            }

        }
    }

