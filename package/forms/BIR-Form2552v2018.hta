					Pg2Pt5Sch3_Col8.push(tableTwo.rows[x].cells[4].children[0].value);
                }
            }

            Load_Pg2Pt5AddMorePopTable(schd);

            //if (Pg2Pt5Sch1_Col1.length == 0){
			if (Pg2Pt5Sch1_Col1.length == 0 || Pg2Pt5Sch2_Col1.length == 0 || Pg2Pt5Sch3_Col1.length == 0){
                d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5").value = "";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5").value = "";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer5").value = "";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp5").value = "";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5").value = "0.00";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5").value = "0.00";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5").value = "0.00";
                d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxDue5").value = "0.00";
                $(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5")).prop('disabled', false);
                $(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5")).prop('disabled', false);
                $(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxDue5")).prop('disabled', true);
                $('#btnPg2Pt5'+ schd + 'More').prop('disabled', true);
            }

            //if (Pg2Pt5Sch1_Col1.length == 1){
			if (Pg2Pt5Sch1_Col1.length == 1 || Pg2Pt5Sch2_Col1.length == 1 || Pg2Pt5Sch3_Col1.length == 1){
				if (schd == 'Sch1'){
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5").value = Pg2Pt5Sch1_Col1[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5").value = Pg2Pt5Sch1_Col2[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer5").value = Pg2Pt5Sch1_Col3[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp5").value = Pg2Pt5Sch1_Col4[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5").value = Pg2Pt5Sch1_Col5[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5").value = Pg2Pt5Sch1_Col6[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5").value = Pg2Pt5Sch1_Col7[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxDue5").value = Pg2Pt5Sch1_Col8[0];
					$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5")).prop('disabled', true);
				}
				else if (schd == 'Sch2'){
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5").value = Pg2Pt5Sch2_Col1[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5").value = Pg2Pt5Sch2_Col2[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer5").value = Pg2Pt5Sch2_Col3[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp5").value = Pg2Pt5Sch2_Col4[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5").value = Pg2Pt5Sch2_Col5[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5").value = Pg2Pt5Sch2_Col6[0];
