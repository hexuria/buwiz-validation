	function checkPartIVFields(){
		var isValid = true;
		var transClass = '';
		var amount = 0.00;

		for (var row = 1; row <= 5; row++){
			transClass = d.getElementById('frm2552:txtPg2P4I' +row +'TransClass').value;
			amount = NumWithComma(d.getElementById('frm2552:txtPg2P4I' +row +'Amount').value) * 1;

			if ((amount == 0.00 && transClass != '') ||
				(amount != 0.00 && transClass == '')){
				alert("Please complete Item #" +row + " in Part IV Page 2.");
				isValid = false;
			}

			if(!isValid) break;
		}

		return isValid;
	}

	function checkPartVSchFields(sch){
		var isValid = true;
		var date = '';
		var seller = '';
		var buyer = '';
		var issueCorp = '';
		var numOfShare = 0.00;
		var taxBase = 0.00;
		var taxRate = 0.00;
		var taxDue = 0.00;

		for (var row = 1; row <= 5; row++){
			date = d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Date' +row).value;
			seller = d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Seller' +row).value;
			buyer = d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Buyer' +row).value;
			issueCorp = d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Corp' +row).value;
			numOfShare = NumWithComma(d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'NumShares' +row).value) * 1;
			taxBase = NumWithComma(d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxBase' +row).value) * 1;
			taxRate = NumWithComma(d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxRate' +row).value) * 1;
			//taxDue = NumWithComma(d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxDue' +row).value) * 1;

			if (sch != '1' && (((date == '' || seller == '' || buyer == '' || issueCorp == '') &&
				(numOfShare != 0.00 || taxBase != 0.00 || taxRate != 0.00)) ||
				((date != '' || seller != '' || buyer != '' || issueCorp != '') &&
				(numOfShare == 0.00 || taxBase == 0.00 || taxRate == 0.00)))){
				alert("Please complete Item #" +row + " in Page 2 Part V Schedule " +sch +".");
				isValid = false;
			}
			else if (sch == '1' && (((date == '' || seller == '' || buyer == '' || issueCorp == '') &&
				(numOfShare != 0.00 || taxBase != 0.00)) ||
				((date != '' || seller != '' || buyer != '' || issueCorp != '') &&
				(numOfShare == 0.00 || taxBase == 0.00)))){
				alert("Please complete Item #" +row + " in Page 2 Part V Schedule " +sch +".");
				isValid = false;
			}

			if(!isValid) break;
		}

		return isValid;
	}

	function checkPartVIFields(){
		var isValid = true;
		var date = '';
		var seller = '';
		var buyer = '';
		var issueCorp = '';
		var numOfShare = 0.00;

		for (var row = 1; row <= 5; row++){
			date = d.getElementById('frm2552:txtPg2Pt6Date' +row).value;
			seller = d.getElementById('frm2552:txtPg2Pt6Seller' +row).value;
			buyer = d.getElementById('frm2552:txtPg2Pt6Buyer' +row).value;
			issueCorp = d.getElementById('frm2552:txtPg2Pt6Corp' +row).value;
			numOfShare = NumWithComma(d.getElementById('frm2552:txtPg2Pt6NumShares' +row).value) * 1;

			if (((date == '' || seller == '' || buyer == '' || issueCorp == '') &&
				(numOfShare != 0.00)) ||
				((date != '' || seller != '' || buyer != '' || issueCorp != '') &&
				(numOfShare == 0.00))){
				alert("Please complete Item #" +row + " in Page 2 Part VI.");
				isValid = false;
			}

			if(!isValid) break;
		}

		return isValid;
	}

	function validateDate(element) {
        var strmmddyyyy = element.value;
        var isValid = true;
        var currentDate = new Date();
        var inputDate = new Date();

        if (strmmddyyyy != "") {
            var result = strmmddyyyy.split("/");
            var isLeap = new Date(result[2], 1, 29).getMonth() === 1;
            var month31 = (['01', '03', '05', '07', '08', '10', '12']);
            var month30 = (['04', '06', '09', '11']);
            var month = result[0];
            var day = result[1];
            if (result.length === 3) {
                if (isNaN(result[0] || result[1] || result[2])) {
                    isValid = false;
                }
                else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 1))) {
                    // numeric check if greater not than 31 - Month.
                    isValid = false;
                }
                else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
                    // numeric check if Date.
                    isValid = false;
                }
                else if (result[2].length != 4) {
                    isValid = false;
                }
                else if (month == 2) {
                    if (!isLeap && day == 29) {
                        isValid = false;
                    }
                    else if (!isLeap && day > 29) {
                        isValid = false;
                    }
                    else if (isLeap && day > 29) {
                        isValid = false;
                    }
                }
                else if (month31.contains(month) && day > 31) {
                    isValid = false;
                }
                else if (month30.contains(month) && day > 30) {
                    isValid = false;
                }

                inputDate = new Date(result[2], month - 1, day);            

            }
            else {
                isValid = false;
            }
        }

        if (!isValid) {
            alert('Please provide a valid date. (MM/DD/YYYY format)');
            element.value = '';
            element.focus();
        }
        else if (inputDate > currentDate) {
            alert('This date cannot be a future date.');
            element.value = '';
            element.focus();
        }
        else if (inputDate.getFullYear() < 2018) {
            alert('This date cannot be prior to 2018.');
            element.value = '';
            element.focus();
        }

        return isValid;
    }

    function dateInPage1Item1() {
        //var strmmddyyyy = element.value;
		var strmm = d.getElementById('frm2552:txtPg1I1Month').value;
		var strdd = d.getElementById('frm2552:txtPg1I1Day').value;
		var stryyyy = d.getElementById('frm2552:txtPg1I1Year').value;
        var isValid = true;
        var currentDate = new Date();
        var inputDate = new Date();

        if (strmm != "" &&
			strdd != "" &&
			stryyyy != "") {
            //var result = strmmddyyyy.split("/");
            var isLeap = new Date(stryyyy, 1, 29).getMonth() === 1;
            var month31 = (['01', '03', '05', '07', '08', '10', '12']);
            var month30 = (['04', '06', '09', '11']);
            var month = strmm;
            var day = strdd;
            //if (result.length === 3) {
                if (isNaN(strmm || strdd || stryyyy)) {
                    isValid = false;
                }
                else if ((strmm.length != 2 || (strmm > 12 || strmm < 0))) {
                    // numeric check if greater not than 31 - Month.
                    isValid = false;
                }
                else if (strdd.length != 2 || (strdd > 31 || strdd < 1)) {
                    // numeric check if Date.
                    isValid = false;
                }
                else if (stryyyy.length != 4 || ((stryyyy * 1) < 1800)) {
                    isValid = false;
                }
                else if (month == 2) {
                    if (!isLeap && day == 29) {
                        isValid = false;
                    }
                    else if (!isLeap && day > 29) {
                        isValid = false;
                    }
                    else if (isLeap && day > 29) {
                        isValid = false;
                    }
                }
                else if (month31.contains(month) && day > 31) {
                    isValid = false;
                }
                else if (month30.contains(month) && day > 30) {
                    isValid = false;
                }

                inputDate = new Date(stryyyy, month - 1, day);
            /*}
            else {
                isValid = false;
            }*/
        }

        if (!isValid) {
            alert('Please provide a valid date. (MM/DD/YYYY format) in Page 1 Item 1.');
            d.getElementById('frm2552:txtPg1I1Day').focus();
			isValid = false;
        }
        else if (inputDate > currentDate) {
            alert('Page 1 Item 1 Date cannot be a future date ');
            d.getElementById('frm2552:txtPg1I1Day').focus();
			isValid = false;
        }
        return isValid;
    }

    function getRegion() {
        var data = "<option value='00'>(Select Region)</option>";

        for (var i = 0; i < regionList.length; i++) {
            var region = regionList[i];
            data = data + "<option value='" + region.regionCode + "'>" + region.description + "</option>";
        }

        //selectRegion11.innerHTML = data;
        //selectRegion12.innerHTML = data;

        $('#frm2552\\:txtPg1Pt1I11Region').html(data);

    }

    function getProvince(regionCode, provID, cityID) {
        //Clear city
        var data = "<option value='00'>(Select City)</option>";

        //var selectCity = d.getElementById(cityID);
        //selectCity.innerHTML = data;
        if (cityID == 'frm2552:txtPg1Pt1I11City') {
            $('#frm2552\\:txtPg1Pt1I11City').html(data);
        }

        data = "<option value='00'>(Select Province)</option>";
        var selectProv = d.getElementById(provID);
        for (var i = 0; i < provinceList.length; i++) {
            var prov = provinceList[i];
            if (prov.regionCode == regionCode) {
                data = data +
                    "<option value='" + prov.provinceCode + "'>" + prov.description + "</option>";
            }
        }
        //selectProv.innerHTML = data;
        if (provID == 'frm2552:txtPg1Pt1I11Province') {
            $('#frm2552\\:txtPg1Pt1I11Province').html(data);
        }
        selectProv.selectedIndex = 0;
