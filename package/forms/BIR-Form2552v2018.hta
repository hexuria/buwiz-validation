    function Save_Pg2Pt5AddMorePopTable(schd) {
        numRows  = d.getElementById("Pg2Pt5"+ schd + "PopTable1st").rows.length;
        tableOne = d.getElementById("Pg2Pt5"+ schd + "PopTable1st");
		tableTwo = d.getElementById("Pg2Pt5"+ schd + "PopTable2nd");

        if (CheckEmptyDesc("Pg2Pt5"+ schd + "PopTable1st", "Pg2Pt5"+ schd + "PopTable2nd", "5.", "save")) {
			newArrayPopTable(schd);

            for (x = 0; x < numRows; x++) {
                str = tableOne.rows[x].cells[0].children[1].value;
                if ($.trim(str) != "" && schd == 'Sch1') {
                    Pg2Pt5Sch1_Col1.push(tableOne.rows[x].cells[0].children[1].value);
                    Pg2Pt5Sch1_Col2.push(tableOne.rows[x].cells[1].children[0].value);
                    Pg2Pt5Sch1_Col3.push(tableOne.rows[x].cells[2].children[0].value);
					Pg2Pt5Sch1_Col4.push(tableTwo.rows[x].cells[0].children[0].value);
					Pg2Pt5Sch1_Col5.push(tableTwo.rows[x].cells[1].children[0].value);
					Pg2Pt5Sch1_Col6.push(tableTwo.rows[x].cells[2].children[0].value);
					Pg2Pt5Sch1_Col7.push(tableTwo.rows[x].cells[3].children[0].value);
					Pg2Pt5Sch1_Col8.push(tableTwo.rows[x].cells[4].children[0].value);
                }
				else if ($.trim(str) != "" && schd == 'Sch2') {
                    Pg2Pt5Sch2_Col1.push(tableOne.rows[x].cells[0].children[1].value);
                    Pg2Pt5Sch2_Col2.push(tableOne.rows[x].cells[1].children[0].value);
                    Pg2Pt5Sch2_Col3.push(tableOne.rows[x].cells[2].children[0].value);
					Pg2Pt5Sch2_Col4.push(tableTwo.rows[x].cells[0].children[0].value);
					Pg2Pt5Sch2_Col5.push(tableTwo.rows[x].cells[1].children[0].value);
					Pg2Pt5Sch2_Col6.push(tableTwo.rows[x].cells[2].children[0].value);
					Pg2Pt5Sch2_Col7.push(tableTwo.rows[x].cells[3].children[0].value);
					Pg2Pt5Sch2_Col8.push(tableTwo.rows[x].cells[4].children[0].value);
                }
				else if ($.trim(str) != "" && schd == 'Sch3') {
                    Pg2Pt5Sch3_Col1.push(tableOne.rows[x].cells[0].children[1].value);
                    Pg2Pt5Sch3_Col2.push(tableOne.rows[x].cells[1].children[0].value);
                    Pg2Pt5Sch3_Col3.push(tableOne.rows[x].cells[2].children[0].value);
					Pg2Pt5Sch3_Col4.push(tableTwo.rows[x].cells[0].children[0].value);
					Pg2Pt5Sch3_Col5.push(tableTwo.rows[x].cells[1].children[0].value);
