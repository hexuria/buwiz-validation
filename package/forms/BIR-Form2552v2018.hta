        if ($.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date1").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller1").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer1").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp1").value) == "" || d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares1").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase1").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate1").value * 1 == 0 ||
            $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date2").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller2").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer2").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp2").value) == "" || d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares2").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase2").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate2").value * 1 == 0 ||
            $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date3").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller3").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer3").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp3").value) == "" || d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares3").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase3").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate3").value * 1 == 0 ||
			$.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date4").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller4").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer4").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp4").value) == "" || d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares4").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase4").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate4").value * 1 == 0 ||
            $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer5").value) == "" || $.trim(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp5").value) == "" || d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5").value * 1 == 0 || d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5").value * 1 == 0 ) {

