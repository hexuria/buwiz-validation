				}
				else if (schd == 'Sch3'){
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5").value = Pg2Pt5Sch3_Col1[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5").value = Pg2Pt5Sch3_Col2[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer5").value = Pg2Pt5Sch3_Col3[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp5").value = Pg2Pt5Sch3_Col4[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5").value = Pg2Pt5Sch3_Col5[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5").value = Pg2Pt5Sch3_Col6[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5").value = Pg2Pt5Sch3_Col7[0];
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxDue5").value = Pg2Pt5Sch3_Col8[0];
					$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5")).prop('disabled', false);
				}
				
				
                $(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5")).prop('disabled', false);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5")).prop('disabled', false);
                //$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5")).prop('disabled', false);
                $(d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxDue5")).prop('disabled', true);
                $('#btnPg2Pt5'+ schd + 'More').prop('disabled', false);
            }

            if (Pg2Pt5Sch1_Col1.length > 1 || Pg2Pt5Sch2_Col1.length > 1 || Pg2Pt5Sch3_Col1.length > 1) {
                d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5").value = "OTHERS";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5").value = "OTHERS";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "Buyer5").value = "OTHERS";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "Corp5").value = "OTHERS";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "NumShares5").value = "OTHERS";
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxBase5").value = "OTHERS";
				
				if (schd == 'Sch1')
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5").value = "6/10 of 1%";
				else 
					d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxRate5").value = "OTHERS";
				
				
                //d.getElementById("frm2552:txtPg2Pt5"+ schd + "TaxDue5").value = "OTHERS";
                $(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Date5")).prop('disabled', true);
				$(d.getElementById("frm2552:txtPg2Pt5"+ schd + "Seller5")).prop('disabled', true);
