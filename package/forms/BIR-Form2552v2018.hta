            var currentDate = new Date();

            document.getElementById("frm2552:txtPg1I1Month").disabled = true;
            document.getElementById("frm2552:txtPg1I1Year").disabled = false;
            if (document.getElementById("frm2552:txtPg1I1Year").value == "") {
                document.getElementById("frm2552:txtPg1I1Year").value = (currentDate.getFullYear() - 2000) - 1;
            }
        }*/

        //setTimeout(function () { document.onmouseup(); }, 1000);
