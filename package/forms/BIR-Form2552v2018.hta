	function negativeNumbers(e, decimal) {
        var key;
        var keychar;

        if (window.event) {
            key = window.event.keyCode;
        }
        else if (e) {
            key = e.which;
        }
        else {
            return true;
        }
        keychar = String.fromCharCode(key);

        if ((key == null) || (key == 0) || (key == 8) || (key == 9) || (key == 13) || (key == 27)) {
            return true;
        }
        else if ((("0123456789-()").indexOf(keychar) > -1)) {
            return true;
        }
        else {
            return false;
        }
    }


    function createEncXMLFileName(subFolder) {
        /// <summary>Creates XML FileName to folder [/IAF_RDO_Copy]</summary>
        /// <param name="subFolder" type="String">folder of saved files.</param>
        /// <returns type="String">xmlFileName</returns>

        var xmlFileName = "";
        var titleTin1 = d.getElementById('frm2552:txtPg1TIN1');
        var titleTin2 = d.getElementById('frm2552:txtPg1TIN2');
        var titleTin3 = d.getElementById('frm2552:txtPg1TIN3');
        var titleBranchCode = d.getElementById('frm2552:txtPg1TIN4');
        var titleTPName = d.getElementById('frm2552:txtPg1Pt1I6Name').value;

        //change if there is Quarter option
        var ddlPg1I1Month = document.getElementById("frm2552:txtPg1I1Month");
        var selectedMonth = ddlPg1I1Month.options[ddlPg1I1Month.selectedIndex].value;
        var selectedYear = d.getElementById('frm2552:txtPg1I1Year').value;

        var returnPeriod = selectedMonth + selectedYear;

        //xmlFileName = "profile/1701q-" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + "-" +
        //( (titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').length > 12) ? titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').substring(0,12).toLowerCase() : titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').toLowerCase() ) + 
        //"-" + dtFormatted +
        //".xml";   

        xmlFileName = subFolder + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
            "-2552v2018-" +
            returnPeriod +
            ".xml";

        fileName = titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
            "-2552v2018-" +
            returnPeriod +
            ".xml";

        return xmlFileName;
    }

