	}

	function enablePageTwoSchedule(schd){
		for (var x = 1; x <= 5; x++){
			if (x == 5 && d.getElementById('frm2552:txtPg2Pt5'+ schd + 'Seller5').value == 'OTHERS'){
				d.getElementById('btnPg2Pt5'+ schd + 'More').disabled = false;
			}
			else {
				d.getElementById('frm2552:txtPg2Pt5'+ schd + 'Date1').disabled = false;
				d.getElementById('frm2552:txtPg2Pt5'+ schd + 'Seller1').disabled = false;
				d.getElementById('frm2552:txtPg2Pt5'+ schd + 'Buyer1').disabled = false;
				d.getElementById('frm2552:txtPg2Pt5'+ schd + 'Corp1').disabled = false;
				d.getElementById('frm2552:txtPg2Pt5'+ schd + 'NumShares1').disabled = false;
				d.getElementById('frm2552:txtPg2Pt5'+ schd + 'TaxBase1').disabled = false;
				
				if (schd != 'Sch1')
					d.getElementById('frm2552:txtPg2Pt5'+ schd + 'TaxRate1').disabled = false;
			}
		}
	}

	function enablePageTwoScheduleRow(element){
		var sch = element.name.substring(20, 21);
		var elemLength = element.name.length;
		var row = element.name.substring(elemLength-1, elemLength);

		var date = '';
		var seller = '';
		var buyer = '';
		var issueCorp = '';
		var numOfShare = 0.00;
		var taxBase = 0.00;
		var taxRate = 0.00;
		var taxDue = 0.00;

		date = d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Date' +row).value;
		seller = d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Seller' +row).value;
		buyer = d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Buyer' +row).value;
		issueCorp = d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Corp' +row).value;
		numOfShare = NumWithComma(d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'NumShares' +row).value) * 1;
		taxBase = NumWithComma(d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxBase' +row).value) * 1;
		taxRate = NumWithComma(d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxRate' +row).value) * 1;
		taxDue = NumWithComma(d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxDue' +row).value) * 1;

		if (row != 5 && sch != '1' && date != '' && seller != '' && buyer != '' && issueCorp != ''
			&& numOfShare != 0.00 && taxBase != 0.00 && taxRate != 0.00){
			row++;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Date' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Seller' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Buyer' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Corp' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'NumShares' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxBase' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxRate' +row).disabled = false;
		}
		else if (row != 5 && sch == '1' && date != '' && seller != '' && buyer != '' && issueCorp != ''
			&& numOfShare != 0.00 && taxBase != 0.00){
			row++;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Date' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Seller' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Buyer' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'Corp' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'NumShares' +row).disabled = false;
			d.getElementById('frm2552:txtPg2Pt5Sch' +sch +'TaxBase' +row).disabled = false;
		}
	}

	function disableAllPageTwoSchedule(){
		disablePageTwoSchedule('Sch1');
		disablePageTwoSchedule('Sch2');
		disablePageTwoSchedule('Sch3');
	}

	function scheduleFromSaveFile(){
		kindOfTransaction();

		if (d.getElementById('frm2552:rdoPg1I11TransactionLSE').checked &&
			d.getElementById('frm2552:rdoPg1I11TransactionPrimary').checked == false &&
			d.getElementById('frm2552:rdoPg1I11TransactionSecondary').checked == false){
			enableSchedule(1);
			Check_Pg2Pt5AddMore('Sch1');
			loadToArray('Sch1');
		}

		else if (d.getElementById('frm2552:rdoPg1I11TransactionLSE').checked == false &&
			d.getElementById('frm2552:rdoPg1I11TransactionPrimary').checked == true &&
			d.getElementById('frm2552:rdoPg1I11TransactionSecondary').checked == false){
			enableSchedule(2);
			Check_Pg2Pt5AddMore('Sch2');
			loadToArray('Sch2');
		}
		else if (d.getElementById('frm2552:rdoPg1I11TransactionLSE').checked == false &&
			d.getElementById('frm2552:rdoPg1I11TransactionPrimary').checked == false &&
			d.getElementById('frm2552:rdoPg1I11TransactionSecondary').checked == true){
			enableSchedule(3);
			Check_Pg2Pt5AddMore('Sch3');
			loadToArray('Sch3');
		}
	}

	function enableSchedule(num){
		for (var x = 1; x <= 3; x++){
			if (x == num){
				enablePageTwoSchedule('Sch' +x);}
			else {
				disablePageTwoSchedule('Sch' +x);
				d.getElementById('Pg2Pt5Sch' +x +'PopLength').value = '';
			}
		}
	}

