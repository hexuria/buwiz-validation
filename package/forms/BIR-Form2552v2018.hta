				d.getElementById("frm2552:txtPg2Pt5"+ schd + "_" + (x + 1) + "Col4").value = Pg2Pt5Sch3_Col4[x];
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "_" + (x + 1) + "Col5").value = Pg2Pt5Sch3_Col5[x];
				d.getElementById("frm2552:txtPg2Pt5"+ schd + "_" + (x + 1) + "Col6").value = Pg2Pt5Sch3_Col6[x];
