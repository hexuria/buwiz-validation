    function FixNumber_Pg2Pt5AddMorePopTable(schd) {
        var i = d.getElementById("Pg2Pt5"+ schd + "PopTable1st").rows.length;
        var tableOne = d.getElementById("Pg2Pt5"+ schd + "PopTable1st");
        for (x = 0; x < i; x++) {
            numberingOne = tableOne.rows[x].cells[0].children[0];
            $(numberingOne).html("5." + (x + 1));
        }
    }

    function AddRow_Pg2Pt5AddMorePopTable(schd) {
        var i = d.getElementById('Pg2Pt5'+ schd + 'PopTable1st').rows.length;
		var o = d.getElementById('Pg2Pt5'+ schd + 'PopTable2nd').rows.length;
        var tableOne = d.getElementById('Pg2Pt5'+ schd + 'PopTable1st');
		var tableTwo = d.getElementById('Pg2Pt5'+ schd + 'PopTable2nd');

        var rowOne = tableOne.insertRow(i);
        var cell1 = rowOne.insertCell(0);//Column A
        var cell2 = rowOne.insertCell(1);//Column B
        var cell3 = rowOne.insertCell(2);//Column C
        var cell4 = rowOne.insertCell(3);//Remove button
		
		var rowTwo = tableTwo.insertRow(o);
		var cell5 = rowTwo.insertCell(0);//Column D
		var cell6 = rowTwo.insertCell(1);//Column E
		var cell7 = rowTwo.insertCell(2);//Column F
		var cell8 = rowTwo.insertCell(3);//Column G
		var cell9 = rowTwo.insertCell(4);//Column H
		var cell10 = rowTwo.insertCell(5);//Dummy remove button

        cell1.innerHTML = '<tr><td class="tblFormTd" align="left" style="width:8%;"><span style="font-weight: bold; font-size: small;">&nbsp;5.' + (i + 1) + '&nbsp;&nbsp;</span><input type="text" onkeypress="return dateOnly(this, event)" onkeydown="dateMasking(this);" onblur="validateDate(this);" maxlength="10" size="15" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col1"/></td>';
        cell2.innerHTML = '<td class="tblFormTd" align="left" style="width:10%;"><input type="text" onfocus="onFocusIterate(this)"  onkeypress="return Code(this)" onblur="return capitalize(this), onBlurIterate(this)" maxlength="80" size="50" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col2"/></td>';
		cell3.innerHTML = '<td class="tblFormTd" align="left" style="width:10%;"><input type="text" onfocus="onFocusIterate(this)"  onkeypress="return Code(this)" onblur="return capitalize(this), onBlurIterate(this)" maxlength="80" size="50" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col3"/></td>';
        cell4.innerHTML = '<td class="tblFormTd" align="left" style="width:10%;"><input type="button" value="Remove" onclick="deleteRow(this, ' + (i + 1) + ', true),FixNumber_Pg2Pt5AddMorePopTable(\''+ schd +'\') "/></td></tr>';
		
		cell5.innerHTML = '<tr><td class="tblFormTd" align="center" style="width:30%;">&ensp;&ensp;&ensp;&ensp;<input type="text" onfocus="onFocusIterate(this)"  onkeypress="return Code(this)" onblur="return capitalize(this), onBlurIterate(this)" maxlength="80" size="50" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col4"/></td>';
		cell6.innerHTML = '<td class="tblFormTd" align="left" style="width:20%;"><input type="text" onfocus="onFocusIterate(this)" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col5" style="text-align: right;" size="20" onblur="onBlurIterate(this); toComma(this); round(this);" onkeypress="return wholenumber(this, event)"  maxlength="20" value="0.00" /></td>';
		cell7.innerHTML = '<td class="tblFormTd" align="left" style="width:20%;"><input type="text" onfocus="onFocusIterate(this)" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col6" style="text-align: right;" size="20" onblur="onBlurIterate(this); toComma(this); Sum_Pg2Pt5AddMore(\''+ schd +'\'); round(this);" onkeypress="return wholenumber(this, event)"  maxlength="20" size="20" value="0.00" /></td>';
		
		if (schd == 'Sch1')
			cell8.innerHTML = '<td class="tblFormTd" align="left" style="width:20%;"><input type="text" onfocus="onFocusIterate(this)" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col7" style="text-align: right;" size="20" onblur="onBlurIterate(this); toComma(this); Sum_Pg2Pt5AddMore(\''+ schd +'\'); round(this);" onkeypress="return wholenumber(this, event)"  maxlength="20" size="20" value="6/10 of 1%" disabled="disabled" /></td>';
		else
			cell8.innerHTML = '<td class="tblFormTd" align="left" style="width:20%;"><input type="text" onfocus="onFocusIterate(this)" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col7" style="text-align: right;" size="20" onblur="onBlurIterate(this); toComma(this); Sum_Pg2Pt5AddMore(\''+ schd +'\'); round(this);" onkeypress="return wholenumber(this, event)"  maxlength="20" size="20" value="0.00" /></td>';
		
		
		cell9.innerHTML = '<td class="tblFormTd" align="left" style="width:20%;"><input type="text" onfocus="onFocusIterate(this)" id="frm2552:txtPg2Pt5'+ schd + '_' + (i + 1) + 'Col8" style="text-align: right;" size="20" onblur="onBlurIterate(this); toComma(this); ; round(this);" onkeypress="return wholenumber(this, event)"  maxlength="20" size="20" disabled="disabled" value="0.00" /></td>';
		cell10.innerHTML = '<td class="tblFormTd" align="center" style="width:10%; display: none;"><input style="display: none;" type="button" value="Remove" id="frm2552:deleteRow2nd' + (i + 1) + '" onclick="deleteRow(this, 0, false), Sum_Pg2Pt5AddMore(\''+ schd +'\')"/></td></tr>';
	
	}

    //Summation
    function Sum_Pg2Pt5AddMore(schd) {
        var total = 0;
		var rowTaxDue = 0;
		var taxRateAddMore = 0;

        numRows = d.getElementById("Pg2Pt5"+ schd + "PopTable2nd").rows.length;
        table = d.getElementById("Pg2Pt5"+ schd + "PopTable2nd");

        for (x = 0; x < numRows; x++) {
			if (schd == 'Sch1')
				taxRateAddMore = 0.6;
			else
				taxRateAddMore = removeCommaParenthesis(table.rows[x].cells[3].children[0].id);
		
		
			rowTaxDue = removeCommaParenthesis(table.rows[x].cells[2].children[0].id) * taxRateAddMore / 100;
			table.rows[x].cells[4].children[0].value = formatCurrency(rowTaxDue.toFixed(0));
            total += removeCommaParenthesis(table.rows[x].cells[4].children[0].id) * 1;
        }
        d.getElementById("Pg2Pt5"+ schd + "SubTotal").disabled = true;
        d.getElementById("Pg2Pt5"+ schd + "SubTotal").value = formatCurrency(total.toFixed(0));

		disableTaxRowInAddMore(schd);

    }
	
	function disableTaxRowInAddMore(schd){
		var currNumRows = d.getElementById("Pg2Pt5"+ schd + "PopTable1st").rows.length;

		for (x = 1; x <= currNumRows; x++){
			if (doesFieldExist('txtPg2Pt5'+ schd + '_' + (x) + 'Col8'))
				d.getElementById('frm2552:txtPg2Pt5'+ schd + '_' + (x) + 'Col8').disabled = true;

			if (doesFieldExist('txtPg2Pt5'+ schd + '_' + (x) + 'Col7') && schd == 'Sch1')
				d.getElementById('frm2552:txtPg2Pt5'+ schd + '_' + (x) + 'Col7').disabled = true;
		}
	}
	
    function doesFieldExist(field){
        var objExist = true;

        if (document.body.contains(d.getElementById('frm2552:'+ field)) == false){
            objExist = false;
        }

        return objExist;
    }
	
</script>


