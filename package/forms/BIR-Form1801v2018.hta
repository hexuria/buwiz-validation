	function getRdo()
	{
		var data = "<select class='iceSelOneMnu' id='frm1801v2018:txtRDOCode_1' name='frm1801v2018:txtRDOCode_1' size='1' ><option value='000'> </option>";

		for(var i = 0; i < rdoList.length; i++) {
			var rdo = rdoList[i];
			data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";
		}
		data = data + "</select>"

		$('#rdoSelect').html(data);
	}


	function initialValidateBeforeSave() {

		if( (d.getElementById('frm1801v2018:txtDateDay').value == "") && (d.getElementById('frm1801v2018:txtDateMonth').value == "") && (d.getElementById('frm1801v2018:txtDateYear').value == "")   ){
			alert("Please enter a valid Return Date");
			return false;
		}
		if( (d.getElementById('frm1801v2018:tinA_1').value == "" || d.getElementById('frm1801v2018:tinB_1').value == "" || d.getElementById('frm1801v2018:tinC_1').value == "" || d.getElementById('frm1801v2018:branchCode_1').value == "") ){
			alert("Please enter a valid TIN number on Item 5.");
			return false;
		}
		if (d.getElementById('frm1801v2018:txtRDOCode_1').value == "000" || d.getElementById('frm1801v2018:txtRDOCode_1').value == "") {
			alert("Please enter a valid RDO Code on Item 6.");
			return false;
		}
		if( (d.getElementById('frm1801v2018:registeredName_1').value == "") ){
			alert("Please enter a valid Taxpayer Name on Item 7.");
			return false;
		}
		
		return true;
	}

	function enableSaveButton(){
	
		if(d.getElementById("frm1801v2018:txtDateDay").value == ''|| d.getElementById("frm1801v2018:txtDateMonth").value == '' ||  d.getElementById("frm1801v2018:txtDateYear").value == '' || 
			(d.getElementById("frm1801v2018:tinA_1").value == "" || d.getElementById("frm1801v2018:tinB_1").value == "" || d.getElementById("frm1801v2018:tinC_1").value == "" || d.getElementById("frm1801v2018:branchCode_1").value == "")  ){
			d.getElementById("btnSave").disabled = true;
			
		} else {
			d.getElementById("btnSave").disabled = false;
			
		} 

		
	}

	//topNav
	$(document).ready(function(){
		$("ul.subnav").parent().append("<span></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)
		$("ul.topnav li span").click(function() { //When trigger is clicked...
			//Following events are applied to the subnav itself (moving subnav up and down)
			$(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click
			$(this).parent().hover(function() {
			}, function(){
				$(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up
			});
			//Following events are applied to the trigger (Hover events for the trigger)
		}).hover(function() {
				$(this).addClass("subhover"); //On hover over, add class "subhover"
			}, function(){ //On Hover Out
				$(this).removeClass("subhover"); //On hover out, remove class "subhover"
			});
		$("ul.topnav .toplevel").click(function() { //When trigger is clicked...
			//Following events are applied to the subnav itself (moving subnav up and down)
			$(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click
			$(this).parent().hover(function() {
			}, function(){
				$(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up
			});
			//Following events are applied to the trigger (Hover events for the trigger)
		}).hover(function() {
				$(this).addClass("subhover"); //On hover over, add class "subhover"
			}, function(){ //On Hover Out
				$(this).removeClass("subhover"); //On hover out, remove class "subhover"
			});

		//added 07/25/2015
		$('#ebirOnlineConfirmUsername, #ebirOnlineConfirmPassword, #ebirOnlinePassword, #ebirOnlineUsername').bind('paste drag drop', function (e) {
			e.preventDefault();
		});

	});
	function loadBGXML(loadWhere) {
		try {
			//This will load the file with filename loadWhere if it exists
			var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
			XMLBGFile = fsoXML.OpenTextFile(loadWhere,1);
			if (XMLBGFile.AtEndOfStream) {
				data = "";
			} else {
				var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
				responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag
			}
			XMLBGFile.Close();
			//alert( responseBG.innerHTML ); //Debug
			loadBGData();	/*This will load data onto fields*/
		} catch(e) {
			msg.innerHTML = "";
		}
	}

	function loadBGData() {
		/*This will load data onto Background Information fields*/
		var responseBG = d.getElementById("responseBG");
		var emailVal = String(responseBG.innerHTML).split('email=');

		if(emailVal[1] === undefined)
		{
			document.getElementById('frm1801v2018:txtEmail').value = "";
		}
		else
		{
			document.getElementById('frm1801v2018:txtEmail').value = emailVal[1];
			globalEmail = emailVal[1];
		}

		var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

		if (formTypeVal[1] == '1801v2018') {
			var fnVal = String(responseBG.innerHTML).split('fn=');

			d.getElementById('frm1801v2018:registeredName').value = unescape(fnVal[1]);

			var tin1Val = String(responseBG.innerHTML).split('tin1=');
			d.getElementById('frm1801v2018:tinA').value = tin1Val[1];

			var tin2Val = String(responseBG.innerHTML).split('tin2=');
			d.getElementById('frm1801v2018:tinB').value = tin2Val[1];

			var tin3Val = String(responseBG.innerHTML).split('tin3=');
			d.getElementById('frm1801v2018:tinC').value = tin3Val[1];

			var tin4Val = String(responseBG.innerHTML).split('tin4=');
			d.getElementById('frm1801v2018:branchCode').value = tin4Val[1];

			var rdoVal = String(responseBG.innerHTML).split('rdo=');
			d.getElementById('frm1801v2018:txtRDOCode').value = rdoVal[1];

			var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
			d.getElementById('frm1801v2018:registeredAddress').value = unescape(regAddrVal[1]);

			var lobVal = String(responseBG.innerHTML).split('lob=');
			d.getElementById('frm1801v2018:txtLineBus').value = unescape(lobVal[1]);

			var zipVal = String(responseBG.innerHTML).split('zip=');
			d.getElementById('frm1801v2018:zipCode').value = zipVal[1];

			var telNoVal = String(responseBG.innerHTML).split('telNo=');
			d.getElementById('frm1801v2018:telephoneNumber').value = telNoVal[1];
		}
	}

	function createXMLProfileName() {
		try {
			var xmlFileName = "";

			var titleTin1 = d.getElementById('frm1801v2018:tinA');
			var titleTin2 = d.getElementById('frm1801v2018:tinB');
			var titleTin3 = d.getElementById('frm1801v2018:tinC');
			var titleBranchCode = d.getElementById('frm1801v2018:branchCode');
			var titleTPName = d.getElementById('frm1801v2018:registeredName');
			var formType = "1801v2018";

			xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";


			// "window.location='../BIRForms.hta?xmlReloadProfile=' + createXMLProfileName() + '&formTyp=1801v2018'"
			// alert(d.getElementById('frm1801v2018:tinA').value);

			return xmlFileName;
		} catch(e) {
			alert('Exception : '+e.description);
		}
	}

	function saveXMLProfile(isFinalCopy) {
		if (gIsReadOnly == false) {
			var xmlFileName = createXMLProfileName();

			msg.innerHTML='Generating File...';
			var fileSys = new ActiveXObject("Scripting.FileSystemObject");
			var xmlFile=fileSys.CreateTextFile(xmlFileName); //(saveWhere);

			var allXML = "<?xml version='1.0'?>",tab=d.getElementById('xmlFormat').innerHTML;
			allXML += tab; //adds line break
			allXML += "<div>fn="+escape(d.getElementById('frm1801v2018:registeredName').value)+"fn=</div>"+tab;
			allXML += "<div>tin1="+d.getElementById('frm1801v2018:tinA').value+"tin1=</div>"+tab;
			allXML += "<div>tin2="+d.getElementById('frm1801v2018:tinB').value+"tin2=</div>"+tab;
			allXML += "<div>tin3="+d.getElementById('frm1801v2018:tinC').value+"tin3=</div>"+tab;
			allXML += "<div>tin4="+d.getElementById('frm1801v2018:branchCode').value+"tin4=</div>"+tab;
			allXML += "<div>rdo="+d.getElementById('frm1801v2018:txtRDOCode').value+"rdo=</div>"+tab;
			allXML += "<div>lob="+escape(d.getElementById('frm1801v2018:txtLineBus').value)+"lob=</div>"+tab;
			allXML += "<div>regAddr="+escape(d.getElementById('frm1801v2018:registeredAddress').value)+"regAddr=</div>"+tab;
			allXML += "<div>zip="+d.getElementById('frm1801v2018:zipCode').value+"zip=</div>"+tab;
			allXML += "<div>telNo="+d.getElementById('frm1801v2018:telephoneNumber').value+"telNo=</div>"+tab;
			allXML += "<div>email="+document.getElementById('frm1801v2018:txtEmail').value+"email=</div>"+tab;allXML += "<div>confirmemail="+document.getElementById('frm1801v2018:txtEmail').value+"confirmemail=</div>"+tab;
			allXML += "<div>confirmtin1=" + d.getElementById('frm1801v2018:tinA').value + "confirmtin1=</div>" + tab;
			allXML += "<div>confirmtin2=" + d.getElementById('frm1801v2018:tinB').value + "confirmtin2=</div>" + tab;
			allXML += "<div>confirmtin3=" + d.getElementById('frm1801v2018:tinC').value + "confirmtin3=</div>" + tab;
			allXML += "<div>confirmtin4=" + d.getElementById('frm1801v2018:branchCode').value + "confirmtin4=</div>" + tab;
			allXML += "<div>formType=1801v2018formType=</div>"+tab;

			allXML += tab+d.getElementById('xmlClose').innerHTML;

			xmlFile.write(allXML);
			xmlFile.close();
			msg.innerHTML = '';

			if (isFinalCopy == false) {
				alert('Background information saved/updated successfully as : '+xmlFileName);
			}
		}
	}

	function cancel() {
		$('#bg').show();
		$('.printSignFooterClass').hide();
		$('.imgClass').hide();
		$('body').css('background','#FFF');

		$('#formPaper').css({'width':'920px', 'border':'#CCC 1px solid', 'margin':'0 auto', 'background':'#FFF' });
		$('#wrapper').css({'width':'920px', 'padding':'1%', 'margin':'0 auto'});
		$('#container').css({'width':'920px', 'padding':'1%', 'margin':'0 auto'});
		$('.labels').remove();

		var elem = document.getElementById('frmMain').elements;
		for(var i = 0; i < elem.length; i++) {
			if (elem[i].type != 'hidden') { // && elem[i].type != 'undefined'
				if (elem[i].type == 'text') {
					document.getElementById(elem[i].id).readOnly = false;
					document.getElementById(elem[i].id).style.height="15px";
					document.getElementById(elem[i].id).style.fontSize="12px";
					if(d.getElementById('frm1801v2018:cmdValidate').disabled == false){
						if (disabledItems.contains(elem[i].id))
							document.getElementById(elem[i].id).disabled = true;
						else
							document.getElementById(elem[i].id).disabled = false;
					}
					else{
						if (disabledItems.contains(elem[i].id))
							document.getElementById(elem[i].id).disabled = true;
						else
							document.getElementById(elem[i].id).disabled = false;
					}
				}

				if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
					if(d.getElementById('frm1801v2018:cmdValidate').disabled == false){
						if (disabledItems.contains(elem[i].id))
							document.getElementById(elem[i].id).disabled = true;
						else
							document.getElementById(elem[i].id).disabled = false;
					}
					else{
						if (disabledItems.contains(elem[i].id))
							document.getElementById(elem[i].id).disabled = true;
						else
							document.getElementById(elem[i].id).disabled = false;
					}
					document.getElementById(elem[i].id).style.height="15px";
					document.getElementById(elem[i].id).style.fontSize="11px";
				}
				
				if ( elem[i].type == 'select-one'){
					$( elem[i] ).show();
				}
			}
		}

		$('input').each(function(){
			if (this.type == 'button') {
				if (this.id != 'test') {
					$(this).removeClass('previewButtonClass');
				}
			}
		});

		$('a').each(function(){
			if (this.id.length > 1) {
				if(d.getElementById('frm1801v2018:cmdValidate').disabled == false){
					if (enableElem)
						d.getElementById(this.id).disabled = true;
					else if(disableElem)
						d.getElementById(this.id).disabled = false;
				}
				else{
					if (disableElem)
						d.getElementById(this.id).disabled = true;
					else if(enableElem)
						d.getElementById(this.id).disabled = false;
				}
			}
		});

		$('#formMenu').show('blind');
		if ( $('#printMenu').css('display') != 'none' ) {
			$('#printMenu').hide('blind');
		}
		// if (qs('xmlFileName') != null && qs('xmlFileName').indexOf('.xml') > -1) {
		// 	d.getElementById('frm1801v2018:txtDateMonth').disabled = true;
		// 	d.getElementById('frm1801v2018:txtDateYear').disabled = true;
		// 	d.getElementById('frm1801v2018:txtDateDay').disabled = true;
		// }
	}
	
	Array.prototype.contains = Array.prototype.indexOf ?
	function(val) {
		return this.indexOf(val) > -1;
	} :
	function(val) {
		var i = this.length;
		while (i--) {
			if (this[i] === val) {
				return true;
			}
		}
		return false;
	};

	var disabledItems = new Array();
	function printme() {
		$('#bg').hide(); //920
		$('.printSignFooterClass').css({ 'width':'94%','margin':'auto','margin-top':'15px','display':'block','position':'relative','overflow':'visible','page-break-before':'always' });
		$('.imgClass').css({ 'margin':'auto','display':'block','position':'relative','overflow':'visible' });
		$('body').css('background','#FFF');

		$('#formPaper').css({'max-width':'8.3in !important', 'border':'#000 3px solid' });
		$('#wrapper').css({'max-width':'8.3in !important'});
		$('#container').css({'max-width':'8.3in !important'});

		var elem = document.getElementById('frmMain').elements;
		var x=0;
		disabledItems = new Array();
		for(var i = 0; i < elem.length; i++) {
			if (elem[i].type != 'hidden') { // && elem[i].type != 'undefined'
				if (elem[i].type == 'text') {
					if (document.getElementById(elem[i].id).disabled) {
						disabledItems[x] = elem[i].id;
						x++;
					}
					document.getElementById(elem[i].id).disabled = false;
					document.getElementById(elem[i].id).readOnly = true;
					document.getElementById(elem[i].id).style.backgroundColor = '#FFFFFF';
					document.getElementById(elem[i].id).style.color = '#000000';
					document.getElementById(elem[i].id).style.height="9px";
					document.getElementById(elem[i].id).style.fontSize="8px";
				}
				if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
					if (document.getElementById(elem[i].id).disabled) {
						disabledItems[x] = elem[i].id;
						x++;
					}
					document.getElementById(elem[i].id).disabled = true;
					document.getElementById(elem[i].id).style.height="9px";
					document.getElementById(elem[i].id).style.fontSize="8px";
				}
				if(elem[i].type == 'select-one'){
					$( elem[i] ).hide();
					var label = "<div class='labels'>".concat(elem[i].options[elem[i].selectedIndex].innerHTML).concat("&nbsp;</div>");
					$( elem[i] ).after(label);
				}
			}
		}

		$('input').each(function(){
			if (this.type == 'button') {
				if (this.id != 'test') {
					$(this).addClass('previewButtonClass');
				}
			}
		});

		$('a').each(function(){
			if (this.id.length > 1) {
				d.getElementById(this.id).disabled = true;
			}
		});

		$('#printMenu').show('blind');
		if ( $('#formMenu').css('display') != 'none' ) {
			$('#formMenu').hide('blind');
		}

		document.getElementById('frm1801v2018:txtCurrentPage').disabled = false;
		document.getElementById('frm1801v2018:txtCurrentPage').readOnly = false;
	}

	$(document).ready(function(){
		$("ul.subnav").parent().append("<span></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)
		$("ul.topnav li span").click(function() { //When trigger is clicked...
			//Following events are applied to the subnav itself (moving subnav up and down)
			$(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click
			$(this).parent().hover(function() {
			}, function(){
