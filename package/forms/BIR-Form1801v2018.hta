		if( (d.getElementById('frm1801v2018:txtRDOCode_1').selectedIndex == 0) ){
			alert("Please enter a valid RDO Code on Item 6.");
			return;
		}
		if( (d.getElementById('frm1801v2018:registeredName_1').value == "") ){
			alert("Please enter a valid Taxpayer's Name on Item 7.");
			return;
		}
		if( (d.getElementById('frm1801v2018:registeredAddress_1').value == "") ){
			alert("Please enter Taxpayer's Resident of Decedent on Item 8.");
			return;
		}
		if(d.getElementById('frm1801v2018:categoryNonResident_1').checked == false && d.getElementById('frm1801v2018:categoryNonResident_2').checked == false){
			alert("Please select an option for Item 9.");
			return;
		}
		if( (d.getElementById('frm1801v2018:telephoneNumber').value == "") ){
			alert("Please enter a valid Telephone Number on Item 12.");
			return;
		}

		if( (d.getElementById('frm1801v2018:instGranted_1').checked)){
			if(!(d.getElementById('frm1801v2018:freq_Mon').checked) &&
				!(d.getElementById('frm1801v2018:freq_Qtr').checked) &&
				!(d.getElementById('frm1801v2018:freq_Semi').checked) &&
				!(d.getElementById('frm1801v2018:freq_Other').checked)){
				
				alert("Please select a frequency of payment on Item 15D.");
				return;
			}

			if(d.getElementById('frm1801v2018:freq_Other').checked && d.getElementById('frm1801v2018:freqOtherInput').value == ""){
				alert("Please specify a frequency of payment on Item 15D - Others.");
				return;
			}
		}

		if(d.getElementById('frm1801v2018:categoryNonResident_1').checked && NumWithComma(d.getElementById('frm1801v2018:txtStandardDed_C').value) > 500000){
			alert('If Yes is selected on Item 9, value should not exceed Php500 Thousand on Item 37A.');
			return;
		}else if(d.getElementById('frm1801v2018:categoryNonResident_2').checked && NumWithComma(d.getElementById('frm1801v2018:txtStandardDed_C').value) > 5000000){
			alert('If No is selected on Item 9, value should not exceed Php5 Million on Item 37A.');
			return;
		}

		if(NumWithComma(d.getElementById('frm1801v2018:txtFamDed_C').value) > 10000000){
			alert("Value should not exceed Php10 Million on Item 37B.");
			return;
		}

		var rows = getElementsByClassName(d.getElementById('tbl_RealProp'), 'dataRow');
		var rows2 = getElementsByClassName(d.getElementById('tbl_RealProp_2'), 'dataRow');
		var check = 0; // 0 = not set; 1 = blank; 2 = has value

		for(var x = 0; x < rows.length; x++){
			// REAL PROP
			for(var y = 0; y < rows[x].cells.length; y++){
				var value = rows[x].cells[y].firstChild.value;

				if(rows[x].cells[y].firstChild.tagName == "SELECT" && rows[x].cells[y].firstChild.selectedIndex == 0)
					value = "";

				if(value != "0.00"){
					if(check == 0){
						check = (value == "") ? 1 : 2;
					}else if((check == 1 && value != "") || (check == 2 && value == "")){
						alert("Incomplete values on Schedule 1, Row " + (x+1) + ".");
						return;
					}
				}
			}

