	function getNumericValue(id) {
        var rawValue = document.getElementById(id).value;
        var cleanedValue = rawValue.replace('%', '').replace(/^\s+|\s+$/g, '');
        return parseFloat(cleanedValue);
    }

	// COMPUTE NUMBER 18
	function computeNo18() {

		var estateValue = parseFloat(d.getElementById('frm1801v2018:txtTaxableEstate').value.replace(/,/g, ''));
		if (!isNaN(estateValue) && estateValue > 0) {
    		//orig: d.getElementById('frm1801v2018:txtEstTaxDue').value = formatCurrency(estateValue * 0.06);
			// id="frm1801v2018:txtTaxRate"
			d.getElementById('frm1801v2018:txtEstTaxDue').value = formatCurrency(estateValue * (getNumericValue('frm1801v2018:txtTaxRate') / 100));
		} 		
		else {
    		d.getElementById("frm1801v2018:txtEstTaxDue").value = "0.00";
		}
		calculate_Part2();
		// d.getElementById('frm1801v2018:txtEstTaxDue').value = formatCurrency(NumWithComma( ) * 0.06); 

		// if (d.getElementById('frm1801v2018:txtEstTaxDue').value < 1) {
		// 	d.getElementById("frm1801v2018:txtEstTaxDue").value = "0.00";
		// } else {
		// }
	}



