				if(rows[x].cells[y].firstChild.tagName == "SELECT" && rows[x].cells[y].firstChild.selectedIndex == 0)
					value = "";

				if(value != "0.00"){
					if(check == 0){
						check = (value == "") ? 1 : 2;
					}else if((check == 1 && value != "") || (check == 2 && value == "")){
						alert("Incomplete values on Schedule 4, Row " + (x+1) + ".");
