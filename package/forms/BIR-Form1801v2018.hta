	function addZeroPadding(e){
		if(e.value.length == 1)
			e.value = "0" + e.value
	}

	function formatCurrency(number){
		return number.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",")
	}

	function NumWithComma(value){
		return parseFloat(value.replace(/,/g, ''));
	}

	function installmentGranted(){
		var isEnabled = !(d.getElementById('frm1801v2018:instGranted_1').checked);
		isInstallment = !isEnabled;
		
		d.getElementById('frm1801v2018:freq_Mon').disabled = isEnabled;
		d.getElementById('frm1801v2018:freq_Qtr').disabled = isEnabled;
		d.getElementById('frm1801v2018:freq_Semi').disabled = isEnabled;
		d.getElementById('frm1801v2018:freq_Other').disabled = isEnabled;
		freqOtherChecked();
		calculate_Part2();
	}

	function setCredits_TaxPrev(){
		d.getElementById('frm1801v2018:txtCredits_TaxPrev').disabled = !(d.getElementById('frm1801v2018:amendedRtn_1').checked);
	}


	function changeTreaty(){
		d.getElementById('frm1801v2018:treatyY').disabled = !(d.getElementById('frm1801v2018:optTreaty_1').checked);
