	function calculate_Part2(){

		
		//sum 19C
		d.getElementById("frm1801v2018:txtCredits_Tot").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtCredits_ForeignEst").value) + NumWithComma(d.getElementById("frm1801v2018:txtCredits_TaxPrev").value));
		//Less 20
		d.getElementById("frm1801v2018:txtTaxPayable").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtEstTaxDue").value) - NumWithComma(d.getElementById("frm1801v2018:txtCredits_Tot").value));
		//Less 22
		d.getElementById("frm1801v2018:txtTaxPayable_1st").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtTaxPayable").value) - NumWithComma(d.getElementById("frm1801v2018:txtInstallment").value));
		//Sum 23D
		d.getElementById("frm1801v2018:txtPen_Tot").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtPen_Surcharge").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtPen_Interest").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtPen_Compromise").value));

		   var totalTaxPayable22 = parseFloat(d.getElementById("frm1801v2018:txtTaxPayable_1st").value.replace(/,/g, '')) || 0;
   	       var totalTaxPayable23D = parseFloat(d.getElementById("frm1801v2018:txtPen_Tot").value.replace(/,/g, '')) || 0;
		var totalPayable2223D = (totalTaxPayable22) + (totalTaxPayable23D);
		
		if (totalTaxPayable22 < 0 && totalTaxPayable23D > 0)
		{
			d.getElementById("frm1801v2018:txtTotPayable").value = formatCurrency(totalTaxPayable23D);
		}
		
		else {

			d.getElementById("frm1801v2018:txtTotPayable").value = formatCurrency(totalPayable2223D);
		}
		
	}


	function calculate_Part4(){
		d.getElementById("frm1801v2018:txtRealProp_A").value = d.getElementById("frm1801v2018:sched1Exc_Total").value;
		d.getElementById("frm1801v2018:txtRealProp_B").value = d.getElementById("frm1801v2018:sched1Conj_Total").value;
		d.getElementById("frm1801v2018:txtRealProp_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtRealProp_A").value) + NumWithComma(d.getElementById("frm1801v2018:txtRealProp_B").value));

		d.getElementById("frm1801v2018:txtFam_A").value = d.getElementById("frm1801v2018:sched1AExc_Total").value;
		d.getElementById("frm1801v2018:txtFam_B").value = d.getElementById("frm1801v2018:sched1AConj_Total").value;
		d.getElementById("frm1801v2018:txtFam_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtFam_A").value) + NumWithComma(d.getElementById("frm1801v2018:txtFam_B").value));

		d.getElementById("frm1801v2018:txtPersonalProp_A").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:sched2Exc_Total").value) + NumWithComma(d.getElementById("frm1801v2018:sched2AExc_Total").value));
		d.getElementById("frm1801v2018:txtPersonalProp_B").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:sched2Conj_Total").value) + NumWithComma(d.getElementById("frm1801v2018:sched2AConj_Total").value));
		d.getElementById("frm1801v2018:txtPersonalProp_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtPersonalProp_A").value) + NumWithComma(d.getElementById("frm1801v2018:txtPersonalProp_B").value));

		d.getElementById("frm1801v2018:txtTaxable_A").value = d.getElementById("frm1801v2018:sched3Exc_Total").value;
		d.getElementById("frm1801v2018:txtTaxable_B").value = d.getElementById("frm1801v2018:sched3Conj_Total").value;
		d.getElementById("frm1801v2018:txtTaxable_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtTaxable_A").value) + NumWithComma(d.getElementById("frm1801v2018:txtTaxable_B").value));

		d.getElementById("frm1801v2018:txtBusiness_A").value = d.getElementById("frm1801v2018:sched4Exc_Total").value;
		d.getElementById("frm1801v2018:txtBusiness_B").value = d.getElementById("frm1801v2018:sched4Conj_Total").value;
		d.getElementById("frm1801v2018:txtBusiness_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtBusiness_A").value) + NumWithComma(d.getElementById("frm1801v2018:txtBusiness_B").value));

		d.getElementById("frm1801v2018:txtGrossEst_A").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtRealProp_A").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtFam_A").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtPersonalProp_A").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtTaxable_A").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtBusiness_A").value));
		d.getElementById("frm1801v2018:txtGrossEst_B").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtRealProp_B").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtFam_B").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtPersonalProp_B").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtTaxable_B").value) +
			NumWithComma(d.getElementById("frm1801v2018:txtBusiness_B").value));
		d.getElementById("frm1801v2018:txtGrossEst_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtGrossEst_A").value) + NumWithComma(d.getElementById("frm1801v2018:txtGrossEst_B").value));

		d.getElementById("frm1801v2018:txtOrdDed_A").value = d.getElementById("frm1801v2018:sched5Exc_Total").value;
		d.getElementById("frm1801v2018:txtOrdDed_B").value = d.getElementById("frm1801v2018:sched5Conj_Total").value;
		d.getElementById("frm1801v2018:txtOrdDed_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtOrdDed_A").value) + NumWithComma(d.getElementById("frm1801v2018:txtOrdDed_B").value));

		d.getElementById("frm1801v2018:txtEstAfterDed_A").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtGrossEst_A").value) - NumWithComma(d.getElementById("frm1801v2018:txtOrdDed_A").value));
		d.getElementById("frm1801v2018:txtEstAfterDed_B").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtGrossEst_B").value) - NumWithComma(d.getElementById("frm1801v2018:txtOrdDed_B").value));
		d.getElementById("frm1801v2018:txtEstAfterDed_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtEstAfterDed_A").value) + NumWithComma(d.getElementById("frm1801v2018:txtEstAfterDed_B").value));

		d.getElementById("frm1801v2018:txtTotalDed_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtStandardDed_C").value) + NumWithComma(d.getElementById("frm1801v2018:txtFamDed_C").value) + NumWithComma(d.getElementById("frm1801v2018:txtOtherDed_C").value));	

		d.getElementById("frm1801v2018:txtNetEst_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtEstAfterDed_C").value) - NumWithComma(d.getElementById("frm1801v2018:txtTotalDed_C").value));
		
		d.getElementById("frm1801v2018:txtShareSpouse_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtEstAfterDed_B").value) / 2);

		d.getElementById("frm1801v2018:txtNetTaxEst_C").value = formatCurrency(NumWithComma(d.getElementById("frm1801v2018:txtNetEst_C").value) - NumWithComma(d.getElementById("frm1801v2018:txtShareSpouse_C").value));

		d.getElementById("frm1801v2018:txtTaxableEstate").value = d.getElementById("frm1801v2018:txtNetTaxEst_C").value;

		calculate_Part2();
		computeNo18();
	}

	function getRealProp_totals(){
		var exc = 0;
		var conj = 0;

		for(var x = 1; x <= count_RealProp; x++){
			exc += NumWithComma(d.getElementById("frm1801v2018:sched1Exc_" + x).value);
			conj += NumWithComma(d.getElementById("frm1801v2018:sched1Conj_" + x).value);	
		}

		d.getElementById("frm1801v2018:sched1Exc_Total").value = formatCurrency(exc);
		d.getElementById("frm1801v2018:sched1Conj_Total").value = formatCurrency(conj);
		calculate_Part4();
	}

