																		<input id="frm1801v2018:txtDateDay" name="frm1801v2018:txt[DateDay]" maxlength="2" size="1" type="text" onKeyPress="return wholenumber(this, event)" onblur="addZeroPadding(this); enableSaveButton();" value="" />

																		<input id="frm1801v2018:txtDateYear" name="frm1801v2018:txt[DateYear]" maxlength="4" size="1" type="text" onKeyPress="return wholenumber(this, event);" onblur="addZeroPadding(this);enableSaveButton();" value="" />
																	</td>
																</tr>
															</table>
														</td>
														<td width="30%" class="tblFormTd">
															<table width="100%" border="0" cellspacing="0" cellpadding="0">
																<tr>
																	<td width="8%"><font size="2" style="font-weight:bold;">&nbsp;2</font></td>
																	<td width="32%"><font size="1">Amended Return?</font></td>
																	<td width="60%">
