		// 	return;
		// }
		// if(document.getElementById('frm1801v2018:txtDateMonth').value.length == 1 || document.getElementById('frm1801v2018:txtDateDay').value.length == 1)
		// {
		// 	alert("Please enter a valid day/month on item 1. Format should be MM/DD/YYYY.")
		// 	return;
		// }
		// if( (document.getElementById('frm1801v2018:txtDateDay').value == "") )
		// {
		// 	alert("Please enter a valid day on Item 1.");
		// 	return;
		// }
		// if( (document.getElementById('frm1801v2018:txtDateYear').value == "") )
		// {
		// 	alert("Please enter a valid year on Item 1.");
		// 	return;
		// }

		// if(document.getElementById('frm1801v2018:txtDateDay').value < 1){
		// 	alert("Please enter a valid day in Item 1.");
		// 	return;
		// }

		// var month31 = (['01', '03', '05', '07', '08', '10', '12']);
		// var month30 = (['04', '06', '09', '11']);
		// var month = document.getElementById('frm1801v2018:txtDateMonth').value
		// if (month31.contains(month) && document.getElementById('frm1801v2018:txtDateDay').value > 31)
		// {
		// 	alert("Invalid date entry on Item no.1.");
		// 	return;
		// }
		// else if (month30.contains(month) && document.getElementById('frm1801v2018:txtDateDay').value > 30)
		// {
		// 	alert("Invalid date entry on Item no.1.");
		// 	return;
		// }

		// if( document.getElementById('frm1801v2018:txtDateYear').value*1 < 1904 )
		// {
		// 	alert("Invalid date entry on Item no.1. Entry should not be lower than 1904.")
		// 	return;
		// }







		var month = parseInt(d.getElementById("frm1801v2018:txtDateMonth").value, 10);
		var day = parseInt(d.getElementById("frm1801v2018:txtDateDay").value, 10);
		var year = d.getElementById("frm1801v2018:txtDateYear").value;

		var inputDate = new Date(year, month-1, day);
		var currDate = new Date();
		currDate.setHours(0, 0, 0, 0);

		var maxDay = 0;
		switch(month - 1){
			case 1 :
				maxDay = (year % 4 == 0 && year % 100) || year % 400 == 0 ? 29 : 28;
				break;
			case 8 : case 3 : case 5 : case 10 :
				maxDay = 30;
				break;
			default :
				maxDay = 31
		}

		if(month == "" || month < 1 || month > 12){
			alert("Please enter a valid month on Item 1.");
			return;
		}

		if(maxDay == 28 && day > maxDay){
			alert("Please enter a valid date on Item 1. Filing year is not a leap year.");
			return;
		}

		if(day == "" || day < 1 || day > maxDay){
			alert("Please enter a valid day on Item 1.");
			return;
		}

		if(year == ""){
			alert("Please enter a valid year on Item 1.");
			return;
		}

		if(year < 1904){
			alert("Invalid date entry on Item 1. Entry should not be lower than 1904.");
			return;
		}

		if(inputDate.valueOf() > currDate.valueOf()){
			alert("Invalid date entry on Item 1. Date cannot be after the current date.");
			return;
		}



		if( (d.getElementById('frm1801v2018:tinA_1').value == "" || d.getElementById('frm1801v2018:tinB_1').value == "" || d.getElementById('frm1801v2018:tinC_1').value == "" || d.getElementById('frm1801v2018:branchCode_1').value == "") ){
