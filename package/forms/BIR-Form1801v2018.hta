																					<label for="frm1801v2018:freq_Semi"><font size="1">Semi-Annual</font></label>
																				</td>

																				<td>
																					<!-- <label><font size="1"><input type="checkbox" id="frm1801v2018:freqOther" disabled onchange="freqOtherChecked()">Others (specify)</font></label> -->
																					<!-- <label><font size="1"><input type="checkbox" id="frm1801v2018:freqOther" disabled onclick="freqOtherChecked()">Others (specify)</font></label> -->
																					<input id="frm1801v2018:freq_Other" name="frm1801v2018:freq" type="radio" value="Others" onclick="freqOtherChecked()" disabled/>
																					<label for="frm1801v2018:freq_Other"><font size="1">Others</font></label>
																				</td>

																				<td colspan="3">
																					<input type="text" value="" name="frm1801v2018:freqOtherInput" id="frm1801v2018:freqOtherInput" size="20" disabled/>
