	function delRow_RealProp(){
		if(count_RealProp > 2){
			count_RealProp--;

			// REAL PROP
			var tbl = d.getElementById('tbl_RealProp').getElementsByTagName('tbody')[0];
			tbl.deleteRow(tbl.rows.length-1);

			// REAL PROP - CONT
			tbl = d.getElementById('tbl_RealProp_2').getElementsByTagName('tbody')[0];
			tbl.deleteRow(tbl.rows.length-2);
			getRealProp_totals();
		}
	}

