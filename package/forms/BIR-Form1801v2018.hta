																				</td>
																				<td>
																					<input id="frm1801v2018:fileGranted_2" name="frm1801v2018:fileGranted" type="radio" value="N" checked/>
																				</td>

																				<td colspan="4">
																					<font size="2" style="font-weight:bold;">&nbsp;15D&nbsp;</font>
																					<font size="1">Has an installment payment been granted?</font>
																				</td>

																				<td>
																					<input id="frm1801v2018:instGranted_1" name="frm1801v2018:instGranted" type="radio" value="Y" onclick="installmentGranted()"/>
																				</td>
																				<td>
																					<input id="frm1801v2018:instGranted_2" name="frm1801v2018:instGranted" type="radio" value="N" checked onclick="installmentGranted()"/>
																				</td>

																				<td></td>
																			</tr>


																			<tr>
																				<td>
																					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
																					<font size="2" style="font-weight:bold;">&nbsp;15B&nbsp;</font>
																					<font size="1">Has the estate been settled judicially?</font>
																				</td>

																				<td>
