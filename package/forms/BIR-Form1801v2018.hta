xmlFileForCreate2X = new Date();
	//getURL() is defined in string-util.js
	var rbURL = getURL();
	function createRecord () {

	createURL = rbURL + "/rest/api/create2?sessionId="+sessionId+"&objName=upload1&tp_zip="+p3TPZip+"&tp_addr="+p3TPAddress+"&tp_telnum="+p3TPTelNum+"&tp_name="+p3TPName+"&tp_rdo_code="+p3TPRDOCode+"&tp_branch_code="+p3TPBranchCode+"&tp_tin="+p3TPTIN+"&is_amended_return="+p3IsAmended+"&return_period="+p3ReturnPeriod+"&return_period_end="+p3ReturnPeriodEnd+"&useIds=false&form_type_text=1801v2018-Jul2008&load="+xmlFileForCreate2X; //FOR create2

	// xmlHttp.open( "GET", encodeURI(createURL), true); //xxx
	// xmlHttp.send(null);

	xmlHttp.open( "POST", createURL, false);
	xmlHttp.send();

	var respXMLMsg = xmlHttp.responseText;

	create2Id = respXMLMsg;
	create2Id = create2Id.split('id=');
	create2Id = String(create2Id[1]).replace(/"/gi,'');
	create2Id = String( parseInt(create2Id) ).replace(/ /,'');

	//alert("Form ID : '"+create2Id+"' successfully created!");
	x.document.theForm.submit();
	uploadXMLFile();
}

