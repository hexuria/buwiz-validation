    function computePenalties() {

        var tax35 = formatCurrency((NumWithComma(d.getElementById("frm0620:txtTax17A").value) * 1 + NumWithComma(d.getElementById("frm0620:txtTax17B").value) * 1 + NumWithComma(d.getElementById("frm0620:txtTax17C").value) * 1).toFixed(2));
        d.getElementById("frm0620:txtTax17D").value = formatCurrency(tax35);
        computeTaxAmountStillDue();
        computeRemittance();
    }

    function computeRemittance() {
        //check if item 16 <=0
        if(formatCurrency((NumWithComma(d.getElementById("frm0620:txtTax16").value) * 1).toFixed(2))<0 || (NumWithComma(d.getElementById("frm0620:txtTax16").value) * 1).toFixed(2)<=-1000){
            //alert("<");
            //d.getElementById("frm0620:txtTax16").value = 0;
            var tax18 = formatCurrency((NumWithComma(d.getElementById("frm0620:txtTax17D").value) * 1).toFixed(2));
            d.getElementById("frm0620:txtTax18").value = formatCurrency(tax18);
        }else{
            var tax18 = formatCurrency((NumWithComma(d.getElementById("frm0620:txtTax16").value) * 1 + NumWithComma(d.getElementById("frm0620:txtTax17D").value) * 1).toFixed(2));
            d.getElementById("frm0620:txtTax18").value = formatCurrency(tax18);
        }
        


    }

    function compute16() {

        var tax16 = formatCurrency((NumWithComma(d.getElementById("frm0620:txtTax14").value) * 1 - NumWithComma(d.getElementById("frm0620:txtTax15").value) * 1).toFixed(2));
        d.getElementById("frm0620:txtTax16").value = formatCurrency(tax16);

        computeRemittance();
    }

