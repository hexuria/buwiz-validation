    function enableItem14(enable) {
        var field = document.getElementById("frm0620:txtTax14");
        field.disabled = !enable;
    }

    // ✅ New validation: Month and Year of Due date shall not be inputtable. Due shall be set every 10th day of the following month, but the date may be editable 020926
    function setDueDateFromPeriod() {
        var month = Number(d.getElementById("frm0620:txtMonth").value);
        var year = Number(d.getElementById("frm0620:txtYear").value);

        if (!month || !year) {
            return; 
        }

        // next month logic
        var dueMonth = month + 1;
        var dueYear = year;

        if (dueMonth === 13) {
            dueMonth = 1;
            dueYear++;
        }

        // pad month
        dueMonth = dueMonth < 10 ? "0" + dueMonth : String(dueMonth);

        d.getElementById("frm0620:txtDueMonth").value = dueMonth;
        d.getElementById("frm0620:txtDueYear").value = dueYear;

        // default day = 10 (but user can change later)
        d.getElementById("frm0620:txtDueDate").value = "10";
    }

    function validateMonthYear(element) {
        var strmmddyyyy = element.value;
        var isValid = true;
        var currentDate = new Date();
        var inputDate = new Date();

        if (strmmddyyyy != "") {
            var result = strmmddyyyy.split("/");
            var isLeap = new Date(result[1], 1, 29).getMonth() === 1;
            var month31 = (['01', '03', '05', '07', '08', '10', '12']);
            var month30 = (['04', '06', '09', '11']);
            var month = result[0];
            if (result.length === 2) {
                if (isNaN(result[0] || result[1])) {
                    isValid = false;
                }
                else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 1))) {
                    // numeric check if greater not than 31 - Month.
                    isValid = false;
                }
                else if (result[1].length != 4) {
                    isValid = false;
                }

                inputDate = new Date(result[1], month - 1);
            }
            else {
                isValid = false;
            }
        }

        if (!isValid) {
            alert('Please provide a valid date. (MM/YYYY format)');
            element.value = '';
            element.focus();
        }
        else if (inputDate > currentDate) {
            alert('This date cannot be a future date.');
            element.value = '';
            element.focus();
        }

        return isValid;
    }

    function validateDate(element) {
        var strmmddyyyy = element.value;
        var isValid = true;
        var currentDate = new Date();
        var inputDate = new Date();

        if (strmmddyyyy != "") {
            var result = strmmddyyyy.split("/");
            var isLeap = new Date(result[2], 1, 29).getMonth() === 1;
            var month31 = (['01', '03', '05', '07', '08', '10', '12']);
            var month30 = (['04', '06', '09', '11']);
            var month = result[0];
            var day = result[1];
            if (result.length === 3) {
                if (isNaN(result[0] || result[1] || result[2])) {
                    isValid = false;
                }
                else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 1))) {
                    // numeric check if greater not than 31 - Month.
                    isValid = false;
                }
                else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
                    // numeric check if Date.
                    isValid = false;
                }
                else if (result[2].length != 4) {
                    isValid = false;
                }
                else if (month == 2) {
                    if (!isLeap && day == 29) {
                        isValid = false;
                    }
                    else if (!isLeap && day > 29) {
                        isValid = false;
                    }
                    else if (isLeap && day > 29) {
                        isValid = false;
                    }
                }
                else if (month31.contains(month) && day > 31) {
                    isValid = false;
                }
                else if (month30.contains(month) && day > 30) {
                    isValid = false;
                }

                inputDate = new Date(result[2], month - 1, day);
            }
            else {
                isValid = false;
            }
        }

        if (!isValid) {
            alert('Please provide a valid date. (MM/DD/YYYY format)');
            element.value = '';
            element.focus();
        }
        else if (inputDate > currentDate) {
            alert('This date cannot be a future date.');
            element.value = '';
            element.focus();
        }

        return isValid;
    }

    function validateRtnPeriod() {

        var date = new Date();

        if (d.getElementById("frm0620:txtYear").value < 2019) {
            alert("Please file using the old version of the form.");
            d.getElementById("frm0620:txtYear").value = "2019";
        }
        if (d.getElementById("frm0620:txtMonth").selectedIndex > date.getMonth() && d.getElementById('frm0620:txtYear').value == date.getFullYear()) {
            alert("Invalid month. Month should not be later than the current month.");
            d.getElementById("frm0620:txtMonth").selectedIndex = date.getMonth();
            return;
        }
        if (d.getElementById("frm0620:txtYear").value > date.getFullYear()) {
            alert("Invalid year. Year should not be later than the current year.");
            d.getElementById("frm0620:txtYear").value = date.getFullYear();
            return;
        }
    }

    function validate() {
        var a;
        var dt = new Date();
        if (d.getElementById('frm0620:txtYear').value == "") {
            alert("Please enter a valid year on Item 1."); return;
        }
        // if (d.getElementById("frm0620:txtMonth").selectedIndex > dt.getMonth()) {
        //     alert("Invalid month. Month should not be later than the current month.");
        //     d.getElementById("frm0620:txtMonth").selectedIndex = dt.getMonth();
        //     return;
        // }
        // if (d.getElementById("frm0620:txtYear").value > dt.getFullYear()) {
        //     alert("Invalid year. Year should not be later than the current year.");
        //     d.getElementById("frm0620:txtYear").value = dt.getFullYear();
        //     return;
        // }
        if (d.getElementById('frm0620:txtYear').value > dt.getFullYear()) {
            alert("Invalid year. Year should not be later than the current year.");
            d.getElementById("frm0620:txtYear").value = dt.getFullYear();
            return;
            //alert("Invalid date entry on Item no.1. Entry should not be later than Current Date."); return;
        }
        if (d.getElementById('frm0620:txtMonth').selectedIndex > dt.getMonth() && d.getElementById('frm0620:txtYear').value == dt.getFullYear()) {
            alert("Invalid month. Month should not be later than the current month.");
            d.getElementById("frm0620:txtMonth").selectedIndex = dt.getMonth();
            return;
            //alert("Invalid date entry on Item no.1. Entry should not be later than Current Date."); return;
        }
        if (!d.getElementById('frm0620:TaxWithheld_1').checked && !d.getElementById('frm0620:TaxWithheld_2').checked) {
            alert("Please select an option for Item 3.")
            return;
        }

        if ((d.getElementById('frm0620:txtTIN1').value == "" || d.getElementById('frm0620:txtTIN2').value == "" || d.getElementById('frm0620:txtTIN3').value == "" || d.getElementById('frm0620:txtBranchCode').value == "")) {
            alert("Please enter a valid TIN number on Item 6.");
            return;
        }
        //if( (d.getElementById('frm0620:txtRDOCode').value == "")  )
        if ((d.getElementById('frm0620:txtRDOCode').selectedIndex == 0)) {
            alert("Please enter a valid RDO Code on Item 7.");
            return;
        }
        // if( (d.getElementById('frm0620:txtLineBus').value == "")  )
        // {
        //     alert("Please enter a valid Line of Business/Occupation on Item 7.");
        //     return;
        // }	
        if ((d.getElementById('frm0620:txtTaxpayerName').value == "")) {
            alert("Please enter a valid Witholding Agent's Name on Item 8.");
            return;
        }
        if ((d.getElementById('frm0620:txtTelNum').value == "")) {
            alert("Please enter a valid Telephone Number on Item 10.");
            return;
        }
        if ((d.getElementById('frm0620:txtAddress').value == "")) {
            alert("Please enter Taxpayer's Registered Address on Item 9.");
            return;
        }
        if ((d.getElementById('frm0620:txtZipCode').value == "")) {
            alert("Please enter Taxpayer's Zip Code on Item 9A.");
            return;
        }
        if (!d.getElementById('frm0620:CatAgent_P').checked && !d.getElementById('frm0620:CatAgent_G').checked) {
            alert("Please select an option for Item 12.");
            //<a href="" id="frm0620:CatAgent_P" onclick="processPrev();">&nbsp;(To Part II Item 14)</a> 
            //d.getElementById('frm0620:CatAgent_P').focus
            d.getElementById('frm0620:txtYear').focus({ preventScroll: false });
            d.getElementById('frm0620:CatAgent_G').focus();
            return;

        }
        /*if (d.getElementById('frm0620:TaxWithheld_1').checked) {
            if (d.getElementById('frm0620:txtTax14').value == 0 || d.getElementById('frm0620:txtTax14').value == 0.00) {
                alert("Invalid amount in Item no.14. Value must be greater than zero(0)."); return;
            }

        }*/


        // 	if(d.getElementById('frm0620:sched1:SelMonthYear1_1').checked || d.getElementById('frm0620:sched1:SelMonthYear1_2').checked) 
        // {
        // 		if(d.getElementById('frm0620:sched1:TxtMonthYearRadio1').value == "" || d.getElementById('frm0620:sched1:TxtDatePaidRadio1').value == "" || d.getElementById('frm0620:sched1:TxtRORNoRadio1').value == "" || d.getElementById('frm0620:sched1:TxtBankCodeRadio1').value == "")
        // 		{
        // 			alert("Please complete details on Section A.");
        // 			return;
        // 		}
        // }
        // if(d.getElementById('frm0620:sched1:SelMonthYear2_1').checked || d.getElementById('frm0620:sched1:SelMonthYear2_2').checked)
        // {
        // 		if(d.getElementById('frm0620:sched1:TxtMonthYearRadio2').value == "" || d.getElementById('frm0620:sched1:TxtDatePaidRadio2').value == "" || d.getElementById('frm0620:sched1:TxtRORNoRadio2').value == "" || d.getElementById('frm0620:sched1:TxtBankCodeRadio2').value == "")
        // 		{
        // 			alert("Please complete details on Section A, row 2.");
        // 			return;
        // 		}
        // }
        // if(d.getElementById('frm0620:sched1:SelMonthYear3_1').checked || d.getElementById('frm0620:sched1:SelMonthYear3_2').checked)
        // {
        // 		if(d.getElementById('frm0620:sched1:TxtMonthYearRadio3').value == "" || d.getElementById('frm0620:sched1:TxtDatePaidRadio3').value == "" || d.getElementById('frm0620:sched1:TxtRORNoRadio3').value == "" || d.getElementById('frm0620:sched1:TxtBankCodeRadio3').value == "" )
        // 		{
        // 		alert("Please complete details on Section A, row 3.");
        // 		return;
        // 		}
        // }

        disableAllControl();

        alert("Validation successful. Click on Edit if you wish to modify your entries.");
        return;
    }

    function enableAllControl() {
        d.getElementById('frm0620:txtMonth').disabled = false;
        d.getElementById('frm0620:txtYear').disabled = false;
        d.getElementById('frm0620:txtDueMonth').disabled = false;
        d.getElementById('frm0620:txtDueYear').disabled = false;
        d.getElementById('frm0620:txtDueDate').disabled = false;


        d.getElementById('frm0620:TaxWithheld_1').disabled = false;
        d.getElementById('frm0620:TaxWithheld_2').disabled = false;
        d.getElementById('frm0620:AmendedRtn_1').disabled = false;
        d.getElementById('frm0620:AmendedRtn_2').disabled = false;
        d.getElementById('frm0620:CatAgent_P').disabled = false;
        d.getElementById('frm0620:CatAgent_G').disabled = false;
        d.getElementById('frm0620:txtTax14').disabled = false;
        //d.getElementById('frm0620:txtTax15').disabled = false;
        changeAmended();
        d.getElementById("frm0620:txtTax17A").disabled = false;
        d.getElementById("frm0620:txtTax17B").disabled = false;
        d.getElementById("frm0620:txtTax17C").disabled = false;


        //d.getElementById('frm0620:btnAdd').disabled = false;
        //d.getElementById('frm0620:btnDelete').disabled = false;

        if (d.getElementById("frm0620:AmendedRtn_1").checked) {
            //d.getElementById("frm0620:txtTax28").disabled = false;
        }

        if (qs('xmlFileName') != null && qs('xmlFileName').indexOf('.xml') > -1) {
            d.getElementById('frm0620:txtMonth').disabled = true;
            d.getElementById('frm0620:txtYear').disabled = true;
        }

        //d.getElementById('frm0620:txtCurrentPage').disabled = false;
        d.getElementById('frm0620:btnValidate').disabled = false;
        d.getElementById('btnSave').disabled = false;
        d.getElementById('frm0620:btnEdit').disabled = true;
        d.getElementById('btnPrint').disabled = true;
        d.getElementById('frm0620:btnFinalCopy').disabled = true;
        d.getElementById('btnUpload').disabled = true;
        disableElem;
        enableElem;
        document.getElementById('frm0620:txtTIN1').disabled = true; document.getElementById('frm0620:txtTIN2').disabled = true; document.getElementById('frm0620:txtTIN3').disabled = true; document.getElementById('frm0620:txtBranchCode').disabled = true;
    }

    function getRdo() {
        var data = "<select class='iceSelOneMnu' id='frm0620:txtRDOCode' name='frm0620:txtRDOCode' size='1' disabled ><option value='000'> </option>";

        for (var i = 0; i < rdoList.length; i++) {
            var rdo = rdoList[i];
            data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";

        }
        data = data + "</select>"

        $('#rdoSelect').html(data);

    }

