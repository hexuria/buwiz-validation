    function changeAmended() {
        if (d.getElementById("frm0620:AmendedRtn_1").checked) {
            d.getElementById("frm0620:txtTax15").disabled = false;
            d.getElementById("frm0620:txtTax14").disabled = false;
            compute16();
        } else {
            d.getElementById("frm0620:txtTax15").disabled = true;
            d.getElementById("frm0620:txtTax14").disabled = true;
            d.getElementById("frm0620:txtTax15").value = "0.00";
            d.getElementById("frm0620:txtTax14").value = "0.00";
            compute16();
        }
    }

