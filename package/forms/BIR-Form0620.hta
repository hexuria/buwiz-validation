    function loadSchedule() {
        var monthYear = String($("#response").html()).split("frm0620:sched1:txtMonthYear");  //monthyear
        var datePaid = String($("#response").html()).split("frm0620:sched1:txtDatePaid");  //datepaid
        var bankCode = String($("#response").html()).split("frm0620:sched1:txtBankCode");  //bankcode
        var number = String($("#response").html()).split("frm0620:sched1:txtNumber");  //number
        var taxPaid = String($("#response").html()).split("frm0620:sched1:txtTaxPaid");  //taxpaid
        var shouldTaxDue = String($("#response").html()).split("frm0620:sched1:txtShouldTaxDue");  //shouldtaxdue
        var adjustments = String($("#response").html()).split("frm0620:sched1:txtAdjustments");  //adjustments

        // var scheduleResponse = String($("#response").html()).substring(($("#response").html()).indexOf("frm0620:sched1:txtMonthYear"), ($("#response").html()).lastIndexOf("frm0620:sched1:txtAdjustments"));   //all schedule in response
        // alert(scheduleResponse);

        $('#tblSched1a').html("");
        $('#tblSched1b').html("");

        var i = 0;
        for (var j = 0; j < monthYear.length; j++) {
            if (j % 2 != 0) {//to not get other div splits

                //get values
                schedule1ToCommit[i] = new Schedule1();
                schedule1ToCommit[i].txtMonthYear = monthYear[j].split('=')[1];
                schedule1ToCommit[i].txtDatePaid = datePaid[j].split('=')[1];
                schedule1ToCommit[i].txtBankCode = bankCode[j].split('=')[1];
                schedule1ToCommit[i].txtNumber = number[j].split('=')[1];
                schedule1ToCommit[i].txtTaxPaid = taxPaid[j].split('=')[1];
                schedule1ToCommit[i].txtShouldTaxDue = shouldTaxDue[j].split('=')[1];
                schedule1ToCommit[i].txtAdjustments = adjustments[j].split('=')[1];

                i++;
            }
        }

        for (x = 0; x < schedule1ToCommit.length; x++) {

            $('#tblSched1a').html(d.getElementById('tblSched1a').innerHTML + "<tr>" +
                "<td width='2%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkScheduleDelete" + x + "'></font></td>" +
                "<td width='18%' align='center'><input type='text' value='" + schedule1ToCommit[x].txtMonthYear + "' style='color: black; text-align: right;' size='15'  maxlength='7' id='frm0620:sched1:txtMonthYear" + x + "' onkeypress='return dateOnly(this, event)' onkeydown='dateMaskingMonthYear(this);' onblur='validateMonthYear(this);' /></td>" +
                "<td align='center'><input type='text' value='" + schedule1ToCommit[x].txtDatePaid + "' style='color: black; text-align: right;' size='20' maxlength='10' id='frm0620:sched1:txtDatePaid" + x + "' onkeypress='return dateOnly(this, event)' onkeydown='dateMasking(this);' onblur='validateDate(this);' /></td>" +
                "<td align='center'><input type='text' value='" + schedule1ToCommit[x].txtBankCode + "' style='color: black; text-align: right;' size='20' maxlength='20' id='frm0620:sched1:txtBankCode" + x + "' onkeypress='return letternumber(event)' /></td>" +
                "<td align='center'><input type='text' value='" + schedule1ToCommit[x].txtNumber + "' style='color: black; text-align: right;' size='20' maxlength='20' id='frm0620:sched1:txtNumber" + x + "' onkeypress='return letternumber(event)' /></td>" +
                "<td align='center'><input type='text' value='" + schedule1ToCommit[x].txtTaxPaid + "' style='color: black; text-align: right;' size='20' maxlength='25' id='frm0620:sched1:txtTaxPaid" + x + "' onkeypress='return numbersonly(this, event)' onblur='round(this,2);computeSchedule1();' /></td>" +
                "</tr>");

            $('#tblSched1b').html(d.getElementById('tblSched1b').innerHTML + "<tr>" +
                "<td width='2%'><font size='1' style='font-weight:bold'>" + (x + 1) + "</font></td>" +
                "<td width='48%' align='center'><input onblur='round(this,2);computeSchedule1();' type='text' value='" + schedule1ToCommit[x].txtShouldTaxDue + "' style='color: black; text-align: right;' size='21' maxlength='25' id='frm0620:sched1:txtShouldTaxDue" + x + "' onkeypress='return numbersonly(this, event)'' /></td>" +
                "<td align='center'><input type='text' value='" + schedule1ToCommit[x].txtAdjustments + "' style='color: black; text-align: right;' size='21' maxlength='25' id='frm0620:sched1:txtAdjustments" + x + "' disabled /></td>" +
                "</tr>");
        }
    }

