    function ATCEnableDisableSchedule2(EnableDisable) {
        switch (EnableDisable) {
            case "Enable":
                d.getElementById('frm1702q:Sched2:txtTax1').disabled = false;
                d.getElementById('frm1702q:Sched2:txtTax2').disabled = false;
                d.getElementById('frm1702q:Sched2:txtTax4').disabled = false;

                // d.getElementById('frm1702q:Sched2:txtTax6').disabled = false;
                if (d.getElementById('frm1702q:rbMthdOfDdctns_1').checked == true) {
                    d.getElementById('frm1702q:Sched2:txtTax6').disabled = false;
                    // d.getElementById('frm1702q:Sched2:txtTax6').value = '0.00';
                } else if (d.getElementById('frm1702q:rbMthdOfDdctns_2').checked == true) {
                    d.getElementById('frm1702q:Sched2:txtTax6').disabled = true;
                    d.getElementById('frm1702q:Sched2:txtTax6').value = formatCurrency((Math.round(d.getElementById("frm1702q:Sched2:txtTax5").value) * 0.40).toFixed(2));
                    Sched2_Computation();
                } else {
                    d.getElementById('frm1702q:Sched2:txtTax6').disabled = true;
                    d.getElementById('frm1702q:Sched2:txtTax6').value = '0.00';
                }


                // d.getElementById('frm1702q:Sched2:txtTax8').disabled = false;
                if (d.getElementById('frm1702q:rbQuarter_1').checked == true) {
                    d.getElementById('frm1702q:Sched2:txtTax8').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched2:txtTax8').disabled = true;

                    Sched2_Computation();

                } else if (d.getElementById('frm1702q:rbQuarter_2').checked == true || d.getElementById('frm1702q:rbQuarter_3').checked == true) {
                    d.getElementById('frm1702q:Sched2:txtTax8').disabled = false;
                    Sched2_Computation();
                }

                // d.getElementById('frm1702q:Sched2:txtTax10').disabled = false;
                Sched2Item10TaxRate(d.getElementById('frm1702q:cbATC_2').value)

                break;
            case "Disable":
                d.getElementById('frm1702q:Sched2:txtTax1').value = '0.00';
                d.getElementById('frm1702q:Sched2:txtTax2').value = '0.00';
                d.getElementById('frm1702q:Sched2:txtTax4').value = '0.00';
                d.getElementById('frm1702q:Sched2:txtTax6').value = '0.00';
                d.getElementById('frm1702q:Sched2:txtTax8').value = '0.00';
                d.getElementById('frm1702q:Sched2:txtTax10').value = '0.00';

                d.getElementById('frm1702q:Sched2:txtTax1').disabled = true;
                d.getElementById('frm1702q:Sched2:txtTax2').disabled = true;
                d.getElementById('frm1702q:Sched2:txtTax4').disabled = true;
                d.getElementById('frm1702q:Sched2:txtTax6').disabled = true;
                d.getElementById('frm1702q:Sched2:txtTax8').disabled = true;
                d.getElementById('frm1702q:Sched2:txtTax10').disabled = false;
                Sched2_Computation();
                break;
        }
    }

