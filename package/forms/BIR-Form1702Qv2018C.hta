            case "IC200_0%": // "IC200_0%"

                // Enabling Schedule 4, 2 and 1B regardless of ATC chosen
                // ATCEnableDisableSchedule4('Disable');
                ATCEnableDisableSchedule4('Enable');
                ATCEnableDisableSchedule4('Enable');
                // ATCEnableDisableSchedule2('Disable');
                // ATCEnableDisableSchedule1B('Disable');
                ATCEnableDisableSchedule1B('Enable');
                ATCEnableDisableSchedule2('Enable');
                ATCEnableDisableSchedule1A('Enable');
                break;

            case "IC030_10%": // "IC030_10%"
            case "IC030_1%": // "IC030_1%"
            case "IC031_10%": // "IC031_10%"
            case "IC031_1%": // "IC031_1%"
