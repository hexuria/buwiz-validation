                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN1 = elem[i].value;
                        } else if (elem[i].id == 'frm1702q:txtTIN2') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN2 = elem[i].value;
                        } else if (elem[i].id == 'frm1702q:txtTIN3') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN3 = elem[i].value;
                        } else if (elem[i].id == 'frm1702q:txtBranchCode') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPBranchCode = elem[i].value;
                        } else if (elem[i].id == 'frm1702q:txtRDOCode') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPRDOCode = elem[i].value;
                        }
                        /*else if (elem[i].id == 'frm1701q:txtLOB') {
                            p3TPLineBus = escape(elem[i].value);
                        } else if (elem[i].id == 'frm1701q:txtTaxPayername') {
                            p3TPName = escape(elem[i].value);
                        }*/
                        else if (elem[i].id == 'frm1702q:txtTelNum') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTelNum = elem[i].value;
                        }
                        /*else if (elem[i].id == 'frm1701q:txt11Address') {
                            p3TPAddress = escape(elem[i].value);
                        }*/
                        else if (elem[i].id == 'frm1702q:txtZipCode') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPZip = elem[i].value;
                        }
                        //set page to 1
                        else if (elem[i].id == 'frm1702q:txtCurrentPage') {
                            allXML += "<div>" + elem[i].id + "=" + "1" + elem[i].id + "=</div>" + tab;
                        }
                        else {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab; //all select-one and text values
                        }
                    }
                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        allXML += "<div>" + elem[i].id + "=" + elem[i].checked + elem[i].id + "=</div>" + tab; //all radio and checkbox values			
                    }

                }
            }
            p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;
            /*--------------------- follow this format for parsing --------------------------- */

            if (submit) {
                allXML += tab + d.getElementById('xmlClose').innerHTML + "0";
            } else {
                allXML += tab + d.getElementById('xmlClose').innerHTML;
            }

            //Phase 3: This 'savefile' will be uploaded to IAF Infra for DI processing
            savedReturn = allXML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (submit == false) {
                alert('BIR Form saved successfully as : ' + xmlFileName);
            }
        }
        return true;
    }
    var XMLrdoFile = '';

    function loadXMLrdo(fileLocation) {
        try {
            //This will load the Region file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLrdoFile = fsoXML.OpenTextFile(fileLocation, 1);

            if (XMLrdoFile.AtEndOfStream)
                data = "";
            else {
                var responseRdo = d.getElementById('responseRdo'); //render file and write to hidden div
                responseRdo.innerHTML = XMLrdoFile.ReadAll(); //remove XML tag
                //responseRdo = replaceHtml(responseRdo, XMLrdoFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
            }
            XMLrdoFile.Close(); //alert( responseRdo.innerHTML ); //Debug			
            loadRdo();	/*This will load ATC onto an array*/
        } catch (e) {
            msg.innerHTML = ""; //"Region File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    var rdoCount = 0;

    function loadRdo() {
        /*This will load data onto an array*/
        var response = d.getElementById("responseRdo");

        var rdoCnt = String(response.innerHTML).split('rdoCount=');
        rdoCount = rdoCnt[1];

        var k = 0;
        //loads rdoList from xml
        for (var i = 1; i <= rdoCount; i++) {

            var rdo = String(response.innerHTML).split('rdo' + i + ':');
            var rdoStr = rdo[1];

            //Ensure that before writing to rdoPropertyJS the formType 1701Q is traceable in rdoStr
            if (rdoStr.indexOf('1702Q') >= 0) {
                var rdoValues = rdoStr.split('~');
                var rdoCode = rdoValues[0];
                var description = rdoValues[1];

                var objRdo = new rdoPropertyJS(rdoCode, description);
                rdoList[k] = objRdo;
                k++;
                //alert('1701Q successfully created array #'+i);

            } else {
                //alert('1701Q not found in array #'+i);
                continue;
            }
        }
    }

    /*--------------------------------------------------------------*/

    function blockletter(e) {
        var number = parseFloat(e.value).toFixed(2);
        if (isNaN(number)) {
            var zero = 0;
            e.value = parseFloat(zero).toFixed(2);
            //e.value = "";
        } else {
            e.value = '' + number;
            if (e.value < 0) {
                var zero = 0;
                e.value = parseFloat(zero).toFixed(2);
            }

        }
    }

    function blockletterWithout2Decimal(e) {
        var number = parseFloat(e.value);
        if (isNaN(number)) {
            //var zero = 0;
            //e.value = parseFloat(zero).toFixed(2);
            e.value = "";
        } else {
            e.value = '' + number.toFixed(0);
        }
    }

    //validate date
    function validateDate(element) {
        var strmmddyyyy = element.value;
        var isValid = true;
        var currentDate = new Date();
        var inputDate = new Date();

        if (strmmddyyyy != "") {
            var result = strmmddyyyy.split("/");
            var isLeap = new Date(result[2], 1, 29).getMonth() === 1;
            var month31 = (['01', '03', '05', '07', '08', '10', '12']);
            var month30 = (['04', '06', '09', '11']);
            var month = result[0];
            var day = result[1];
            if (result.length === 3) {
                if (isNaN(result[0] || result[1] || result[2])) {
                    isValid = false;
                }
                else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 1))) {
                    // numeric check if greater not than 31 - Month.
                    isValid = false;
                }
                else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
                    // numeric check if Date.
                    isValid = false;
                }
                else if (result[2].length != 4) {
                    isValid = false;
                }
                else if (month == 2) {
                    if (!isLeap && day == 29) {
                        isValid = false;
                    }
                    else if (!isLeap && day > 29) {
                        isValid = false;
                    }
                    else if (isLeap && day > 29) {
                        isValid = false;
                    }
                }
                else if (month31.contains(month) && day > 31) {
                    isValid = false;
                }
                else if (month30.contains(month) && day > 30) {
                    isValid = false;
                }

                inputDate = new Date(result[2], month - 1, day);
            }
            else {
                isValid = false;
            }
        }

        if (!isValid) {
            alert('Please provide a valid date. (MM/DD/YYYY format)');
            element.value = '';
            element.focus();
        }
        else if (inputDate > currentDate) {
            alert('This date cannot be a future date.');
            element.value = '';
            element.focus();
        }

        return isValid;
    }


    function validate() {


        var currentDate = new Date();
        var currentYear = currentDate.getFullYear();

        var d = document;
        var YearEnded = d.getElementById('frm1702q:txtYrEndYear');
        var fiscalYearEndMonthValue = d.getElementById('frm1702q:rbYrEndMonth').value;

        // Validate YearEnded value
        if (!YearEnded.value || isNaN(YearEnded.value)) {
            alert("Invalid year entered. Please provide a valid year.");
            return;
        }
        // Assuming the form expects only the last two digits:
        var inputYear = 2000 + parseInt(YearEnded.value, 10);

        // Validate fiscalYearEndMonth
        if (!fiscalYearEndMonthValue || isNaN(fiscalYearEndMonthValue)) {
            alert("Please provide a valid fiscal year-end month.");
            return;
        }
        var fiscalYearEndMonth = parseInt(fiscalYearEndMonthValue, 10);
        // (Assume January = 1, February = 2, …, December = 12)

        // Determine which quarter is being filed (for fiscal mode)
        var selectedQuarter = 0;
        if (d.getElementById('frm1702q:rbQuarter_1').checked) {
            selectedQuarter = 1;
        } else if (d.getElementById('frm1702q:rbQuarter_2').checked) {
            selectedQuarter = 2;
        } else if (d.getElementById('frm1702q:rbQuarter_3').checked) {
            selectedQuarter = 3;
        } else {
            alert("Please select Quarter in Item 3.");
            return;
        }

        // -----------------------------
        // CALENDAR YEAR VALIDATION
        // -----------------------------
        if (d.getElementById("frm1702q:rbForClndrFscl_1").checked) {
            if (inputYear < 2018) {
                YearEnded.value = "18";
                alert("Year (Page 1 Item 2) should not be earlier than January 2018.");
                return;
            }
            if (inputYear > currentYear) {
                YearEnded.value = currentYear - 2000;
                alert("Year (Page 1 Item 2) cannot be greater than the current year for Calendar Year.");
                return;
            }
        }
        // -----------------------------
        // FISCAL YEAR VALIDATION
        // -----------------------------
        else if (d.getElementById("frm1702q:rbForClndrFscl_2").checked) {
            if (inputYear < 2018) {
                YearEnded.value = "18";
                alert("Year (Page 1 Item 2) should not be earlier than January 2018.");
                return;
            }
            // For fiscal returns the Quarterly Return covers only the first three quarters.
            // We now define the "quarterly return period" based on the fiscal year-end month.
            // (Remember: our months here are 1-based.)
            var periodStartYear, periodStartMonth;
            var q1_start, q1_end, q2_start, q2_end, q3_start, q3_end;

            if (fiscalYearEndMonth === 1) {
                // SPECIAL CASE: If fiscal year ended is January, then the quarterly return period is
                // from February of the PREVIOUS year to September of the PREVIOUS year.
                // According to your spec:
                //   • Q1: Feb–Mar  (2 months)
                //   • Q2: Apr–Jun  (3 months)
                //   • Q3: Jul–Sep  (3 months)
                periodStartYear = inputYear - 1;  // e.g., for inputYear 2025, use 2024
                periodStartMonth = 2; // February

                // Q1: From February 1 to the last day of March:
                q1_start = new Date(periodStartYear, periodStartMonth - 1, 1);
                q1_end = new Date(periodStartYear, (periodStartMonth - 1) + 2, 0);

                // Q2: From April 1 to the last day of June:
                q2_start = new Date(periodStartYear, (periodStartMonth - 1) + 2, 1);
                q2_end = new Date(periodStartYear, (periodStartMonth - 1) + 2 + 3, 0);

                // Q3: From July 1 to the last day of September:
                q3_start = new Date(periodStartYear, (periodStartMonth - 1) + 2 + 3, 1);
                q3_end = new Date(periodStartYear, (periodStartMonth - 1) + 2 + 3 + 3, 0);
            }
            else {
                // For all other fiscal year-end months, assume the quarterly return period is 9 months long:
                // It begins the month after the fiscal year-end (of the previous year) and spans 9 months.
                // For example, if fiscal year ended is May (5), the period is June (6) – February (2) of inputYear.
                periodStartYear = inputYear - 1;
                periodStartMonth = fiscalYearEndMonth + 1; // e.g., if fiscalYearEndMonth is 5 then start in month 6

                // Divide the 9-month period into three 3 month quarters.
                q1_start = new Date(periodStartYear, periodStartMonth - 1, 1);
                q1_end = new Date(periodStartYear, (periodStartMonth - 1) + 3, 0);

                q2_start = new Date(periodStartYear, (periodStartMonth - 1) + 3, 1);
                q2_end = new Date(periodStartYear, (periodStartMonth - 1) + 6, 0);

                q3_start = new Date(periodStartYear, (periodStartMonth - 1) + 6, 1);
                q3_end = new Date(periodStartYear, (periodStartMonth - 1) + 9, 0);
            }

            // Now, select the quarter end date based on the selected quarter:
            var selectedQuarterEnd;
            if (selectedQuarter === 1) {
                selectedQuarterEnd = q1_end;
            } else if (selectedQuarter === 2) {
                selectedQuarterEnd = q2_end;
            } else if (selectedQuarter === 3) {
                selectedQuarterEnd = q3_end;
            }

            // Finally, validate:
            // For a valid filing the selected quarter's period must have already ended.
            if (selectedQuarterEnd > currentDate) {
                alert("Future filing is not allowed.");
                return;
            }
        }





        if (d.getElementById('frm1702q:rbYrEndMonth').value == "" || d.getElementById('frm1702q:txtYrEndYear').value == "") {
            alert("Please enter a valid Date on Item 2.");
            return;
        }

        if (!d.getElementById('frm1702q:rbQuarter_1').checked && !d.getElementById('frm1702q:rbQuarter_2').checked && !d.getElementById('frm1702q:rbQuarter_3').checked) {
            alert("Please select Quarter in Item 3.");
            return;
        }


        if (!d.getElementById('frm1702q:rbATC_1').checked && !d.getElementById('frm1702q:rbATC_2').checked) {
            alert("Please select ATC on Item 5.");
            return;
        }

        if (d.getElementById('frm1702q:rbATC_2').checked == true) {
            if (d.getElementById('frm1702q:cbATC_2').value == '') {
                alert('Please select ATC on Item 5');
                return;
            }
        }

        //--- dgarfin : Added 'Background Information' field validation for Phase 2
        if ((d.getElementById('frm1702q:txtTIN1').value == "" || d.getElementById('frm1702q:txtTIN2').value == "" || d.getElementById('frm1702q:txtTIN3').value == "" || d.getElementById('frm1702q:txtBranchCode').value == "")) {
            alert("Please enter a valid TIN number on Item 6.");
            return;
        }

        if ((d.getElementById('frm1702q:txtTIN1').value.length != 3 || d.getElementById('frm1702q:txtTIN2').value.length != 3 || d.getElementById('frm1702q:txtTIN3').value.length != 3 || d.getElementById('frm1702q:txtBranchCode').value.length < 3)) {
            alert("Please enter a valid TIN number on Item 6.");
            return;
        }

        if ((d.getElementById('frm1702q:txtRDOCode').value == 0)) {
            alert("Please enter a valid RDO Code on Item 7.");
            return;
        }

        if ((d.getElementById('frm1702q:txtTaxpayerName1').value == "")) {
            alert("Please enter a valid Taxpayer Name on Item 8.");
            return;
        }

        if ((d.getElementById('frm1702q:txtAddress').value == "")) {
            alert("Please enter Taxpayer's Registered Address on Item 9.");
            return;
        }

        if (d.getElementById('frm1702q:txtZipCode').value == "") {
            alert("Please enter Zip Code on Item 9A.");
            return;
        }

        if (d.getElementById('frm1702q:txtTelNum').value == "") {
            alert("Please enter Contact Number on Item 10.");
            return;
        }

        if (d.getElementById('frm1702q:rbMthdOfDdctns_1').checked == false && d.getElementById('frm1702q:rbMthdOfDdctns_2').checked == false) {
            alert("Please select Method of Deductions on Item 12.");
            return;
        }

        if (d.getElementById('frm1702q:rbTxRlf_1').checked == true) {
            if (d.getElementById('frm1702q:txtTxRlfSpcfy').value == "") {
                alert("Please specify Special Law/International Tax Treaty on Item 13A.");
                return;
            }

        }

        for (var i = 0; i < d.getElementById("tblOthrTxCrdts").rows.length; i++) {
            if (d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + i).value != '' && d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + i).value == '0.00') {
                alert("Please input Other Tax Credits/Payments amount on Schedule 4 Item 6");
                return;
            }
        }

        for (var i = 0; i < d.getElementById("tblOthrTxCrdts").rows.length; i++) {
            if (d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + i).value == '' && d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + i).value != '0.00') {
                alert("Please specify Other Tax Credits/Payments on Schedule 4 Item 6");
                return;
            }
        }

        disableAllControl();
        alert("Validation successful. Click on Edit if you wish to modify your entries.");
        return;
    }

