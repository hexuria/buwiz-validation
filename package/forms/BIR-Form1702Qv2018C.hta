            case "IC190_30%_OtherThanForeignCurrencyTransaction": // "IC190_10%_OtherThanForeignCurrencyTransaction"
            case "IC191_10%": // "IC191_10%"
            case "IC190_25%_NotSubjectToFinalTax_New": // "IC190_25%_NotSubjectToFinalTax_New"
            case "IC190_25%_OtherThanForeignCurrencyTransaction_New": // "IC190_25%_OtherThanForeignCurrencyTransaction_New"
            case "IC191_25%_NotSubjectToFinalTax_New": // "IC191_25%_NotSubjectToFinalTax_New"

                // Enabling Schedule 4, 2 and 1A regardless of ATC chosen
                // ATCEnableDisableSchedule4('Disable');
                ATCEnableDisableSchedule4('Enable');
                // ATCEnableDisableSchedule2('Disable');
                // ATCEnableDisableSchedule1A('Disable');
                ATCEnableDisableSchedule2('Enable');
                ATCEnableDisableSchedule1A('Enable');
                ATCEnableDisableSchedule1B('Enable');
                break;

            case "IC010_30%": // "IC010_30%"
            case "IC010_25%": // "IC010_25%"
            case "IC010_20%": // "IC010_20%"
            case "IC020_30%": // "IC020_30%"
            case "IC020_25%": // "IC020_25%"
            case "IC020_20%": // "IC020_20%"
            case "IC030_30%": // "IC030_30%"
            case "IC030_25%": // "IC030_25%"
            case "IC030_20%": // "IC030_20%"
            case "IC031_30%": // "IC031_30%"
            case "IC031_25%": // "IC031_25%"
            case "IC031_20%": // "IC031_20%"
            case "IC040_30%": // "IC040_30%"
            case "IC040_25%": // "IC040_25%"
            case "IC040_20%": // "IC040_20%"
            case "IC041_30%": // "IC041_30%"
            case "IC041_25%": // "IC041_25%"
            case "IC041_20%": // "IC041_20%"
            case "IC070_30%": // "IC070_30%"
            case "IC070_25%": // "IC070_25%"
            case "IC101_25%": // "IC101_25%"
            case "OBU_25%": // "OBU_25%"
            case "IC191_30%": // "IC191_30%"
            case "IC191_25%_OtherThanForeignCurrencyTransaction_New": // "IC191_25%_OtherThanForeignCurrencyTransaction_New"

                ATCEnableDisableSchedule1A('Enable');

                ATCEnableDisableSchedule1B('Enable');

                ATCEnableDisableSchedule2('Enable');


                ATCEnableDisableSchedule4('Enable');
                break;
        }

    }

    function ATCEnableDisableSchedule1A(EnableDisable) {
        switch (EnableDisable) {
            case "Enable":
                d.getElementById('frm1702q:Sched1:txtTax1A').disabled = false;
                d.getElementById('frm1702q:Sched1:txtTax2A').disabled = false;
                d.getElementById('frm1702q:Sched1:txtTax4A').disabled = false;
                d.getElementById('frm1702q:Sched1:txtTax6A').disabled = false;

                // d.getElementById('frm1702q:Sched1:txtTax8A').disabled = false;
                if (d.getElementById('frm1702q:rbQuarter_1').checked == true) {
                    d.getElementById('frm1702q:Sched1:txtTax8A').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched1:txtTax8A').disabled = true;
                } else if (d.getElementById('frm1702q:rbQuarter_2').checked == true || d.getElementById('frm1702q:rbQuarter_3').checked == true) {
                    d.getElementById('frm1702q:Sched1:txtTax8A').disabled = false;
                }

                Sched1_Computation();
                break;
            case "Disable":
                d.getElementById('frm1702q:Sched1:txtTax1A').value = '0.00';
                d.getElementById('frm1702q:Sched1:txtTax2A').value = '0.00';
                d.getElementById('frm1702q:Sched1:txtTax4A').value = '0.00';
                d.getElementById('frm1702q:Sched1:txtTax6A').value = '0.00';
                d.getElementById('frm1702q:Sched1:txtTax8A').value = '0.00';
                d.getElementById('frm1702q:Sched1:txtTax1A').disabled = true;
                d.getElementById('frm1702q:Sched1:txtTax2A').disabled = true;
                d.getElementById('frm1702q:Sched1:txtTax4A').disabled = true;
                d.getElementById('frm1702q:Sched1:txtTax6A').disabled = true;
                d.getElementById('frm1702q:Sched1:txtTax8A').disabled = true;
                Sched1_Computation();
                break;
        }
    }
