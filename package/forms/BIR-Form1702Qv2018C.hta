    function ATCEnableDisableSchedules(ATC) {
        switch (ATC) {

            case "":
                ATCEnableDisableSchedule1A('Disable');
                ATCEnableDisableSchedule1B('Disable');
                ATCEnableDisableSchedule2('Disable');
                ATCEnableDisableSchedule4('Disable');

                break;

            case "IC011_0%": // "IC011_0%"
