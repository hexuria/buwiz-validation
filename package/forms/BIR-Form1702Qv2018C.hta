                    <tr>
                    </tr>
                </tbody>
                <tfoot>
                    <tr style="border: 1px solid black; padding: 2px;">
                        <td colspan="2" align="right" style="font-size: 12px;">&nbsp;</td>
                        <td align="center" style="padding: 2px">
                            <font style="font-size: 12px; font-weight:bold; margin-left: -53px">Subtotal:</font>
                            <input type="text"
                                style="text-align: right; background-color: rgb(220, 220, 220); border: 1px solid black; padding: 2px;"
                                id="resultOtherSpecify" size="20" value="0.00" disabled />
                        <td>&nbsp;</td>
                    </tr>
                </tfoot>
            </table>
            <!-- BUTTON FOR ADDING -->
