            d.getElementById('frm1702q:txtPg2TIN2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            d.getElementById('frm1702q:txtTIN3').value = tin3Val[1];
            d.getElementById('frm1702q:txtPg2TIN3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            d.getElementById('frm1702q:txtBranchCode').value = tin4Val[1];
            d.getElementById('frm1702q:txtPg2BranchCode').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm1702q:txtRDOCode').value = rdoVal[1];

            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm1702q:txtLOB').value = unescape(lobVal[1]);

