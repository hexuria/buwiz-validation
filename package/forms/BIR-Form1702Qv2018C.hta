    function getFiscalMonth(M) {
        var month = new Array();

        month[0] = "";
        month[1] = "01";
        month[2] = "02";
        month[3] = "03";
        month[4] = "04";
        month[5] = "05";
        month[6] = "06";
        month[7] = "07";
        month[8] = "08";
        month[9] = "09";
        month[10] = "10";
        month[11] = "11";
        month[12] = "12";

        return month[M];
    }

    function validateFiscalMonth() {
        var txtMonth = document.getElementById("frm1702q:rbYrEndMonth").value;
        var currentYear = new Date().getYear();
        var inputYear = 2000 + (document.getElementById("frm1702q:txtYrEndYear").value * 1);
        var currentDate = new Date();
        currentMonth = currentDate.getMonth() + 1;

        if (inputYear > currentYear) {
            if (txtMonth >= currentMonth) {
                alert("Date (Page 1 Item 2) cannot be greater than current date when filing for Fiscal Year.");
                document.getElementById("frm1702q:rbYrEndMonth").value = getFiscalMonth(currentMonth - 1);
            }
        }
    }

