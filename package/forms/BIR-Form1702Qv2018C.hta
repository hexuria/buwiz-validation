    function ATCEnableDisableSchedule4(EnableDisable) {
        switch (EnableDisable) {
            case "Enable":
                d.getElementById('frm1702q:Sched4:txtTax1').disabled = false;

                if (d.getElementById('frm1702q:rbQuarter_1').checked == true) {
                    d.getElementById('frm1702q:Sched4:txtTax2').value = '0.00';
                    d.getElementById('frm1702q:Sched4:txtTax2').disabled = true;
                    d.getElementById('frm1702q:Sched4:txtTax3').value = '0.00';
                    d.getElementById('frm1702q:Sched4:txtTax3').disabled = true;
                    d.getElementById('frm1702q:Sched4:txtTax4').value = '0.00';
                    d.getElementById('frm1702q:Sched4:txtTax4').disabled = true;
                    //Sched4_Computation();
                } else if (d.getElementById('frm1702q:rbQuarter_2').checked == true || d.getElementById('frm1702q:rbQuarter_3').checked == true) {
                    d.getElementById('frm1702q:Sched4:txtTax2').disabled = false;
                    d.getElementById('frm1702q:Sched4:txtTax3').disabled = false;
                    d.getElementById('frm1702q:Sched4:txtTax4').disabled = false;
                    //Sched4_Computation();
                }

                d.getElementById('frm1702q:Sched4:txtTax5').disabled = false;

                if (d.getElementById('frm1702q:rbAmendedRtn_1').checked == true) {
                    d.getElementById('frm1702q:Sched4:txtTax6').disabled = false;
                } else if (d.getElementById('frm1702q:rbAmendedRtn_2').checked == true) {
                    d.getElementById('frm1702q:Sched4:txtTax6').value = '0.00';
                    d.getElementById('frm1702q:Sched4:txtTax6').disabled = true;
                }

                d.getElementById('frm1702q:Sched4:btnAdd').disabled = true;
                d.getElementById('frm1702q:Sched4:btnDelete').disabled = true;


                var firstRowIndex = 0;

                d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + firstRowIndex).disabled = false;
                d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + firstRowIndex).disabled = false;

                var rowCount = d.getElementById("tblOthrTxCrdts").rows.length;
                for (var i = 1; i < rowCount; i++) {
                    d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + i).disabled = true;
                    d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + i).disabled = true;
                }




                break;

            case "Disable":
                d.getElementById('frm1702q:Sched4:txtTax1').value = '0.00';
                d.getElementById('frm1702q:Sched4:txtTax2').value = '0.00';
                d.getElementById('frm1702q:Sched4:txtTax3').value = '0.00';
                d.getElementById('frm1702q:Sched4:txtTax4').value = '0.00';
                d.getElementById('frm1702q:Sched4:txtTax5').value = '0.00';
                d.getElementById('frm1702q:Sched4:txtTax6').value = '0.00';

                d.getElementById('frm1702q:Sched4:txtTax1').disabled = true;
                d.getElementById('frm1702q:Sched4:txtTax2').disabled = true;
                d.getElementById('frm1702q:Sched4:txtTax3').disabled = true;
                d.getElementById('frm1702q:Sched4:txtTax4').disabled = true;
                d.getElementById('frm1702q:Sched4:txtTax5').disabled = true;
                d.getElementById('frm1702q:Sched4:txtTax6').disabled = true;

                d.getElementById('frm1702q:Sched4:btnAdd').disabled = true;
                d.getElementById('frm1702q:Sched4:btnDelete').disabled = true;
                for (var i = 0; i < d.getElementById("tblOthrTxCrdts").rows.length; i++) {
                    d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + i).value = '';
                    d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + i).value = '0.00';
                    d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + i).disabled = true;
                    d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + i).disabled = true;
                    d.getElementById('frm1702q:Sched4:chkOthrTxCrdts' + i).disabled = true;
                }

                Sched4_Computation();
                break;
        }
    }

