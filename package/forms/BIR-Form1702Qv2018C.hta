    function Part2_Computation() {

        //INCOME TAX STILL DUE - SPECIAL RATE (TAX 16)
        var ComputeTax16 = NumWithComma(d.getElementById("frm1702q:txtTax14").value) - NumWithComma(d.getElementById("frm1702q:txtTax15").value)
        d.getElementById('frm1702q:txtTax16').value = formatCurrency(NumWithComma(ComputeTax16.toFixed(2).toString()));

        //AGGREGATED INCOME TAX DUE (TAX 18)
        var ComputeTax18 = NumWithComma(d.getElementById("frm1702q:txtTax16").value) + NumWithComma(d.getElementById("frm1702q:txtTax17").value)
        d.getElementById('frm1702q:txtTax18').value = formatCurrency(NumWithComma(ComputeTax18.toFixed(2).toString()));

        //NET TAX PAYABLE (TAX 20)
        var ComputeTax20 = NumWithComma(d.getElementById("frm1702q:txtTax18").value) - NumWithComma(d.getElementById("frm1702q:txtTax19").value)
        d.getElementById('frm1702q:txtTax20').value = formatCurrency(NumWithComma(ComputeTax20.toFixed(2).toString()));

        //TOTAL PENALTIES (TAX 24)
        var ComputeTax24 = NumWithComma(d.getElementById("frm1702q:txtTax21").value) + NumWithComma(d.getElementById("frm1702q:txtTax22").value) + NumWithComma(d.getElementById("frm1702q:txtTax23").value)
        d.getElementById('frm1702q:txtTax24').value = formatCurrency(NumWithComma(ComputeTax24.toFixed(2).toString()));

        //TOTAL AMOUNT PAYABLE (TAX 25)
        // var ComputeTax25 = NumWithComma(d.getElementById("frm1702q:txtTax20").value) + NumWithComma(d.getElementById("frm1702q:txtTax24").value) 
        // d.getElementById('frm1702q:txtTax25').value = formatCurrency(NumWithComma(ComputeTax25.toFixed(2).toString()));

        //TOTAL AMOUNT PAYABLE (TAX 25)
        var txt20 = NumWithComma(d.getElementById("frm1702q:txtTax20").value);
        var txt24 = NumWithComma(d.getElementById("frm1702q:txtTax24").value);

        if (txt20 < 0 && txt24 > 0) {
            // d.getElementById("frm1702q:txtTax25").value = d.getElementById("frm1702q:txtTax24").value;
            var ComputeTax25 = NumWithComma(d.getElementById("frm1702q:txtTax24").value)
            d.getElementById('frm1702q:txtTax25').value = formatCurrency(NumWithComma(ComputeTax25.toFixed(2).toString()));
        } else {
            var ComputeTax25 = NumWithComma(d.getElementById("frm1702q:txtTax20").value) + NumWithComma(d.getElementById("frm1702q:txtTax24").value)
            d.getElementById('frm1702q:txtTax25').value = formatCurrency(NumWithComma(ComputeTax25.toFixed(2).toString()));
        }
    }

    function Sched1_Computation() {
        function safeNum(value) {
            // Convert the value to a number and handle NaN cases
            return isNaN(NumWithComma(value)) ? 0 : NumWithComma(value);
        }

        // Function to format as currency with no decimals
        function formatCurrency(value) {
            return parseFloat(value).toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0 });
        }

        var tax1A = safeNum(document.getElementById("frm1702q:Sched1:txtTax1A").value);
        var tax2A = safeNum(document.getElementById("frm1702q:Sched1:txtTax2A").value);
        var tax3A = tax1A - tax2A;
        document.getElementById('frm1702q:Sched1:txtTax3A').value = formatCurrency(Math.round(tax3A));

        var tax1B = safeNum(document.getElementById("frm1702q:Sched1:txtTax1B").value);
        var tax2B = safeNum(document.getElementById("frm1702q:Sched1:txtTax2B").value);
        var tax3B = tax1B - tax2B;
        document.getElementById('frm1702q:Sched1:txtTax3B').value = formatCurrency(Math.round(tax3B));

        var tax4A = safeNum(document.getElementById("frm1702q:Sched1:txtTax4A").value);
        var tax5A = tax4A + safeNum(document.getElementById("frm1702q:Sched1:txtTax3A").value);
        document.getElementById('frm1702q:Sched1:txtTax5A').value = formatCurrency(Math.round(tax5A));

        var tax4B = safeNum(document.getElementById("frm1702q:Sched1:txtTax4B").value);
        var tax5B = tax4B + safeNum(document.getElementById("frm1702q:Sched1:txtTax3B").value);
        document.getElementById('frm1702q:Sched1:txtTax5B').value = formatCurrency(Math.round(tax5B));

        var tax6A = safeNum(document.getElementById("frm1702q:Sched1:txtTax6A").value);
        var tax7A = tax5A - tax6A;
        document.getElementById('frm1702q:Sched1:txtTax7A').value = formatCurrency(Math.round(tax7A));

        var tax6B = safeNum(document.getElementById("frm1702q:Sched1:txtTax6B").value);
        var tax7B = tax5B - tax6B;
        document.getElementById('frm1702q:Sched1:txtTax7B').value = formatCurrency(Math.round(tax7B));

        var tax8A = safeNum(document.getElementById("frm1702q:Sched1:txtTax8A").value);
        var tax9A = tax7A + tax8A;
        document.getElementById('frm1702q:Sched1:txtTax9A').value = formatCurrency(Math.round(tax9A));

        var tax8B = safeNum(document.getElementById("frm1702q:Sched1:txtTax8B").value);
        var tax9B = tax7B + tax8B;
        document.getElementById('frm1702q:Sched1:txtTax9B').value = formatCurrency(Math.round(tax9B));

        var tax10A = safeNum(document.getElementById("frm1702q:Sched1:txtTax10A").value);
        var tax11A = Math.round((tax9A * tax10A) / 100);
        document.getElementById('frm1702q:Sched1:txtTax11A').value = formatCurrency(tax11A);

        var tax10B = safeNum(document.getElementById("frm1702q:Sched1:txtTax10B").value);
        var tax11B = tax9B <= 0 ? 0 : Math.round((tax9B * tax10B) / 100);
        document.getElementById('frm1702q:Sched1:txtTax11B').value = formatCurrency(tax11B);

        var tax12B = safeNum(document.getElementById("frm1702q:Sched1:txtTax12B").value);
        var tax13B = Math.round((tax11A + tax11B) - tax12B);
        document.getElementById('frm1702q:Sched1:txtTax13B').value = formatCurrency(tax13B);

        document.getElementById('frm1702q:txtTax17').value = document.getElementById('frm1702q:Sched1:txtTax13B').value;

        Part2_Computation();
    }


    function Sched2_Computation() {



        //GROSS INCOME FROM OPERATION (Schedule 2 - 3)
        var ComputeSched2_3 = NumWithComma(d.getElementById("frm1702q:Sched2:txtTax1").value) - NumWithComma(d.getElementById("frm1702q:Sched2:txtTax2").value)
        d.getElementById('frm1702q:Sched2:txtTax3').value = formatCurrency(NumWithComma(ComputeSched2_3.toFixed(2).toString()));

        //TOTAL GROSS INCOME (Schedule 2 - 5)
        var ComputeSched2_5 = NumWithComma(d.getElementById("frm1702q:Sched2:txtTax3").value) + NumWithComma(d.getElementById("frm1702q:Sched2:txtTax4").value)
        d.getElementById('frm1702q:Sched2:txtTax5').value = formatCurrency(NumWithComma(ComputeSched2_5.toFixed(2).toString()));

        //LESS: DEDUCTIONS

        if (d.getElementById('frm1702q:rbMthdOfDdctns_2').checked == true) {
            d.getElementById('frm1702q:Sched2:txtTax6').value = formatCurrency(Math.round((NumWithComma(d.getElementById("frm1702q:Sched2:txtTax5").value) * 0.40).toFixed(2)));
        }

        //TAXABLE INCOME THIS QUARTER (Schedule 2 - 7)
        var ComputeSched2_7 = NumWithComma(d.getElementById("frm1702q:Sched2:txtTax5").value) - NumWithComma(d.getElementById("frm1702q:Sched2:txtTax6").value)
        d.getElementById('frm1702q:Sched2:txtTax7').value = formatCurrency(NumWithComma(ComputeSched2_7.toFixed(2).toString()));

        //TOTAL TAXABLE INCOME TO DATE (Schedule 2 - 9)
        var ComputeSched2_9 = NumWithComma(d.getElementById("frm1702q:Sched2:txtTax7").value) + NumWithComma(d.getElementById("frm1702q:Sched2:txtTax8").value)
        d.getElementById('frm1702q:Sched2:txtTax9').value = formatCurrency(NumWithComma(ComputeSched2_9.toFixed(2).toString()));




        //INCOME TAX DUE OTHER THAN MCIT (Schedule 2 - 11)
        //Added 11/12/2021
        var Sched2Tax9 = NumWithComma(d.getElementById("frm1702q:Sched2:txtTax9").value);
        if (Sched2Tax9 < 0) {
            d.getElementById('frm1702q:Sched2:txtTax11').value = '0.00'
        } else {
            var ComputeSched2_11 = formatCurrency((NumWithComma(d.getElementById("frm1702q:Sched2:txtTax9").value) * NumWithComma(d.getElementById("frm1702q:Sched2:txtTax10").value) * 1 / 100).toFixed(5));
            d.getElementById('frm1702q:Sched2:txtTax11').value = formatCurrency(Math.round(NumWithComma(ComputeSched2_11).toFixed(2).toString()));
        }

        //MINIMUM CORPORATE INCOME TAX (MCIT)
        // var ComputeSched2_12 = NumWithComma(d.getElementById("frm1702q:Sched3:txtTax6").value)
        // d.getElementById('frm1702q:Sched2:txtTax12').value = formatCurrency(Math.round(NumWithComma(ComputeSched2_12.toFixed(2).toString())));

        //GET VALUE FOR SCHEDULE 2 ITEM 12


        d.getElementById('frm1702q:Sched2:txtTax12').value = formatCurrency((NumWithComma(d.getElementById('frm1702q:Sched3:txtTax6').value)));

        //formatCurrency(Math.round(NumWithComma(d.getElementById('frm1702q:Sched3:txtTax6').value)).toFixed(2));







        //INCOME TAX DUE
        var tax11 = NumWithComma(d.getElementById('frm1702q:Sched2:txtTax11').value);
        var tax12 = NumWithComma(d.getElementById('frm1702q:Sched2:txtTax12').value);
        var tax13Field = d.getElementById('frm1702q:Sched2:txtTax13');
        var tax15Field = d.getElementById('frm1702q:txtTax15');

        if (tax11 == tax12) {
            tax13Field.value = formatCurrency(tax11);
        } else if (tax11 > tax12) {
            tax13Field.value = formatCurrency(tax11);
            tax15Field.disabled = false;
        } else {
            tax13Field.value = formatCurrency(tax12);  // Dapat `tax12` kung mas mataas ito
            tax15Field.value = '0.00';
            tax15Field.disabled = true;
        }



        //ASSIGN VALUE TO PART II ITEM 14
        d.getElementById('frm1702q:txtTax14').value = d.getElementById('frm1702q:Sched2:txtTax13').value
        var sampleVariable = formatCurrency(Math.round(d.getElementById('frm1702q:txtTax14').value));
        d.getElementById('frm1702q:txtTax14').value = sampleVariable



        d.getElementById('frm1702q:txtTax14').value = formatCurrency(Math.round(NumWithComma(d.getElementById('frm1702q:Sched2:txtTax13').value)));



        //RELOAD PART II

        Part2_Computation();

    }

    function Sched3_Computation() {
        //TOTAL GROSS INCOME (Schedule 3 - 4)
        var ComputeSched3_4 = NumWithComma(d.getElementById("frm1702q:Sched3:txtTax1").value) + NumWithComma(d.getElementById("frm1702q:Sched3:txtTax2").value) + NumWithComma(d.getElementById("frm1702q:Sched3:txtTax3").value)
        d.getElementById('frm1702q:Sched3:txtTax4').value = formatCurrency(NumWithComma(ComputeSched3_4.toFixed(2).toString()));

        //MINIMUM CORPORATE INCOME TAX (Schedule 3-6)
        var ComputeSched3_6 = formatCurrency((NumWithComma(d.getElementById("frm1702q:Sched3:txtTax4").value) * NumWithComma(d.getElementById("frm1702q:Sched3:txtTax5").value) * 1 / 100).toFixed(2));
        var roundedSched3_6 = Math.round(NumWithComma(ComputeSched3_6));
        if (roundedSched3_6 < 0) {
            roundedSched3_6 = 0;
        }
        d.getElementById('frm1702q:Sched3:txtTax6').value = formatCurrency(roundedSched3_6.toFixed(2));

        //ASSIGN VALUE TO SCHEDULE 2 ITEM 12


        //d.getElementById('frm1702q:Sched2:txtTax12').value =  d.getElementById('frm1702q:Sched3:txtTax6').value = ComputeSched3_6;      

        //RELOAD SCHEDULE 2 COMPUTATION
        Sched2_Computation();

    }

    function ComputeOtherTaxCredits() {

        var OtherTaxCredit = 0;

        for (var i = 0; i < d.getElementById("tblOthrTxCrdts").rows.length; i++) {

            //GETTING THE TOTAL OF APPLICABLE COLUMN
            OtherTaxCredit += NumWithComma(d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + i).value);
        }
        return OtherTaxCredit
    }

    function Sched4_Computation() {
        //TOTAL TAX CREDITS/PAYMENTS
        var OtherTaxCredit = ComputeOtherTaxCredits();
        var ComputeSched4_7 = NumWithComma(d.getElementById("frm1702q:Sched4:txtTax1").value) + NumWithComma(d.getElementById("frm1702q:Sched4:txtTax2").value) + NumWithComma(d.getElementById("frm1702q:Sched4:txtTax3").value) + NumWithComma(d.getElementById("frm1702q:Sched4:txtTax4").value) + NumWithComma(d.getElementById("frm1702q:Sched4:txtTax5").value) + NumWithComma(d.getElementById("frm1702q:Sched4:txtTax6").value) + OtherTaxCredit
        d.getElementById('frm1702q:Sched4:txtTax7').value = formatCurrency(NumWithComma(ComputeSched4_7.toFixed(2).toString()));


        d.getElementById('frm1702q:Sched3:txtTax6').value = d.getElementById('frm1702q:Sched2:txtTax12').value

        //ASSIGN VALUE TO PART II ITEM 19
        d.getElementById('frm1702q:txtTax19').value = d.getElementById('frm1702q:Sched4:txtTax7').value

        //RELOAD PART II COMPUTATION
        Part2_Computation();
    }

    function ALL_Computation() {
        Sched1_Computation();
        Sched2_Computation();
        Sched3_Computation();
        Sched4_Computation();
        Part2_Computation();
    }

    function ProcessMethodOfDeduction(ATC) {

        switch (ATC) {

            case "IC010_30%": // "IC010_30%"
            case "IC010_25%": // "IC010_25%"
            case "IC010_20%": // "IC010_20%"
            case "IC020_30%": // "IC020_30%"
            case "IC020_25%": // "IC020_25%"
            case "IC020_20%": // "IC020_20%"
            case "IC030_30%": // "IC030_30%"
            case "IC030_25%": // "IC030_25%"
            case "IC030_20%": // "IC030_20%"
            case "IC031_30%": // "IC031_30%"
            case "IC031_25%": // "IC031_25%"
            case "IC031_20%": // "IC031_20%"
            case "IC040_30%": // "IC040_30%"
            case "IC040_25%": // "IC040_25%"
            case "IC040_20%": // "IC040_20%"
            case "IC041_30%": // "IC041_30%"
            case "IC041_25%": // "IC041_25%"
            case "IC041_20%": // "IC041_20%"
            case "IC070_30%": // "IC070_30%"
            case "IC070_25%": // "IC070_25%"
            case "IC101_25%": // "IC101_25%"
            case "OBU_25%": // "OBU_25%"
            case "IC191_30%": // "IC191_30%"

                if (d.getElementById('frm1702q:rbMthdOfDdctns_1').checked == true) {
                    d.getElementById('frm1702q:Sched2:txtTax6').disabled = false;
                    // d.getElementById('frm1702q:Sched2:txtTax6').value = '0.00';
                    Sched2_Computation();
                } else if (d.getElementById('frm1702q:rbMthdOfDdctns_2').checked == true) {
                    d.getElementById('frm1702q:Sched2:txtTax6').disabled = true;
                    d.getElementById('frm1702q:Sched2:txtTax6').value = formatCurrency((NumWithComma(d.getElementById("frm1702q:Sched2:txtTax5").value) * 0.40).toFixed(2));
                    Sched2_Computation();
                } else {
                    d.getElementById('frm1702q:Sched2:txtTax6').disabled = true;
                    d.getElementById('frm1702q:Sched2:txtTax6').value = '0.00';
                    Sched2_Computation();
                }
                break;
        }

    }
    function activateGrossIncomeRegularFieldsPerQuarter() {
        if (d.getElementById('frm1702q:rbQuarter').checked == true) {
            d.getElementById('frm1702q:Sched3:txtTax1').disabled = false;
        }
        else if (d.getElementById('frm1702q:rbQuarter_2' == true).checked) {
            d.getElementById('frm1702q:Sched3:txtTax1').disabled = false;
            d.getElementById('frm1702q:Sched3:txtTax2').disabled = false;
        }
        else if (d.getElementById('frm1702q:rbQuarter_3' == true).checked) {
            d.getElementById('frm1702q:Sched3:txtTax1').disabled = false;
            d.getElementById('frm1702q:Sched3:txtTax2').disabled = false;
            d.getElementById('frm1702q:Sched3:txtTax3').disabled = false;
        }
        else {
            d.getElementById('frm1702q:Sched3:txtTax1').disabled = true;
            d.getElementById('frm1702q:Sched3:txtTax2').disabled = true;
            d.getElementById('frm1702q:Sched3:txtTax3').disabled = true;
        }

    }
    function ProcessTaxableIncomePrevQtr(ATC) {

        switch (ATC) {

            case "IC010_30%": // "IC010_30%"
            case "IC010_25%": // "IC010_25%"
            case "IC010_20%": // "IC010_20%"
            case "IC020_30%": // "IC020_30%"
            case "IC020_25%": // "IC020_25%"
            case "IC020_20%": // "IC020_20%"
            case "IC030_30%": // "IC030_30%"
            case "IC030_25%": // "IC030_25%"
            case "IC030_20%": // "IC030_20%"
            case "IC031_30%": // "IC031_30%"
            case "IC031_25%": // "IC031_25%"
            case "IC031_20%": // "IC031_20%"
            case "IC040_30%": // "IC040_30%"
            case "IC040_25%": // "IC040_25%"
            case "IC040_20%": // "IC040_20%"
            case "IC041_30%": // "IC041_30%"
            case "IC041_25%": // "IC041_25%"
            case "IC041_20%": // "IC041_20%"
            case "IC070_30%": // "IC070_30%"
            case "IC070_25%": // "IC070_25%"
            case "IC101_25%": // "IC101_25%"
            case "OBU_25%": // "OBU_25%"
            case "IC191_30%": // "IC191_30%"
            case "IC191_25%_OtherThanForeignCurrencyTransaction_New":

                if (d.getElementById('frm1702q:rbQuarter').checked == true) {

                    d.getElementById('frm1702q:Sched1:txtTax8A').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched1:txtTax8A').disabled = true;

                    d.getElementById('frm1702q:Sched1:txtTax8B').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched1:txtTax8B').disabled = true;

                    d.getElementById('frm1702q:Sched2:txtTax8').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched2:txtTax8').disabled = true;

                    d.getElementById('frm1702q:Sched4:txtTax2').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched4:txtTax2').disabled = true;

                    d.getElementById('frm1702q:Sched4:txtTax3').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched4:txtTax3').disabled = true;

                    d.getElementById('frm1702q:Sched4:txtTax4').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched4:txtTax4').disabled = true;

                    Sched1_Computation();
                    Sched2_Computation();
                    Sched4_Computation();
                } else if (d.getElementById('frm1702q:rbQuarter_2').checked == true || d.getElementById('frm1702q:rbQuarter_3').checked == true) {
                    d.getElementById('frm1702q:Sched1:txtTax8A').disabled = false;
                    d.getElementById('frm1702q:Sched1:txtTax8B').disabled = false;
                    d.getElementById('frm1702q:Sched2:txtTax8').disabled = false;
                    d.getElementById('frm1702q:Sched4:txtTax2').disabled = false;
                    d.getElementById('frm1702q:Sched4:txtTax3').disabled = false;
                    d.getElementById('frm1702q:Sched4:txtTax4').disabled = false;
                    Sched1_Computation();
                    Sched2_Computation();
                    Sched4_Computation();
                }
                break;

            case "IC011_0%":
            case "IC021_Exempt":
            case "IC200_0%":

                if (d.getElementById('frm1702q:rbQuarter_1').checked == true) {
                    d.getElementById('frm1702q:Sched1:txtTax8A').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched1:txtTax8A').disabled = true;
                    Sched1_Computation();
                } else if (d.getElementById('frm1702q:rbQuarter_2').checked == true || d.getElementById('frm1702q:rbQuarter_3').checked == true) {
                    d.getElementById('frm1702q:Sched1:txtTax8A').disabled = false;
                    Sched1_Computation();
                }
                break;

            case "IC030_10%":
            case "IC030_1%":
            case "IC031_10%":
            case "IC031_1%":
            case "IC200_5%":
            case "IC210_2%":
            case "IC080_2.5%":
            case "IC101_10%":
            case "IC190_10%_NotSubjectToFinalTax":
            case "IC190_30%_OtherThanForeignCurrencyTransaction":
            case "IC191_10%":
            case "IC190_25%_NotSubjectToFinalTax_New":
            case "IC190_25%_OtherThanForeignCurrencyTransaction_New":
            case "IC191_25%_NotSubjectToFinalTax_New":

                if (d.getElementById('frm1702q:rbQuarter_1').checked == true) {
                    d.getElementById('frm1702q:Sched1:txtTax8B').value = parseFloat(0).toFixed(2);
                    d.getElementById('frm1702q:Sched1:txtTax8B').disabled = true;
                    Sched1_Computation();
                } else if (d.getElementById('frm1702q:rbQuarter_2').checked == true || d.getElementById('frm1702q:rbQuarter_3').checked == true) {
                    d.getElementById('frm1702q:Sched1:txtTax8B').disabled = false;
                    Sched1_Computation();
                }
                break;
        }
    }

    function isEmptyOrSpaces(str) {
        return str === null || str.match(/^ *$/) !== null;
    }

    function roundupdown(num) {
        var x = Math.round(NumWithComma(num.value));
        num.value = formatCurrency(NumWithComma(x.toFixed(2).toString()));
    }


