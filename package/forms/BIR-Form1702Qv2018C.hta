    function enableAllControl() {

        var CreateYear = 2000 + (d.getElementById('frm1702q:txtYrEndYear').value * 1);
        var CreateMonth = d.getElementById('frm1702q:rbYrEndMonth').value;

        d.getElementById('frm1702q:rbForClndrFscl_1').disabled = false;
        d.getElementById('frm1702q:rbForClndrFscl_2').disabled = false;

        if (d.getElementById('frm1702q:rbForClndrFscl_1').checked == true) {
            d.getElementById('frm1702q:rbYrEndMonth').disabled = true;
        } else {
            d.getElementById('frm1702q:rbYrEndMonth').disabled = false;
        }

        d.getElementById('frm1702q:txtYrEndYear').disabled = false;
        d.getElementById('frm1702q:rbQuarter_1').disabled = false;
        d.getElementById('frm1702q:rbQuarter_2').disabled = false;
        d.getElementById('frm1702q:rbQuarter_3').disabled = false;
        d.getElementById('frm1702q:rbAmendedRtn_1').disabled = false;
        d.getElementById('frm1702q:rbAmendedRtn_2').disabled = false;
        d.getElementById('frm1702q:rbATC_1').disabled = false;
        d.getElementById('frm1702q:rbATC_2').disabled = false;
        d.getElementById('frm1702q:txtATC_1').disabled = false;
        d.getElementById('frm1702q:cbATC_2').disabled = false;
        d.getElementById('frm1702q:rbMthdOfDdctns_1').disabled = false;
        d.getElementById('frm1702q:rbMthdOfDdctns_2').disabled = false;

        if (d.getElementById('frm1702q:rbTxRlf_2').checked == true) {
            d.getElementById('frm1702q:rbTxRlf_1').disabled = false;
            d.getElementById('frm1702q:rbTxRlf_2').disabled = false;
            d.getElementById('frm1702q:txtTxRlfSpcfy').disabled = true;
        } else {
            d.getElementById('frm1702q:rbTxRlf_1').disabled = false;
            d.getElementById('frm1702q:rbTxRlf_2').disabled = false;
            d.getElementById('frm1702q:txtTxRlfSpcfy').disabled = false;
        }


        if (NumWithComma(d.getElementById('frm1702q:Sched2:txtTax11').value) > NumWithComma(d.getElementById('frm1702q:Sched2:txtTax12').value)) {
            d.getElementById('frm1702q:txtTax15').disabled = false;
        } else if (NumWithComma(d.getElementById('frm1702q:Sched2:txtTax12').value) > NumWithComma(d.getElementById('frm1702q:Sched2:txtTax11').value)) {
            d.getElementById('frm1702q:txtTax15').disabled = true;
        }

