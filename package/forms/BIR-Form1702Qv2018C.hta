    function enableSched4() {
        var firstRowIndex = 0;
        var secondRowIndex = 1;
        var firstRowValueDescription = d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + firstRowIndex).value;
        var firstRowValueAmount = d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + firstRowIndex).value;
        var secondRowValueDescription = d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + secondRowIndex).value;
        var secondRowValueAmount = d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + secondRowIndex).value;

        d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + firstRowIndex).disabled = false;
        d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + firstRowIndex).disabled = false;

        // Check if first row has a value
        if (firstRowValueDescription != null && firstRowValueAmount != "0.00") {
            var nextRowIndex = firstRowIndex + 1;
            var rowCount = d.getElementById("tblOthrTxCrdts").rows.length;

            if (nextRowIndex < rowCount) {
                d.getElementById('frm1702q:Sched4:txtOthrTxCrdts' + nextRowIndex).disabled = false;
                d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt' + nextRowIndex).disabled = false;
            }
        }

        // Check if second row has a value
        if (secondRowValueDescription != null && secondRowValueAmount != "0.00") {
            d.getElementById('frm1702q:Sched4:btnAdd').disabled = false;
            d.getElementById('frm1702q:Sched4:btnDelete').disabled = false;
        } else {
            d.getElementById('frm1702q:Sched4:btnAdd').disabled = true;
            d.getElementById('frm1702q:Sched4:btnDelete').disabled = true;
        }

        var startRow = 2;  // Start in Third row

        for (var i = startRow; i < rowCount; i++) {
            var previousRowIndex = i - 1;

            // Get the values of the previous row
            var previousRowValue = d.getElementById("frm1702q:Sched4:txtOthrTxCrdts" + previousRowIndex).value;
            var previousRowAmount = d.getElementById("frm1702q:Sched4:txtOthrTxCrdtAmnt" + previousRowIndex).value;

            // If the previous row is not filled, disable the current row
            if (previousRowValue == "" && previousRowAmount == "0.00") {
                disableRow(i);
                return;  // Stop execution if the previous row is not filled
            } else if (previousRowValue != "" && previousRowAmount != "0.00") {
                enableNextRow(i);  // Enable the next row if the previous row is filled
            }
        }
    }

    // VALIDATE INPUTS
    function validationSpecify() {
        var size = specifyToCommit.length;
        for (var i = 0; i < size; i++) {
            if (d.getElementById('frm1702q:sched4:Description' + i).value == "" ||
                d.getElementById('frm1702q:sched4:Amount' + i).value == "0.00") {
                alert("Empty fields are not allowed");
                return;
            }
        }
        return true;
    }

    var specifyToCommit = new Array();


    function NewSpecifySched4() {
        this.txtSpecifySched4Description = '';
        this.txtSpecifySched4Amount = '0.00';
    }

    // ADD COLUMN SCHED 4
    function addColSched4() {
        if (validationSpecify()) {
            var size = specifyToCommit.length;
            var externalInputValueDescription = document.getElementById('frm1702q:sched4:txtOthrTxCrdts1').value;
            var externalInputValueTotal = document.getElementById('frm1702q:sched4:txtOthrTxCrdtAmnt1').value;

            // Populate the specifyToCommit array with existing values
            for (var i = 0; i < size; i++) {
                specifyToCommit[i].txtSpecifySched4Description = document.getElementById('frm1702q:sched4:Description' + i).value;
                specifyToCommit[i].txtSpecifySched4Amount = document.getElementById('frm1702q:sched4:Amount' + i).value;
            }

            // Add new entry if no existing entries
            if (size < 1) {
                specifyToCommit[size] = new NewSpecifySched4();
                specifyToCommit[size].txtSpecifySched4Description = externalInputValueDescription;
                specifyToCommit[size].txtSpecifySched4Amount = externalInputValueTotal;
            }

            // Add a new entry to the array
            specifyToCommit.push(new NewSpecifySched4());
            $('#tbodySched4').html("");

            // Render the updated schedule table
            for (var i = 0; i < specifyToCommit.length; i++) {
                $('#tbodySched4').append(
                    "<tr>" +
                    "<td width='10%' style='border: 1px solid black; padding: 2px'>B." + (i + 1) + "</td>" +
                    "<td width='50%' style='border: 1px solid black; padding: 2px'>" +
                    "<input type='text' id='frm1702q:sched4:Description" + i + "' style='width: 450px;' value='" + specifyToCommit[i].txtSpecifySched4Description + "' maxlength='50'>" +
                    "</td>" +
                    "<td width='30%' style='border: 1px solid black; padding: 2px'>" +
                    "<input type='text' id='frm1702q:sched4:Amount" + i + "' style='width: 150px; text-align: right;' value='" + specifyToCommit[i].txtSpecifySched4Amount + "' onblur='roundupdown(this,2); computeOtherSpecify();' maxlength='25'>" +
                    "</td>" +
                    "<td width='10%' style='border: 1px solid black; padding: 2px;'>" +
                    "<button id='deleteId1" + i + "' onclick='deleteRowSched4(" + i + ")' style='padding: 2px'>Remove</button>" +
                    "</td>" +
                    "</tr>"
                );
            }

            computeOtherSpecify();
        }
    }




    // COMPUTE SCHED 4
    function computeOtherSpecify() {
        // Correct the ID references based on your actual HTML
        var inputField = document.getElementById('frm1702q:sched4:txtOthrTxCrdtAmnt1'); // Corrected ID
        var resultField = document.getElementById('resultOtherSpecify');

        if (!inputField || !resultField) {
            console.error("Input or result field not found. Please check the IDs.");
            return; // Stop if the fields are not found
        }

        // Ensure specifyToCommit is defined and has items
        var size = specifyToCommit ? specifyToCommit.length : 0;
        var otherCredits = 0;

        // If there are no items, set values to "0.00"
        if (size === 0) {
            inputField.value = "0.00";
            resultField.value = "0.00";
        } else {
            // Loop through specifyToCommit and sum the Amount fields
            for (var i = 0; i < size; i++) {
                var amountField = document.getElementById('frm1702q:sched4:Amount' + i);
                if (amountField) {
                    var amountValue = Math.round(NumWithComma(amountField.value)); // Parse the value correctly
                    otherCredits += amountValue ? parseFloat(amountValue) : 0;
                }
            }
            // Format and display the calculated total
            var formattedOtherCredits = formatCurrency(otherCredits);
            inputField.value = formattedOtherCredits;
            resultField.value = formattedOtherCredits;
        }
    }



    // DELETE SCHED 4
    function deleteRowSched4(index) {
        var size = specifyToCommit.length;
        var externalInputValueDescription = document.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt1').value;
        var externalInputValueTotal = document.getElementById('frm1702q:Sched4:txtOthrTxCrdts1').value;

        for (var i = 0; i < size; i++) {
            specifyToCommit[i].txtSpecifySched4Description = d.getElementById('frm1702q:sched4:Description' + i).value;
            specifyToCommit[i].txtSpecifySched4Amount = d.getElementById('frm1702q:sched4:Amount' + i).value;
        }

        if (size < 1) {
            specifyToCommit[size] = new NewSpecifySched4();
            specifyToCommit[size].txtSpecifySched4Description = externalInputValueDescription;
            specifyToCommit[size].txtSpecifySched4Amount = externalInputValueTotal
        }


        specifyToCommit.splice(index, 1);
        $('#tbodySched4').html("");
        for (var i = 0; i < specifyToCommit.length; i++) {
            $('#tbodySched4').append(
                "<tr>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px'>E." + (i + 1) + "</td>" +
                "<td width='50%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm1702q:sched4:Description" + i + "' style='width: 450px;' value='" + specifyToCommit[i].txtSpecifySched4Description + "' maxlength='50'> </td>" +
                "<td width='30%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm1702q:sched4:Amount" + i + "' style='width: 150px; text-align: right;' value='" + specifyToCommit[i].txtSpecifySched4Amount + "' onblur='round(this,2); computeOtherSpecify();'  maxlength='25'> </td>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px;'> <button id='deleteId1" + i + "' onclick='deleteRowSched4(" + i + ")' style='padding: 2px'>Remove</button> </td>" +
                "</tr>"
            );
        }
        computeOtherSpecify();
    }

    // CANCEL SCHED 4

    function cancelSched4() {
        // Function to manually trim whitespace
        function manualTrim(str) {
            return str.replace(/^\s+|\s+$/g, '');
        }

        // Get the table body element
        var tableBody = document.getElementById('tbodySched4');
        if (!tableBody) {
            alert("Table body element not found.");
            return;
        }

        var rows = tableBody.getElementsByTagName('tr');
        var specifyToCommit = [];
        var count = 0;

        // Iterate over each row in the table body
        for (var i = 0; i < rows.length; i++) {
            // Skip empty rows or rows that don't have the correct structure
            if (rows[i].cells.length < 3) continue;

            var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
            var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

            if (!descriptionInput || !amountInput) {
                alert("Input elements not found in row " + i);
                continue;
            }

            var description = manualTrim(descriptionInput.value);
            var amount = manualTrim(amountInput.value);

            // Validate the inputs
            if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                count += 1; // Increment count for invalid rows
            } else {
                // Add valid rows to specifyToCommit array
                specifyToCommit.push({
                    txtSpecifySched4Description: description,
                    txtSpecifySched4Amount: parseFloat(amount).toFixed(2)
                });
            }
            deleteRowSched4();
        }
    }

    // SAVE SCHED 4

    function savingSched4() {

        var tableBody = document.getElementById('tbodySched4');
        var rows = tableBody.getElementsByTagName('tr');
        var specifyToCommit = [];
        var count = 0;

        function manualTrim(str) {
            return str.replace(/^\s+|\s+$/g, ''); g
        }

        for (var i = 0; i < rows.length; i++) {
            var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
            var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

            var description = manualTrim(descriptionInput.value);
            var amount = manualTrim(amountInput.value);

            if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                count += 1; // Increment count for invalid rows
            } else {
                specifyToCommit.push({
                    txtSpecifySched4Description: description,
                    txtSpecifySched4Amount: parseFloat(amount).toFixed(2)
                });
            }
        }
    }


    // SAVE AND CLOSE SCHED 4

    function saveAndCloseSched4() {
        function manualTrim(str) {
            return str.replace(/^\s+|\s+$/g, '');
        }

        var tableBody = document.getElementById('tbodySched4');
        var rows = tableBody.getElementsByTagName('tr');
        var specifyToCommit = [];
        var count = 0;

        for (var i = 0; i < rows.length; i++) {
            if (rows[i].cells.length < 3) continue;

            var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
            var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

            var description = manualTrim(descriptionInput.value);
            var amount = manualTrim(amountInput.value);

            if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                count += 1; // Increment count for invalid rows
            } else {
                specifyToCommit.push({
                    txtSpecifySched4Description: description,
                    txtSpecifySched4Amount: parseFloat(amount).toFixed(2)
                });
            }
        }

        if (count === 0) {
            alert('Data has been saved successfully!');

            closeModalSched4();
        } else {
            alert('Please fill up all required fields and ensure amounts are greater than zero.');
        }
    }



    // CLOSE MODAL SCHED 4
    function closeModalSched4() {

        if ($('#modalSched4').css('display') != 'none') {
            // $('#modalNewSched1').hide('blind');
            $('#container').show();
            $('#modalSched4').hide('blind');
        }

        var size = specifyToCommit.length;

        if (size > 1) {
            document.getElementById('frm1702q:sched4:txtOthrTxCrdts1').value = "VARIOUS"
            document.getElementById('frm1702q:sched4:txtOthrTxCrdts1').disabled = true
            document.getElementById('frm1702q:sched4:txtOthrTxCrdtAmnt1').disabled = true
            var latestValue = d.getElementById('resultOtherSpecify').value;
            d.getElementById('frm1702q:sched4:txtOthrTxCrdtAmnt1').value = latestValue;
        }
        if (size < 1) {
            // document.getElementById('frm1702q:sched4:txtOthrTxCrdts1').value = ""
            // document.getElementById('frm1702q:sched4:txtOthrTxCrdtAmnt1').value = "0.00"
            document.getElementById('frm1702q:sched4:txtOthrTxCrdts1').disabled = false
            document.getElementById('frm1702q:sched4:txtOthrTxCrdtAmnt1').disabled = false
        }
        Sched4_Computation();

    }





