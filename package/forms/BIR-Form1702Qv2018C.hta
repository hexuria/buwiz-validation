                                                        </div>
                                                    </div>
                                                    <br />
                                                </td>
                                                <div id="DummyTxt" style='display:none;'> </div>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

            </div>
        </div>
        <!-- import modal -->

        <div id="modalSched4" class="printSignFooterClass aBox2550mSched1"
            style="width: 60%; display: none; height: 70%; position: fixed; top: 10%; left: 20%; right: auto; overflow-y: auto; overflow-x: hidden; background: #e2e2e2; border: 1px solid black">
            <br><br>
            <h3 style="font-size: 12px; margin-bottom: 4px; font-weight: bold; text-align: center">Credits / Payment
            </h3>
            <table cellspacing="3" cellpadding="3" width="100% border:1px solid black;" id="tblSched4" align="center">
                <thead align="center" style="font-size: 12px; border: 1px solid black;">
                    <tr style="border:1px solid black;">
                        <th width="10%" style="border: 1px solid black;">&nbsp;</th>
