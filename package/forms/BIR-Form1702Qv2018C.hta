                                                            onclick="saveXML(false);" />
                                                        <!--<input class="printButtonClass" type="button" value="Print" style="width: 100px;" name="btnPrint" id="btnPrint" onclick="window.print()" />-->
                                                        <input class="printButtonClass" type="button" value="Print"
                                                            style="width: 100px;" name="btnPrint" id="btnPrint"
                                                            onclick="printme();" />
                                                        <input class="printButtonClass" type="button"
                                                            value="Submit / Final Copy" style="width: 200px;"
                                                            name="frm1702q:btnFinalCopy" id="frm1702q:btnFinalCopy"
                                                            onclick="openAlertEmail();" />
