            // }
            // else {
            d.getElementById('frm1702q:txtTaxpayerName1').value = unescape(fnVal[1]);

            //}

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            d.getElementById('frm1702q:txtTIN1').value = tin1Val[1];
            d.getElementById('frm1702q:txtPg2TIN1').value = tin1Val[1];

