    function clearCheck(id) {
        if (d.getElementById(id).waschecked == true) {
            d.getElementById(id).checked = false;
            d.getElementById(id).waschecked = false;
        }
        else {
            d.getElementById(id).waschecked = true;
        }
    }



    function ProcessAmended(ATC) {

        switch (ATC) {

