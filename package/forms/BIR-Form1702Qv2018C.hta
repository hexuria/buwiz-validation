    // Modify the existing function above
    function deleteOtherTaxCredits() {
        var table = d.getElementById("tblOthrTxCrdts");
        if (!table) return;

        var rowCount = table.rows.length;

        // ✅ Step 1: make sure all checkboxes are enabled before selection
        for (var x = 0; x < rowCount; x++) {
            var chkBox = d.getElementById("frm1702q:Sched4:chkOthrTxCrdts" + x);
            if (chkBox) chkBox.disabled = false;
        }

        // ✅ Step 2: clear values only for checked rows
        for (var i = 0; i < rowCount; i++) {
            var chk = d.getElementById("frm1702q:Sched4:chkOthrTxCrdts" + i);
            var desc = d.getElementById("frm1702q:Sched4:txtOthrTxCrdts" + i);
            var amt = d.getElementById("frm1702q:Sched4:txtOthrTxCrdtAmnt" + i);

            if (chk && chk.checked) {
                // clear fields
                if (desc) {
                    desc.value = "";
                    desc.disabled = false;
                }
                if (amt) {
                    amt.value = "0.00";
                    amt.disabled = false;
                }

                // reset checkbox
                chk.checked = false;
                chk.disabled = false;
                //clear sched 4 modal
                clearSched4ModalData();
            }
        }

        // ✅ Step 3: trigger recomputation and UI refresh
        if (typeof Sched4_Computation === "function") Sched4_Computation();
        if (typeof enableSched4 === "function") enableSched4();
    }

    // Added this function to clear the sched 4 modal’s table data
    function clearSched4ModalData() {
        // var d = document;
        var tbody = d.getElementById("tbodySched4");

        if (tbody) {
            // Loop through each row and clear input values
            for (var i = 0; i < tbody.rows.length; i++) {
                var row = tbody.rows[i];
                for (var j = 0; j < row.cells.length; j++) {
                    var cell = row.cells[j];
                    // Clear input elements inside each cell
                    var inputs = cell.getElementsByTagName("input");
                    for (var k = 0; k < inputs.length; k++) {
                        var input = inputs[k];
                        if (input.type === "text") {
                            input.value = "";
                        } else if (input.type === "checkbox") {
                            input.checked = false;
                        }
                    }
                }
            }
        }

        // Reset subtotal field
        var subtotalField = d.getElementById("resultOtherSpecify");
        if (subtotalField) subtotalField.value = "0.00";
    }

    function loadOtherTaxCredits() {

        var OtherTaxCredit = String($("#response").html()).split("frm1702q:Sched4:txtOthrTxCrdts");
        var OtherTaxCreditAmount = String($("#response").html()).split("frm1702q:Sched4:txtOthrTxCrdtAmnt");

        $('#tblOthrTxCrdts').html("");

        var i = 0;
        for (var j = 0; j < OtherTaxCredit.length; j++) {
            if (j % 2 != 0) {//to not get other div splits

                // get values
                OtherTaxCreditToCommit[i] = new Sched4OtherTaxCredit();
                OtherTaxCreditToCommit[i].txtOtherTaxCredit = OtherTaxCredit[j].split('=')[1];
                OtherTaxCreditToCommit[i].txtOtherTaxCreditAmount = OtherTaxCreditAmount[j].split('=')[1];

                i++;

            }
        }

        for (x = 0; x < OtherTaxCreditToCommit.length; x++) {

            $('#tblOthrTxCrdts').html(d.getElementById('tblOthrTxCrdts').innerHTML + "<tr>" +
                "<td width='25'><input type='checkbox' id='frm1702q:Sched4:chkOthrTxCrdts" + x + "'></td>" +
                "<td colspan='2'><font size='1' face='Arial, Helvetica, sans-serif'> " + getLetter(x) + " &nbsp;&nbsp;</font><input type='text' value='" + OtherTaxCreditToCommit[x].txtOtherTaxCredit + "' style='color: black; text-align: left;' size='60'  maxlength='25' id='frm1702q:Sched4:txtOthrTxCrdts" + x + "'></td>" +
                "<td width='190' align='left'><span class='spacePadder'><font size='2' style='font-weight:bold;'>" + getLetter(x) + "</font>&nbsp; <input type='text' value='" + OtherTaxCreditToCommit[x].txtOtherTaxCreditAmount + "' style='color: black; text-align: right;' size='22'  maxlength='25' id='frm1702q:Sched4:txtOthrTxCrdtAmnt" + x + "' onblur='round(this,2); Sched4_Computation();' onkeypress='return numbersonly(this, event)'></span></td>" +
                "</tr>");

        }
    }

    function getLetter(x) {
        var letter = '';
        switch (x) {
            case 0:
                letter = 'a'
                break;
            case 1:
                letter = 'b'
                break;
            case 2:
                letter = 'c'
                break;
            case 3:
                letter = 'd'
                break;
            case 4:
                letter = 'e'
                break;
            case 5:
                letter = 'f'
                break;
            case 6:
                letter = 'g'
                break;
            case 7:
                letter = 'h'
                break;
            case 8:
                letter = 'i'
                break;
            case 9:
                letter = 'j'
                break;
            case 10:
                letter = 'k'
                break;
            case 11:
                letter = 'l'
                break;
            case 12:
                letter = 'm'
                break;
            case 13:
                letter = 'n'
                break;
            case 14:
                letter = 'o'
                break;
            case 15:
                letter = 'p'
                break;
            case 16:
                letter = 'q'
                break;
            case 17:
                letter = 'r'
                break;
            case 18:
                letter = 's'
                break;
            case 19:
                letter = 't'
                break;
            case 20:
                letter = 'u'
                break;
            case 21:
                letter = 'v'
                break;
            case 22:
                letter = 'w'
                break;
            case 23:
                letter = 'x'
                break;
            case 24:
                letter = 'y'
                break;
            case 25:
                letter = 'z'
                break;
        }
        return letter;
    }

    function goToSched(page) {
        document.getElementById("frm1702q:txtCurrentPage").value = page;
        goToPage();
    }

    function setDecimal(event) {

        var regex = /^\d+(\.\d{1,5})?$/;

        if (regex.test(d.getElementById("frm1702q:Sched2:txtTax10").value)) {
            d.getElementById("frm1702q:Sched2:txtTax10").value;
        }
        else {
            alert('Decimal point must be less than 5 places only');
            d.getElementById("frm1702q:Sched2:txtTax10").value = 0.00000;
        }

    }



    function setDecimalB(event) {

        var regex = /^\d+(\.\d{1,5})?$/;

        if (regex.test(d.getElementById("frm1702q:Sched1:txtTax10B").value)) {
            d.getElementById("frm1702q:Sched1:txtTax10B").value;
        }
        else {
            alert('Decimal point must be less than 5 places only');
            d.getElementById("frm1702q:Sched1:txtTax10B").value = 0.00000;
        }

    }




    function taxCreditPayments() {
        taxCredits = d.getElementById('frm1702q:Sched4:txtOthrTxCrdts0').value;
        totalCredits = d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt0').value;

        if (taxCredits != "" && totalCredits != "0.00") {
            d.getElementById('addOtherTaxCredits();').disabled = false;
        };

        if (taxCredits == null) {
            d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt0').disabled = true;
        } else {
            d.getElementById('frm1702q:Sched4:txtOthrTxCrdtAmnt0').disabled = false;
        }
    }


    function enableOptionalDeduction() {
        var selectedOptionalDeduction = document.getElementById('frm1702q:cbATC_2').value;
        var deductionMethod = document.getElementById('frm1702q:rbMthdOfDdctns_1'); // Itemized Deductions radio button
        var deductionOsd = document.getElementById('frm1702q:rbMthdOfDdctns_2'); // Optional Standard Deduction (OSD) radio button

        // Run logic only if a valid dropdown value is selected
        if (selectedOptionalDeduction) {
            // Check for General Professional Partnership or specific exempt value
            if (
                selectedOptionalDeduction.indexOf("General Professional Partnership") !== -1 ||
                selectedOptionalDeduction === "ICO21" ||
                selectedOptionalDeduction === "IC021_Exempt"
            ) {
                // Allow user to choose between Itemized and OSD
                deductionMethod.checked = false; // Unchecked by default
                deductionMethod.disabled = false; // Enable Itemized Deductions
                deductionOsd.disabled = false; // Enable OSD
            } else if (
                selectedOptionalDeduction.indexOf("30%") === -1 &&
                selectedOptionalDeduction.indexOf("25%") === -1 &&
                selectedOptionalDeduction.indexOf("20%") === -1
            ) {
                // Auto-select Itemized Deductions for rates not 30%, 25%, or 20%
                deductionMethod.checked = true;
                deductionMethod.disabled = false; // Ensure Itemized Deductions is enabled
                deductionOsd.checked = false; // Uncheck OSD
                deductionOsd.disabled = true; // Disable OSD
            } else {
                // Allow user to choose deduction method for 30%, 25%, or 20% rates
                deductionMethod.checked = false; // Unchecked by default
                deductionMethod.disabled = false; // Enable Itemized Deductions
                deductionOsd.disabled = false; // Enable OSD
            }
        } else {
            // Clear the deduction method if no valid ATC is selected
            deductionMethod.checked = false;
            deductionMethod.disabled = false; // Enable Itemized Deductions
            deductionOsd.checked = false;
            deductionOsd.disabled = false; // Enable OSD
        }
    }





    function netIncome() {
        // var incomeTaxdue = parseFloat(d.getElementById('frm1702q:Sched1:txtTax11B').value.replace(/[^0-9.]/g, '')) || 0;
        var incomeTaxdue = (parseFloat(d.getElementById('frm1702q:Sched1:txtTax11A').value.replace(/[^0-9.]/g, '')) || 0) +
            (parseFloat(d.getElementById('frm1702q:Sched1:txtTax11B').value.replace(/[^0-9.]/g, '')) || 0);
        var shareOtherAgencies = parseFloat(d.getElementById('frm1702q:Sched1:txtTax12B').value.replace(/[^0-9.]/g, '')) || 0;
        var netIncome = parseFloat(d.getElementById('frm1702q:Sched1:txtTax13B').value.replace(/[^0-9.]/g, '')) || 0;

        // Ensure netIncome is not negative
        if (incomeTaxdue < shareOtherAgencies) {
            netIncome = 0;
        } else {
            netIncome = incomeTaxdue - shareOtherAgencies;
        }

        d.getElementById('frm1702q:Sched1:txtTax13B').value = netIncome;
    }



    function toggleTax5() {
        var rbATC_1 = document.getElementById("frm1702q:rbATC_1");
        var txtTax5 = document.getElementById("frm1702q:Sched3:txtTax5");

        if (rbATC_1.checked) {
            txtTax5.disabled = false; // Enable field
        } else {
            txtTax5.disabled = true;  // Disable field
            txtTax5.value = "";       // Optional: Clear value if disabled
        }
    }



</script>