    function Sched2Item10TaxRate(ATC) {

        var CreateYear = 2000 + (d.getElementById('frm1702q:txtYrEndYear').value * 1);
        var CreateMonth = d.getElementById('frm1702q:rbYrEndMonth').value;

        switch (ATC) {

            case "IC010_30%": // "IC010_30%"
            case "IC010_25%": // "IC010_25%"
            case "IC010_20%": // "IC010_20%"
            case "IC020_30%": // "IC020_30%"
            case "IC020_25%": // "IC020_25%"
            case "IC020_20%": // "IC020_20%"
            case "IC030_30%": // "IC030_30%"
            case "IC030_25%": // "IC030_25%"
            case "IC030_20%": // "IC030_20%"
            case "IC031_30%": // "IC031_30%"
            case "IC031_25%": // "IC031_25%"
            case "IC031_20%": // "IC031_20%"
            case "IC040_30%": // "IC040_30%"
            case "IC040_25%": // "IC040_25%"
            case "IC040_20%": // "IC040_20%"
            case "IC041_30%": // "IC041_30%"
            case "IC041_25%": // "IC041_25%"
            case "IC041_20%": // "IC041_20%"
            case "IC070_30%": // "IC070_30%"
            case "IC070_25%": // "IC070_25%"
            case "IC101_25%": // "IC101_25%"
            case "OBU_25%": // "OBU_25%"
            case "IC191_30%": // "IC191_30%"
            case "IC191_25%_OtherThanForeignCurrencyTransaction_New": // "case "IC191_25%_OtherThanForeignCurrencyTransaction_New":"

                if (CreateYear == 2020 && CreateMonth == 7 || CreateMonth == 8) {
                    d.getElementById('frm1702q:Sched2:txtTax10').disabled = false;
                    d.getElementById('frm1702q:Sched2:txtTax10').value = '0.00';
                    Sched2_Computation();
                } else {
                    if (d.getElementById('frm1702q:txtYrEndYear').value == '' || d.getElementById('frm1702q:rbYrEndMonth').value == '') {
                        d.getElementById('frm1702q:Sched2:txtTax10').disabled = false;
                        d.getElementById('frm1702q:Sched2:txtTax10').value = '0.00';
                        Sched2_Computation();
                    } else {
                        d.getElementById('frm1702q:Sched2:txtTax10').disabled = false;
                        d.getElementById('frm1702q:Sched2:txtTax10').value = getATCRate(ATC);
                        Sched2_Computation();
                    }
                }
                break;

            default:
                d.getElementById('frm1702q:Sched2:txtTax10').disabled = false;
                d.getElementById('frm1702q:Sched2:txtTax10').value = '0.00';
                Sched2_Computation();
                break;
        }



    }


    function Sched3Item5TaxRate() {

        var CreateYear = 2000 + (d.getElementById('frm1702q:txtYrEndYear').value * 1);
        var CreateMonth = d.getElementById('frm1702q:rbYrEndMonth').value;

        if (d.getElementById('frm1702q:rbATC_1').checked == true && d.getElementById('frm1702q:rbATC_2').checked == true) {
            if (CreateYear == 2018 || CreateYear == 2019) {
                d.getElementById('frm1702q:Sched3:txtTax5').disabled = true;
                d.getElementById('frm1702q:Sched3:txtTax5').value = '2.00';
                Sched3_Computation();
            }

            else if (CreateYear == 2020 && CreateMonth <= 6) {
                d.getElementById('frm1702q:Sched3:txtTax5').disabled = true;
                d.getElementById('frm1702q:Sched3:txtTax5').value = '2.00';
                Sched3_Computation();
            }

            else if (CreateYear == 2020 && CreateMonth >= 7) {
                d.getElementById('frm1702q:Sched3:txtTax5').disabled = false;
                d.getElementById('frm1702q:Sched3:txtTax5').value = '0.00';
                Sched3_Computation();
            }
            else if (CreateYear == 2021 || CreateYear == 2022 || CreateYear == 2023) {
                d.getElementById('frm1702q:Sched3:txtTax5').disabled = false;
                d.getElementById('frm1702q:Sched3:txtTax5').value = '0.00';
                Sched3_Computation();
            }

            else if (CreateYear == 2024 && CreateMonth >= 5) {
                d.getElementById('frm1702q:Sched3:txtTax5').disabled = false;
                d.getElementById('frm1702q:Sched3:txtTax5').value = '0.00';
                Sched3_Computation();

            }

            else if (CreateYear == 2024 && CreateMonth >= 6) {
                d.getElementById('frm1702q:Sched3:txtTax5').disabled = false;
                d.getElementById('frm1702q:Sched3:txtTax5').value = '2.00';
                Sched3_Computation();
            }

            else if (CreateYear >= 2024 && CreateMonth >= 7) {
                d.getElementById('frm1702q:Sched3:txtTax5').disabled = true;
                d.getElementById('frm1702q:Sched3:txtTax5').value = '2.00';
                Sched3_Computation();
            }


            else {
                d.getElementById('frm1702q:Sched3:txtTax5').disabled = true;
                d.getElementById('frm1702q:Sched3:txtTax5').value = '0.00';
            }
        }
    }


    function TaxRelief_Selected() {
