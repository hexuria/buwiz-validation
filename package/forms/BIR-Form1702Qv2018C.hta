            }
        });

        $('a').each(function () {
            if (this.id.length > 1) {
                if (d.getElementById('frm1702q:cmdValidate').disabled == false) {
                    if (enableElem) {
                        d.getElementById(this.id).disabled = true;
                    }
                    else if (disableElem) {
                        d.getElementById(this.id).disabled = false;
                    }
