                <input style="padding: 4px; margin-top: 4px; border: 1px solid black;" type='button'
                    class="printButtonClass" id="btnAdd4" value='Save and Close' onclick="saveAndCloseSched4()" />
                <input style="padding: 4px; margin-top: 4px; border: 1px solid black;" type='button'
                    class="printButtonClass" id="btnAdd5" value='Close' onclick="closeModalSched4()" />
            </div><br><br>
