	function computePage1mScBTotal(person,pgItem,sched) {
		if (person.toString() === "taxpayer"){
			getSum('txtPg1'+pgItem+'A'+sched +',txtPg1'+pgItem+'B'+sched +',txtPg1'+pgItem+'C'+sched, 'txtPg1'+pgItem+'D'+sched);
	    }
		else if (person.toString() === "spouse") {
			getSum('txtPg1'+pgItem+'E'+sched +',txtPg1'+pgItem+'F'+sched +',txtPg1'+pgItem+'G'+sched, 'txtPg1'+pgItem+'H'+sched);
		}
	}
	
	function computePage2mScheduleC(person){
		if(person.toString() === "taxpayer"){
			//item 18 A Exempt
			getSum('txtPg2mI1ASchdC,txtPg2mI2ASchdC,txtPg2mI3ASchdC,txtPg2mI4ASchdC,txtPg2mI5ASchdC,txtPg2mI6ASchdC,txtPg2mI7ASchdC,txtPg2mI8ASchdC,txtPg2mI9ASchdC,txtPg2mI10ASchdC,txtPg2mI11ASchdC,txtPg2mI12ASchdC,txtPg2mI13ASchdC,txtPg2mI14ASchdC,txtPg2mI15ASchdC,txtPg2mI16ASchdC,txtPg2mI17aASchdC,txtPg2mI17bASchdC,txtPg2mI17cASchdC,txtPg2mI17dASchdC','txtPg2mI18ASchdC');
			//item 18 B Special
			getSum('txtPg2mI1BSchdC,txtPg2mI2BSchdC,txtPg2mI3BSchdC,txtPg2mI4BSchdC,txtPg2mI5BSchdC,txtPg2mI6BSchdC,txtPg2mI7BSchdC,txtPg2mI8BSchdC,txtPg2mI9BSchdC,txtPg2mI10BSchdC,txtPg2mI11BSchdC,txtPg2mI12BSchdC,txtPg2mI13BSchdC,txtPg2mI14BSchdC,txtPg2mI15BSchdC,txtPg2mI16BSchdC,txtPg2mI17aBSchdC,txtPg2mI17bBSchdC,txtPg2mI17cBSchdC,txtPg2mI17dBSchdC','txtPg2mI18BSchdC');
			computePage1mScheduleB('taxpayer');
		}
		else if (person.toString() === "spouse") {
			//item 18 A Exempt
			getSum('txtPg2mI1CSchdC,txtPg2mI2CSchdC,txtPg2mI3CSchdC,txtPg2mI4CSchdC,txtPg2mI5CSchdC,txtPg2mI6CSchdC,txtPg2mI7CSchdC,txtPg2mI8CSchdC,txtPg2mI9CSchdC,txtPg2mI10CSchdC,txtPg2mI11CSchdC,txtPg2mI12CSchdC,txtPg2mI13CSchdC,txtPg2mI14CSchdC,txtPg2mI15CSchdC,txtPg2mI16CSchdC,txtPg2mI17aCSchdC,txtPg2mI17bCSchdC,txtPg2mI17cCSchdC,txtPg2mI17dCSchdC','txtPg2mI18CSchdC');
			//item 18 B Special
