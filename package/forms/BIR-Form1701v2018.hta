		for (var i = 9; i <= 12; i++){
			disableAndReset('txtPg4IShed6_'+i+'Year', 'text');
			disableAndReset('txtPg4IShed6_'+i+'A', 'number');
			disableAndReset('txtPg4IShed6_'+i+'B', 'number');
