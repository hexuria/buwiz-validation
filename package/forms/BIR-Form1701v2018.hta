	function P5Sched2Field(field, param){
		if (param == 'enable'){
			$_Id('frm1701:txtPg2IShed2_5'+field).disabled = false;}
		else if (param == 'disable'){
			disableAndReset('txtPg2IShed2_5'+field, 'number');
		}
	}

	function TPdisableP5Sched4Fields(){
		for (var i = 1; i <= 16; i++){
			disableAndReset('txtPg3IShed4_'+i+'A', 'number');
		}
		disableAndReset('txtPg3IShed4_17aA', 'number');
		disableAndReset('txtPg3IShed4_17bA', 'number');
		disableAndReset('txtPg3IShed4_17cA', 'number');
		disableAndReset('txtPg3IShed4_17dA', 'number');

		disableAndReset('txtPg3IShed5_1Desc', 'text');
		disableAndReset('txtPg3IShed5_1Legal', 'text');
		disableAndReset('txtPg3IShed5_1Amt', 'number');
		disableAndReset('txtPg3IShed5_2Desc', 'text');
		disableAndReset('txtPg3IShed5_2Legal', 'text');
		disableAndReset('txtPg3IShed5_2Amt', 'number');

		if ($_Id('frm1701:txtPg3IShed4_17dA').disabled == true &&
			$_Id('frm1701:txtPg3IShed4_17dB').disabled == true){
			disableAndReset('txtPg3IShed4_17dDesc', 'text');}
		disableAndReset('txtPg3IShed4_18A', 'number');
	}

	function SPdisableP5Sched4Fields(){	
		for (var i = 1; i <= 16; i++){
			disableAndReset('txtPg3IShed4_'+i+'B', 'number');
		}
		disableAndReset('txtPg3IShed4_17aB', 'number');
		disableAndReset('txtPg3IShed4_17bB', 'number');
		disableAndReset('txtPg3IShed4_17cB', 'number');
		disableAndReset('txtPg3IShed4_17dB', 'number');

