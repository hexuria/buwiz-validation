		//alert("Please populate Page 3M and 4M. Consolidated amount will be computed in Part 10 Schedule B, C, and D.");
	}

//Part 11 - start
	function setTaxRegime(){
		/*The function call enablePart11EXFields() and enablePart11SPFields()
		is responsible for enabling and disabling of fields
		in the ATTACHMENT page based on the Taxpayer/Spouse choice for
		Income Exempt or Income subject to Special/Preferential Rate.*/
		if (currTaxReg == 'EX' && $_Id('frm1701:rdoPg1mOption2').checked == true){
			$_Id('frm1701:rdoPg3mExempt'+TYPE).checked = true;
			disableAndReset('rdoPg3mSpecialRate'+TYPE, 'radio');
			disableAndReset('txtPg3mSchedB_14A'+TYPE, 'number');
			disableAndReset('txtPg3mSchedB_14B'+TYPE, 'number');

			//enablePart11EXFields();
		}
		else if (currTaxReg == 'SP' && $_Id('frm1701:rdoPg1mOption2').checked == true){
			$_Id('frm1701:rdoPg3mSpecialRate'+TYPE).checked = true;
			disableAndReset('rdoPg3mExempt'+TYPE, 'radio');

			//enablePart11SPFields();
		}
		else{
			disableAndReset('rdoPg3mSpecialRate'+TYPE, 'radio');
			disableAndReset('rdoPg3mExempt'+TYPE, 'radio');
		}
	}

	function enablePart11EXFields(){
		if ($_Id('frm1701:rdoPg1I19IncomeExemptYes').checked == true){
			enablePart11SchedAFields('A');
			enablePart11SchedBFields('A');
