	function validateSpouseFields(){
		var spTIN1 = $_Id('frm1701:txtPg2I1TIN1').value;
		var spTIN2 = $_Id('frm1701:txtPg2I1TIN2').value;
		var spTIN3 = $_Id('frm1701:txtPg2I1TIN3').value;
		var spBranchCode = $_Id('frm1701:txtPg2I1BranchCode').value;
		if (spTIN1.length <= 2 || spTIN2.length <= 2 ||
			spTIN3.length <= 2 || spBranchCode.length <= 2 ){
			alert("You have entered an invalid TIN format for Spouse.");
			return true;
		}
		
		var tinChkCode = getTinChkCode($('#frm1701\\:txtPg2I1TIN1').val(),$('#frm1701\\:txtPg2I1TIN2').val(),$('#frm1701\\:txtPg2I1TIN3').val());
		if (tinChkCode !== 0){
			alert(getChkTinErrDesc(tinChkCode) + " on Page 2 Part IV Item 1.");
			return true;
		}

		if ($_Id('frm1701:txtPg2I2SpouseRDOCode').selectedIndex == 0){
			alert("Please enter a valid RDO Code on Page 2 Part IV Item 2.");
			return true;
        }

		if ($_Id('frm1701:rdoPg2I3SpouseTypeS').checked == false &&
			$_Id('frm1701:rdoPg2I3SpouseTypeP').checked == false &&
			$_Id('frm1701:rdoPg2I3SpouseTypeC').checked == false){
			alert("Please select a Filer type for Spouse on Page 2 Part IV Item 3.");
			return true;
		}

		if ($_Id('frm1701:rdoPg2I4ATC_II011').checked == false &&
			$_Id('frm1701:rdoPg2I4ATC_II012').checked == false &&
			$_Id('frm1701:rdoPg2I4ATC_II013').checked == false &&
			$_Id('frm1701:rdoPg2I4ATC_II014').checked == false &&
			$_Id('frm1701:rdoPg2I4ATC_II015').checked == false &&
			$_Id('frm1701:rdoPg2I4ATC_II016').checked == false &&
			$_Id('frm1701:rdoPg2I4ATC_II017').checked == false){
			alert("Please select an ATC code for Spouse on Page 2 Part IV Item 4.");
			return true;
		}
		
		if ($_Id('frm1701:txtPg2I5SpouseName').value == ''){
			alert("Please enter a name for Spouse on Page 2 Part IV Item 5.");
			return true;
		}

		if ($_Id('frm1701:txtPg2I6TelNum').value.length == 0){
			alert("Please enter a contact number for Spouse on Page 2 Part IV Item 6.");
			return true;
		}
		else if ($_Id('frm1701:txtPg2I6TelNum').value.length <= 5){
			alert("Please enter a valid contact number for Spouse on Page 2 Part IV Item 6.");
			return true;
		}

		if ($_Id('frm1701:txtPg2I7Citizenship').value == ''){
			alert("Please enter a citizenship for Spouse on Page 2 Part IV Item 7.");
			return true;
		}

		if ($_Id('frm1701:rdoPg2I8ForeignTaxCreditsYes').checked == false &&
			$_Id('frm1701:rdoPg2I8ForeignTaxCreditsNo').checked == false){
			alert("Please select a Foreign Tax Credit for Spouse on Page 2 Part IV Item 8.");
			return true;
		}

		if ($_Id('frm1701:rdoPg2I8ForeignTaxCreditsYes').checked == true &&
			$_Id('frm1701:txtPg2I9ForeignTaxNumber').value == ''){
			alert("Please select a Foreign Tax Number for Spouse on Page 2 Part IV Item 9.");
			return true;
		}

		if ($_Id('frm1701:rdoPg2I10IncomeExemptYes').checked == false &&
			$_Id('frm1701:rdoPg2I10IncomeExemptNo').checked == false){
			alert("Please select an option for Spouse on Page 2 Part IV Item 10.");
			return true;
		}

		if ($_Id('frm1701:rdoPg2I11IncomeSpecialYes').checked == false &&
			$_Id('frm1701:rdoPg2I11IncomeSpecialNo').checked == false){
			alert("Please select an option for Spouse on Page 2 Part IV Item 11.");
			return true;
		}

		if ($_Id('frm1701:rdoPg2I12TaxRateG').checked == false &&
			$_Id('frm1701:rdoPg2I12TaxRateP').checked == false &&
			!isSPCompIncOnly){
			alert("Please select a Tax Rate option for Spouse on Page 2 Part IV Item 12.");
			return true;
		}

		if ($_Id('frm1701:rdoPg2I12TaxRateG').checked == true &&
			!isSPCompIncOnly &&
			($_Id('frm1701:rdoPg2I12AMethodDeductionI').checked == false &&
			 $_Id('frm1701:rdoPg2I12AMethodDeductionO').checked == false)){
			alert("Please select a Method of Deduction for Spouse on Page 2 Part IV Item 12A.");
			return true;
		}
	}

    function validate() {
		if ($_Id('frm1701:rdoPg1I3ShortPeriodYes').checked == true &&
			$_Id('frm1701:txtPg1I1Month').value == 00){
			alert("Please choose a month on page 1 Item 1.");
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
		}
        var dt = new Date();
        if (d.getElementById('frm1701:txtPg1I1Year').value == "") {
            alert("Please enter a valid year on page 1 Item 1."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if( d.getElementById('frm1701:txtPg1I1Year').value*1 > dt.getFullYear()*1) {
            alert("Invalid date entry on page 1 Item 1. Entry should not be later than Current Date.")
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:txtPg1I1Year').value * 1 < 1900) {
            alert("Invalid date entry on page 1 Item 1. Entry should not be lower than 1900.")
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
		if (d.getElementById('frm1701:txtPg1I1Year').value * 1 < 2018) {
            alert("Please file using the old version of the form.");
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:rdoPg1I6TaxpayerTypeS').checked == false && d.getElementById('frm1701:rdoPg1I6TaxpayerTypeP').checked == false && d.getElementById('frm1701:rdoPg1I6TaxpayerTypeE').checked == false && d.getElementById('frm1701:rdoPg1I6TaxpayerTypeT').checked == false && d.getElementById('frm1701:rdoPg1I6TaxpayerTypeC').checked == false) {
            alert("Please select an option for page 1 Item 6."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:rdoPg1I7ATC_II011').checked == false && d.getElementById('frm1701:rdoPg1I7ATC_II012').checked == false && d.getElementById('frm1701:rdoPg1I7ATC_II013').checked == false && d.getElementById('frm1701:rdoPg1I7ATC_II014').checked == false && d.getElementById('frm1701:rdoPg1I7ATC_II015').checked == false && d.getElementById('frm1701:rdoPg1I7ATC_II016').checked == false && d.getElementById('frm1701:rdoPg1I7ATC_II017').checked == false) {
            alert("Please select an option for page 1 Item 7."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:txtPg1I10BirthDate').value != ""){
            if (validateMonthDayYearDate(d.getElementById('frm1701:txtPg1I10BirthDate').value)) {
                alert("Invalid birth date on page 1 item 10.  Please check date format."); 
                d.getElementById("frm1701:txtCurrentPage").value = 1;
                goToPage();
                return;
			}
        } else {
            alert("Please indicate birth date on page 1 item 10.");
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:txtPg1I10BirthDate').value.split('/')[2] * 1 > dt.getFullYear() * 1) {
            alert("Birth year on page 1 Item 10 should not be later than current year.");
            return false;
        }
        if (d.getElementById('frm1701:txtPg1I12Citizenship').value == "") {
            alert("Please fill up citizenship on page 1 Item 12."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:rdoPg1I13ForeignTaxCreditsYes').checked == true) {
            if (d.getElementById('frm1701:txtPg1I14ForeignTaxNumber').value == "") {
                alert("Please fill up foreign tax number on page 1 Item 14."); 
                d.getElementById("frm1701:txtCurrentPage").value = 1;
                goToPage();
                return;
            }
        }
        if (d.getElementById('frm1701:rdoPg1I16CivilStatusS').checked == false && d.getElementById('frm1701:rdoPg1I16CivilStatusM').checked == false && d.getElementById('frm1701:rdoPg1I16CivilStatusLS').checked == false && d.getElementById('frm1701:rdoPg1I16CivilStatusW').checked == false) {
            alert("Please select an option for page 1 Item 16."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:rdoPg1I16CivilStatusM').checked == true) {
            if (d.getElementById('frm1701:rdoPg1I17SpouseIncomeYes').checked == false && d.getElementById('frm1701:rdoPg1I17SpouseIncomeNo').checked == false) {
                alert("Please select an option for page 1 Item 17."); 
                d.getElementById("frm1701:txtCurrentPage").value = 1;
                goToPage();
                return;
            }
        }
        if (d.getElementById('frm1701:rdoPg1I17SpouseIncomeYes').checked == true) {
            if (d.getElementById('frm1701:rdoPg1I18FilingStatusJ').checked == false && d.getElementById('frm1701:rdoPg1I18FilingStatusS').checked == false) {
                alert("Please select an option for page 1 Item 18."); 
                d.getElementById("frm1701:txtCurrentPage").value = 1;
                goToPage();
                return;
            }
        }
        if (d.getElementById('frm1701:rdoPg1I19IncomeExemptYes').checked == false && d.getElementById('frm1701:rdoPg1I19IncomeExemptNo').checked == false) {
            alert("Please select an option for page 1 Item 19."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:rdoPg1I20IncomeSpecialYes').checked == false && d.getElementById('frm1701:rdoPg1I20IncomeSpecialNo').checked == false) {
            alert("Please select an option for page 1 Item 20."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:rdoPg1I21TaxRateG').checked == false && d.getElementById('frm1701:rdoPg1I21TaxRateP').checked == false &&
			!isTPCompIncOnly) {
            alert("Please select an option for page 1 Item 21."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (d.getElementById('frm1701:rdoPg1I21TaxRateG').checked == true && !isTPCompIncOnly) {
            if (d.getElementById('frm1701:rdoPg1I21AMethodDeductionI').checked == false && d.getElementById('frm1701:rdoPg1I21AMethodDeductionO').checked == false) {
                alert("Please select an option for page 1 Item 21A."); 
                d.getElementById("frm1701:txtCurrentPage").value = 1;
                goToPage();
                return;
            }
        }
        if (validateTxtPg1I25Part2('taxpayer')) {
            alert("Amount in page 1 Item 25A cannot be more than 50% of Item 22."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        if (validateTxtPg1I25Part2('spouse')) {
            alert("Amount in page 1 Item 25B cannot be more than 50% of Item 22."); 
            d.getElementById("frm1701:txtCurrentPage").value = 1;
            goToPage();
            return;
        }

		//page 3 schedule 5
		if (validatePg3Schd5A()){
			$_Id("frm1701:txtCurrentPage").value = 3;
			goToPage();
			return;
		}

        //overpayment
        if (NumWithComma(d.getElementById('frm1701:txtPg1I32AggregateAmtPyble').value) < 0) {
            if (d.getElementById('frm1701:rdoPg1OverpaymentRefund').checked == false && d.getElementById('frm1701:rdoPg1OverpaymentTCC').checked == false && d.getElementById('frm1701:rdoPg1OverpaymentCarryOver').checked == false) {
                alert("Please select an Overpayment option on Page 1 Part II.");
                d.getElementById("frm1701:txtCurrentPage").value = 1;
                goToPage();
                return;
            }
        }

		if (compareTaxableIncForTP() || compareTaxableIncForSP()){
			return;
		}

		//The code below will check for Part 10 Schedule A for incomplete fields.
		if (checkPart10TPSchedA() && $_Id('frm1701:rdoPg1mOption1').checked == true && (
			$_Id('frm1701:rdoPg1I19IncomeExemptYes').checked == true ||
			$_Id('frm1701:rdoPg1I20IncomeSpecialYes').checked == true)){
			$_Id("frm1701:txtCurrentPage").value = 1;
			popMainpage();
			d.getElementById('mainPageGoToNavigation').style.display = "block";
			goToPage();
			return;
		}

		if (checkPart10SPSchedA() && $_Id('frm1701:rdoPg1mOption1').checked == true && (
			$_Id('frm1701:rdoPg2I10IncomeExemptYes').checked == true ||
			$_Id('frm1701:rdoPg2I11IncomeSpecialYes').checked == true)){
			$_Id("frm1701:txtCurrentPage").value = 2;
			popMainpage();
			d.getElementById('mainPageGoToNavigation').style.display = "block";
			goToPage();
			return;
		}

		if ($_Id('frm1701:rdoPg1I18FilingStatusJ').checked == true){
			if (validateSpouseFields()){
				$_Id("frm1701:txtCurrentPage").value = 2;
				goToPage();
				return;
			}
		}

        disableAllControl();
        alert("Validation successful. Click on Edit if you wish to modify your entries.");
        return;
    }

    var disableElem = true;
    var enableElem = false;
    function disableAllControl() {

        $("input:text, select", $("#container")).attr("disabled", true);
        $("input:button, input:checkbox, input:radio").attr("disabled", true);
      
        $(".disabledInputs").attr("disabled", true);
        $('input[type="text"]:not(:disabled)').css('background-color', 'white');

        d.getElementById('frm1701:txtCurrentPage').disabled = false;
		d.getElementById('frm1701:btnPrevPage').disabled = false;
		d.getElementById('frm1701:btnNextPage').disabled = false;
        d.getElementById('frm1701:cmdValidate').disabled = true;
        d.getElementById('frm1701:cmdEdit').disabled = false;
        d.getElementById('btnPrint').disabled = false;
        d.getElementById('frm1701:btnFinalCopy').disabled = false;
        d.getElementById('btnUpload').disabled = false;
		$_Id('btnSave').disabled = false;

        disableElem;
        enableElem;
    }

    function enableAllControl() {
		var holdSPrdo = 0;
		if ($_Id('frm1701:rdoPg1I18FilingStatusJ').checked == true){
			holdSPrdo = $_Id('frm1701:txtPg2I2SpouseRDOCode').value;}

        $("input:text, select", $("#container")).attr("disabled", false);
        $("input:button, input:checkbox, input:radio").attr("disabled", false);

		$(".disabledInputs").attr("disabled", true);
		$('input[type="text"]:not(:disabled)').css('background-color', 'white');
		

		d.getElementById('frm1701:txtPg1I22ATaxDue').disabled = true;
        d.getElementById('frm1701:txtPg1I22BTaxDue').disabled = true;
        d.getElementById('frm1701:txtPg1I23A').disabled = true;
        d.getElementById('frm1701:txtPg1I23B').disabled = true;
        d.getElementById('frm1701:txtPg1I24ATaxPayable').disabled = true;
        d.getElementById('frm1701:txtPg1I24BTaxPayable').disabled = true;
        d.getElementById('frm1701:txtPg1I26A').disabled = true;
        d.getElementById('frm1701:txtPg1I26B').disabled = true;
        d.getElementById('frm1701:txtPg1I30A').disabled = true;
        d.getElementById('frm1701:txtPg1I30B').disabled = true;
        d.getElementById('frm1701:txtPg1I31ATotalAmtPyble').disabled = true;
        d.getElementById('frm1701:txtPg1I31BTotalAmtPyble').disabled = true;
        d.getElementById('frm1701:txtPg1I32AggregateAmtPyble').disabled = true;

        $('input[name="frm1701:txtProfile"]').each(function() {
            $(this).attr("disabled", true);
        });
        d.getElementById("frm1701:txtPg1I5RDOCode").disabled = true;

        $('input[name="frm1701:txtPart3"]').each(function() {
            $(this).attr("disabled", true);
        });

		controlFields(true);

		checkFields();

		ifOverpayment();
		TPATCeffect();
		SPATCeffect();
		forPart8Fields('taxpayer');
		forPart8Fields('spouse');
		
        d.getElementById('frm1701:txtCurrentPage').disabled = false;
        d.getElementById('frm1701:cmdValidate').disabled = false;
        d.getElementById('frm1701:cmdEdit').disabled = true;
        d.getElementById('btnPrint').disabled = true;
        d.getElementById('frm1701:btnFinalCopy').disabled = true;
        d.getElementById('btnUpload').disabled = true;

        disableElem;
        enableElem;

		if ($_Id('frm1701:rdoPg1I18FilingStatusJ').checked == true){
			$_Id('frm1701:txtPg2I2SpouseRDOCode').value = holdSPrdo;
			SPATCeffect();
		}

		if ($_Id('frm1701:rdoPg1I13ForeignTaxCreditsNo').checked == true){
			disableAndReset('txtPg1I14ForeignTaxNumber', 'text');}

		//This will control the enabled and disabled field in Consolidated and Attachment page
		//after clicking the edit button.
		//checkConsolFields();
    }

	function checkYear(){
		var year = new Date();
		year = year.getFullYear();

		if ($_Id('frm1701:txtPg1I1Year').value > year && $_Id('frm1701:rdoPg1I3ShortPeriodNo').checked == true){
			alert("Year (Page 1 Item 1) cannot be greater than to current year.");
			//$_Id('frm1701:txtPg1I1Year').value = year;
			d.getElementById("frm1701:txtCurrentPage").value = 1;
			goToPage();
		}

		if ($_Id('frm1701:rdoPg1I3ShortPeriodYes').checked == true && $_Id('frm1701:txtPg1I1Year').value > year){
			alert("Year (Page 1 Item 1) cannot be greater than to current year.");
			//$_Id('frm1701:txtPg1I1Year').value = year;
			d.getElementById("frm1701:txtCurrentPage").value = 1;
			goToPage();
		}

		if ($_Id('frm1701:txtPg3IShed6_7Year').value.length >= 3){
			$_Id('frm1701:txtPg3IShed6_7Year').value = $_Id('frm1701:txtPg1I1Year').value;}

		if ($_Id('frm1701:txtPg4IShed6_12Year').value.length >= 3){
			$_Id('frm1701:txtPg4IShed6_12Year').value = $_Id('frm1701:txtPg1I1Year').value;}
	}

	function checkAmendedRtrn(){
		if ($_Id('frm1701:rdoPg1I2AmendedYes').checked == true){
			$_Id('frm1701:txtPg4IPart7_6A').disabled = false;
			
			if ($_Id('frm1701:rdoPg1I18FilingStatusJ').checked == true){
				$_Id('frm1701:txtPg4IPart7_6B').disabled = false;}
		}
		else if ($_Id('frm1701:rdoPg1I2AmendedNo').checked == true){
			$_Id('frm1701:txtPg4IPart7_6A').disabled = true;
			$_Id('frm1701:txtPg4IPart7_6B').disabled = true;
		}
	}

	function checkShortPeriodRtrn(){
		if ($_Id('frm1701:rdoPg1I3ShortPeriodYes').checked == true){
			alert('Choosing ‘YES’ means you are filing for a short period return. You are required to change the Month field to correspond with your New Return Period. If this is incorrect, please update your registration details by filing BIR Form No. 1905 at the RDO where you are registered within five (5) working days. Otherwise, this return will be considered un-filed.');
			$_Id('frm1701:txtPg1I1Month').disabled = false;
			$_Id('frm1701:txtPg1I1Month').options[0].selected = true;
		}
		else if ($_Id('frm1701:rdoPg1I3ShortPeriodNo').checked == true){
			$_Id('frm1701:txtPg1I1Month').options[12].selected = true;
			$_Id('frm1701:txtPg1I1Month').disabled = true;
		}
	}


	function TPFilerType(){
		var currTPtype = 0;
		var maxTPtype = 2;

		if ($_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked == true){
			currTPtype+=1.5;}

		if ($_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked == true){
			currTPtype+=1.5;}

		if ($_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked == true){
			currTPtype+=2;}

		if ($_Id('frm1701:rdoPg1I6TaxpayerTypeT').checked == true){
			currTPtype+=2;}

		if ($_Id('frm1701:rdoPg1I6TaxpayerTypeC').checked == true){
			currTPtype+=0.5;}

		if (currTPtype > maxTPtype){
			alert('The combination of the chosen filer type is invalid.');
			resetTPfiler();
		}

		tpHasBusnOrProf = false;
		TPATCcodes();
	}

var isTPCompIncOnly = false;
var isSPCompIncOnly = false;

	function TPATCcodes(){
		disableAllTPATCcodes();

		if ($_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked == true &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked == false &&
