    var XMLrdoFile = '';

    function loadXMLrdo(fileLocation) {
        try {
            //This will load the Region file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLrdoFile = fsoXML.OpenTextFile(fileLocation, 1);

            if (XMLrdoFile.AtEndOfStream)
                data = "";
            else {
                var responseRdo = d.getElementById('responseRdo'); //render file and write to hidden div
                responseRdo.innerHTML = XMLrdoFile.ReadAll(); //remove XML tag
                //responseRdo = replaceHtml(responseRdo, XMLrdoFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
            }
            XMLrdoFile.Close(); //alert( responseRdo.innerHTML ); //Debug			
            loadRdo();	/*This will load ATC onto an array*/
        } catch (e) {
            msg.innerHTML = ""; //"Region File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    var rdoCount = 0;
    function loadRdo() {
        /*This will load data onto an array*/
        var response = d.getElementById("responseRdo");

        var rdoCnt = String(response.innerHTML).split('rdoCount=');
        rdoCount = rdoCnt[1];

        var k = 0;
        //loads rdoList from xml
        for (var i = 1; i <= rdoCount; i++) {

            var rdo = String(response.innerHTML).split('rdo' + i + ':');
            var rdoStr = rdo[1];

            //Ensure that before writing to rdoPropertyJS the formType 1701Q is traceable in rdoStr
            if (rdoStr.indexOf('1701Q') >= 0) {
                var rdoValues = rdoStr.split('~');
                var rdoCode = rdoValues[0];
                var description = rdoValues[1];

                var objRdo = new rdoPropertyJS(rdoCode, description);
                rdoList[k] = objRdo;
                k++;
                //alert('1701Q successfully created array #'+i);

            } else {
                //alert('1701Q not found in array #'+i);
                continue;
            }
        }
    }

    function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = "";
            } else {
                var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag			
            }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug				
            loadBGData();	/*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = "";
        }
    }

    function loadBGData() {
        /*This will load data onto Background Information fields*/
        var responseBG = d.getElementById("responseBG");

        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '1701v2018') {
            var fnVal = String(responseBG.innerHTML).split('fn=');
            d.getElementById('frm1701:txtPg1I8TaxpayerName').value = unescape(fnVal[1]);
            d.getElementById('frm1701:txtPg2TaxpayerName').value = unescape(fnVal[1]).split(',')[0];
            d.getElementById('frm1701:txtPg3TaxpayerName').value = unescape(fnVal[1]).split(',')[0];
            d.getElementById('frm1701:txtPg4TaxpayerName').value = unescape(fnVal[1]).split(',')[0];
            d.getElementById('frm1701:txtPg1mTaxpayerName').value = unescape(fnVal[1]).split(',')[0];
            d.getElementById('frm1701:txtPg2mTaxpayerName').value = unescape(fnVal[1]).split(',')[0];
            d.getElementById('frm1701:txtPg3mTaxpayerName').value = unescape(fnVal[1]).split(',')[0];
            d.getElementById('frm1701:txtPg4mTaxpayerName').value = unescape(fnVal[1]).split(',')[0];
            
            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            d.getElementById('frm1701:txtPg1I4TIN1').value = tin1Val[1];
            d.getElementById('frm1701:txtPg2TIN1').value = tin1Val[1];
            d.getElementById('frm1701:txtPg3TIN1').value = tin1Val[1];
            d.getElementById('frm1701:txtPg4TIN1').value = tin1Val[1];
            d.getElementById('frm1701:txtPg1mTIN1').value = tin1Val[1];
            d.getElementById('frm1701:txtPg2mTIN1').value = tin1Val[1];
            d.getElementById('frm1701:txtPg3mTIN1').value = tin1Val[1];
            d.getElementById('frm1701:txtPg4mTIN1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            d.getElementById('frm1701:txtPg1I4TIN2').value = tin2Val[1];
            d.getElementById('frm1701:txtPg2TIN2').value = tin2Val[1];
            d.getElementById('frm1701:txtPg3TIN2').value = tin2Val[1];
            d.getElementById('frm1701:txtPg4TIN2').value = tin2Val[1];
            d.getElementById('frm1701:txtPg1mTIN2').value = tin2Val[1];
            d.getElementById('frm1701:txtPg2mTIN2').value = tin2Val[1];
            d.getElementById('frm1701:txtPg3mTIN2').value = tin2Val[1];
            d.getElementById('frm1701:txtPg4mTIN2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            d.getElementById('frm1701:txtPg1I4TIN3').value = tin3Val[1];
            d.getElementById('frm1701:txtPg2TIN3').value = tin3Val[1];
            d.getElementById('frm1701:txtPg3TIN3').value = tin3Val[1];
            d.getElementById('frm1701:txtPg4TIN3').value = tin3Val[1];
            d.getElementById('frm1701:txtPg1mTIN3').value = tin3Val[1];
            d.getElementById('frm1701:txtPg2mTIN3').value = tin3Val[1];
            d.getElementById('frm1701:txtPg3mTIN3').value = tin3Val[1];
            d.getElementById('frm1701:txtPg4mTIN3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            d.getElementById('frm1701:txtPg1I4BranchCode').value = tin4Val[1];
            d.getElementById('frm1701:txtPg2BranchCode').value = tin4Val[1];
            d.getElementById('frm1701:txtPg3BranchCode').value = tin4Val[1];
            d.getElementById('frm1701:txtPg4BranchCode').value = tin4Val[1];
            d.getElementById('frm1701:txtPg1mBranchCode').value = tin4Val[1];
            d.getElementById('frm1701:txtPg2mBranchCode').value = tin4Val[1];
            d.getElementById('frm1701:txtPg3mBranchCode').value = tin4Val[1];
            d.getElementById('frm1701:txtPg4mBranchCode').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm1701:txtPg1I5RDOCode').value = rdoVal[1];

            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm1701:txtLineBus').value = unescape(lobVal[1]);

            //address to split
			var regAddrVal = String(responseBG.innerHTML).split('regAddr=');		
			if (regAddrVal[1].length > 100) {
				d.getElementById('frm1701:txtPg1I9Address').value = 	unescape(regAddrVal[1].substring(0, 100));
				d.getElementById('frm1701:txtPg1I9Address2').value = 	unescape(regAddrVal[1].substring(100, regAddrVal[1].length));
			}
			else {
			d.getElementById('frm1701:txtPg1I9Address').value = 	unescape(regAddrVal[1]);	
			d.getElementById('frm1701:txtPg1I9Address2').value = 	"";
			}

            var zipVal = String(responseBG.innerHTML).split('zip=');
            d.getElementById('frm1701:txtPg1I9AZipCode').value = zipVal[1];

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            d.getElementById('frm1701:txtPg1I15TelNum').value = telNoVal[1];
        }
        var emailVal = String(responseBG.innerHTML).split('email=');
        if (emailVal[1] === undefined) {
            document.getElementById('txtEmail').value = "";
        }
        else {
            document.getElementById('txtEmail').value = emailVal[1];
            globalEmail = emailVal[1];
        }
    }

    function createXMLProfileName() {
        try {
            var xmlFileName = "";

            var titleTin1 = d.getElementById('frm1701:txtPg1I4TIN1');
            var titleTin2 = d.getElementById('frm1701:txtPg1I4TIN2');
            var titleTin3 = d.getElementById('frm1701:txtPg1I4TIN3');
            var titleBranchCode = d.getElementById('frm1701:txtPg1I4BranchCode');
            var titleTPName = d.getElementById('frm1701:txtPg1I8TaxpayerName');
            var formType = "1701v2018";

            xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";

            return xmlFileName;
        } catch (e) {
            alert('Exception : ' + e.description);
        }
    }

