	function computePg3Sc6I7E() {
		allFormat('txtPg3IShed6_3A', 'txtPg3IShed6_7A');

		if (NumWithComma($_Id("frm1701:txtPg3IShed6_7A").value) < 0.00){
			$_Id('frm1701:txtPg3IShed6_7A').value = formatCurrency(NumWithComma($_Id("frm1701:txtPg3IShed6_7A").value) * -1);}
		else{
			disableAndReset('txtPg3IShed6_7A', 'number');
			disableAndReset('txtPg3IShed6_7Year', 'text');
		}

		checkNOLCOoperLoss('txtPg3IShed6_7');
        getDifference('txtPg3IShed6_7A', 'txtPg3IShed6_7B'+',txtPg3IShed6_7C'+',txtPg3IShed6_7D', 'txtPg3IShed6_7E');
    }

	function checkNOLCOoperLoss(field){
		var amount = NumWithComma($_Id('frm1701:'+field+'A').value);
		var tempTot = 0;
		
		tempTot = NumWithComma($_Id('frm1701:'+field+'B').value) +
				  NumWithComma($_Id('frm1701:'+field+'C').value) +
				  NumWithComma($_Id('frm1701:'+field+'D').value);

		if (amount < tempTot){
			alert('Amount is invalid. Sum of Column B, C and D shall not be greater than the amount in Column E (Net Operating Loss)');

			var zero = 0.00
			$_Id('frm1701:'+field+'B').value = formatCurrency(NumWithComma(zero));
			$_Id('frm1701:'+field+'C').value = formatCurrency(NumWithComma(zero));
			$_Id('frm1701:'+field+'D').value = formatCurrency(NumWithComma(zero));
		}
	}

	function checkSched5Fields(item){
		if ($_Id('frm1701:txtPg3IShed5_'+item+'Desc').value == '' || $_Id('frm1701:txtPg3IShed5_'+item+'Legal').value == ''){
			alert("Description and Legal Basis should both have values for item #" +item +".");
			$_Id('frm1701:txtPg3IShed5_'+item+'Amt').value = "0.00";
			$_Id('frm1701:txtPg3IShed5_'+item+'Desc').focus();
		}
	}

	function check8percGross(person){
		if (person == "taxpayer") {
			if (NumWithComma($_Id('frm1701:txtPg3IShed3_26A').value) > 3000000){
				alert("Your Gross Sales/Receipts and Other Non-Operating Income exceeds VAT Threshold (P3M), thus, not qualified to 8% tax rate and shall be subjected to graduated rates. Please choose a graduated rate ATC and fill in Page 2 Schedule 3.");
				$_Id('frm1701:txtPg3IShed3_26A').value = "0.00";
			}
		}
		else if (person == "spouse") {
			if (NumWithComma($_Id('frm1701:txtPg3IShed3_26B').value) > 3000000){
				alert("Your Gross Sales/Receipts and Other Non-Operating Income exceeds VAT Threshold (P3M), thus, not qualified to 8% tax rate and shall be subjected to graduated rates. Please choose a graduated rate ATC and fill in Page 2 Schedule 3.");
				$_Id('frm1701:txtPg3IShed3_26B').value = "0.00";
			}
		}
	}

