	function copyValue(person,pgItem,sched) {
		if (person.toString() === "taxpayer"){
			allFormat('txtPg1'+pgItem+'C'+sched, 'txtPg1'+pgItem+'D'+sched);
	    }
		else if (person.toString() === "spouse") {
			allFormat('txtPg1'+pgItem+'G'+sched, 'txtPg1'+pgItem+'H'+sched);
		}
	}

	function copyToRegularField(person){
		if (person == 'taxpayer'){
			//Item 1 (get value from Pt5 Sched 3A Item 8A)
			allFormat('txtPg2IShed3_8A', 'txtPg1mI1CSchdB');

			//Item 2 (get value from Pt5 Sched 3A Item 9A)
			allFormat('txtPg2IShed3_9A', 'txtPg1mI2CSchdB');

			//Item 4 (get value from Pt5 Sched 3A Item 11A)
			allFormat('txtPg2IShed3_11A', 'txtPg1mI4CSchdB');

			//Item 6 (get value from Pt5 Sched 3A Item 13A)
			allFormat('txtPg2IShed3_13A', 'txtPg1mI6CSchdB');

			//Item 7 (get value from Pt5 Sched 3A Item 14A)
			allFormat('txtPg2IShed3_14A', 'txtPg1mI7CSchdB');

			//Item 8 (get value from Pt5 Sched 6 Item 8)
			allFormat('txtPg3IShed6_8D', 'txtPg1mI8CSchdB');
			copyValue('taxpayer','mI8','SchdB');

			//Item 12 (get value from Pt5 Sched 3A Item 19A)
			allFormat('txtPg2IShed3_19A', 'txtPg1mI12CSchdB');

			//Item 13 (get value from Pt5 Sched 3A Item 20A)
			allFormat('txtPg2IShed3_20A', 'txtPg1mI13CSchdB');

			//Item 14 (get value from Pt5 Sched 3A Item 21A)
			allFormat('txtPg2IShed3_21A', 'txtPg1mI14CSchdB');
			copyValue('taxpayer','mI14','SchdB');

			//Item 17 (get value from Pt5 Sched3B Item 31A)
			allFormat('txtPg3IShed3_31A', 'txtPg1mI17CSchdB');
		}
		else if (person == 'spouse'){
			//Item 1 (get value from Pt5 Sched 3A Item 8B)
			allFormat('txtPg2IShed3_8B', 'txtPg1mI1GSchdB');

			//Item 2 (get value from Pt5 Sched 3A Item 9B)
			allFormat('txtPg2IShed3_9B', 'txtPg1mI2GSchdB');

			//Item 4 (get value from Pt5 Sched 3A Item 11B)
			allFormat('txtPg2IShed3_11B', 'txtPg1mI4GSchdB');

			//Item 6 (get value from Pt5 Sched 3A Item 13B)
			allFormat('txtPg2IShed3_13B', 'txtPg1mI6GSchdB');

			//Item 7 (get value from Pt5 Sched 3A Item 14B)
			allFormat('txtPg2IShed3_14B', 'txtPg1mI7GSchdB');

			//Item 8 (get value from Pt5 Sched 6 Item 13)
			allFormat('txtPg4IShed6_13D', 'txtPg1mI8GSchdB');
			copyValue('spouse','mI8','SchdB');

			//Item 12 (get value from Pt5 Sched 3A Item 19B)
			allFormat('txtPg2IShed3_19B', 'txtPg1mI12GSchdB');

			//Item 13 (get value from Pt5 Sched 3A Item 20B)
			allFormat('txtPg2IShed3_20B', 'txtPg1mI13GSchdB');

			//Item 14 (get value from Pt5 Sched 3A Item 21B
			allFormat('txtPg2IShed3_21B', 'txtPg1mI14GSchdB');
			copyValue('spouse','mI14','SchdB');

			//Item 17 (get value from Pt5 Sched3B Item 31B)
			allFormat('txtPg3IShed3_31B', 'txtPg1mI17GSchdB');

		}
	}

	function computePage1mScheduleB(person) {
		//Uncommment this for the computation - START
		/*copyToRegularField(person);

	    if (person.toString() === "taxpayer") {		
			//Item 3 (Difference of Items 1 & 2 Column A)  Total Exempt
			differenceOfElements('txtPg1mI1ASchdB', 'txtPg1mI2ASchdB', 'txtPg1mI3ASchdB');
			//Item 3 (Difference of Items 1 & 2 Column B) Total Special
			differenceOfElements('txtPg1mI1BSchdB', 'txtPg1mI2BSchdB', 'txtPg1mI3BSchdB');
			//Item 3 (Difference of Items 1 & 2 Column C) Total Regular
			differenceOfElements('txtPg1mI1CSchdB', 'txtPg1mI2CSchdB', 'txtPg1mI3CSchdB');
			//Item 3 (Difference of Items 1 & 2 COLUMN D) Total 
			differenceOfElements('txtPg1mI1DSchdB', 'txtPg1mI2DSchdB', 'txtPg1mI3DSchdB');
			
			//Item 5 (Difference of Items 3 & 4 Column A)  Total Exempt
			differenceOfElements('txtPg1mI3ASchdB', 'txtPg1mI4ASchdB', 'txtPg1mI5ASchdB');
			//Item 5 (Difference of Items 3 & 4 Column B)  Total Special
			differenceOfElements('txtPg1mI3BSchdB', 'txtPg1mI4BSchdB', 'txtPg1mI5BSchdB');
			//Item 5 (Difference of Items 3 & 4 Column C)  Total Regular
			differenceOfElements('txtPg1mI3CSchdB', 'txtPg1mI4CSchdB', 'txtPg1mI5CSchdB');
			//Item 5 (Difference of Items 3 & 4 Column D)  Total 
			differenceOfElements('txtPg1mI3DSchdB', 'txtPg1mI4DSchdB', 'txtPg1mI5DSchdB');

			//Item 6 (Copy Amount from Part 10 Sched C Item 18A) Total Exempt
			allFormat('txtPg2mI18ASchdC', 'txtPg1mI6ASchdB');
			//Item 6 (Copy Amount from Part 10 Sched C Item 18B) Total Special
			allFormat('txtPg2mI18BSchdC', 'txtPg1mI6BSchdB');

			//Item 7 (Copy Amount from Part 10 Sched D Item 5A) Total Exempt
			if ($_Id('frm1701:rdoPg1I19IncomeExemptYes').checked == true){
				allFormat('txtPg2mI5ASchdD', 'txtPg1mI7ASchdB');}
			//Item 7 (Copy Amount from Part 10 Sched D Item 5A) Total Special
			if ($_Id('frm1701:rdoPg1I20IncomeSpecialYes').checked == true){
				allFormat('txtPg2mI5ASchdD', 'txtPg1mI7BSchdB');}

			//Item 9 (sum of Items 6,7) Total Exempt
			getSum('txtPg1mI6ASchdB,txtPg1mI7ASchdB','txtPg1mI9ASchdB');
			//Item 9 (sum of Items 6,7) Total Special
			getSum('txtPg1mI6BSchdB,txtPg1mI7BSchdB','txtPg1mI9BSchdB');
			//Item 9 (sum of Items 6,7,8) Total Regular
			getSum('txtPg1mI6CSchdB,txtPg1mI7CSchdB,txtPg1mI8CSchdB','txtPg1mI9CSchdB');
			//Item 9 (sum of Items 6,7,8) Total
			getSum('txtPg1mI6DSchdB,txtPg1mI7DSchdB,txtPg1mI8DSchdB','txtPg1mI9DSchdB');
			 
			//Item 10 (40% of item 3)  Regular
			getProduct('txtPg1mI3CSchdB',0.40,'txtPg1mI10CSchdB');
			allFormat('txtPg1mI10CSchdB', 'txtPg1mI10DSchdB');
			//Item 11 (Net Income Loss) Total Exempt
			differenceOfElements('txtPg1mI5ASchdB', 'txtPg1mI9ASchdB', 'txtPg1mI11ASchdB');
			//Item 11 (Net Income Loss) Total Special
			differenceOfElements('txtPg1mI5BSchdB', 'txtPg1mI9BSchdB', 'txtPg1mI11BSchdB');
			//Item 11 (Net Income Loss) Total Regular and Total
			methodRate('consolTP');

			//Item 15 Total Other Non-Operating Income (Sum items 12-14) Total Exempt 
			getSum('txtPg1mI12ASchdB,txtPg1mI13ASchdB','txtPg1mI15ASchdB');
			//Item 15 Total Other Non-Operating Income (Sum items 12-14)Total Special 
			getSum('txtPg1mI12BSchdB,txtPg1mI13BSchdB','txtPg1mI15BSchdB');
			//Item 15 Total Other Non-Operating Income (Sum items 12-14) Total Regular 
			getSum('txtPg1mI12CSchdB,txtPg1mI13CSchdB,txtPg1mI14CSchdB','txtPg1mI15CSchdB');
			//Item 15 Total Other Non-Operating Income (Sum items 12-14) Total
			getSum('txtPg1mI15ASchdB,txtPg1mI15BSchdB,txtPg1mI15CSchdB','txtPg1mI15DSchdB');
			
			//Item 16 Total Taxable Income/(Loss)(Sum of Items 11 and 5) Total Exempt
			getSum('txtPg1mI11ASchdB,txtPg1mI15ASchdB','txtPg1mI16ASchdB');
			//Item 16 Total Taxable Income/(Loss)(Sum of Items 11 and 5) Total Special
			getSum('txtPg1mI11BSchdB,txtPg1mI15BSchdB','txtPg1mI16BSchdB');
			//Item 16 Total Taxable Income/(Loss)(Sum of Items 11 and 5) Total Regular
			getSum('txtPg1mI11CSchdB,txtPg1mI15ASchdB','txtPg1mI16CSchdB');
			//Item 16 Total Taxable Income/(Loss)(Sum of Items 11 and 5) Total 
			getSum('txtPg1mI16ASchdB,txtPg1mI16BSchdB,txtPg1mI16CSchdB','txtPg1mI16DSchdB');
			
			//Item 17 (Item 16A x 0%) Total Exempt 
			//getProduct('txtPg1mI16ASchdB',0,'txtPg1mI17ASchdB');
			//Item 17 Taxdue (Item 16B x %)-  Special
			if ($_Id('frm1701:rdoPg1mOption1').checked == true){
				val = ($_Id('frm1701:txtPg1mI4BSchdA').value/100);
				getProduct('txtPg1mI5BSchdB',val,'txtPg1mI17BSchdB');
			}
			//Item 17 Taxdue (Item 5B  x applicable tax)-  Special
			//allFormat('txtPg3IShed3_31A','txtPg1mI17CSchdB');
			// Item 17 total D 
			getSum('txtPg1mI17ASchdB,txtPg1mI17BSchdB,txtPg1mI17CSchdB','txtPg1mI17DSchdB');	
			
			//computeCollectedValue('frm1701:txtPg1mI17BSchdB'.substring(0,2) , 'frm1701:txtPg4ISc6_2A');

			//The function call below will copy the amount in Part 10 to Page 4 Part 8 of Main page
			//The function is not yet complete, the amount for applicable income tax rate is not yet
			//given by the testers.
			//copyToPart8TP();
		}

		else if (person.toString() === "spouse") {
			//Item 3 (Difference of Items 1 & 2 Column E) Total Exempt
			differenceOfElements('txtPg1mI1ESchdB','txtPg1mI2ESchdB', 'txtPg1mI3ESchdB');
			//Item 3 (Difference of Items 1 & 2 Column F) Total Special
			differenceOfElements('txtPg1mI1FSchdB','txtPg1mI2FSchdB', 'txtPg1mI3FSchdB');
			//Item 3 (Difference of Items 1 & 2 Column G) Total Regular
			differenceOfElements('txtPg1mI1GSchdB','txtPg1mI2GSchdB', 'txtPg1mI3GSchdB');
	        //Item 3 (Difference of Items 1 & 2 COLUMN H) 
			differenceOfElements('txtPg1mI1HSchdB','txtPg1mI2HSchdB', 'txtPg1mI3HSchdB');

			//Item 5 (Difference of Items 3 & 4 Column E)  Total Exempt
	        differenceOfElements('txtPg1mI3ESchdB','txtPg1mI4ESchdB', 'txtPg1mI5ESchdB');
			//Item 5 (Difference of Items 3 & 4 Column F)  Total Special
	        differenceOfElements('txtPg1mI3FSchdB','txtPg1mI4FSchdB', 'txtPg1mI5FSchdB');
			//Item 5 (Difference of Items 3 & 4 Column G)  Total Regular
	        differenceOfElements('txtPg1mI3GSchdB','txtPg1mI4GSchdB', 'txtPg1mI5GSchdB');
			//Item 5 (Difference of Items 3 & 4 Column H)  Total
	        differenceOfElements('txtPg1mI3HSchdB','txtPg1mI4HSchdB', 'txtPg1mI5HSchdB');

			//Item 6 (Copy Amount from Part 10 Sched C Item 18C) Total Exempt
			allFormat('txtPg2mI18CSchdC', 'txtPg1mI6ESchdB');
			//Item 6 (Copy Amount from Part 10 Sched C Item 18D) Total Special
			allFormat('txtPg2mI18DSchdC', 'txtPg1mI6FSchdB');

			//Item 7 (Copy Amount from Part 10 Sched D Item 5B) Total Exempt
			if ($_Id('frm1701:rdoPg2I10IncomeExemptYes').checked == true){
				allFormat('txtPg2mI5BSchdD', 'txtPg1mI7ESchdB');}
			//Item 7 (Copy Amount from Part 10 Sched D Item 5B) Total Special
			if ($_Id('frm1701:rdoPg2I11IncomeSpecialYes').checked == true){
				allFormat('txtPg2mI5BSchdD', 'txtPg1mI7FSchdB');}

			//Item 9 (sum of Items 6,7,9) Total Exempt
	        getSum('txtPg1mI6ESchdB,txtPg1mI7ESchdB','txtPg1mI9ESchdB');
			//Item 9 (sum of Items 6,7,9) Total Special
	        getSum('txtPg1mI6FSchdB,txtPg1mI7FSchdB','txtPg1mI9FSchdB');
		 	//Item 9 (sum of Items 6,7,9) Total Regular
	        getSum('txtPg1mI6GSchdB,txtPg1mI7GSchdB,txtPg1mI8GSchdB','txtPg1mI9GSchdB');
			 //Item 9 (sum of Items 6,7,8) Total
			getSum('txtPg1mI6HSchdB,txtPg1mI7HSchdB,txtPg1mI8HSchdB','txtPg1mI9HSchdB');
			//Item 10 (40% of item 3)  Regular
	        getProduct('txtPg1mI3GSchdB',0.40,'txtPg1mI10GSchdB');
			allFormat('txtPg1mI10GSchdB', 'txtPg1mI10HSchdB');
	
			//Item 11 (Net Income Loss) Total Exempt
			differenceOfElements('txtPg1mI5ESchdB', 'txtPg1mI9ESchdB', 'txtPg1mI11ESchdB');
			//Item 11 (Net Income Loss) Total Special
			differenceOfElements('txtPg1mI5FSchdB', 'txtPg1mI9FSchdB', 'txtPg1mI11FSchdB');
			//Item 11 (Net Income Loss) Total Regular and Total
			methodRate('consolSPS');
			
			//Item 15 Total Other Non-Operating Income (Sum items 12-14) Total Exempt 
