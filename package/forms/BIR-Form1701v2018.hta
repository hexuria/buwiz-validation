	function computeConsolSchedD(fromID, toID, person){
		//var taxReg = ($_Id("currentTypeView").value).substring(0,2);
		var total = 0;

		if ($_Id('frm1701:rdoPg1I19IncomeExemptYes').checked == true ||
			$_Id('frm1701:rdoPg2I10IncomeExemptYes').checked == true){
			for (var i = 1; i <= totalEXArray.length; i++){
				total = formatCurrency(NumWithComma(total) + NumWithComma($_Id('frm1701:'+fromID+'EX'+i).value));
			}

			if (person == 'taxpayer'){
				$_Id('frm1701:'+ toID + 'ASchdD').value = formatCurrency(NumWithComma(total));}
			else if (person == 'spouse'){
				$_Id('frm1701:'+ toID + 'BSchdD').value = formatCurrency(NumWithComma(total));}
		}

		if ($_Id('frm1701:rdoPg1I20IncomeSpecialYes').checked == true ||
			$_Id('frm1701:rdoPg2I11IncomeSpecialYes').checked == true){
			for (var i = 1; i <= totalSPArray.length; i++){
				total = formatCurrency(NumWithComma(total) + NumWithComma($_Id('frm1701:'+fromID+'SP'+i).value));
			}

			if (person == 'taxpayer'){
				$_Id('frm1701:'+ toID + 'ASchdD').value = formatCurrency(NumWithComma(total));}
			else if (person == 'spouse'){
				$_Id('frm1701:'+ toID + 'BSchdD').value = formatCurrency(NumWithComma(total));}
		}

		computePage2mScheduleD(person);
	}
	//===========================================================================================================================

	function computeCollectedValue(fromID, toID){
		var id = fromID.toString().split(":");
		var fromCollection = $("input[id*=" + ( id[0]+"\\:"+id[1] ) + "]");
		var total = 0;
		for (var i = 0; i < fromCollection.length; i++) {
			//do not compute textbox with id TYPE, they are the source HTML
			if (fromCollection[i].id.indexOf("TYPE") === -1){
			
				total = convertToFloat(removeCommaParenthesis(fromCollection[i].id.replace('frm1701:',''))) + total;  
			}
		}
		d.getElementById(toID).value = NegativeValue(formatCurrency(Math.round(total).toFixed(2)));
	}
	

	 
	 //convert to Float to avoid NaN
    function convertToFloat(value) {
        var xFloat = (value) * 1;
	
        if (xFloat.toString() === "NaN") {
            xFloat = 0;
        }
        return xFloat;
    }
	
	 function getSum(params, output) {
        var total = 0;
        var array1 = params.split(',');
        var array2 = output.split(',');
        for (var i = 0; i < array1.length; i++) {
            total += (isNaN(NumWithComma($_Id('frm1701:' + array1[i]).value)) ? 0 : NumWithComma($_Id('frm1701:' + array1[i]).value));
        }
        for (var i = 0; i < array2.length; i++) {
            $_Id('frm1701:' + array2[i]).value = formatCurrency(Math.round(total).toFixed(2));
        }
    }

	function getDifference(minuend, subtrahend, output) {
        var total = 0, total2 = 0;
        var min = minuend.split(',');
        var sub = subtrahend.split(',');
        for (var i = 0; i < min.length; i++) {
            total += (isNaN(NumWithComma(NumWithParenthesis($_Id('frm1701:' + min[i]).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1701:' + min[i]).value)));
        }
        for (var i = 0; i < sub.length; i++) {
            total2 += (isNaN(NumWithComma(NumWithParenthesis($_Id('frm1701:' + sub[i]).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1701:' + sub[i]).value)));
        }

		var diff = convertToNumber(total) - convertToNumber(total2);
        $_Id('frm1701:' + output).value = formatCurrency(Math.round(diff).toFixed(2));

        return total;
    }

	 function differenceOfElements(param, param2, outputControlID) {
        var paramValue = removeCommaParenthesis(param);
        var param2Value =removeCommaParenthesis(param2);
		
        var diff = convertToNumber(paramValue) - convertToNumber(param2Value);
        d.getElementById('frm1701:' +outputControlID).value = formatCurrency(Math.round(diff).toFixed(2));
	}
	
	 //convert to Number to avoid NaN
		function convertToNumber(value) {
			var xNumber = (value) * 1;
		
			if (xNumber.toString() === "NaN") {
				xNumber = 0;
			}

			return xNumber;
		}
		
		function removeCommaParenthesis(senderID) {
			var senderValue = d.getElementById('frm1701:'+senderID).value;
		
			if (senderValue.toString().indexOf('(') != -1 || senderValue.toString().indexOf(')') != -1) {
				senderValue = NumWithParenthesis(senderValue);
			}

			if (senderValue.toString().indexOf(',') != -1) {
				senderValue = NumWithComma(senderValue);
			}
			if(!isNaN(senderValue)){
				return (senderValue * 1);
			}
			else {
				 return senderValue;
			}
		}
   
     function getProduct(param1, param2, outputProduct) {
	    var product = 0;
		 //multiply
        product = (isNaN(NumWithComma(NumWithParenthesis($_Id('frm1701:' + param1).value))) ? 0 : NumWithComma(NumWithParenthesis($_Id('frm1701:' + param1).value))) * param2;
        //Get the output product
        $_Id('frm1701:' + outputProduct).value = formatCurrency(Math.round(product).toFixed(2));
    }

	function allFormat(param, output) {
        $_Id('frm1701:' + output).value = $_Id('frm1701:' + param).value;
    }
	
	function $_Id(id) {
        return document.getElementById(id);
    }

    function $_Name(name) {
        return document.getElementsByName(name);
	}
  
   function setPercentage(e, decimalPlaces) {
        var isNumber = isNumeric(e.value);

        if (($.trim(e.value) === "") || !isNumber) {
            e.value = "0.0";
            e.select();
        }
        else if ((convertToNumber(e.value) < 0) || (convertToNumber(e.value) >= 100)) {
            alert("Percentage cannot be greater than or equal to 100%");
            e.value = "0.0";
            e.onblur();
            e.select();
        }
        else {
            var temp = e.value.split('.');
            if ((temp.length === 2) && (temp[1].length > 2)) {
                e.value = (e.value * 1).toFixed(2);
            }
            else if (decimalPlaces !== 0) {
                e.value = (e.value * 1).toFixed(decimalPlaces);
            }
        }
    }
	    //convert to Number to avoid NaN
		function convertToNumber(value) {
        var xNumber = (value) * 1;

        if (xNumber.toString() === "NaN") {
            xNumber = 0;
        }

        return xNumber;
    }
