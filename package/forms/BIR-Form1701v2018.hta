	function GRrateSelect(){
		if ($_Id('frm1701:rdoPg1I21AMethodDeductionI').checked == true){
			enableP5Sched4Fields('A');
			enableP5Sched5Fields(1,2);
			enableP5Sched6Fields();
		}
		else if ($_Id('frm1701:rdoPg1I21AMethodDeductionO').checked == true){
			TPdisableP5Sched4Fields();
			TPdisableP5Sched5Fields();
			TPdisableP5Sched6Fields();
		}

		if ($_Id('frm1701:rdoPg2I12AMethodDeductionI').checked == true){
			enableP5Sched4Fields('B');
			enableP5Sched5Fields(4,5);
			enableP5Sched6Fields();
		}
		else if ($_Id('frm1701:rdoPg2I12AMethodDeductionO').checked == true){
			SPdisableP5Sched4Fields();
			SPdisableP5Sched5Fields();
			SPdisableP5Sched6Fields();
		}
	}

	function TPdisableP5Sched1Fields(){
		disableAndReset('chkPg2IShed1a_1Taxpayer', 'radio');
		disableAndReset('chkPg2IShed2a_2Taxpayer', 'radio');
		disableAndReset('txtPg2IShed1a_1TPName', 'text');
		disableAndReset('txtPg2IShed2a_2TPName', 'text');
		disableAndReset('txtPg2IShed1c_3ACI', 'number');
		disableAndReset('txtPg2IShed1c_3ATW', 'number');
		
		if ($_Id('frm1701:chkPg2IShed1a_1Taxpayer').checked == false &&
			$_Id('frm1701:chkPg2IShed1a_1Spouse').checked == false){
			disableAndReset('txtPg2IShed1c_1CI', 'number');
			disableAndReset('txtPg2IShed1c_1TW', 'number');
			disableAndReset('txtPg2IShed1a_TIN1', 'text');
			disableAndReset('txtPg2IShed1a_TIN2', 'text');
			disableAndReset('txtPg2IShed1a_TIN3', 'text');
			disableAndReset('txtPg2IShed1a_BranchCode', 'text');
		}

		if ($_Id('frm1701:chkPg2IShed2a_2Taxpayer').checked == false &&
			$_Id('frm1701:chkPg2IShed2a_2Spouse').checked == false){
			disableAndReset('txtPg2IShed1c_2CI', 'number');
			disableAndReset('txtPg2IShed1c_2TW', 'number');
			disableAndReset('txtPg2IShed2a_TIN1', 'text');
			disableAndReset('txtPg2IShed2a_TIN2', 'text');
			disableAndReset('txtPg2IShed2a_TIN3', 'text');
			disableAndReset('txtPg2IShed2a_BranchCode', 'text');
		}

		computeTxtPg2Sc2I4CI('taxpayer');
		copyToPt7I5('taxpayer');
	}

