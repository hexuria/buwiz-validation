	function callConsol(){
		popConsol();
		$("#Page1mContent").show('fade');
		$('#Page2mContent').hide();
		d.getElementById('mainPageGoToNavigation').style.display = "none";
		$("#consolidatedPage1New").prop('disabled', true);
		$("#consolidatedPage2New").prop('disabled', false);

		//The code below is responsible for enabling and disabling of fields
		//in the consolidated page based on the Taxpayer/Spouse choice for
		//Income Exempt or Income subject to Special/Preferential Rate.
		/*checkConsolFields();
		checkConsolFieldsOther();*/

		if (isTP || isSP){
			$_Id('attachmentPage1New').disabled = false;
			$_Id('attachmentPage2New').disabled = false;
		}
		else {
			$_Id('attachmentPage1New').disabled = true;
			$_Id('attachmentPage2New').disabled = true;
		}
	}

	function popConsol(){
		$("#mainPages").hide();
		$('#ATTACHMENT').hide();
		$("#CONSOLIDATED").show();
	}

	function popAttchmnt(){
		$("#mainPages").hide();
		$("#CONSOLIDATED").hide();
		$('#ATTACHMENT').show();
	}

	function popMainpage(){
		$("#CONSOLIDATED").hide();
        $('#ATTACHMENT').hide();		
		$('#mainPages').show('blind');
		controlAttReset();
	}
	
	function consolPage(origin){
		if (origin == 'to1M'){
			$('#Page2mContent').hide();
			$('#Page1mContent').show('fade');
			$("#consolidatedPage1New").prop('disabled', true);
			$("#consolidatedPage2New").prop('disabled', false);
		}
		else if (origin == 'to2M'){
			$('#Page1mContent').hide();
			$('#Page2mContent').show('fade');
			$("#consolidatedPage1New").prop('disabled', false);
			$("#consolidatedPage2New").prop('disabled', true);
		}
	}

	function attachPage(){
		if (isExempt){
			isTo4M = true;
			verifyActionForAttachment('EX');
			currentAttachmentPage = "Page1mEX1Content";
			$("#" + currentAttachmentPage).hide();
			displayAttachmentByPage(2);
		}
		else if (isSpecial){
			isTo4M = true;
			verifyActionForAttachment('SP');
			currentAttachmentPage = "Page1mSP1Content";
			$("#" + currentAttachmentPage).hide();
			displayAttachmentByPage(2);
		}
	}

var isExempt = false;
var isSpecial = false;
var isTP = false;
var isSP = false;
var isTo4M = false;
var hasExempt = false;
var hasSpecial = false;
var currTaxReg = '';
var tpHasBusnOrProf = false;
var spHasBusnOrProf = false;

	function controlAttReset(){
		isExempt = false;
		isSpecial = false;
		isTP = false;
		isSP = false;
		currTaxReg = '';
	}

	function TPexmpt(){
		isTP = true;
		isSP = false;
		isExempt = true;
		isSpecial = false;
		currTaxReg = 'EX';
	}

	function TPspcl(){
		isTP = true;
		isSP = false;
		isExempt = false;
		isSpecial = true;
		currTaxReg = 'SP';
	}

	function SPexmpt(){
		isTP = false;
		isSP = true;
		isExempt = true;
		isSpecial = false;
		currTaxReg = 'EX';
	}

	function SPspcl(){
		isTP = false;
		isSP = true;
		isExempt = false;
		isSpecial = true;
		currTaxReg = 'SP';
	}

	function checkConsolFields(){
		disableAllPart10();

		if ($_Id('frm1701:rdoPg1mOption1').checked == true){
			if (isTP && isExempt){
				//alert('1');
				enableTPandExmpt();
				//checkConsolFieldsOther();
				numOfAct();
			}
			else if (isTP && isSpecial){
				//alert('2');
				enableTPandSpcl();
				//checkConsolFieldsOther();
				numOfAct();
			}
			else if (isSP && isExempt){
				//alert('3');
				enableSPandExmpt();
				//checkConsolFieldsOther();
				numOfAct();
			}
			else if (isSP && isSpecial){
				//alert('4');
				enableSPandSpcl();
				//checkConsolFieldsOther();
				numOfAct();
			}

		}
	}

	function disableAllPart10(){
		disableAllP10SchedAFields();
		disableAllP10SchedBFields();
		disableAllP10SchedCFields();
		disableAllP10SchedDFields();
	}

	function enableTPandExmpt(){
		enableP10SchedAFields('A');
		TPenableP10SchedARegularField();
		enableP10SchedBFields('A');
		enableP10SchedCFields('A');
		enableP10SchedDFields('A');
		fieldsP10SchedCTPExempt(false);
	}

	function enableTPandSpcl(){
		enableP10SchedASpecialField('B');
		TPenableP10SchedARegularField();
		enableP10SchedBFields('B');
		enableP10SchedCFields('B');
		enableP10SchedDFields('A');
		fieldsP10SchedCTPSpecial(false);
	}

	function enableSPandExmpt(){
		enableP10SchedAFields('D');
		SPenableP10SchedARegularField();
		enableP10SchedBFields('E');
		enableP10SchedCFields('C');
		enableP10SchedDFields('B');
		fieldsP10SchedCSPExempt(false);
	}

	function enableSPandSpcl(){
		enableP10SchedASpecialField('E');
		SPenableP10SchedARegularField();
		enableP10SchedBFields('F');
		enableP10SchedCFields('D');
		enableP10SchedDFields('B');
		fieldsP10SchedCSPSpecial(false);
	}

	function checkConsolFieldsOther(){
		if ($_Id('frm1701:rdoPg1mOption1').checked == true){
			if ($_Id('frm1701:rdoPg1I19IncomeExemptYes').checked == true){
				enableTPandExmpt();}

			if ($_Id('frm1701:rdoPg1I20IncomeSpecial').checked == true){
				enableTPandSpcl();}

			if ($_Id('frm1701:rdoPg2I10IncomeExemptYes').checked == true){
				enableSPandExmpt();}

			if ($_Id('frm1701:rdoPg2I11IncomeSpecial').checked == true){
				enableSPandSpcl();}
		}
	}
	
	//Disable Fields Part 10
	function disableAllP10SchedAFields(){
		//Disable C.Regular, D.Total, and Total fields
		for (var x = 1; x <= 6; x++){
			if (x != 4){
				$_Id('frm1701:txtPg1mI'+x+'ASchdA').disabled = true;
				$_Id('frm1701:txtPg1mI'+x+'BSchdA').disabled = true;
				$_Id('frm1701:txtPg1mI'+x+'CSchdA').disabled = true;
				$_Id('frm1701:txtPg1mI'+x+'DSchdA').disabled = true;
				$_Id('frm1701:txtPg1mI'+x+'ESchdA').disabled = true;
				$_Id('frm1701:txtPg1mI'+x+'FSchdA').disabled = true;
			}
		}
		$_Id('frm1701:txtPg1mI4BSchdA').disabled = true;
		$_Id('frm1701:txtPg1mI4ESchdA').disabled = true;
	}

	function enableP10SchedAFields(field1){
		//alert(field);
		//alert("TP>" + isTP + " - SP>" + isSP + " - Exempt>" + isExempt + " - Special>" + isSpecial);
		for (var x = 1; x <= 6; x++){
			if (x != 4){
				$_Id('frm1701:txtPg1mI'+x+field1+'SchdA').disabled = false;
			}
		}
	}

	function enableP10SchedASpecialField(SF){
		for (var x = 1; x <= 6; x++){
			$_Id('frm1701:txtPg1mI'+x+SF+'SchdA').disabled = false;
		}
	}

	function TPenableP10SchedARegularField(){
		for (var x = 1; x <= 6; x++){
			if (x != 4){
				$_Id('frm1701:txtPg1mI'+x+'CSchdA').disabled = false;}
		}
	}

	function SPenableP10SchedARegularField(){
		for (var x = 1; x <= 6; x++){
			if (x != 4){
				$_Id('frm1701:txtPg1mI'+x+'FSchdA').disabled = false;}
		}
	}

	function disableAllP10SchedBFields(){
		//Disable C.Regular, D.Total, and Total fields
		for (var x = 1; x <= 17; x++){
			$_Id('frm1701:txtPg1mI'+x+'CSchdB').disabled = true;
			$_Id('frm1701:txtPg1mI'+x+'DSchdB').disabled = true;
			$_Id('frm1701:txtPg1mI'+x+'GSchdB').disabled = true;
			$_Id('frm1701:txtPg1mI'+x+'HSchdB').disabled = true;

			if (x != 8 && x != 10 && x != 14){
				$_Id('frm1701:txtPg1mI'+x+'ASchdB').disabled = true;
				$_Id('frm1701:txtPg1mI'+x+'BSchdB').disabled = true;
				$_Id('frm1701:txtPg1mI'+x+'ESchdB').disabled = true;
				$_Id('frm1701:txtPg1mI'+x+'FSchdB').disabled = true;
			}
		}
		$_Id('frm1701:txtPg1mI12DescSchdB').disabled = true;
		$_Id('frm1701:txtPg1mI13DescSchdB').disabled = true;
	}

