	function computeTxtPg4Pt8I3(person){
		if (person == "taxpayer") {
			getSum('txtPg4IPart8_1A,txtPg4IPart8_2A','txtPg4IPart8_3A');
		}
		else if (person == "spouse"){
			getSum('txtPg4IPart8_1B,txtPg4IPart8_2B', 'txtPg4IPart8_3B');
		}
		computeTxtPg4Pt8I5(person);
	}

	function computeTxtPg4Pt8I5(person){
