			computeConsolSchedBAmt('txtPg3mSchedB_15A', 'txtPg1mI17', 'taxpayer');
		}
		else if (person.toString() === "spouse") {
			//item 3 Sched B 
			differenceOfElements('txtPg3mSchedB_1B'+TYPE, 'txtPg3mSchedB_2B'+TYPE, 'txtPg3mSchedB_3B'+TYPE);
			//item 4 Sched B 
			differenceOfElements('txtPg3mSchedB_3B'+TYPE, 'txtPg3mSchedB_4B'+TYPE, 'txtPg3mSchedB_5B'+TYPE);
			//item 8 Sched B 
			getSum('txtPg3mSchedB_6B'+TYPE+',txtPg3mSchedB_7B'+TYPE,'txtPg3mSchedB_8B'+ TYPE );
			 //item 9 Sched B 
			differenceOfElements('txtPg3mSchedB_5B'+TYPE, 'txtPg3mSchedB_8B'+TYPE, 'txtPg3mSchedB_9B'+TYPE);
			//item 12 Sched B 
			getSum('txtPg3mSchedB_10B'+TYPE+',txtPg3mSchedB_11B'+TYPE,'txtPg3mSchedB_12B'+ TYPE );
			//item 13 Sched B 
			getSum('txtPg3mSchedB_9B'+TYPE+',txtPg3mSchedB_12B'+TYPE,'txtPg3mSchedB_13B'+ TYPE );
			//item 15 Sched B
			//item 15 Sched B
			val = (document.getElementById('frm1701:txtPg3mSchedB_14B'+TYPE).value/100);
			if (d.getElementById('frm1701:rdoPg3mExempt'+TYPE).checked == true)	{
				getProduct('txtPg3mSchedB_13B'+TYPE,val,'txtPg3mSchedB_15B'+TYPE)	
				//allFormat('txtPg3mSchedB_15B'+TYPE,'txtPg1mI17ESchdB'+TYPE)
			}
			else if(d.getElementById('frm1701:rdoPg3mSpecialRate'+TYPE).checked == true){
				getProduct('txtPg3mSchedB_5B'+TYPE,val,'txtPg3mSchedB_15B'+TYPE)	
				//allFormat('txtPg3mSchedB_15B'+TYPE,'txtPg1mI17ESchdB'+TYPE)
			}

			computeConsolSchedBAmt('txtPg3mSchedB_1B', 'txtPg1mI1', 'spouse');
			computeConsolSchedBAmt('txtPg3mSchedB_2B', 'txtPg1mI2', 'spouse');
			computeConsolSchedBAmt('txtPg3mSchedB_4B', 'txtPg1mI4', 'spouse');
