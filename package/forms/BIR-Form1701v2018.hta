					alert('Please complete details in Page 3 Schedule 5 Item #' +i +'.');
					return true;
				}
			}
		}
	}

	function compareTaxableIncForTP(){
		if ($_Id('frm1701:rdoPg1I21TaxRateG').checked == true && $_Id('frm1701:rdoPg1I21AMethodDeductionI').checked == true){
			if (NumWithComma($_Id('frm1701:txtPg4IPart9_11A').value) ==
				NumWithComma($_Id('frm1701:txtPg2IShed3_23A').value)){
				return false;
			}
			else{
				alert('Page 4 Part IX Item 11 must be equal to Item 23 on Page 2 Part V Schedule 3.A (Taxpayer is under Graduated Rates)');
				return true;
			}
		}
		else if ($_Id('frm1701:rdoPg1I21TaxRateP').checked == true){
			if (NumWithComma($_Id('frm1701:txtPg4IPart9_11A').value) ==
				NumWithComma($_Id('frm1701:txtPg3IShed3_30A').value)){
				return false;
			}
			else{
				alert('Page 4 Part IX Item 11 must be equal to Item 30 on Page 3 Part V Schedule 3.B (Taxpayer is under 8% IT Rate)');
				return true;
			}
		}
		else{
			return false;}
	}

