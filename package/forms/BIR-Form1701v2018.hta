			else if(d.getElementById('frm1701:rdoPg3mSpecialRate'+TYPE).checked == true){
				getProduct('txtPg3mSchedB_5A'+TYPE,val,'txtPg3mSchedB_15A'+TYPE)
				//allFormat('txtPg3mSchedB_15A'+TYPE,'txtPg1mI17ASchdB'+TYPE)		
			}

			computeConsolSchedBAmt('txtPg3mSchedB_1A', 'txtPg1mI1', 'taxpayer');
			computeConsolSchedBAmt('txtPg3mSchedB_2A', 'txtPg1mI2', 'taxpayer');
