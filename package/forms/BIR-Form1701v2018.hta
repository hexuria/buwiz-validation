                                                                <table>
                                                                    <tr>
                                                                        <td width="11"><font size="2" style="font-weight:bold;">21A</font></td>
                                                                        <td width="459" colspan="2"><font size="1" face="Arial, Helvetica, sans-serif">Method of Deduction (choose one) </font></td>
                                                                    </tr>
                                                                    <tr valign="top">
                                                                        <td>&nbsp;</td>
                                                                        <td width="134">
                                                                            <input type="radio" value="Itemized"  name="frm1701:rdoPg1I21AMethodDeduction" id="frm1701:rdoPg1I21AMethodDeductionI" onclick="GRrateSelect(); methodRate('taxpayer');" disabled />
                                                                            <label for="frm1701:rdoPg1I21AMethodDeductionI" class="iceSelOneRb-dis fieldText1-dis-dis" style="font-size:10px;" >Itemized Deduction<br/> [Sec. 34(A-J), NIRC]</label>
                                                                        </td>
                                                                        <td width="325">
                                                                            <input type="radio" value="OSD"  name="frm1701:rdoPg1I21AMethodDeduction" id="frm1701:rdoPg1I21AMethodDeductionO" onclick="GRrateSelect(); methodRate('taxpayer');" disabled />
                                                                            <label for="frm1701:rdoPg1I21AMethodDeductionO" style="font-size:10px;" >Optional Standard Deduction (OSD) <br/> [40% of Gross Sales/Receipts/Revenues/Fees [Sec. 34(L), NIRC]]</label>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
