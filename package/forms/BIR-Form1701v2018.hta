	function resetTPfiler(){
		$_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked = false;
		$_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked = false;
		$_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked = false;
		$_Id('frm1701:rdoPg1I6TaxpayerTypeT').checked = false;
		$_Id('frm1701:rdoPg1I6TaxpayerTypeC').checked = false;
	}

	function SPFilerType(){
		var currSPtype = 0;
		var maxSPtype = 2;

		if ($_Id('frm1701:rdoPg2I3SpouseTypeS').checked == true){
			currSPtype+=1.5;}

		if ($_Id('frm1701:rdoPg2I3SpouseTypeP').checked == true){
			currSPtype+=1.5;}

		if ($_Id('frm1701:rdoPg2I3SpouseTypeC').checked == true){
			currSPtype+=0.5;}

		if (currSPtype > maxSPtype){
			alert('The combination of the chosen filer type is invalid.');
			resetSPfiler();
		}

		spHasBusnOrProf = false;
		SPATCcodes();
	}

	function SPATCcodes(){
		disableAllSPATCcodes();

		if ($_Id('frm1701:rdoPg2I3SpouseTypeS').checked == true &&
			$_Id('frm1701:rdoPg2I3SpouseTypeP').checked == false &&
			$_Id('frm1701:rdoPg2I3SpouseTypeC').checked == true){
			$_Id('frm1701:rdoPg2I4ATC_II013').disabled = false;
			$_Id('frm1701:rdoPg2I4ATC_II016').disabled = false;
			disableAndReset('txtPg3IShed3_29B', 'number');
			computeTxtPg3Sc3I30('spouse');
			isSPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg2I3SpouseTypeS').checked == false &&
			$_Id('frm1701:rdoPg2I3SpouseTypeP').checked == true &&
			$_Id('frm1701:rdoPg2I3SpouseTypeC').checked == true){
			$_Id('frm1701:rdoPg2I4ATC_II013').disabled = false;
			$_Id('frm1701:rdoPg2I4ATC_II016').disabled = false;
			disableAndReset('txtPg3IShed3_29B', 'number');
			computeTxtPg3Sc3I30('spouse');
			isSPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg2I3SpouseTypeS').checked == true &&
			$_Id('frm1701:rdoPg2I3SpouseTypeP').checked == false &&
			$_Id('frm1701:rdoPg2I3SpouseTypeC').checked == false){
			$_Id('frm1701:rdoPg2I4ATC_II012').disabled = false;
			$_Id('frm1701:rdoPg2I4ATC_II015').disabled = false;
			spHasBusnOrProf = true;
			isSPEligForReduction();
			isSPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg2I3SpouseTypeS').checked == false &&
			$_Id('frm1701:rdoPg2I3SpouseTypeP').checked == true &&
			$_Id('frm1701:rdoPg2I3SpouseTypeC').checked == false){
			$_Id('frm1701:rdoPg2I4ATC_II014').disabled = false;
			$_Id('frm1701:rdoPg2I4ATC_II017').disabled = false;
			spHasBusnOrProf = true;
			isSPEligForReduction();
			isSPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg2I3SpouseTypeS').checked == false &&
			$_Id('frm1701:rdoPg2I3SpouseTypeP').checked == false &&
			$_Id('frm1701:rdoPg2I3SpouseTypeC').checked == true){
			$_Id('frm1701:rdoPg2I4ATC_II011').disabled = false;
			$_Id('frm1701:rdoPg2I4ATC_II011').checked = true;
			disableAndReset('txtPg3IShed3_29B', 'number');
			computeTxtPg3Sc3I30('spouse');
			SPATCeffect();
			allFormat('txtPg2IShed2_7B', 'txtPg1I22BTaxDue');
			isSPCompIncOnly = true;
		}	
	}

	function isSPEligForReduction(){
		if ($_Id('frm1701:rdoPg2I12TaxRateP').checked == true){
			$_Id('frm1701:txtPg3IShed3_29B').disabled = false;}
	}

	function disableAllSPATCcodes(){
		disableAndReset('rdoPg2I4ATC_II011', 'radio');
		disableAndReset('rdoPg2I4ATC_II012', 'radio');
		disableAndReset('rdoPg2I4ATC_II013', 'radio');
		disableAndReset('rdoPg2I4ATC_II014', 'radio');
		disableAndReset('rdoPg2I4ATC_II015', 'radio');
		disableAndReset('rdoPg2I4ATC_II016', 'radio');
		disableAndReset('rdoPg2I4ATC_II017', 'radio');
	}

	function resetSPfiler(){
		$_Id('frm1701:rdoPg2I3SpouseTypeS').checked = false;
		$_Id('frm1701:rdoPg2I3SpouseTypeP').checked = false;
		$_Id('frm1701:rdoPg2I3SpouseTypeC').checked = false;
	}

	function checkFields(){
		if ($_Id('frm1701:rdoPg1I18FilingStatusJ').checked == true){
			spouseFields('enable');
		}
		else if ($_Id('frm1701:rdoPg1I16CivilStatusM').checked == false){
			disableSpouseFields('noSpouse');
		}
		else if ($_Id('frm1701:rdoPg1I17SpouseIncomeNo').checked == true){
			disableSpouseFields('spouseNoInc');
		}
		
		if ($_Id('frm1701:rdoPg1I21TaxRateG').checked == true){
			enableFieldsForGRRate('A');
			disableFieldsForGRRate('A');
		}
		else if ($_Id('frm1701:rdoPg1I21TaxRateP').checked == true){
			enableFieldsForEightPerRate('A');
			disableFieldsForEightPerRate('A');
			disableAndReset('rdoPg1I21AMethodDeductionI', 'radio');
			disableAndReset('rdoPg1I21AMethodDeductionO', 'radio');
		}
		
		if ($_Id('frm1701:rdoPg2I12TaxRateG').checked == true){
			enableFieldsForGRRate('B');
			disableFieldsForGRRate('B');
		}
		else if ($_Id('frm1701:rdoPg2I12TaxRateP').checked == true){
			enableFieldsForEightPerRate('B');
			disableFieldsForEightPerRate('B');
			disableAndReset('rdoPg2I12AMethodDeductionI', 'radio');
			disableAndReset('rdoPg2I12AMethodDeductionO', 'radio');
		}

		if ($_Id('frm1701:chkPg2IShed2a_2Spouse').checked == true){
			$_Id('frm1701:txtPg2IShed1c_3BCI').disabled = false;
			$_Id('frm1701:txtPg2IShed1c_3BTW').disabled = false;
		}

		if ($_Id('frm1701:rdoPg2I8ForeignTaxCreditsYes').checked == true){
			$_Id('frm1701:txtPg2I9ForeignTaxNumber').disabled = false;
		}
		
	}

