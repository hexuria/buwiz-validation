	function othersToPart10(toID){
		$_Id('frm1701:'+ toID).value = 'OTHERS';
	}

	function computeConsolSchedBAmt(fromID, toID, person){
		//var taxReg = ($_Id("currentTypeView").value).substring(0,2);
		var total = 0;

		if ($_Id('frm1701:rdoPg3mExempt'+TYPE).checked == true){
			for (var i = 1; i <= totalEXArray.length; i++){
				total = formatCurrency(NumWithComma(total) + NumWithComma($_Id('frm1701:'+fromID+'EX'+i).value));
			}

			if (person == 'taxpayer'){
				$_Id('frm1701:'+ toID + 'ASchdB').value = formatCurrency(NumWithComma(total));}
			else if (person == 'spouse'){
				$_Id('frm1701:'+ toID + 'ESchdB').value = formatCurrency(NumWithComma(total));}
		}
		else if ($_Id('frm1701:rdoPg3mSpecialRate'+TYPE).checked == true){
			for (var i = 1; i <= totalSPArray.length; i++){
				total = formatCurrency(NumWithComma(total) + NumWithComma($_Id('frm1701:'+fromID+'SP'+i).value));
			}

			if (person == 'taxpayer'){
				$_Id('frm1701:'+ toID + 'BSchdB').value = formatCurrency(NumWithComma(total));}
			else if (person == 'spouse'){
				$_Id('frm1701:'+ toID + 'FSchdB').value = formatCurrency(NumWithComma(total));}
		}

		computePage1mScheduleB(person);
	}

