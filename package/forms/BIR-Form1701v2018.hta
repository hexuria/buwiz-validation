//Part 11 - end
	function disableAndReset(param, type){
		if(type == 'radio'){
			d.getElementById('frm1701:' + param).checked = false;
			d.getElementById('frm1701:' + param).disabled = true;
		}
		else if(type == 'text'){
			d.getElementById("frm1701:" + param).value = "";
			d.getElementById("frm1701:" + param).disabled = true;
		}
		else if(type == 'number'){
			var zero = 0.00
			d.getElementById("frm1701:" + param).value = formatCurrency(NumWithComma(zero));
			d.getElementById("frm1701:" + param).disabled = true;
		}
	}


	function disableFor8Perc(){
		if ($_Id('frm1701:rdoPg1I21TaxRateP').checked == true){	
			TPdisableP5Sched4Fields();
			TPdisableP5Sched5Fields();
			TPdisableP5Sched6Fields();
		}

		if ($_Id('frm1701:rdoPg2I12TaxRateP').checked == true){
			SPdisableP5Sched4Fields();
			SPdisableP5Sched5Fields();
			SPdisableP5Sched6Fields();
		}
	}

	function TPATCeffect(){
		if ($_Id('frm1701:rdoPg1I7ATC_II011').checked == true){
			disableAndReset('rdoPg1I21TaxRateG', 'radio');
			disableAndReset('rdoPg1I21TaxRateP', 'radio');
			disableAndReset('rdoPg1I21AMethodDeductionI', 'radio');
			disableAndReset('rdoPg1I21AMethodDeductionO', 'radio');
			TPenableP5Sched1Fields();
			P5Sched2Field('A', 'enable');
			disableFieldsForGRRate('A');
			disableFieldsForEightPerRate('A');
			populateTotalAllowDeduc('taxpayer');
			computeTxtPg2I16('taxpayer');
			computeTxtPg3Sc3I32('taxpayer');
			TPdisableP5Sched4Fields();
			TPdisableP5Sched5Fields();
			TPdisableP5Sched6Fields();
		}
		else if ($_Id('frm1701:rdoPg1I7ATC_II012').checked == true ||
			$_Id('frm1701:rdoPg1I7ATC_II014').checked == true){
			$_Id('frm1701:rdoPg1I21TaxRateG').checked = true;
			disableAndReset('rdoPg1I21TaxRateP', 'radio');
			taxRateEnableDisableFields('taxpayer', 'GR');
			P5Sched2Field('A', 'disable');
			TPdisableP5Sched1Fields();
			//enableP5Sched4Fields('A');
			//enableP5Sched5Fields(1,2);
			//enableP5Sched6Fields();
			taxRateSelect('GR','rdoPg1I21A');
		}
		else if ($_Id('frm1701:rdoPg1I7ATC_II013').checked == true){
			$_Id('frm1701:rdoPg1I21TaxRateG').checked = true;
			disableAndReset('rdoPg1I21TaxRateP', 'radio');
			taxRateEnableDisableFields('taxpayer', 'GR');
			TPenableP5Sched1Fields();
			P5Sched2Field('A', 'enable');
			//enableP5Sched4Fields('A');
			//enableP5Sched5Fields(1,2);
			//enableP5Sched6Fields();
			taxRateSelect('GR','rdoPg1I21A');
		}
		else if ($_Id('frm1701:rdoPg1I7ATC_II015').checked == true ||
			$_Id('frm1701:rdoPg1I7ATC_II017').checked == true){
			$_Id('frm1701:rdoPg1I21TaxRateP').checked = true;
			disableAndReset('rdoPg1I21TaxRateG', 'radio');
			disableAndReset('rdoPg1I21AMethodDeductionI', 'radio');
			disableAndReset('rdoPg1I21AMethodDeductionO', 'radio');
			taxRateEnableDisableFields('taxpayer', '8%');
			P5Sched2Field('A', 'disable');
			TPdisableP5Sched1Fields();
			disableFor8Perc();
			computePg3Sc4I18('taxpayer');
		}
		else if ($_Id('frm1701:rdoPg1I7ATC_II016').checked == true){
			$_Id('frm1701:rdoPg1I21TaxRateP').checked = true;
			disableAndReset('rdoPg1I21TaxRateG', 'radio');
			disableAndReset('rdoPg1I21AMethodDeductionI', 'radio');
			disableAndReset('rdoPg1I21AMethodDeductionO', 'radio');
			taxRateEnableDisableFields('taxpayer', '8%');
			TPenableP5Sched1Fields();
			P5Sched2Field('A', 'enable');
			disableFor8Perc();
			computePg3Sc4I18('taxpayer');
		}
	}

