	function computePg3Sc6I6E() {
        checkNOLCOoperLoss('txtPg3IShed6_6');
		getDifference('txtPg3IShed6_6A', 'txtPg3IShed6_6B'+',txtPg3IShed6_6C'+',txtPg3IShed6_6D', 'txtPg3IShed6_6E');
