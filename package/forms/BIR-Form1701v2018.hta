	function copyToPart8TP(){
		var amt1 = ($_Id('frm1701:txtPg1mI4BSchdA').value/100);

		if ($_Id('frm1701:rdoPg1I20IncomeSpecialYes').checked == true){
			getProduct('txtPg1mI16BSchdB',amt1,'txtPg4IPart8_1A');
			getProduct('txtPg1mI7BSchdB',amt1,'txtPg4IPart8_2A');
			allFormat('txtPg1mI17BSchdB', 'txtPg4IPart8_4A');
			allFormat('txtPg4IPart7_8A', 'txtPg4IPart8_6A');
			computeTxtPg4Pt8I3('taxpayer');
		}
		
		if ($_Id('frm1701:rdoPg1I19IncomeExemptYes').checked == true){
			getProduct('txtPg1mI16ASchdB',amt1,'txtPg4IPart8_8A');
			getProduct('txtPg1mI7ASchdB',amt1,'txtPg4IPart8_9A');
