		disableAndReset('txtPg4IShed6_13D', 'number');
	}

	function enableP5Sched6Fields(){
		if ($_Id('frm1701:rdoPg1I21TaxRateG').checked == true &&
			$_Id('frm1701:rdoPg1I21AMethodDeductionI').checked == true){	
			$_Id('frm1701:txtPg3IShed6_1A').disabled = false;
			$_Id('frm1701:txtPg3IShed6_2A').disabled = false;

			for (var i = 4; i <= 7; i++){
				if (i != 7){
					$_Id('frm1701:txtPg3IShed6_'+i+'Year').disabled = false;
					$_Id('frm1701:txtPg3IShed6_'+i+'A').disabled = false;
				}

				$_Id('frm1701:txtPg3IShed6_'+i+'B').disabled = false;
				$_Id('frm1701:txtPg3IShed6_'+i+'C').disabled = false;
				$_Id('frm1701:txtPg3IShed6_'+i+'D').disabled = false;
			}
		}
		
		if ($_Id('frm1701:rdoPg2I12TaxRateG').checked == true &&
			$_Id('frm1701:rdoPg2I12AMethodDeductionI').checked == true){
			$_Id('frm1701:txtPg3IShed6_1B').disabled = false;
			$_Id('frm1701:txtPg3IShed6_2B').disabled = false;

			for (var i = 9; i <= 12; i++){
				if (i != 12){
					$_Id('frm1701:txtPg4IShed6_'+i+'Year').disabled = false;
					$_Id('frm1701:txtPg4IShed6_'+i+'A').disabled = false;
				}

				$_Id('frm1701:txtPg4IShed6_'+i+'B').disabled = false;
				$_Id('frm1701:txtPg4IShed6_'+i+'C').disabled = false;
				$_Id('frm1701:txtPg4IShed6_'+i+'D').disabled = false;
			}
		}
	}

	function checkTaxCred(param, field){
		if(param == 'taxCredYes'){
			$_Id("frm1701:" + field).disabled = false;
		}
		else if(param == 'taxCredNo'){
			$_Id("frm1701:" + field).value = "";
			$_Id("frm1701:" + field).disabled = true;
		}
	}

	function taxRateSelect(param, field){
		if(param == 'GR'){
			$_Id("frm1701:" + field + "MethodDeductionI").disabled = false;
			$_Id("frm1701:" + field + "MethodDeductionO").disabled = false;
		}
		else if(param == '8%'){
			disableAndReset(field + "MethodDeductionI", 'radio');
			disableAndReset(field + "MethodDeductionO", 'radio');
		}
	}

	function enableSpouseFields(param){
		if(param == 'spouseHasInc'){
			$_Id("frm1701:rdoPg1I17SpouseIncomeYes").disabled = false;
			$_Id("frm1701:rdoPg1I17SpouseIncomeNo").disabled = false;
		}
		else if(param == 'filingStat'){
			$_Id("frm1701:rdoPg1I18FilingStatusJ").disabled = false;
			$_Id("frm1701:rdoPg1I18FilingStatusS").disabled = false;
		}
		else if(param == 'jointFiling'){
			spouseFields('enable');
			$_Id("frm1701:rdoPg2I8ForeignTaxCreditsNo").checked = true;
		}
	}

