			disableAndReset('txtPg3IShed6_'+i+'B', 'number');
			disableAndReset('txtPg3IShed6_'+i+'C', 'number');
			disableAndReset('txtPg3IShed6_'+i+'D', 'number');
			disableAndReset('txtPg3IShed6_'+i+'E', 'number');
		}

		computePg3Sc6I3('taxpayer', 'none');
		disableAndReset('txtPg3IShed6_8D', 'number');
	}

	function SPdisableP5Sched6Fields(){
		disableAndReset('txtPg3IShed6_1B', 'number');
