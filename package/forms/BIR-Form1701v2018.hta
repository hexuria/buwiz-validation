		if ($_Id('frm1701:txtPg1mI1CSchdA').value.length > 0 &&
			$_Id('frm1701:txtPg1mI2CSchdA').value.length > 0 &&
			$_Id('frm1701:txtPg1mI3CSchdA').value.length > 0 && (
				$_Id('frm1701:txtPg1mI5CSchdA').value.length <= 9 ||
				$_Id('frm1701:txtPg1mI6CSchdA').value.length <= 9)){
				alert("Please complete Date of Tax Relief in Taxpayer's Part 10 Schedule A Regular Fields since you have an input in IPA/Legal Basis/Registered Activity.");
				return true;
		}
	}

