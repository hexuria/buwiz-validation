															onclick="taxRateSelect('8%','rdoPg1I21A'); taxRateEnableDisableFields('taxpayer', '8%'); disableFor8Perc();" />
                                                        <label for="frm1701:rdoPg1I21TaxRateP" style="font-size:10px;" >8%  in lieu of Graduated Rates under Sec. 24(A) & Percentage Tax under Sec. 116 of NIRC 
                                                            <br/> [available if gross sales/receipts and other non-operating income do not exceed Three million pesos (P3M)]</label>
