			//Item 15 Total Other Non-Operating Income (Sum items 12-14) Total  
			getSum('txtPg1mI12HSchdB,txtPg1mI13HSchdB,txtPg1mI14HSchdB','txtPg1mI15HSchdB');
			
			//Item 16 Total Taxable Income/(Loss)(Sum of Items 11 and 5) Total Exempt
