                                                <td align="center"><input type="text" value="0.00" style="color: black; text-align: right;" size="20" maxlength="25" name="frm1701:txtSpouse" id="frm1701:txtPg1I25B" onblur="round(this,2);computeTxtPg1I26('spouse');" onkeypress="return wholenumber(this, event)" /></td>
