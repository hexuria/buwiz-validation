	function disableSpouseFields(param){
		if(param == 'noSpouse'){
			disableAndReset('rdoPg1I17SpouseIncomeYes', 'radio');
			disableAndReset('rdoPg1I17SpouseIncomeNo', 'radio');
			disableAndReset('rdoPg1I18FilingStatusJ', 'radio');
			disableAndReset('rdoPg1I18FilingStatusS', 'radio');
		}
		else if(param == 'spouseNoInc'){
			disableAndReset('rdoPg1I18FilingStatusJ', 'radio');
			disableAndReset('rdoPg1I18FilingStatusS', 'radio');
		}

		resetSPRDO = true;
		spouseFields('disable');
		disableFieldsForGRRate('B');
		disableFieldsForEightPerRate('B');

	}

	function emplyrDetails(param, field){
		if (field == 'TP'){
			$_Id("frm1701:txt" + param + "SName").value = "";
			$_Id("frm1701:txt" + param + "SName").disabled = true;
			$_Id("frm1701:txt" + param + "TPName").disabled = false;
		}
		else if (field == 'SPS'){
			$_Id("frm1701:txt" + param + "TPName").value = "";
			$_Id("frm1701:txt" + param + "TPName").disabled = true;
			$_Id("frm1701:txt" + param + "SName").disabled = false;
		}
		
		if (param == 'Pg2IShed1a_1'){
			$_Id("frm1701:txtPg2IShed1a_TIN1").disabled = false;
			$_Id("frm1701:txtPg2IShed1a_TIN2").disabled = false;
			$_Id("frm1701:txtPg2IShed1a_TIN3").disabled = false;
			$_Id("frm1701:txtPg2IShed1a_BranchCode").disabled = false;

			if (field == 'TP'){
				$_Id("frm1701:txtPg2IShed1c_3ACI").disabled = false;
				$_Id("frm1701:txtPg2IShed1c_3ATW").disabled = false;
			}
			else {
				disableAndReset('txtPg2IShed1c_3ACI', 'number');
				disableAndReset('txtPg2IShed1c_3ATW', 'number');
			}
		}
		else if (param == 'Pg2IShed2a_2'){
			$_Id("frm1701:txtPg2IShed2a_TIN1").disabled = false;
			$_Id("frm1701:txtPg2IShed2a_TIN2").disabled = false;
			$_Id("frm1701:txtPg2IShed2a_TIN3").disabled = false;
			$_Id("frm1701:txtPg2IShed2a_BranchCode").disabled = false;

			if (field == 'SPS'){
				$_Id("frm1701:txtPg2IShed1c_3BCI").disabled = false;
				$_Id("frm1701:txtPg2IShed1c_3BTW").disabled = false;
			}
			else {
				disableAndReset('txtPg2IShed1c_3BCI', 'number');
				disableAndReset('txtPg2IShed1c_3BTW', 'number');
			}
		}
	}

	function p10rateChk(field){
		if ($_Id("frm1701:" + field).value > 100.00){
			alert("Rate cannot exceed 100%");
			$_Id("frm1701:" + field).value = 0.00;
			$_Id("frm1701:" + field).focus();
		}
	}

	function p11rateChk(field1){
		if ($_Id("frm1701:" + field1 +TYPE).value > 100.00){
			alert("Rate cannot exceed 100%");
			$_Id("frm1701:" + field1 +TYPE).value = 0.00;
			$_Id("frm1701:" + field1 +TYPE).focus();
		}
	}

	function taxRateEnableDisableFields(person, rate){
		if (person == 'taxpayer' && rate == 'GR'){
			computeTxtPg2I22('taxpayer');
			enableFieldsForGRRate('A');
			disableFieldsForGRRate('A');
			populateTotalAllowDeduc(person);
			computeTxtPg2I16(person);
		}
		else if (person == 'taxpayer' && rate == '8%'){
			methodRate('taxpayer');
			enableFieldsForEightPerRate('A');
			disableFieldsForEightPerRate('A');
			computeTxtPg3Sc3I32(person);
		}
		else if (person == 'spouse' && rate == 'GR'){
			computeTxtPg2I22('spouse');
			enableFieldsForGRRate('B');
			disableFieldsForGRRate('B');
			populateTotalAllowDeduc(person);
			computeTxtPg2I16(person);
		}
		else if (person == 'spouse' && rate == '8%'){
			methodRate('spouse');
			enableFieldsForEightPerRate('B');
			disableFieldsForEightPerRate('B');
			computeTxtPg3Sc3I32(person);
		}
	}

	function enableFieldsForGRRate(field){
		$_Id("frm1701:txtPg2IShed3_8" + field).disabled = false;
		$_Id("frm1701:txtPg2IShed3_9" + field).disabled = false;
		
		//$_Id("frm1701:txtPg2IShed3_11" + field).disabled = false;
		
		$_Id("frm1701:txtPg2IShed3_19Desc").disabled = false;
		$_Id("frm1701:txtPg2IShed3_20Desc").disabled = false;
		$_Id("frm1701:txtPg2IShed3_19" + field).disabled = false;
		$_Id("frm1701:txtPg2IShed3_20" + field).disabled = false;
		$_Id("frm1701:txtPg2IShed3_21" + field).disabled = false;
	}

	function controlPart9Fields(person, param){
		if (person == 'taxpayer')
			var field = 'A';
		else if (person == 'spouse')
			var field = 'B';

		if (param == 'enable'){
			for(var ctr = 1; ctr <= 9; ctr++){
				if (ctr != 5){
					$_Id('frm1701:txtPg4IPart9_' + ctr + field).disabled = false;
				}
			}
		}
		else if (param == 'disable'){
			for(var ctr = 1; ctr <= 9; ctr++){
				if (ctr != 5){
					disableAndReset('txtPg4IPart9_' + ctr + field, 'number');
				}
			}
			computeTxtPg4Pt9I5(person);
		}
	}

	function ifItemized(field, item){
		if ($_Id("frm1701:rdo" + field + "MethodDeductionI").checked == true){
			$_Id("frm1701:txtPg2IShed3_11" + item).disabled = false;
		}
		else if ($_Id("frm1701:rdo" + field + "MethodDeductionO").checked == true){
			disableAndReset('txtPg2IShed3_11' + item, 'number');
			differenceOfElements('txtPg2IShed3_10'+item,'txtPg2IShed3_11'+item,'txtPg2IShed3_12'+item);
		}
	}

	function disableFieldsForGRRate(field){
		for (var ctr=26; ctr <= 32; ctr++){
			disableAndReset('txtPg3IShed3_'+ctr +field, 'number');
		}

		if ($_Id("frm1701:txtPg3IShed3_27A").disabled == true && $_Id("frm1701:txtPg3IShed3_27B").disabled == true){
			disableAndReset('txtPg3IShed3_27Desc', 'text'); }
	}

	function enableFieldsForEightPerRate(field){
		$_Id("frm1701:txtPg3IShed3_26" + field).disabled = false;
		$_Id("frm1701:txtPg3IShed3_27" + field).disabled = false;
		$_Id("frm1701:txtPg3IShed3_27Desc").disabled = false;

		if (field == 'A' && tpHasBusnOrProf){
			$_Id("frm1701:txtPg3IShed3_29A").disabled = false;}
		else if (field == 'B' && spHasBusnOrProf){
			$_Id("frm1701:txtPg3IShed3_29B").disabled = false;}
	}

	function disableFieldsForEightPerRate(field){
		for (var ctr=8; ctr <= 25; ctr++){
			disableAndReset('txtPg2IShed3_'+ctr +field, 'number');
		}

		if ($_Id("frm1701:txtPg2IShed3_19A").disabled == true && $_Id("frm1701:txtPg2IShed3_19B").disabled == true){
			disableAndReset('txtPg2IShed3_19Desc', 'text');
			disableAndReset('txtPg2IShed3_20Desc', 'text');
		}
	}
	
    /*-----Computations-----*/
	function methodRate(person){
		if (person == 'taxpayer') {
			ifItemized('Pg1I21A', 'A');
			if ($_Id("frm1701:rdoPg1I21AMethodDeductionI").checked == true){
				populateTotalAllowDeduc(person);
				getSum('txtPg2IShed3_13A'+',txtPg2IShed3_14A'+',txtPg2IShed3_15A','txtPg2IShed3_16A');
				differenceOfElements('txtPg2IShed3_12A', 'txtPg2IShed3_16A', 'txtPg2IShed3_18A');
				disableAndReset('txtPg2IShed3_17A', 'number');
			}
			else if ($_Id("frm1701:rdoPg1I21AMethodDeductionO").checked == true){
				computeTxtPg2I17(person);
				differenceOfElements('txtPg2IShed3_10A', 'txtPg2IShed3_17A', 'txtPg2IShed3_18A');
				disableAndReset('txtPg2IShed3_13A', 'number');
				disableAndReset('txtPg2IShed3_14A', 'number');
				disableAndReset('txtPg2IShed3_15A', 'number');
				disableAndReset('txtPg2IShed3_16A', 'number');
				disableAndReset('txtPg3IShed6_7Year', 'text');
			}
			else{
				disableAndReset('txtPg2IShed3_18A', 'number');
			}
			computeTxtPg2I23(person);
		}

		else if (person == 'spouse') {
			ifItemized('Pg2I12A', 'B');
			if ($_Id("frm1701:rdoPg2I12AMethodDeductionI").checked == true){
				populateTotalAllowDeduc(person);
				getSum('txtPg2IShed3_13B'+',txtPg2IShed3_14B'+',txtPg2IShed3_15B','txtPg2IShed3_16B');
				differenceOfElements('txtPg2IShed3_12B', 'txtPg2IShed3_16B', 'txtPg2IShed3_18B');
				disableAndReset('txtPg2IShed3_17B', 'number');
			}
			else if ($_Id("frm1701:rdoPg2I12AMethodDeductionO").checked == true){
				computeTxtPg2I17(person);
				differenceOfElements('txtPg2IShed3_10B', 'txtPg2IShed3_17B', 'txtPg2IShed3_18B');
				disableAndReset('txtPg2IShed3_13B', 'number');
				disableAndReset('txtPg2IShed3_14B', 'number');
				disableAndReset('txtPg2IShed3_15B', 'number');
				disableAndReset('txtPg2IShed3_16B', 'number');
				disableAndReset('txtPg4IShed6_12Year', 'text');
			}
			else{
				disableAndReset('txtPg2IShed3_18B', 'number');
			}
			computeTxtPg2I23(person);
		}
		
		else if (person == 'consolTP'){
			if ($_Id("frm1701:rdoPg1I21AMethodDeductionI").checked == true){
				differenceOfElements('txtPg1mI5CSchdB','txtPg1mI9CSchdB', 'txtPg1mI11CSchdB');
				differenceOfElements('txtPg1mI5DSchdB','txtPg1mI9DSchdB', 'txtPg1mI11DSchdB');
			}
			else if ($_Id("frm1701:rdoPg1I21AMethodDeductionO").checked == true){
				differenceOfElements('txtPg1mI3CSchdB', 'txtPg1mI10CSchdB', 'txtPg1mI11CSchdB');
				differenceOfElements('txtPg1mI3DSchdB', 'txtPg1mI10DSchdB', 'txtPg1mI11DSchdB');
			}
			else{
				disableAndReset('txtPg1mI11CSchdB', 'number');
				disableAndReset('txtPg1mI11DSchdB', 'number');
			}
		}
		
		else if (person == 'consolSPS'){
			if ($_Id("frm1701:rdoPg2I12AMethodDeductionI").checked == true){
				differenceOfElements('txtPg1mI5GSchdB','txtPg1mI9GSchdB', 'txtPg1mI11GSchdB');
				differenceOfElements('txtPg1mI5HSchdB','txtPg1mI9HSchdB', 'txtPg1mI11HSchdB');
			}
			else if ($_Id("frm1701:rdoPg2I12AMethodDeductionO").checked == true){
				differenceOfElements('txtPg1mI3GSchdB', 'txtPg1mI10GSchdB', 'txtPg1mI11GSchdB');
				differenceOfElements('txtPg1mI3HSchdB', 'txtPg1mI10HSchdB', 'txtPg1mI11HSchdB');
			}
			else{
				disableAndReset('txtPg1mI11GSchdB', 'number');
				disableAndReset('txtPg1mI11HSchdB', 'number');
			}
		}
	}

	function computeTxtPg2Sc2I4CI(person){
		if (person == "taxpayer") {
			allFormat('txtPg2IShed1c_3ACI','txtPg2IShed2_4A');
		}
		else if (person == "spouse") {
    		allFormat('txtPg2IShed1c_3BCI','txtPg2IShed2_4B');
		}

		computeTxtPg2I6(person);
	}

	
	function computeTxtPg2I6(person) {
		if (person == "taxpayer") {
			differenceOfElements('txtPg2IShed2_4A','txtPg2IShed2_5A','txtPg2IShed2_6A');
		}
		else if (person == "spouse") {
			differenceOfElements('txtPg2IShed2_4B','txtPg2IShed2_5B','txtPg2IShed2_6B');
		}

		computeTxtPg1I7(person);
		computeTxtPg2I24(person);
	}
	
	function computeTxtPg1I7(person){
		if (person == "taxpayer") {
			$_Id("frm1701:txtPg2IShed2_7A").value = calcTaxAmt('txtPg2IShed2_6A');
			$_Id("frm1701:txtPg2IShed2_7A").value = formatCurrency((NumWithComma($_Id("frm1701:txtPg2IShed2_7A").value) * 1).toFixed(0));

			if (isTPCompIncOnly) {
				allFormat('txtPg2IShed2_7A', 'txtPg1I22ATaxDue');
				computeTxtPg1I24(person);
			}
		}
		else if (person == "spouse") {
			$_Id("frm1701:txtPg2IShed2_7B").value = calcTaxAmt('txtPg2IShed2_6B');
			$_Id("frm1701:txtPg2IShed2_7B").value = formatCurrency((NumWithComma($_Id("frm1701:txtPg2IShed2_7B").value) * 1).toFixed(0));

			if (isSPCompIncOnly) {
				allFormat('txtPg2IShed2_7B', 'txtPg1I22BTaxDue');
				computeTxtPg1I24(person);
			}
		}

		computeTxtPg3Sc3I30(person);
	}

	function calcTaxAmt(txbleIncField){
		var taxInc = NumWithComma($_Id("frm1701:"+txbleIncField).value);
		var amount = 0.00;

		if ($_Id("frm1701:txtPg1I1Year").value >= 2018 && $_Id("frm1701:txtPg1I1Year").value <= 2022){
			if (taxInc <= 250000){
				amount = 0.00;
				return amount;
			}
			else if (taxInc > 250000 && taxInc <= 400000){
				amount = (taxInc - 250000) * 0.20;
				return amount;
			}
			else if (taxInc > 400000 && taxInc <= 800000){
				amount = ((taxInc - 400000) * 0.25) + 30000;
				return amount;
			}
			else if (taxInc > 800000 && taxInc <= 2000000){
				amount = ((taxInc - 800000) * 0.30) + 130000;
				return amount;
			}
			else if (taxInc > 2000000 && taxInc <= 8000000){
				amount = ((taxInc - 2000000) * 0.32) + 490000;
				return amount;
			}
			else if (taxInc > 8000000){
				amount = ((taxInc - 8000000) * 0.35) + 2410000;
				return amount;
			}
		}
		else if ($_Id("frm1701:txtPg1I1Year").value >= 2023){
			if (taxInc <= 250000){
				amount = 0.00;
				return amount;
			}
			else if (taxInc > 250000 && taxInc <= 400000){
				amount = (taxInc - 250000) * 0.15;
				return amount;
			}
			else if (taxInc > 400000 && taxInc <= 800000){
				amount = ((taxInc - 400000) * 0.20) + 22500;
				return amount;
			}
			else if (taxInc > 800000 && taxInc <= 2000000){
				amount = ((taxInc - 800000) * 0.25) + 102500;
				return amount;
			}
			else if (taxInc > 2000000 && taxInc <= 8000000){
				amount = ((taxInc - 2000000) * 0.30) + 402500;
				return amount;
			}
			else if (taxInc > 8000000){
				amount = ((taxInc - 8000000) * 0.35) + 2202500;
				return amount;
			}
		}

	}

	function computeTxtPg2I10(person){
		if (person == "taxpayer") {
			differenceOfElements('txtPg2IShed3_8A','txtPg2IShed3_9A','txtPg2IShed3_10A');
		}
		else if (person == "spouse") {
			differenceOfElements('txtPg2IShed3_8B','txtPg2IShed3_9B','txtPg2IShed3_10B');
		}

		computeTxtPg2I12(person);
	}

	function computeTxtPg2I12(person){
		if (person == "taxpayer") {
			differenceOfElements('txtPg2IShed3_10A','txtPg2IShed3_11A','txtPg2IShed3_12A');
		}
		else if (person == "spouse") {
			differenceOfElements('txtPg2IShed3_10B','txtPg2IShed3_11B','txtPg2IShed3_12B');
		}

		computeTxtPg2I16(person);
	}

	function computeTxtPg2I16(person){
		if (person == "taxpayer") {
			getSum('txtPg2IShed3_13A'+',txtPg2IShed3_14A'+',txtPg2IShed3_15A','txtPg2IShed3_16A');
		}
		else if (person == "spouse") {
			getSum('txtPg2IShed3_13B'+',txtPg2IShed3_14B'+',txtPg2IShed3_15B','txtPg2IShed3_16B');
		}

		computeTxtPg2I17(person);
		methodRate(person);
		computeTxtPg2I22(person);
	}

	function computeTxtPg2I17(person){
		if (person == "taxpayer") {
			getProduct('txtPg2IShed3_10A', 0.40,'txtPg2IShed3_17A');
		}
		else if (person == "spouse") {
			getProduct('txtPg2IShed3_10B', 0.40,'txtPg2IShed3_17B');
		}
	}

	function computeTxtPg2I22(person){
		if (person == "taxpayer") {
			getSum('txtPg2IShed3_19A'+',txtPg2IShed3_20A'+',txtPg2IShed3_21A','txtPg2IShed3_22A');
		}
		else if (person == "spouse") {
			getSum('txtPg2IShed3_19B'+',txtPg2IShed3_20B'+',txtPg2IShed3_21B','txtPg2IShed3_22B');
		}

		computeTxtPg2I23(person);
	}

	function computeTxtPg2I23(person){
		if (person == "taxpayer") {
			getSum('txtPg2IShed3_18A'+',txtPg2IShed3_22A','txtPg2IShed3_23A');
		}
		else if (person == "spouse") {
			getSum('txtPg2IShed3_18B'+',txtPg2IShed3_22B','txtPg2IShed3_23B');
		}

		computeTxtPg2I24(person);
	}

	function computeTxtPg2I24(person){
		if (person == "taxpayer" && $_Id("frm1701:rdoPg1I21TaxRateG").checked == true) {
			getSum('txtPg2IShed2_6A'+',txtPg2IShed3_23A','txtPg2IShed3_24A');
			computeTxtPg2I25(person);
		}
		else if (person == "spouse" && $_Id("frm1701:rdoPg2I12TaxRateG").checked == true) {
			getSum('txtPg2IShed2_6B'+',txtPg2IShed3_23B','txtPg2IShed3_24B');
			computeTxtPg2I25(person);
		}
	}

	function computeTxtPg2I25(person){
		if (person == "taxpayer") {
			$_Id("frm1701:txtPg2IShed3_25A").value = calcTaxAmt('txtPg2IShed3_24A');
			$_Id("frm1701:txtPg2IShed3_25A").value = formatCurrency((NumWithComma($_Id("frm1701:txtPg2IShed3_25A").value) * 1).toFixed(0));
			allFormat('txtPg2IShed3_25A','txtPg4ISc6_1A');
			computePg4Sc6I4('taxpayer');
		}
		else if (person == "spouse") {
			$_Id("frm1701:txtPg2IShed3_25B").value = calcTaxAmt('txtPg2IShed3_24B');
			$_Id("frm1701:txtPg2IShed3_25B").value = formatCurrency((NumWithComma($_Id("frm1701:txtPg2IShed3_25B").value) * 1).toFixed(0));
			allFormat('txtPg2IShed3_25B','txtPg4ISc6_1B');
			computePg4Sc6I4('spouse');
		}
	}
	
	function computeTxtPg1I24(person) {
        if (person == "taxpayer") {
            d.getElementById('frm1701:txtPg1I24ATaxPayable').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I22ATaxDue").value) - NumWithComma(d.getElementById("frm1701:txtPg1I23A").value));
        } else if (person == "spouse") {
            d.getElementById('frm1701:txtPg1I24BTaxPayable').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I22BTaxDue").value) - NumWithComma(d.getElementById("frm1701:txtPg1I23B").value));
        }
		isTxtPg1I25Allowed(person);
        computeTxtPg1I26(person);
    }

	function isTxtPg1I25Allowed(person) {
		if (person == "taxpayer") {
			if(NumWithComma($_Id('frm1701:txtPg1I24ATaxPayable').value) <= 0){
				disableAndReset('txtPg1I25A', 'number');
			} else {
				$_Id('frm1701:txtPg1I25A').disabled = false;
			}
		} else if (person == "spouse") {
			if(NumWithComma($_Id('frm1701:txtPg1I24BTaxPayable').value) <= 0){
				disableAndReset('txtPg1I25B', 'number');
			} else {
				$_Id('frm1701:txtPg1I25B').disabled = false;
			}
		}
	}

    function computeTxtPg1I26(person) {
        if (person == "taxpayer") {
            if (validateTxtPg1I25Part2(person)) {
                alert("Amount in page 1 Item 25A cannot be more than 50% of Item 22."); 
                d.getElementById("frm1701:txtPg1I25A").value = (0).toFixed(2);
            }
			d.getElementById('frm1701:txtPg1I26A').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I24ATaxPayable").value) - NumWithComma(d.getElementById("frm1701:txtPg1I25A").value));
        } else if (person == "spouse") {
            if (validateTxtPg1I25Part2(person)) {
                alert("Amount in page 1 Item 25B cannot be more than 50% of Item 22."); 
                d.getElementById("frm1701:txtPg1I25B").value = (0).toFixed(2);
            }
			d.getElementById('frm1701:txtPg1I26B').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I24BTaxPayable").value) - NumWithComma(d.getElementById("frm1701:txtPg1I25B").value));
        }
        computeTxtPg1I30(person);
    }

    function computeTxtPg1I30(person) {
        if (person == "taxpayer") {
            d.getElementById('frm1701:txtPg1I30A').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I27A").value) + NumWithComma(d.getElementById("frm1701:txtPg1I28A").value) + NumWithComma(d.getElementById("frm1701:txtPg1I29A").value));
        } else if (person == "spouse") {
            d.getElementById('frm1701:txtPg1I30B').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I27B").value) + NumWithComma(d.getElementById("frm1701:txtPg1I28B").value) + NumWithComma(d.getElementById("frm1701:txtPg1I29B").value));
        }
        computeTxtPg1I31(person);
    }

    function computeTxtPg1I31(person) {
        if (person == "taxpayer") {
            d.getElementById('frm1701:txtPg1I31ATotalAmtPyble').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I26A").value) + NumWithComma(d.getElementById("frm1701:txtPg1I30A").value));

			if (NumWithComma($_Id('frm1701:txtPg1I26A').value) < 0.00 &&
				NumWithComma($_Id('frm1701:txtPg1I30A').value) > 0.00){
				$_Id('frm1701:txtPg1I31ATotalAmtPyble').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I30A").value));
			}
   		}
		else if (person == "spouse") {
            d.getElementById('frm1701:txtPg1I31BTotalAmtPyble').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I26B").value) + NumWithComma(d.getElementById("frm1701:txtPg1I30B").value));

			if (NumWithComma($_Id('frm1701:txtPg1I26B').value) < 0.00 &&
				NumWithComma($_Id('frm1701:txtPg1I30B').value) > 0.00){
				$_Id('frm1701:txtPg1I31BTotalAmtPyble').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I30B").value));
			}
		}
		
        computeTxtPg1I32();
    }

    function computeTxtPg1I32() {
        d.getElementById('frm1701:txtPg1I32AggregateAmtPyble').value = formatCurrency(NumWithComma(d.getElementById("frm1701:txtPg1I31ATotalAmtPyble").value) + NumWithComma(d.getElementById("frm1701:txtPg1I31BTotalAmtPyble").value));
		
		ifOverpayment();
	}

	function ifOverpayment(){
		if (NumWithComma($_Id('frm1701:txtPg1I26A').value) < 0 ||
			NumWithComma($_Id('frm1701:txtPg1I26B').value) < 0){
			$_Id('frm1701:rdoPg1OverpaymentRefund').disabled = false;
			$_Id('frm1701:rdoPg1OverpaymentTCC').disabled = false;
			$_Id('frm1701:rdoPg1OverpaymentCarryOver').disabled = false;
		}
		else if (NumWithComma($_Id('frm1701:txtPg1I26A').value) >= 0 &&
			NumWithComma($_Id('frm1701:txtPg1I26B').value) >= 0){
			disableAndReset('rdoPg1OverpaymentRefund', 'radio');
			disableAndReset('rdoPg1OverpaymentTCC', 'radio');
			disableAndReset('rdoPg1OverpaymentCarryOver', 'radio');
		}
	}
	
	function computeTxtPg3Sc3I28(person){
