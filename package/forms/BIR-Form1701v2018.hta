	function computePage3mScheduleB(person){
		if(person.toString() === "taxpayer"){
			//item 3 Sched B 
			differenceOfElements('txtPg3mSchedB_1A'+TYPE, 'txtPg3mSchedB_2A'+TYPE, 'txtPg3mSchedB_3A'+TYPE);
			//item 4 Sched B 
			differenceOfElements('txtPg3mSchedB_3A'+TYPE, 'txtPg3mSchedB_4A'+TYPE, 'txtPg3mSchedB_5A'+TYPE);
			//item 8 Sched B 
			getSum('txtPg3mSchedB_6A'+TYPE+',txtPg3mSchedB_7A'+TYPE,'txtPg3mSchedB_8A'+ TYPE );
			//item 9 Sched B 
			differenceOfElements('txtPg3mSchedB_5A'+TYPE, 'txtPg3mSchedB_8A'+TYPE, 'txtPg3mSchedB_9A'+TYPE);
			//item 12 Sched B 
			getSum('txtPg3mSchedB_10A'+TYPE+',txtPg3mSchedB_11A'+TYPE,'txtPg3mSchedB_12A'+ TYPE );
			//item 13 Sched B 
			getSum('txtPg3mSchedB_9A'+TYPE+',txtPg3mSchedB_12A'+TYPE,'txtPg3mSchedB_13A'+ TYPE );
			//item 15 Sched B
			val = (document.getElementById('frm1701:txtPg3mSchedB_14A'+TYPE).value/100);
			if (d.getElementById('frm1701:rdoPg3mExempt'+TYPE).checked == true)	{
				getProduct('txtPg3mSchedB_13A'+TYPE,val,'txtPg3mSchedB_15A'+TYPE)
