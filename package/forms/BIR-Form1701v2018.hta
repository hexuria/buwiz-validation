	function checkPart10TPSchedA(){
		if ($_Id('frm1701:rdoPg1I19IncomeExemptYes').checked == true &&
			$_Id('frm1701:rdoPg1mOption1').checked == true){
			for (var x = 1; x <= 6; x++){
				if (x != 4){
					if ($_Id('frm1701:txtPg1mI'+x+'ASchdA').value == ''){
						alert("Please populate Taxpayer's Part 10 Schedule A Item " + x + " Exempt.");
						return true;
					}
				}
			}
		}

		if ($_Id('frm1701:rdoPg1I20IncomeSpecialYes').checked == true &&
			$_Id('frm1701:rdoPg1mOption1').checked == true){
			for (var x = 1; x <= 6; x++){
				if ($_Id('frm1701:txtPg1mI'+x+'BSchdA').value == ''){
					alert("Please populate Taxpayer's Part 10 Schedule A Item " + x + " Special.");
					return true;
