            allXML += "<div>lob=" + escape(d.getElementById('frm1701:txtLineBus').value) + "lob=</div>" + tab;
            allXML += "<div>regAddr="+escape(d.getElementById('frm1701:txtPg1I9Address').value)+escape(d.getElementById('frm1701:txtPg1I9Address2').value)+"regAddr=</div>"+tab;	
            allXML += "<div>zip=" + d.getElementById('frm1701:txtPg1I9AZipCode').value + "zip=</div>" + tab;
            allXML += "<div>telNo=" + d.getElementById('frm1701:txtPg1I15TelNum').value + "telNo=</div>" + tab;
            allXML += "<div>email=" + document.getElementById('txtEmail').value + "email=</div>" + tab;allXML += "<div>confirmemail=" + document.getElementById('txtEmail').value + "confirmemail=</div>" + tab;
             allXML += "<div>confirmtin1=" + d.getElementById('frm1701:txtPg1I4TIN1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm1701:txtPg1I4TIN2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm1701:txtPg1I4TIN3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm1701:txtPg1I4BranchCode').value + "confirmtin4=</div>" + tab;
			allXML += "<div>formType=1701v2018formType=</div>" + tab;

            allXML += tab + d.getElementById('xmlClose').innerHTML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (isFinalCopy == false) {
                alert('Background information saved/updated successfully as : ' + xmlFileName);
            }
        }
    }

    /*--------------------------------------------------------------*/
	
	function negativeNumbers(e, decimal) {
        var key;
        var keychar;

        if (window.event) {
            key = window.event.keyCode;
        }
        else if (e) {
            key = e.which;
        }
        else {
            return true;
        }
        keychar = String.fromCharCode(key);

        if ((key == null) || (key == 0) || (key == 8) || (key == 9) || (key == 13) || (key == 27)) {
            return true;
        }
        else if ((("0123456789-()").indexOf(keychar) > -1)) {
            return true;
        }
        else {
            return false;
        }
    }

    function blockletter(e) {
        var number = parseFloat(e.value).toFixed(2);
        if (isNaN(number)) {
            var zero = 0;
            e.value = parseFloat(zero).toFixed(2);
            //e.value = "";
        } else {
            e.value = '' + number;
            if (e.value < 0) {
                var zero = 0;
                e.value = parseFloat(zero).toFixed(2);
            }
        }
    }

    function blockletterWithout2Decimal(e) {
        var number = parseFloat(e.value);
        if (isNaN(number)) {
            //var zero = 0;
            //e.value = parseFloat(zero).toFixed(2);
            e.value = "";
        } else {
            e.value = '' + number.toFixed(0);
        }
    }

	function validateMonthDayYearDate(dateID) {
        strmmddyyyy = dateID;

        if (strmmddyyyy != "") {
            var result = strmmddyyyy.split("/");
            var isLeap = new Date(result[2], 1, 29).getMonth() == 1;
            var month31 = (['01', '03', '05', '07', '08', '10', '12']);
            var month30 = (['04', '06', '09', '11']);
            var month = result[0];
            var day = result[1];
            if (result.length == 3) {
                if (isNaN(result[0] || result[1] || result[2])) {
                    return true;
                }
                else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 0))) {
                    // numeric check if greater not than 31 - Month.
                    return true;
                }
                else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
                    // numeric check if Date.
                    return true;
                }
                else if (result[2].length != 4) {
                    return true;
                }
                else if (month == 2) {
                    if (!isLeap && day == 29) {
                        return true;
                    }
                    else if (!isLeap && day > 29) {
                        return true;
                    }
                    else if (isLeap && day > 29) {
                        return true;
                    }
                }
                else if (month31.contains(month) && day > 31) {
                    return true;
                }
                else if (month30.contains(month) && day > 30) {
                    return true;
                }
            } else {
                return true;
            }
        }
    }

	function checkFieldsAfterXMLLoad(){
		//This function will do the necessary check for fields after loading the XML.
		if ($_Id('frm1701:rdoPg1I13ForeignTaxCreditsYes').checked == true){
			$_Id('frm1701:txtPg1I14ForeignTaxNumber').disabled = false;}
		
		if ($_Id('frm1701:rdoPg1I18FilingStatusJ').checked == true){
			$_Id("frm1701:rdoPg1I17SpouseIncomeYes").disabled = false;
			$_Id("frm1701:rdoPg1I17SpouseIncomeNo").disabled = false;
			$_Id("frm1701:rdoPg1I18FilingStatusJ").disabled = false;
			$_Id("frm1701:rdoPg1I18FilingStatusS").disabled = false;
			spouseFields('enable');
			$_Id("frm1701:rdoPg2I8ForeignTaxCreditsNo").checked = true;
			SPATCeffect();
		}
		else if ($_Id('frm1701:rdoPg1I17SpouseIncomeNo').checked == true){
			disableSpouseFields('spouseNoInc');}
		else if ($_Id('frm1701:rdoPg1I16CivilStatusM').checked == false){
			disableSpouseFields('noSpouse');}
		
		forPart8Fields('taxpayer');
		forPart8Fields('spouse');
	}

	function validateDate(dateID) {
        strmmddyyyy = dateID.value;
		var isValid = true;
        var currentDate = new Date();
        var inputDate = new Date();

        if (strmmddyyyy != "") {
            var result = strmmddyyyy.split("/");
            var isLeap = new Date(result[2], 1, 29).getMonth() === 1;
            var month31 = (['01', '03', '05', '07', '08', '10', '12']);
            var month30 = (['04', '06', '09', '11']);
            var month = result[0];
            var day = result[1];
            if (result.length === 3) {
                if (isNaN(result[0] || result[1] || result[2])) {
                    isValid = false;
                }
                else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 0))) {
                    // numeric check if greater not than 31 - Month.
                    isValid = false;
                }
                else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
                    // numeric check if Date.
                    isValid = false;
                }
                else if (result[2].length != 4 || ((result[2] * 1) < 1800)) {
                    isValid = false;
                }
                else if (month == 2) {
                    if (!isLeap && day == 29) {
                        isValid = false;
                    }
                    else if (!isLeap && day > 29) {
                        isValid = false;
                    }
                    else if (isLeap && day > 29) {
                        isValid = false;
                    }
                }
                else if (month31.contains(month) && day > 31) {
                    isValid = false;
                }
                else if (month30.contains(month) && day > 30) {
                    isValid = false;
                }

                inputDate = new Date(result[2], month - 1, day);
            }
            else {
                isValid = false;
            }
        }

        if (!isValid) {
            alert('Please provide a valid date. (MM/DD/YYYY format)');
            dateID.value = '';
            dateID.focus();
        }
        /*else if (inputDate > currentDate) {
            alert('This date cannot be a future date.');
            dateID.value = '';
            dateID.focus();
        }*/
        return isValid;    
	}
	
    function validateTxtPg1I25Part2(person) {
        if (person == "taxpayer") {
            var total = NumWithComma(d.getElementById('frm1701:txtPg1I22ATaxDue').value) * 50/100;

            if (NumWithComma(d.getElementById('frm1701:txtPg1I25A').value) > total) {
                return true;
            } else {
                return false;
            }
        } else if (person == "spouse") {
            var total = NumWithComma(d.getElementById('frm1701:txtPg1I22BTaxDue').value) * 50/100;
            
            if (NumWithComma(d.getElementById('frm1701:txtPg1I25B').value) > total) {
                return true;
            } else {
                return false;
            }
        }
    } 

