			$_Id('frm1701:rdoPg1I7ATC_II013').disabled = false;
			$_Id('frm1701:rdoPg1I7ATC_II016').disabled = false;
			disableAndReset('txtPg3IShed3_29A', 'number');
			computeTxtPg3Sc3I30('taxpayer');
			isTPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked == true &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeT').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeC').checked == true){
			$_Id('frm1701:rdoPg1I7ATC_II013').disabled = false;
			$_Id('frm1701:rdoPg1I7ATC_II016').disabled = false;
			disableAndReset('txtPg3IShed3_29A', 'number');
			computeTxtPg3Sc3I30('taxpayer');
			isTPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked == true &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeT').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeC').checked == false){
			$_Id('frm1701:rdoPg1I7ATC_II012').disabled = false;
			$_Id('frm1701:rdoPg1I7ATC_II015').disabled = false;
			tpHasBusnOrProf = true;
			isTPEligForReduction();
			isTPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked == true &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeT').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeC').checked == false){
			$_Id('frm1701:rdoPg1I7ATC_II014').disabled = false;
			$_Id('frm1701:rdoPg1I7ATC_II017').disabled = false;
			tpHasBusnOrProf = true;
			isTPEligForReduction();
			isTPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked == true &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeT').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeC').checked == false){
			$_Id('frm1701:rdoPg1I7ATC_II012').disabled = false;
			$_Id('frm1701:rdoPg1I7ATC_II015').disabled = false;
			tpHasBusnOrProf = true;
			isTPEligForReduction();
			isTPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeT').checked == true &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeC').checked == false){
			$_Id('frm1701:rdoPg1I7ATC_II012').disabled = false;
			$_Id('frm1701:rdoPg1I7ATC_II015').disabled = false;
			tpHasBusnOrProf = true;
			isTPEligForReduction();
			isTPCompIncOnly = false;
		}
		else if ($_Id('frm1701:rdoPg1I6TaxpayerTypeS').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeP').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeE').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeT').checked == false &&
			$_Id('frm1701:rdoPg1I6TaxpayerTypeC').checked == true){
			$_Id('frm1701:rdoPg1I7ATC_II011').disabled = false;
			$_Id('frm1701:rdoPg1I7ATC_II011').checked = true;
			disableAndReset('txtPg3IShed3_29A', 'number');
			computeTxtPg3Sc3I30('taxpayer');
			TPATCeffect();
			allFormat('txtPg2IShed2_7A', 'txtPg1I22ATaxDue');
			isTPCompIncOnly = true;
		}
	}

	function isTPEligForReduction(){
		if ($_Id('frm1701:rdoPg1I21TaxRateP').checked == true){
			$_Id('frm1701:txtPg3IShed3_29A').disabled = false;}
	}

