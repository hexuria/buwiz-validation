	function TPdisableP5Sched6Fields(){
		disableAndReset('txtPg3IShed6_1A', 'number');
		disableAndReset('txtPg3IShed6_2A', 'number');

		for (var i = 4; i <= 7; i++){
			disableAndReset('txtPg3IShed6_'+i+'Year', 'text');
