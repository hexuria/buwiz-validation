   function computePg3Sc6I3(person, field){
	   if (person == "taxpayer") {
			if (NumWithComma($_Id('frm1701:txtPg3IShed6_2A').value) <
				NumWithComma($_Id('frm1701:txtPg3IShed6_1A').value) &&
				field == 'item2'){
				alert('Deduction amount should be greater than the gross income amount.');
				$_Id('frm1701:txtPg3IShed6_2A').value = '0.00';
			}
			differenceOfElements('txtPg3IShed6_1A','txtPg3IShed6_2A','txtPg3IShed6_3A');
			computePg3Sc6I7E();

			if ($_Id('frm1701:rdoPg1I21AMethodDeductionI').checked == true &&
				NumWithComma($_Id("frm1701:txtPg3IShed6_7A").value) > 0.00){
				$_Id('frm1701:txtPg3IShed6_7Year').value = $_Id('frm1701:txtPg1I1Year').value;}
	   }
	   else if (person == "spouse") {
			if (NumWithComma($_Id('frm1701:txtPg3IShed6_2B').value) <
				NumWithComma($_Id('frm1701:txtPg3IShed6_1B').value) &&
				field == 'item2'){
				alert('Deduction amount should be greater than the gross income amount.');
				$_Id('frm1701:txtPg3IShed6_2B').value = '0.00';
			}
			differenceOfElements('txtPg3IShed6_1B','txtPg3IShed6_2B','txtPg3IShed6_3B');			
			computePg4Sc6I12E();

			if ($_Id('frm1701:rdoPg2I12AMethodDeductionI').checked == true &&
				NumWithComma($_Id("frm1701:txtPg4IShed6_12A").value) > 0.00){
				$_Id('frm1701:txtPg4IShed6_12Year').value = $_Id('frm1701:txtPg1I1Year').value;}
	   }
   }

	function checkValidNOLCOYear(field){
		//alert($_Id('frm1701:txtPg1I1Year').value);
		var tempYear = $_Id('frm1701:txtPg1I1Year').value - 3;
		//alert(tempYear);
		if($_Id('frm1701:'+ field).value < tempYear){
			alert('Year incurred cannot be more than 3 years of current year.');
			$_Id('frm1701:'+ field).value = '';
		}
		else if ($_Id('frm1701:'+ field).value > $_Id('frm1701:txtPg1I1Year').value){
			alert('Year incurred in this field cannot be a future year.');
			$_Id('frm1701:'+ field).value = '';
		}
		else if ($_Id('frm1701:'+ field).value == $_Id('frm1701:txtPg1I1Year').value){
			alert('Year incurred in this field cannot be the same as current year.');
			$_Id('frm1701:'+ field).value = '';
		}
	}

	function computePg3Sc6I4E() {
		checkNOLCOoperLoss('txtPg3IShed6_4');
	    getDifference('txtPg3IShed6_4A', 'txtPg3IShed6_4B'+',txtPg3IShed6_4C'+',txtPg3IShed6_4D', 'txtPg3IShed6_4E');
	}
