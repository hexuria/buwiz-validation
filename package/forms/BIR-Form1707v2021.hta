<script type="text/javascript">

    function openDialog3(element) {
        $('#' + element).show("fade");
        centerMe2('#' + element);

        $('#containerPage').hide();
        $('#wrapper').hide();
        $('#PageFooter').hide();
    }

    function closeDialog3(element) {
        $('#' + element).hide("fade");
        $('#containerPage').show();
        
        $('#wrapper').show();
        $('#PageFooter').show();
    }
    function centerMe2(element) {
        //pass element name to be centered on screen
        var pWidth = $(window).width();
        var pTop = $(window).scrollTop()
        var eWidth = $(element).width()
        var height = $(element).height()
        $(element).css('top', '130px')
        $(element).css('left', parseInt((pWidth / 2) - (eWidth / 2)) + 'px')
    }


    function openDialog(element) {
        $('#container').hide();
        $(element).show('clip');

        // centerMe(element);
    }

    function closeDialog(element) {
        $('#container').show();
        $(element).hide('clip');

    }

    function openDialog2(element) {
        //this is the general dialog handler.
        //pass the element name and this will copy
        //the contents of the element to the dialog box

        $('#overlay2').css('height', $(document.body).height() + 'px')
        $('#overlay2').show()
        $('#dialog2').html($(element).html())
        centerMe('#dialog2')
        $('#dialog2').slideDown();
    }

    function closeDialog2() {
        $('#overlay2').hide();
        $('#dialog2').slideUp().html('');
    }
    function Load_Schedule(schedule) {
        var $dialog2 = $('#dialog2').html($('#dialog2').html() + '<br /> &nbsp;&nbsp;&nbsp; <input type="button" value=" Save " onclick="Save_Schedule(dialog2,' + "'" + schedule + "'" + ')"/>'
                        + '&nbsp;&nbsp;&nbsp; <input type="button" value=" Save and Close " onclick="Save_Schedule(dialog2,' + "'" + schedule + "'" + '), closeDialog2()" /> '
                        + '&nbsp;&nbsp;&nbsp; <input type="button" value=" Cancel " onclick="closeDialog2()" /> ');

        Get_Schedule(schedule);
    }

    function Get_Schedule(schedule) {
        var $schedTable = $($('#dialog2').find("div[id*='" + schedule + "']")[0]);
        var origTableID = "#containerPage #" + $schedTable.attr("id");
        var $origSchedTable = $(origTableID);

        $schedTable.find("input").each(function (idx, elem) {
            var $elem = $(elem);
            $elem.val($(origTableID + " input[id='" + $elem.attr("id") + "']").val());
        });
        $schedTable = null;
        $origSchedTable = null;
    }
    function Save_Schedule(dialog, schedule) {
        var $schedTable = $($(dialog).find("div[id*='" + schedule + "']")[0]);
        var origTableID = "#containerPage #" + $schedTable.attr("id");
        var $origSchedTable = $(origTableID);

        $inputs = $schedTable.find("input").each(function (idx, elem) {
            var $elem = $(elem);
            $(origTableID + " input[id='" + $elem.attr("id") + "']").val($elem.val());
        });

        $inputs.blur(function () {
            var $this = $(this);

        });

        $inputs.trigger('blur');    //trigger remote blur        
        Get_Schedule(schedule);     //get values from original

    }

    function centerMe(element) {
        //pass element name to be centered on screen
        var pWidth = $(window).width();
        var pTop = $(window).scrollTop();
        var eWidth = $(element).width();
        var height = $(element).height();
        $(element).css('top', '130px');
        //$(element).css('top',pTop+100+'px')
        $(element).css('left', parseInt((pWidth / 2) - (eWidth / 2)) + 'px');
    }

    function deleteRow(btn, currRow, delete2ndRow) {
        var row = btn.parentNode.parentNode;
        row.parentNode.removeChild(row);
		
		if (delete2ndRow)
			d.getElementById('frm1707:deleteRow2nd' +currRow).onclick();
    }

    function deleteRow2(btn) {
        var row = btn.parentNode.parentNode;
        row.parentNode.removeChild(row);
    }

    function cancelModal(modal, loadFunction) {
        var answer = confirm("Don't save changes?");
        if (answer == true) {
            closeDialog(modal);
            loadFunction();
        }
        else {
            return;
        }
    }

    function onFocusIterate(elem) {
        $(elem).css({ 'background': '#ffffcc' });
    }
    function onBlurIterate(elem) {
        $(elem).css({ 'background': '#ffffff' });
    }


    function SaveAndClose(saveFunction, popTable) {
        if (saveFunction()) {
            closeDialog(popTable);
        }
    }

    function ConditionPrint(table) {
        if (document.getElementById("frm1707:btnValidate").disabled) {
            $(table + " input[type='text']").attr("disabled", true);
            $(table + " input[type='button']").attr("disabled", true);
            $(table + " input[name='prnModal']").attr("disabled", false);
            $(table + " input[name='closeModal']").attr("disabled", false);
        }
        else {
            $(table + " input[type='text']").attr("disabled", false);
            $(table + " input[type='button']").attr("disabled", false);
            $(table + " input[name='prnModal']").attr("disabled", true);
        }
    }

    function CheckEmptyDesc(table1st, table2nd, number, method) {
        numRows = document.getElementById(table1st).rows.length;
        table1st = document.getElementById(table1st);
		table2nd = document.getElementById(table2nd);


        for (x = 0; x < numRows; x++) {
            cellslength1st = table1st.rows[x].cells.length;
			cellslength2nd = table2nd.rows[x].cells.length;
            str = table1st.rows[x].cells[0].children[1].value;
			
			row1itemA = table1st.rows[x].cells[0].children[1].value;
			
			row1itemB = table2nd.rows[x].cells[0].children[0].value;
			row1itemC = table2nd.rows[x].cells[1].children[0].value;
			row1itemD = table2nd.rows[x].cells[2].children[0].value;

			if (cellslength1st == 2){
				if ($.trim(row1itemA) == ""){
					alert('Cannot ' + method + '. You have an empty data in ' + number + (x + 1));
					return false;
				}
			}			
			
			if (cellslength2nd == 4){
				if ($.trim(row1itemB) <= 0.00 ||$.trim(row1itemC) == "" || $.trim(row1itemD) <= 0.00){
					alert('Cannot ' + method + '. You have an empty data in ' + number + (x + 1));
					return false;
				}
			}
		}

        return true;
    }   

    function ConditionAddRow(table1st, table2nd, number, method, addFunction) {
        if (CheckEmptyDesc(table1st, table2nd, number, method)) {
            addFunction();
        }
    }

    function CheckEmptyDesc2(table1st, number, method) {
        numRows = document.getElementById(table1st).rows.length;
        table1st = document.getElementById(table1st);


        for (x = 0; x < numRows; x++) {
            cellslength1st = table1st.rows[x].cells.length;
            str = table1st.rows[x].cells[0].children[1].value;
			
			row1itemA = table1st.rows[x].cells[0].children[1].value;
			row1itemB = table1st.rows[x].cells[1].children[0].value;
			

			if (cellslength1st == 3){
				if ($.trim(row1itemA) == "" || $.trim(row1itemB) <= 0.00){
					alert('Cannot ' + method + '. You have an empty data in ' + number + (x + 1));
					return false;
				}
			}			
		}

        return true;
    } 

    function ConditionAddRow2(table, number, method, addFunction) {
        if (CheckEmptyDesc2(table, number, method)) {
            addFunction();
        }
    }

</script>

<!--Page2 Part 4 Sched 22 Modal Scripts-->
<script>
	var Pg2Pt4S2_Col1 = new Array();
    var Pg2Pt4S2_Col2 = new Array();
    var Pg2Pt4S2_Col3 = new Array();
	var Pg2Pt4S2_Col4 = new Array();

    function Check_Pg2Pt4S2() {
        //  var isNotEmpty = true;

        if ($.trim(d.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock1").value) == "" || d.getElementById("frm1707:txtPg2P4Sch2NoOfShares1").value * 1 == 0 || d.getElementById("frm1707:txtPg2P4Sch2StockCertNo1").value == "" || d.getElementById("frm1707:txtPg2P4Sch2TaxBaseSellPrice1").value * 1 == 0 ||
            $.trim(d.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock2").value) == "" || d.getElementById("frm1707:txtPg2P4Sch2NoOfShares2").value * 1 == 0 || d.getElementById("frm1707:txtPg2P4Sch2StockCertNo2").value == "" || d.getElementById("frm1707:txtPg2P4Sch2TaxBaseSellPrice2").value * 1 == 0 ||
            $.trim(d.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock3").value) == "" || d.getElementById("frm1707:txtPg2P4Sch2NoOfShares3").value * 1 == 0 || d.getElementById("frm1707:txtPg2P4Sch2StockCertNo3").value == "" || d.getElementById("frm1707:txtPg2P4Sch2TaxBaseSellPrice3").value * 1 == 0 ||
			$.trim(d.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock4").value) == "" || d.getElementById("frm1707:txtPg2P4Sch2NoOfShares4").value * 1 == 0 || d.getElementById("frm1707:txtPg2P4Sch2StockCertNo4").value == "" || d.getElementById("frm1707:txtPg2P4Sch2TaxBaseSellPrice4").value * 1 == 0 ) {

			$('#btnPg2Pt4Sch2More').prop('disabled', true);
            if (!$('#dialog2').is(':empty')) {
                $('#dialog2 #btnPg2Pt4Sch2More').prop('disabled', true);
            }
            //      isNotEmpty = false;
        }
        else {
            $('#btnPg2Pt4Sch2More').prop('disabled', false);
            if (!$('#dialog2').is(':empty')) {
                $('#dialog2 #btnPg2Pt4Sch2More').prop('disabled', false);
            }
			
			if (d.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock4").value == "OTHERS"){
				d.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock4").disabled = true;
				d.getElementById("frm1707:txtPg2P4Sch2NoOfShares4").disabled = true;
				d.getElementById("frm1707:txtPg2P4Sch2StockCertNo4").disabled = true;
				d.getElementById("frm1707:txtPg2P4Sch2TaxBaseSellPrice4").disabled = true;
			}
			
            //      isNotEmpty = true;
        }
        //  return isNotEmpty;
    }

    function Set_Pg2Pt4S2() {
        if (Pg2Pt4S2_Col1.length <= 1) {
            Pg2Pt4S2_Col1[0] = d.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock4").value;
            Pg2Pt4S2_Col2[0] = d.getElementById("frm1707:txtPg2P4Sch2NoOfShares4").value;
            Pg2Pt4S2_Col3[0] = d.getElementById("frm1707:txtPg2P4Sch2StockCertNo4").value;
			Pg2Pt4S2_Col4[0] = d.getElementById("frm1707:txtPg2P4Sch2TaxBaseSellPrice4").value;

            //            d.getElementById("frm1707:txtPg3Pt6S2I4Description").value = "OTHERS";
            //            $(d.getElementById("frm1707:txtPg3Pt6S2I4Description")).prop('disabled', true);
            //            $(d.getElementById("frm1707:txtPg3Pt6S2I4LegalBasis")).prop('disabled', true);
            //            $(d.getElementById("frm1707:txtPg3Pt6S2I4Amount")).prop('disabled', true);
        }
    }

    function Save_Pg2Pt4S2PopTable() {
        numRows = d.getElementById("Pg2Pt4S2PopTable1st").rows.length;
        tableOne = d.getElementById("Pg2Pt4S2PopTable1st");
		tableTwo = d.getElementById("Pg2Pt4S2PopTable2nd");

