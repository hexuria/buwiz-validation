        getValue("frm1707:txtPg2Pt6I49BIRAccreditedNoC1") + getValue("frm1707:txtPg2Pt6I49BIRAccreditedNoC2") + getValue("frm1707:txtPg2Pt6I49BIRAccreditedNoC3") + getValue("frm1707:txtPg2Pt6I49BIRAccreditedNoC4"),
