        getAmount("frm1707:txtPg3S2I21DirectMaterials"),
        getAmount("frm1707:txtPg3S2I22DirectDepreciation"),
        getAmount("frm1707:txtPg3S2I23DirectRental"),
        getAmount("frm1707:txtPg3S2I24DirectOutside"),
        getAmount("frm1707:txtPg3S2I25DirectOthers"),
        getAmount("frm1707:txtPg3S2I26TotalCostServices"),
        getAmount("frm1707:txtPg3S2I27TotalCostSales"));

		var txtPg3Pt6S1I17Col1 = getValue("frm1707:txtPg3Pt6I17OthersIDesc");
