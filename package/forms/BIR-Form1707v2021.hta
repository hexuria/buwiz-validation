    function goToSched(page) {
        document.getElementById("frm1707:txtCurrentPage").value = page;
        goToPage();
    }

    function goToPage() {
        
        var newVal = document.getElementById("frm1707:txtCurrentPage").value;

        var printType = "Page";

        if ((newVal <= MaxPage) && (newVal > 0) && (newVal !== currentPage.toString())) {
/*
            if(newVal == "1"){
                $('#formPaper').css({ 'max-width': '8.3in !important','max-height': '14in !important', 'left': '-5.0mm', 'border': '#000 2px solid', 'position': 'relative', 'margin': '0px' });
                $('#wrapper').css({ 'max-width': '8.3in !important' ,'max-height': '14in !important', 'left': '-5.0mm'});
                $('#container').css({ 'max-width': '8.3in !important','max-height': '14in !important', 'left': '-5.0mm' });
            }
            else if(newVal == "2"){
                $('#formPaper').css({ 'max-width': '8.3in !important','max-height': '14in !important', 'left': '4.0mm','border': '#000 2px solid', 'position': 'relative', 'margin': '0px' });
                $('#wrapper').css({ 'max-width': '8.3in !important' ,'max-height': '14in !important', 'left': '4.0mm' });
                $('#container').css({ 'max-width': '8.3in !important','max-height': '14in !important', 'left': '4.0mm' });
            }*/

            $('#' + printType + currentPage + 'Content').hide('blind');
            $('#' + printType + newVal + 'Content').show('blind');
            currentPage = (document.getElementById("frm1707:txtCurrentPage").value) * 1;
        }
        else if ((newVal > MaxPage) || (newVal <= 0)) {
            alert("Invalid page");

            document.getElementById("frm1707:txtCurrentPage").value = currentPage;
        }

    }

    function processPrev() {
        if (currentPage == 1)
            currentPage = 1;
        else {
            currentPage--;
            $('#Page' + currentPage + 'Content').show('blind');
            $('#Page' + (currentPage + 1) + 'Content').hide('blind');
            document.getElementById('frm1707:txtCurrentPage').value = currentPage;

        }

        if(document.getElementById('txtFinalFlag').value == "1"){
            if(document.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock4").value == "OTHERS"){
                document.getElementById("btnPg2Pt4Sch2More").disabled = false;  
            }
            else{
                document.getElementById("btnPg2Pt4Sch2More").disabled = true;  
            }

            if(document.getElementById("frm1707:txtPg2P4Sch3Particulars4").value == "OTHERS"){
                document.getElementById("btnPg2Pt4Sch3More").disabled = false;  
            }
            else{
                document.getElementById("btnPg2Pt4Sch3More").disabled = true; 
            }
            
        }   
    }
    function processNext() {

        if (currentPage == MaxPage) {

        }
        else {
            currentPage++;
            $('#Page' + currentPage + 'Content').show('blind');
            $('#Page' + (currentPage - 1) + 'Content').hide('blind');
            document.getElementById('frm1707:txtCurrentPage').value = currentPage;
        }


        if(document.getElementById('txtFinalFlag').value == "1"){
            if(document.getElementById("frm1707:txtPg2P4Sch2NameOfCorpStock4").value == "OTHERS"){
                document.getElementById("btnPg2Pt4Sch2More").disabled = false;  
            }
            else{
                document.getElementById("btnPg2Pt4Sch2More").disabled = true;  
            }

            if(document.getElementById("frm1707:txtPg2P4Sch3Particulars4").value == "OTHERS"){
                document.getElementById("btnPg2Pt4Sch3More").disabled = false;  
            }
            else{
                document.getElementById("btnPg2Pt4Sch3More").disabled = true; 
            }
            
        }         
    }



    function getDisabledText() {
        $("input, select").removeClass("disabledInputs");
        $("input:disabled, select:disabled").addClass("disabledInputs");

    }
    var disableElem = true;
    var enableElem = false;
    function disableAllControl() {
        $("input:text, select", $("#containerPage")).attr("disabled", true);
        $("input:button, input:checkbox, input:radio").attr("disabled", true);
        $('input[disabled]').css('background-color', '#EBEBE4');
        disableElem;
        enableElem;
    }
    function enableAllControl() {

        $("input:text, select", $("#containerPage")).attr("disabled", false);
        $("input:button, input:checkbox, input:radio").attr("disabled", false);
      
        $(".disabledInputs").attr("disabled", true);
        $('input[type="text"]:not(:disabled)').css('background-color', 'white');

        document.getElementById("frm1707:btnValidate").disabled = false;

        //document.onmouseup();
        disableElem;
        enableElem;
    }

    // SUBMIT START
    function processSubmit() {


        if (d.getElementById('frm1707:SubmitToAIF').checked) {
            if (confirm("Are you sure you want to submit this form to eBIRForms Online?") === true) {
                //  alert('eBIRForms Offline to eBIRForms Online is under construction');
                submitToEFPS();
            }

            //openLogin();
        }
        else if (d.getElementById('frm1707:SubmitToeFPS').checked) {
            if (confirm("Are you sure you want to submit this form to eFPS?") === true) {
                alert('eBIRForms Offline to eFPS is under construction');

            }
            //var url = "../forms/BIR-Form1702MX.hta?xmlFileName=savefile/" + createXMLProfileName();
            //window.location = url;
        }


        $('#SubmitPage').hide('blind');
    }

