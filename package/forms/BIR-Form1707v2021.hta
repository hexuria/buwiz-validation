	function loadToArray(){
		numRows = d.getElementById("Pg2Pt4S2PopTable1st").rows.length;
        tableOne = d.getElementById("Pg2Pt4S2PopTable1st");
		tableTwo = d.getElementById("Pg2Pt4S2PopTable2nd");

		Pg2Pt4S2_Col1 = new Array();
		Pg2Pt4S2_Col2 = new Array();
		Pg2Pt4S2_Col3 = new Array();
		Pg2Pt4S2_Col4 = new Array();

        for (x = 0; x < numRows; x++) {
            str = tableOne.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                Pg2Pt4S2_Col1.push(tableOne.rows[x].cells[0].children[1].value);//alert("0>" + Pg2Pt4S2_Col1);
				Pg2Pt4S2_Col2.push(tableTwo.rows[x].cells[0].children[0].value);//alert("1>" + Pg2Pt4S2_Col2);
				Pg2Pt4S2_Col3.push(tableTwo.rows[x].cells[1].children[0].value);//alert("2>" + Pg2Pt4S2_Col3);
				Pg2Pt4S2_Col4.push(tableTwo.rows[x].cells[2].children[0].value);//alert("3>" + Pg2Pt4S2_Col4);
            }
        }

		numRows = d.getElementById("Pg2Pt4S3PopTable1st").rows.length;
        tableOne = d.getElementById("Pg2Pt4S3PopTable1st");

		Pg2Pt4S3_Col1 = new Array();
		Pg2Pt4S3_Col2 = new Array();

        for (x = 0; x < numRows; x++) {
            str = tableOne.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                Pg2Pt4S3_Col1.push(tableOne.rows[x].cells[0].children[1].value);//alert("0>" + Pg2Pt4S3_Col1);
				Pg2Pt4S3_Col2.push(tableOne.rows[x].cells[1].children[0].value);//alert("1>" + Pg2Pt4S3_Col2);
            }
        }
	}

    function init() {

        //located in string-util.js
        getDrives();

