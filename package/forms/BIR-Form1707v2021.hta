		disableAndReset('txtPg2P4Sch1I1SellPrice', 'number');
		disableAndReset('txtPg2P4Sch1I2CostExpense', 'number');
		disableAndReset('txtPg2P4Sch1I3AssumMortgage', 'number');
		disableAndReset('txtPg2P4Sch1I4NumInstallments', 'zeroOnly');
		disableAndReset('txtPg2P4Sch1I5InstallmentAmt', 'number');
		disableAndReset('txtPg2P4Sch1I6ApplcRate', 'text');
		disableAndReset('txtPg2P4Sch1I7PeriodTaxDue', 'number');
		disableAndReset('txtPg2P4Sch1I8DateCollection', 'text');
		disableAndReset('txtPg2P4Sch1I9TotCollection', 'number');
		
		pageOneComputation();
	}
	
	function disableSchedTwo(){
		for (var i = 1 ; i <= 4; i++){
			disableAndReset('txtPg2P4Sch2NameOfCorpStock'+ i, 'text');
			disableAndReset('txtPg2P4Sch2NoOfShares'+ i, 'number');
			disableAndReset('txtPg2P4Sch2StockCertNo'+ i, 'text');
			disableAndReset('txtPg2P4Sch2TaxBaseSellPrice'+ i, 'number');
		}

		pageTwoSched2Comp();
	}
	
	function disableSchedThree(){
		for (var i = 1 ; i <= 4; i++){
			disableAndReset('txtPg2P4Sch3Particulars'+ i, 'text');
			disableAndReset('txtPg2P4Sch3Amount'+ i, 'number');
		}

		pageTwoSched3Comp();
	}

	function transactionType(){
		if (d.getElementById('frm1707:rdoPg1I9TransDescInstallment').checked == true){
			disableSchedTwo();
			disableSchedThree();
			enableSchedOne();

            d.getElementById("frm1707:txtPg2P4Sch1I6ApplcRate").value = 15.00;
            d.getElementById("frm1707:txtPg1P2I13AppTaxRate").value = "";
            d.getElementById("frm1707:txtPg1P2I13AppTaxRate").readOnly = true;
		}
		else {
			disableSchedOne();
			enableSchedTwo();
			enableSchedThree();

            d.getElementById("frm1707:txtPg2P4Sch1I6ApplcRate").value = "";
            d.getElementById("frm1707:txtPg1P2I13AppTaxRate").value = 15.00;
            d.getElementById("frm1707:txtPg1P2I13AppTaxRate").readOnly = true;
		}
	}

