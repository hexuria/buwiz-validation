				formatCurrency((NumWithComma(d.getElementById("frm1707:txtPg2P4Sch2TotAmount").value) * 1
				+ NumWithComma(d.getElementById("frm1707:txtPg2P4Sch2TaxBaseSellPrice" +row).value) * 1).toFixed(2));
		}
		
		pageOneComputation();
	}

