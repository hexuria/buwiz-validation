                elemVal = elemVal.replace(/[>]+/g, '&gt;');
                }                           
                else {
                elemVal = elem[i].value;
                }                       
                            
                allXML += "<"+elem[i].id+">"+elemVal+"</"+elem[i].id+">"+tab; //all select-one and text values
                }
