		for (var i = 1 ; i <= 1; i++){
			d.getElementById('frm1707:txtPg2P4Sch3Particulars'+ i).disabled = false;
			d.getElementById('frm1707:txtPg2P4Sch3Amount'+ i).disabled = false;
		}
	}

	function enableSchedTwoRow(element){
		var elemLength = element.name.length;
		var row = element.name.substring(elemLength-1, elemLength);
		
		var corpoName = '';
		var numOfShare = 0.00;
		var stockCertNo = '';
		var taxBaseSellPrice = 0.00;
		
		corpoName = d.getElementById('frm1707:txtPg2P4Sch2NameOfCorpStock' +row).value;
		numOfShare = NumWithComma(d.getElementById('frm1707:txtPg2P4Sch2NoOfShares' +row).value) * 1;
		stockCertNo = d.getElementById('frm1707:txtPg2P4Sch2StockCertNo' +row).value;
		taxBaseSellPrice = NumWithComma(d.getElementById('frm1707:txtPg2P4Sch2TaxBaseSellPrice' +row).value) * 1;

		if (row != 4 && corpoName != '' && stockCertNo != '' && numOfShare != 0.00 && taxBaseSellPrice != 0.00){
			row++;
			d.getElementById('frm1707:txtPg2P4Sch2NameOfCorpStock' +row).disabled = false;
			d.getElementById('frm1707:txtPg2P4Sch2NoOfShares' +row).disabled = false;
			d.getElementById('frm1707:txtPg2P4Sch2StockCertNo' +row).disabled = false;
			d.getElementById('frm1707:txtPg2P4Sch2TaxBaseSellPrice' +row).disabled = false;
			d.getElementById('frm1707:txtPg2P4Sch2NameOfCorpStock' +row).focus();
		}

	}

	function enableSchedThreeRow(element){
		var elemLength = element.name.length;
		var row = element.name.substring(elemLength-1, elemLength);
		
		var particulars = '';
		var amount = 0.00;
		
		particulars = d.getElementById('frm1707:txtPg2P4Sch3Particulars' +row).value;
		amount = NumWithComma(d.getElementById('frm1707:txtPg2P4Sch3Amount' +row).value) * 1;

		if (row != 4 && particulars != '' && amount != 0.00){
			row++;
			d.getElementById('frm1707:txtPg2P4Sch3Particulars' +row).disabled = false;
			d.getElementById('frm1707:txtPg2P4Sch3Amount' +row).disabled = false;
			d.getElementById('frm1707:txtPg2P4Sch3Particulars' +row).focus();
		}

	}

	function checkSellerRow(){		
		var rowCount = d.getElementById("tblSeller").rows.length;

		var name = '';
		var address = '';
		var TIN = '';

		d.getElementById('frm1707:txtPg1I6SellerName0').disabled = false;
		d.getElementById('frm1707:txtPg1I6SellerAddr0').disabled = false;
		d.getElementById('frm1707:txtPg1I6SellerTIN0').disabled = false;

		if (rowCount >= 1){
			for (var row = 0; row <= rowCount-1; row++){
				name = d.getElementById('frm1707:txtPg1I6SellerName' +row).value;
				address = d.getElementById('frm1707:txtPg1I6SellerAddr' +row).value;
				TIN = d.getElementById('frm1707:txtPg1I6SellerTIN' +row).value;

                if (isNaN(TIN)){
                    TIN = '';
                    d.getElementById('frm1707:txtPg1I6SellerTIN' +row).value = '';
                }
			
				if (row != rowCount-1 && name != '' && address != '' && TIN != ''){
					var ctr = row + 1;
					d.getElementById('frm1707:txtPg1I6SellerName' +ctr).disabled = false;
					d.getElementById('frm1707:txtPg1I6SellerAddr' +ctr).disabled = false;
					d.getElementById('frm1707:txtPg1I6SellerTIN' +ctr).disabled = false;
				}
			}
		}
		
	}

	function checkBuyerRow(){		
		var rowCount = d.getElementById("tblBuyer").rows.length;

		var name = '';
		var address = '';
		var TIN = '';

		d.getElementById('frm1707:txtPg1I7BuyerName0').disabled = false;
		d.getElementById('frm1707:txtPg1I7BuyerAddr0').disabled = false;
		d.getElementById('frm1707:txtPg1I7BuyerTIN0').disabled = false;

		if (rowCount >= 1){
			for (var row = 0; row <= rowCount-1; row++){
				name = d.getElementById('frm1707:txtPg1I7BuyerName' +row).value;
				address = d.getElementById('frm1707:txtPg1I7BuyerAddr' +row).value;
				TIN = d.getElementById('frm1707:txtPg1I7BuyerTIN' +row).value;

                if (isNaN(TIN)){
                    TIN = '';
                    d.getElementById('frm1707:txtPg1I7BuyerTIN' +row).value = '';
                }
			
				if (row != rowCount-1 && name != '' && address != '' && TIN != ''){
					var ctr = row + 1;
					d.getElementById('frm1707:txtPg1I7BuyerName' +ctr).disabled = false;
					d.getElementById('frm1707:txtPg1I7BuyerAddr' +ctr).disabled = false;
					d.getElementById('frm1707:txtPg1I7BuyerTIN' +ctr).disabled = false;
				}
			}
		}
		
	}

	$(document).ready(function(){
		$('.checkSchedTwo').blur(function(){
            enableSchedTwoRow(this);
			Check_Pg2Pt4S2();
        })
		
		$('.checkSchedThree').blur(function(){
            enableSchedThreeRow(this);
			Check_Pg2Pt4S3();
        })

	})

</script>

<!--to eFPS-->
<script>
    function submitOnline(){
        if(confirm("You will now be redirected to eFPS Online.")){
            submitToEFPS();
        }
    }

    function checkconnection() {
        var status = navigator.onLine;
        if (status) {
            return true;
        } else {
            return false;
        }
    }

    function submitToEFPS() {

        if (checkconnection()) {
            var formVersion = Form2200C.version;
            function getValue(stringId) {
                
                var alpha = document.getElementById(stringId).value;
                
                alpha = alpha.replace(/&/g, '&amp;');
                alpha = alpha.replace(/</g, '&lt;');
                alpha = alpha.replace(/>/g, '&gt;');
                
                return alpha;
                //if (!document.getElementById(stringId)) {
                //  console.error(stringId);
                //}
            }

            function convertDateXML(element) {
                //alert(d.getElementById('frm1707:'+element).value);
                var date = '';
                var dateSplit = d.getElementById('frm1707:' + element).value.split('/');
                var date = dateSplit[2] + '-' + dateSplit[0] + '-' + dateSplit[1];

                return date;
            }

            function getAmount(stringId) {
                return ((document.getElementById(stringId).value.indexOf(')') > 0 ? "-" : "") + document.getElementById(stringId).value.replace(/[\(\)\,]/gi, "")) * 1;
                //if (!document.getElementById(stringId)) {
                //  console.error(stringId);
                //  }
            }

            function fixAmount(elemValue) {
                return ((elemValue.indexOf(')') > 0 ? "-" : "") + elemValue.replace(/[\(\)\,]/gi, "")) * 1;
            }

            function returnPeriod() {
                var yyyyR = "20" + d.getElementById('frm1707:txtPg1I1Year').value;
                var mmR = (d.getElementById('frm1707:txtPg1I1Month').value.toString());
                var ddR = new Date(yyyyR, mmR, 0).getDate();
                var returnPeriodFormat = yyyyR + "-" + (mmR) + "-" + ddR;

                return returnPeriodFormat;
            }

            var endedyear = '20' + getValue("frm1707:txtPg1I1Year");
            populateTaxpayer(getValue("frm1707:txtPg1TIN4"), '',
        '', '', '', '',
        '', convertDateXML("txtPg1Pt1I8DateofIncorporation"), '', '', '', getValue("frm1707:txtPg1TIN1"),
        getValue("frm1707:txtPg1TIN2"), getValue("frm1707:txtPg1TIN3"), getValue("frm1707:ProfileAddress1"), '', '',
        returnPeriod(), getValue("frm1707:ProfileEmailAddr"), '', (document.getElementById("frm1707:rdoPg1I2AmendedYes").checked == true ? "Y" : "N"), '',
        '', (document.getElementById("frm1707:rdoPg1I4ShortPeriodYes").checked == true ? "Y" : "N"), (document.getElementById("frm1707:rdoPg1I5ATCR1C3").checked == true ? "IC011" : "IC021"),
        getValue("frm1707:txtPg1Pt2NumberofPagesFiled"), getValue("frm1707:ProfileContactNum"), '',
        '', /*(document.getElementById("frm1707:rdoPg1I1Calendar").checked == true ? "C" : "F"),*/ getValue("frm1707:txtPg1I1Month"), endedyear, getValue("frm1707:rdoPg1Pt1I5RDO"),
        /*getValue("frm1707:txtPg1Pt1I16RegisteredActivity"),*/ '', '', getValue("frm1707:ProfileName"), (document.getElementById("frm1707:rdoPg1CTC").checked == true ? "CTC" : "SEC"),
        (document.getElementById("frm1707:rdoPg1I2AmendedYes").checked == true ? "Y" : "N"), (document.getElementById("frm1707:rdoPg1I5ATCR1C3").checked == true ? "true" : "false"), /*(document.getElementById("frm1707:rdoPg1I5ATCR2C3").checked == true ? "true" : "false"),*/ convertDateXML("txtPg1Pt1I19EffectivityFrom"),
        convertDateXML("txtPg1Pt1I19EffectivityTo"), /*getValue("frm1707:txtPg1Pt1I14LegalBasis"), getValue("frm1707:txtPg1Pt1I15Investment"),*/
        '', '', '', formVersion);

            //alert(endedyear);
            //alert(getValue("frm1707:txtPg1I1Month"));
            populateTotalTaxPayable(
        getAmount("frm1707:txtPg1Pt2I20TotalIncome"),
        getAmount("frm1707:txtPg1Pt2I21AddPenalty"),
        getAmount("frm1707:txtPg7Sc9I19TotalFinalTax"),
        getValue("frm1707:txtPg1Pt2I23CommunityTax"),
        convertDateXML("txtPg1Pt1I24DateofIssue"),
        getValue("frm1707:txtPg1Pt1I25PlaceofIssue"),
        getAmount("frm1707:txtPg1Pt1I26Amount"),
        getAmount("frm1707:txtPg1Pt2I22TotalAmount"),
        getAmount("frm1707:txtPg7Sc10I8TotalIncome"));

            populateComputationOfTaxBean(getAmount("frm1707:txtPg2Pt4I32LessCost"),
