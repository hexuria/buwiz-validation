        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '1707v2021') {
            var fnVal = String(responseBG.innerHTML).split('fn=');
            d.getElementById('frm1707:ProfileName').value = unescape(fnVal[1]).toUpperCase();

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            //d.getElementById('frm1707:txtPg1TIN1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            // d.getElementById('frm1707:txtPg1TIN2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            //d.getElementById('frm1707:txtPg1TIN3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            //d.getElementById('frm1707:txtPg1TIN4').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            //d.getElementById('frm1707:txtPg1I5RDO').value = rdoVal[1];

            if (rdoVal != "") {
                //$('select[id="frm1707:rdoPg1Pt1I5RDO"] option[value = ' + rdoVal[1] + ']').attr("selected", "selected");
                //document.getElementById("frm1707:rdoPg1Pt1I5RDO").disabled = true;
            }

            //            var data = "<select id='frm1707:rdoPg1Pt1I5RDO' name='frm1707:rdoPg1Pt1I5RDO' disabled='disabled' size='1'><option value='" + rdoVal[1] + "' selected>" + rdoVal[1] + "</option>";
            //            $('#rdoContainer').html(data);
            //if(rdoVal != "")
            //d.getElementById('frm1707:rdoPg1Pt1I5RDO').value = rdoVal;

            // Store the value of Main Line of Business for the parent window (frm1707:txtPg1Pt1I13MainLine)
            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm1707:txtLOB').value = unescape(lobVal[1]);

            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
            regAddrVal[1] = unescape(regAddrVal[1].substring(0, regAddrVal[1].length));
            //if (regAddrVal[1].length > 80 && regAddrVal[1].length <= 160) {
			if (regAddrVal[1].length > 80) {
                d.getElementById('frm1707:ProfileAddress1').value = regAddrVal[1].substring(0, 80);
                //d.getElementById('frm1707:ProfileAddress2').value = regAddrVal[1].substring(80, regAddrVal[1].length);
				d.getElementById('frm1707:ProfileAddress2').value = regAddrVal[1].substring(80, 160);
            }
            else if (regAddrVal[1].length <= 80) {
                d.getElementById('frm1707:ProfileAddress1').value = regAddrVal[1];   
                d.getElementById('frm1707:ProfileAddress2').value = "";
            }

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            d.getElementById('frm1707:ProfileContactNum').value = telNoVal[1];

            var zipVal = String(responseBG.innerHTML).split('zip=');
            document.getElementById('frm1707:ProfileZipCode').value = zipVal[1];
            p3TPZip = zipVal[1];

            if (rdoVal[1] == "000") {
                d.getElementById('frm1707:rdoPg1Pt1I5RDO').disabled = false;
            }
                        
            //set TIN & TaxFiler's Name across the page
            var TIN1 = d.getElementsByName('frm1707:TIN1');
            var TIN2 = d.getElementsByName('frm1707:TIN2');
            var TIN3 = d.getElementsByName('frm1707:TIN3');
            var TIN4 = d.getElementsByName('frm1707:TIN4');
            TaxFiler = d.getElementsByName('frm1707:RegName');

            for (var i = 0; i < TIN1.length; i++) {
                TIN1[i].value = tin1Val[1];
                TIN2[i].value = tin2Val[1];
                TIN3[i].value = tin3Val[1];
                TIN4[i].value = tin4Val[1];
               // TaxFiler[i].value = fnVal[1].toUpperCase();
            }

            if(d.getElementById('frm1707:rdoPg1I9TransDescInstallment').checked == false && 
               d.getElementById("frm1707:txtPg1P2I13AppTaxRate").value == 0.00){
                    d.getElementById("frm1707:txtPg1P2I13AppTaxRate").value = 15.00;
