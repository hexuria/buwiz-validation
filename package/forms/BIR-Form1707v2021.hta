	}

    //Summation
    function Sum_Pg2Pt4S2() {
        var total = 0;
		var rowTaxDue = 0;

        numRows = d.getElementById("Pg2Pt4S2PopTable2nd").rows.length;
        table = d.getElementById("Pg2Pt4S2PopTable2nd");

        for (x = 0; x < numRows; x++) {
            total += removeCommaParenthesis(table.rows[x].cells[2].children[0].id) * 1;	
        }
		
        d.getElementById("Pg2Pt4S2SubTotal").disabled = true;
        d.getElementById("Pg2Pt4S2SubTotal").value = formatCurrency(total.toFixed(2));
        
        //d.getElementById("Pg2Pt4S2SubTotal").value = formatCurrency(NumWithComma(total).toFixed(2));
		
    }

</script>

