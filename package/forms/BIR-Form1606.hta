															<table border="0" cellpadding="0" cellspacing="0">
																<tbody><tr>
																	<td width="350"><font style="font-weight: bold;" size="2">&nbsp;27&nbsp;</font><font size="1">Fair Market Value (FMV) - Valuation at the time of the Contract</font></td>
