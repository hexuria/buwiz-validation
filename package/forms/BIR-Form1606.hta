                return;			
            }		
            
            if ( document.getElementById('frm1606:j_id395:_1').checked == true && document.getElementById('frm1606:txtFMVZonal').value <= 0 )
            {
                alert("Please provide a valid value for 27C.")
                return;			
            }
    
            if ( document.getElementById('frm1606:j_id395:_1').checked == true && document.getElementById('frm1606:txtFMVBIR').value <= 0 )
            {
