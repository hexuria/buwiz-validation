	    function saveBeforeExit() {
	        var y = confirm("Are you sure you want to exit?");
	        if (y) {
	            saveXML(false);
	            //saveXMLProfile(false);
	            try {
	                deleteTemp();
	                window.close(); self.close();
	            }
	            catch (err) {
