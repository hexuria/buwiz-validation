                return;			
            }*/

	        //if ( (document.getElementById('frm1606:opt27A').checked == true && document.getElementById('frm1606:opt27C').checked == true && document.getElementById('frm1606:opt27B').checked == false && document.getElementById('frm1606:opt27D').checked == false) || (document.getElementById('frm1606:opt27B').checked == true && document.getElementById('frm1606:opt27D').checked == true && document.getElementById('frm1606:opt27A').checked == false && document.getElementById('frm1606:opt27C').checked == false) )
