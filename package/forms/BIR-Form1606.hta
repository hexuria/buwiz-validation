                                    <table class="tblForm" style="height: 23px;" border="0" cellpadding="0" cellspacing="0" width="990">
                                        <tbody><tr>
											<td class="tblFormTd" valign="top" width="990">
												<table border="0" cellpadding="0" cellspacing="0" width="990">
													<tbody><tr>
														<td width="350">
															<table border="0" cellpadding="0" cellspacing="0">
																<tbody><tr>
																	<td width="350"><font style="font-weight: bold;" size="2">&nbsp;28&nbsp;</font><font size="1">Determination of Taxable Base&nbsp;</font></td>
																</tr>
															</tbody></table>
														</td>
                                                    </tr>
													<tr>
														<td>
															<font size="1">&nbsp;&nbsp;28A&nbsp;</font><input id="frm1606:opt28A" name="frm1606:opt28" onclick="document.getElementById('frm1606:txtGross').disabled = false;" type="radio"><label for="frm1606:opt28A:_1"> </label>
															<font style="" size="1">&nbsp;Gross Selling Price&nbsp;</font></td><td><input id="frm1606:txtGross" maxlength="40" name="frm1606:txtGross" style="text-align: right" size="20" value="0.00" onblur="round(this,2);computeTaxableBase()"  type="text"></td>
																								
														<td>
															<font size="1">&nbsp;28D&nbsp;</font><input id="frm1606:opt28D" name="frm1606:opt28" onclick="document.getElementById('frm1606:txtInstallment').disabled = false;" type="radio"><label for="frm1606:opt28D:_1"> </label>
															<font style="" size="1">&nbsp;Installment Collected (For &nbsp;Installment Sale excluding interest)&nbsp;</font></td><td><input id="frm1606:txtInstallment" style="text-align: right" maxlength="40" name="frm1606:txtInstallment" onblur="round(this,2);computeTaxableBase()"  size="20" value="0.00" type="text"></td>
														
													</tr>
													<tr>
														<td>
															<font size="1">&nbsp;&nbsp;28B&nbsp;</font><input id="frm1606:opt28B" name="frm1606:opt28" type="radio"><label for="frm1606:opt28B:_1"> </label>
															<font style="" size="1">&nbsp;Fair Market Value of Land and Improvement&nbsp;</font></td><td><input id="frm1606:txtFMVLI" maxlength="40" name="frm61606:txtFMVLI" style="text-align: right" size="20" value="0.00" onblur="round(this,2);computeTaxableBase()"  onmousemove="computeFMVLI()" type="text"></td>
														
														
                                                       	<td>
															<font size="1">&nbsp;&nbsp;28E&nbsp;</font><input id="frm1606:opt28E" name="frm1606:opt28" onclick="document.getElementById('frm1606:txtOthers28E').disabled = false;" type="radio"><label for="frm1606:opt28E:_1"> </label>
															<font style="" size="1">&nbsp;Others (Specify)&nbsp;</font></td><td><input id="frm1606:txtOtherss28E" maxlength="40" name="frm1606:txtOtherss28E" size="20" value="" type="text"></td><td><input id="frm1606:txtOthers28E" maxlength="40" name="frm1606:txtOthers28E" style="text-align: right" size="20" value="0.00" onblur="round(this,2);computeTaxableBase()" type="text"></td>
														
                                                    </tr>
													<tr>
														<td><font style="" size="1">&nbsp;&nbsp;(Sum of 27A &amp; 27B/ 27C &amp; 27D/ 27B &amp; 27C/27A &amp; 27D, whichever is higher)&nbsp;</font></td>
													</tr>
													<tr>
														<td>
															<font size="1">&nbsp;&nbsp;28C&nbsp;</font><input id="frm1606:opt28C" name="frm1606:opt28" onclick="document.getElementById('frm1606:txtBid').disabled = false;" type="radio"><label for="frm1606:opt28C:_1"> </label>
                                                            <font style="" size="1">&nbsp;Bid Price (For Foreclosure Sale)&nbsp;</font></td><td><input id="frm1606:txtBid" style="text-align: right" maxlength="40" name="frm1606:txtBid" size="20" value="0.00" onblur="round(this,2);computeTaxableBase()" type="text"></td>  
                                                        													
                                                    </tr>
												</tbody></table>
											</td>
                                        </tr>
                                    </tbody></table>
                                
                            
							
                            
                                <table class="tblForm" border="0" cellpadding="0" cellspacing="0" width="990">
                                    <tbody><tr>
                                        <td class="tblFormTd" valign="top" width="800">
                                            <table border="0" cellpadding="0" cellspacing="0" width="382">
                                                <tbody><tr>
                                                    <td width="382"><font style="font-weight: bold;" size="2">&nbsp;29&nbsp;</font><font size="1">Is
