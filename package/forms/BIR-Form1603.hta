    function blockletter(e) {
        var number = parseFloat(e.value).toFixed(2);
        if (isNaN(number)) {
            var zero = 0;
            e.value = parseFloat(zero).toFixed(2);
        } else {
            e.value = '' + number;
        }
    }

    function blockletterWithout2Decimal(e) {
        var number = parseFloat(e.value);
        if (isNaN(number)) {
            //var zero = 0;
            //e.value = parseFloat(zero).toFixed(2);
            e.value = "";
        } else {
            e.value = '' + number.toFixed(0);
        }
    }

    function validateYear() {

        if (d.getElementById("frm1603:txtYear").value > 2017) {
            alert("Please use newer version if you wish to file for year 2018 and up.");
            d.getElementById("frm1603:txtYear").value = "2017";
        }
    }

    function validateForm() {
        var dt = new Date();

        if ((d.getElementById('frm1603:txtYear').value == "")) {
            alert("Please enter a valid year on Item 1.");
            return;
        }
        /*if(d.getElementById('frm1603:txtYear').value*1 > dt.getFullYear()*1)
        {
            alert("Invalid date entry on Item no.1. Entry should not be later than Current Date.")
            return;
        }*/
        if (d.getElementById('frm1603:txtYear').value * 1 < 1900) {
            alert("Invalid date entry on Item no.1. Entry should not be lower than 1900.")
            return;
        }
        if (d.getElementById('frm1603:optQrtr:_1').checked == false && d.getElementById('frm1603:optQrtr:_2').checked == false
            && d.getElementById('frm1603:optQrtr:_3').checked == false && d.getElementById('frm1603:optQrtr:_4').checked == false) {
            alert("Please select quarter on Item 2.");
            return;
        }
        if (d.getElementById('frm1603:chk1st').checked == false && d.getElementById('frm1603:chk2nd').checked == false && d.getElementById('frm1603:chk3rd').checked == false) {
            alert("Please select month/s on Item 3.");
            return;
        }
        if (d.getElementById('frm1603:j_id252:_1').checked == false && d.getElementById('frm1603:j_id252:_2').checked == false) {
            alert("Please select an option for Item 5.")
            return;
        }

        if ((d.getElementById('frm1603:tinPart1').value == "" || d.getElementById('frm1603:tinPart2').value == "" || d.getElementById('frm1603:tinPart3').value == "" || d.getElementById('frm1603:branchCode').value == "")) {
            alert("Please enter a valid TIN number on Item 6.");
            return;
        }
        //if( (d.getElementById('frm1603:rdoCode').value == "")  )
        if ((d.getElementById('frm1603:rdoCode').selectedIndex == 0)) {
            alert("Please enter a valid RDO Code on Item 7.");
            return;
        }
        if ((d.getElementById('frm1603:description').value == "")) {
            alert("Please enter a valid Line of Business/Occupation on Item 8.");
            return;
        }
        if ((d.getElementById('frm1603:registeredName').value == "")) {
            alert("Please enter a valid Taxpayer Name on Item 9.");
            return;
        }
        if ((d.getElementById('frm1603:telephoneNumber').value == "")) {
            alert("Please enter a valid Telephone Number  on Item 10.");
            return;
        }
        if ((d.getElementById('frm1603:registeredAddress').value == "")) {
            alert("Please enter Taxpayer's Registered Address on Item 11.");
            return;
        }
        if ((d.getElementById('frm1603:zipCode').value == "")) {
            alert("Please enter Taxpayer's Zip Code on Item 12.");
            return;
        }

        if (d.getElementById('frm1603:j_id392:_1').checked == false && d.getElementById('frm1603:j_id392:_2').checked == false) {
            alert("Please select an option for Item 13.");
            return;
        }
        if (d.getElementById('frm1603:j_id252:_1').checked == true) {
            if (d.getElementById('frm1603:txt18A').value == 0) {
                alert("Please fill up Part 2.");
                return;
            }
        }


        d.getElementById('frm1603:cmdValidate').disabled = true;
        d.getElementById('frm1603:cmdEdit').disabled = false;
        d.getElementById('btnUpload').disabled = false;

        disabledControls();

        alert("Validation successful. Click on Edit if you wish to modify your entries.");
        return;
    }

