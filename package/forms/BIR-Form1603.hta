    var previousTW;
    function changeTaxWitheld(param) {
        if (confirm('Changing Item #5 will clear all computed data.\nDo you want to continue?')) {
            clearComputedData();

            previousTW = "frm1603:j_id252:_" + param;
        } else {
            if (previousTW != null) {
                d.getElementById(previousTW).checked = true;
            }
        }
    }

    function compute320() {
        d.getElementById('frm1603:txtBase320').value = formatCurrency((NumWithComma(d.getElementById('frm1603:txtFringe320').value) / 85) * 100);

        d.getElementById('frm1603:txtReq320').value = formatCurrency((NumWithComma(d.getElementById('frm1603:txtBase320').value) * 15) / 100);

        compute18Aand18B();
    }

    function compute330() {
        d.getElementById('frm1603:txtBase330').value = formatCurrency((NumWithComma(d.getElementById('frm1603:txtFringe330').value) / 75) * 100);

        d.getElementById('frm1603:txtReq330').value = formatCurrency((NumWithComma(d.getElementById('frm1603:txtBase330').value) * 25) / 100);

        compute18Aand18B();
    }

    function compute360() {
        d.getElementById('frm1603:txtBase360').value = formatCurrency((NumWithComma(d.getElementById('frm1603:txtFringe360').value) / 65) * 100);
        
        d.getElementById('frm1603:txtReq360').value  = formatCurrency((NumWithComma(d.getElementById('frm1603:txtBase360').value) * 35) / 100);
        // removed 04/24/2018 based on the new Bir-Form1603Q mark p.
        // if (d.getElementById('frm1603:txtFringe360').value != 0) {
        //     if (d.getElementById('frm1603:txtPercent').value == 0) {
        //         d.getElementById('frm1603:txtBase360').value = formatCurrency(NumWithComma(d.getElementById('frm1603:txtPercent').value) / NumWithComma(d.getElementById('frm1603:txtFringe360').value) * 100);
        //     } else {
        //         d.getElementById('frm1603:txtBase360').value = formatCurrency(NumWithComma(d.getElementById('frm1603:txtFringe360').value) / NumWithComma(d.getElementById('frm1603:txtPercent').value) * 100);
        //     }

        //     if (d.getElementById('frm1603:txtTaxRate').value == 0) {
        //         d.getElementById('frm1603:txtReq360').value = formatCurrency(NumWithComma(d.getElementById('frm1603:txtTaxRate').value) * NumWithComma(d.getElementById('frm1603:txtBase360').value) / 100);
        //     } else {
        //         d.getElementById('frm1603:txtReq360').value = formatCurrency(NumWithComma(d.getElementById('frm1603:txtBase360').value) * NumWithComma(d.getElementById('frm1603:txtTaxRate').value) / 100);
        //     }
        // }

        compute18Aand18B();
    }

    function compute18Aand18B() {
        d.getElementById('frm1603:txt18A').value = formatCurrency(NumWithComma(d.getElementById('frm1603:txtFringe320').value) * 1 + NumWithComma(d.getElementById('frm1603:txtFringe330').value) * 1 + NumWithComma(d.getElementById('frm1603:txtFringe360').value) * 1);
        d.getElementById('frm1603:txt18B').value = formatCurrency(NumWithComma(d.getElementById('frm1603:txtReq320').value) * 1 + NumWithComma(d.getElementById('frm1603:txtReq330').value) * 1 + NumWithComma(d.getElementById('frm1603:txtReq360').value) * 1);

        computeTaxStillDue();
    }

    function computeTaxStillDue() {
        d.getElementById('frm1603:txt20').value = formatCurrency(NumWithComma(d.getElementById('frm1603:txt18B').value) - NumWithComma(d.getElementById('frm1603:txt19').value));
        computeTotalTaxStillDue();
    }

    function computePenalties() {
        d.getElementById("frm1603:txt21D").value = formatCurrency(NumWithComma(d.getElementById("frm1603:txt21A").value) * 1 + NumWithComma(d.getElementById("frm1603:txt21B").value) * 1 + NumWithComma(d.getElementById("frm1603:txt21C").value) * 1);
        computeTotalTaxStillDue();
    }

    function computeTotalTaxStillDue() {
        d.getElementById('frm1603:txt22').value = formatCurrency(NumWithComma(d.getElementById('frm1603:txt20').value) * 1 + NumWithComma(d.getElementById('frm1603:txt21D').value) * 1);
        capital();
    }

    function initialValidateBeforeSave() {
        if (d.getElementById('frm1603:optQrtr:_1').checked == false && d.getElementById('frm1603:optQrtr:_2').checked == false
            && d.getElementById('frm1603:optQrtr:_3').checked == false && d.getElementById('frm1603:optQrtr:_4').checked == false) {
            alert("Please select quarter on Item 2.");
            return false;
        }
        if ((d.getElementById('frm1603:tinPart1').value == "" || d.getElementById('frm1603:tinPart2').value == "" || d.getElementById('frm1603:tinPart3').value == "" || d.getElementById('frm1603:branchCode').value == "")) {
            alert("Please enter a valid TIN number on Item 6.");
            return false;
        }
        if ((d.getElementById('frm1603:rdoCode').value == "000")) {
            alert("Please enter a valid RDO Code on Item 7.");
            return false;
        }
        if ((d.getElementById('frm1603:registeredName').value == "")) {
            alert("Please enter a valid Withholding Agent's Name on Item 9.");
            return false;
        }
        return true;
    }

    function clearYearData(yearValue) {
        if (yearValue != "") {
            if (confirm('Changing the return period will clear all computed data.\nDo you want to continue?')) {
                clearComputedData();
            } else {
                d.getElementById('frm1603:txtYear').value = yearValue;
            }
        }
    }

