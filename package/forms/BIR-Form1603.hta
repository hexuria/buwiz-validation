        d.getElementById('frm1603:txtBase360').value = formatCurrency(0.00);
        // d.getElementById('frm1603:txtTaxRate').value = 0;
        d.getElementById('frm1603:txtReq360').value = formatCurrency(0.00);

        d.getElementById('frm1603:txt18A').value = formatCurrency(0.00);
        d.getElementById('frm1603:txt18B').value = formatCurrency(0.00);

        d.getElementById('frm1603:txt19').value = formatCurrency(0.00);
        d.getElementById('frm1603:txt20').value = formatCurrency(0.00);
        d.getElementById('frm1603:txt21A').value = formatCurrency(0.00);
        d.getElementById('frm1603:txt21B').value = formatCurrency(0.00);
        d.getElementById('frm1603:txt21C').value = formatCurrency(0.00);
        d.getElementById('frm1603:txt21D').value = formatCurrency(0.00);
        d.getElementById('frm1603:txt22').value = formatCurrency(0.00);
    }

