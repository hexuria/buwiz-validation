function createXMLProfileName() {
	try {
	    var xmlFileName = "";
		
	    var titleTin1 = d.getElementById('frm1706:txtTIN1');
	    var titleTin2 = d.getElementById('frm1706:txtTIN2');
		var titleTin3 = d.getElementById('frm1706:txtTIN3');
		var titleBranchCode = d.getElementById('frm1706:txtBranchCode');	
		var titleTPName = d.getElementById('frm1706:txtSellerName');	
		var formType = "1706";		
		
		xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";		
	
		return xmlFileName;
	} catch(e) {
		alert('Exception : '+e.description);
	}	
}	
	
function saveXMLProfile(isFinalCopy) {	
	if (gIsReadOnly == false) {
	   var xmlFileName = createXMLProfileName();
	
		msg.innerHTML='Generating File...';
		var fileSys = new ActiveXObject("Scripting.FileSystemObject");
		var xmlFile=fileSys.CreateTextFile(xmlFileName); //(saveWhere);

		var allXML = "<?xml version='1.0'?>",tab=d.getElementById('xmlFormat').innerHTML;
		allXML += tab; //adds line break			
		
		allXML += "<div>fn="+escape(d.getElementById('frm1706:txtSellerName').value)+"fn=</div>"+tab;
		allXML += "<div>tin1="+d.getElementById('frm1706:txtTIN1').value+"tin1=</div>"+tab;
		allXML += "<div>tin2="+d.getElementById('frm1706:txtTIN2').value+"tin2=</div>"+tab;
		allXML += "<div>tin3="+d.getElementById('frm1706:txtTIN3').value+"tin3=</div>"+tab;
		allXML += "<div>tin4="+d.getElementById('frm1706:txtBranchCode').value+"tin4=</div>"+tab;	
		allXML += "<div>rdo="+d.getElementById('frm1706:txtRDOCode').value+"rdo=</div>"+tab;		
		allXML += "<div>lob=lob=</div>"+tab;		
		allXML += "<div>regAddr="+escape(d.getElementById('frm1706:txtSellerAddress').value)+"regAddr=</div>"+tab;	
		allXML += "<div>zip=zip=</div>"+tab;				
		allXML += "<div>telNo=telNo=</div>"+tab;	
		allXML += "<div>email="+document.getElementById('txtEmail').value+"email=</div>"+tab;allXML += "<div>confirmemail="+document.getElementById('txtEmail').value+"confirmemail=</div>"+tab;
		allXML += "<div>confirmtin1=" + d.getElementById('frm1706:txtTIN1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm1706:txtTIN2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm1706:txtTIN3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm1706:txtBranchCode').value + "confirmtin4=</div>" + tab;
		allXML += "<div>formType=1706formType=</div>"+tab;			
		
		allXML += tab+d.getElementById('xmlClose').innerHTML;
		
		xmlFile.write(allXML);
		xmlFile.close();
		msg.innerHTML = '';
		
		if (isFinalCopy == false) {
		alert('Background information saved/updated successfully as : '+xmlFileName);
		}	
	}	
}
