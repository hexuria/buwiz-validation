    function checkDate(dateID)
    {
        
      //  var d = new Date(01/02/2019); 
        var dt = new Date(dateID);
        var monthNum;
        var actualMonth = "test month";
        if (Object.prototype.toString.call(dt)=== "[object Date]") 
            { 
                if (isNaN(dt.getTime())) {  
                    //alert("Invalid Date."); 
                } 
                else { 
                    monthNum = dt.getMonth()+1;
                    //alert(dt.getMonth()+1);
                        if(monthNum===1){
                            actualMonth = "January";
                        }else if(monthNum===2){
                            actualMonth = "February";
                        }else if(monthNum===3){
                            actualMonth = "March";
                        }else if(monthNum===4){
                            actualMonth = "April";
                        }else if(monthNum===5){
                            actualMonth = "May";
                        }else if(monthNum===6){
                            actualMonth = "June";
                        }else if(monthNum===7){
                            actualMonth = "July";
                        }else if(monthNum===8){
                            actualMonth = "August";
                        }else if(monthNum===9){
                            actualMonth = "September";
                        }else if(monthNum===10){
                            actualMonth = "October";
                        }else if(monthNum===11){
                            actualMonth = "November";
                        }else if(monthNum===12){
                            actualMonth = "December";
                        }
                        alert("Please enter any of the following details TRA/eROR/eAR Number for the "+actualMonth+". You may refer to your 1601-FQ for the said quarter.");
                } 
            } 
     
    }



