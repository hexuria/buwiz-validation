	//Final Copy Button:
	function openAlertEmail() {       
		var tinNumber = $('#frm1604f\\:tinA').val() + $('#frm1604f\\:tinB').val() + $('#frm1604f\\:tinC').val();
		conService.initConConfig(tinNumber, '1604F');
