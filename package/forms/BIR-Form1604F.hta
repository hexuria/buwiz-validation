    function computeTotal(sched)
    {
        var total = 0;
        /*if(sched == '1'){
            var x = 1;
            var amt = 0;
            while(x <= 12){
                amt = NumWithComma(d.getElementById('frm1604f:txtSched' + sched + 'TotalAmt' + x).value);
                if(amt > 0){
                    total = (total*1) + (amt*1);
                }
                x++;
            }
        }else {
            total = (NumWithComma(d.getElementById('frm1604f:txtSched' + sched + 'TaxWheldTotal').value)*1) + (NumWithComma(d.getElementById('frm1604f:txtSched' + sched + 'PenTotal').value)*1);
        }*/
		
        total = (NumWithComma(d.getElementById('frm1604f:txtSched' + sched + 'TaxWheldTotal').value)*1) + (NumWithComma(d.getElementById('frm1604f:txtSched' + sched + 'PenTotal').value)*1);
        d.getElementById('frm1604f:txtSched' + sched + 'Total').value = formatCurrency(total);
		capital();
    }

