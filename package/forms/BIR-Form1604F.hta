    function computeTotalWithheld(sched)
    {
        var x = 1;
        var totalWithheld = 0;
        
		while(x <= 4){
                totalWithheld = (totalWithheld*1) + (NumWithComma(d.getElementById('frm1604f:txtSched' + sched + 'TaxWheld' + x).value)*1);

                x++;
            }
		
		/*if(sched == '4'){
            while(x <= 4){
                totalWithheld = (totalWithheld*1) + (NumWithComma(d.getElementById('frm1604f:txtSched' + sched + 'TaxWheld' + x).value)*1);

                x++;
            }
        }else {
            while(x <= 12){
                totalWithheld = (totalWithheld*1) + (NumWithComma(d.getElementById('frm1604f:txtSched' + sched + 'TaxWheld' + x).value)*1);

                x++;
            }
        }*/
        d.getElementById('frm1604f:txtSched' + sched + 'TaxWheldTotal').value = formatCurrency(totalWithheld);

        computeTotal(sched);
    }

