            $('input').each(function () {
                if (this.type == 'button') {
                    if (this.id != 'test') {
                        $(this).removeClass('previewButtonClass');
                    }
                }
            });

            $('a').each(function () {
                if (this.id.length > 1) {
                    if (d.getElementById('frm1702EX:btnValidate').disabled == false) {
                        if (enableElem) {
                            d.getElementById(this.id).disabled = true;
                        }
                        else if (disableElem) {
                            d.getElementById(this.id).disabled = false;
                        }
