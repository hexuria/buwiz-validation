                // refer to SRS for this part
                d.getElementById('frm1702EX:txtPg1I2YearEnd').disabled = true;
                d.getElementById('frm1702EX:ddlPg1I2Date').disabled = true;
            }
            d.getElementById('mnuPrint').disabled = false;
        }
        else if (globalcancelModalInit == 1) {

            $('#bg').show();
            $('#' + globalcurrentDiv).removeClass();
            $('#' + globalcurrentDiv).addClass("modalShow");


            $('input').each(function () {
                if (this.type == 'button') {
                    if (this.id != 'test') {
                        $(this).removeClass('previewButtonClass');
                    }
                }
            });

            $('a').each(function () {
                if (this.id.length > 1) {
                    if (document.getElementById('frm1702EX:btnValidate').disabled == false) {
                        if (enableElem) {
                            document.getElementById(this.id).disabled = true;
                        }
                        else if (disableElem) {
