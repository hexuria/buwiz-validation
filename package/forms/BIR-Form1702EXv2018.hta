    var rdoList = new Array();

    var XMLrdoFile = ''; //Object Type

    var rdoCount = 0;

    function loadXMLrdo(fileLocation) {
        try {
            //This will load the Region file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLrdoFile = fsoXML.OpenTextFile(fileLocation, 1);

            if (XMLrdoFile.AtEndOfStream)
                data = "";
            else {
                var responseRdo = d.getElementById('responseRdo'); //render file and write to hidden div
                responseRdo.innerHTML = XMLrdoFile.ReadAll(); //remove XML tag
                //responseRdo = replaceHtml(responseRdo, XMLrdoFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
            }
            XMLrdoFile.Close(); //alert( responseRdo.innerHTML ); //Debug           
            loadRdo(); /*This will load ATC onto an array*/
        } catch (e) {
            msg.innerHTML = ""; //"Region File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadRdo() {
        /*This will load data onto an array*/
        var response = document.getElementById("responseRdo");

        var rdoCnt = String(response.innerHTML).split('rdoCount=');
        rdoCount = rdoCnt[1];

        var k = 0;
        //loads rdoList from xml
        for (var i = 1; i <= rdoCount; i++) {
            var rdo = String(response.innerHTML).split('rdo' + i + ':');
            var rdoStr = rdo[1];

            //Ensure that before writing to rdoPropertyJS the formType 1702EX is traceable in rdoStr
            if (rdoStr.indexOf('1702EX') >= 0) {
                var rdoValues = rdoStr.split('~');
                var rdoCode = rdoValues[0];
                var description = rdoValues[1];

                var objRdo = new rdoPropertyJS(rdoCode, description);
                rdoList[k] = objRdo;
                k++;
            } else {
                //alert('1702EX not found in array #'+i);
                continue;
            }
        }

    }

    function rdoPropertyJS(rdoCode, description) {
        this.rdoCode = rdoCode;
        this.description = description;
    }

    function getRdo() {

        var data = "<select id='frm1702EX:rdoPg1Pt1I7RDO' name='frm1702EX:rdoPg1Pt1I7RDO' size='1'><option value='000'>000</option>";

        for (var i = 0; i < rdoList.length; i++) {
            var rdo = rdoList[i];
            data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";
        }
        data = data + "</select>"

        //var data = "<select id='frm1702EX:rdoPg1Pt1I7RDO' name='frm1702EX:rdoPg1Pt1I7RDO' size='1'><option value='000'> </option>";
        $('#rdoContainer').html(data);

    }

    // load profile.xml
    function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = "";
            } else {
                var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag            
            }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug                
            loadBGData(); /*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = "";
        }
    }

    // load data on controls based on profile.xml
    function loadBGData() {
        /*This will load data onto Background Information fields*/
        var responseBG = d.getElementById("responseBG");

        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '1702EXv2018') {
            var fnVal = String(responseBG.innerHTML).split('fn=');
            //d.getElementById('frm1702EX:txtPg1Pt1I8RegisteredName').value = unescape(fnVal[1]);

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            //d.getElementById('frm1702EX:txtPg1Pt1I6TINC1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            // d.getElementById('frm1702EX:txtPg1Pt1I6TINC2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            //d.getElementById('frm1702EX:txtPg1Pt1I6TINC3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            //d.getElementById('frm1702EX:txtPg1Pt1I6TINC4').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm1702EX:hdnPg1Pt1I7RDO').value = rdoVal[1];

            if (rdoVal != "") {
                $('select[id="frm1702EX:rdoPg1Pt1I7RDO"] option[value = ' + rdoVal[1] + ']').attr("selected", "selected");
                document.getElementById("frm1702EX:rdoPg1Pt1I7RDO").disabled = true;
            }

            //            var data = "<select id='frm1702EX:rdoPg1Pt1I7RDO' name='frm1702EX:rdoPg1Pt1I7RDO' disabled='disabled' size='1'><option value='" + rdoVal[1] + "' selected>" + rdoVal[1] + "</option>";
            //            $('#rdoContainer').html(data);
            //if(rdoVal != "")
            //d.getElementById('frm1702EX:rdoPg1Pt1I7RDO').value = rdoVal;

            // Store the value of Main Line of Business for the parent window (frm1702EX:txtPg1Pt1I13MainLine)
            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm1702EX:txtLOB').value = unescape(lobVal[1]);

            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
            regAddrVal[1] = unescape(regAddrVal[1].substring(0, regAddrVal[1].length));
            if (regAddrVal[1].length > 160) {
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress').value = regAddrVal[1].substring(0, 80);
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress2').value = regAddrVal[1].substring(80, 160);
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress3').value = regAddrVal[1].substring(160, regAddrVal[1].length);
            }
            else if (regAddrVal[1].length > 80 && regAddrVal[1].length <= 160) {
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress').value = regAddrVal[1].substring(0, 80);
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress2').value = regAddrVal[1].substring(80, regAddrVal[1].length);
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress3').value = "";
            }
            else if (regAddrVal[1].length <= 80) {
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress').value = regAddrVal[1];   
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress2').value = "";
                d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress3').value = "";
            }

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            d.getElementById('frm1702EX:txtPg1Pt1I11ContactNumber').value = telNoVal[1];

            var zipVal = String(responseBG.innerHTML).split('zip=');
            document.getElementById('frm1702EX:txPg1I9ZipCode').value = zipVal[1];
            p3TPZip = zipVal[1];

            if (rdoVal[1] == "000") {
                d.getElementById('frm1702EX:rdoPg1Pt1I7RDO').disabled = false;
            }
            
            fnVal[1] = unescape(fnVal[1].substring(0, fnVal[1].length)).toUpperCase();
            if (fnVal[1].length > 120) {
                d.getElementById('frm1702EX:RegName').value = fnVal[1].substring(0, 60);
                d.getElementById('frm1702EX:RegName2').value = fnVal[1].substring(60, 120);
                d.getElementById('frm1702EX:RegName3').value = fnVal[1].substring(120, fnVal[1].length);
            }
            else if (fnVal[1].length > 60 && fnVal[1].length <= 120) {
                d.getElementById('frm1702EX:RegName').value = fnVal[1].substring(0, 60);
                d.getElementById('frm1702EX:RegName2').value = fnVal[1].substring(60, fnVal[1].length);
                d.getElementById('frm1702EX:RegName3').value = "";
            }
            else if (fnVal[1].length <= 60){
                d.getElementById('frm1702EX:RegName').value = fnVal[1]; 
                d.getElementById('frm1702EX:RegName2').value = "";
                d.getElementById('frm1702EX:RegName3').value = "";
            }
            
            //set TIN & TaxFiler's Name across the page
            var TIN1 = d.getElementsByName('frm1702EX:TIN1');
            var TIN2 = d.getElementsByName('frm1702EX:TIN2');
            var TIN3 = d.getElementsByName('frm1702EX:TIN3');
            var TIN4 = d.getElementsByName('frm1702EX:TIN4');
            TaxFiler = d.getElementsByName('frm1702EX:RegName');

            for (var i = 0; i < TIN1.length; i++) {
                TIN1[i].value = tin1Val[1];
                TIN2[i].value = tin2Val[1];
                TIN3[i].value = tin3Val[1];
                TIN4[i].value = tin4Val[1];
               // TaxFiler[i].value = fnVal[1].toUpperCase();
            }
        }
        var emailVal = String(responseBG.innerHTML).split('email=');
            if(emailVal[1] === undefined)
            {
                document.getElementById('frm1702EX:txtPg1Pt1I12Email').value = "";
            }
            else
            {
                document.getElementById('frm1702EX:txtPg1Pt1I12Email').value = emailVal[1];
                globalEmail = emailVal[1];
            }
    }

