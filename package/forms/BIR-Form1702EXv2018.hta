		if (( (d.getElementById("frm1702EX:txtPg3Pt6S2I4Description").value == "" || d.getElementById("frm1702EX:txtPg3Pt6S2I4LegalBasis").value == "") 
			&& d.getElementById("frm1702EX:txtPg3Pt6S2I4Amount").value > "0.01" )
			||
			( (d.getElementById("frm1702EX:txtPg3Pt6S2I4Description").value != "" && d.getElementById("frm1702EX:txtPg3Pt6S2I4LegalBasis").value == "") 
			&& d.getElementById("frm1702EX:txtPg3Pt6S2I4Amount").value < "0.01" )
			||
			( (d.getElementById("frm1702EX:txtPg3Pt6S2I4Description").value == "" && d.getElementById("frm1702EX:txtPg3Pt6S2I4LegalBasis").value != "") 
			&& d.getElementById("frm1702EX:txtPg3Pt6S2I4Amount").value < "0.01" )){
