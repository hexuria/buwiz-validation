        cell2.innerHTML = '<td class="tblFormTd" align="center" style="width:30%;"><input type="text" onfocus="onFocusIterate(this)"  onkeypress="return Code(this)" onblur="return capitalize(this), onBlurIterate(this)" maxlength="20" size="25" id="frm1702EX:txtPg3Pt6S2I4_' + (i + 1) + 'Col2"/></td>';
