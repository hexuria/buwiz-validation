            // alert(counter);
            for (var i = 0; i < counter; i++) {
                AddRow_Pg3Pt6S3I3PopTable();
            }
        }
        
        if ((response.innerHTML).indexOf('Pg3Pt6S3I6PopLength') != -1) {
