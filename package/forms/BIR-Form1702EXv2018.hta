		//Page 3 Schedule 2
		for (var i = 1; i <= 4; i++){
			disableAndReset('txtPg3Pt6S2I'+i+'Description', 'text');
			disableAndReset('txtPg3Pt6S2I'+i+'LegalBasis', 'text');
			disableAndReset('txtPg3Pt6S2I'+i+'Amount', 'number');
		}
		d.getElementById('btnPg3Pt6S2I4More').disabled = true;
		Pg3Pt6S2I4_Col1 = new Array();
		Pg3Pt6S2I4_Col2 = new Array();
		Pg3Pt6S2I4_Col3 = new Array();
		FormatAmount('totalSpecAllowedItemDeduc');

		compTaxReliefAvail();
	}

