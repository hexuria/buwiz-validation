            }*/
            {
                if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
                    if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                        if (elem[i].id == 'frm1702EX:txtPg1Pt1I8RegisteredName') {
                            allXML += "<div>" + elem[i].id + "=" + escape(elem[i].value) + elem[i].id + "=</div>" + tab;
                            p3TPName = escape(elem[i].value);
                        }
                        else if (elem[i].id == 'frm1702EX:txtPg1Pt1I13MainLine') {
                            allXML += "<div>" + elem[i].id + "=" + escape(elem[i].value) + elem[i].id + "=</div>" + tab;
                            p3TPLineBus = escape(elem[i].value);
                        }
                        else if (elem[i].id == 'frm1702EX:txtPg1Pt1I9RegisteredAddress') {
                            allXML += "<div>" + elem[i].id + "=" + escape(elem[i].value) + elem[i].id + "=</div>" + tab;
                            p3TPAddress = escape(elem[i].value);
                        }
                        
                        //TIN, branchCode, rdoCode, TPClass, LOB, TPName, TelNo, Addr, Zip
                        else if (elem[i].id == 'frm1702EX:txtPg1Pt1I11ContactNumber') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTelNum = elem[i].value;
                        } else if (elem[i].id == 'frm1702EX:txtPg1Pt1I6TINC1') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN1 = elem[i].value;
                        } else if (elem[i].id == 'frm1702EX:txtPg1Pt1I6TINC2') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN2 = elem[i].value;
                        } else if (elem[i].id == 'frm1702EX:txtPg1Pt1I6TINC3') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPTIN3 = elem[i].value;
                        } else if (elem[i].id == 'frm1702EX:txtPg1Pt1I6TINC4') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPBranchCode = elem[i].value;
                        }
                        else if (elem[i].id == 'frm1702EX:hdnPg1Pt1I7RDO') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPRDOCode = elem[i].value;
                        }
                        else if (elem[i].id == 'frm1702EX:txPg1I9ZipCode') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                            p3TPZip = elem[i].value;
                            //alert("3==" + p3TPZip);
                        }
                        else if (elem[i].maxLength == '12' || elem[i].maxLength == '15') {
                            var elemValue = elem[i].value;
                               
                            if (elem[i].value.toString().indexOf('(') != -1 && elem[i].value.toString().indexOf(')') != -1) {
                                elemValue = NumWithParenthesis(elemValue);
                                    
                                if (elem[i].value.toString().indexOf(',') != -1) {
                                elemValue = elemValue.replace(/,/g, '');
                                }
                            }
                            else if (elem[i].value.toString().indexOf(',') != -1) {
                                elemValue = elemValue.replace(/,/g, '');
                            }

                            if (elem[i].id == 'frm1702EX:txtPg1Pt2I21AddPenalty') {
                                p3Compromise = elemValue;
                            } else if (elem[i].id == 'frm1702EX:txtPg1Pt2I20TotalIncome') {
                                p3BasicTax = elemValue;
                            } else if (elem[i].id == 'frm1702EX:txtPg1Pt2I21AddPenalty') {
                                p3TotalPenalties = elemValue;
                            } else if (elem[i].id == 'frm1702EX:txtPg1Pt2I22TotalAmount') {
                                p3TotalAmountPayable = elemValue;
                            } else if (elem[i].id == 'frm1702EX:txtPg2Pt4I31NetSales') {
                                //alert("p3GrossSales >>> " + elemValue + " \r\n p3BasicTax >>> " + p3BasicTax);
                                p3GrossSales = elemValue;
                            }

                            allXML += "<div>" + elem[i].id + "=" + elemValue + elem[i].id + "=</div>" + tab; //all numeric text values
                        }
                        else {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab; //all select-one and text values
                        }
                    }
                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        allXML += "<div>" + elem[i].id + "=" + elem[i].checked + elem[i].id + "=</div>" + tab; //all radio and checkbox values          
                        
                        if (d.getElementById('frm1702EX:rdoPg1I3AmendedYes').checked == true) {
                            p3IsAmended = "Yes";
                        } else if (d.getElementById('frm1702EX:rdoPg1I3AmendedNo').checked == true) {
                            p3IsAmended = "No";
                        }
                    }
                }
            }
            p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;
            /*--------------------- follow this format for parsing --------------------------- */

            if (submit) {
                allXML += tab + d.getElementById('xmlClose').innerHTML + "0";
            } else {
                allXML += tab + d.getElementById('xmlClose').innerHTML;
            }

            //Phase 3: This 'savefile' will be uploaded to IAF Infra for DI processing
            savedReturn = allXML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (submit == false) {
                alert('BIR Form saved successfully as : ' + xmlFileName);
            }
        }
        return true;
    }

    function validate() {

        if (validateAll()) {
            alert("Validation successful. Click on Edit if you wish to modify your entries.");
            getDisabledText();
            disableAllControl();
            document.getElementById("frm1702EX:btnEdit").disabled = false;
            document.getElementById("btnUpload").disabled = false;
            document.getElementById("frm1702EX:btnFinalCopy").disabled = false;
            document.getElementById("frm1702EX:btnValidate").disabled = true;
            document.getElementById("frm1702EX:btnPrevPage").disabled = false;
            document.getElementById("frm1702EX:btnNextPage").disabled = false;
            document.getElementById("btnSave").disabled = false;
            document.getElementById("btnPg3Pt6S1I17More").disabled = false;
            document.getElementById("btnPg3Pt6S2I4More").disabled = false;
            document.getElementById("btnPrint").disabled = false;
            document.getElementById("btnCancelSubmit").disabled = false;
            document.getElementById("CloseGuidlinesPage").disabled = false;    
            d.getElementById('mnuPrint').disabled = false;
            document.getElementById("ebironline").disabled = false;
            document.getElementById("efps").disabled = false;
            //document.onmouseup();
            return;
        }
        else {
            document.getElementById("frm1702EX:btnEdit").disabled = true;
            document.getElementById("btnUpload").disabled = true;
            document.getElementById("frm1702EX:btnFinalCopy").disabled = true;
            document.getElementById("btnPrint").disabled = true;
            d.getElementById('mnuPrint').disabled = true;
        };
        
    }

    function initialValidateBeforeSave() {
        //validation here
        //return true to save
        if (d.getElementById('frm1702EX:rdoPg1Pt1I7RDO').value === "000") { alert("Please enter a valid RDO Code on Item 7."); return false; }
        if (!checkMandatory("frm1702EX:txtPg1Pt1I8RegisteredName", "Please enter a valid name on Page 1 Item 8")) return false;
        if (!checkMandatory("frm1702EX:txtPg1Pt1I9RegisteredAddress", "Please enter a valid Registered Address on Page 1 Item 9.")) return false;
        if (!checkMandatory("frm1702EX:txtPg1Pt1I11ContactNumber", "Please enter a valid Contact Number on Page 1 Item 11")) return false;

        return true;
    }

    //topNav
    $(document).ready(function () {

        $("ul.subnav").parent().append("<span></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)  
        $("ul.topnav li span").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
        $("ul.topnav .toplevel").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
    });


    function createXMLProfileName() {
        try {
            var xmlFileName = "";

            var titleTin1 = d.getElementById('frm1702EX:txtPg1Pt1I6TINC1');
            var titleTin2 = d.getElementById('frm1702EX:txtPg1Pt1I6TINC2');
            var titleTin3 = d.getElementById('frm1702EX:txtPg1Pt1I6TINC3');
            var titleBranchCode = d.getElementById('frm1702EX:txtPg1Pt1I6TINC4');
            var titleTPName = d.getElementById('frm1702EX:txtPg1Pt1I8RegisteredName');
            var formType = "1702EXv2018";

            xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";

            return xmlFileName;
        } catch (e) {
            alert('Exception : ' + e.description);
        }
    }

    function saveXMLProfile(isFinalCopy) {
        if (gIsReadOnly == false) {
            var xmlFileName = createXMLProfileName();

            msg.innerHTML = 'Generating File...';
            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFile = fileSys.CreateTextFile(xmlFileName); //(saveWhere);

            var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break            

            allXML += "<div>fn=" + escape(d.getElementById('frm1702EX:txtPg1Pt1I8RegisteredName').value) 
                                 + escape(d.getElementById('frm1702EX:txtPg1Pt1I8RegisteredName2').value)
                                 + escape(d.getElementById('frm1702EX:txtPg1Pt1I8RegisteredName3').value) + "fn=</div>" + tab;
            allXML += "<div>tin2=" + d.getElementById('frm1702EX:txtPg1Pt1I6TINC2').value + "tin2=</div>" + tab;
            allXML += "<div>tin3=" + d.getElementById('frm1702EX:txtPg1Pt1I6TINC3').value + "tin3=</div>" + tab;
            allXML += "<div>tin1=" + d.getElementById('frm1702EX:txtPg1Pt1I6TINC1').value + "tin1=</div>" + tab;
            allXML += "<div>tin4=" + d.getElementById('frm1702EX:txtPg1Pt1I6TINC4').value + "tin4=</div>" + tab;
            allXML += "<div>rdo=" + d.getElementById('frm1702EX:hdnPg1Pt1I7RDO').value + "rdo=</div>" + tab;
            allXML += "<div>lob=" + d.getElementById('frm1702EX:txtLOB').value + "lob=</div>" + tab;
            allXML += "<div>regAddr=" + escape(d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress').value)
                                      + escape(d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress2').value)
                                      + escape(d.getElementById('frm1702EX:txtPg1Pt1I9RegisteredAddress3').value)+ "regAddr=</div>" + tab;

            //No Zip for 1702EX, just get it from var p3TPZip
            allXML += "<div>zip=" + p3TPZip + "zip=</div>" + tab;

            allXML += "<div>telNo=" + d.getElementById('frm1702EX:txtPg1Pt1I11ContactNumber').value + "telNo=</div>" + tab;
            allXML += "<div>email="+document.getElementById('frm1702EX:txtPg1Pt1I12Email').value+"email=</div>"+tab;allXML += "<div>confirmemail="+document.getElementById('frm1702EX:txtPg1Pt1I12Email').value+"confirmemail=</div>"+tab;
            allXML += "<div>confirmtin1=" + d.getElementById('frm1702EX:txtPg1Pt1I6TINC1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm1702EX:txtPg1Pt1I6TINC2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm1702EX:txtPg1Pt1I6TINC3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm1702EX:txtPg1Pt1I6TINC4').value + "confirmtin4=</div>" + tab;
            allXML += "<div>formType=1702EXv2018formType=</div>" + tab;

            allXML += tab + d.getElementById('xmlClose').innerHTML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (isFinalCopy == false) {
                alert('Background information saved/updated successfully as : ' + xmlFileName);
            }
        }
    }
