        cell4.innerHTML = '<td class="tblFormTd" align="center" style="width:10%;"><input type="button" value="Remove" onclick="deleteRow(this),FixNumber_Pg3Pt6S2I4PopTable(), Sum_Pg3Pt6S2I4()"/></td></tr>';
    }

    //Summation
    function Sum_Pg3Pt6S2I4() {
        var total = 0;

        numRows = document.getElementById("Pg3Pt6S2I4PopTable").rows.length;
        table = document.getElementById("Pg3Pt6S2I4PopTable");

        for (x = 0; x < numRows; x++) {
            total += removeCommaParenthesis(table.rows[x].cells[2].children[0].id) * 1;
        }
        document.getElementById("Pg3Pt6S2I4SubTotal").disabled = true;
        document.getElementById("Pg3Pt6S2I4SubTotal").value = formatCurrency(total.toFixed(0));
    }
</script>

