                        if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                            if (elem[i].id == 'frm1702EX:txtPg1Pt1I8RegisteredName' || elem[i].id == 'frm1702EX:txtPg1Pt1I13MainLine' || elem[i].id == 'frm1702EX:txtPg1Pt1I9RegisteredAddress') {
