    function redirectToSchedule() {
        if (confirm("Schedules need to be filled up before Part II, IV and V can have values. Do you want to fill up the Schedules first? (Clicking on 'OK' will redirect you to Schedule 1)") === true) {
            document.getElementById("frm1702EX:txtCurrentPage").value = 3;
            goToPage();
        }
    }
    var globalEmail = "";
    function sleeptime() {
        //var delay = 0;

        init();


        var bgFileName = qs('xmlBGInfoFileName');
        if (bgFileName != null && bgFileName.indexOf('.xml') > -1) {
            loadBGXML(bgFileName);

            // delay = 600;
        }

        fileName = qs('xmlFileName');
        if (fileName != null && fileName.indexOf('.xml') > -1) {
            var tin = fileName.split("/")[1].split("-");
            loadBGXML("profile/"+ tin[0]+".xml");
            loadXML(fileName);
            existingXMLFileName = fileName;

            // delay = 2500;

            //Dev Note: This new function will be used for processing well-formed XML for Tax Software Provider (TSP)
            //XML file processing.  The parameter 'savefile/1602_wellformed.xml' should be replaced by RB with 
            //the xml file that came from the upload xml portal page.
            //loadXMLWellFormed("savefile/1701Q_wellformed.xml");   
            if (gIsReadOnly) {
                window.setTimeout("disableAllElementIDs(); d.getElementById('btnUpload').disabled = false; d.getElementById('btnPrint').disabled = false; d.getElementById('mnuPrint').disabled = false; document.getElementById('frm1702EX:btnPrevPage').disabled = false;"
            + " document.getElementById('frm1702EX:btnNextPage').disabled = false;", 1000);
            }


        } else {
            window.setTimeout("$('#loader').hide('blind');", 200);

            isNewEntry = true;

        }
        if ($('#printMenu').css('display') != 'none') {
            $('#printMenu').hide('blind');
        }

        enableEmptyMandatory();
        getDisabledText();
        loadToArray();
        checkMoreButtons();

        $('input[maxlength="12"]').each(function () {
            var currentId = $(this).attr('id');
            myvalue = FormatValue(document.getElementById(currentId).value);

            if (myvalue == "")
                myvalue = "0";

            document.getElementById(currentId).value = myvalue;

        });

        $('#sched7 input[maxlength="15"]').each(function () {
            var currentId = $(this).attr('id');
            myvalue = FormatValue(document.getElementById(currentId).value);

            if (myvalue == "")
                myvalue = "0";

            document.getElementById(currentId).value = myvalue;

        });

        //set pager to 1
        document.getElementById("frm1702EX:txtCurrentPage").value = "1";
        //check yearend for disabling month
        //checkFilingYear();

        //return capitalized from main

        //        document.getElementById("frm1702EX:txtPg1Pt1I8RegisteredName").setAttribute('value', document.getElementById("frm1702EX:txtPg1Pt1I8RegisteredName").getAttribute('value').toUpperCase());
        //        document.getElementById("frm1702EX:txtPg1Pt1I9RegisteredAddress").setAttribute('value', document.getElementById("frm1702EX:txtPg1Pt1I9RegisteredAddress").getAttribute('value').toUpperCase());
        //        document.getElementById("frm1702EX:txtPg1Pt1I13MainLine").setAttribute('value', document.getElementById("frm1702EX:txtPg1Pt1I13MainLine").getAttribute('value').toUpperCase());
        document.getElementById("frm1702EX:txtPg1Pt1I9RegisteredAddress").value = document.getElementById("frm1702EX:txtPg1Pt1I9RegisteredAddress").value.toUpperCase();
		document.getElementById("frm1702EX:txtPg1Pt1I9RegisteredAddress2").value = document.getElementById("frm1702EX:txtPg1Pt1I9RegisteredAddress2").value.toUpperCase();
		document.getElementById("frm1702EX:txtPg1Pt1I9RegisteredAddress3").value = document.getElementById("frm1702EX:txtPg1Pt1I9RegisteredAddress3").value.toUpperCase();
        
        var myNameValue = document.getElementById("frm1702EX:txtPg1Pt1I8RegisteredName").value;
        $("input[name='frm1702EX\:RegName']").val(myNameValue);
        // $("input[name='frm1702EX\:TIN4']").val("0000");
        if (document.getElementById("frm1702EX:rdoPg1I1Calendar").checked == true) {

            var currentDate = new Date();

            document.getElementById("frm1702EX:ddlPg1I2Date").disabled = true;
            document.getElementById("frm1702EX:txtPg1I2YearEnd").disabled = false;
            if (document.getElementById("frm1702EX:txtPg1I2YearEnd").value == "") {
                document.getElementById("frm1702EX:txtPg1I2YearEnd").value = (currentDate.getFullYear() - 2000) - 1;
            }
        }

        //setTimeout(function () { document.onmouseup(); }, 1000);
        window.setTimeout("checkFinalCopyBtn('1702EXv2018')", 2000);
    }

    function loadToArray() {
        //Part 6 Schedule 1 - Ordinary Allowable Itemized Deductions
        numRows = document.getElementById("Pg3Pt6S1I17PopTable").rows.length;
        table = document.getElementById("Pg3Pt6S1I17PopTable");

        Pg3Pt6S1I17_Col1 = new Array();
        Pg3Pt6S1I17_Col2 = new Array();

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                Pg3Pt6S1I17_Col1.push(table.rows[x].cells[0].children[1].value);
                Pg3Pt6S1I17_Col2.push(table.rows[x].cells[1].children[0].value);
            }
        }
        
        //Part 6 Schedule 2 - Special Allowable Itemized Deductions
        numRows = document.getElementById("Pg3Pt6S2I4PopTable").rows.length;
        table = document.getElementById("Pg3Pt6S2I4PopTable");

        Pg3Pt6S2I4_Col1 = new Array();
        Pg3Pt6S2I4_Col2 = new Array();
        Pg3Pt6S2I4_Col3 = new Array();

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                Pg3Pt6S2I4_Col1.push(table.rows[x].cells[0].children[1].value);
                Pg3Pt6S2I4_Col2.push(table.rows[x].cells[1].children[0].value);
                Pg3Pt6S2I4_Col3.push(table.rows[x].cells[2].children[0].value);
            }
        }
        
        //Start - Part 6 Schedule 3 - Reconciliation of Net Income per Books Against Taxable Income
        //Non-Deductible Expenses/Other Income
        numRows = document.getElementById("Pg3Pt6S3I3PopTable").rows.length;
        table = document.getElementById("Pg3Pt6S3I3PopTable");

        Pg3Pt6S3I3_Col1 = new Array();
        Pg3Pt6S3I3_Col2 = new Array();

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                Pg3Pt6S3I3_Col1.push(table.rows[x].cells[0].children[1].value);
                Pg3Pt6S3I3_Col2.push(table.rows[x].cells[1].children[0].value);
            }
        }
        
        //Non-Taxable Income and Income Subjected to Final Tax
        numRows = document.getElementById("Pg3Pt6S3I6PopTable").rows.length;
        table = document.getElementById("Pg3Pt6S3I6PopTable");

        Pg3Pt6S3I6_Col1 = new Array();
        Pg3Pt6S3I6_Col2 = new Array();

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                Pg3Pt6S3I6_Col1.push(table.rows[x].cells[0].children[1].value);
                Pg3Pt6S3I6_Col2.push(table.rows[x].cells[1].children[0].value);
            }
        }
        
        //Special Deductions
        numRows = document.getElementById("Pg3Pt6S3I8PopTable").rows.length;
        table = document.getElementById("Pg3Pt6S3I8PopTable");

        Pg3Pt6S3I8_Col1 = new Array();
        Pg3Pt6S3I8_Col2 = new Array();

        for (x = 0; x < numRows; x++) {
            str = table.rows[x].cells[0].children[1].value;
            if ($.trim(str) != "") {
                Pg3Pt6S3I8_Col1.push(table.rows[x].cells[0].children[1].value);
                Pg3Pt6S3I8_Col2.push(table.rows[x].cells[1].children[0].value);
            }
        }
        //End - Part 6 Schedule 3 - Reconciliation of Net Income per Books Against Taxable Income
    }
    
