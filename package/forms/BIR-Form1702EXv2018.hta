            // alert(counter);
            for (var i = 0; i < counter; i++) {
                AddRow_Pg3Pt6S3I6PopTable();
            }
        }
        
        if ((response.innerHTML).indexOf('Pg3Pt6S3I8PopLength') != -1) {
