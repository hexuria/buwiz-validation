			alert('You entered a data on Page 3 Part VI Schedule 3 Item 8. Amount should not be zero');
			isValid = false;
            return false;
		}
		
        return isValid;
    }

    function checkFilingYear() {
        var txtYearEnd = document.getElementById("frm1702EX:txtPg1I2YearEnd");
        var ddlDate = document.getElementById('frm1702EX:ddlPg1I2Date');
        var currentDate = new Date();
        var isAmendedReturn = document.getElementById("frm1702EX:rdoPg1I3AmendedYes").checked; // If Amended Return Yes option is selected, set to true else false
        var isShortPeriod = document.getElementById("frm1702EX:rdoPg1I4ShortPeriodYes").checked; // If Short Period Return Yes option is selected, set to true else false
        
        // CALENDAR YEAR
        if (document.getElementById("frm1702EX:rdoPg1I1Calendar").checked === true) {
            // If Short Period Return is No and Amended Return is No for 1701,1702 EX,MX and RT
            // then default to December + <Current Year - 1>
            // make non-editable or have validation to not proceed if not met
            if ((!isAmendedReturn && !isShortPeriod) || (!isShortPeriod && !!isAmendedReturn)) {
                ddlDate.options[12].selected = true;
                ddlDate.disabled = true;

                txtYearEnd.value = (currentDate.getFullYear() - 2000) - 1;
                txtYearEnd.disabled = false;
            }
            /*
            // If Short Reriod Return is No and Amended Return is Yes for 1701,1702 EX,MX and RT
            // then default to December + editable year field with restriction rules
            else if (!isShortPeriod && !!isAmendedReturn) {
            ddlDate.options[12].selected = true;
            ddlDate.disabled = true;

            txtYearEnd.disabled = false;
            txtYearEnd.value = "";
            }
            // If Short Period Return is Yes and Amended Return is No for 1701,1702 EX,MX and RT
            // then default to editable month field + <Current Year - 1>
            else if (!!isShortPeriod && !isAmendedReturn) {
            ddlDate.disabled = false;
            ddlDate.options[0].selected = true;
            ddlDate.focus();

            txtYearEnd.value = (currentDate.getFullYear() - 2000) - 1;
            txtYearEnd.disabled = true;
            }
            */
            // If Short Period Return is Yes and Amended Return is Yes
            // then default to editable month field + editable year field with restriction rules
            else if ((!!isShortPeriod && !!isAmendedReturn) || (!!isShortPeriod && !isAmendedReturn)) {
                ddlDate.disabled = false;
                ddlDate.options[0].selected = true;
                ddlDate.focus();

                txtYearEnd.value = (currentDate.getFullYear() - 2000) - 1;
                txtYearEnd.disabled = false;
            }
        }
        // FISCAL YEAR
        else if (document.getElementById("frm1702EX:rdoPg1I1Fiscal").checked === true) {
            ddlDate.options[0].selected = true;
            ddlDate.disabled = false;
            ddlDate.focus();

            txtYearEnd.disabled = false;
            txtYearEnd.value = "";
        }
        
        if (isAmendedReturn) {
            d.getElementById("frm1702EX:txtPg2Pt4I47TaxPaidInReturnPrevFiled").disabled = false;
        }
        else {
            d.getElementById("frm1702EX:txtPg2Pt4I47TaxPaidInReturnPrevFiled").disabled = true;
            d.getElementById("frm1702EX:txtPg2Pt4I47TaxPaidInReturnPrevFiled").value = 0;
            FormatAmount("overallTotal");
        }
    }

    function checkYearEnd() {
        var element = document.getElementById("frm1702EX:txtPg1I2YearEnd");
        var inputYear = 2000 + (element.value * 1);
        var inputMonth = (document.getElementById('frm1702EX:ddlPg1I2Date').value * 1) - 1;
        var currentDate = new Date();
        var isValid = true;
		var holdYr = currentDate.getFullYear() - 2001;

        if (element.value !== "") {
            if ((document.getElementById("frm1702EX:rdoPg1I1Fiscal").checked === true) &&
                (inputYear > currentDate.getFullYear() || (inputMonth > currentDate.getMonth() && inputYear === currentDate.getFullYear()))) {
                alert('Date (Page 1 Item 2) cannot be greater than current date when filing for Fiscal Year.');
                element.value = '';
                element.focus();

                isValid = false;
            }
            else if (document.getElementById("frm1702EX:rdoPg1I1Fiscal").checked === true && inputMonth == 11) {
                alert('Date (Page 1 Item 2) Month cannot be equal to December.');
                document.getElementById('frm1702EX:ddlPg1I2Date').value = "00";
                document.getElementById('frm1702EX:ddlPg1I2Date').focus();
                isValid = false;
            }
            // MONTH: JANUARY = 0, FEBRUARY = 1, MARCH = 2 ... NOVEMBER = 10, DECEMBER = 11
            else if ((inputYear < 2018)) {
                alert("Invalid Year. Year should not be earlier than 2018.");
				document.getElementById('frm1702EX:txtPg1I2YearEnd').value = holdYr;
                document.getElementById('frm1702EX:ddlPg1I2Date').focus();
                isValid = false;
            }
            else if ((document.getElementById("frm1702EX:rdoPg1I1Calendar").checked === true)) {
                if ((document.getElementById("frm1702EX:rdoPg1I4ShortPeriodNo").checked === true) && (inputYear >= currentDate.getFullYear())) {
                    
                    alert('Year (Page 1 Item 2) cannot be greater than or equal to current year when filing for Calendar Year.');
                    element.value = holdYr;
                    element.focus();

                    isValid = false;
                }
                else if ((document.getElementById("frm1702EX:rdoPg1I4ShortPeriodYes").checked === true)) {
                    if ((inputYear > currentDate.getFullYear())) {
                        alert('Year (Page 1 Item 2) cannot be greater than the current year when filing for Calendar Year.');
                        
                        element.value = holdYr;
                        element.focus();
                        isValid = false;
                    }
                    else if ((inputYear === currentDate.getFullYear()) && (inputMonth > currentDate.getMonth())) {
                        alert('Month (Page 1 Item 2) cannot be greater than  current month date when filing for Calendar Year  and  Short Period Return.');
                        document.getElementById('frm1702EX:ddlPg1I2Date').value = '';
                        document.getElementById('frm1702EX:ddlPg1I2Date').focus();
                        isValid = false;
                    }
                    else if ((inputYear === currentDate.getFullYear()) && (inputMonth == 11)) {
                        alert('Month (Page 1 Item 2) cannot be equal to december  when filing for Calendar Year and  Short Period Return.');
                        document.getElementById('frm1702EX:ddlPg1I2Date').value = '';
                        document.getElementById('frm1702EX:ddlPg1I2Date').focus();
                        isValid = false;
                    }
                }
            }
            else if (inputMonth < 0) {
                alert('(Page 1 Item 2) Month is invalid.');
                document.getElementById('frm1702EX:ddlPg1I2Date').focus();
                isValid = false;
            }
            
        }

        if (element.value !== '' && (element.value * 1) > -1 && (element.value * 1) < 10) {
            element.value = '0' + element.value * 1;
        }

        return isValid;
    }

    function Check_CTCorReg() {
        var cert = document.getElementsByName('CTCorReg');
        var cert_value;
        for (var i = 0; i < cert.length; i++) {
            if (cert[i].checked) {
                cert_value = cert[i].value;
            }
        }

        if (cert_value == 'CTC' || cert_value == 'Reg') {

            return true;
        }
        else {
            alert('Please select CTC or SEC Reg on Page 1 Item 23');
            return false;
        }
    }

	function Check_rdoPg1I5ATC() {
        var rates = document.getElementsByName('frm1702EX:rdoPg1I5ATC');
        var rate_value;
        for (var i = 0; i < rates.length; i++) {
            if (rates[i].checked) {
                rate_value = rates[i].value;
            }
        }
        
        if (rate_value == "IC021" || rate_value == "IC011") {
            return true;
        }
        else {
            alert('Please select an ATC on Page 1 Item 5');
            return false;
        }
        
    }
    
    function check_MethodOfDeduction() {
        if (d.getElementById('frm1702EX:rdoPg1Pt1I13MethodOfDeducItemized').checked == false
         && d.getElementById('frm1702EX:rdoPg1Pt1I13MethodOfDeducOptional').checked == false) {
            alert("Please select a Method of Deduction in page 1 Item 13."); 
            return false;
        }
        else {
            return true;
        }

    }
    
    function check_Overpayment() {
        if (d.getElementById('frm1702EX:rdoPg1OverpaymentRefund').checked == false
         && d.getElementById('frm1702EX:rdoPg1OverpaymentTCC').checked == false
         && d.getElementById('frm1702EX:rdoPg1OverpaymentCarryOver').checked == false) {
            alert("Please select an Overpayment option in Page 1 after Item 22.");
            return false;
        }
        else {
            return true;
        }
    }

	function validateNetTaxInc(){
		if (d.getElementById('frm1702EX:txtPg2Pt4I39NetTaxable').value != d.getElementById('frm1702EX:txtPg3Pt6S3I10NetTaxableIncome').value){
			alert('Page 2 Part IV Item 39 should be equal to Page 3 Schedule 3 Item 10.');
			return false;
		}
		else
			return true;
	}

	function disableAndReset(param, type){
		if(type == 'radio'){
			d.getElementById('frm1702EX:' + param).checked = false;
			d.getElementById('frm1702EX:' + param).disabled = true;
		}
		else if(type == 'text'){
			d.getElementById("frm1702EX:" + param).value = "";
			d.getElementById("frm1702EX:" + param).disabled = true;
		}
		else if(type == 'number'){
			var zero = 0.00
			d.getElementById("frm1702EX:" + param).value = formatCurrency(NumWithComma(zero));
			d.getElementById("frm1702EX:" + param).disabled = true;
		}
	}

    function FormatAmount(amountType) {
        if (amountType == "totalGrossIncome") {
            //Page 2 - Part 4 Item 34
            //Net Sales computation
            d.getElementById("frm1702EX:txtPg2Pt4I30NetSalesReceiptsRevFees").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I28SalesReceiptsRevFees").value) * 1 
                - NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I29SalesRetAllowanceDisc").value) * 1).toFixed(0));
            
            //Gross Income From Operation computation
            d.getElementById("frm1702EX:txtPg2Pt4I32GrossIncomeFromOper").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I30NetSalesReceiptsRevFees").value) * 1 
                - NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I31CostOfSalesServ").value) * 1).toFixed(0));
                
            //Total Gross Income computatiom
            d.getElementById("frm1702EX:txtPg2Pt4I34TotalGross").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I32GrossIncomeFromOper").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I33AddOther").value) * 1).toFixed(0));
                
            //Optional Standard Deduction computation
            d.getElementById("frm1702EX:txtPg2Pt4I38OptionalStandardDeduc").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I34TotalGross").value) * 0.4).toFixed(0));            
        }
        
        else if (amountType == "overallTotal") {
            //Page 2 - Part 4 Item 50
            //Total Tax Credits/Payments computation
            d.getElementById("frm1702EX:txtPg2Pt4I50TotalTaxCrPmt").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I42PriorYearExcessCr").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I43IncomeTaxPmtFromPreviousQrt").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I44CreditableTaxWithheldFromPrevQrt").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I45CreditableTaxWithheldFor4thQrt").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I46ForeignTaxCr").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I47TaxPaidInReturnPrevFiled").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I48OtherTaxCrPmtAmt").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I49OtherTaxCrPmtAmt").value) * 1).toFixed(0));
        }
        
        else if (amountType == "totalOrdAllowedItemDeduc") {
            //Page 3 - Page 6 Schedule 1
            //Total Ordinary Allowable Itemized Deductions computation
            d.getElementById("frm1702EX:txtPg3Pt6S1I18TotOrdinaryAllowableItemDeduc").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I1Ammortization").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I2BadDebts").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I3CharitableContrib").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I4Depletion").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I5Depreciation").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I6EntertainmentAmuseRecreate").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I7FringeBenefits").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I8Interest").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I9Losses").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I10PensionTrust").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I11Rental").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I12RnD").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I13SalaryWageAllowance").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I14SssGsisPHealthHDMFOthers").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I15TaxAndLicense").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I16TranspoAndTravel").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I17aJanitorAndMessengerServ").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I17bProfessionalFee").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I17cSecurityServices").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6I17OthersDAmt").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6I17OthersEAmt").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6I17OthersFAmt").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6I17OthersGAmt").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6I17OthersHAmt").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6I17OthersIAmt").value) * 1).toFixed(0));
        }
        
        else if (amountType == "totalSpecAllowedItemDeduc") {
            //Page 3 - Part 6 Schedule 2
            //Total Special Allowable Itemized Deductions computation
            d.getElementById("frm1702EX:txtPg3Pt6S2I5TotSpecialAllowedItemDeduc").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S2I1Amount").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S2I2Amount").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S2I3Amount").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S2I4Amount").value) * 1).toFixed(0));
        }
        
        else if (amountType == "netTaxIncomeLoss") {
            //Page 3 - Part 6 Schedule 3
            //Total Net Income/Loss per Books, and Non-Deductible Expenses/Other Income computation
            d.getElementById("frm1702EX:txtPg3Pt6S3I4Total").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I1NetIncomePerBook").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I2NonDeductExpenseOtherIncomeAmt").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I3NonDeductExpenseOtherIncomeAmt").value) * 1));
                
            //Total of Non-Taxable Income and Income Subjected to Final Tax, and Special Deductions computation
            d.getElementById("frm1702EX:txtPg3Pt6S3I9Total").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I5NonTaxIncomeAndIncomeSubjectToFinTaxAmt").value) * 1 
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I6NonTaxIncomeAndIncomeSubjectToFinTaxAmt").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I7SpecialDeductAmt").value) * 1
                + NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I8SpecialDeductAmt").value) * 1).toFixed(0));
                
            //Overall Net Taxable Income/Loss computation
            d.getElementById("frm1702EX:txtPg3Pt6S3I10NetTaxableIncome").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I4Total").value) * 1 
                - NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S3I9Total").value) * 1).toFixed(0));
        }
        
        amountComputation();
    } //FormatAmount End
    
    function amountComputation() {
        //Copy the amount from Part VI Sched 1 Item 18 TO Page 2 Part IV Item 35
        d.getElementById("frm1702EX:txtPg2Pt4I35OrdinaryAllowable").value = 
            formatCurrency(NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S1I18TotOrdinaryAllowableItemDeduc").value) * 1);      

        //Copy the amount from Part VI Sched 2 Item 5 TO Page 2 Part IV Item 36
        d.getElementById("frm1702EX:txtPg2Pt4I36SpecialAllowable").value = 
            formatCurrency(NumWithComma(d.getElementById("frm1702EX:txtPg3Pt6S2I5TotSpecialAllowedItemDeduc").value) * 1);

        //Total Itemized Deductions computation           
        if (d.getElementById('frm1702EX:rdoPg1Pt1I13MethodOfDeducItemized').checked == true) {
			d.getElementById("frm1702EX:txtPg2Pt4I37TotalItemized").value = 
				formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I35OrdinaryAllowable").value) * 1
				+ NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I36SpecialAllowable").value) * 1).toFixed(0));
				
			d.getElementById("frm1702EX:txtPg2Pt4I38OptionalStandardDeduc").value = "0.00";

            d.getElementById("frm1702EX:txtPg2Pt4I39NetTaxable").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I34TotalGross").value) * 1 
                - NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I37TotalItemized").value) * 1).toFixed(0));
        } 
        else if (d.getElementById('frm1702EX:rdoPg1Pt1I13MethodOfDeducOptional').checked == true) {
            d.getElementById("frm1702EX:txtPg2Pt4I38OptionalStandardDeduc").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I34TotalGross").value) * 0.4).toFixed(0));

			d.getElementById("frm1702EX:txtPg2Pt4I35OrdinaryAllowable").value = "0.00";
			d.getElementById("frm1702EX:txtPg2Pt4I36SpecialAllowable").value = "0.00";

			d.getElementById("frm1702EX:txtPg2Pt4I39NetTaxable").value = 
                formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I34TotalGross").value) * 1 
                - NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I38OptionalStandardDeduc").value) * 1).toFixed(0));
        }

		//Total Itemized Deductions
		d.getElementById("frm1702EX:txtPg2Pt4I37TotalItemized").value = 
				formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I35OrdinaryAllowable").value) * 1
				+ NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I36SpecialAllowable").value) * 1).toFixed(0));

        //Tax Due computation
        d.getElementById("frm1702EX:txtPg2Pt4I41TaxDue").value = 
            formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I39NetTaxable").value) * 1
            * NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I40TaxRate").value) / 100).toFixed(0));
            
        //Overall total amount or overpayment computation
        d.getElementById("frm1702EX:txtPg2Pt4I51TotalOverpayment").value = 
            formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I41TaxDue").value) * 1 
            - NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I50TotalTaxCrPmt").value) * 1).toFixed(0)); 
        
        //Part V - Item 52 to 54
		compTaxReliefAvail();
                        
        //Page 1 - Part 2 Item 18 to 22
        //Copy the amount from Part IV Item 41 TO Page 1 Part II Item 18
        d.getElementById("frm1702EX:txtPg1Pt2I18TaxDue").value = 
            formatCurrency(NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I41TaxDue").value) * 1);
            
        //Copy the amount from Part IV Item 50 TO Page 1 Part II Item 19
        d.getElementById("frm1702EX:txtPg1Pt2I19TotalTaxCrPmt").value = 
            formatCurrency(NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I50TotalTaxCrPmt").value) * 1);
            
        //Copy the amount from Part IV Item 51 TO Page 1 Part II Item 20
        d.getElementById("frm1702EX:txtPg1Pt2I20TotalOverpmt").value = 
            formatCurrency(NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I51TotalOverpayment").value) * 1);
            
        //Total Amount Payable computation
        if (NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I20TotalOverpmt").value) > -1){
			d.getElementById("frm1702EX:txtPg1Pt2I22TotalAmtPayable").value =
				formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I20TotalOverpmt").value) * 1 
				+ NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I21PenaltyCompromise").value) * 1).toFixed(0));
		}
		else if (NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I20TotalOverpmt").value) < 0
			&& NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I21PenaltyCompromise").value) > 0){
			d.getElementById("frm1702EX:txtPg1Pt2I22TotalAmtPayable").value =
				formatCurrency(NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I21PenaltyCompromise").value) * 1);
		}
		else{
			d.getElementById("frm1702EX:txtPg1Pt2I22TotalAmtPayable").value =
				formatCurrency(NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I20TotalOverpmt").value) * 1);
		}

		if (NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I20TotalOverpmt").value) < 0){
			d.getElementById("frm1702EX:rdoPg1OverpaymentRefund").disabled = false;
			d.getElementById("frm1702EX:rdoPg1OverpaymentTCC").disabled = false;
			d.getElementById("frm1702EX:rdoPg1OverpaymentCarryOver").disabled = false;
		}
		else if (NumWithComma(d.getElementById("frm1702EX:txtPg1Pt2I20TotalOverpmt").value) > -1){
			d.getElementById("frm1702EX:rdoPg1OverpaymentRefund").checked = false;
			d.getElementById("frm1702EX:rdoPg1OverpaymentTCC").checked = false;
			d.getElementById("frm1702EX:rdoPg1OverpaymentCarryOver").checked = false;
			d.getElementById("frm1702EX:rdoPg1OverpaymentRefund").disabled = true;
			d.getElementById("frm1702EX:rdoPg1OverpaymentTCC").disabled = true;
			d.getElementById("frm1702EX:rdoPg1OverpaymentCarryOver").disabled = true;
		}
    }

	function compTaxReliefAvail(){
		if (d.getElementById('frm1702EX:txtPg1I2YearEnd').value <= 20)
			var taxRate = 30;
		else
			var taxRate = d.getElementById("frm1702EX:txtPg2Pt4I40TaxRate").value;

        //Regular Income Tax Otherwise Due computation
        d.getElementById("frm1702EX:txtPg2Pt5I52RegularIncomeOtherwiseDue").value = 
            formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I39NetTaxable").value) * 1 
            * (taxRate / 100)).toFixed(0));

        //Special Allowable Itemized Deductions computation
        d.getElementById("frm1702EX:txtPg2Pt5I53SpecialAllowableItemizedDeduc").value = 
            formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt4I36SpecialAllowable").value) * 1 
            * (taxRate / 100)).toFixed(0));

		//Total Tax Relief Availment computation
        d.getElementById("frm1702EX:txtPg2Pt5I54TotalTaxReliefAvailment").value = 
            formatCurrency((NumWithComma(d.getElementById("frm1702EX:txtPg2Pt5I52RegularIncomeOtherwiseDue").value) * 1
            + NumWithComma(d.getElementById("frm1702EX:txtPg2Pt5I53SpecialAllowableItemizedDeduc").value) * 1).toFixed(0));
	}

    function enableCompleteRows(source) {
        //Part 4
        if (source == 'otherTax1') {
            if (d.getElementById("frm1702EX:txtPg2Pt4I48OtherTaxCrPmtDesc").value != '' && d.getElementById("frm1702EX:txtPg2Pt4I48OtherTaxCrPmtAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg2Pt4I49OtherTaxCrPmtDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg2Pt4I49OtherTaxCrPmtDesc").focus();
                d.getElementById("frm1702EX:txtPg2Pt4I49OtherTaxCrPmtAmt").disabled = false;
            }
        }
        
        //Part 6 Schedule 1
        else if (source == 'othersD') {
            if (d.getElementById("frm1702EX:txtPg3Pt6I17OthersDDesc").value != '' && d.getElementById("frm1702EX:txtPg3Pt6I17OthersDAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersEDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersEDesc").focus();
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersEAmt").disabled = false;
            }
        }
        else if (source == 'othersE') {
            if (d.getElementById("frm1702EX:txtPg3Pt6I17OthersEDesc").value != '' && d.getElementById("frm1702EX:txtPg3Pt6I17OthersEAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersFDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersFDesc").focus();
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersFAmt").disabled = false;
            }
        }
        else if (source == 'othersF') {
            if (d.getElementById("frm1702EX:txtPg3Pt6I17OthersFDesc").value != '' && d.getElementById("frm1702EX:txtPg3Pt6I17OthersFAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersGDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersGDesc").focus();
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersGAmt").disabled = false;
            }
        }
        else if (source == 'othersG') {
            if (d.getElementById("frm1702EX:txtPg3Pt6I17OthersGDesc").value != '' && d.getElementById("frm1702EX:txtPg3Pt6I17OthersGAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersHDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersHDesc").focus();
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersHAmt").disabled = false;
            }
        }
        else if (source == 'othersH') {
            if (d.getElementById("frm1702EX:txtPg3Pt6I17OthersHDesc").value != '' && d.getElementById("frm1702EX:txtPg3Pt6I17OthersHAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersIDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersIDesc").focus();
                d.getElementById("frm1702EX:txtPg3Pt6I17OthersIAmt").disabled = false;
            }
        }
        //Part 6 Schedule 2
        else if (source == 'specialAllow1') {
            if (d.getElementById("frm1702EX:txtPg3Pt6S2I1Description").value != '' && d.getElementById("frm1702EX:txtPg3Pt6S2I1LegalBasis").value != ''
             && d.getElementById("frm1702EX:txtPg3Pt6S2I1Amount").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6S2I2Description").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S2I2Description").focus();
                d.getElementById("frm1702EX:txtPg3Pt6S2I2LegalBasis").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S2I2Amount").disabled = false;
            }
        }
        else if (source == 'specialAllow2') {
            if (d.getElementById("frm1702EX:txtPg3Pt6S2I2Description").value != '' && d.getElementById("frm1702EX:txtPg3Pt6S2I2LegalBasis").value != ''
             && d.getElementById("frm1702EX:txtPg3Pt6S2I2Amount").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6S2I3Description").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S2I3Description").focus();
                d.getElementById("frm1702EX:txtPg3Pt6S2I3LegalBasis").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S2I3Amount").disabled = false;
            }
        }
        else if (source == 'specialAllow3') {
            if (d.getElementById("frm1702EX:txtPg3Pt6S2I3Description").value != '' && d.getElementById("frm1702EX:txtPg3Pt6S2I3LegalBasis").value != ''
             && d.getElementById("frm1702EX:txtPg3Pt6S2I3Amount").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6S2I4Description").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S2I4Description").focus();
                d.getElementById("frm1702EX:txtPg3Pt6S2I4LegalBasis").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S2I4Amount").disabled = false;
            }
        }
        //Part 6 Schedule 3
        else if (source == 'nonDeduc1') {
            if (d.getElementById("frm1702EX:txtPg3Pt6S3I2NonDeductExpenseOtherIncomeDesc").value != '' 
             && d.getElementById("frm1702EX:txtPg3Pt6S3I2NonDeductExpenseOtherIncomeAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6S3I3NonDeductExpenseOtherIncomeDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S3I3NonDeductExpenseOtherIncomeDesc").focus();
                d.getElementById("frm1702EX:txtPg3Pt6S3I3NonDeductExpenseOtherIncomeAmt").disabled = false;
            }
        }
        else if (source == 'nonTaxInc1') {
            if (d.getElementById("frm1702EX:txtPg3Pt6S3I5NonTaxIncomeAndIncomeSubjectToFinTaxDesc").value != '' 
             && d.getElementById("frm1702EX:txtPg3Pt6S3I5NonTaxIncomeAndIncomeSubjectToFinTaxAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6S3I6NonTaxIncomeAndIncomeSubjectToFinTaxDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S3I6NonTaxIncomeAndIncomeSubjectToFinTaxDesc").focus();
                d.getElementById("frm1702EX:txtPg3Pt6S3I6NonTaxIncomeAndIncomeSubjectToFinTaxAmt").disabled = false;
            }
        }
        else if (source == 'specialDeduc1') {
            if (d.getElementById("frm1702EX:txtPg3Pt6S3I7SpecialDeductDesc").value != '' 
             && d.getElementById("frm1702EX:txtPg3Pt6S3I7SpecialDeductAmt").value != 0) {
                d.getElementById("frm1702EX:txtPg3Pt6S3I8SpecialDeductDesc").disabled = false;
                d.getElementById("frm1702EX:txtPg3Pt6S3I8SpecialDeductDesc").focus();
                d.getElementById("frm1702EX:txtPg3Pt6S3I8SpecialDeductAmt").disabled = false;
            }
        }
        
    }
	
	function validateEmptyField(source) {
	//Page 2 Part 4
	var isValid = true;
	if (source == 'pg2Pt4I48') {
		if (d.getElementById("frm1702EX:txtPg2Pt4I48OtherTaxCrPmtDesc").value == '' && d.getElementById("frm1702EX:txtPg2Pt4I48OtherTaxCrPmtAmt").value != 0 ) {
			alert('You have an empty description on Page 2 Part IV Item 48.');
			isValid = false;
			return false;
		}
		else if (d.getElementById("frm1702EX:txtPg2Pt4I48OtherTaxCrPmtDesc").value != ''
			&& (d.getElementById("frm1702EX:txtPg2Pt4I48OtherTaxCrPmtAmt").value == 0 || d.getElementById("frm1702EX:txtPg2Pt4I48OtherTaxCrPmtAmt").value == 0.00) ) {
			alert('You entered a description on Page 2 Part IV Item 48. Amount should not be zero.');
			isValid = false;
			return false;
		}
	}
	
	return isValid;
	}
    
</script>
<!--to eFPS-->
<script>
    function submitOnline(){
        if(confirm("You will now be redirected to eFPS Online.")){
            submitToEFPS();
        }
    }

    function checkconnection() {
        var status = navigator.onLine;
        if (status) {
            return true;
        } else {
            return false;
        }
    }

    function submitToEFPS() {

        if (checkconnection()) {
            var formVersion = Form1702EX.version;
            function getValue(stringId) {
                
                var alpha = document.getElementById(stringId).value;
                
                alpha = alpha.replace(/&/g, '&amp;');
                alpha = alpha.replace(/</g, '&lt;');
                alpha = alpha.replace(/>/g, '&gt;');
                
                return alpha;
                //if (!document.getElementById(stringId)) {
                //  console.error(stringId);
                //}
            }

            function convertDateXML(element) {
                //alert(d.getElementById('frm1702EX:'+element).value);
                var date = '';
                var dateSplit = d.getElementById('frm1702EX:' + element).value.split('/');
                var date = dateSplit[2] + '-' + dateSplit[0] + '-' + dateSplit[1];

                return date;
            }

            function getAmount(stringId) {
                return ((document.getElementById(stringId).value.indexOf(')') > 0 ? "-" : "") + document.getElementById(stringId).value.replace(/[\(\)\,]/gi, "")) * 1;
                //if (!document.getElementById(stringId)) {
                //  console.error(stringId);
                //  }
            }

            function fixAmount(elemValue) {
                return ((elemValue.indexOf(')') > 0 ? "-" : "") + elemValue.replace(/[\(\)\,]/gi, "")) * 1;
            }

            function returnPeriod() {
                var yyyyR = "20" + d.getElementById('frm1702EX:txtPg1I2YearEnd').value;
                var mmR = (d.getElementById('frm1702EX:ddlPg1I2Date').value.toString());
                var ddR = new Date(yyyyR, mmR, 0).getDate();
                var returnPeriodFormat = yyyyR + "-" + (mmR) + "-" + ddR;

                return returnPeriodFormat;
            }

            var endedyear = '20' + getValue("frm1702EX:txtPg1I2YearEnd");
            populateTaxpayer(getValue("frm1702EX:txtPg1Pt1I6TINC4"), '',
        '', '', '', '',
        '', convertDateXML("txtPg1Pt1I8DateofIncorporation"), '', '', '', getValue("frm1702EX:txtPg1Pt1I6TINC1"),
        getValue("frm1702EX:txtPg1Pt1I6TINC2"), getValue("frm1702EX:txtPg1Pt1I6TINC3"), getValue("frm1702EX:txtPg1Pt1I9RegisteredAddress"), '', '',
        returnPeriod(), getValue("frm1702EX:txtPg1Pt1I12Email"), '', (document.getElementById("frm1702EX:rdoPg1I3AmendedYes").checked == true ? "Y" : "N"), '',
        '', (document.getElementById("frm1702EX:rdoPg1I4ShortPeriodYes").checked == true ? "Y" : "N"), (document.getElementById("frm1702EX:rdoPg1I5ATCR1C3").checked == true ? "IC011" : "IC021"),
        getValue("frm1702EX:txtPg1Pt2NumberofPagesFiled"), getValue("frm1702EX:txtPg1Pt1I11ContactNumber"), '',
        '', (document.getElementById("frm1702EX:rdoPg1I1Calendar").checked == true ? "C" : "F"), getValue("frm1702EX:ddlPg1I2Date"), endedyear, getValue("frm1702EX:rdoPg1Pt1I7RDO"),
        getValue("frm1702EX:txtPg1Pt1I16RegisteredActivity"), '', '', getValue("frm1702EX:txtPg1Pt1I8RegisteredName"), (document.getElementById("frm1702EX:rdoPg1CTC").checked == true ? "CTC" : "SEC"),
        (document.getElementById("frm1702EX:rdoPg1I3AmendedYes").checked == true ? "Y" : "N"), (document.getElementById("frm1702EX:rdoPg1I5ATCR1C3").checked == true ? "true" : "false"), (document.getElementById("frm1702EX:rdoPg1I5ATCR2C3").checked == true ? "true" : "false"), convertDateXML("txtPg1Pt1I19EffectivityFrom"),
        convertDateXML("txtPg1Pt1I19EffectivityTo"), getValue("frm1702EX:txtPg1Pt1I14LegalBasis"), getValue("frm1702EX:txtPg1Pt1I15Investment"),
        '', '', '', formVersion);

            //alert(endedyear);
            //alert(getValue("frm1702EX:ddlPg1I2Date"));
            populateTotalTaxPayable(
        getAmount("frm1702EX:txtPg1Pt2I20TotalIncome"),
        getAmount("frm1702EX:txtPg1Pt2I21AddPenalty"),
        getAmount("frm1702EX:txtPg7Sc9I19TotalFinalTax"),
        getValue("frm1702EX:txtPg1Pt2I23CommunityTax"),
        convertDateXML("txtPg1Pt1I24DateofIssue"),
        getValue("frm1702EX:txtPg1Pt1I25PlaceofIssue"),
        getAmount("frm1702EX:txtPg1Pt1I26Amount"),
        getAmount("frm1702EX:txtPg1Pt2I22TotalAmount"),
        getAmount("frm1702EX:txtPg7Sc10I8TotalIncome"));

            populateComputationOfTaxBean(getAmount("frm1702EX:txtPg2Pt4I32LessCost"),
        getAmount("frm1702EX:txtPg2Pt4I33GrossIncome"),
            '0',
            '0',
            '0',
            '0',
        getAmount("frm1702EX:txtPg2Pt4I31NetSales"),
            '0',
        getAmount("frm1702EX:txtPg2Pt4I39NetTaxable"),
            '0',
        false,
            '0',
        false,
        getAmount("frm1702EX:txtPg2Pt4I35OrdinaryAllowable"),
        true,
        getAmount("frm1702EX:txtPg2Pt4I33AddOther"),
        getAmount("frm1702EX:txtPg2Pt4I36SpecialAllowable"),
        true,
            '0',
        getAmount("frm1702EX:txtPg2Pt4I34TotalGross"),
        getAmount("frm1702EX:txtPg2Pt4I41TotalIncome"),
        getAmount("frm1702EX:txtPg2Pt4I37TotalItemized"),
            '0');

            populateTaxReliefAvailment(getAmount("frm1702EX:txtPg2Pt5I42RegularIncome"),
        getAmount("frm1702EX:txtPg2Pt5I43SpecialAllowable"),
        getAmount("frm1702EX:txtPg2Pt5I44TotalTax"));

            populateExternalAuditorAccreditedTaxAgentBean(getValue("frm1702EX:txtPg2Pt6I45NameofExternalAuditor"),
        getValue("frm1702EX:txtPg2Pt6I46TinC1") + getValue("frm1702EX:txtPg2Pt6I46TinC2") + getValue("frm1702EX:txtPg2Pt6I46TinC3"),
        getValue("frm1702EX:txtPg2Pt6I47NameofSigningPartner"),
        getValue("frm1702EX:txtPg2Pt6I48TinC1") + getValue("frm1702EX:txtPg2Pt6I48TinC2") + getValue("frm1702EX:txtPg2Pt6I48TinC3"),
        getValue("frm1702EX:txtPg2Pt6I49BIRAccreditedNoC1") + getValue("frm1702EX:txtPg2Pt6I49BIRAccreditedNoC2") + getValue("frm1702EX:txtPg2Pt6I49BIRAccreditedNoC3") + getValue("frm1702EX:txtPg2Pt6I49BIRAccreditedNoC4"),
        convertDateXML("txtPg2Pt6I50IssueDate"),
        convertDateXML("txtPg2Pt6I51ExpiryDate"),
        getValue("frm1702EX:txtPg2Pt6I46TinC4"),
        getValue("frm1702EX:txtPg2Pt6I48TinC4"));

            //Schedule1                     
            populateSalesRevenueBean(getAmount("frm1702EX:txtPg3S1I1GoodsProp"),
        getAmount("frm1702EX:txtPg3S1I2SaleServices"),
        getAmount("frm1702EX:txtPg3S1I3LeaseProp"),
        getAmount("frm1702EX:txtPg3S1I4Total"),
        getAmount("frm1702EX:txtPg3S1I5LessSales"),
        getAmount("frm1702EX:txtPg3S1I6NetSales"));

            //Schedule2                     
            populateCostOfSaleBean(getAmount("frm1702EX:txtPg3S2I1MerchInventory"),
        getAmount("frm1702EX:txtPg3S2I2AddPurchases"),
        getAmount("frm1702EX:txtPg3S2I3TotalGoods"),
        getAmount("frm1702EX:txtPg3S2I4LessMerch"),
        getAmount("frm1702EX:txtPg3S2I5CostSales"),
        getAmount("frm1702EX:txtPg3S2I6DirectMaterials"),
        getAmount("frm1702EX:txtPg3S2I7AddPurchases"),
        getAmount("frm1702EX:txtPg3S2I8MaterialsAvailable"),
        getAmount("frm1702EX:txtPg3S2I9DirectMaterials"),
        getAmount("frm1702EX:txtPg3S2I10RawMaterials"),
        getAmount("frm1702EX:txtPg3S2I11DirectLabor"),
        getAmount("frm1702EX:txtPg3S2I12ManOverhead"),
        getAmount("frm1702EX:txtPg3S2I13TotalMan"),
        getAmount("frm1702EX:txtPg3S2I14WorkProcess"),
        getAmount("frm1702EX:txtPg3S2I15LessWork"),
