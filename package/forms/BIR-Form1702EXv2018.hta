<script type="text/javascript">

    function shortPeriodYes() {

        alert('Choosing "Yes" means you are filing for a short-period return. You are required to change the Month field to correspond with your New return period.');
        checkFilingYear();

        document.getElementById('frm1702EX:ddlPg1I2Date').focus();
    }

    function DateCompare_Page1_Item17() {
        var first1 = document.getElementById("frm1702EX:txtPg1Pt1I17EffectivityFrom").value;
        var second1 = document.getElementById("frm1702EX:txtPg1Pt1I17EffectivityTo").value;
		var currTaxYr = (d.getElementById('frm1702EX:txtPg1I2YearEnd').value * 1) + 2000;

        firstDate = new Date(first1);
        secondDate = new Date(second1);

        if (firstDate >= secondDate) {
            alert("Effective Tax Relief/Exemption TO date should be greater than FROM date.");
            d.getElementById("frm1702EX:txtPg1Pt1I17EffectivityTo").value = "";
			d.getElementById("frm1702EX:txtPg1Pt1I17EffectivityTo").focus();
            return false;
        }
		else if(currTaxYr > d.getElementById('frm1702EX:txtPg1Pt1I17EffectivityTo').value.split('/')[2] * 1 ||
			(currTaxYr >= d.getElementById('frm1702EX:txtPg1Pt1I17EffectivityTo').value.split('/')[2] * 1 &&	d.getElementById('frm1702EX:ddlPg1I2Date').value > d.getElementById('frm1702EX:txtPg1Pt1I17EffectivityTo').value.split('/')[0] * 1)){
			alert("Expired exemption not allowed. Effective Tax Relief/Exemption date should be greater than the Taxable Year in Page 1 Item 2.");
			d.getElementById("frm1702EX:txtPg1Pt1I17EffectivityTo").value = "";
			d.getElementById("frm1702EX:txtPg1Pt1I17EffectivityTo").focus();
			return false;
		}
        return true;
    }

	function chkDtTaxRliefFrom(){
		var currTaxYr = (d.getElementById('frm1702EX:txtPg1I2YearEnd').value * 1) + 2000;
		
		if (currTaxYr < d.getElementById('frm1702EX:txtPg1Pt1I17EffectivityFrom').value.split('/')[2] * 1 ||
			(currTaxYr == d.getElementById('frm1702EX:txtPg1Pt1I17EffectivityFrom').value.split('/')[2] * 1 && d.getElementById('frm1702EX:ddlPg1I2Date').value < d.getElementById('frm1702EX:txtPg1Pt1I17EffectivityFrom').value.split('/')[0] * 1)){
			alert("Effective Tax Relief/Exemption date should not be greater than Taxable Year in Page 1 Item 2.");
			d.getElementById('frm1702EX:txtPg1Pt1I17EffectivityFrom').value = '';
			d.getElementById('frm1702EX:txtPg1Pt1I17EffectivityFrom').focus();
		}
	}

