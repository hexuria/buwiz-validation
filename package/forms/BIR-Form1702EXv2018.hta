            <div style="position: relative; width: 100%;">
                
                       <span style="font-weight: bold; font-size: largerBold;">Are you a registered eBIRForms Online User?</span>
                       
            </div>
            <div class="modalInner" style="width: 98%;">
                <table>
            
                    </tr>
                            <td>
