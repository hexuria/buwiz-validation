			&& d.getElementById("frm1702EX:txtPg3Pt6S2I3Amount").value < "0.01" )
			||
			( (d.getElementById("frm1702EX:txtPg3Pt6S2I3Description").value == "" && d.getElementById("frm1702EX:txtPg3Pt6S2I3LegalBasis").value != "") 
			&& d.getElementById("frm1702EX:txtPg3Pt6S2I3Amount").value < "0.01" )){
			alert('You have an empty data on Page 3 Part VI Schedule 2 Item 3.');
