		disableAndReset('txtPg3Pt6S1I14SssGsisPHealthHDMFOthers', 'number');
		disableAndReset('txtPg3Pt6S1I15TaxAndLicense', 'number');
		disableAndReset('txtPg3Pt6S1I16TranspoAndTravel', 'number');
		disableAndReset('txtPg3Pt6S1I17aJanitorAndMessengerServ', 'number');
		disableAndReset('txtPg3Pt6S1I17bProfessionalFee', 'number');
		disableAndReset('txtPg3Pt6S1I17cSecurityServices', 'number');
		disableAndReset('txtPg3Pt6I17OthersDDesc', 'text');
		disableAndReset('txtPg3Pt6I17OthersDAmt', 'number');
		disableAndReset('txtPg3Pt6I17OthersEDesc', 'text');
		disableAndReset('txtPg3Pt6I17OthersEAmt', 'number');
		disableAndReset('txtPg3Pt6I17OthersFDesc', 'text');
		disableAndReset('txtPg3Pt6I17OthersFAmt', 'number');
		disableAndReset('txtPg3Pt6I17OthersGDesc', 'text');
		disableAndReset('txtPg3Pt6I17OthersGAmt', 'number');
		disableAndReset('txtPg3Pt6I17OthersHDesc', 'text');
		disableAndReset('txtPg3Pt6I17OthersHAmt', 'number');
		disableAndReset('txtPg3Pt6I17OthersIDesc', 'text');
		disableAndReset('txtPg3Pt6I17OthersIAmt', 'number');
		FormatAmount('totalOrdAllowedItemDeduc');
		d.getElementById('btnPg3Pt6S1I17More').disabled = true;
		Pg3Pt6S1I17_Col1 = new Array();
