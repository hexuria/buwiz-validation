            return false;
		}
		else if ( (d.getElementById("frm1702EX:txtPg3Pt6S2I3Description").value != "" && d.getElementById("frm1702EX:txtPg3Pt6S2I3LegalBasis").value != "") 
			&& d.getElementById("frm1702EX:txtPg3Pt6S2I3Amount").value < "0.01" ){
