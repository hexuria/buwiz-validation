                </table>
            </div>
            <table class="modalContent" align="center">
                <tr>
                    <td><input type='button' class='printButtonClass' id="btnAddSecC" value='Add' onclick="addlistSecC()" /><input type='button' class='printButtonClass' id="btnDeleteSecC" value='Delete' onclick="    deletelistSecC()" />  </td>
                </tr>
            </table>
            <br/><br />
            <br />
