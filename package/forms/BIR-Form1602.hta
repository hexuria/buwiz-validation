    function getSecB(isReloaded) {
        if (checkifFieldEmptySecB() != true) {
            return;
        }

        if (isReloaded) {

            var size = secBToCommit.length;
            secB = new Array();
            for (var i = 0 ; i < size ; i++) {
                secB[i] = new SectionBC();
                secB[i].SelTreatyCode = secBToCommit[i].SelTreatyCode;
                secB[i].SelATC = secBToCommit[i].SelATC;
                // sched1[i].SelATC = d.getElementById('drpATCCodeSecB'+i).value;
                secB[i].txtAmtIncomePayment = d.getElementById('txtAmtIncomePaySecB' + i).value;
                secB[i].TxtTaxRate = d.getElementById('txtRateSecB' + i).value;
                secB[i].TxtRequiredWithheld = d.getElementById('txtReqWithheldSecB' + i).value;

            }
            var tblrow = d.getElementById('tbllistSecB');
            var totalSum = 0;
            for (var i = 0; i < tblrow.rows.length - 1 ; i++) {
                totalSum = (totalSum * 1 + NumWithComma(d.getElementById('txtReqWithheldSecB' + i).value) * 1);
            }
            d.getElementById('frm1602:txt29').value = formatCurrency(totalSum * 1);
            compute33();
            cancelSecB();

        } else {


            if (confirm("Values in column Tax Required to be Withheld shall now be added and put\n" +
				"into item 29 of form 1602.\n" +
				"Press Ok to do so; otherwise press Cancel.")) {
                var size = secBToCommit.length;
                secB = new Array();
                for (var i = 0 ; i < size ; i++) {
                    secB[i] = new SectionBC();
                    secB[i].SelTreatyCode = secBToCommit[i].SelTreatyCode;
                    secB[i].SelATC = secBToCommit[i].SelATC;
                    // sched1[i].SelATC = d.getElementById('drpATCCodeSecB'+i).value;
                    secB[i].txtAmtIncomePayment = d.getElementById('txtAmtIncomePaySecB' + i).value;
                    secB[i].TxtTaxRate = d.getElementById('txtRateSecB' + i).value;
                    secB[i].TxtRequiredWithheld = d.getElementById('txtReqWithheldSecB' + i).value;

                }
                var tblrow = d.getElementById('tbllistSecB');
                var totalSum = 0;
                for (var i = 0; i < tblrow.rows.length - 1 ; i++) {
                    totalSum = (totalSum * 1 + NumWithComma(d.getElementById('txtReqWithheldSecB' + i).value) * 1);
                }
                d.getElementById('frm1602:txt29').value = formatCurrency(totalSum * 1);
                compute33();
                cancelSecB();
            }
        }
    }

    function getATCdrpTaxRateSecB(i) {
        for (var j = 0; j < ATCnameCode.length ; j++) {
            if (d.getElementById('drpATCCodeSecB' + i).value == ATCnameCode[j]) {
                d.getElementById('txtRateSecB' + i).value = (taxRate[j] * 1).toFixed(2);
                return;
            } else {
                d.getElementById('txtRateSecB' + i).value = "0.00";
            }
        }
    }

    function getATCdrpTaxRateSecBReload(i) {
        for (var j = 0; j < ATCnameCode.length ; j++) {
            d.getElementById('txtRateSecB' + i).value = d.getElementById('txtRateSecB' + i).value;
        }
    }

    function getReqWithheldComputeSecB(numIndex) {
        d.getElementById('txtReqWithheldSecB' + numIndex).value = formatCurrency(NumWithComma(d.getElementById('txtAmtIncomePaySecB' + numIndex).value) * NumWithComma(d.getElementById('txtRateSecB' + numIndex).value) / 100);
    }

    function getATCdrpTaxRateSecC(i) {
        for (var j = 0; j < ATCnameCode.length ; j++) {
            if (d.getElementById('drpATCCodeSecC' + i).value == ATCnameCode[j]) {
                d.getElementById('txtRateSecC' + i).value = (taxRate[j] * 1).toFixed(2); return;
            } else {
                d.getElementById('txtRateSecC' + i).value = "0.00";
            }
        }
    }

