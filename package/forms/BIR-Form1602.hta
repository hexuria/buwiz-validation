            d.getElementById('frm1602:txt25C').disabled = false;


            for (var index = 1; index <= 10 ; index++) {

                d.getElementById('frm1602:txtReg' + index).disabled = false;
                d.getElementById('frm1602:txtForeign' + index).disabled = false;
                d.getElementById('frm1602:txtInst' + index).disabled = false;
            }
            d.getElementById('btnSectionB').disabled = false;
            d.getElementById('btnSectionC').disabled = false;
        }

        if (qs('xmlFileName') != null && qs('xmlFileName').indexOf('.xml') > -1) {
            d.getElementById('frm1602:MonthEnd').disabled = true;
            d.getElementById('frm1602:txtYear').disabled = true;
        }

        disableElem;
        enableElem;
		document.getElementById('frm1602:txtTIN1').disabled = true; document.getElementById('frm1602:txtTIN2').disabled = true; document.getElementById('frm1602:txtTIN3').disabled = true; document.getElementById('frm1602:txtBranchCode').disabled = true;
    }

    function getRdo() {
        var data = "<select class='iceSelOneMnu' id='frm1602:txtRDOCode' name='frm1602:txtRDOCode' size='1' ><option value='000'> </option>";

        for (var i = 0; i < rdoList.length; i++) {
            var rdo = rdoList[i];
            data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";

        }
        data = data + "</select>"

        $('#rdoSelect').html(data);

    }

    function initialValidateBeforeSave() {
        if ((d.getElementById('frm1602:txtTIN1').value == "" || d.getElementById('frm1602:txtTIN2').value == "" || d.getElementById('frm1602:txtTIN3').value == "" || d.getElementById('frm1602:txtBranchCode').value == "")) {
            alert("Please enter a valid TIN number on Item 5.");
            return false;
        }
        if ((d.getElementById('frm1602:txtRDOCode').value == "000")) {
            alert("Please enter a valid RDO Code on Item 6.");
            return false;
        }
        if ((d.getElementById('frm1602:txtTaxpayerName').value == "")) {
            alert("Please enter a valid Withholding Agent's Name on Item 8.");
            return false;
        }
        return true;
    }

