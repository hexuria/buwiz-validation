    function enablePartII() {
        for (var i = 14 ; i <= 25 ; i++) {
            if (i == 22) {
                d.getElementById('frm1602:txt' + i + 'A').disabled = false;
                d.getElementById('frm1602:txt' + i + 'D').disabled = false;
                d.getElementById('frm1602:txt' + i + 'G').disabled = false;
            } else {
                d.getElementById('frm1602:txt' + i + 'A').disabled = false;

            }
        }
        d.getElementById('frm1602:txt24C').disabled = false;
        d.getElementById('frm1602:txt25C').disabled = false;

        for (var index = 1; index <= 10 ; index++) {
            d.getElementById('frm1602:txtReg' + index).disabled = false;
            d.getElementById('frm1602:txtForeign' + index).disabled = false;
            d.getElementById('frm1602:txtInst' + index).disabled = false;

        }
    }

    function disablePartII() {
        for (var i = 14 ; i <= 25 ; i++) {
            if (i == 22) {
                d.getElementById('frm1602:txt' + i + 'A').disabled = true;
                d.getElementById('frm1602:txt' + i + 'D').disabled = true;
                d.getElementById('frm1602:txt' + i + 'G').disabled = true;
            } else {
                d.getElementById('frm1602:txt' + i + 'A').disabled = true;

            }
        }
        d.getElementById('frm1602:txt24C').disabled = true;
        d.getElementById('frm1602:txt25C').disabled = true;
    }
    function cancelAllCompute() {
        if (d.getElementById('frm1602:txt37').value > 0) {
            if (confirm("You are about to change the Value to NO. Doing this will clear the entries in Part II.\n" +
                "Do you wish to proceed?")) {
                for (var i = 14 ; i <= 25; i++) {
                    d.getElementById('frm1602:txt' + i + 'A').value = "0.00";
                    d.getElementById('frm1602:txt' + i + 'C').value = "0.00";
                }
                d.getElementById('frm1602:txt22D').value = "0.00";
                d.getElementById('frm1602:txt22G').value = "0.00";
                d.getElementById('frm1602:txt22F').value = "0.00";
                d.getElementById('frm1602:txt22I').value = "0.00";
                d.getElementById('frm1602:txt24C').value = "0.00";
                d.getElementById('frm1602:txt25C').value = "0.00";
                d.getElementById('frm1602:txt24D').value = "0.00";
                d.getElementById('frm1602:txt25D').value = "0.00";
                d.getElementById('frm1602:txt29').value = "0.00";
                d.getElementById('frm1602:txt32').value = "0.00";
                secB = new Array();
                secC = new Array();
                getCommittedSecC();
                getCommittedSecB();

                compute26();
                for (var index = 1; index <= 10 ; index++) {
                    d.getElementById('frm1602:txtReg' + index).value = "0.00";
                    d.getElementById('frm1602:txtForeign' + index).value = "0.00";
                    d.getElementById('frm1602:txtInst' + index).value = "0.00";

                    d.getElementById('frm1602:txtReg' + index).disabled = true;
                    d.getElementById('frm1602:txtForeign' + index).disabled = true;
                    d.getElementById('frm1602:txtInst' + index).disabled = true;
                }
                computeSchedule1();
                disablePartII();
            } else {
                d.getElementById('frm1602:OptTaxWithheld1').checked = true;
            }
        } else {
            for (var index = 1; index <= 10 ; index++) {
                d.getElementById('frm1602:txtReg' + index).value = "0.00";
                d.getElementById('frm1602:txtForeign' + index).value = "0.00";
                d.getElementById('frm1602:txtInst' + index).value = "0.00";

                d.getElementById('frm1602:txtReg' + index).disabled = true;
                d.getElementById('frm1602:txtForeign' + index).disabled = true;
                d.getElementById('frm1602:txtInst' + index).disabled = true;

            }
            computeSchedule1();
            disablePartII();
        }
    }

    function checkifFieldEmptySecB() {
        var size = secBToCommit.length;


        for (var i = 0 ; i < size ; i++) {
            if (secBToCommit[i].SelTreatyCode <= 0) {
                alert("Please choose a Treaty Code on the list."); return;
            }
            if (secBToCommit[i].SelATC <= 0) {
                alert("Please choose an ATC on the list."); return;
            }

            if (d.getElementById('txtAmtIncomePaySecB' + i).value == 0) {
                alert("Please enter amount in Total Interest."); return;
            }
        }

        return true;
    }

    function checkifFieldEmptySecC() {
        var size = secCToCommit.length;

        for (var i = 0 ; i < size ; i++) {
            if (secCToCommit[i].SelTreatyCode <= 0) {
                alert("Please select Treaty Code on the list."); return;
            }
            if (secCToCommit[i].SelATC <= 0) {
                alert("Please select ATC Code on the list."); return;
            }
            if (d.getElementById('txtAmtIncomePaySecC' + i).value == 0) {
                alert("Please enter amount in Total Interest."); return;
            }
        }
        return true;
    }

    var tempPreviousindex = 0;
    function deleteDatainSection() {
        secBSize = secBToCommit.length;
        secCSize = secCToCommit.length;
        if (d.getElementById('frm1602:lstSpecialTax').value == 1) {
            if (secBSize > 0) {
                if (confirm("You are about to change the value of Item 13. Doing this will clear the entries \n" +
                    "in Section B.\n" +
                    "Do you wish to proceed?")) {
                    d.getElementById('frm1602:txt29').value = "0.00";
                    secB = new Array();
                    getCommittedSecB();
                    tempPreviousindex = 1;
                } else {
                    d.getElementById('frm1602:lstSpecialTax').selectedIndex = tempPreviousindex;
                }
            }


        } else if (d.getElementById('frm1602:lstSpecialTax').value == 2) {
            if (secCSize > 0) {
                if (confirm("You are about to change the value of Item 13. Doing this will clear the entries \n" +
                    "in Section C.\n" +
                    "Do you wish to proceed?")) {

                    d.getElementById('frm1602:txt32').value = "0.00";
                    secC = new Array();
                    getCommittedSecC();
                    tempPreviousindex = 2;
                } else {

                    d.getElementById('frm1602:lstSpecialTax').selectedIndex = tempPreviousindex;
                }
            }
        } else if (d.getElementById('frm1602:lstSpecialTax').value == 0) {
            d.getElementById('frm1602:OptSpecialTax2').checked = true;
            d.getElementById('frm1602:lstSpecialTax').disabled = true;
            d.getElementById('frm1602:txt29').value = "0.00";
            d.getElementById('frm1602:txt32').value = "0.00";
            secB = new Array();
            secC = new Array();
            getCommittedSecC();
            getCommittedSecB();

            tempPreviousindex = 0;
        } else if (d.getElementById('frm1602:lstSpecialTax').value == 3) {
            tempPreviousindex = 3;
        }

        compute33();

    }
    function computeTaxWithheld(index) {
        d.getElementById('frm1602:txt' + index + 'C').value = formatCurrency(NumWithComma(d.getElementById('frm1602:txt' + index + 'A').value) * NumWithComma(d.getElementById('hdntxt' + index).value));
        compute26();
    }
    function computeTaxWithheldForeign(index) {
        d.getElementById('frm1602:txt' + index + 'D').value = formatCurrency(NumWithComma(d.getElementById('frm1602:txt' + index + 'A').value) * NumWithComma(d.getElementById('hdntxt' + index).value) * NumWithComma(d.getElementById('frm1602:txt' + index + 'C').value));
        compute26();
    }
    function computeTaxWithheld22F() {
        d.getElementById('frm1602:txt22F').value = formatCurrency(NumWithComma(d.getElementById('frm1602:txt22D').value) * NumWithComma(d.getElementById('hdntxt22E').value));
        compute26();
    }

    function computeTaxWithheld22I() {
        d.getElementById('frm1602:txt22I').value = formatCurrency(NumWithComma(d.getElementById('frm1602:txt22G').value) * NumWithComma(d.getElementById('hdntxt22H').value));
        compute26();
    }

    function compute26() {
        var txt26 = 0;
        for (var i = 14 ; i <= 23; i++) {
            txt26 = txt26 + NumWithComma(d.getElementById('frm1602:txt' + i + 'C').value) * 1;
        }
        d.getElementById('frm1602:txt26').value = formatCurrency(txt26 + NumWithComma(d.getElementById('frm1602:txt22F').value) * 1 + NumWithComma(d.getElementById('frm1602:txt22I').value) * 1 + NumWithComma(d.getElementById('frm1602:txt24D').value) * 1 + NumWithComma(d.getElementById('frm1602:txt25D').value) * 1);
        compute33();
    }

    function compute33() {
        d.getElementById('frm1602:txt33').value = formatCurrency(NumWithComma(d.getElementById('frm1602:txt26').value) * 1 + NumWithComma(d.getElementById('frm1602:txt29').value) * 1 + NumWithComma(d.getElementById('frm1602:txt32').value) * 1);
        compute35();
    }

    function compute35() {
        d.getElementById('frm1602:txt35').value = formatCurrency(NumWithComma(d.getElementById('frm1602:txt33').value) * 1 - NumWithComma(d.getElementById('frm1602:txt34').value) * 1);
        compute37();
    }

    function computePenalties() {
        d.getElementById("frm1602:txt36D").value = formatCurrency(NumWithComma(d.getElementById("frm1602:txt36A").value) * 1 + NumWithComma(d.getElementById("frm1602:txt36B").value) * 1 + NumWithComma(d.getElementById("frm1602:txt36C").value) * 1);
        compute37();
    }

    function compute37() {
        d.getElementById('frm1602:txt37').value = formatCurrency(NumWithComma(d.getElementById('frm1602:txt36D').value) * 1 + NumWithComma(d.getElementById('frm1602:txt35').value) * 1);
        capital();
    }

    function computeSchedule1() {
        var txtTotalReg = 0;
        var txtTotalForeign = 0;
        var txtTotalSum = 0;
        var txtTotalInst = 0;
        for (var i = 1 ; i <= 10; i++) {
            d.getElementById('frm1602:txtTotal' + i + 'C').value = formatCurrency(NumWithComma(d.getElementById('frm1602:txtReg' + i).value) + NumWithComma(d.getElementById('frm1602:txtForeign' + i).value));
            txtTotalReg = txtTotalReg + NumWithComma(d.getElementById('frm1602:txtReg' + i).value);
            txtTotalForeign = txtTotalForeign + NumWithComma(d.getElementById('frm1602:txtForeign' + i).value);
            txtTotalSum = txtTotalSum + NumWithComma(d.getElementById('frm1602:txtTotal' + i + 'C').value);
            txtTotalInst = txtTotalInst + NumWithComma(d.getElementById('frm1602:txtInst' + i).value);

        }
        d.getElementById('frm1602:txtTotalA').value = formatCurrency(txtTotalReg);
        d.getElementById('frm1602:txtTotalB').value = formatCurrency(txtTotalForeign);
        d.getElementById('frm1602:txtTotalC').value = formatCurrency(txtTotalSum);
        d.getElementById('frm1602:txtTotalD').value = formatCurrency(txtTotalInst);
    }

    function validateYear() {

        if (d.getElementById("frm1602:txtYear").value > 2017) {
            alert("Please use newer version if you wish to file for year 2018 and up.");
            d.getElementById("frm1602:txtYear").value = "2017";
        }
    }

    function validate() {
        var dt = new Date();
        if (d.getElementById('frm1602:txtYear').value == "") {
            alert("Please enter a valid year on Item 1."); return;
        }
        /*if( d.getElementById('frm1602:txtYear').value*1 > dt.getFullYear()*1   )
        {
            alert("Invalid date entry on Item no.1. Entry should not be later than Current Date.")
            return;
        }
		if(d.getElementById('frm1602:MonthEnd').selectedIndex > dt.getMonth() && d.getElementById('frm1602:txtYear').value == dt.getFullYear())
		{
			alert("Invalid date entry on Item no.1. Entry should not be later than Current Date."); return;
		}*/
        if (d.getElementById('frm1602:txtYear').value * 1 < 1900) {
            alert("Invalid date entry on Item no.1. Entry should not be lower than 1900.")
            return;
        }
        if (d.getElementById('frm1602:OptTaxWithheld1').checked == false && d.getElementById('frm1602:OptTaxWithheld2').checked == false) {
            alert("Please select an option for Item 4."); return;
        }

        if ((d.getElementById('frm1602:txtTIN1').value == "" || d.getElementById('frm1602:txtTIN2').value == "" || d.getElementById('frm1602:txtTIN3').value == "" || d.getElementById('frm1602:txtBranchCode').value == "")) {
            alert("Please enter a valid TIN number on Item 5.");
            return;
        }
        //if( (d.getElementById('frm1602:txtRDOCode').value == "")  )
        if ((d.getElementById('frm1602:txtRDOCode').selectedIndex == 0)) {
            alert("Please enter a valid RDO Code on Item 6.");
            return;
        }
        if ((d.getElementById('frm1602:txtLineBus').value == "")) {
            alert("Please enter a valid Line of Business/Occupation on Item 7.");
            return;
        }
        if ((d.getElementById('frm1602:txtTaxpayerName').value == "")) {
            alert("Please enter a valid Taxpayer Name on Item 8.");
            return;
        }
        if ((d.getElementById('frm1602:txtTelNum').value == "")) {
            alert("Please enter a valid Telephone Number on Item 9.");
            return;
        }
        if ((d.getElementById('frm1602:txtAddress').value == "")) {
            alert("Please enter Taxpayer's Registered Address on Item 10.");
            return;
        }
        if ((d.getElementById('frm1602:txtZipCode').value == "")) {
            alert("Please enter Taxpayer's Zip Code on Item 11.");
            return;
        }
        if (d.getElementById('frm1602:OptCategoryAgent1').checked == false && d.getElementById('frm1602:OptCategoryAgent2').checked == false) {
            alert("Please select an option for Item 12."); return;
        }
        if (d.getElementById('frm1602:OptTaxWithheld1').checked == true) {
            if (d.getElementById('frm1602:txt33').value == 0) {
                alert("Please fill up Part II Computation of Tax if item 4 is set to Yes."); return;
            }
        }
        if (d.getElementById('frm1602:lstSpecialTax').value == 1) {
            if (d.getElementById('tbodyllistSecC').innerHTML == "") {
                alert("Special Treaty has been selected under item 13. Please enter values for C. Details of Interest Payment\n" +
                    "to Taxpayers enjoying Preferential Rates (i.e. PEZA Registered Enterprises)."); return;
            }
            if (d.getElementById('frm1602:txt32').value == 0) {
                alert("Please select a value for Section C when Item 13 is Special Rate or Both"); return;
            }
        }
        if (d.getElementById('frm1602:lstSpecialTax').value == 2) {
            if (d.getElementById('tbodyllistSecB').innerHTML == "") {
                alert("International Tax Treaty has been selected under item 13. Please enter values for B. Details of Interest\n" +
                    "Payment and Tax Withheld Based on Tax Treaty Rates."); return;
            }
            if (d.getElementById('frm1602:txt29').value == 0) {
                alert("Please select a value for Section B when Item 13 is International Tax Treaty or Both"); return;
            }
        }
        if (d.getElementById('frm1602:lstSpecialTax').value == 3) {
            if (d.getElementById('tbodyllistSecB').innerHTML == "" && d.getElementById('tbodyllistSecC').innerHTML == "") {
                alert("Both has been selected under item 13. Please enter values for Section B and C by clicking on the link\n" +
                    "for Section B and C."); return;
            }
            if (d.getElementById('frm1602:txt29').value == 0 || d.getElementById('frm1602:txt32').value == 0) {
                alert("Please fill up Sections B and C since Item 13 is set to 'Both'."); return;
            }
        }
        disableAllControl();

        alert("Validation successful. Click on 'Edit' if you wish to modify your entries.");
        return;
    }

