    function onchangeATCrowC() {
        /*This will programatically fire onchange for Select-one in modal*/
        var response = d.getElementById("response");
        var elem = document.getElementById('frmMain').elements;
        for (var i = 0; i < elem.length; i++) {
            if (String(elem[i].id).indexOf('drpTreatyCodeSecC') != -1 || String(elem[i].id).indexOf('drpATCCodeSecC') != -1)
