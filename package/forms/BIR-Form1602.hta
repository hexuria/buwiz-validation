    function showSection(Section) {
        if (d.getElementById('btnSectionB').disabled == false) {
            if (checkiftaxwheld(Section) == true) {
                if (Section == "SecB") {
                    //d.getElementById('mainContent').style.display = "inline";
                    //d.getElementById('modalSectionB').style.display = "block";
                    d.getElementById('wrapper').style.display = "none";
                    $('#modalSectionB').show('blind');
                } else {
                    //d.getElementById('mainContent').style.display = "inline";
                    //d.getElementById('modalSectionC').style.display = "block";
                    d.getElementById('wrapper').style.display = "none";
                    $('#modalSectionC').show('blind');
                }
            } else {
                alert(checkiftaxwheld(Section));
            }

            if (viewForm) {
                // SECTION B
                var size = secBToCommit.length;
                for (var i = 0 ; i < size ; i++) {
                    setTimeout("d.getElementById('drpTreatyCodeSecB" + i + "').disabled = true;", 100);
                    setTimeout("d.getElementById('drpATCCodeSecB" + i + "').disabled = true;", 100);
                    setTimeout("d.getElementById('txtAmtIncomePaySecB" + i + "').disabled = true;", 100);
                    setTimeout("d.getElementById('txtRateSecB" + i + "').disabled = true;", 100);
                    setTimeout("d.getElementById('txtReqWithheldSecB" + i + "').disabled = true;", 100);
                }
                // SECTION C
                size = secCToCommit.length;
                for (i = 0 ; i < size ; i++) {
                    setTimeout("d.getElementById('drpTreatyCodeSecC" + i + "').disabled = true;", 100);
                    setTimeout("d.getElementById('drpATCCodeSecC" + i + "').disabled = true;", 100);
                    setTimeout("d.getElementById('txtAmtIncomePaySecC" + i + "').disabled = true;", 100);
                    setTimeout("d.getElementById('txtRateSecC" + i + "').disabled = true;", 100);
                    setTimeout("d.getElementById('txtReqWithheldSecC" + i + "').disabled = true;", 100);
                }

                setTimeout("d.getElementById('btnAddSecB').disabled = true;", 100);
                setTimeout("d.getElementById('btnDeleteSecB').disabled = true;", 100);
                setTimeout("d.getElementById('btnOkPopSecB').disabled = true;", 100);
                setTimeout("d.getElementById('btnAddSecC').disabled = true;", 100);
                setTimeout("d.getElementById('btnDeleteSecC').disabled = true;", 100);
                setTimeout("d.getElementById('btnOkPopSecC').disabled = true;", 100);
            }
        }
        else {
            return false;
        }
    }

    function checkiftaxwheld(Section) {


        if (Section == "SecB") {
            if (d.getElementById('frm1602:OptTaxWithheld1').checked == true) {
                if (d.getElementById('frm1602:lstSpecialTax').value == 2 || d.getElementById('frm1602:lstSpecialTax').value == 3) {
                    return true;
                }
            } return "Section B is only enabled if Item 4 is set to Yes and Item 13 is set to Yes - International Tax Treaty or\nBoth.";
        } else if (Section == "SecC") {
            if (d.getElementById('frm1602:OptTaxWithheld1').checked == true) {
                if (d.getElementById('frm1602:lstSpecialTax').value == 1 || d.getElementById('frm1602:lstSpecialTax').value == 3) {
                    return true;
                }
            } return "Section C is only enabled if Item 4 is set to Yes and Item 13 is set to Yes - Special Rate or\nBoth.";
        }


    }

