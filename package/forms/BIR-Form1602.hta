    function deletelistSecB() {
        var secBTemp = new Array();
        var i = 0;
        var size = secBToCommit.length;
        for (i = 0 ; i < size ; i++) {
            //secBToCommit[i].SelTreatyCode = d.getElementById('drpTreatyCodeSecB'+i).selectedIndex;
            //secBToCommit[i].SelATC = d.getElementById('drpATCCodeSecB'+i).selectedIndex;
            secBToCommit[i].txtAmtIncomePayment = d.getElementById('txtAmtIncomePaySecB' + i).value;
            secBToCommit[i].TxtTaxRate = d.getElementById('txtRateSecB' + i).value;
            secBToCommit[i].TxtRequiredWithheld = d.getElementById('txtReqWithheldSecB' + i).value;
        }
        i = 0;
        for (var j = 0; j < size ; j++) {
            if (!d.getElementById("chxSecB" + j).checked) {
                secBTemp[i++] = secBToCommit[j];
            }
        }

        if (secBTemp.length > 0) {
            secBToCommit = new Array();
            secBToCommit = secBTemp;
            //d.getElementById("tbodyllistSecB").innerHTML = "";
            $('#tbodyllistSecB').html("");

            for (i = 0; i < secBTemp.length; i++) {
                secBToCommit[i] = secBTemp[i];
                //d.getElementById("tbodyllistSecB").innerHTML += "<tr>" +				
                $('#tbodyllistSecB').html(d.getElementById('tbodyllistSecB').innerHTML + "<tr>" +
                    "<td> <input type='checkbox' class='printButtonClass' id='chxSecB" + i + "' /> </td>" +
                    "<td align='left'> <select  id='drpTreatyCodeSecB" + i + "' style='width: 150px' onchange='setTreatyCodeSecB(" + i + ")' ></select> </td>" +
                    "<td align='left'> <select id='drpATCCodeSecB" + i + "' style='width: 240px' onchange='setATCCodeSecB(" + i + ");getATCdrpTaxRateSecB(" + i + ");getReqWithheldComputeSecB(" + i + ");' ></select></td> " +
