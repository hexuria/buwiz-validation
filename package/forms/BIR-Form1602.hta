    function deletelistSecC() {
        var SecCTemp = new Array();
        var i = 0;
        var size = secCToCommit.length;
        for (i = 0 ; i < size ; i++) {
            //secCToCommit[i].SelATC = d.getElementById('drpATCCodeSecC'+i).selectedIndex;
            secCToCommit[i].txtAmtIncomePayment = d.getElementById('txtAmtIncomePaySecC' + i).value;
            secCToCommit[i].TxtTaxRate = d.getElementById('txtRateSecC' + i).value;
            secCToCommit[i].TxtRequiredWithheld = d.getElementById('txtReqWithheldSecC' + i).value;
        }
        i = 0;
        for (var j = 0; j < size ; j++) {
            if (!d.getElementById("chxSecC" + j).checked) {
                SecCTemp[i++] = secCToCommit[j];
            }
        }

        if (SecCTemp.length > 0) {
            secCToCommit = new Array();
            secCToCommit = SecCTemp;
            //d.getElementById("tbodyllistSecC").innerHTML = "";
            $('#tbodyllistSecC').html("");

            for (i = 0; i < SecCTemp.length; i++) {
                secCToCommit[i] = SecCTemp[i];
                //d.getElementById("tbodyllistSecC").innerHTML += "<tr>" +
                $('#tbodyllistSecC').html(d.getElementById('tbodyllistSecC').innerHTML + "<tr>" +
