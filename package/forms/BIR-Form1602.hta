                    "<td><input type='text' style='text-align:right' id='txtRateSecB" + i + "' value='" + secBToCommit[i].TxtTaxRate + "' onblur='round(this,2);getReqWithheldComputeSecB(" + i + ")' size='8' onkeypress='return numbersonly(this, event)' maxlength='25' /> </td>" +
                    "<td><input type='text' id='txtReqWithheldSecB" + i + "' value='" + secBToCommit[i].TxtRequiredWithheld + "' size='16' maxlength='25' style='background-color: rgb(220, 220, 220); text-align:right' /> </td> ");


                addTreatyCodeInDropDownSecB(i, secBToCommit[i].SelTreatyCode);
                addATCCodeInDropDownSecB(i, secBToCommit[i].SelATC);
                setTimeout("d.getElementById('txtReqWithheldSecB" + i + "').disabled = true;" +
                    "setInputTextControl_HorizontalAlignment('txtReqWithheldSecB" + i + "',4 );" +
                    "setInputTextControl_HorizontalAlignment('txtRateSecB" + i + "',4 );" +
                    "setInputTextControl_HorizontalAlignment('txtAmtIncomePaySecB" + i + "',4 ) ", 100);

                //    setTimeout("setInputTextControl_NumberFormatter('txtReqWithheldSecB"+i+"',12,2);" +
                //        "setInputTextControl_NumberFormatter('txtRateSecB"+i+"',12,2);" +
                //        "setInputTextControl_NumberFormatter('txtAmtIncomePaySecB"+i+"',12,2) ",100);

            }
        } else {
            secBToCommit = new Array();
            //d.getElementById("tbodyllistSecB").innerHTML = "";
            $('#tbodyllistSecB').html("");
        }

    }

