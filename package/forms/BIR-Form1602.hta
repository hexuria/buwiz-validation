        <!-- Section  B -->
		 <div id="modalSectionB"  class="printSignFooterClass printButtonClass" style="width:94%; display:none; height:50%; position:fixed; top:3%; left:3%; right:auto; overflow-y:auto; background:#e2e2e2;" align="center"> 
            <br/>
            <br/>
			<div class="modalColumnHeader" style="width: 90%" align="center">
				<table border="1" cellspacing="0" cellpadding="0" width="90%">
					<tr>
						<td class="modalHeader" align="left"><span id="label1"><b>Please click a check box to select and deselect an ATC.</b><span></td>
					</tr>
					<tr>
						<td class="modalHeader"><b>B. Details of Interest Payments and Tax Withheld based on Tax Treaty Rates</b></td>
					</tr>
				</table>
            
                <table id="tbllistSecB"  cellspacing="0" cellpadding="0" width="90%" border="1">
                    <tr><td width="4%">&nbsp;  </td>
                        <td width='20%'> Treaty Code </td>
                        <td width='50%'> ATC </td>
                        <td width='8%'> Total Interest </td>
                        <td width='8%'> Tax Rate (%) </td>
                        <td width='10%'> Tax Required to be Withheld </td>
                    </tr>
                    <tbody id="tbodyllistSecB"></tbody>

                </table>
            </div>
            <table class="modalContent" align="center">
                <tr>
                    <td><input type='button' class='printButtonClass' id="btnAddSecB" value='Add' onclick="addlistSecB()" /><input type='button' class='printButtonClass' id="btnDeleteSecB" value='Delete' onclick="    deletelistSecB()" />  </td>
                </tr>
            </table>
            <br/><br /><br />
			<div align="center">
				<input type="button" class="printButtonClass" name="btnOkPopSecB" id="btnOkPopSecB" style="width:120px; height:30px;" value="OK" onclick="getSecB(false)"  />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
				<input type="button" class="printButtonClass" name="btnCancelPopSecB" id="btnCancelPopSecB" style="width:120px; height:30px;" value="CANCEL"  onclick="cancelSecB()" />
			</div>
        </div>

        <!-- Section  C -->
		 <div id="modalSectionC" class="printSignFooterClass printButtonClass" style="width:94%; display:none; height:50%; position:fixed; top:3%; left:3%; right:auto; overflow-y:auto; background:#e2e2e2;" align="center"> 
            <br/>
            <br/>

			<div class="modalColumnHeader" style="width: 90%" align="center">
            <table border="1" cellspacing="0" cellpadding="0" width="90%">
				<tr>
                    <td class="modalHeader" align="left"><span id="label2"><b>Please click a check box to select and deselect an ATC.</b></span></td>
                </tr>
                <tr>
                    <td class="modalHeader"><b>C. Details of Interest Payments to Taxpayers enjoying Preferential Rates<br/>(i.e. Peza Registered Enterprises)</b></td>
                </tr>
            </table>
            
                <table id="tbllistSecC"  cellspacing="0" cellpadding="0" width="90%" border="1">
                    <tr><td width="4%">&nbsp;  </td>
                        <td width='20%'> Treaty Code </td>
