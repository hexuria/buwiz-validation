    function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = "";
            } else {
                var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag			
            }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug				
            loadBGData();	/*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = "";
        }
    }

    function loadBGData() {
        /*This will load data onto Background Information fields*/
        var responseBG = d.getElementById("responseBG");

        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '1602') {

            var fnVal = String(responseBG.innerHTML).split('fn=');
            d.getElementById('frm1602:txtTaxpayerName').value = unescape(fnVal[1]);

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            d.getElementById('frm1602:txtTIN1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            d.getElementById('frm1602:txtTIN2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            d.getElementById('frm1602:txtTIN3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            d.getElementById('frm1602:txtBranchCode').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm1602:txtRDOCode').value = rdoVal[1];

            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm1602:txtLineBus').value = unescape(lobVal[1]);

            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
            d.getElementById('frm1602:txtAddress').value = unescape(regAddrVal[1]);

            var zipVal = String(responseBG.innerHTML).split('zip=');
            d.getElementById('frm1602:txtZipCode').value = zipVal[1];

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            d.getElementById('frm1602:txtTelNum').value = telNoVal[1];
        }
        var emailVal = String(responseBG.innerHTML).split('email=');
        if (emailVal[1] === undefined) {
            document.getElementById('txtEmail').value = "";
        }
        else {
            document.getElementById('txtEmail').value = emailVal[1];
            globalEmail = emailVal[1];
        }
    }
    function createXMLProfileName() {
        try {
            var xmlFileName = "";

            var titleTin1 = d.getElementById('frm1602:txtTIN1');
            var titleTin2 = d.getElementById('frm1602:txtTIN2');
            var titleTin3 = d.getElementById('frm1602:txtTIN3');
            var titleBranchCode = d.getElementById('frm1602:txtBranchCode');
            var titleTPName = d.getElementById('frm1602:txtTaxpayerName');
            var formType = "1602";

            xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";

            return xmlFileName;
        } catch (e) {
            alert('Exception : ' + e.description);
        }
    }

    function saveXMLProfile(isFinalCopy) {

        if (gIsReadOnly == false) {
            var xmlFileName = createXMLProfileName();

            msg.innerHTML = 'Generating File...';
            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFile = fileSys.CreateTextFile(xmlFileName); //(saveWhere);

            var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break			

            allXML += "<div>fn=" + escape(d.getElementById('frm1602:txtTaxpayerName').value) + "fn=</div>" + tab;
            allXML += "<div>tin1=" + d.getElementById('frm1602:txtTIN1').value + "tin1=</div>" + tab;
            allXML += "<div>tin2=" + d.getElementById('frm1602:txtTIN2').value + "tin2=</div>" + tab;
            allXML += "<div>tin3=" + d.getElementById('frm1602:txtTIN3').value + "tin3=</div>" + tab;
            allXML += "<div>tin4=" + d.getElementById('frm1602:txtBranchCode').value + "tin4=</div>" + tab;
            allXML += "<div>rdo=" + d.getElementById('frm1602:txtRDOCode').value + "rdo=</div>" + tab;
            allXML += "<div>lob=" + escape(d.getElementById('frm1602:txtLineBus').value) + "lob=</div>" + tab;
            allXML += "<div>regAddr=" + escape(d.getElementById('frm1602:txtAddress').value) + "regAddr=</div>" + tab;
            allXML += "<div>zip=" + d.getElementById('frm1602:txtZipCode').value + "zip=</div>" + tab;
            allXML += "<div>telNo=" + d.getElementById('frm1602:txtTelNum').value + "telNo=</div>" + tab;
            allXML += "<div>email=" + document.getElementById('txtEmail').value + "email=</div>" + tab;allXML += "<div>confirmemail=" + document.getElementById('txtEmail').value + "confirmemail=</div>" + tab;
			 allXML += "<div>confirmtin1=" + d.getElementById('frm1602:txtTIN1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm1602:txtTIN2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm1602:txtTIN3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm1602:txtBranchCode').value + "confirmtin4=</div>" + tab;
            allXML += "<div>formType=1602formType=</div>" + tab;

            allXML += tab + d.getElementById('xmlClose').innerHTML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (isFinalCopy == false) {
                alert('Background information saved/updated successfully as : ' + xmlFileName);
            }
        }
    }
    function cancel() {
        $('#bg').show();

        $('.printSignFooterClass').css({ 'width': '94%', 'display': 'none', 'height': '50%', 'position': 'fixed', 'top': '3%', 'left': '3%', 'right': 'auto', 'overflow-y': 'auto', 'background': '#e2e2e2' });
