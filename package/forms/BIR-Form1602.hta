<script type="text/javascript">
    var isSubmitFinal = false;
    var isSubmit = false;

    var gIsReadOnly = false;

    var atcList = new Array();
    var atcCount = 0;
    var treatyList = new Array();
    var treatyCount = 0;

    var max_number = 10;

    var fileName = "";
    var existingXMLFileName = "";
    var fileNameToExport = "";

    var savedReturn = "";
    var p3Compromise = "";
    var p3Surcharge = "";
    var p3Interest = "";
    var p3IsAmended = "";
    var p3FilingDate = "";
    var p3ReturnPeriod = "";
    var p3ReturnPeriodEnd = "";

    var p3BasicTax = "";
    var p3TotalPenalties = "";
    var p3TotalAmountPayable = "";

    var p3TPTIN1 = "";
    var p3TPTIN2 = "";
    var p3TPTIN3 = "";
    var p3TPTIN = "";
    var p3TPBranchCode = "";
    var p3TPRDOCode = "";
    var p3TPLineBus = "";
    var p3TPName = "";
    var p3TPTelNum = "";
    var p3TPAddress = "";
    var p3TPZip = "";


    function atcPropertyJS(formType, atcCode, description, rate, category, base, compType, constTaxDue, minimum, maximum) {
        this.formType = formType;
        this.atcCode = atcCode;
        this.description = description;
        this.rate = rate;
        this.category = category;
        this.base = base;
        this.compType = compType;
        this.constTaxDue = constTaxDue;
        this.minimum = minimum;
        this.maximum = maximum;
    }

    function treatyPropertyJS(treatyCode, description) {
        this.treatyCode = treatyCode;
        this.description = description;
    }

    /*----------------------------------*/
    var d = document, XMLBGFile = '', data = '', XMLFile = '', XMLATCFile = '', XMLTreatyCdFile = '', msg = d.getElementById('msg'), flagB = true, flagC = true;
    var loader = d.getElementById('loader');
    /*----------------------------------*/

    function SectionBC() {
        this.SelTreatyCode = -1;
        this.SelATC = -1;
        this.txtAmtIncomePayment = '0.00';
        this.TxtTaxRate = '0.00';
        this.TxtRequiredWithheld = '0.00';
    }

    var viewForm = false;
    var secB = new Array();
    var secC = new Array();
    var secBToCommit = new Array();
    var secCToCommit = new Array();

    var TreatynameCode = new Array();
    var TreatynameDesc = new Array();
    setTimeout("sleeptime()", 300);
    var globalEmail = "";
    function sleeptime() {
		
        loadXMLATC('xml/atcCodes.xml');
        loadXMLTreaty('xml/treatyCodes.xml');
        init();

        var bgFileName = qs('xmlBGInfoFileName');
        if (bgFileName != null && bgFileName.indexOf('.xml') > -1) {
            loadBGXML(bgFileName);

        }

        fileName = qs('xmlFileName');
        if (fileName != null && fileName.indexOf('.xml') > -1) {
            var tin = fileName.split("/")[1].split("-");
            loadBGXML("profile/" + tin[0] + ".xml");
            loadXML(fileName);

            d.getElementById('frm1602:MonthEnd').disabled = true;
            d.getElementById('frm1602:txtYear').disabled = true;


            existingXMLFileName = fileName;
            if (gIsReadOnly) {
                window.setTimeout("disableAllElementIDs(); d.getElementById('btnUpload').disabled = false;", 1000);
                window.setTimeout("d.getElementById('btnSectionB').disabled = false;", 1000);
                window.setTimeout("d.getElementById('btnSectionC').disabled = false;", 1000);
                window.setTimeout("d.getElementById('btnCancelPopSecB').disabled = false;", 1000);
                window.setTimeout("d.getElementById('btnCancelPopSecC').disabled = false;", 1000);
            }
            //loadXMLWellFormed("savefile/1602_wellformed.xml");			
        } else {
            window.setTimeout("$('#loader').hide('blind');", 100);
        }

        if ($('#printMenu').css('display') != 'none') {
            $('#printMenu').hide('blind');
        }
		document.getElementById('frm1602:txtTIN1').disabled = true; document.getElementById('frm1602:txtTIN2').disabled = true; document.getElementById('frm1602:txtTIN3').disabled = true; document.getElementById('frm1602:txtBranchCode').disabled = true;
		 window.setTimeout("checkFinalCopyBtn('1602')", 2000);
	
	}

    function rdoPropertyJS(rdoCode, description) {
        this.rdoCode = rdoCode;
        this.description = description;
    }

    var rdoList = new Array();

    /*Dev Note: First test all alerts
	function loadXMLWellFormed(loadWhere) {
		try {
			//This will load the file with filename loadWhere if it exists
			var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
			XMLFile = fsoXML.OpenTextFile(loadWhere,1);	
	
			if (XMLFile.AtEndOfStream)
				data = "";
			else {
				var responseWF = d.getElementById('responseWF'); //render file and write to hidden div
				responseWF.innerHTML = XMLFile.ReadAll(); //remove XML tag
			}
			XMLFile.Close(); //alert( responseWF.innerHTML ); //Debug			
			loadWFData();
		} catch(e) {
			alert('Exception Thrown: '+e.message);
		}	
	}*/

    function loadXMLWellFormed(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere, 1);

            if (XMLFile.AtEndOfStream)
                data = "";
            else {
                var response = d.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug			
            loadWFData();	/*This will load data onto fields*/


            if (response.innerHTML.indexOf("All Rights Reserved BIR 2012.0") >= 0) {
                gIsReadOnly = true;
            }

            if (gIsReadOnly) {
                d.getElementById('frm0602:cmdValidate').disabled = true;
                d.getElementById('btnSave').disabled = true;
            }

            /*-------------SecB:  Find Instances of Dynamic Rows within the XML and add to modal-----------*/
            //5-27-2012
            flagB = false; //added param for loading - false
            var countB = 0;
            var responsesB = d.getElementById('response').getElementsByTagName('*');
            var bPar = 'chxSecB'; //modal section B	

            do {
                if (responsesB.item(countB).tagName.indexOf('/') == -1 && responsesB.item(countB).tagName.indexOf(bPar.toUpperCase()) != -1) {
                    var temp = String(responsesB.item(countB).tagName);
                    temp = temp.substring(0, bPar.length + 1); //substring to length of search param for index - check files				
                    temp = temp.substring(bPar.length, bPar.length + 1); //get the last character for checking				
                    if (!isNaN(temp)) addlistSecBReload(); //if last char is a number, add modal section
                }
                countB++;
            } while (countB != responsesB.length);

            /*--------------------------------------------------------------------------------------*/
            //window.setTimeout("loadWFData();",410);
            //window.setTimeout("loadWFDataATCRow()",450); //read onchangeATCrowC();		
            //window.setTimeout("onchangeATCrowB()",500);
            //window.setTimeout("getSecB(true)",550);
            //window.setTimeout("flagB=true",600);	
            loadWFData();
            loadWFDataATCRow();
            onchangeATCrowB();
            getSecB(true);
            flagB = true;

            //Apparently the action after loading must be commited, we programatically auto-click the OK button - getSecB(true)

            /*-------------SecC:  Find Instances of Dynamic Rows within the XML and add to modal-----------*/
            //5-27-2012
            flagC = false; //added param for loading - false
            var countC = 0;
            var responsesC = d.getElementById('response').getElementsByTagName('*');
            var cPar = 'chxSecC'; //modal section C		

            do {
                if (responsesC.item(countC).tagName.indexOf('/') == -1 && responsesC.item(countC).tagName.indexOf(cPar.toUpperCase()) != -1) {
                    var temp = String(responsesC.item(countC).tagName);
                    temp = temp.substring(0, cPar.length + 1); //substring to length of search param for index - check files
                    temp = temp.substring(cPar.length, cPar.length + 1); //get the last character for checking
                    if (!isNaN(temp)) addlistSecCReload(); //if last char is a number, add modal section
                } countC++;
            } while (countC != responsesC.length);
            /*--------------------------------------------------------------------------------------*/
            //window.setTimeout("loadWFData();",650);
            //window.setTimeout("loadWFDataATCRow()",700); //read onchangeATCrowC();		
            //window.setTimeout("onchangeATCrowC()",750);
            //window.setTimeout("getSecC(true)",800);
            //window.setTimeout("flagC=true",850);	
            loadWFData();
            loadWFDataATCRow();
            onchangeATCrowC();
            getSecC(true);
            flagC = true;
            //Apparently the action after loading must be commited, we programatically auto-click the OK button - getSecC(true)

            window.setTimeout("$('#loader').hide('blind');", 2000);

        } catch (e) {
            msg.innerHTML = ""; //"Save File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }


    function loadWFData() {
        /*This will load data onto fields*/
        var responseWF = d.getElementById("response");

        var elem = document.getElementById('frmMain').elements;
        for (var i = 0; i < elem.length; i++) {

            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&  			
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String(responseWF.innerHTML).split(elem[i].id + ">"); //.replace(':', '')

                    if (fieldVal != null && fieldVal.length > 1) {
                        elem[i].value = fieldVal[1].substring(0, fieldVal[1].indexOf("</")); //all select-one and text values		  
                        //alert("text/select-one : '"+ elem[i].id +"' value = "+fieldVal[1].substring(0, fieldVal[1].indexOf("</"))); 
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String(responseWF.innerHTML).split(elem[i].id + ">");
                    if (rdoVal[1].substring(0, rdoVal[1].indexOf("</")) == 'true') {
                        elem[i].checked = rdoVal[1].substring(0, rdoVal[1].indexOf("</"));
                        elem[i].onclick();
                        //alert("radio : '"+ elem[i].id +"' value = "+rdoVal[1].substring(0, rdoVal[1].indexOf("</"))); 
                    }
                }

                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String(responseWF.innerHTML).split(elem[i].id + ">");
                    if (chkboxVal[1].substring(0, chkboxVal[1].indexOf("</")) == 'true') { //error ln1802 : encounter when there's no alert in loadWFDataATCRow()
                        elem[i].checked = chkboxVal[1].substring(0, chkboxVal[1].indexOf("</"));

                    }
                }

            }

        }
    }

    function pause(millis) {
        var d = new Date();
        var curDate = null;

        do { curDate = new Date(); }
        while (curDate - d < millis);
    }

    /*--------------------------------------------------------------*/
    function loadXML(loadWhere) {

        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere, 1);

            if (XMLFile.AtEndOfStream)
                data = "";
            else {
                var response = d.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug			
            loadData();	/*This will load data onto fields*/


            if (response.innerHTML.indexOf("All Rights Reserved BIR 2012.0") >= 0) {
                gIsReadOnly = true;
            }

            if (gIsReadOnly) {
                d.getElementById('frm0602:cmdValidate').disabled = true;
                d.getElementById('btnSave').disabled = true;
            }

            /*var eles = [];
			var inputs = d.getElementsByTagName('input');
			for(var i = 0; i < inputs.length; i++) {
				if(inputs[i].id.indexOf('chkSecB') >= 0) {
					alert('inputs[i].id = '+inputs[i].id);
					eles.push(inputs[i]);
				} else {
				    alert('else inputs[i].id = '+inputs[i].id);
				}
			}*/

            /*-------------SecB:  Find Instances of Dynamic Rows within the XML and add to modal-----------*/
            //5-27-2012
            flagB = false; //added param for loading - false
            var countB = 0;
            var responsesB = d.getElementById('response').getElementsByTagName('div');
            var bPar = 'chxSecB'; //modal section B	


            do {
                if (responsesB.item(countB).innerHTML.indexOf(bPar) != -1) {
                    var temp = String(responsesB.item(countB).innerHTML);
                    temp = temp.substring(0, bPar.length + 1); //substring to length of search param for index - check files (ex: chkSecB0)	
                    temp = temp.substring(bPar.length, bPar.length + 1); //get the last character for checking (ex: 0)					
                    pause(300);
                    if (!isNaN(temp)) window.setTimeout("addlistSecBReload();", 0); //if last char is a number, add modal section
                } countB++;
            } while (countB != responsesB.length);
            /*--------------------------------------------------------------------------------------*/
            window.setTimeout("loadData();", 410);
            window.setTimeout("loadDataATCRow();onchangeATCrowB();getSecB(true);flagB=true;", 450); //read onchangeATCrowB();			
            //Apparently the action after loading must be commited, we programatically auto-click the OK button - getSecB(true)

            /*-------------SecC:  Find Instances of Dynamic Rows within the XML and add to modal-----------*/
            //5-27-2012
            flagC = false; //added param for loading - false
            var countC = 0;
            var responsesC = d.getElementById('response').getElementsByTagName('div');
            var cPar = 'chxSecC'; //modal section C		

            do {
                if (responsesC.item(countC).innerHTML.indexOf(cPar) != -1) {
                    var temp = String(responsesC.item(countC).innerHTML);
                    temp = temp.substring(0, cPar.length + 1); //substring to length of search param for index - check files
                    temp = temp.substring(cPar.length, cPar.length + 1); //get the last character for checking
                    pause(300);
                    if (!isNaN(temp)) window.setTimeout("addlistSecCReload();", 0); //if last char is a number, add modal section
                } countC++;
            } while (countC != responsesC.length);
            /*--------------------------------------------------------------------------------------*/
            window.setTimeout("loadData();", 410);
            window.setTimeout("loadDataATCRow();onchangeATCrowC();getSecC(true);flagC=true;", 450); //read onchangeATCrowC();			
            //Apparently the action after loading must be commited, we programatically auto-click the OK button - getSecC(true)

            window.setTimeout("$('#loader').hide('blind');", 2000);

        } catch (e) {
            msg.innerHTML = ""; //"Save File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadData() {
        /*This will load data onto fields*/
        var response = d.getElementById("response");

        var elem = document.getElementById('frmMain').elements;
        for (var i = 0; i < elem.length; i++) {

            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&  			
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String($("#response").html()).split(elem[i].id + '=');
                    if (fieldVal != null && fieldVal.length > 1) {
                        if (elem[i].id == 'frm1602:txtTaxpayerName' || elem[i].id == 'frm1602:txtLineBus' || elem[i].id == 'frm1602:txtAddress') {
                            elem[i].value = unescape(fieldVal[1]);
                        }
						else if (elem[i].className.indexOf("FinalFlag") > -1) {
                        elem[i].value = typeof (fieldVal[1]) === "undefined" ? "3" : fieldVal[1];
                    }
                        else {
                            elem[i].value = fieldVal[1]; //all select-one and text values		 		
                        }
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String($("#response").html()).split(elem[i].id + '=');
                    if (rdoVal[1] == 'true') {
                        elem[i].checked = rdoVal[1];
                        elem[i].onclick();
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String($("#response").html()).split(elem[i].id + '=');
                    if (chkboxVal[1] == 'true') {
                        elem[i].checked = chkboxVal[1];
                    }
                }
            }

        }
    }

    function onchangeATCrowB() {
        /*This will programatically fire onchange for Select-one in modal*/
