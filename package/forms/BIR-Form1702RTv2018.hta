    function populateAllNames() {
	
        $_Id('frm1702RT:txtPg2RegisteredName').value = $_Id('frm1702RT:txtPg1Pt1I8Name1').value;
        $_Id('frm1702RT:txtPg3RegisteredName').value = $_Id('frm1702RT:txtPg1Pt1I8Name1').value;
