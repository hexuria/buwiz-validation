        allFormat('txtPg2Pt4I43TotalIncomeTax', 'txtPg1Pt2I14IncomeTax');
		
		
		computeP2Pt4I55TotalTaxCredits();
		computePg4Sc3I3NetOperatingLoss();
		//computeP1Pt2I20();
		//computeP1Pt2I21();
	}
    
	
	function computeP2Pt4I55TotalTaxCredits() {
        getSum('txtPg2Pt4I44ExcessCredits,txtPg2Pt4I45IncomeTaxPaymentUnderMCIT,txtPg2Pt4I46IncomeTaxUnderRegular,txtPg2Pt4I47ExcessMCIT,txtPg2Pt4I48CreditableTaxWithheldFromPrevious,txtPg2Pt4I49CreditableTaxWithheldFor4thQuarter,txtPg2Pt4I50ForeignTaxCredits,txtPg2Pt4I51TaxPaidInReturn,txtPg2Pt452SpecialTaxCredits,txtPg2Pt4I53C2,txtPg2Pt4I54C2', 'txtPg2Pt4I55TotalTaxCredits');
        $_Id('frm1702RT:txtPg1Pt2I15TotalTaxCredits').value = $_Id('frm1702RT:txtPg2Pt4I55TotalTaxCredits').value;
	    allFormat('txtPg2Pt452SpecialTaxCredits', 'txtPg2Pt5I58AddSpecialTax');
        computeP2Pt4I56();
