        }
        //Page 1 Amount Fields sum should be equal to Total Amount Payable if there is an amount
        if ((NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt3I23DebitMemoC4Amount').value)) + NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt3I24CheckC4Amount').value)) + NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt3I25TaxDebitC4Amount').value)) + NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt3I26OthersC4Amount').value))) != 0) {
