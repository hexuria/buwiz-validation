        enableCompleteRows('txtPg4Sc3AI6C1', 'txtPg4Sc3AI6C2', 'frm1702RT:txtPg4Sc3AI7C1,frm1702RT:txtPg4Sc3AI7C2,frm1702RT:txtPg4Sc3AI7C3,frm1702RT:txtPg4Sc3AI7C4,frm1702RT:txtPg4Sc3AI7C5');
        enableCompleteRows('txtPg4Sc3AI7C1', 'txtPg4Sc3AI7C2', 'btnPg4Sc3AI7More');
      
        enableCompleteRows('txtPg4Sc5I2C1', 'txtPg4Sc5I2C2', 'frm1702RT:txtPg4Sc5I3C1,frm1702RT:txtPg4Sc5I3C2');
        enableCompleteRows('txtPg4Sc5I3C1', 'txtPg4Sc5I3C2', 'btnPg4Sc5I3More');
        enableCompleteRows('txtPg4Sc5I5C1', 'txtPg4Sc5I5C2', 'frm1702RT:txtPg4Sc5I6C1,frm1702RT:txtPg4Sc5I6C2');
        enableCompleteRows('txtPg4Sc5I6C1', 'txtPg4Sc5I6C2', 'btnPg4Sc5I6More');
        enableCompleteRows('txtPg4Sc5I7C1', 'txtPg4Sc5I7C2', 'frm1702RT:txtPg4Sc5I8C1,frm1702RT:txtPg4Sc5I8C2');
        enableCompleteRows('txtPg4Sc5I8C1', 'txtPg4Sc5I8C2', 'btnPg4Sc5I8More');
