		computeP1Pt2I21();
        computePg4Sc3I3NetOperatingLoss();
		
    }

    function computeP4Sc3AI8TotalNOLCO() {
         //Compute Net Operating Loss
        if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI4C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI4C2').value))) {
            alert('Page 4 Schedule IIIA Item 4 Column D (NOLCO Applied Current Year) cannot be more than Page 4 Schedule 3A Item 4 Column A (Amount)');
            $_Id('frm1702RT:txtPg4Sc3AI4C5').value = "0";
        }
        else if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C2').value))) {
            alert('Page 4 Schedule IIIA Item 5 Column D (NOLCO Applied Current Year) cannot be more than Page 4 Schedule 3A Item 5 Column A (Amount)');
            $_Id('frm1702RT:txtPg4Sc3AI5C5').value = "0";
        }
        else if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI6C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI6C2').value))) {
            alert('Page 4 Schedule IIIA Item 6 Column D (NOLCO Applied Current Year) cannot be more than Page 4 Schedule 3A Item 6 Column A (Amount)');
            $_Id('frm1702RT:txtPg4Sc3AI6C5').value = "0";
        }
        else if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C2').value))) {
            alert('Page 4 Schedule  IIIA Item 7 Column D (NOLCO Applied Current Year) cannot be more than Page 4 Schedule 3A Item 7 Column A (Amount)');
            $_Id('frm1702RT:txtPg4Sc3AI7C5').value = "0";
        }
        else if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C3').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C4').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C2').value))) {
            alert('Page 4 Schedule IIIA Item 5: Column B + C + D cannot be greater than Column A');
            $_Id('frm1702RT:txtPg4Sc3AI5C5').value = "0";
        }
        else if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI6C3').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI6C4').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI6C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI6C2').value))) {
            alert('Page 4 Schedule IIIA Item 6: Column B + C + D cannot be greater than Column A');
            $_Id('frm1702RT:txtPg4Sc3AI6C5').value = "0";
        }
        else if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C3').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C4').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C2').value))) {
            alert('Page 4 Schedule IIIA Item 7: Column B + C + D cannot be greater than Column A');
            $_Id('frm1702RT:txtPg4Sc3AI7C5').value = "0";
        }
		
        getDifference('txtPg4Sc3AI5C2', 'txtPg4Sc3AI5C3,txtPg4Sc3AI5C4,txtPg4Sc3AI5C5', 'txtPg4Sc3AI5C6');
        getDifference('txtPg4Sc3AI6C2', 'txtPg4Sc3AI6C3,txtPg4Sc3AI6C4,txtPg4Sc3AI6C5', 'txtPg4Sc3AI6C6');
        getDifference('txtPg4Sc3AI7C2', 'txtPg4Sc3AI7C3,txtPg4Sc3AI7C4,txtPg4Sc3AI7C5', 'txtPg4Sc3AI7C6');
        getSum('txtPg4Sc3AI4C5,txtPg4Sc3AI5C5,txtPg4Sc3AI6C5,txtPg4Sc3AI7C5', 'txtPg4Sc4I8TotalNOLCO');
		
		allFormat('txtPg4Sc4I8TotalNOLCO', 'txtPg2Pt4I36Nolco');
			//To Part4 Item 37
        $_Id('frm1702RT:txtPg2Pt4I36Nolco').value = $_Id('frm1702RT:txtPg4Sc4I8TotalNOLCO').value;
		computeP2Pt4I33();
		computeP2Pt4I37();
		computeP1Pt2I20();
	     computeP1Pt2I21();
        computePg4Sc3I3NetOperatingLoss();
    }
    function computePg4Sc3I3NetOperatingLoss() {
        fillNetOperatingLossItems();
        computeP4Sc3AI4C6();
    }
	
	function fillNetOperatingLossItems(){
		var totalDeductions = $_Id('frm1702RT:txtPg4Sc3I2TotalDeductions');
			var netOperatingLoss = $_Id('frm1702RT:txtPg4Sc3I3NetOperatingLoss');
			var yearIncurred = $_Id('frm1702RT:txtPg4Sc3AI4C1');
			var amount = $_Id('frm1702RT:txtPg4Sc3AI4C2');
			   if ($_Id('frm1702RT:rdoPg1Pt1I13ItemizedDeduction').checked == true){
				getDifference('txtPg4Sc3I1GrossIncome', 'txtPg4Sc3I2TotalDeductions', 'txtPg4Sc3I3NetOperatingLoss');
			}
			if (WholeNumWithComma(NumWithParenthesis(netOperatingLoss.value)) >= 0 ) {
				 $_Id('frm1702RT:txtPg4Sc3I1GrossIncome').value = "0";
				 $_Id('frm1702RT:txtPg4Sc3I2TotalDeductions').value = "0";
				 $_Id('frm1702RT:txtPg4Sc3I3NetOperatingLoss').value = "0";
				 $_Id('frm1702RT:txtPg4Sc3AI4C1').value = "";
				 $_Id('frm1702RT:txtPg4Sc3AI4C2').value = "0";
			}
			else {
				if ($_Id('frm1702RT:txtPg1I2Year').value != "") {
					yearIncurred.value = "20" + $_Id('frm1702RT:txtPg1I2Year').value;
				}
				amount.value = addCommas(Math.abs(WholeNumWithComma(NumWithParenthesis(netOperatingLoss.value))));
				 getDifference('txtPg4Sc3AI4C2', 'txtPg4Sc3AI4C3,txtPg4Sc3AI4C4,txtPg4Sc3AI4C5', 'txtPg4Sc3AI4C6');
		   }
	   }
    function checkP4Sc3I4NetOperatingLoss() {
        var returnPeriod = $_Id('frm1702RT:txtPg1I2Year');
        var netOperatingLoss = $_Id('frm1702RT:txtPg4Sc3I3NetOperatingLoss');
        var p4Sc3AI4C1 = $_Id('frm1702RT:txtPg4Sc3AI4C1');
        var p4Sc3AI4C2 = $_Id('frm1702RT:txtPg4Sc3AI4C2');
        var p4Sc3AI5C1 = $_Id('frm1702RT:txtPg4Sc3AI5C1');
        var p4Sc3AI5C2 = $_Id('frm1702RT:txtPg4Sc3AI5C2');
        var p4Sc3AI6C1 = $_Id('frm1702RT:txtPg4Sc3AI6C1');
        var p4Sc3AI6C2 = $_Id('frm1702RT:txtPg4Sc3AI6C2');
        var p4Sc3AI7C1 = $_Id('frm1702RT:txtPg4Sc3AI7C1');
        var p4Sc3AI7C2 = $_Id('frm1702RT:txtPg4Sc3AI7C2');

        //Compute Net Operating Loss
        computeP4Sc3AI4C6();
        computeP4Sc3AI5C6(0);
        computeP4Sc3AI6C6(0);
        computeP4Sc3AI7C6(0);
    }
    function checkYear(year) {
        var p4Sc3AI4C1 = $_Id('frm1702RT:txtPg4Sc3AI4C1').value;
        var p4Sc3AI5C1 = $_Id('frm1702RT:txtPg4Sc3AI5C1').value;
        var p4Sc3AI6C1 = $_Id('frm1702RT:txtPg4Sc3AI6C1').value;
        var p4Sc3AI7C1 = $_Id('frm1702RT:txtPg4Sc3AI7C1').value;
        var returnPeriod = $_Id('frm1702RT:txtPg1I2Year');
        var dateOfIncorporation = $_Id('frm1702RT:txtPg1Pt1I10').value;
        var ctr = 0;
        var yearIncurred = new Array();
        yearIncurred[1] = p4Sc3AI4C1;
        yearIncurred[2] = p4Sc3AI5C1;
        yearIncurred[3] = p4Sc3AI6C1;
        yearIncurred[4] = p4Sc3AI7C1;

        if ($_Id('frm1702RT:ddlPg1I2Month').value == 0 || $_Id('frm1702RT:txtPg1I2Year').value == 0 && year.value != '') {
            alert('Please provide a valid Year Ended on Page 1 Item 2');
            year.value = '';
            goToControl(1, 'frm1702RT:txtPg1I2Year');
        }

        else if (dateOfIncorporation == "" && year.value != '') {
            alert('You must fill-up Page 1 Part 1 Item 10 (Date of Incorporation/Organization) before you can add Year Incurred.');
            year.value = '';
        }
        else if (year.value == "20" + returnPeriod.value) {
            alert('Page 4 Schedule IIIA Item 5-7 Year Incurred cannot be equal to Page 1 Item 2 Year Ended.');
            year.value = '';
        }
        else if (year.value >= ("20" + returnPeriod.value - 3) && year.value <= "20" + returnPeriod.value) {
            dateOfIncorporationArray = dateOfIncorporation.split("/");

            if (dateOfIncorporationArray[2] <= year.value) {
                for (var i = 1; i < yearIncurred.length; i++) {
                    if (year.value == yearIncurred[i]) {
                        ctr = ctr + 1;
                    }
                }
                if (ctr != 1) {
                    alert('Year Incurred per row must be unique.');
                    year.value = '';
                }
            }
            else {
                alert('Year Incurred cannot be less than year in Page 1 Part 1 Item 10 (Date of Incorporation/Organization)');
                year.value = '';
            }
        }
        else if (year.value > "20" + returnPeriod.value) {
            alert('Year Incurred cannot be more than Page 1 Part 1 Item 2 (Year Ended)');
            year.value = '';
        }
        else if (year.value != '') {
            alert('Year Incurred Cannot be less than 3 years in Page 1 Item 2 (Year Ended)');
            year.value = '';
        }
    }

    function computeP4Sc3AI4C6() {
        getDifference('txtPg4Sc3AI4C2', 'txtPg4Sc3AI4C3,txtPg4Sc3AI4C4,txtPg4Sc3AI4C5', 'txtPg4Sc3AI4C6');
		computeP4Sc3AI8TotalNOLCO();
	}

    function computeP4Sc3AI5C6(fieldID) {
        if (fieldID != 0) {
            if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C3').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C4').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C2').value))) {
                alert('Page 4 Schedule IIIA Item 5: Column B + C + D cannot be greater than Column A');
                fieldID.value = "0";
            }
        }
        else if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C3').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C4').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI5C2').value))) {
            alert('Page 4 Schedule IIIA Item 5: Column B + C + D cannot be greater than Column A');
            $_Id('frm1702RT:txtPg4Sc3AI5C3').value = "0";
            $_Id('frm1702RT:txtPg4Sc3AI5C4').value = "0";
            $_Id('frm1702RT:txtPg4Sc3AI5C5').value = "0";
        }
        getDifference('txtPg4Sc3AI5C2', 'txtPg4Sc3AI5C3,txtPg4Sc3AI5C4,txtPg4Sc3AI5C5', 'txtPg4Sc3AI5C6');
    }
