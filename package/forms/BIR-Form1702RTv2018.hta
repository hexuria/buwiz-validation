                    //                    currentParam1.disabled = true;
                    //                    currentParam2.disabled = true;
                    //                    currentParam3.disabled = true;
                    //                    currentParam1.value = "OTHERS";
                    //                    currentButton.disabled = false;
                    saveModalTable(0, 0);
                }
                else if (currentRow.childNodes.length == 5) {
                    var params = new Array();
