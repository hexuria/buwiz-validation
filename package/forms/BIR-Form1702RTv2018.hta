    // load profile.xml
    function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = ""
            } else {
                var responseBG = document.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag	
		    }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug				
            loadBGData(); /*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = ""
        }
    }

    // load data on controls based on profile.xml
	function loadBGData() {
		
        /*This will load data onto Background Information fields*/
        var responseBG = document.getElementById("responseBG");
	
        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '1702RTv2018') {
		     
			 var fnVal = String(responseBG.innerHTML).split('fn=');
            //document.getElementById('frm1702RT:txtPg1Pt1I9RegisteredName').value = unescape(fnVal[1]);
			fnVal[1] = unescape(fnVal[1].substring(0, fnVal[1].length)).toUpperCase();
			if (fnVal[1].length >= 78) {
				d.getElementById('frm1702RT:txtPg1Pt1I8Name1').value = fnVal[1].substring(0, 100);
				d.getElementById('frm1702RT:txtPg1Pt1I8Name2').value = fnVal[1].substring(100, 200);
				d.getElementById('frm1702RT:txtPg1Pt1I8Name3').value = fnVal[1].substring(200, fnVal[1].length);
			}
			if (fnVal[1].length > 38 && fnVal[1].length <= 76) {
				d.getElementById('frm1702RT:txtPg1Pt1I8Name1').value = fnVal[1].substring(0, 100);
				d.getElementById('frm1702RT:txtPg1Pt1I8Name2').value = fnVal[1].substring(100, fnVal[1].length);
				d.getElementById('frm1702RT:txtPg1Pt1I8Name3').value = "";
			}
			else if (fnVal[1].length < 38) {
				d.getElementById('frm1702RT:txtPg1Pt1I8Name1').value = fnVal[1];	
				d.getElementById('frm1702RT:txtPg1Pt1I8Name2').value = "";
			}
			

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            //document.getElementById('').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            //document.getElementById('').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            //document.getElementById('').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            //document.getElementById('').value = tin4Val[1];
	
			
            var rdoVal = String(responseBG.innerHTML).split('rdo=');
			document.getElementById('frm1702RT:txtRDO').value = "";
			document.getElementById('frm1702RT:txtRDO').value = rdoVal[1];
            $('select[id="frm1702RT:drpPg1Pt1I7RDOCode"] option[value = ' + rdoVal[1] + ']').attr("selected", "selected");
            document.getElementById('frm1702RT:hdnPg1Pt1I7RDOCode').value = rdoVal[1];
            //var data = "<select id='frm1702RT:drpPg1Pt1I7RDOCode' name='frm1702RT:drpPg1Pt1I7RDOCode' disabled='disabled' size='1'><option value='" + rdoVal[1] + "' selected>" + rdoVal[1] + "</option>"
            //$('#rdoContainer').html(data);

            var lobVal = String(responseBG.innerHTML).split('lob=');
            document.getElementById('frm1702RT:txtPg1Pt1I18Business').value = unescape(lobVal[1].toUpperCase());

            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
			regAddrVal[1] = unescape(regAddrVal[1].substring(0, regAddrVal[1].length)).toUpperCase();
			if (regAddrVal[1].length >= 200 ) {
				d.getElementById('frm1702RT:txtPg1Pt1I9Address1').value = regAddrVal[1].substring(0, 100);
				d.getElementById('frm1702RT:txtPg1Pt1I9Address2').value = regAddrVal[1].substring(100, 200);
				d.getElementById('frm1702RT:txtPg1Pt1I9Address3').value = regAddrVal[1].substring(200, regAddrVal[1].length);
			}
			if (regAddrVal[1].length >= 100 && regAddrVal[1].length <= 200) {
				d.getElementById('frm1702RT:txtPg1Pt1I9Address1').value = regAddrVal[1].substring(0, 100);
				d.getElementById('frm1702RT:txtPg1Pt1I9Address2').value = regAddrVal[1].substring(100, regAddrVal[1].length);
				d.getElementById('frm1702RT:txtPg1Pt1I9Address3').value = "";
			}
			else if (regAddrVal[1].length < 99) {
				d.getElementById('frm1702RT:txtPg1Pt1I9Address1').value = regAddrVal[1];	
				d.getElementById('frm1702RT:txtPg1Pt1I9Address2').value = "";
			}

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            document.getElementById('frm1702RT:txtPg1Pt1I11Contact').value = telNoVal[1];

		
			 var emailVal = String(responseBG.innerHTML).split('email=');
			 if (emailVal[1] === undefined) {
				document.getElementById('frm1702RT:txtPg1Pt1I12Email').value = "";
			}
			else {
				document.getElementById('frm1702RT:txtPg1Pt1I12Email').value = emailVal[1];
				globalEmail = emailVal[1];
				p3TPEmail = emailVal[1];
			}
            var zipVal = String(responseBG.innerHTML).split('zip=');
            document.getElementById('frm1702RT:txtZIP').value = zipVal[1];
            p3TPZip = zipVal[1];

            //No Zip for 1702RT, just same in a variable
            //var zipVal = String(responseBG.innerHTML).split('zip=');
            //p3TPZip = zipVal[1];

            //set TIN & TaxFiler's Name across the whole form
			var TIN1 = d.getElementsByName('frm1702RT:txtTIN1');
            var TIN2 = d.getElementsByName('frm1702RT:txtTIN2');
            var TIN3 = d.getElementsByName('frm1702RT:txtTIN3');
            var TIN4 = d.getElementsByName('frm1702RT:txtTIN4');
            var TaxFiler = d.getElementsByName('frm1702RT:txtRegisteredName') 
			
            for (var i = 0; i < TIN1.length; i++) {
                TIN1[i].value = tin1Val[1];
                TIN2[i].value = tin2Val[1];
                TIN3[i].value = tin3Val[1];
                TIN4[i].value = tin4Val[1];
                TaxFiler[i].value = unescape(fnVal[1].toUpperCase());
            }
        }
		
		var emailVal = String(responseBG.innerHTML).split('email=');
        if (emailVal[1] === undefined) {
            document.getElementById('frm1702RT:txtPg1Pt1I12Email').value = "";
        }
        else {
            document.getElementById('frm1702RT:txtPg1Pt1I12Email').value = emailVal[1];
            globalEmail = emailVal[1];
        }		
		
	}

    // if file is already existing
  function loadData() {
        /*This will load data onto fields*/
        var response = document.getElementById("response");
        var modalCounter = document.getElementById('modalCounter').getElementsByTagName('input');
        var counter = 0;
		
		for (var i = 0; i < modalCounter.length; i++) {
            if ((response.innerHTML).indexOf(modalCounter[i].id) != -1 && i == 0) {
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
		
                if (counter > 0) {
                    document.getElementById('btnPg2Pt4I54More').disabled = false;
                    document.getElementById('frm1702RT:txtPg2Pt4I54C1').disabled = true;
                    document.getElementById('frm1702RT:txtPg2Pt4I54C2').disabled = true;
                    var row = document.getElementById('btnPg2Pt4I54More').parentNode.parentNode;
                    for (var k = 0; k < counter; k++) {
					    
                        addXMLRowModalTable("frm1702RT:txtPg2Pt4I54ModalTable",  "frm1702RT:txtPg2Pt4I54", "54", row, "frm1702RT:txtPg2Pt4I54");
                    }
                }
            }
			      
       
			
			if ((response.innerHTML).indexOf(modalCounter[i].id) != -1 && i == 1) {
                counter = (response.innerHTML).split(modalCounter[i].id + "=")[1];
                if (counter > 0) {
                    document.getElementById('btnPg3Sc1I17iMore').disabled = false;
