                            }
                            /*else if (elem[i].id == 'frm1700:txt19') {
                            p3TPLineBus = escape(elem[i].value);
                            } else if (elem[i].id == 'frm1700:txtRegisteredName') {
                            p3TPName = escape(elem[i].value);
                            }*/
                            else if (elem[i].id == 'frm1702RT:txtPg1Pt1I11Contact') {
                                allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                                p3TPTelNum = elem[i].value;
                            }
							
                            else if (elem[i].id == 'frm1702RT:txtZIP') {
                                allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                                p3TPZip = elem[i].value;
                            }
							else if (elem[i].id == 'frm1702RT:txtPg1Pt1I12Email') {
                                allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                                p3TPEmail = elem[i].value;
                            }
                            /*else if (elem[i].id == 'frm1700:txt11Address') {
                            p3TPAddress = escape(elem[i].value);
                            }*/

                            //EDIT Check is there is ZIP, if none, i.set ung p3TPZip sa loadBGData()
