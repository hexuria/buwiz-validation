            $('input[value=" Print "]').attr("disabled", false);
        }
        else if ($_Id('frm1702RT:cmdValidate').disabled === false) {
           $('.modalShow').find('input, select').attr("disabled", false);
		    $_Id('frm1702RT:txtPg2Pt4I54Subtotal').disabled = true;
			$_Id('frm1702RT:txtPg3Sc2I4Subtotal').disabled = true;
            $_Id('frm1702RT:txtPg3Sc1I17iSubtotal').disabled = true;
            $_Id('frm1702RT:txtPg4Sc5I3Subtotal').disabled = true;
            $_Id('frm1702RT:txtPg4Sc5I6Subtotal').disabled = true;
            $_Id('frm1702RT:txtPg4Sc5I8Subtotal').disabled = true;
            $('input[value=" Print "]').attr("disabled", true);
        }
    }
</script>
<!--END: Disable/enable More button-->

<!--BEGIN: Computations-->
<script type="text/javascript">
    //Page 2 js

	  function computeP1Pt2I16() {
        getDifference('txtPg1Pt2I14IncomeTax', 'txtPg1Pt2I15TotalTaxCredits', 'txtPg1Pt2I16NetTax');
		computeP1Pt2I20();
	 }
	
	 function computeP1Pt2I20() {
        getSum('txtPg1Pt2I17Surcharge,txtPg1Pt2I18Interest,txtPg1Pt2I19Compromise', 'txtPg1Pt2I20TotalPenalties');
		computeP1Pt2I21();
    }

     function computeP1Pt2I21() {
	    if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt2I16NetTax').value)) >= 0) {
            getSum('txtPg1Pt2I16NetTax,txtPg1Pt2I20TotalPenalties', 'txtPg1Pt2I21TotalAmount');
        }
        else if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt2I16NetTax').value)) < 0) {
			if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt2I20TotalPenalties').value)) > 0){
				$_Id('frm1702RT:txtPg1Pt2I21TotalAmount').value = $_Id('frm1702RT:txtPg1Pt2I20TotalPenalties').value;
			}
			else if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt2I20TotalPenalties').value)) <= 0){
				$_Id('frm1702RT:txtPg1Pt2I21TotalAmount').value = $_Id('frm1702RT:txtPg1Pt2I16NetTax').value;
			}
		}
		
        //for Page 1 Item 21
        if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt2I16NetTax').value)) < 0) {
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentRefunded').disabled = false;
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentIssued').disabled = false;
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentCarried').disabled = false;
        }
        else if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg1Pt2I16NetTax').value)) >= 0) {
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentRefunded').checked = false;
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentIssued').checked = false;
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentCarried').checked = false;
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentRefunded').disabled = true;
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentIssued').disabled = true;
            $_Id('frm1702RT:rdoPg1Pt2I21OverpaymentCarried').disabled = true;
        }
		computeP2Pt4I29();
    }
	
	 function computeP2Pt4I29() {
	    getDifference('txtPg2Pt4I27Sales','txtPg2Pt4I28LessSales','txtPg2Pt4I29NetSales');
        computeP2Pt4I31();
		 computeP2Pt4I33();
		computeP2Pt4I39();
		
		computeP2Pt4I41();
	}
	
	function computeP2Pt4I31() {
		getDifference('txtPg2Pt4I29NetSales', 'txtPg2Pt4I30LessCost', 'txtPg2Pt4I31GrossIncome');
		computeP2Pt4I33();
		computeP2Pt4I41();
   }
	
    function computeP2Pt4I33() {
		//$_Id('frm1702RT:txtPg4Sc3I1GrossIncome').value = addCommas(WholeNumWithComma($_Id('frm1702RT:txtPg2Pt4I33TotalGross').value));
		//$_Id('frm1702RT:txtPg4Sc3I1GrossIncome').value = 0;
		getSum('txtPg2Pt4I31GrossIncome,txtPg2Pt4I32AddOtherTaxable', 'txtPg2Pt4I33TotalGross');
				
	
		if ($_Id('frm1702RT:rdoPg1Pt1I13OptionalStandard').checked == true ) {
			$_Id('frm1702RT:txtPg4Sc3I1GrossIncome').value = 0;
			$_Id('frm1702RT:txtPg4Sc3I2TotalDeductions').value = 0;
			$_Id('frm1702RT:txtPg4Sc3I3NetOperatingLoss').value = 0;
			computeItem18and33();	
			computeP2Pt4I38();
		}
		if ($_Id('frm1702RT:rdoPg1Pt1I13ItemizedDeduction').checked == true ){
			computeItem18and33();			
			computeP2Pt4I37();			
		}
		
		computeP2Pt4I41();		
		
	}

	function computeItem18and33(){
			$_Id('frm1702RT:txtPg4Sc3I2TotalDeductions').value = $_Id('frm1702RT:txtPg3Sc1I18TotalOrdinaryAllowable').value;
			$_Id('frm1702RT:txtPg2Pt4I34OrdinaryAllowable').value = $_Id('frm1702RT:txtPg3Sc1I18TotalOrdinaryAllowable').value;
			allFormat('txtPg2Pt4I34OrdinaryAllowable','txtPg3Sc1I18TotalOrdinaryAllowable', 'txtPg4Sc3I2TotalDeductions');
			fillNetOperatingLossItems();
			var totalItem18 = getValAmount('txtPg3Sc1I18TotalOrdinaryAllowable')
			var totalItem33 = getValAmount('txtPg2Pt4I33TotalGross');
			if(totalItem18 > totalItem33){
				$_Id('frm1702RT:txtPg4Sc3I1GrossIncome').value = $_Id('frm1702RT:txtPg2Pt4I33TotalGross').value;
				$_Id('frm1702RT:txtPg4Sc3I2TotalDeductions').value  =  $_Id('frm1702RT:txtPg3Sc1I18TotalOrdinaryAllowable').value;
				getDifference('txtPg4Sc3I1GrossIncome', 'txtPg4Sc3I2TotalDeductions', 'txtPg4Sc3I3NetOperatingLoss');
				fillNetOperatingLossItems();
			}
		  if(totalItem18 <= totalItem33){
 
			$_Id('frm1702RT:txtPg4Sc3I1GrossIncome').value = 0;
			$_Id('frm1702RT:txtPg4Sc3I2TotalDeductions').value = 0;
			$_Id('frm1702RT:txtPg4Sc3I3NetOperatingLoss').value = 0;
			 $_Id('frm1702RT:txtPg4Sc3AI4C2').value = "0";
            $_Id('frm1702RT:txtPg4Sc3AI4C1').value = "";
			fillNetOperatingLossItems();
		 }
}
    function computeP2Pt4I37() {
	//	$_Id('frm1702RT:txtPg2Pt4I37TotalItemized').value = 0;
		if ($_Id('frm1702RT:rdoPg1Pt1I13ItemizedDeduction').checked == true){
			getSum('txtPg2Pt4I34OrdinaryAllowable,txtPg2Pt4I35SpecialAllowable,txtPg2Pt4I36Nolco', 'txtPg2Pt4I37TotalItemized');
		}
	    else if ($_Id('frm1702RT:rdoPg1Pt1I13OptionalStandard').checked == true) {
			$_Id('frm1702RT:txtPg2Pt4I37TotalItemized').value = 0;
	    }
		
		computeP2Pt4I39();
		//computePg4Sc3I3NetOperatingLoss();
		//computeP2Pt4I42();
	}

    function computeP2Pt4I38() {
		
		//$_Id('frm1702RT:txtPg2Pt4I38OptionalStandard').value = 0;
		if ($_Id('frm1702RT:rdoPg1Pt1I13OptionalStandard').checked == true ) {
			getProduct2('txtPg2Pt4I33TotalGross', 0.40, 'txtPg2Pt4I38OptionalStandard');
	
		}
	    else if ($_Id('frm1702RT:rdoPg1Pt1I13ItemizedDeduction').checked == true){
			$_Id('frm1702RT:txtPg2Pt4I38OptionalStandard').value =  0 ;
		}
		computeP2Pt4I39();
		//computePg4Sc3I3NetOperatingLoss();
		//computeP2Pt4I42();
	}
	
    function computeP2Pt4I39() {
        if ($_Id('frm1702RT:rdoPg1Pt1I13OptionalStandard').checked == true) {
			getDifference('txtPg2Pt4I33TotalGross', 'txtPg2Pt4I38OptionalStandard', 'txtPg2Pt4I39NetTaxable');
             $_Id('frm1702RT:txtPg4Sc3I1GrossIncome').value = "0";
        }
        else if ($_Id('frm1702RT:rdoPg1Pt1I13ItemizedDeduction').checked == true) {
			getDifference('txtPg2Pt4I33TotalGross', 'txtPg2Pt4I37TotalItemized', 'txtPg2Pt4I39NetTaxable');
            if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg2Pt4I33TotalGross').value)) > NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg2Pt4I34OrdinaryAllowable').value))) {
 
                $_Id('frm1702RT:txtPg4Sc3AI4C5').value = "0";
                $_Id('frm1702RT:txtPg4Sc3AI4C6').value = "0";
                $_Id('frm1702RT:txtPg4Sc3AI4C5').disabled = true;
            }
        }
		//$_Id('frm1702RT:txtPg4Sc3I1GrossIncome').value =  $_Id('frm1702RT:txtPg2Pt4I33TotalGross').value ;
		computeP2Pt4I41();
		//computeP2Pt4I42();
		
	}

    function computeP2Pt4I41() {
        if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg2Pt4I39NetTaxable').value)) > 0){
			getProduct2('txtPg2Pt4I39NetTaxable', 0.3, 'txtPg2Pt4I41IncomeTaxDue');
		}
		else if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg2Pt4I39NetTaxable').value)) <= 0) {
            $_Id('frm1702RT:txtPg2Pt4I41IncomeTaxDue').value = "0";
        }
		computeP2Pt4I42() ;
    }

    function computeP2Pt4I42() {

		if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg2Pt4I33TotalGross').value)) <= 0) {
            $_Id('frm1702RT:txtPg2Pt4I42MinimumCorporate').value = "0";
        } 
		else 
		{
			if ($_Id('frm1702RT:rdoPg1I5Atc').checked == true) {
				getProduct2('txtPg2Pt4I33TotalGross', 0.02, 'txtPg2Pt4I42MinimumCorporate');
			}
		}
		computeP2Pt4I43();
	}

    function computeP2Pt4I43() {
		 if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg2Pt4I39NetTaxable').value)) < 0) {
		  $_Id('frm1702RT:txtPg2Pt4I43TotalIncomeTax').value = "0";
		 }
        if (NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg2Pt4I41IncomeTaxDue').value)) >= NumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg2Pt4I42MinimumCorporate').value))) {
            allFormat('txtPg2Pt4I41IncomeTaxDue', 'txtPg2Pt4I43TotalIncomeTax');
          
        }
        else {
            allFormat('txtPg2Pt4I42MinimumCorporate', 'txtPg2Pt4I43TotalIncomeTax');
         }

