    function submitData() {
        //Page 1 Taxpayer
		if (checkconnection()) {
        var formVersion = Form1702RT.version;
        populateTaxpayerBean(
			getVal('txtPg1Pt1I6TIN1') + getVal('txtPg1Pt1I6TIN2') + getVal('txtPg1Pt1I6TIN3'),
			getVal('txtPg1Pt1I6TIN4'),
			'',
			'',
