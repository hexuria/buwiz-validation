    function computeP4Sc3AI7C6(fieldID) {
        if (fieldID != 0) {
            if (WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C3').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C4').value)) + WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C5').value)) > WholeNumWithComma(NumWithParenthesis($_Id('frm1702RT:txtPg4Sc3AI7C2').value))) {
