	function computeAllIterationsSub(){
		getSum('txtPg3Sc1I1Amortization,txtPg3Sc1I2BadDebts,txtPg3Sc1I3CharitableContributions,txtPg3Sc1I4Depletion,txtPg3Sc1I5Depreciation,txtPg3Sc1I6Entertainment,txtPg3Sc1I7FringeBenefits,txtPg3Sc1I8Interest,txtPg3Sc1I9Losses,txtPg3Sc1I10PensionTrust,txtPg3Sc1I11Rental,txtPg3Sc1I12Research,txtPg3Sc1I13Salaries,txtPg3Sc1I14Contributions,txtPg3Sc1I15TaxesandLicenses,txtPg3Sc1I16TransportationandTravel,txtPg3Sc1I17aJanitorial,txtPg3Sc1I17bProfessionalFees,txtPg3Sc1I17cSecurityServices,txtPg3Sc1I17dC2,txtPg3Sc1I17eC2,txtPg3Sc1I17fC2,txtPg3Sc1I17gC2,txtPg3Sc1I17hC2,txtPg3Sc1I17iC2','txtPg3Sc1I18TotalOrdinaryAllowable');
