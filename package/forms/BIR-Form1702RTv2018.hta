    function computeP3Sc2I5TotalSpecialAllowable() {
        getSum('txtPg3Sc2I1C3,txtPg3Sc2I2C3,txtPg3Sc2I3C3,txtPg3Sc2I4C3', 'txtPg3Sc2I5TotalSpecialAllowable');
        //$_Id('frm1702RT:txtPg2Pt4I35SpecialAllowable').value = $_Id('frm1702RT:txtPg3Sc2I5TotalSpecialAllowable').value;
