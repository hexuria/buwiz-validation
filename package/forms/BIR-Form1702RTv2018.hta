    function initialValidateBeforeSave() {
        var isValid = true;
        var errorList = [];

        // RDO Code
        if ($_Id('frm1702RT:drpPg1Pt1I7RDOCode').value === '000') {
            errorList.push('Please select an RDO Code (Part I Item 7).');
        }
        // Registered Name
        if ($_Id('frm1702RT:txtPg1Pt1I8Name1').value === '') {
            errorList.push('Please provide a Registered Name (Part I Item 9).');
        }
        // Registered Address
        if ($_Id('frm1702RT:txtPg1Pt1I9Address1').value === '') {
            errorList.push('Please provide a Registered Address (Part I Item 10).');
        }
        // Contact Number
        if ($_Id('frm1702RT:txtPg1Pt1I11Contact').value === '') {
            errorList.push('Please provide a Contact Number (Part I Item 11).');
        }
        // Email Address
        if ($_Id('frm1702RT:txtPg1Pt1I12Email').value === '') {
            errorList.push('Please provide an Email Address (Part I Item 12).');
        }
       
        // PSIC code
       // if ($_Id('frm1702RT:txtPg1Pt1I14PSIC').value === '') {
       //     errorList.push('Please provide PSIC code (Part I Item 14).');
       // }

        if (errorList.length > 0) {
            isValid = false;
            alert(errorList[0]);
        }
        else {
            $_Id('frm1702RT:txtCurrentPage').value = 1;
        }
        //validation here
        //return true to save
        return isValid;
    }

    //topNav
    $(document).ready(function () {

        $("ul.subnav").parent().append("<span></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)  
        $("ul.topnav li span").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
        $("ul.topnav .toplevel").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
    });


    function createXMLProfileName() {
        try {
            var xmlFileName = ""

            var titleTin1 = document.getElementById('frm1702RT:txtPg1Pt1I6TIN1');
            var titleTin2 = document.getElementById('frm1702RT:txtPg1Pt1I6TIN2');
            var titleTin3 = document.getElementById('frm1702RT:txtPg1Pt1I6TIN3');
            var titleBranchCode = document.getElementById('frm1702RT:txtPg1Pt1I6TIN4');
            var titleTPName = document.getElementById('frm1702RT:txtPg1Pt1I8Name1') +' '+document.getElementById('frm1702RT:txtPg1Pt1I8Name2')+' '+ document.getElementById('frm1702RT:txtPg1Pt1I8Name3');
         
            var formType = "1702RTv2018";

            xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml"

            return xmlFileName;
        } catch (e) {
            alert('Exception : ' + e.description);
        }
    }
 
	
    function saveXMLProfile(isFinalCopy) {
        if (gIsReadOnly == false) {
            var xmlFileName = createXMLProfileName();

            msg.innerHTML = 'Generating File...';
            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFile = fileSys.CreateTextFile(xmlFileName); //(saveWhere);

            var allXML = "<?xml version='1.0'?>", tab = document.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break			

            allXML += "<div>fn=" + escape(document.getElementById('frm1702RT:txtPg1Pt1I8Name1').value)+ escape(document.getElementById('frm1702RT:txtPg1Pt1I8Name2').value)+ escape(document.getElementById('frm1702RT:txtPg1Pt1I8Name3').value) + "fn=</div>" + tab;
            allXML += "<div>tin2=" + document.getElementById('frm1702RT:txtPg1Pt1I6TIN2').value + "tin2=</div>" + tab;
            allXML += "<div>tin3=" + document.getElementById('frm1702RT:txtPg1Pt1I6TIN3').value + "tin3=</div>" + tab;
            allXML += "<div>tin1=" + document.getElementById('frm1702RT:txtPg1Pt1I6TIN1').value + "tin1=</div>" + tab;
            allXML += "<div>tin4=" + document.getElementById('frm1702RT:txtPg1Pt1I6TIN4').value + "tin4=</div>" + tab;
			
            allXML += "<div>rdo=" + document.getElementById('frm1702RT:txtRDO').value + "rdo=</div>" + tab;
            allXML += "<div>lob=" + escape(document.getElementById('frm1702RT:txtPg1Pt1I18Business').value) + "lob=</div>" + tab;
            allXML += "<div>regAddr=" + escape(document.getElementById('frm1702RT:txtPg1Pt1I9Address1').value)+ escape(document.getElementById('frm1702RT:txtPg1Pt1I9Address2').value)+ escape(document.getElementById('frm1702RT:txtPg1Pt1I9Address3').value) + "regAddr=</div>" + tab;

            //No Zip for 1702RT, just get it from var p3TPZip
            allXML += "<div>zip=" + document.getElementById('frm1702RT:txtZIP').value + "zip=</div>" + tab;
            //allXML += "<div>zip=" + p3TPZip + "zip=</div>" + tab;

            allXML += "<div>telNo=" + d.getElementById('frm1702RT:txtPg1Pt1I11Contact').value + "telNo=</div>" + tab;
            allXML += "<div>email=" + d.getElementById('frm1702RT:txtPg1Pt1I12Email').value + "email=</div>" + tab; 
			allXML += "<div>confirmemail=" + d.getElementById('frm1702RT:txtPg1Pt1I12Email').value + "confirmemail=</div>" + tab;
            allXML += "<div>confirmtin1=" + d.getElementById('frm1702RT:txtPg1Pt1I6TIN1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm1702RT:txtPg1Pt1I6TIN2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm1702RT:txtPg1Pt1I6TIN3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm1702RT:txtPg1Pt1I6TIN4').value + "confirmtin4=</div>" + tab;
            allXML += "<div>formType=1702RTv2018formType=</div>" + tab;

            allXML += tab + document.getElementById('xmlClose').innerHTML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (isFinalCopy == false) {
                alert('Background information saved/updated successfully as : ' + xmlFileName);
				
            }
        }
    }

    var globalcancelModalInit = 0;
    var globalcurrentDiv = "";
    function cancel() {

        if (globalcancelModalInit != 1) {
            var inputs = document.getElementsByTagName("input");
            for (a = 0; a < inputs.length; a++) {
                if ((inputs[a].type == "checkbox" || inputs[a].type == "radio")) {
                    $(inputs[a].previousSibling).remove();
                    $(inputs[a]).addClass("styled");
                }
            }
          //  document.onmouseup();


            $('#bg').show();
            $('.printSignFooterClass').hide();
            $('.imgClass').hide();
            $('body').css('background', '#FFF');

            $('#formPaper').css({ 'border': '#CCC 1px solid', 'margin': '0 auto', 'background': '#FFF' });
            $('#wrapper').css({ 'padding': '1%', 'margin': '0 auto' });
            $('#container').css({ 'padding': '1%', 'margin': '0 auto' });
            $('.labels').remove();

            var elem = document.getElementById('frmMain').elements;
            for (var i = 0; i < elem.length; i++) {
                if (elem[i].type != 'hidden') { // && elem[i].type != 'undefined' 
                    if (elem[i].type == 'text') {
                        document.getElementById(elem[i].id).readOnly = false;
                        document.getElementById(elem[i].id).style.height = "15px"
                        document.getElementById(elem[i].id).style.fontSize = "12px"
                        if (document.getElementById('frm1702RT:cmdValidate').disabled == false) {
                            if (disabledItems.contains(elem[i].id)) {
                                document.getElementById(elem[i].id).disabled = true;
                            }
                            else {
                                document.getElementById(elem[i].id).disabled = false;
                            }
                        }
                        else {
                            if (disabledItems.contains(elem[i].id)) {
                                document.getElementById(elem[i].id).disabled = true;
                            }
                            else {
                                document.getElementById(elem[i].id).disabled = false;
                            }
                        }
                    }
                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        if (document.getElementById('frm1702RT:cmdValidate').disabled == false) {
                            if (disabledItems.contains(elem[i].id)) {
                                document.getElementById(elem[i].id).disabled = true;
                            }
                            else {
                                document.getElementById(elem[i].id).disabled = false;
                            }
                        }
                        else {
                            if (disabledItems.contains(elem[i].id)) {
                                document.getElementById(elem[i].id).disabled = true;
                            }
                            else {
                                document.getElementById(elem[i].id).disabled = false;
                            }
                        }
                        document.getElementById(elem[i].id).style.height = "15px"
                        document.getElementById(elem[i].id).style.fontSize = "11px"
                    }
                    if (elem[i].type == 'select-one') {
                        $(elem[i]).show();
                    }
                }
            }

            $('input').each(function () {
                if (this.type == 'button') {
                    if (this.name == 'navButton') {
                        $(this).removeAttr("disabled");
                    }
                    else if (this.id != 'test') {
                        $(this).removeClass('previewButtonClass');
                    }
                }
            });


            $('a').each(function () {
                if (this.id.length > 1) {
                    if (document.getElementById('frm1702RT:cmdValidate').disabled == false) {
                        if (enableElem) {
                            document.getElementById(this.id).disabled = true;
                        }
                        else if (disableElem) {
                            document.getElementById(this.id).disabled = false;
                        }
                    }
                    else {
                        if (disableElem) {
                            document.getElementById(this.id).disabled = true;
                        }
                        else if (enableElem) {
                            document.getElementById(this.id).disabled = false;
                        }
                    }
                }
            });

            $('#formMenu').show('blind');
            if ($('#printMenu').css('display') != 'none') {
                $('#printMenu').hide('blind');
            }

            if (qs('xmlFileName') != null && qs('xmlFileName').indexOf('.xml') > -1) {
                // refer to SRS for this part
                //document.getElementById('frm1702RT:txtPg1I2Year').disabled = true;
                //document.getElementById('frm1702RT:ddlPg1I2Month').disabled = true;
            }
        }
        else if (globalcancelModalInit == 1) {

            $('#bg').show();
            $('#' + globalcurrentDiv).removeClass();
            $('#' + globalcurrentDiv).addClass("modalShow");


            $('input').each(function () {
                if (this.type == 'button') {
                    if (this.id != 'test') {
                        $(this).removeClass('previewButtonClass');
                    }
                }
            });

            $('a').each(function () {
                if (this.id.length > 1) {
                    if (document.getElementById('frm1702RT:cmdValidate').disabled == false) {
                        if (enableElem) {
                            document.getElementById(this.id).disabled = true;
                        }
                        else if (disableElem) {
                            document.getElementById(this.id).disabled = false;
                        }
                    }
                    else {
                        if (disableElem) {
                            document.getElementById(this.id).disabled = true;
                        }
                        else if (enableElem) {
                            document.getElementById(this.id).disabled = false;
                        }
                    }
                }
            });

            $('#formMenu').show('blind');
            if ($('#printMenu').css('display') != 'none') {
                $('#printMenu').hide('blind');
            }

            if (qs('xmlFileName') != null && qs('xmlFileName').indexOf('.xml') > -1) {
                // refer to SRS for this part
                //document.getElementById('frm1702RT:txtPg1I2Year').disabled = true;
                //document.getElementById('frm1702RT:ddlPg1I2Month').disabled = true;
            }
            globalcancelModalInit = 0;
            globalcurrentDiv = "";
        }
        //document.onmouseup();
        $_Id('mnuPrint').disabled = false;
    }

