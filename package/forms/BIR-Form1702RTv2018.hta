                            else if (elem[i].id == 'frm1702RT:txtPg1Pt1I6TIN1' || elem[i].id == 'frm1702RT:txtPg2TIN1' || elem[i].id == 'frm1702RT:txtPg3TIN1'
                                    || elem[i].id == 'frm1702RT:txtPg4TIN1' ) {
