                goToPage();
                return;
            }
        }
     
        //Page 1 Part 3 Item 23
        if (validate_nullDescription('txtPg1Pt3I23DebitMemoC4Amount', 'txtPg1Pt3I23DebitMemoC1,txtPg1Pt3I23DebitMemoC2,txtPg1Pt3I23DebitMemoC3Date', 'Page 1 Part III Item 26') === false) {
            $_Id("frm1702RT:txtCurrentPage").value = 1;
            goToPage();
