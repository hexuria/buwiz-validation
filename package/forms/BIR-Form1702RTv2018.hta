                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String($("#response").html()).split(elem[i].id + '=');
                    if (elem[i].id == 'frm1702RT:txtPg1Pt1I8Name1' || elem[i].id == 'frm1702RT:txtPg1Pt1I8Name2' || elem[i].id == 'frm1702RT:txtPg1Pt1I8Name3'
						|| elem[i].id == 'frm1702RT:txtPg1Pt1I9Address1' || elem[i].id == 'frm1702RT:txtPg1Pt1I9Address2' || elem[i].id == 'frm1702RT:txtPg1Pt1I9Address3') {
                        elem[i].value = unescape(fieldVal[1]);
                    }
                    if (elem[i].id == 'frm1702RT:ddlPg1I2Month') {
                        elem[i].selectedIndex = fieldVal[1];
                    }
                    if (elem[i].id == 'frm1702RT:txtPg1Pt2I15TotalTaxCredits') {
                        fieldVal = (fieldVal[1] == undefined) ? String($("#response").html()).split('frm1702RT:txtPg2Pt4I45LessTotalTax=') : fieldVal;
                        elem[i].value = unescape(fieldVal[1]);
                    }

                    else if (elem[i].className.indexOf("FinalFlag") > -1) {
                        elem[i].value = typeof (fieldVal[1]) === "undefined" ? "3" : fieldVal[1];
                    }
                    else {
                        elem[i].value = unescape(fieldVal[1]); //all select-one and text values		 		
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String($("#response").html()).split(elem[i].id + '=');
                    if (rdoVal[1] == 'true') {
                        elem[i].checked = rdoVal[1];
                        //elem[i].onclick(); dgarfin: commented since it hinders the rest of the elements to load its values 
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String($("#response").html()).split(elem[i].id + '=');
                    if (chkboxVal[1] == 'true') {
                        elem[i].checked = chkboxVal[1];
                    }
                }
                //dgarfin: temporarily commented until modalAtc popup show/hide	
                //if (elem[i].type == 'button' && elem[i].id == 'btnOkPop') {
                //	elem[i].onclick();				
                //}					
            }

        }
        document.getElementById('frm1702RT:txtPg1Pt1I12Email').value = globalEmail;
        document.getElementById('frm1702RT:txtPg1Pt1I12Email').disabled = true;

    }

    function loadXMLWellFormed(loadWhere) {
        try {

            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLFile.AtEndOfStream)
                data = ""
            else {
                var response = document.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug				
            loadWFData(); /*This will load data onto fields*/
            if (response.innerHTML.indexOf("All Rights Reserved BIR 2014.0") >= 0) {
                gIsReadOnly = true;
            }

            if (gIsReadOnly) {
                document.getElementById('frm1702RT:cmdValidate').disabled = true;
                document.getElementById('btnSave').disabled = true;
            }
            window.setTimeout("$('#loader').hide('blind');", 2000);
        } catch (e) {
            //msg.innerHTML = "Save File not Found."
        } //this will Alert File not Found if it doesn't exist
    }

    function loadWFData() {
        /*This will load data onto fields*/
        var response = document.getElementById("response");
        var elem = document.getElementById('frmMain').elements;
        for (var i = 0; i < elem.length; i++) {

            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&  			
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String(response.innerHTML).split(elem[i].id + '>');
                    // elem[i].value = fieldVal[1]; //all select-one and text values		 
                    if (fieldVal != null && fieldVal.length > 1) {
                        elem[i].value = fieldVal[1].substring(0, fieldVal[1].indexOf("</"));
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String(response.innerHTML).split(elem[i].id + '>');
					if (rdoVal[1] == 'true') {
                        // elem[i].checked = rdoVal[1];
                        if (rdoVal != null && rdoVal.length > 1) {
                            elem[i].value = rdoVal[1].substring(0, rdoVal[1].indexOf("</"));
                        }
                        //elem[i].onclick(); dgarfin: commented since it hinders the rest of the elements to load its values 
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String(response.innerHTML).split(elem[i].id + '>');
                    if (chkboxVal[1] == 'true') {
                        // elem[i].checked = chkboxVal[1];
                        if (chkboxVal != null && chkboxVal.length > 1) {
                            elem[i].value = chkboxVal[1].substring(0, chkboxVal[1].indexOf("</"));
                        }
                    }
                }
                //dgarfin: temporarily commented until modalAtc popup show/hide	
                //if (elem[i].type == 'button' && elem[i].id == 'btnOkPop') {
                //	elem[i].onclick();				
                //}					
            }

        }
    }

    // if file is already existing
    function loadXML(loadWhere) {
        try {

            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLFile.AtEndOfStream)
                data = ""
            else {
                var response = document.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
			 
            XMLFile.Close(); //alert( response.innerHTML ); //Debug				
           loadData(); /*This will load data onto fields*/
            if (response.innerHTML.indexOf("All Rights Reserved BIR 2014.0") >= 0) {
                gIsReadOnly = true;
            }

            if (gIsReadOnly) {
                document.getElementById('frm1702RT:cmdValidate').disabled = true;
                document.getElementById('btnSave').disabled = true;
            }
            window.setTimeout("$('#loader').hide('blind');", 2000);

        } catch (e) {
            //msg.innerHTML = "Save File not Found."
        }   //this will Alert File not Found if it doesn't exist
    }


    function createEncXMLFileName(subFolder) {
        /// <summary>Creates XML FileName to folder [/IAF_RDO_Copy]</summary>
        /// <param name="subFolder" type="String">folder of saved files.</param>
        /// <returns type="String">xmlFileName</returns>

       var isAmendedReturn = isItAnAmendedReturn(); //check name of function if correct
        var xmlFileName = "";
        var titleTin1 = document.getElementById('frm1702RT:txtPg1Pt1I6TIN1');
        var titleTin2 = document.getElementById('frm1702RT:txtPg1Pt1I6TIN2');
        var titleTin3 = document.getElementById('frm1702RT:txtPg1Pt1I6TIN3');
        var titleBranchCode = document.getElementById('frm1702RT:txtPg1Pt1I6TIN4');
        var titleTPName = document.getElementById('frm1702RT:txtPg1Pt1I8Name1').value +' '+ document.getElementById('frm1702RT:txtPg1Pt1I8Name2').value+' '+ document.getElementById('frm1702RT:txtPg1Pt1I8Name3').value;
	     //change if there is Quarter option
        var ddlPg1I2Date = document.getElementById("frm1702RT:ddlPg1I2Month");
        var selectedMonth = ddlPg1I2Date.options[ddlPg1I2Date.selectedIndex].value;
        var selectedYear = "20"+document.getElementById('frm1702RT:txtPg1I2Year').value;

        var returnPeriod = selectedMonth + selectedYear;

        //xmlFileName = "profile/1702RT-" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + "-" +
        //( (titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').length > 12) ? titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').substring(0,12).toLowerCase() : titleTPName.value.replace(/[ ,\^;\)'\(]+/g, '').toLowerCase() ) + 
        //"-" + dtFormatted +
        //".xml"	

        xmlFileName = subFolder + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
  			"-1702RTv2018-" +
  			returnPeriod +
  			".xml"

        fileName = titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
    		"-1702RTv2018-" +
    		returnPeriod +
    		".xml"

        return xmlFileName;
    }

