        }
        //Page 1 Part 3 Item 24
        if (validate_nullDescription('txtPg1Pt3I24CheckC4Amount', 'txtPg1Pt3I24CheckC1,txtPg1Pt3I24CheckC2,txtPg1Pt3I24CheckC3Date', 'Page 1 Part III Item 27') === false) {
            $_Id("frm1702RT:txtCurrentPage").value = 1;
