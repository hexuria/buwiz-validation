                            } else if (elem[i].id == 'frm1702RT:txtPg1Pt2I16NetTax') {
                                p3BasicTax = elemValue;
                            } else if (elem[i].id == 'frm1702RT:txtPg1Pt2I20TotalPenalties') {
                                p3TotalPenalties = elemValue;
                            } else if (elem[i].id == 'frm1702RT:txtPg1Pt2I21TotalAmount') {
                                p3TotalAmountPayable = elemValue;
                            } else if (elem[i].id == 'frm1702RT:txtPg2Pt4I29NetSales') {
                                //alert("p3GrossSales >>> " + elemValue + " \r\n p3BasicTax >>> " + p3BasicTax);
                                p3GrossSales = elemValue;
                            }

                            allXML += "<div>" + elem[i].id + "=" + elemValue + elem[i].id + "=</div>" + tab; //all select-one and text values
                        }
                    }

                    if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
                        allXML += "<div>" + elem[i].id + "=" + elem[i].checked + elem[i].id + "=</div>" + tab; //all radio and checkbox values			

                        if (d.getElementById('frm1702RT:rdoPg1I3AmmendYes').checked == true) {
                            p3IsAmended = "Yes";
                        } else if (d.getElementById('frm1702RT:rdoPg1I3AmmendNo').checked == true) {
                            p3IsAmended = "No";
                        }
                    }
                }
            }
            p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;
            /*--------------------- follow this format for parsing --------------------------- */

            if (submit) {
                allXML += tab + document.getElementById('xmlClose').innerHTML + "0"
            } else {
                allXML += tab + document.getElementById('xmlClose').innerHTML;
            }

            //Phase 3: This 'savefile' will be uploaded to IAF Infra for DI processing
            savedReturn = allXML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (submit == false) {
                alert('BIR Form saved successfully as : ' + xmlFileName);
            }
        }
        return true;
    }

    function validate() {
        //Page 1 Item 1
        if ($_Id('frm1702RT:rdoPg1I1Calendar').checked == false && $_Id('frm1702RT:rdoPg1I1Fiscal').checked == false) {
            alert('Please select if you are filing for Calendar or Fiscal year on Page 1 Item 1');
            $_Id("frm1702RT:txtCurrentPage").value = 1;
            goToPage();
            return;
        }
        //Page 1 Item 2
        if ($_Id('frm1702RT:ddlPg1I2Month').value == 0 || $_Id('frm1702RT:txtPg1I2Year').value == 0) {
