                                    p3Surcharge = elemValue;
                                } else if (elem[i].id == 'frm1702RT:txtPg1Pt2I18Interest') {
                                    p3Interest = elemValue;
                                } else if (elem[i].id == 'frm1702RT:txtPg1Pt2I19Compromise') {
