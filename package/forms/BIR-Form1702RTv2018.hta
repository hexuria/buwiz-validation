        }
        //Page 1 Part 3 Item 25
        if (validate_nullDescription('txtPg1Pt3I25TaxDebitC4Amount', 'txtPg1Pt3I25TaxDebitC2,txtPg1Pt3I25TaxDebitDate', 'Page 1 Part III Item 28') === false) {
