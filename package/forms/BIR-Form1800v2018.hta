        this.txtOCT = '';
        this.txtTaxDecNo = '';
        this.txtLocation = '';
        this.txtLotImprovement = '';
        this.txtClassification = '';
        
    }

    
    
    var scheduleAToCommit = new Array();
    var ScheduleB2ToCommit = new Array();
	var scheduleB1ToCommit = new Array();

    var currentPage;
    var MaxPage = 2;
    
    function atcPropertyJS(formType, atcCode, description, rate, category, base, compType, constTaxDue, minimum, maximum, formatRate)
    {
        this.formType=formType;
        this.atcCode=atcCode;
        this.description=description;
        this.rate=rate;
        this.category=category;
        this.base=base;
        this.compType=compType;
        this.constTaxDue=constTaxDue;
        this.minimum=minimum;
        this.maximum=maximum;
        this.formatRate=formatRate;
    }
    /*----------------------------------*/
    var d=document,XMLBGFile='',data='',XMLFile='', XMLATCFile='',msg = d.getElementById('msg'),flag=true;
    var loader=d.getElementById('loader');
    /*----------------------------------*/
    
    function sleeptime()
    {       
        init2();
        
        var bgFileName =  qs('xmlBGInfoFileName'); 
        if (bgFileName != null && bgFileName.indexOf('.xml') > -1) {
            loadBGXML(bgFileName);  
        } 
        
        fileName =  qs('xmlFileName'); 
        if (fileName != null && fileName.indexOf('.xml') > -1) {
               //loadXML(fileName); 
			   var tin = fileName.split("/")[1].split("-");   loadBGXML("profile/"+ tin[0]+".xml");  loadXML2(fileName);

               existingXMLFileName = fileName;   
            if (gIsReadOnly) { 
            //window.setTimeout("disableAllElementIDs(); d.getElementById('btnUpload').disabled = false; d.getElementById('frm1800v2018:txtCurrentPage').disabled = false; d.getElementById('frm1800v2018:btnPrevPage').disabled = false; d.getElementById('frm1800v2018:btnNextPage').disabled = false;",1000); 
            window.setTimeout(" d.getElementById('frm1800v2018:cmdValidate').disabled = false; d.getElementById('frm1800v2018:btnFinalCopy').disabled; d.getElementById('frm1800v2018:txtCurrentPage').disabled = false; d.getElementById('frm1800v2018:btnPrevPage').disabled = false; d.getElementById('frm1800v2018:btnNextPage').disabled = false;",1000); 
            }
        } else {
            window.setTimeout("$('#loader').hide('blind');",100);
        }
        if ( $('#printMenu').css('display') != 'none' ) {   
            $('#printMenu').hide('blind');
        }

        if (d.getElementById("frm1800v2018:AmendedRtn_1").checked) {
            d.getElementById("frm1800v2018:TaxCredit17C").disabled = false;
        }
        
        processOtherParty();
        window.setTimeout("checkFinalCopyBtn('1800v2018')", 2000);
    }
    
    function rdoPropertyJS(rdoCode, description) 
    {
        this.rdoCode=rdoCode;
        this.description=description;
    }
        
    var rdoList = new Array();

    function init()
    {
        d.getElementById('frm1800v2018:AmendedRtn_1').disabled = false;
        d.getElementById('frm1800v2018:AmendedRtn_2').disabled = false;
        d.getElementById('frm1800v2018:txtSheets').disabled = false;
		
        //d.getElementById('frm1800v2018:txtATC').disabled = true;
		//for testing only: enable all disabled to test if data are saved
		/*
        d.getElementById('frm1800v2018:TotalNetGifts').disabled = false;
        d.getElementById('frm1800v2018:DonorTaxDue').disabled = false;
        d.getElementById('frm1800v2018:TaxCredit17A').disabled = false;
        d.getElementById('frm1800v2018:TaxCredit17B').disabled = false;
        d.getElementById('frm1800v2018:TaxCredit17C').disabled = false;
        d.getElementById('frm1800v2018:TaxCredit17D').disabled = true;
        d.getElementById('frm1800v2018:txtTaxPayable').disabled = false;
        d.getElementById('frm1800v2018:Surcharge').disabled = false;
        d.getElementById('frm1800v2018:Interest').disabled = false;
        d.getElementById('frm1800v2018:Compromise').disabled = false;
        d.getElementById('frm1800v2018:TotalPenalties').disabled = false;
        d.getElementById('frm1800v2018:TotalAmountPayable').disabled = false;
		d.getElementById('frm1800v2018:PersonalProperties').disabled = false;
        d.getElementById('frm1800v2018:RealProperties').disabled = false;
        d.getElementById('frm1800v2018:TotalGifts').disabled = false;
        d.getElementById('frm1800v2018:TotalDeductionsAllowed').disabled = false;
        d.getElementById('frm1800v2018:TotalReturnNetGifts').disabled = false;
        d.getElementById('frm1800v2018:TotalNetGifts36').disabled = false;
        d.getElementById('frm1800v2018:TotalNetGiftsSubjectToTax').disabled = false;
        
		
		*/
		
		//end
        var dt = new Date();
        d.getElementById('frm1800v2018:txtMonth').selectedIndex = dt.getMonth()+1;
		d.getElementById('frm1800v2018:txtDate').selectedIndex = dt.getDate();
        d.getElementById('frm1800v2018:txtYear').value = dt.getFullYear();
        
        currentPage = 1;
        d.getElementById('frm1800v2018:txtCurrentPage').value = currentPage;

        loadXMLATC('xml/atcCodes.xml');
        
        processModeAffixture(); //disable schedules if mode of affixture not tick
        
        d.getElementById('btnPrint').disabled = true;
		d.getElementById("btnSave").disabled = true;
        d.getElementById('frm1800v2018:cmdEdit').disabled = true;
        d.getElementById('frm1800v2018:btnFinalCopy').disabled = true;
        d.getElementById('btnUpload').disabled = true;
        getDrives();
        loadXMLrdo('xml/rdo.xml');
        getRdo();
    }
	
	function init2()
    {
        d.getElementById('frm1800v2018:AmendedRtn_1').disabled = false;
        d.getElementById('frm1800v2018:AmendedRtn_2').disabled = false;
        d.getElementById('frm1800v2018:txtSheets').disabled = false;
		
        
        var dt = new Date();
        d.getElementById('frm1800v2018:txtMonth').selectedIndex = dt.getMonth()+1;
		d.getElementById('frm1800v2018:txtDate').selectedIndex = dt.getDate();
        d.getElementById('frm1800v2018:txtYear').value = dt.getFullYear();
        
        currentPage = 1;
        d.getElementById('frm1800v2018:txtCurrentPage').value = currentPage;

        //loadXMLATC('xml/atcCodes.xml');
        
        //processModeAffixture(); //disable schedules if mode of affixture not tick
        
        d.getElementById('btnPrint').disabled = true;
		d.getElementById("btnSave").disabled = true;
        d.getElementById('frm1800v2018:cmdEdit').disabled = true;
        d.getElementById('frm1800v2018:btnFinalCopy').disabled = true;
        d.getElementById('btnUpload').disabled = true;
        getDrives();
        loadXMLrdo('xml/rdo.xml');
        getRdo2();
    }
    

    /*--------------------------------------------------------------*/
    //Added By dgarfin
    function loadXMLATC(fileLocation) {
        try {
            //This will load the ATC file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLATCFile = fsoXML.OpenTextFile(fileLocation,1);   
    
            if (XMLATCFile.AtEndOfStream)
                data = "";
            else {
                var responseATC = d.getElementById('responseATC'); //render file and write to hidden div
                responseATC.innerHTML = XMLATCFile.ReadAll(); //remove XML tag
            }
            XMLATCFile.Close(); //alert( responseATC.innerHTML ); //Debug           
            loadATC();  /*This will load ATC onto an array*/    
        } catch(e) {
            msg.innerHTML = "ATC File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }   
    
    var atcCount=0;
    
    function loadATC() {
        /*This will load data onto an array*/
        var response = d.getElementById("responseATC");
        
        var atcCnt = String(response.innerHTML).split('atcCount=');
        atcCount = atcCnt[1]; 
        
        var j = 0;
        //loads atcList from xml
        for (var i = 1; i <= atcCount; i++) { 
            
            var atc = String(response.innerHTML).split('atc'+i+':');
            var atcStr = atc[1];
            
            //Ensure that before writing to atcPropertyJS the formType 2000 is traceable in atcStr
            if (atcStr.indexOf('2000^') >= 0) {
                var atcValues = atcStr.split('~');              
                
                var formType = "2000";
                var atcCode = atcValues[0];
                var description = atcValues[1];
                var rate = atcValues[2];
                var category = atcValues[3];        
                
                var base = atcValues[4];    
                var compType = atcValues[5];    
                var constTaxDue = atcValues[6]; 
                var minimum = atcValues[7]; 
                var maximum = atcValues[8]; 
                var formatRate = atcValues[9];  
                
                var objATC = new atcPropertyJS(formType, atcCode, description, rate, category, base, compType, constTaxDue, minimum, maximum, formatRate);
                atcList[j] = objATC; 
                j++;
                //alert('2000 successfully created array #'+i);
                
            } else {        
                //alert('2000 not found in array #'+i);
                continue;
            }
        }           
    }   

    /*--------------------------------------------------------------*/  
    
    

    /*--------------------------------------------------------------*/
    function loadXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere,1); 
    
            if (XMLFile.AtEndOfStream)
                data = "";
            else {
                var response = d.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug         
            loadData(); /*This will load data onto fields*/         
            
            if (response.innerHTML.indexOf("All Rights Reserved BIR 2012.0") >= 0) {
                gIsReadOnly = true;
            }
        
            if (gIsReadOnly) {
                d.getElementById('frm1800v2018:cmdValidate').disabled = true;
				 enableSaveButton();
                d.getElementById('btnSave').disabled = true;
            }
            
            window.setTimeout("loadscheduleA();loadScheduleB1();processModeAffixture();", 500);//loadScheduleB2()
            window.setTimeout("$('#loader').hide('blind');",2000);  
            
        } catch(e) {
            msg.innerHTML = ""; //"Save File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }
	
	function loadXML2(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere,1); 
    
            if (XMLFile.AtEndOfStream)
                data = "";
            else {
                var response = d.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug         
            loadData3(); /*This will load data onto fields*/         
            
            if (response.innerHTML.indexOf("All Rights Reserved BIR 2012.0") >= 0) {
                gIsReadOnly = true;
            }
        
            if (gIsReadOnly) {
                d.getElementById('frm1800v2018:cmdValidate').disabled = true;
                d.getElementById('btnSave').disabled = true;
            }
            
            window.setTimeout("loadscheduleA();loadScheduleB2();loadScheduleB1();", 500);//loadScheduleB2()
            window.setTimeout("$('#loader').hide('blind');",2000);  
            
        } catch(e) {
            msg.innerHTML = ""; //"Save File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }
    
    
    function loadData() {
        /*This will load data onto fields*/
        var response = d.getElementById("response");
        
        var elem = document.getElementById('frmMain').elements;
        var fieldVal = "";
        for(var i = 0; i < elem.length; i++)
        {
            
            if (elem[i].type != 'undefined') {  //elem[i].type != 'button' && elem[i].type != 'hidden' &&           
                if (elem[i].type == 'text' || elem[i].type == 'select-one' || elem[i].type == 'hidden') {
                    
                    if(elem[i].id == 'frm1800v2018:txtResAddress2'){
                        fieldVal = String( $("#response").html() ).split("frm1800v2018:txtResAddress=");
                    }
                    //else if (elem[i].id == 'frm1800v2018:txtDoneeNameE') {
                    //    fieldVal = String( $("#response").html() ).split("frm1800v2018:txtDoneeNameA=");
                    //}
                    else{
                        fieldVal = String( $("#response").html() ).split(elem[i].id+'=');
                    }

                     elem[i].value = '';
                    if (fieldVal != null && fieldVal.length > 1  && fieldVal[1] != 'undefined') {
                        if(elem[i].id == 'frm1800v2018:txtDonorName' || elem[i].id == 'frm1800v2018:txtLineBus'){
