    function loadscheduleA() {
        //var paymentDate = String($("#response").html()).split("frm1800v2018:sched3:txtPaymentDate");  //paymentdate
        var receipt = String($("#response").html()).split("frm1800v2018:schedA:txtParticulars");  //receipt
        var amountPaid = String($("#response").html()).split("frm1800v2018:schedA:txtFairMarketValue");  //amountpaid

        $('#tblSchedA').html("");

        var i = 0;
        for(var j = 0; j < receipt.length; j++) {
            if (j % 2 != 0) {//to not get other div splits
                
                //get values
                scheduleAToCommit[i] = new scheduleA();
                //scheduleAToCommit[i].txtPaymentDate = paymentDate[j].split('=')[1];
                scheduleAToCommit[i].txtParticulars = receipt[j].split('=')[1];
                scheduleAToCommit[i].txtFairMarketValue = amountPaid[j].split('=')[1];
                
                i++;
            }
        }

        for (x=0;x< scheduleAToCommit.length;x++) {  

            $('#tblSchedA').html(d.getElementById('tblSchedA').innerHTML + "<tr>" +
            "<td width='2%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkscheduleADelete" + x + "'></font></td>" + 
            //"<td align='center'><input onblur='' type='text' value='" + scheduleAToCommit[x].txtPaymentDate + "' style='color: black; text-align: right;' size='20' maxlength='10' id='frm1800v2018:sched3:txtPaymentDate" + x + "' onkeypress='return wholenumber(this, event)' onkeydown='dateMasking(this);' /></td>" +
            "<td align='center'><input type='text' value='" + scheduleAToCommit[x].txtParticulars + "' style='color: black; text-align: right;' size='87' maxlength='100' id='frm1800v2018:schedA:txtParticulars" + x + "' onkeypress='return letternumber(event)' /></td>" + 
            "<td align='center'><input type='text' value='" + scheduleAToCommit[x].txtFairMarketValue + "' style='color: black; text-align: right;' size='23' maxlength='25' id='frm1800v2018:schedA:txtFairMarketValue" + x + "' onkeypress='return numbersonly(this, event)' onblur='round(this,2);computeScheduleA()' /></td>" + 
            "</tr>");
        }
    }  

