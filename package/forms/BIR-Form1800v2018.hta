            }
			
        } else {
            ScheduleB2ToCommit = new Array();
            $('#tblSchedB2').html("");
        }
        computeScheduleB2();
    } 
	
	function loadScheduleB1() {
        var OCT = String($("#response").html()).split("frm1800v2018:schedB1:txtOCT");  //rcocode
        var taxDecNo = String($("#response").html()).split("frm1800v2018:schedB1:txtTaxDecNo");  //remittancedate
        var location = String($("#response").html()).split("frm1800v2018:schedB1:txtLocation");  //bank
        var lotImprovement = String($("#response").html()).split("frm1800v2018:schedB1:txtLotImprovement");  //amountremitted
        var classification = String($("#response").html()).split("frm1800v2018:schedB1:txtClassification");  //numberfrom
        //var numberTo = String($("#response").html()).split("frm1800v2018:sched4:txtNumberTo");  //numberto

        $('#tblSchedB1').html("");

        var i = 0;
        for(var j = 0; j < OCT.length; j++) {
            if (j % 2 != 0) {//to not get other div splits
                
                //get values
                scheduleB1ToCommit[i] = new ScheduleB1();
                scheduleB1ToCommit[i].txtOCT = OCT[j].split('=')[1];
                scheduleB1ToCommit[i].txtTaxDecNo = taxDecNo[j].split('=')[1];
                scheduleB1ToCommit[i].txtLocation = location[j].split('=')[1];
                scheduleB1ToCommit[i].txtLotImprovement = lotImprovement[j].split('=')[1];
                scheduleB1ToCommit[i].txtClassification = classification[j].split('=')[1];
                //ScheduleB2ToCommit[i].txtNumberTo = numberTo[j].split('=')[1];
                
                i++;
            }
        }

        for (x=0;x< scheduleB1ToCommit.length;x++) {  

            $('#tblSchedB1').html(d.getElementById('tblSchedB1').innerHTML + "<tr>" +
            "<td width='2%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkScheduleB1Delete" + x + "'></font></td>" + 
            "<td width='13%' align='center'><input type='text' value='" + scheduleB1ToCommit[x].txtOCT + "' style='color: black; text-align: right;' size='8' maxlength='10' id='frm1800v2018:schedB1:txtOCT" + x + "' /></td>" + 
            "<td align='center'><input onblur='' type='text' value='" + scheduleB1ToCommit[x].txtTaxDecNo + "' style='color: black; text-align: right;' size='20' maxlength='140' id='frm1800v2018:schedB1:txtTaxDecNo" + x + "' /></td>" + 
            "<td align='center'><input type='text' value='" + scheduleB1ToCommit[x].txtLocation + "' style='color: black; text-align: right;' size='33' maxlength='140' id='frm1800v2018:schedB1:txtLocation"+ x +"' /></td>" + 
            "<td align='center'><input type='text' value='" + scheduleB1ToCommit[x].txtLotImprovement + "' style='color: black; text-align: right;' size='13' maxlength='140' id='frm1800v2018:schedB1:txtLotImprovement" + x + "' /></td>" + 
            "<td align='center'><input onblur='' type='text' value='" + scheduleB1ToCommit[x].txtClassification + "' style='color: black; text-align: right;' size='20' maxlength='200' id='frm1800v2018:schedB1:txtClassification" + x + "' /></td>" + 
           // "<td align='center'><input onblur='' type='text' value='" + ScheduleB2ToCommit[x].txtNumberTo + "' style='color: black; text-align: right;' size='10' maxlength='10' id='frm1800v2018:sched4:txtNumberTo" + x + "' onkeypress='return wholenumber(this, event)' /></td>" + 
            "</tr>");
        }
    }
	
	
	
