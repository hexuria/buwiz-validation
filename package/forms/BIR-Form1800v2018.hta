    /*----------Computation----------*/

    function computeTax15D() {
        //d.getElementById("frm1800v2018:txtTax15D").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:txtTax15A").value)*1 + NumWithComma(d.getElementById("frm1800v2018:txtTax15B").value)*1 + NumWithComma(d.getElementById("frm1800v2018:txtTax15C").value)*1);
        //computeTax16();
    }

    function computeTax16() {
        d.getElementById("frm1800v2018:txtTaxPayable").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:TotalNetGifts").value)*1 - NumWithComma(d.getElementById("frm1800v2018:txtTax15D").value)*1);
        computeTotalAmtPayable();
    }
  
    function computePenalties()
    {        
        d.getElementById("frm1800v2018:TotalPenalties").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:Surcharge").value)*1 + NumWithComma(d.getElementById("frm1800v2018:Interest").value)*1 + NumWithComma(d.getElementById("frm1800v2018:Compromise").value)*1);
        computeTotalAmtPayable();compute18()
		
    }

    function computeTotalAmtPayable() {
        d.getElementById("frm1800v2018:TotalAmountPayable").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:txtTaxPayable").value)*1 + NumWithComma(d.getElementById("frm1800v2018:TotalPenalties").value)*1);
		compute27();compute18();
	}
	
	function compute17D() {
        d.getElementById("frm1800v2018:TaxCredit17D").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:TaxCredit17A").value)*1 + NumWithComma(d.getElementById("frm1800v2018:TaxCredit17B").value)*1 + NumWithComma(d.getElementById("frm1800v2018:TaxCredit17C").value)*1);
		compute18();
    }
	
	function compute27() {
        d.getElementById("frm1800v2018:TotalGifts").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:PersonalProperties").value)*1 + NumWithComma(d.getElementById("frm1800v2018:RealProperties").value)*1); 
    }
	
	function compute33() {
		d.getElementById("frm1800v2018:TotalDeductionsAllowed").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:DeductionAmt1").value)*1 + NumWithComma(d.getElementById("frm1800v2018:DeductionAmt2").value)*1 + NumWithComma(d.getElementById("frm1800v2018:DeductionAmt3").value)*1 + NumWithComma(d.getElementById("frm1800v2018:DeductionAmt4").value)*1 + NumWithComma(d.getElementById("frm1800v2018:DeductionAmt5").value)*1); 
		compute34();
	}
	
	function compute34() {
		d.getElementById("frm1800v2018:TotalReturnNetGifts").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:TotalGifts").value)*1 - NumWithComma(d.getElementById("frm1800v2018:TotalDeductionsAllowed").value)*1); 
		compute36();
	}
	
	function compute36() {
		d.getElementById("frm1800v2018:TotalNetGifts36").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:TotalReturnNetGifts").value)*1 + NumWithComma(d.getElementById("frm1800v2018:TotalPriorNetGifts").value)*1); 
		compute38();
	}
	
	function compute38() {
		d.getElementById("frm1800v2018:TotalNetGiftsSubjectToTax").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:TotalNetGifts36").value)*1 - 250000); 
		d.getElementById("frm1800v2018:TotalNetGifts").value = d.getElementById("frm1800v2018:TotalNetGiftsSubjectToTax").value;
		compute16();
    }
	
	function compute16() {
		d.getElementById("frm1800v2018:DonorTaxDue").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:TotalNetGifts").value)*1 * .06); 
		compute18();
	}
	
	function compute18() {
		d.getElementById("frm1800v2018:txtTaxPayable").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:DonorTaxDue").value)*1 - NumWithComma(d.getElementById("frm1800v2018:TaxCredit17D").value)*1); 
	computeTotalAmtPayable();
    }
	
    function newRate(i) {
		
        switch (d.getElementById('drpATCCode'+i).value) {
            case "DS106":
				 d.getElementById("frm1800v2018:numOfDays").value = 0;
				d.getElementById("frm1800v2018:cmdValidate").disabled = true;
                d.getElementById("btnSave").disabled = true;
                $('#ds106modal').show('fade');
				d.getElementById("frm1800v2018:rowLocation").value=i;
			    break;
                
            default:
                break;              
        }
    }

    function ds106BtnFunc(){
        if (d.getElementById('ds106modYes').checked == true){
            d.getElementById('frm1800v2018:numOfDays').disabled = false;
            d.getElementById('frm1800v2018:numOfDays').focus();
        }
        else{
            d.getElementById('frm1800v2018:numOfDays').disabled = true;
            d.getElementById('frm1800v2018:numOfDays').value = 0;
        }
    }
    
    function ds106InputDays(){
        if (d.getElementById('frm1800v2018:numOfDays').value >= 366 || d.getElementById('frm1800v2018:numOfDays').value <= 0){
            alert("Number of days should be from 1 to 365 only.");
        }
    }

