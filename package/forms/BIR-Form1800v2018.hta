            "<td align='center'><input onblur='' type='text' value='" + scheduleB1ToCommit[i].txtTaxDecNo + "' style='color: black; text-align: right;' size='20' maxlength='140' id='frm1800v2018:schedB1:txtTaxDecNo" + i + "'  /></td>" + 
            "<td align='center'><input type='text' value='" + scheduleB1ToCommit[i].txtLocation + "' style='color: black; text-align: right;' size='33' maxlength='140' id='frm1800v2018:schedB1:txtLocation"+ i +"' /></td>" + 
