    function computeScheduleA() {
        d.getElementById("frm1800v2018:schedA:txtTotalPayment1").value = "0.00";

        for(var i=0;i<d.getElementById("tblSchedA").rows.length;i++) {
            d.getElementById("frm1800v2018:schedA:txtTotalPayment1").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:schedA:txtTotalPayment1").value)*1 + NumWithComma(d.getElementById("frm1800v2018:schedA:txtFairMarketValue"+i).value)*1);
        }

        d.getElementById("frm1800v2018:PersonalProperties").value = d.getElementById("frm1800v2018:schedA:txtTotalPayment1").value;
		compute27();
		compute34();
        //computeTax15D();
    }

    function computeScheduleB2() {
        d.getElementById("frm1800v2018:schedB2:txtTotal").value = "0.00";

        for(var i=0;i<d.getElementById("tblSchedB2").rows.length;i++) {
            d.getElementById("frm1800v2018:schedB2:txtTotal").value = formatCurrency(NumWithComma(d.getElementById("frm1800v2018:schedB2:txtTotal").value)*1 + NumWithComma(d.getElementById("frm1800v2018:schedB2:txtFairMarketValue"+i).value)*1);
        }

        d.getElementById("frm1800v2018:RealProperties").value = d.getElementById("frm1800v2018:schedB2:txtTotal").value;
		compute27();
		compute34();
    }

