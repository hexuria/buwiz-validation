    function deleteScheduleA() {
		var scheduleTemp = new Array();
        var rowCount = d.getElementById("tblSchedA").rows.length;
        for(var i = 0; i < rowCount; i++ ) {
            
            scheduleAToCommit[i] = new scheduleA();
            //scheduleAToCommit[i].txtPaymentDate = d.getElementById("frm1800v2018:sched3:txtPaymentDate"+i).value;
            scheduleAToCommit[i].txtParticulars = d.getElementById("frm1800v2018:schedA:txtParticulars"+i).value;
            scheduleAToCommit[i].txtFairMarketValue = d.getElementById("frm1800v2018:schedA:txtFairMarketValue"+i).value;
        }
        i = 0;
        for(var j = 0; j < rowCount; j++ ) {
            if(!d.getElementById("chkscheduleADelete" + j).checked) {
                scheduleTemp[i++] = scheduleAToCommit[j];
            }
        }

        if(scheduleTemp.length > 0) {
            scheduleAToCommit = new Array();
            
            $('#tblSchedA').html("");

            for(i = 0; i < scheduleTemp.length; i++) {
                scheduleAToCommit[i] = scheduleTemp[i];

                $('#tblSchedA').html(d.getElementById('tblSchedA').innerHTML + "<tr>" +
                "<td width='2%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkscheduleADelete" + i + "'></font></td>" + 
                <!--"<td align='center'><input onblur='' type='text' value='" + scheduleAToCommit[i].txtPaymentDate + "' style='color: black; text-align: right;' size='20' maxlength='10' id='frm1800v2018:sched3:txtPaymentDate" + i + "' onkeypress='return wholenumber(this, event)' onkeydown='dateMasking(this);' /></td>" + -->
                "<td align='center'><input type='text' value='" + scheduleAToCommit[i].txtParticulars + "' style='color: black; text-align: right;' size='87' maxlength='200' id='frm1800v2018:schedA:txtParticulars" + i + "'  /></td>" + 
                "<td align='center'><input type='text' value='" + scheduleAToCommit[i].txtFairMarketValue + "' style='color: black; text-align: right;' size='23' maxlength='25' id='frm1800v2018:schedA:txtFairMarketValue" + i + "' onkeypress='return numbersonly(this, event)' onblur='round(this,2);computeScheduleA()' /></td>" + 
                "</tr>");
            }
        } else {
            scheduleAToCommit = new Array();
            $('#tblSchedA').html("");
        }
        computeScheduleA();
		
    } 

