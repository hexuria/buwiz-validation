	function checkDate() {
		var dt = new Date();
		if(d.getElementById('frm1800v2018:txtMonth').value > dt.getMonth()+1 && d.getElementById('frm1800v2018:txtYear').value >= dt.getFullYear()){
			alert("Date of donation should not be later than the current date.");	
			
		}else if(d.getElementById('frm1800v2018:txtDate').value > dt.getDate() && d.getElementById('frm1800v2018:txtMonth').value == dt.getMonth()+1 && d.getElementById('frm1800v2018:txtYear').value == dt.getFullYear()){
			alert("Date of donation should not be later than the current date.");	
			
		}else if(d.getElementById('frm1800v2018:txtYear').value > dt.getFullYear()){
			alert("Date of donation should not be later than the current date.");	
			
		}
		else{
			return ;
		}
	}
	function checkDate1() {
		var dt = new Date();
		if(d.getElementById('frm1800v2018:txtMonth').value > dt.getMonth()+1 && d.getElementById('frm1800v2018:txtYear').value >= dt.getFullYear()){
			alert("Date of donation should not be later than the current date.");	
			d.getElementById("btnSave").disabled = true;
			return false;
			
		}else if(d.getElementById('frm1800v2018:txtDate').value > dt.getDate() && d.getElementById('frm1800v2018:txtMonth').value == dt.getMonth()+1 && d.getElementById('frm1800v2018:txtYear').value == dt.getFullYear()){
			alert("Date of donation should not be later than the current date.");	
			d.getElementById("btnSave").disabled = true;
			return false;
		}else if(d.getElementById('frm1800v2018:txtYear').value > dt.getFullYear()){
			alert("Date of donation should not be later than the current date.");	
			d.getElementById("btnSave").disabled = true;
			return false;
		}
		else if(d.getElementById("frm1800v2018:txtMonth").value == "00" || d.getElementById("frm1800v2018:txtDate").value =="00" || 
			d.getElementById("frm1800v2018:txtYear").value ==""	) {
			alert("Please enter a valid date on Item 1.");
			return false ;
		}
		else if ((d.getElementById("frm1800v2018:txtYear").value).length < 4) {
				alert("Please enter a valid Year(YYYY)");
				return false;
		}
		else{
			return true;
		}
	}
	
