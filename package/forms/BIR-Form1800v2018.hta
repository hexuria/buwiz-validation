    function getRdo()
    {
        var data = "<select class='iceSelOneMnu' id='frm1800v2018:txtRDOCode' name='frm1800v2018:txtRDOCode' size='1' disabled><option value='000' > </option>";
        
        for(var i = 0; i < rdoList.length; i++) {
            var rdo = rdoList[i];
            data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";
            
        }
        data = data + "</select>"
        
        $('#rdoSelect').html(data);     
        
    }
	
	function getRdo2()
    {
        var data = "<select class='iceSelOneMnu' id='frm1800v2018:txtRDOCode' name='frm1800v2018:txtRDOCode' size='1' disabled><option value='000' > </option>";
        
        for(var i = 0; i < rdoList.length; i++) {
            var rdo = rdoList[i];
            data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";
            
        }
        data = data + "</select>"
        
        $('#rdoSelect').html(data);     
        
    }
    
    function initialValidateBeforeSave() {
			if( (d.getElementById('frm1800v2018:txtDate').value == "") && (d.getElementById('frm1800v2018:txtMonth').value == "") && (d.getElementById('frm1800v2018:txtYear').value == "")   ){
				alert("Please enter a valid Return Date");
				return false;
			}
			if  (d.getElementById('frm1800v2018:txtYear').length < 4) {
				alert("Please enter a valid Year(YYYY)");
				return false;
			}
            if( (d.getElementById('frm1800v2018:txtTIN1').value == "" || d.getElementById('frm1800v2018:txtTIN2').value == "" || d.getElementById('frm1800v2018:txtTIN3').value == "" || d.getElementById('frm1800v2018:txtBranchCode').value == "")  )
            {
                alert("Please enter a valid TIN number on Item 5.");
                return false;
            }   
            if ((d.getElementById('frm1800v2018:txtRDOCode').value == "000")) {
                alert("Please enter a valid RDO Code on Item 6.");
                return false;
            }
            if( (d.getElementById('frm1800v2018:txtDonorName').value == "")  )
            {
                alert("Please enter a valid Taxpayer's Name on Item 8.");
                return false;
            }       
            return true;
    }   

