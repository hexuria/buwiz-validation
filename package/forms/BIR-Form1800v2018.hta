        function deleteScheduleB1() {

        var scheduleTemp = new Array();
        var rowCount = d.getElementById("tblSchedB1").rows.length;
        for(var i = 0; i < rowCount; i++ ) {
            
            scheduleB1ToCommit[i] = new ScheduleB1();
            scheduleB1ToCommit[i].txtOCT = d.getElementById("frm1800v2018:schedB1:txtOCT"+i).value;
            scheduleB1ToCommit[i].txtTaxDecNo = d.getElementById("frm1800v2018:schedB1:txtTaxDecNo"+i).value;
            scheduleB1ToCommit[i].txtLocation = d.getElementById("frm1800v2018:schedB1:txtLocation"+i).value;
            scheduleB1ToCommit[i].txtLotImprovement = d.getElementById("frm1800v2018:schedB1:txtLotImprovement"+i).value;
            scheduleB1ToCommit[i].txtClassification = d.getElementById("frm1800v2018:schedB1:txtClassification"+i).value;
            //ScheduleB2ToCommit[i].txtNumberTo = d.getElementById("frm1800v2018:sched4:txtNumberTo"+i).value;
        }
        i = 0;
        for(var j = 0; j < rowCount; j++ ) {
            if(!d.getElementById("chkScheduleB1Delete" + j).checked) {
                scheduleTemp[i++] = scheduleB1ToCommit[j];
            }
        }

        if(scheduleTemp.length > 0) {
            scheduleB1ToCommit = new Array();
            
            $('#tblSchedB1').html("");

            for(i = 0; i < scheduleTemp.length; i++) {
                scheduleB1ToCommit[i] = scheduleTemp[i];

                $('#tblSchedB1').html(d.getElementById('tblSchedB1').innerHTML + "<tr>" +
                "<td width='2%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkScheduleB1Delete" + i + "'></font></td>" + 
                "<td width='13%' align='center'><input type='text' value='" + scheduleB1ToCommit[i].txtOCT + "' style='color: black; text-align: right;' size='11' maxlength='10' id='frm1800v2018:schedB1:txtOCT" + i + "' /></td>" + 
                "<td align='center'><input onblur='' type='text' value='" + scheduleB1ToCommit[i].txtTaxDecNo + "' style='color: black; text-align: right;' size='20' maxlength='140' id='frm1800v2018:schedB1:txtTaxDecNo" + i + "' /></td>" + 
                "<td align='center'><input type='text' value='" + scheduleB1ToCommit[i].txtLocation + "' style='color: black; text-align: right;' size='33' maxlength='140' id='frm1800v2018:schedB1:txtLocation"+ i +"' /></td>" + 
                "<td align='center'><input type='text' value='" + scheduleB1ToCommit[i].txtLotImprovement + "' style='color: black; text-align: right;' size='13' maxlength='140' id='frm1800v2018:schedB1:txtLotImprovement" + i + "'  /></td>" + 
                "<td align='center'><input onblur='' type='text' value='" + scheduleB1ToCommit[i].txtClassification + "' style='color: black; text-align: right;' size='20' maxlength='200' id='frm1800v2018:schedB1:txtClassification" + i + "' /></td>" + 
                //"<td align='center'><input onblur='' type='text' value='" + ScheduleB2ToCommit[i].txtNumberTo + "' style='color: black; text-align: right;' size='10' maxlength='10' id='frm1800v2018:sched4:txtNumberTo" + i + "' onkeypress='return wholenumber(this, event)' /></td>" + 
                "</tr>");
            }
        } else {
            scheduleB1ToCommit = new Array();
            $('#tblSchedB1').html("");
        }
        //computeScheduleB2();
    } 
				

