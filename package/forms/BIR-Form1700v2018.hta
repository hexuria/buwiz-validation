    function computeSched1I5(){
        var totalTaxpayerC = 0;
        var totalTaxpayerD = 0;
        var totalTaxpayerE = 0;
        var totalSpouseC = 0;
        var totalSpouseD = 0;
        var totalSpouseE = 0;

        //Item 1
        if(d.getElementById('frm1700:rdoPg2I1PartVIEmployeeT').checked){
            totalTaxpayerC += NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_1REG').value);
            totalTaxpayerD += NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_1CIFR').value);
            totalTaxpayerE += NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_1TW').value);  
        }else{
            totalSpouseC += NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_1REG').value);
            totalSpouseD += NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_1CIFR').value);
            totalSpouseE += NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_1TW').value);  
        }

        //Item 2
        if(d.getElementById('frm1700:rdoPg2I2PartVIEmployeeT').checked){
            totalTaxpayerC += NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_2REG').value);
            totalTaxpayerD += NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_2CIFR').value);
            totalTaxpayerE += NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_2TW').value);  
        }else{
            totalSpouseC += NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_2REG').value);
            totalSpouseD += NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_2CIFR').value);
            totalSpouseE += NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_2TW').value);  
        }
            
        //Item 3
        if(d.getElementById('frm1700:rdoPg2I3PartVIEmployeeT').checked){
            totalTaxpayerC += NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_3REG').value);
            totalTaxpayerD += NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_3CIFR').value);
            totalTaxpayerE += NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_3TW').value);  
        }else{
            totalSpouseC += NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_3REG').value);
            totalSpouseD += NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_3CIFR').value);
            totalSpouseE += NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_3TW').value);  
        }


        //Item 4

        if(saveSched1Items.length > 0){
            for(var i = 0; i < saveSched1Items.length ;i++){

                if(saveSched1Items[i].taxpayer){
                    totalTaxpayerC += NumWithComma(saveSched1Items[i].eCompensationRegularIncome);
                    totalTaxpayerD += NumWithComma(saveSched1Items[i].eCompensationIncomeFlatRate);
                    totalTaxpayerE += NumWithComma(saveSched1Items[i].etaxWithheld);
                }else{
                    totalSpouseC += NumWithComma(saveSched1Items[i].eCompensationRegularIncome);
                    totalSpouseD += NumWithComma(saveSched1Items[i].eCompensationIncomeFlatRate);
                    totalSpouseE += NumWithComma(saveSched1Items[i].etaxWithheld);
                }

                
            }

            d.getElementById('frm1700:txtPg2ISched1c_4REG').value = d.getElementById("frm1700:txtPg2Pt6I4SubtotalC").value;
            d.getElementById('frm1700:txtPg2ISched1d_4CIFR').value = d.getElementById("frm1700:txtPg2Pt6I4SubtotalD").value;
            d.getElementById('frm1700:txtPg2ISched1e_4TW').value = d.getElementById("frm1700:txtPg2Pt6I4SubtotalE").value;
        }else{
            if(d.getElementById('frm1700:rdoPg2I4PartVIEmployeeT').checked){
                totalTaxpayerC += NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_4REG').value);
                totalTaxpayerD += NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_4CIFR').value);
                totalTaxpayerE += NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_4TW').value);  
            }else{
                totalSpouseC += NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_4REG').value);
                totalSpouseD += NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_4CIFR').value);
                totalSpouseE += NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_4TW').value);  
            }
        }
       
       
       

        d.getElementById('frm1700:txtPg2ISched1c_5AREG').value = formatCurrency((totalTaxpayerC).toFixed(0));
        d.getElementById('frm1700:txtPg2ISched1d_5ACIFR').value = formatCurrency((totalTaxpayerD).toFixed(0));
        d.getElementById('frm1700:txtPg2ISched1e_5ATW').value = formatCurrency((totalTaxpayerE).toFixed(0));

        d.getElementById('frm1700:txtPg2ISched1c_5BREG').value = formatCurrency((totalSpouseC).toFixed(0));
        d.getElementById('frm1700:txtPg2ISched1d_5BCIFR').value = formatCurrency((totalSpouseD).toFixed(0));
        d.getElementById('frm1700:txtPg2ISched1e_5BTW').value = formatCurrency((totalSpouseE).toFixed(0));
        // alert(totalSpouseC);    

        if(d.getElementById('frm1700:rdoPg1I6TaxpayerTypeE').checked){
            d.getElementById('frm1700:txtPg2I42A').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_5AREG').value).toFixed(0));
            computePg2I44(TAXPAYER);
        }else {
            d.getElementById('frm1700:txtPg2I48A').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_5ACIFR').value).toFixed(0));
            computePg2I50(TAXPAYER);
        }
       
        d.getElementById('frm1700:txtPg2I54A').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_5ATW').value).toFixed(0));
        computePg2I58(TAXPAYER);

        if(d.getElementById('frm1700:rdoPg1I20SpouseTaxpayerTypeE').checked){
            d.getElementById('frm1700:txtPg2I42B').value = formatCurrency(d.getElementById('frm1700:txtPg2ISched1c_5BREG').value);
            computePg2I44(SPOUSE);
        }else if(d.getElementById('frm1700:rdoPg1I20SpouseTaxpayerTypeN').checked){
            d.getElementById('frm1700:txtPg2I48B').value = formatCurrency(d.getElementById('frm1700:txtPg2ISched1d_5BCIFR').value);
            computePg2I50(SPOUSE);
        }
       
        d.getElementById('frm1700:txtPg2I54B').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_5BTW').value).toFixed(0));
        computePg2I58(SPOUSE);
    }

	function checkYear(field){
		var dt = new Date();

		switch (field){
			case 'taxYear':
				if (d.getElementById('frm1700:txtPg1I1Year').value * 1 > dt.getFullYear() * 1){
					alert("Invalid year input. Year should not be later to the Current Year.");
					//d.getElementById('frm1700:txtPg1I1Year').value = dt.getFullYear() - 1;
				}
				
				if (d.getElementById('frm1700:txtPg1I1Year').value * 1 < 2018) {
					alert("Invalid year input. Year should not be lower than 2018.")
					//d.getElementById('frm1700:txtPg1I1Year').value = dt.getFullYear() - 1;
				}
				break;

			case 'birthDate':
				//if (d.getElementById('frm1700:txtPg1I9BirthDate').value * 1 >= dt.getFullYear() * 1){
				if (validateMonthDayYearDate(d.getElementById('frm1700:txtPg1I9BirthDate').value)) {
					alert("Invalid birth date entered.  Please check date format."); 
					d.getElementById("frm1700:txtPg1I9BirthDate").value = "";
					d.getElementById("frm1700:txtPg1I9BirthDate").focus();
				}

				if (d.getElementById('frm1700:txtPg1I9BirthDate').value.split('/')[0] * 1 > dt.getMonth() + 1 * 1 &&
					d.getElementById('frm1700:txtPg1I9BirthDate').value.split('/')[1] * 1 > dt.getDate() * 1 &&
					d.getElementById('frm1700:txtPg1I9BirthDate').value.split('/')[2] * 1 > dt.getFullYear() * 1) {
					alert("Birth year should not be a future date.");
					d.getElementById("frm1700:txtPg1I9BirthDate").value = "";
					d.getElementById("frm1700:txtPg1I9BirthDate").focus();
				}
				break
		}
	}

    function computeTaxDue(income){
        var total = 0;
        var year = d.getElementById('frm1700:txtPg1I1Year').value;
        // if(year >= 2023){
        //     if(income >= 8000000){
        //         total = ((income - 8000000) * (35 / 100) + 2410000).toFixed(2);
        //     }else if(income >= 2000000){
        //         total = ((income - 2000000) * (30 / 100) + 490000).toFixed(2);
        //     }else if(income >= 800000){
        //         total = ((income - 800000) * (25 / 100) + 130000).toFixed(2);
        //     }else if(income >= 400000){
        //         total = ((income - 400000) * (20 / 100) + 30000).toFixed(2);
        //     }else if(income >= 250000){
        //         total = ((income - 250000) * (15 / 100)).toFixed(2);
        //     }else if(income < 250000){
        //         total = 0;
        //     }
        // }
        // else if(year >= 2018){

        //     if(income >= 8000000){
        //         total = ((income - 8000000) * (35 / 100) + 2410000).toFixed(2);
        //     }else if(income >= 2000000){
        //         total = ((income - 2000000) * (32 / 100) + 490000).toFixed(2);
        //     }else if(income >= 800000){
        //         total = ((income - 800000) * (30 / 100) + 130000).toFixed(2);
        //     }else if(income >= 400000){
        //         total = ((income - 400000) * (25 / 100) + 30000).toFixed(2);
        //     }else if(income >= 250000){
        //         total = ((income - 250000) * (20 / 100)).toFixed(2);
        //     }else if(income < 250000){
        //         total = 0;
        //     }
        // }

        if(year >= 2023){
            if(income >= 8000000){
                total = ((income - 8000000) * (35 / 100) + 2202500).toFixed(2);
            }else if(income >= 2000000){
                total = ((income - 2000000) * (30 / 100) + 402500).toFixed(2);
            }else if(income >= 800000){
                total = ((income - 800000) * (25 / 100) + 102500).toFixed(2);
            }else if(income >= 400000){
                total = ((income - 400000) * (20 / 100) + 22500).toFixed(2);
            }else if(income >= 250000){
                total = ((income - 250000) * (15 / 100)).toFixed(2);
            }else if(income < 250000){
                total = 0;
            }
        }
        else if(year >= 2018 && year <= 2022){

            if(income >= 8000000){
                total = ((income - 8000000) * (35 / 100) + 2410000).toFixed(2);
            }else if(income >= 2000000){
                total = ((income - 2000000) * (32 / 100) + 490000).toFixed(2);
            }else if(income >= 800000){
                total = ((income - 800000) * (30 / 100) + 130000).toFixed(2);
            }else if(income >= 400000){
                total = ((income - 400000) * (25 / 100) + 30000).toFixed(2);
            }else if(income >= 250000){
                total = ((income - 250000) * (20 / 100)).toFixed(2);
            }else if(income < 250000){
                total = 0;
            }
        }

        return total;
    }



