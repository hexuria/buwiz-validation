    function setSchedule1More(){
        
        if(saveSched1Items.length==0){
            sched1Item4Original = {};
            sched1Item4Original = {'taxpayer':d.getElementById('frm1700:rdoPg2I4PartVIEmployeeT').checked,
                            'spouse': d.getElementById('frm1700:rdoPg2I4PartVIEmployeeS').checked,
                            'employerName1' : d.getElementById('frm1700:txtPg2I4PartVIEmployerName1').value,
                            'employerName2' : d.getElementById('frm1700:txtPg2I4PartVIEmployerName2').value,
                            'eTIN1' : d.getElementById('frm1700:txtPg2I4PartVIEmployerTIN1').value,
                            'eTIN2' : d.getElementById('frm1700:txtPg2I4PartVIEmployerTIN2').value,
                            'eTIN3' : d.getElementById('frm1700:txtPg2I4PartVIEmployerTIN3').value,
                            'eTINBranchCode' : d.getElementById('frm1700:txtPg2I4PartVIEmployerBranchCode').value,
                            'eCompensationRegularIncome'  : d.getElementById('frm1700:txtPg2ISched1c_4REG').value,
                            'eCompensationIncomeFlatRate' : d.getElementById('frm1700:txtPg2ISched1d_4CIFR').value,
                            'etaxWithheld' : d.getElementById('frm1700:txtPg2ISched1e_4TW').value
            };

            saveSched1Items.push(sched1Item4Original);
        }

        setUpSchedule1TableModal();
        reloadTable(true);

    }

    function reloadTable(bool){
        $("#tblSchedule1Page2Part6Continuation").find("tr").remove();
        $("#tblSchedule1Page2Part6EmployersInfo").find("tr").remove();

        if(bool){
            sched1Items = new Array();
            for(var i = 0; i < saveSched1Items.length;i++){
                sched1Items.push(saveSched1Items[i]);
            }
        }

        for(var i=1; i <=sched1Items.length; i++){
            addRow_schedule1();
            d.getElementById('frm1700:rdoPg2I4_'+i+'PartVIEmployeeT').checked=sched1Items[i-1].taxpayer;
            d.getElementById('frm1700:rdoPg2I4_'+i+'PartVIEmployeeS').checked=sched1Items[i-1].spouse;
            d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerName1').value=sched1Items[i-1].employerName1;
            d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerName2').value=sched1Items[i-1].employerName2;
            d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerTIN1').value=sched1Items[i-1].eTIN1;
            d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerTIN2').value=sched1Items[i-1].eTIN2;
            d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerTIN3').value=sched1Items[i-1].eTIN3;
            d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerBranchCode').value=sched1Items[i-1].eTINBranchCode;
            d.getElementById('frm1700:txtPg2ISched1c_4_'+i+'REG').value=sched1Items[i-1].eCompensationRegularIncome
            d.getElementById('frm1700:txtPg2ISched1d_4_'+i+'CIFR').value=sched1Items[i-1].eCompensationIncomeFlatRate
            d.getElementById('frm1700:txtPg2ISched1e_4_'+i+'TW').value=sched1Items[i-1].etaxWithheld;

            if(sched1Items[i-1].taxpayer){
                enabledSched1ColumnField(d.getElementById('frm1700:rdoPg2I4_'+i+'PartVIEmployeeT'), getThisId(i));
                enabledContinuationOfSchedule1(getThisId(i));
            }else if(sched1Items[i-1].spouse){
                enabledSched1ColumnField(d.getElementById('frm1700:rdoPg2I4_'+i+'PartVIEmployeeS'), getThisId(i));
                enabledContinuationOfSchedule1(getThisId(i));
            }
            
        }
        if(gIsReadOnly || !isEditable){
            $('input[id*="4_"]').each(function(){
                $(this).attr('disabled','disabled');
            });
            d.getElementById('frm1700:btnPg2Pt6Save').disabled = true;
            d.getElementById('frm1700:btnPg2Pt6Cancel').disabled = true;
            d.getElementById('frm1700:btnPg2Pt6Close').disabled = false;
        }else{
            enabledAddButton(getThisId(d.getElementById("tblSchedule1Page2Part6Continuation").rows.length));
            d.getElementById('frm1700:btnPg2Pt6Save').disabled = false;
            d.getElementById('frm1700:btnPg2Pt6Cancel').disabled = false;
        }
        
    }

    function removeRow(elem){
        getSched1MoreData();
        var i=$("#"+elem.id).closest("td").find("input[type='hidden']").attr('value');
        sched1Items.splice(i-1, 1);
        reloadTable(false);
    }

   function getSched1MoreData(){
        var index = d.getElementById('tblSchedule1Page2Part6Continuation').rows.length;
        sched1Items = new Array();
        sched1ItemElement = {};
        for(var i = 1; i <= index;i++){
            sched1ItemElement = {'taxpayer':d.getElementById('frm1700:rdoPg2I4_'+i+'PartVIEmployeeT').checked,
                            'spouse': d.getElementById('frm1700:rdoPg2I4_'+i+'PartVIEmployeeS').checked,
                            'employerName1' : d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerName1').value,
                            'employerName2' : d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerName2').value,
                            'eTIN1' : d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerTIN1').value,
                            'eTIN2' : d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerTIN2').value,
                            'eTIN3' : d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerTIN3').value,
                            'eTINBranchCode' : d.getElementById('frm1700:txtPg2I4_'+i+'PartVIEmployerBranchCode').value,
                            'eCompensationRegularIncome'  : d.getElementById('frm1700:txtPg2ISched1c_4_'+i+'REG').value,
                            'eCompensationIncomeFlatRate' : d.getElementById('frm1700:txtPg2ISched1d_4_'+i+'CIFR').value,
                            'etaxWithheld' : d.getElementById('frm1700:txtPg2ISched1e_4_'+i+'TW').value
            };
            sched1Items.push(sched1ItemElement);
        }
   }

    function getThisId(id){
        return '4_'+id; 
    }

    function openDialog2(element) {
        $('#container').hide();
        $(element).show('fade');
    }

    function closeDialog2(element) {
        $('#container').show();
        $(element).hide('fade');
    }

    function saveSched1MoreData(bool){
        getSched1MoreData();
        if(validateSched1More()){
            if(bool){
                saveSched1Items = new Array();
                for(var i = 0; i < sched1Items.length;i++){
                    saveSched1Items.push(sched1Items[i]);
                }

                alert("Saved!");
            }else{

                sched1Items = new Array();
                for(var i = 0; i < saveSched1Items.length;i++){
                    sched1Items.push(saveSched1Items[i]);
                }
            }
            reloadTable(true);
            computeSubTotal();

        }
    }


