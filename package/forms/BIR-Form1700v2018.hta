                                allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                                p3TotalPenalties = elem[i].value;
                            } else if (elem[i].id == 'frm1700:txtPg1I31ATotalAmtPyble') {   //total amount payable/overpayment
                                allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                                p3TotalAmountPayable = elem[i].value;
                            } else if (elem[i].id == 'frm1700:txtPg1I4TIN1') {
                                allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                                p3TPTIN1 = elem[i].value;
                            } else if (elem[i].id == 'frm1700:txtPg1I4TIN2') {
                                allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                                p3TPTIN2 = elem[i].value;
                            } else if (elem[i].id == 'frm1700:txtPg1I4TIN3') {
                                allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + tab;
                                p3TPTIN3 = elem[i].value;
