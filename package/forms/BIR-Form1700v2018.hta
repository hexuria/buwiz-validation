    function validate(){
        var dt = new Date();
        if (d.getElementById('frm1700:txtPg1I1Year').value == "") {
            alert("Please enter a valid year in Item 1."); return;
            return;
        }

        if(d.getElementById('frm1700:txtPg1I3ATC')==""){
            alert("Please enter a valid ATC on Item no. 3");
            return;
        }

        if ((d.getElementById('frm1700:txtPg1I4TIN1').value == "" || d.getElementById('frm1700:txtPg1I4TIN2').value == "" || d.getElementById('frm1700:txtPg1I4TIN3').value == "" || d.getElementById('frm1700:txtPg1I4BranchCode').value == "")) {
            alert("Please enter a valid TIN number on Item 4.");
            return;
        }

        if ((d.getElementById('frm1700:txtPg1I4TIN1').value.length != 3 || d.getElementById('frm1700:txtPg1I4TIN2').value.length != 3 || d.getElementById('frm1700:txtPg1I4TIN3').value.length != 3 || d.getElementById('frm1700:txtPg1I4BranchCode').value.length < 3)) {
            alert("Please enter a valid TIN number on Item 4.");
            return;
        }

        if ((d.getElementById('frm1700:txtRDOCode').selectedIndex == 0)) {
            alert("Please enter a valid RDO Code on Item 5.");
            return;
        }

        if(!d.getElementById('frm1700:rdoPg1I6TaxpayerTypeE').checked && !d.getElementById('frm1700:rdoPg1I6TaxpayerTypeN').checked){
            alert("Please select Taxpayer Type on Item no. 6");
            return;
        }

        if ((d.getElementById('frm1700:txtPg1I7TaxpayerName').value == "")) {
            alert("Please enter a valid Taxpayer Name on Item 7.");
            return;
        }

        if ((d.getElementById('frm1700:txtPg1I8Address').value == "")) {
            alert("Please enter Taxpayer's Registered Address on Item 8.");
            return;
        }

        if ((d.getElementById('frm1700:txtPg1I8AZipCode').value == "")) {
            alert("Please enter Taxpayer's Registered Address on Item 8A.");
            return;
        }

        if (d.getElementById('frm1700:txtPg1I9BirthDate').value != "") {
            if (validateMonthDayYearDate(d.getElementById('frm1700:txtPg1I9BirthDate').value)) {
                alert("Invalid birth date on item 9 of Taxpayer.  Please check date format.");
                return true;
            }
        } else {
            alert("Please indicate Birth Date of Taxpayer on item 9.");
            return true;
        }

        if(d.getElementById('frm1700:txtPg1I11Citizenship').value == ""){
            alert("Please enter Taxpayer's Citizenship on Item 11");
            return;
        }

        if(!validateCivilStatus()){
            alert("Please indicate Civil Status on Item 15");
            return;
        }

        //Spouse
        if(d.getElementById('frm1700:rdoPg1I15CivilStatusM').checked){
            if(d.getElementById('frm1700:rdoPg1I16SpouseHasIncomeY').checked){
                if(d.getElementById('frm1700:rdoPg1I17FilingStatusJ').checked){
                    if ((d.getElementById('frm1700:txtPg1I18STIN1').value != "" && d.getElementById('frm1700:txtPg1I18STIN2').value != "" && d.getElementById('frm1700:txtPg1I18STIN3').value != "")) {
                        if ((d.getElementById('frm1700:txtPg1I18STIN1').value.length != 3 || d.getElementById('frm1700:txtPg1I18STIN2').value.length != 3 || d.getElementById('frm1700:txtPg1I18STIN3').value.length != 3 || d.getElementById('frm1700:txtPg1I18SBranchCode').value.length > 5 )) {
                            alert("Please enter a valid TIN number on Item 18.");
                            return;
                        }

                        var tinChkCode = getTinChkCode($('#frm1700\\:txtPg1I18STIN1').val(),$('#frm1700\\:txtPg1I18STIN2').val(),$('#frm1700\\:txtPg1I18STIN3').val());
                        if ( tinChkCode !== 0) {
                            alert(getChkTinErrDesc(tinChkCode) + " on Item 18.");
                            return;
                        } 
                    }else {
                        alert("Please enter Spouse TIN");
                        return;
                    }

                    if ((d.getElementById('frm1700:txtSpouseRDOCode').selectedIndex == 0)) {
                        alert("Please enter a valid RDO Code on Item 19.");
                        return;
                    }
                    if ((d.getElementById('frm1700:txtPg1I21SpouseName').value == "")) {
                        alert("Please enter Spouse Name on Item 21.");
                        return;
                    }
                }else if(!d.getElementById('frm1700:rdoPg1I17FilingStatusS').checked){
                  alert("Please choose Yes or No on Item 17");
                  return;  
                }
            } else if(!d.getElementById('frm1700:rdoPg1I16SpouseHasIncomeN').checked){
                alert("Please choose Yes or No on Item 16");
                return;
            }
        }

        //schedule 1
     
        if(!validateSched1(1)){
            return;
        }
        if(!validateSched1(2)){
            return;
        }
        if(!validateSched1(3)){
            return;
        }
        if(saveSched1Items.length <= 0){
            if(!validateSched1(4)){
                return;
            }
        }

        disableAllControl();
        alert("Validation successful. Click on Edit if you wish to modify your entries.");

        d.getElementById('cmdValidate').disabled = true;
        d.getElementById('cmdEdit').disabled = false;
        d.getElementById('frm1700:btnFinalCopy').disabled = false;
        d.getElementById('btnPrint').disabled=false;

        isEditable = false;
    }

    function validateCivilStatus(){
        var bool = false;

        jQuery.each(d.getElementsByName("frm1700:rdoPg1I15CivilStatus"), function(i, val){
            if(val.checked){
                bool = true;
            }
        });
        
        return bool;
    }

    function  validateSched1(itemNumber){
        if(d.getElementById("frm1700:rdoPg2I"+itemNumber+"PartVIEmployeeT").checked || d.getElementById("frm1700:rdoPg2I"+itemNumber+"PartVIEmployeeS").checked){
            if(d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerName1").value == "" && d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerName2").value == ""){
                alert("Please enter Employer's name on Part VI Item "+itemNumber+"A ");
                return false;
            }

            if ((d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerTIN1").value != "" && d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerTIN2").value != "" && d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerTIN3").value != "")) {
                if ((d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerTIN1").value.length != 3 || d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerTIN2").value.length != 3 || d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerTIN3").value.length != 3 || d.getElementById("frm1700:txtPg2I"+itemNumber+"PartVIEmployerBranchCode").value.length < 3 )) {
                    alert("Please enter valid TIN on Part VI Item "+itemNumber+"B");
                    return false;
                }
                var tinChkCode = getTinChkCode($("#frm1700\\:txtPg2I"+itemNumber+"PartVIEmployerTIN1").val(),$("#frm1700\\:txtPg2I"+itemNumber+"PartVIEmployerTIN2").val(),$("#frm1700\\:txtPg2I"+itemNumber+"PartVIEmployerTIN3").val());
               
                if ( tinChkCode !== 0) {
                    alert(getChkTinErrDesc(tinChkCode) + " Part VI Item "+itemNumber+"B.");
                    return false;
                } 
            }else {
                alert("Please enter Employer's TIN on Part VI Item "+itemNumber+"B")
                return false;
            }

            if(d.getElementById("frm1700:rdoPg1I6TaxpayerTypeE").checked == true || d.getElementById("frm1700:rdoPg1I20SpouseTaxpayerTypeE").checked == true){
                if(!checkMandatoryNonZero(d.getElementById("frm1700:txtPg2ISched1c_"+itemNumber+"REG"), "Page 2 Item "+itemNumber+" Compensation Income should not be zero."))
					return false;

				//if(!checkMandatoryNonZero(d.getElementById("frm1700:txtPg2ISched1e_"+itemNumber+"TW"), "Page 2 Item "+itemNumber+" Tax Withheld should not be zero."))
					//return false;
            }
            
            if(d.getElementById("frm1700:rdoPg1I6TaxpayerTypeN").checked == true || d.getElementById("frm1700:rdoPg1I20SpouseTaxpayerTypeN").checked == true){
                if(!checkMandatoryNonZero(d.getElementById("frm1700:txtPg2ISched1d_"+itemNumber+"CIFR"), "Page 2 Item "+itemNumber+" Compensation Income should not be zero."))
					return false;

				//if(!checkMandatoryNonZero(d.getElementById("frm1700:txtPg2ISched1e_"+itemNumber+"TW"), "Page 2 Item "+itemNumber+" Tax Withheld should not be zero."))
					//return false;
            }
        }

        return true;
    }

    function checkMandatoryNonZero(elem, msg) {
        var myMandatory = elem.value;
        if ($.trim(myMandatory) == 0) {
            alert(msg);
            return false;
        }
        else {
            return true;
        }
    }

    function enableAllControl(){
        if(enabledControls.length > 0){
            for(i = 0; i < enabledControls.length; i++){
                enabledControls[i].disabled = false;
            }
        }else{
            enableAllControlAfterLoad();
        }
        
        d.getElementById('cmdValidate').disabled = false;
        d.getElementById('cmdEdit').disabled = true;
        d.getElementById('frm1700:btnFinalCopy').disabled = true;
        d.getElementById('btnPrint').disabled = true;
        disableElem;
        enableElem;
        isEditable = true;
    }

    function enableAllControlAfterLoad(){
        //enabled part V.A/B
        var taxpayerType = getRadioChecked(d.getElementsByName("frm1700:rdoPg1I6TaxpayerType"));
        if(taxpayerType !== undefined) processTaxpayerType("frm1700:rdoPg1I6TaxpayerTypeE" == taxpayerType.id ? false :true);

        //enabled item 13
        processForeignTaxCredits(!(d.getElementById("frm1700:rdoPg1I12ForeignTaxCreditsNo").checked));

        //enabled Iitems for Spouse
        if(d.getElementById("frm1700:rdoPg1I15CivilStatusM").checked){
            d.getElementById("frm1700:rdoPg1I16SpouseHasIncomeY").disabled = false;
            d.getElementById("frm1700:rdoPg1I16SpouseHasIncomeN").disabled = false;
            
            if(d.getElementById("frm1700:rdoPg1I16SpouseHasIncomeY").checked){
                d.getElementById("frm1700:rdoPg1I17FilingStatusJ").disabled = false;
                d.getElementById("frm1700:rdoPg1I17FilingStatusS").disabled = false;

                if(d.getElementById("frm1700:rdoPg1I17FilingStatusJ").checked){
                    d.getElementById("frm1700:rdoPg2I1PartVIEmployeeS").disabled=false;
                    d.getElementById("frm1700:rdoPg2I2PartVIEmployeeS").disabled=false;
                    d.getElementById("frm1700:rdoPg2I3PartVIEmployeeS").disabled=false;
                    d.getElementById("frm1700:rdoPg2I4PartVIEmployeeS").disabled=false;


                    disableElementsArray(d.getElementsByName('frm1700:SpouseTin'), false);
                    disableElementsArray(d.getElementsByName('frm1700:rdoPg1I20SpouseTaxpayerType'),false);
                    disableElementsArray(d.getElementsByName('frm1700:rdoPg1I24SpouseForeignTaxCredits'), false);
                    d.getElementById('frm1700:txtPg1I18SBranchCode').disabled=false;
                    d.getElementById('rdoSpouseSelect').disabled=false;
                    d.getElementById('frm1700:txtPg1I21SpouseName').disabled=false;
                    d.getElementById('frm1700:txtPg1I22TSpouseTelNum').disabled=false;
                    d.getElementById('frm1700:txtPg1I23SpouseCitizenship').disabled=false;

                    if(d.getElementById("frm1700:rdoPg1I24SpouseForeignTaxCreditsYes").checked){
                        d.getElementById("frm1700:txtPg1I25SpouseForeignTaxNumber").disabled = false;
                    }

                    var spouseTaxpayerType = getRadioChecked(d.getElementsByName("frm1700:rdoPg1I20SpouseTaxpayerType"));
                    if(spouseTaxpayerType !== undefined) processSpouseTaxpayerType("frm1700:rdoPg1I20SpouseTaxpayerTypeE" == spouseTaxpayerType.id ? false :true);

                    
                    d.getElementById("frm1700:txtPg1I29B").disabled=false;
                    d.getElementById("frm1700:txtPg1I31B").disabled=false;
                    d.getElementById("frm1700:txtPg1I32B").disabled=false;
                    d.getElementById("frm1700:txtPg1I33B").disabled=false;
                }
            }
        }

        var sched1Item1 = d.getElementsByName("frm1700:rdoPg2I1PartVIEmployee")[0].checked || d.getElementsByName("frm1700:rdoPg2I1PartVIEmployee")[1].checked;
        var sched1Item2 = d.getElementsByName("frm1700:rdoPg2I2PartVIEmployee")[0].checked || d.getElementsByName("frm1700:rdoPg2I2PartVIEmployee")[1].checked;
        var sched1Item3 = d.getElementsByName("frm1700:rdoPg2I3PartVIEmployee")[0].checked || d.getElementsByName("frm1700:rdoPg2I3PartVIEmployee")[1].checked;
        var sched1Item4 = d.getElementsByName("frm1700:rdoPg2I4PartVIEmployee")[0].checked || d.getElementsByName("frm1700:rdoPg2I4PartVIEmployee")[1].checked;


        if(sched1Item1){
            d.getElementById("frm1700:txtPg2I1PartVIEmployerName1").disabled = false;
            d.getElementById("frm1700:txtPg2I1PartVIEmployerName2").disabled = false;          
            disableElementsArray(d.getElementsByName("frm1700:txtEmployer1TIN"), false);
        }

        if(sched1Item2){
            d.getElementById("frm1700:txtPg2I2PartVIEmployerName1").disabled = false;
            d.getElementById("frm1700:txtPg2I2PartVIEmployerName2").disabled = false;          
            disableElementsArray(d.getElementsByName("frm1700:txtEmployer2TIN"), false);
        }

        if(sched1Item3){
            d.getElementById("frm1700:txtPg2I3PartVIEmployerName1").disabled = false;
            d.getElementById("frm1700:txtPg2I3PartVIEmployerName2").disabled = false;          
            disableElementsArray(d.getElementsByName("frm1700:txtEmployer3TIN"), false);
        }

        if(sched1Item4){
            d.getElementById("frm1700:txtPg2I4PartVIEmployerName1").disabled = false;
            d.getElementById("frm1700:txtPg2I4PartVIEmployerName2").disabled = false;          
            disableElementsArray(d.getElementsByName("frm1700:txtEmployer4TIN"), false);
        }
   
        processAmend();
        enabledContinuationOfSchedule1(1);
        enabledContinuationOfSchedule1(2);
        enabledContinuationOfSchedule1(3);
        enabledContinuationOfSchedule1(4);


    }

    function getRadioChecked(elements){
        var elem = undefined;
        for(i=0; i < elements.length; i++){
            if(elements[i].checked){
                elem = elements[i];
            }
        }
        return elem;
    }

    var disableElem = true;
    var enableElem = false;
    function disableAllControl(){
     
        if(enabledControls.length > 0){
            enabledControls = new Array();
        }
        
        var elements = d.forms["frmMain"].getElementsByTagName("input");
        for(i = 0; i < elements.length; i++){
            if('frm1700:txtCurrentPage' != elements[i].id && "button" != elements[i].type){
                if(!gIsReadOnly && !elements[i].disabled){
                    enabledControls.push(elements[i]);
                    elements[i].disabled = true;
                }else{
                    elements[i].disabled = true;
                }
            }
        }
        disableElem;
        enableElem;
    }


    function enabledSched1ColumnField(elem,itemNumber){
        if(elem.checked){
            if(elem.value == "Taxpayer"){
                
                d.getElementById("frm1700:rdoPg2I"+itemNumber+ "PartVIEmployeeS").checked=false;
            }else if(elem.value == "Spouse"){
                
                d.getElementById("frm1700:rdoPg2I"+itemNumber+ "PartVIEmployeeT").checked=false;
            }
        }


        if(!elem.checked){
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerName1").value = "";
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerName2").value = "";
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN1").value = "";
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN2").value = "";
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN3").value = "";
