     function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = "";
            } else {
                var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag            
            }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug
            loadBGData();   /*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = "";
        }
    }

    function rdoPropertyJS(rdoCode, description) {
        this.rdoCode = rdoCode;
        this.description = description;
    }

    function loadRdo() {
        /*This will load data onto an array*/
        var response = d.getElementById("responseRdo");

        var rdoCnt = String(response.innerHTML).split('rdoCount=');
        rdoCount = rdoCnt[1];

        var k = 0;
        //loads rdoList from xml
        for (var i = 1; i <= rdoCount; i++) {

            var rdo = String(response.innerHTML).split('rdo' + i + ':');
            var rdoStr = rdo[1];
            
            
            //Ensure that before writing to rdoPropertyJS the formType 1700 is traceable in rdoStr
            if (rdoStr.indexOf('1700') >= 0) {
                var rdoValues = rdoStr.split('~');
                var rdoCode = rdoValues[0];
                var description = rdoValues[1];
                var objRdo = new rdoPropertyJS(rdoCode, description);
                rdoList[k] = objRdo;
                k++;
            } else {
                
                continue;
            }

            
        }

    }

    function loadData(){
        var response = d.getElementById("response").innerHTML;
        response = response.replaceAll("<DIV>", "").replaceAll("</DIV>","");
        
        var loadElements = response.split("\n");
        var hasOtherItems = false;
        for(i=0;i < loadElements.length;i++){
            var loadElement = loadElements[i].split("=");
            
            if(loadElement.length == 3){
                var element = d.getElementById(loadElement[0]);

                if(element === undefined || element === null){
                    addRow_schedule1();
                    element = d.getElementById(loadElement[0]);
                    hasOtherItems = true;
                }
                
                if(element.type=="radio" || element.type=="checkbox"){
                    element.checked =  loadElement[1].split(loadElement[0])[0] == "true" ? true : false;
                }else{
                    element.value = unescape(loadElement[1].split(loadElement[0])[0]);
                }


            }
        }
       

        if(hasOtherItems){
            getSched1MoreData();
            saveSched1Items = new Array();
            for(var i =0 ; i < sched1Items.length; i++){
                saveSched1Items.push(sched1Items[i]);
            }
        }
    
        enableAllControlAfterLoad();

    }

    function loadBGData() {
        /*This will load data onto Background Information fields*/
        var responseBG = d.getElementById("responseBG");

        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '1700v2018') {
            var fnVal = String(responseBG.innerHTML).split('fn=');
            d.getElementById('frm1700:txtPg1I7TaxpayerName').value = unescape(fnVal[1]).toUpperCase();;
            d.getElementById('frm1700:txtPg2TaxpayerName').value = unescape(fnVal[1]).split(',')[0].toUpperCase();
            
            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            d.getElementById('frm1700:txtPg1I4TIN1').value = tin1Val[1];
            d.getElementById('frm1700:txtPg2TIN1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            d.getElementById('frm1700:txtPg1I4TIN2').value = tin2Val[1];
            d.getElementById('frm1700:txtPg2TIN2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            d.getElementById('frm1700:txtPg1I4TIN3').value = tin3Val[1];
            d.getElementById('frm1700:txtPg2TIN3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            d.getElementById('frm1700:txtPg1I4BranchCode').value = tin4Val[1];
            d.getElementById('frm1700:txtPg2BranchCode').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm1700:txtRDOCode').value = rdoVal[1];

            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm1700:txtLOB').value = unescape(lobVal[1]);

            //address to split
            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');    

            if (regAddrVal[1].length > 127) {
                d.getElementById('frm1700:txtPg1I8Address').value = unescape(regAddrVal[1].substring(0, 127)).toUpperCase();
                d.getElementById('frm1700:txtPg1I8Address2').value = unescape(regAddrVal[1].substring(127, regAddrVal[1].length)).toUpperCase();
            }
            else {
                d.getElementById('frm1700:txtPg1I8Address').value = unescape(regAddrVal[1]).toUpperCase();    
                d.getElementById('frm1700:txtPg1I8Address2').value = "";
            }

            var zipVal = String(responseBG.innerHTML).split('zip=');
            d.getElementById('frm1700:txtPg1I8AZipCode').value = zipVal[1];

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            d.getElementById('frm1700:txtPg1I14TelNum').value = telNoVal[1];
        }
        var emailVal = String(responseBG.innerHTML).split('email=');
        if (emailVal[1] === undefined) {
            document.getElementById('frm1700:txtPg1I10Email').value = "";
        }
        else {
            document.getElementById('frm1700:txtPg1I10Email').value = emailVal[1].toUpperCase();
            globalEmail = emailVal[1];
        }
    }

