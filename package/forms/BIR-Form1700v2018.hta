    function sched1HasOtherItems(){
       var elements =  d.body.getElementsByTagName("input");

        for(var i =0; i < elements.length; i++){
            if(elements[i].id.includes(getThisId(""))){
                return true;
            }
        }

        return false;
    }

    String.prototype.includes = function(search, start) {
        'use strict';

        if (search instanceof RegExp) {
          throw TypeError('first argument must not be a RegExp');
        } 
        if (start === undefined) { start = 0; }
        return this.indexOf(search, start) !== -1;
    };

    function computeSubTotal(){
        getSched1MoreData();
        d.getElementById("frm1700:txtPg2Pt6I4SubtotalC").value = 0.00;
        d.getElementById("frm1700:txtPg2Pt6I4SubtotalD").value = 0.00;
        d.getElementById("frm1700:txtPg2Pt6I4SubtotalE").value = 0.00;
        var subtotalC = 0;
        var subtotalD = 0;
        var subtotalE = 0;
        for(var i = 0; i < sched1Items.length;i++){
            subtotalC += NumWithComma(sched1Items[i].eCompensationRegularIncome);
            subtotalD += NumWithComma(sched1Items[i].eCompensationIncomeFlatRate);
            subtotalE += NumWithComma(sched1Items[i].etaxWithheld);
        }

        d.getElementById("frm1700:txtPg2Pt6I4SubtotalC").value = formatCurrency(subtotalC);
        d.getElementById("frm1700:txtPg2Pt6I4SubtotalD").value = formatCurrency(subtotalD);
        d.getElementById("frm1700:txtPg2Pt6I4SubtotalE").value = formatCurrency(subtotalE);

    }

    function printModal(modalID) {

        globalcancelModalInit = 1;
        globalcurrentDiv = modalID;
        $('#bg').hide();
        $('#' + modalID).removeClass("modalShow");
        //$('#' + modalID).removeClass("modalShow2");
        $('#' + modalID).css({ 'max-width': '8.27in !important', 'border': '#000 2px solid' });
        $('input').each(function () {
            if (this.type == 'button') {
                if (this.id != 'test') {
                    $(this).addClass('previewButtonClass');
                }
            }
        });

        $('a').each(function () {
            if (this.id.length > 1) {
                document.getElementById(this.id).disabled = true;
            }
        });

        $('#printMenu').show('blind');
        if ($('#formMenu').css('display') != 'none') {
            $('#formMenu').hide('blind');
        }
        alert("This form must be printed on an A4 Size Paper. Please update your Printer Settings to ensure the correct printout of the form.\n\n" +
           "If applicable, open Internet Explorer, go to File -> Page Setup and change Page Size to A4,  Left, Right and Bottom Margins must be 0.75 inches, Top Margin must be 0.25 inches and all Headers & Footers must be set to empty.");
  
        window.print();
    }


    function enableAddMore(){
        var reg = NumWithComma(d.getElementById("frm1700:txtPg2ISched1c_4REG").value);
        var cifr = NumWithComma(d.getElementById("frm1700:txtPg2ISched1d_4CIFR").value);
        var tw = NumWithComma(d.getElementById("frm1700:txtPg2ISched1e_4TW").value);

        if((reg > 0 || cifr > 0) && tw > 0){
            $("#addMoreSched1Link").unbind('click');
            
            // $("#addMoreSched1Link").attr('disabled',false);
           
            $("#addMoreSched1Link").click(function(){
                openDialog2($('#modalPage2Part6'));
                setSchedule1More();
            });
            d.getElementById("addMoreSched1Link").disabled = false;
        }else{

            d.getElementById("addMoreSched1Link").disabled = true;
            $("#addMoreSched1Link").unbind('click');
        }

    }

    function enabledAddButton(id){
        var reg = NumWithComma(d.getElementById('frm1700:txtPg2ISched1c_'+id+'REG').value)
        var cifr = NumWithComma(d.getElementById('frm1700:txtPg2ISched1d_'+id+'CIFR').value);
        var tw = NumWithComma(d.getElementById('frm1700:txtPg2ISched1e_'+id+'TW').value)

        if((reg > 0 || cifr > 0) && tw > 0){
            d.getElementById("frm1700:btnPg2Pt6AddRow").disabled = false;
        }else{
            d.getElementById("frm1700:btnPg2Pt6AddRow").disabled = true;
        }
    }

</script>