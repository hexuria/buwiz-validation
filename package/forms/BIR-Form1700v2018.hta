            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN3").disabled = !elem.checked;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerBranchCode").disabled = !elem.checked;
        }
    }  

    function enabledContinuationOfSchedule1(itemNumber){
        var bool = true;

        if(d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN1").value.length == 3
            &&  d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN2").value.length == 3
            &&  d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN3").value.length == 3
            &&  d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerBranchCode").value.length >=3){
            bool = false;
        }


        if(d.getElementById("frm1700:rdoPg1I6TaxpayerTypeE").checked || d.getElementById("frm1700:rdoPg1I20SpouseTaxpayerTypeE").checked){
           d.getElementById("frm1700:txtPg2ISched1c_"+itemNumber+ "REG").disabled = bool; 
           
        }else if(!d.getElementById("frm1700:rdoPg1I6TaxpayerTypeE").checked && !d.getElementById("frm1700:rdoPg1I20SpouseTaxpayerTypeE").checked){
             d.getElementById("frm1700:txtPg2ISched1c_"+itemNumber+ "REG").disabled = true; 
             d.getElementById("frm1700:txtPg2ISched1c_"+itemNumber+ "REG").value = "0.00"; 
        }
        
        if(d.getElementById("frm1700:rdoPg1I6TaxpayerTypeN").checked || d.getElementById("frm1700:rdoPg1I20SpouseTaxpayerTypeN").checked){
            d.getElementById("frm1700:txtPg2ISched1d_"+itemNumber+"CIFR").disabled = bool;
        }else if(!d.getElementById("frm1700:rdoPg1I6TaxpayerTypeN").checked && !d.getElementById("frm1700:rdoPg1I20SpouseTaxpayerTypeN").checked){
            d.getElementById("frm1700:txtPg2ISched1d_"+itemNumber+"CIFR").disabled = true;
            d.getElementById("frm1700:txtPg2ISched1d_"+itemNumber+"CIFR").value = "0.00";

        }
        
        d.getElementById("frm1700:txtPg2ISched1e_"+itemNumber+"TW").disabled = bool;

        if(itemNumber == 4 && saveSched1Items.length > 0){
             enableAddMore();
            if(d.getElementById("frm1700:rdoPg2I4PartVIEmployeeT").checked == true){
                enabledSched1ColumnField(d.getElementById("frm1700:rdoPg2I4PartVIEmployeeT"), 4);
            }else if(d.getElementById("frm1700:rdoPg2I4PartVIEmployeeS").checked == true){
                enabledSched1ColumnField(d.getElementById("frm1700:rdoPg2I4PartVIEmployeeS"), 4);
            }
            setUpSchedule1TableModal();
         }
    }

    
    //prototypes
    Array.prototype.contains = Array.prototype.indexOf ?
        function (val) {
            return this.indexOf(val) > -1;
        } :
        function (val) {
            var i = this.length;
            while (i--) {
                if (this[i] === val) {
                    return true;
                }
            }
            return false;
        };
    String.prototype.trim = function () {
        return this.replace(/^\s+|\s+$/g, '');
    }

    String.prototype.replaceAll = function(search, replacement) {
        var target = this;
        return target.replace(new RegExp(search, 'g'), replacement);
    };

    function validateTIN(elem, checkFull) {
        var isValid = true;

        if (!checkFull && elem.value.length < 3 && elem.value !== "" ) {
            alert("Please provide a valid TIN (must have 3 numbers per box).");
            elem.select();

            //isValid = false;
        }
        else if (!!checkFull) {
            var tinArray = $_Name(elem.name);
            var totalTIN = 0;
            var tinToFocus = {};

            for (var i = (tinArray.length - 1) ; i >= 0; i--) {
                totalTIN += tinArray[i].value.length;
                if (tinArray[i].value.length < 3) {
                    tinToFocus = tinArray[i];
                }
            }
            if (totalTIN < 15) {
                //alert("Please provide a valid TIN (must have 3 numbers per box).");
                //tinToFocus.select();

                isValid = false;
            }
        }

        return isValid;
    }
    function validateMonthDayYearDate(dateID) {
        strmmddyyyy = dateID;
        
        if (strmmddyyyy != "") {
            var result = strmmddyyyy.split("/");
            var isLeap = new Date(result[2], 1, 29).getMonth() == 1;
            var month31 = new Array('01', '03', '05', '07', '08', '10', '12');
            var month30 = new Array('04', '06', '09', '11');
            var month = result[0];
            var day = result[1];
            if (result.length == 3) {
                if (isNaN(result[0] || result[1] || result[2])) {
                    return true;
                }
                else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 0))) {
                    // numeric check if greater not than 31 - Month.
                    return true;
                }
                else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
                    // numeric check if Date.
                    return true;
                }
                else if (result[2].length != 4) {
                    return true;
                }
                else if (month == 2) {
                    if (!isLeap && day == 29) {
                        return true;
                    }
                    else if (!isLeap && day > 29) {
                        return true;
                    }
                    else if (isLeap && day > 29) {
                        return true;
                    }
                }
                else if (month31.contains(month) && day > 31) {
                    return true;
                }
                else if (month30.contains(month) && day > 30) {
                    return true;
                }
            } else {
                return true;
            }
        }
    }

    function validatePg1I26(person){
        /*if(person===TAXPAYER){
            var result = d.getElementById('frm1700:txtPg1I26A').value * (50/100);
            return result > d.getElementById('frm1700:txtPg1I29A').value ? true : false;
        }else{
            var result = d.getElementById('frm1700:txtPg1I26B').value * (50/100);
            return result > d.getElementById('frm1700:txtPg1I29B').value ? true : false;
        }*/
		if(person===TAXPAYER){
            var result = NumWithComma(d.getElementById('frm1700:txtPg1I26A').value) * 0.5;
			//alert(result + " - " + formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg1I29A').value)));
            return result < NumWithComma(d.getElementById('frm1700:txtPg1I29A').value) ? true : false;
        }
		else if (person===SPOUSE){
            var result = NumWithComma(d.getElementById('frm1700:txtPg1I26B').value) * 0.5;
            return result < NumWithComma(d.getElementById('frm1700:txtPg1I29B').value) ? true : false;
        }
    }

    function validatePg1I27(person){
		if(person===TAXPAYER){
            var result = NumWithComma(d.getElementById('frm1700:txtPg1I26A').value) * 0.5;
			
			return result > NumWithComma(d.getElementById('frm1700:txtPg1I29A').value) &&
				NumWithComma(d.getElementById('frm1700:txtPg1I29A').value) > NumWithComma(d.getElementById('frm1700:txtPg1I28A').value) ? true : false;
        }
		else if (person===SPOUSE){
            var result = NumWithComma(d.getElementById('frm1700:txtPg1I26B').value) * 0.5;

			return result > NumWithComma(d.getElementById('frm1700:txtPg1I29B').value) &&
				NumWithComma(d.getElementById('frm1700:txtPg1I29B').value) > NumWithComma(d.getElementById('frm1700:txtPg1I28B').value) ? true : false;
        }
    }

    function validatePg1I28(person){
		if(person===TAXPAYER && NumWithComma(d.getElementById("frm1700:txtPg1I26A").value) > 0.00){
            var zero = 0.00;
			
			if (NumWithComma(d.getElementById('frm1700:txtPg1I28A').value) <= 0.00){
				d.getElementById('frm1700:txtPg1I29A').value = formatCurrency(NumWithComma(zero));
				d.getElementById('frm1700:txtPg1I29A').disabled = true;
			} else {
				d.getElementById('frm1700:txtPg1I29A').disabled = false;
			}
        }
		else if (person===SPOUSE && NumWithComma(d.getElementById("frm1700:txtPg1I26B").value) > 0.00){
            var zero = 0.00;
			
			if (NumWithComma(d.getElementById('frm1700:txtPg1I28B').value) <= 0.00){
				d.getElementById('frm1700:txtPg1I29B').value = formatCurrency(NumWithComma(zero));
				d.getElementById('frm1700:txtPg1I29B').disabled = true;
			} else {
				d.getElementById('frm1700:txtPg1I29B').disabled = false;
			}
        }
    }
    //Computations

    function computePg1I30(person){
        if(person===TAXPAYER){
			if(validatePg1I26(person)){
				alert("Amount in Item 29A cannot be more than 50% of Item 26A."); 
                d.getElementById("frm1700:txtPg1I29A").value = (0).toFixed(2);
            }
			
			if (NumWithComma(d.getElementById("frm1700:txtPg1I27A").value) != 0.00 && validatePg1I27(person) && NumWithComma(d.getElementById("frm1700:txtPg1I29A").value) != 0.00){
				alert("Amount in Item 29A cannot be greater than Item 28A."); 
                d.getElementById("frm1700:txtPg1I29A").value = (0).toFixed(2);
			}
            d.getElementById('frm1700:txtPg1I30A').value = formatCurrency(NumWithComma(d.getElementById("frm1700:txtPg1I28A").value) - NumWithComma(d.getElementById("frm1700:txtPg1I29A").value).toFixed(0));
        }
		
		else if(person===SPOUSE){
            if(validatePg1I26(person)){
                alert("Amount in Item 29B cannot be more than 50% of Item 26B."); 
                d.getElementById("frm1700:txtPg1I29B").value = (0).toFixed(2);
            }

			if (NumWithComma(d.getElementById("frm1700:txtPg1I27B").value) != 0.00 && validatePg1I27(person) && NumWithComma(d.getElementById("frm1700:txtPg1I29B").value) != 0.00){
				alert("Amount in Item 29B cannot be greater than Item 28B."); 
                d.getElementById("frm1700:txtPg1I29B").value = (0).toFixed(2);
			}
            d.getElementById('frm1700:txtPg1I30B').value = formatCurrency(NumWithComma(d.getElementById("frm1700:txtPg1I28B").value) - NumWithComma(d.getElementById("frm1700:txtPg1I29B").value).toFixed(0));
        }

        computePg1I34(person);
    }

    function computePg1I34(person){
        if(person===TAXPAYER){
            d.getElementById('frm1700:txtPg1I34A').value = formatCurrency((NumWithComma(d.getElementById('frm1700:txtPg1I31A').value) + NumWithComma(d.getElementById("frm1700:txtPg1I32A").value) + NumWithComma(d.getElementById('frm1700:txtPg1I33A').value)).toFixed(0));
        }else if(person===SPOUSE){
            d.getElementById('frm1700:txtPg1I34B').value = formatCurrency((NumWithComma(d.getElementById('frm1700:txtPg1I31B').value) + NumWithComma(d.getElementById("frm1700:txtPg1I32B").value) + NumWithComma(d.getElementById('frm1700:txtPg1I33B').value)).toFixed(0));
        }
        computePg1I35(person);
    }

    function computePg1I35(person){
        var totalAmountPayable = 0;
        if(person===TAXPAYER){
            totalAmountPayable = NumWithComma(d.getElementById('frm1700:txtPg1I30A').value);

			if (totalAmountPayable >= 0.00){
				d.getElementById('frm1700:txtPg1I35A').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg1I30A').value) + NumWithComma(d.getElementById('frm1700:txtPg1I34A').value));}
				
			else if (totalAmountPayable < 0.00 && NumWithComma(d.getElementById('frm1700:txtPg1I34A').value) == 0.00){
				d.getElementById('frm1700:txtPg1I35A').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg1I30A').value));}
				
			else if (totalAmountPayable < 0.00 && NumWithComma(d.getElementById('frm1700:txtPg1I34A').value) != 0.00){
				d.getElementById('frm1700:txtPg1I35A').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg1I34A').value));}
        }
		else if(person===SPOUSE){
            totalAmountPayable = NumWithComma(d.getElementById('frm1700:txtPg1I30B').value);

			if (totalAmountPayable >= 0.00){
				d.getElementById('frm1700:txtPg1I35B').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg1I30B').value) + NumWithComma(d.getElementById('frm1700:txtPg1I34B').value));}
				
			else if (totalAmountPayable < 0.00 && NumWithComma(d.getElementById('frm1700:txtPg1I34B').value) == 0.00){
				d.getElementById('frm1700:txtPg1I35B').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg1I30B').value));}
				
			else if (totalAmountPayable < 0.00 && NumWithComma(d.getElementById('frm1700:txtPg1I34B').value) != 0.00){
				d.getElementById('frm1700:txtPg1I35B').value = formatCurrency(NumWithComma(d.getElementById('frm1700:txtPg1I34B').value));}
        }
        computePg1I36();
    }

