                            '<input type="text" size="2" name="frm1700:txtEmployer4_'+i+'TIN" maxlength="3" id="frm1700:txtPg2I4_'+i+'PartVIEmployerTIN3" onkeypress="return wholenumber(this, event)"  onkeyup="moveToNext(this,3);enabledContinuationOfSchedule1(getThisId('+i+'));" onblur="validateTIN(this,false);" disabled/>&nbsp;-&nbsp;'+
                            '<input type="text" size="3" name="frm1700:txtEmployer4_'+i+'TIN" maxlength="5" id="frm1700:txtPg2I4_'+i+'PartVIEmployerBranchCode" onkeypress="return letternumber(event)" onkeyup="enabledContinuationOfSchedule1(getThisId('+i+'));" onblur="validateTIN(this,false);"  disabled />'+
                    
                            '&nbsp;&nbsp;&nbsp;'+
