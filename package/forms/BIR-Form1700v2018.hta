    }

    function goToItem(id, page){
        if(page!=d.getElementById("frm1700:txtCurrentPage").value){
           if(page == 1){
                processPrev();
            }else{
                processNext();
            } 
        }
        

        location.href('#'+id);
    }


    //iteration
    function setUpSchedule1TableModal(){
        $.each($('input[name="frm1700:rdoPg2I4PartVIEmployee"]'), function(){
            $(this).hide();
        });

        $.each($('label[for^="frm1700:rdoPg2I4PartVIEmployee"]'), function(){
            $(this).hide();
        });

        $('label[for^="frm1700:schedule1OtherItem"]').show();

        $("#frm1700\\:txtPg2I4PartVIEmployerName1").val("OTHERS");
        $("#frm1700\\:txtPg2I4PartVIEmployerName2").val("");
        $("#frm1700\\:txtPg2I4PartVIEmployerTIN1").val("");
        $("#frm1700\\:txtPg2I4PartVIEmployerTIN2").val("");
        $("#frm1700\\:txtPg2I4PartVIEmployerTIN3").val("");
        $("#frm1700\\:txtPg2I4PartVIEmployerBranchCode").val("");
    }



