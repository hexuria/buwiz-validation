<script type="text/javascript">
    var TAXPAYER="taxpayer";
    var SPOUSE="spouse";
    var isSubmitFinal = false;
    var isSubmit = false;

    var gIsReadOnly = false;
    var fileName = "";
    var existingXMLFileName = "";
    var fileNameToExport = "";

    var savedReturn = "";
    var p3Compromise = "";
    var p3Surcharge = "";
    var p3Interest = "";
    var p3IsAmended = "";
    var p3FilingDate = "";
    var p3ReturnPeriod = "";
    var p3ReturnPeriodEnd = "";

    var p3BasicTax = "";
    var p3TotalPenalties = "";
    var p3TotalAmountPayable = "";

    var p3TPTIN1 = "";
    var p3TPTIN2 = "";
    var p3TPTIN3 = "";
    var p3TPTIN = "";
    var p3TPBranchCode = "";
    var p3TPRDOCode = "";
    var p3TPLineBus = "";
    var p3TPName = "";
    var p3TPTelNum = "";
    var p3TPAddress = "";
    var p3TPZip = "";

    var currentPage;
    var MaxPage = 2;

    var rdoList = new Array();
    var enabledControls = new Array();

    var hasOtherItems = false;

    //For schedule1 Iteration

    var sched1Items = new Array();
    var saveSched1Items = new Array();
    var sched1ItemElement= {};
    var sched1Item4Original = {};
    var index = 0;
    var isEditable = true;


     /*----------------------------------*/
    var d = document, XMLBGFile = '', data = '', XMLFile = '', XMLATCFile = '', msg = d.getElementById('msg');
    var loader = d.getElementById('loader');
    /*----------------------------------*/
    var globalEmail = "";
    setTimeout("sleeptime()", 200);

    function sleeptime() {
        init();

        var bgFileName = qs('xmlBGInfoFileName');
        if (bgFileName != null && bgFileName.indexOf('.xml') > -1) {
            loadBGXML(bgFileName);
        }

        fileName = qs('xmlFileName');
        if (fileName != null && fileName.indexOf('.xml') > -1) {
            var tin = fileName.split("/")[1].split("-");
            loadBGXML("profile/" + tin[0] + ".xml");
            loadXML(fileName);
            existingXMLFileName = fileName;
            
            d.getElementById('frm1700:txtPg1I1Year').disabled = true;
           

            //Dev Note: This new function will be used for processing well-formed XML for Tax Software Provider (TSP)
            //XML file processing.  The parameter 'savefile/1602_wellformed.xml' should be replaced by RB with 
            //the xml file that came from the upload xml portal page.
            //loadXMLWellFormed("savefile/1701Q_wellformed.xml");   
            if (gIsReadOnly) {
                window.setTimeout("disableAllElementIDs(); d.getElementById('btnUpload').disabled = false; d.getElementById('frm1700:txtCurrentPage').disabled = false; d.getElementById('frm1700:btnPrevPage').disabled = false; d.getElementById('frm1700:btnNextPage').disabled = false;", 1000);
            }
        } else {
            window.setTimeout("$('#loader').hide('blind');", 100);
        }
        if ($('#printMenu').css('display') != 'none') {
            $('#printMenu').hide('blind');
        }
        document.getElementById('frm1700:txtPg1I4TIN1').disabled = true; document.getElementById('frm1700:txtPg1I4TIN2').disabled = true; document.getElementById('frm1700:txtPg1I4TIN3').disabled = true; document.getElementById('frm1700:txtPg1I4BranchCode').disabled = true;
        window.setTimeout("checkFinalCopyBtn('1700v2018')", 2000);
         
         // Disable pasting
        $(document).ready(function () {
            $('input').bind('paste', function (e) {
                e.preventDefault();
            });
        });
    }

    function init() {
        getDrives();
        loadXMLrdo('xml/rdo.xml');
        getRdo();
        var year = new Date();
        
        
        //d.getElementById('frm1700:txtPg1I1Year').value = year.getFullYear();
        
        currentPage = 1;
        d.getElementById('frm1700:txtCurrentPage').value = currentPage;

        d.getElementById('frm1700:rdoPg1I2AmendedYes').disabled = false;
        d.getElementById('frm1700:rdoPg1I2AmendedNo').disabled = false;
        d.getElementById('frm1700:txtPg1I3ATC').disabled=true;
        d.getElementById('frm1700:txtPg1I3ATC').value="II011"
       
        //Command Buttons 
        d.getElementById('cmdEdit').disabled = true;
        d.getElementById('btnPrint').disabled = true;
        d.getElementById('frm1700:btnFinalCopy').disabled = true;
        d.getElementById('btnUpload').disabled = true;
        

        d.getElementById('frm1700:txtPg1I13ForeignTaxNumber').disabled = true;
        
        d.getElementById('frm1700:txtPg2I46A').disabled=true;
        d.getElementById('frm1700:txtPg2I47A').disabled=true;
        d.getElementById('frm1700:txtPg2I52A').disabled=true;
        d.getElementById('frm1700:txtPg2I53A').disabled=true;
        d.getElementById('frm1700:txtPg2I58A').disabled=true;
        d.getElementById('frm1700:txtPg2I59A').disabled=true;

        disableAllSpouseItem();
        var itemNumber = 1;
        while(itemNumber<=4){
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerName1").disabled = true;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerName2").disabled = true;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN1").disabled = true;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN2").disabled = true;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN3").disabled = true;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerBranchCode").disabled = true;

            d.getElementById("frm1700:txtPg2ISched1c_"+itemNumber+ "REG").disabled = true;
            d.getElementById("frm1700:txtPg2ISched1d_"+itemNumber+ "CIFR").disabled = true;
            d.getElementById("frm1700:txtPg2ISched1e_"+itemNumber+ "TW").disabled = true;
            itemNumber++;
        }
        processAmend();
        disablePartVAB();
        processForeignTaxCredits(true);
        enabledContinuationOfSchedule1(1);
        enabledContinuationOfSchedule1(2);
        enabledContinuationOfSchedule1(3);
        enabledContinuationOfSchedule1(4);
    }

    function processAmend() {
         if (d.getElementById('frm1700:rdoPg1I2AmendedYes').checked) {
            if (d.getElementById("frm1700:txtPg1I21SpouseName").value != "") {
                d.getElementById("frm1700:txtPg2I55A").disabled = false;
                d.getElementById("frm1700:txtPg2I55B").disabled = false;
            } else {
                d.getElementById("frm1700:txtPg2I55A").disabled = false;
                d.getElementById("frm1700:txtPg2I55B").disabled = true;
            }
        } else {
            d.getElementById("frm1700:txtPg2I55A").disabled = true;
            d.getElementById("frm1700:txtPg2I55B").disabled = true;
        } 
    }

    function processTaxpayerType(bool){
        disablePartVATaxpayer(bool);
        disablePartVBTaxpayer(!bool)
        enabledContinuationOfSchedule1(1);
        enabledContinuationOfSchedule1(2);
        enabledContinuationOfSchedule1(3);
        enabledContinuationOfSchedule1(4);
        computeSched1I5();
        d.getElementById('frm1700:txtPg1I29A').disabled=bool;
        if(bool){
            d.getElementById('frm1700:txtPg1I29A').value="0.00";
        }
    }

    function processSpouseTaxpayerType(bool){
        disablePartVASpouse(bool);
        disablePartVBSpouse(!bool);
        enabledContinuationOfSchedule1(1);
        enabledContinuationOfSchedule1(2);
        enabledContinuationOfSchedule1(3);
        enabledContinuationOfSchedule1(4);
        computeSched1I5();
        d.getElementById('frm1700:txtPg1I29B').disabled=bool;
        if(bool){
            d.getElementById('frm1700:txtPg1I29B').value="0.00";
        }
    }

    
    function processCivilStatus(bool){
        resetElementsArray(d.getElementsByName('frm1700:rdoPg1I16SpouseHasIncome'), bool);
        if(bool){
            processSpouseHasIncome(bool);
        }
    }

    function processSpouseHasIncome(bool){
        resetElementsArray(d.getElementsByName('frm1700:rdoPg1I17FilingStatus'), bool);

        if(bool){
            processFilingStatus(bool);
        }
       
    }

    function processFilingStatus(bool){

        disableSpouseBGInformation(bool);
        disableSpouseTotalTaxPayable(bool);
        d.getElementById("frm1700:rdoPg2I1PartVIEmployeeS").disabled=bool;
        d.getElementById("frm1700:rdoPg2I2PartVIEmployeeS").disabled=bool;
        d.getElementById("frm1700:rdoPg2I3PartVIEmployeeS").disabled=bool;
        d.getElementById("frm1700:rdoPg2I4PartVIEmployeeS").disabled=bool;

        if(bool){
           disablePartVASpouse(bool);
           disablePartVBSpouse(bool);
           disablePartVCSpouse(bool);


           //disable sched 1 for spouse

           if(d.getElementById('frm1700:rdoPg2I1PartVIEmployeeS').checked){
                d.getElementById('frm1700:rdoPg2I1PartVIEmployeeS').checked = false;
                enabledSched1ColumnField(d.getElementById('frm1700:rdoPg2I1PartVIEmployeeS'),1);
           }
           if(d.getElementById('frm1700:rdoPg2I2PartVIEmployeeS').checked){
                d.getElementById('frm1700:rdoPg2I2PartVIEmployeeS').checked = false;
                enabledSched1ColumnField(d.getElementById('frm1700:rdoPg2I2PartVIEmployeeS'),2);
           }
           if(d.getElementById('frm1700:rdoPg2I3PartVIEmployeeS').checked){
                d.getElementById('frm1700:rdoPg3I1PartVIEmployeeS').checked = false;
                enabledSched1ColumnField(d.getElementById('frm1700:rdoPg2I3PartVIEmployeeS'),3);
           }
           if(d.getElementById('frm1700:rdoPg2I4PartVIEmployeeS').checked){
                d.getElementById('frm1700:rdoPg2I4PartVIEmployeeS').checked = false;
                enabledSched1ColumnField(d.getElementById('frm1700:rdoPg2I4PartVIEmployeeS'),4);
           }
        }else{
            d.getElementById('frm1700:txtPg2I57B').disabled=false;
        }

        computeSched1I5();
    }


    function disableSpouseTotalTaxPayable(bool){
        d.getElementById("frm1700:txtPg1I29B").disabled=bool;
        d.getElementById("frm1700:txtPg1I31B").disabled=bool;
        d.getElementById("frm1700:txtPg1I32B").disabled=bool;
        d.getElementById("frm1700:txtPg1I33B").disabled=bool;

        if(bool){
            d.getElementById("frm1700:txtPg1I26B").value="0.00";
            d.getElementById("frm1700:txtPg1I27B").value="0.00";
            d.getElementById("frm1700:txtPg1I28B").value="0.00";
            d.getElementById("frm1700:txtPg1I29B").value="0.00";
            d.getElementById("frm1700:txtPg1I31B").value="0.00";
            d.getElementById("frm1700:txtPg1I32B").value="0.00";
            d.getElementById("frm1700:txtPg1I33B").value="0.00";
            computePg1I30(SPOUSE);
        }
    }

    function resetElementsArray(elements,bool){
        for(i=0;i<elements.length;i++){
            elements[i].disabled=bool;
            if(elements[i].type == "radio"){
                elements[i].checked=false;
            }else if(elements[i].type="text"){
                elements[i].value="";
            }
        }
    }

    function disableElementsArray(elements,bool){
        for(i=0;i<elements.length;i++){
            elements[i].disabled=bool;
        }
    }


    function disableAllSpouseItem(){
        // page 1
        processCivilStatus(true);
        disableSpouseBGInformation(true);
        
        d.getElementById('frm1700:txtPg1I26B').disabled = true;
        d.getElementById('frm1700:txtPg1I27B').disabled = true;
        d.getElementById('frm1700:txtPg1I28B').disabled = true;
        d.getElementById('frm1700:txtPg1I29B').disabled = true;
        d.getElementById('frm1700:txtPg1I30B').disabled = true;
        d.getElementById('frm1700:txtPg1I31B').disabled = true;
        d.getElementById('frm1700:txtPg1I32B').disabled = true;
        d.getElementById('frm1700:txtPg1I33B').disabled = true;
        d.getElementById('frm1700:txtPg1I34B').disabled = true;
        d.getElementById('frm1700:txtPg1I35B').disabled = true;

        //page 2
        d.getElementById('frm1700:txtPg2I42A').disabled=true;
        d.getElementById('frm1700:txtPg2I42B').disabled=true;
        d.getElementById('frm1700:txtPg2I44A').disabled=true;
        d.getElementById('frm1700:txtPg2I44B').disabled=true;
        d.getElementById('frm1700:txtPg2I46A').disabled=true;
        d.getElementById('frm1700:txtPg2I46B').disabled=true;
        d.getElementById('frm1700:txtPg2I47A').disabled=true;
        d.getElementById('frm1700:txtPg2I47B').disabled=true;

        d.getElementById('frm1700:txtPg2I48A').disabled=true;
        d.getElementById('frm1700:txtPg2I48B').disabled=true;
        d.getElementById('frm1700:txtPg2I50A').disabled=true;
        d.getElementById('frm1700:txtPg2I50B').disabled=true;
        d.getElementById('frm1700:txtPg2I52A').disabled=true;
        d.getElementById('frm1700:txtPg2I52B').disabled=true;
        d.getElementById('frm1700:txtPg2I53A').disabled=true;
        d.getElementById('frm1700:txtPg2I53B').disabled=true;


        d.getElementById('frm1700:txtpg2I54A').disabled=true;
        d.getElementById('frm1700:txtpg2I54B').disabled=true;

        d.getElementById('frm1700:txtPg2I58B').disabled=true;
        d.getElementById('frm1700:txtPg2I59B').disabled=true;
        processSpouseForeignTaxCredits(true);

    }



    function disableSpouseBGInformation(bool){
        if(bool){
            d.getElementById("frm1700:txtPg1I25SpouseForeignTaxNumber").disabled=true;
             d.getElementById("frm1700:txtPg1I25SpouseForeignTaxNumber").value="";
            d.getElementById("frm1700:txtSpouseRDOCode").selectedIndex=0;
            d.getElementById("frm1700:txtPg1I21SpouseName").value="";
            d.getElementById("frm1700:txtPg1I22TSpouseTelNum").value="";
            d.getElementById("frm1700:txtPg1I23SpouseCitizenship").value="";
            d.getElementById('frm1700:txtPg1I18SBranchCode').value="00000";
        }

        resetElementsArray(d.getElementsByName('frm1700:SpouseTin'), bool);
        resetElementsArray(d.getElementsByName('frm1700:rdoPg1I20SpouseTaxpayerType'),bool);
        resetElementsArray(d.getElementsByName('frm1700:rdoPg1I24SpouseForeignTaxCredits'), bool);
        d.getElementById('frm1700:txtPg1I18SBranchCode').disabled=bool;
        d.getElementById('rdoSpouseSelect').disabled=bool;
        d.getElementById('frm1700:txtPg1I21SpouseName').disabled=bool;
        d.getElementById('frm1700:txtPg1I22TSpouseTelNum').disabled=bool;
        d.getElementById('frm1700:txtPg1I23SpouseCitizenship').disabled=bool;

        
        
   }

