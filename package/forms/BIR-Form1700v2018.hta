    function displayAllPages(bool){
        if(bool){
            $(".pagesContent").show();  
           
        }else{
            $(".pagesContent").hide();

            var id = "#Page"+ document.getElementById("frm1700:txtCurrentPage").value+"Content";
            $(id).show();
          
