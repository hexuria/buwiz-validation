                                                                                    </tr>
                                                                                    <tr>
                                                                                        <td align="center"><font style="font-size:8px;">Over P250,000 but not over P400,000 </font></td>
                                                                                        <td align="center"><font style="font-size:8px;">15% of the excess over P250,000 </font></td>
