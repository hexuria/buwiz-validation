        <!-- Form Start -->
        <form id="frmMain" name="frmMain">
              <div id="container">
                <div id="wrapper" style="margin: 0 auto; position: relative; width: 800px; ">
                    <table border="0" width="800" cellspacing="0" cellpadding="0" align="center" style="background-image: url(../img/frmbg.png); background-repeat: repeat-x;">
                        <tr>
                            <td>
                                <div id="formPaper">
                                    <div id="mainPages">
                                        <!-- Page 1 Start -->
                                        <div id="Page1Content" class="pagesContent">
                                            <!-- Above Header -->
                                            <table width="800" border="0" cellspacing="0" cellpadding="0">
                                                <tr>
                                                    <td width="300" valign="bottom">
                                                        <p><img src="../img/bcs_new.png" width="80" /> </p>
                                                    </td>
                                                    <td>
                                                        <p><img src="../img/header_logo.png" width="210" height="50px" /> </p>
                                                    </td>
                                                </tr>
                                            </table>
                                            <!-- Header Start -->
                                            <table width="751" border="1" cellspacing="0" cellpadding="0">
                                                <tr>
                                                    <td width="102" valign="middle" style="text-align: center;">
                                                        <font face="Arial" size="1px">BIR Form No.</font>
                                                        <br/><font size="5px" style="font-weight:bold;">1700</font>
                                                        <br/><font face="Arial" size="1px">January 2018 (ENCS)</font>
                                                        <br/><font face="Arial" size="1px" style="font-weight:bold;">Page 1</font>
                                                    </td>
                                                    <td width="0" align="center">
                                                        <font size="4px" style="font-weight: bold;">Annual IncomeTax Return </font> <br />
                                                        <font size="2px" style="font-weight: bold;">Individuals Earning Purely Compensation Income</font><br />
                                                        <font size="2px" style="font-weight: bold;">(Including Non-Business/Non-Profession Income)</font><br />
                                                        <span><font face="Arial" size="1px"><em>Enter all required information in CAPITAL LETTERS using BLACK
                                                            ink. Mark applicable boxes with an "X". Three(3) copies must be filed: two(2) copies for BIR
                                                            and one copy for taxpayer.</em></font></span>
                                                    </td>
                                                    <td valign="center" align="right">
                                                        <div style="float: right" >
                                                            <img id="imgPage1" alt="" src="../img/1700v2018_BarCode/1700_01_18_ENCS_P1.png" style="height:35px; width:250px" />
                                                            <br />                                                 
                                                            <span class="xsmallBold">1700 01/18ENCS P1</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </table>
                                            <!-- Header End -->
                                            <!-- Before Part I Start Item 1, Item 2, Item 3-->
                                            <table border="0" cellspacing="0" cellpadding="0" class="tblForm">
                                                <tr>
                                                    <td class="tblFormTd" >
                                                        <table>
                                                            <tr>
                                                                <td><font size="2" style="font-weight:bold;">1</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">For the Year (YYYY) </font></td>
                                                                <td>
                                                                    <input type="text" value="" size="4" name="frm1700:txtPg1I1Year" maxlength="4" id="frm1700:txtPg1I1Year" onblur="blockletterWithout2Decimal(this); checkYear('taxYear');" onkeypress="return wholenumber(this, event)" />
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td class="tblFormTd" >
                                                        <table>
                                                            <tr>
                                                                <td><font size="2" style="font-weight:bold;">2</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">Amended Return? </font></td>
                                                                <td>
                                                                    <input type="radio" value="Yes" name="frm1700:rdoPg1I2Amended" id="frm1700:rdoPg1I2AmendedYes" onclick="processAmend()" /><label for="frm1700:rdoPg1I2AmendedYes" style="font-size:10px;" >Yes</label>
                                                                </td>
                                                                <td>
                                                                    <input type="radio" value="No" name="frm1700:rdoPg1I2Amended" id="frm1700:rdoPg1I2AmendedNo" onclick="processAmend()" checked /><label for="frm1700:rdoPg1I2AmendedNo" style="font-size:10px;" >No</label>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td class="tblFormTd" >
                                                        <table>
                                                            <tr>
                                                                <td><font size="2" style="font-weight:bold;">3</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">Alphanumeric Tax Code <em>(ATC)</em></font></td>
                                                                <td>
                                                                    <input type="text" value="" size="4" name="frm1700:txtPg1I3ATC" maxlength="5" id="frm1700:txtPg1I3ATC" onkeypress="return letternumber(event)" />
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                            <!-- Before Part I End -->
                                            <!-- Part I Start -->
                                            <table border="0" cellspacing="0" cellpadding="0" class="tblForm">
                                                <tr>
                                                    <td colspan="3" class="tblFormTdPart" style="border-bottom: #000000 2px solid; border-top: #000000 2px solid;">
                                                        <div align="center"><font size="2" style="font-weight:bold;">PART I - BACKGROUND INFORMATION OF TAXPAYER/FILER </font></div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="tblFormTd" >
                                                        <table>
                                                            <tr><!-- Item 4 Start -->
                                                                <td><font size="2" style="font-weight:bold;">4</font></td>
                                                                <td>
                                                                    <font size="1" face="Arial, Helvetica, sans-serif">Taxpayer Identification Number (TIN) </font>
                                                                    <input type="text" value="" size="2" name="frm1700:txtProfile" maxlength="3" id="frm1700:txtPg1I4TIN1" onkeypress="return wholenumber(this, event)" disabled />&nbsp;-&nbsp;
                                                                    <input type="text" value="" size="2" name="frm1700:txtProfile" maxlength="3" id="frm1700:txtPg1I4TIN2" onkeypress="return wholenumber(this, event)" disabled />&nbsp;-&nbsp;
                                                                    <input type="text" value="" size="2" name="frm1700:txtProfile" maxlength="3" id="frm1700:txtPg1I4TIN3" onkeypress="return wholenumber(this, event)" disabled />&nbsp;-&nbsp;
                                                                    <input type="text" value="" size="3" name="frm1700:txtProfile" maxlength="5" id="frm1700:txtPg1I4BranchCode" onkeypress="return letternumber(event)" disabled />
                                                                </td>
                                                            </tr><!-- Item 4 End -->
                                                        </table>
                                                    </td>
                                                    <td width="125"class="tblFormTd">
                                                        <table >
                                                            <tr><!-- Item 5 Start -->
                                                                <td><font size="2" style="font-weight:bold;">5</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">RDO Code </font></td>
                                                                <td id="rdoSelect">
                                                                        
                                                                </td>
                                                            </tr><!-- Item 5 End -->
                                                        </table>
                                                    </td>
                                                    <td class="tblFormTd">
                                                        <table>
                                                            <tr><!-- Item 6 Start -->
                                                                <td><font size="2" style="font-weight:bold;">6</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">Taxpayer Type </font></td>
                                                                <td>
                                                                    <input type="radio" value="Employee" name="frm1700:rdoPg1I6TaxpayerType" id="frm1700:rdoPg1I6TaxpayerTypeE" onclick="processTaxpayerType(false)" /><label for="frm1700:rdoPg1I6TaxpayerTypeE" style="font-size:10px;" >Employee <br /> (Regular Rates)</label>
                                                                </td>
                                                                <td>
                                                                    <input type="radio" value="NRANETB" name="frm1700:rdoPg1I6TaxpayerType" id="frm1700:rdoPg1I6TaxpayerTypeN" onclick="processTaxpayerType(true)" /><label for="frm1700:rdoPg1I6TaxpayerTypeN" style="font-size:10px;" >NRANETB*<br /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(25%)</label></td>

                                                            </tr><!-- Item 6 End -->
                                                        </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="tblFormTd" colspan="3">
                                                        <table>
                                                            <tr><!-- Item 7 Start -->
                                                                <td><font size="2" style="font-weight:bold;">7</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">Taxpayer's Name (Last Name, First Name, Middle Name)</font></td>
                                                            </tr>
                                                            <tr>
                                                                <td>&nbsp;</td>
                                                                <td><input type="text" value="" size="120" name="frm1700:txtProfile" maxlength="50" id="frm1700:txtPg1I7TaxpayerName" onblur="return capital(this, event)" disabled /></td>
                                                            </tr><!-- Item 7 End -->
                                                        </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="tblFormTd" colspan="3">
                                                        <table>
                                                            <tr> <!-- Item 8 Start -->
                                                                <td><font size="2" style="font-weight:bold;">8</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">Registered Address </font><font style="font-size: 8px;"> (Indicate complete address. If the registered address is different from the current address, got to the RDO to update registered address by using BIR Form No. 1905) </font></td>
                                                            </tr>
                                                            <tr>
                                                                <td>&nbsp;</td>
                                                                <td><input type="text" value="" size="120" name="frm1700:txtProfile" maxlength="100" id="frm1700:txtPg1I8Address" onblur="return capital(this, event)" disabled /></td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="tblFormTd" colspan="2">
                                                        <table>
                                                            <tr>
                                                                <td>&nbsp;</td>
                                                                <td><input type="text" value="" size="80" name="frm1700:txtProfile" maxlength="100" id="frm1700:txtPg1I8Address2" onblur="return capital(this, event)" disabled /></td>
                                                            </tr>
                                                        </table>
                                                    </td> <!-- Item 8 End -->
                                                    <td class="tblFormTd">
                                                        <table>
                                                            <tr><!-- Item 8A Start -->
                                                                <td><font size="2" style="font-weight:bold;">8A</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">ZIP Code </font></td>
                                                                <td><input type="text" value="" size="2" name="frm1700:txtProfile" maxlength="12" id="frm1700:txtPg1I8AZipCode" onkeypress="return wholenumber(this, event)" disabled /></td>
                                                            </tr><!-- Item 8A End -->
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                            <table border="0" cellspacing="0" cellpadding="0" class="tblForm">
                                                <tr>
                                                    <td class="tblFormTd">
                                                        <table>
                                                            <tr><!-- Item 9 Start --> 
                                                                <td><font size="2" style="font-weight:bold;">9</font></td>
                                                                <td><font size="1" face="Arial, Helvetica, sans-serif">Date of Birth (MM/DD/YYYY) </font></td>
                                                            </tr>
                                                            <tr>
