            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN3").disabled = true;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerBranchCode").disabled = true;
        }else{
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerName1").disabled = !elem.checked;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerName2").disabled = !elem.checked;
            d.getElementById("frm1700:txtPg2I"+itemNumber+ "PartVIEmployerTIN1").disabled = !elem.checked;
