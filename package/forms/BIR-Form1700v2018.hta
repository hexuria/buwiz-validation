                            '<input type="text" value="" size="20" align="left" name="frm1700:txtProfile" maxlength="50" id="frm1700:txtPg2I4_'+i+'PartVIEmployerName2" onblur="return capital(this, event)"  disabled/>'+
                            '<font size="2" style="font-weight:bold;">b.</font>'+
                            '<font size="1" face="Arial, Helvetica, sans-serif">Employer\'s TIN </font>'+
                            '<input type="text" size="2" name="frm1700:txtEmployer4_'+i+'TIN" maxlength="3" id="frm1700:txtPg2I4_'+i+'PartVIEmployerTIN1" onkeypress="return wholenumber(this, event)" onkeyup="moveToNext(this,3);enabledContinuationOfSchedule1(getThisId('+i+'));" onblur="validateTIN(this,false);"  disabled/>&nbsp;-&nbsp;'+
