                                                '<td><font size="2" style="font-weight:bold;">4.'+i+'</font></td>'+
                                                    '<td colspan="2" width="100%"></td>'+
                                                    '<td align="center"><input type="text" value="0.00" style="color: black; text-align: right;" size="20" maxlength="25" name="frm1700:txtPg2ISched1c_4_'+i+'EG" id="frm1700:txtPg2ISched1c_4_'+i+'REG" onblur="round(this,2);computeSubTotal();enabledAddButton(getThisId('+i+'));" onkeypress="return wholenumber(event, true);" disabled/></td>'+
                                                    '<td align="center"><input type="text" value="0.00" style="color: black; text-align: right;" size="20" maxlength="25" name="frm1700:txtPg2ISched1d_4_'+i+'CIFR" id="frm1700:txtPg2ISched1d_4_'+i+'CIFR" onblur="round(this,2);computeSubTotal();enabledAddButton(getThisId('+i+'));" onkeypress="return wholenumber(event, true);" disabled/></td>'+
