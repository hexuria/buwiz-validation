     function encrypt(val) {

        //var bf = new Blowfish('i@f0ffl1n3F0rm$');
        //var ciphertext = bf.encrypt(val);

        var ciphertext = Aes.Ctr.encrypt(val, aesPW, 256);
        return ciphertext;
    }

