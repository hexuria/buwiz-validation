	function uploadXMLFile () {
		var binDataURL;

		//Dev Note: frmMainSrc contains the HTML and content of the form
		//frmMainSrc should get the print preview version
		// $('#frmMain').html(); //content of the loop
		printme();

		if (savedReturn != null && savedReturn.length > 0) {
			var intervalCnt = 1000;

			var xmlFileForUpload = savedReturn.replace(/&nbsp;/g,"<span style='padding-left:0.25em'> </span>");
			xmlFileForUpload = xmlFileForUpload.replace(/&amp;/g,"AND");
			xmlFileForUpload = xmlFileForUpload.replace(/&/g,"_AND_");
			xmlFileForUpload = xmlFileForUpload.replace(/\+/g,"_PLUS_");
			var savedReturnLen = xmlFileForUpload.length;

			//Loop Begin - create submit_return_data records, related to Created Upload File -
			var numOfSRLoops = Math.ceil(savedReturnLen*1 / intervalCnt);
			var loopSRCnt = numOfSRLoops+1;
			var startSRPost = 0;
			var endSRPost = intervalCnt;
			var partSRCnt = 1;

			for(var i = 0; i < numOfSRLoops; i++) {

				binDataURL = rbURL + "/rest/api/create2?sessionId="+sessionId+"&objName=submit_return_data&useIds=false&index_="+partSRCnt+"&name=2200Tv2020_part"+partSRCnt+"&R95607586="+create2Id+"&content="+xmlFileForUpload.substring(startSRPost, endSRPost);
				var binDataUploadXML = new XMLHttpRequest();
				// binDataUploadXML.open( "GET", encodeURI(binDataURL) , false);
				// binDataUploadXML.send(null);

				binDataUploadXML.open( "POST", encodeURI(binDataURL) , false);
				binDataUploadXML.send();

				//xmlFn.writeLine(xmlFileInBase64.substring(startSRPost, endSRPost)+"\n\ncompleted\n\n");
				//alert('i = '+i+' startSRPost = '+startSRPost+' endSRPost = '+endSRPost);

				startSRPost = startSRPost + intervalCnt;
				if (i == numOfSRLoops-1) {
					endSRPost = savedReturnLen;
				} else {
					endSRPost = endSRPost + intervalCnt;
				}
				partSRCnt++;
			}
			//alert("A total of "+loopSRCnt+" iterations are uploaded in 'submit_return_data' object for this form!");
			cancel();
			disableAllElementIDs();
			//Open a new page, displaying the created form
			//alert("Finished Loading REST 'create2' request for FORMS object.");

			//getDisplayPageURL() is defined in string-util2014.js
			var redirectURL = x.window.location.href;
			var formURL = getDisplayPageURL(redirectURL, create2Id);
			if( parseInt(create2Id) > 0 ) window.open(formURL,'Login_Screen','resizable=1,scrollbars=1,height=850,width=900');
		} else {
			alert("Tax Return file does not exists.  Cannot proceed with submission.");
			return;
		}

	//xmlFn.close();
	}

	function loadXMLRegion(fileLocation) {
		try {
			//This will load the Region file with filename 'fileLocation' if it exists
			var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
			XMLRegionFile = fsoXML.OpenTextFile(fileLocation,1);

			if (XMLRegionFile.AtEndOfStream)
				data = "";
			else {
				var responseRegion = d.getElementById('responseRegion'); //render file and write to hidden div
				//responseRegion.innerHTML = XMLRegionFile.ReadAll(); //remove XML tag
				responseRegion = replaceHtml(responseRegion, XMLRegionFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
			}
			XMLRegionFile.Close(); //alert( responseRegion.innerHTML ); //Debug
			loadRegion();	/*This will load ATC onto an array*/
		} catch(e) {
			msg.innerHTML = ""; //"Region File not Found.";
		} //this will Alert File not Found if it doesn't exist
	}
	var regionCount=0;

	function loadXMLProvince(fileLocation) {
		try {
			//This will load the Province file with filename 'fileLocation' if it exists
			var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
			XMLProvinceFile = fsoXML.OpenTextFile(fileLocation,1);

			if (XMLProvinceFile.AtEndOfStream)
				data = "";
			else {
				var responseProvince = d.getElementById('responseProvince'); //render file and write to hidden div
				//responseProvince.innerHTML = XMLProvinceFile.ReadAll(); //remove XML tag
				responseProvince = replaceHtml(responseProvince, XMLProvinceFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
			}
			XMLProvinceFile.Close(); //alert( responseProvince.innerHTML ); //Debug
			loadProvince();	/*This will load ATC onto an array*/
		} catch(e) {
			msg.innerHTML = ""; //"Region File not Found.";
		} //this will Alert File not Found if it doesn't exist
	}

	function loadRegion() {
		/*This will load data onto an array*/
		var response = d.getElementById("responseRegion");

		var regionCnt = String(response.innerHTML).split('regionCount=');
		regionCount = regionCnt[1];

		var k = 0;
		//loads regionList from xml
		for (var i = 1; i <= regionCount; i++) {
			var region = String(response.innerHTML).split('region'+i+':');
			var regionStr = region[1];

			//Ensure that before writing to regionPropertyJS the formType 2200T is traceable in regionStr
			if (regionStr.indexOf('2200T') >= 0) {
				var regionValues = regionStr.split('~');
				var regionCode = regionValues[0];
				var description = regionValues[1];

				var objRegion = new regionPropertyJS(regionCode, description);
				regionList[k] = objRegion;
				k++;
				//alert('2200T successfully created array #'+i);

			} else {
				//alert('2200T not found in array #'+i);
				continue;
			}
		}
	}

	function loadProvince() {
		/*This will load data onto an array*/
		var response = d.getElementById("responseProvince");

		var provinceCnt = String(response.innerHTML).split('provinceCount=');
		provinceCount = provinceCnt[1];

		var k = 0;
		//loads provinceList from xml
		for (var i = 1; i <= provinceCount; i++) {

			var province = String(response.innerHTML).split('province'+i+':');
			var provinceStr = province[1];

			//Ensure that before writing to provincePropertyJS the formType 2200T is traceable in provinceStr
			if (provinceStr.indexOf('2200T') >= 0) {
				var provinceValues = provinceStr.split('~');

				var regionCode = provinceValues[0];
				var provinceCode = provinceValues[1];
				var description = provinceValues[2];

				var objProvince = new provincePropertyJS(regionCode, provinceCode, description);
				provinceList[k] = objProvince;
				k++;
				//alert('2200T successfully created array #'+i);

			} else {
				//alert('2200T not found in array #'+i);
				continue;
			}
		}
	}

	function getRegion() {
		var data = "<option value='00'>(Select Region)</option>";

		for(var i = 0; i < regionList.length; i++) {
			var region = regionList[i];
			data = data + "<option value=" + region.regionCode + ">" + region.description + "</option>";
		}

		$('#frm2200Tv2020\\:prodRegion').html(data);
		$('#frm2200Tv2020\\:remRegion').html(data);
	}

	function getProvince(regionElem, provId, cityId) {
		// escape colon for jQuery input
		provId = provId.replace(":", "\\:");
		cityId = cityId.replace(":", "\\:");

		// clear city
		$("#"+cityId).html("<option value='00'>(Select City)</option>");

		// set province data
		data = "<option value='00'>(Select Province)</option>";
		for(var i = 0; i < provinceList.length; i++) {
			var prov = provinceList[i];

			if(prov.regionCode == regionElem.value)
				data = data +"<option value=" + prov.provinceCode + ">" + prov.description + "</option>";
		}
		$("#"+provId).html(data);
	}

	function getCity(regionId, provElem, cityId) {
		// escape colon for jQuery input
		regionId = regionId.replace(":", "\\:");
		cityId = cityId.replace(":", "\\:");

		// set city data
		var data = "<option value='00'>(Select City)</option>";

		for(var i = 0; i < cityList.length; i++) {
			var city = cityList[i];

			if(city.regionCode == $("#"+regionId).val() && city.provinceCode == provElem.value)
				data = data + "<option value=" + city.cityCode + ">" + city.description + "</option>";
		}

		$("#"+cityId).html(data);
	}

	function validateDate(element) {
		var strmmddyyyy = element.value;
		var isValid = true;
		var currentDate = new Date();
		var inputDate = new Date();

		if (strmmddyyyy != "") {
			var result = strmmddyyyy.split("/");
			var isLeap = new Date(result[2], 1, 29).getMonth() === 1;
			var month31 = (['01', '03', '05', '07', '08', '10', '12']);
			var month30 = (['04', '06', '09', '11']);
			var month = result[0];
			var day = result[1];
			if (result.length === 3) {
				if (isNaN(result[0] || result[1] || result[2])) {
					isValid = false;
				}
				else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 1))) {
					// numeric check if greater not than 31 - Month.
					isValid = false;
				}
				else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
					// numeric check if Date.
					isValid = false;
				}
				else if (result[2].length != 4) {
					isValid = false;
				}
				else if (month == 2) {
					if (!isLeap && day == 29) {
						isValid = false;
					}
					else if (!isLeap && day > 29) {
						isValid = false;
					}
					else if (isLeap && day > 29) {
						isValid = false;
					}
				}
				else if (month31.contains(month) && day > 31) {
					isValid = false;
				}
				else if (month30.contains(month) && day > 30) {
					isValid = false;
				}

				inputDate = new Date(result[2], month - 1, day);

			}
			else {
				isValid = false;
			}
		}

		if (!isValid) {
			alert('Please provide a valid date. (MM/DD/YYYY format)');
			element.value = '';
			element.focus();
		}
		else if (inputDate > currentDate) {
			alert('This date cannot be a future date.');
			element.value = '';
			element.focus();
		}
		else if (inputDate.getFullYear() < 2018) {
			alert('This date cannot be prior to 2018.');
			element.value = '';
			element.focus();
		}

		return isValid;
	}

	function addZeroPadding(e){
		if(e.value.length == 1)
			e.value = "0" + e.value
	}


	function onAmendedClick(){
		var isAmended = d.getElementById('frm2200Tv2020:amendedRtn_1').checked;

		// Part II item 19 disabled if not amended
		d.getElementById('frm2200Tv2020:txtPrevReturn').disabled = !isAmended;
		if(!isAmended){
			d.getElementById('frm2200Tv2020:txtPrevReturn').value = '0.00';
			calculate_Part3();
		}

	}


	function onTreatyClick(){
		var isAvail = d.getElementById('frm2200Tv2020:optTreaty_1').checked;

		// Item 12A disabled if not availing of tax relief
		d.getElementById('frm2200Tv2020:treatyY').disabled = !isAvail;
	}

	function changePayment(){
		d.getElementById('frm2200Tv2020:paymentOther').disabled = !(d.getElementById('frm2200Tv2020:optPayment_3').checked);
	}


	function valToFloat(value){
		return parseFloat(value.replace(/,/g, ''));
	}

	function amtFormat(number){
		return number.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",")
	}

	function calculate_Part3(){
		d.getElementById("frm2200Tv2020:txtLess_Tot").value = amtFormat(valToFloat(d.getElementById("frm2200Tv2020:txtLess_Balance").value) + valToFloat(d.getElementById("frm2200Tv2020:txtLess_Excise").value));
		d.getElementById("frm2200Tv2020:txtNetTaxDue").value = amtFormat(valToFloat(d.getElementById("frm2200Tv2020:txtExciseDue").value) - valToFloat(d.getElementById("frm2200Tv2020:txtLess_Tot").value));
		d.getElementById("frm2200Tv2020:txtStillDue").value = amtFormat(valToFloat(d.getElementById("frm2200Tv2020:txtNetTaxDue").value) - valToFloat(d.getElementById("frm2200Tv2020:txtPrevReturn").value));

		d.getElementById("frm2200Tv2020:txtPen_Tot").value = amtFormat(
			valToFloat(d.getElementById("frm2200Tv2020:txtPen_Surcharge").value) +
			valToFloat(d.getElementById("frm2200Tv2020:txtPen_Interest").value) + 
			valToFloat(d.getElementById("frm2200Tv2020:txtPen_Compromise").value)
		);

		d.getElementById("frm2200Tv2020:txtAmtPayable").value = amtFormat(valToFloat(d.getElementById("frm2200Tv2020:txtStillDue").value) + valToFloat(d.getElementById("frm2200Tv2020:txtPen_Tot").value));
		d.getElementById("frm2200Tv2020:txtPay_Penalties").value = d.getElementById("frm2200Tv2020:txtPen_Tot").value
		d.getElementById("frm2200Tv2020:txtPay_Tot").value = amtFormat(valToFloat(d.getElementById("frm2200Tv2020:txtPay_TaxPayment").value) + valToFloat(d.getElementById("frm2200Tv2020:txtPay_Penalties").value));
		d.getElementById("frm2200Tv2020:txtBalance").value = amtFormat(valToFloat(d.getElementById("frm2200Tv2020:txtAmtPayable").value) - valToFloat(d.getElementById("frm2200Tv2020:txtPay_Tot").value));
	}	

	function calculate_Sched1_TotalDue(){
		var totalDue_Value = 0;
		$('input[id^="frm2200Tv2020\\:txtSched1_"][id$="_Due"]').each(function(i, j){
			totalDue_Value += valToFloat(j.value);
		});

		d.getElementById("frm2200Tv2020:txtSched1_TotalDue").value = amtFormat(totalDue_Value);

		d.getElementById("frm2200Tv2020:txtExciseDue").value = d.getElementById("frm2200Tv2020:txtSched1_TotalDue").value;
	}



//--------------------------END:  Rollbase REST API using 'create2' and 'setBinaryData' --------------------------

</script>
