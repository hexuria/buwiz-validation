										<tr>
											<td width="70%" valign="top" class="tblFormTd">
												<table border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td>
															<table border="0" cellspacing="0" cellpadding="0">
																<tr>
																	<td width="11"><font size="2" style="font-weight:bold;">&nbsp;7&nbsp;</font></td>
																	<td><font size="1">Registered Address (Indicate complete address. If branch, indicate the branch address. If the registered address is different form the current address, go to the RDO to update registered address by using BIR Form No. 1905)</font></td>

																</tr>
															</table>
														</td>
													</tr>
													<tr>
														<td>
