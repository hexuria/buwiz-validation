	function goToPage() {
		var newVal = document.getElementById("frm2200Tv2020:txtCurrentPage").value;
		//var printType = !isFromPrint ? "Page" : "Print";
		var printType = "Page";

		if ((newVal <= MaxPage) && (newVal > 0) && (newVal !== currentPage.toString())) {
			$('#' + printType + currentPage + 'Content').hide('blind');
			$('#' + printType + newVal + 'Content').show('blind');
			currentPage = (document.getElementById("frm2200Tv2020:txtCurrentPage").value) * 1;
		}
		else if ((newVal > MaxPage) || (newVal <= 0)) {
			alert("Invalid page");

			document.getElementById("frm2200Tv2020:txtCurrentPage").value = currentPage;
		}

		// if (isFromPrint) {
		// 	//printOCR();
		// }
	}

	function processPrev() {
		if (currentPage == 1){
			currentPage = 1;
		} else {
			currentPage--;
			$('#Page' + currentPage + 'Content').show('blind');
			$('#Page' + (currentPage + 1) + 'Content').hide('blind');
			document.getElementById('frm2200Tv2020:txtCurrentPage').value = currentPage;

		}
	}
	function processNext() {
		if (currentPage == MaxPage) {
		} else {
			currentPage++;
			$('#Page' + currentPage + 'Content').show('blind');
			$('#Page' + (currentPage - 1) + 'Content').hide('blind');
			document.getElementById('frm2200Tv2020:txtCurrentPage').value = currentPage;
		}
	}







	function blockletter(e)
	{
		var number = parseFloat(e.value).toFixed(2);
		if(isNaN(number))
		{
			var zero = 0;
			e.value = parseFloat(zero).toFixed(2);
		}else {
			e.value = '' + number;
		}
	}

	function blockNegativeNumber(e)
	{
		if(e.value < 0){
			e.value = "0.00";
		}
	}

	function blockletterWithout2Decimal(e)
	{
		var number = parseFloat(e.value);
		if(isNaN(number))
		{
			e.value = "";
		} else {
			e.value = '' + number.toFixed(0);
		}
	}

	function blockLetterInt(e)
	{
		var number = e.value;
		if(isNaN(number))
		{
			e.value = "";
		} else {
			e.value = '' + number;
		}
	}

	function validateForm()
	{
		var dt = new Date();

		var month = parseInt(d.getElementById("frm2200Tv2020:txtDateMonth").value, 10);
		var day = parseInt(d.getElementById("frm2200Tv2020:txtDateDay").value, 10);
		var year = d.getElementById("frm2200Tv2020:txtDateYear").value;

		var inputDate = new Date(year, month-1, day);
		var currDate = new Date();
		currDate.setHours(0, 0, 0, 0);

		var maxDay = 0;
		switch(month - 1){
			case 1 :
				maxDay = (year % 4 == 0 && year % 100) || year % 400 == 0 ? 29 : 28;
				break;
			case 8 : case 3 : case 5 : case 10 :
				maxDay = 30;
				break;
			default :
				maxDay = 31
		}

		if(month == "" || month < 1 || month > 12 || !month){
			alert("Please enter a valid month on Item 1.");
			return;
		}

		if(maxDay == 28 && day > maxDay){
			alert("Please enter a valid date on Item 1. Filing year is not a leap year.");
			return;
		}

		if(day == "" || day < 1 || day > maxDay || !day){
			alert("Please enter a valid day on Item 1.");
			return;
		}

		if(year == ""){
			alert("Please enter a valid year on Item 1.");
			return;
		}

		if(year < 1904){
			alert("Invalid date entry on Item 1. Entry should not be lower than 1904.");
			return;
		}

		if(inputDate.valueOf() > currDate.valueOf()){
			alert("Invalid date entry on Item 1. Date cannot be after the current date.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:tinA').value == "" || d.getElementById('frm2200Tv2020:tinB').value == "" || d.getElementById('frm2200Tv2020:tinC').value == "" || d.getElementById('frm2200Tv2020:branchCode').value == ""){
			alert("Please enter a valid TIN number on Item 4.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:rdoCode').selectedIndex == 0){
			alert("Please enter a valid RDO Code on Item 5.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:registeredName').value == ""){
			alert("Please enter a valid Taxpayer's Name on Item 6.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:registeredAddress').value == ""){
			alert("Please enter Taxpayer's Registered Address on Item 7.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:zipCode').value == ""){
			alert("Please enter Taxpayer's Zip Code on Item 7A.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:phoneNumber').value == ""){
			alert("Please enter a valid Telephone Number on Item 8.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:prodCity').selectedIndex == 0){
			alert("Please enter a valid Place of Production on Item 10.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:remCity').selectedIndex == 0){
			alert("Please enter a valid Place of Removal on Item 11.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:optTreaty_1').checked && d.getElementById('frm2200Tv2020:treatyY').value == ""){
			alert("Please specify a Tax Relief on Item 12A.");
			return;
		}

		if(!d.getElementById('frm2200Tv2020:optPayment_1').checked && 
			!d.getElementById('frm2200Tv2020:optPayment_2').checked && 
			!d.getElementById('frm2200Tv2020:optPayment_3').checked){

			alert("Please enter a Manner of Payment on Part II.");
			return;
		}

		if(d.getElementById('frm2200Tv2020:optPayment_3').checked && d.getElementById('frm2200Tv2020:paymentOther').value == ""){
			alert("Please specify a Scheme on Item 15.");
			return;
		}



		d.getElementById('frm2200Tv2020:cmdValidate').disabled = true;
		d.getElementById('btnPrint').disabled = false;
		d.getElementById('frm2200Tv2020:cmdEdit').disabled = false;
		d.getElementById('btnUpload').disabled = false;

		enabledDisabledControls(true);

		alert("Validation successful. Click on Edit if you wish to modify your entries.");
		return;
	}


	function getElementsByClassName(node, classname) {
		var a = [];
		var re = new RegExp('(^| )'+classname+'( |$)');
		var els = node.getElementsByTagName("*");
		for(var i=0,j=els.length; i<j; i++)
			if(re.test(els[i].className))a.push(els[i]);
		return a;
	}

	function validateMonthDayYearDate(dateID) {
		strmmddyyyy = dateID;
		if(strmmddyyyy != "")
		{
			var result = strmmddyyyy.split("/");
			var isLeap = new Date(result[2], 1, 29).getMonth() == 1;
			var month31 = (['01', '03', '05', '07', '08', '10', '12']);
			var month30 = (['04', '06', '09', '11']);
			var month = result[0];
			var day = result[1];
			if(result.length == 3 )
			{
				if(isNaN(result[0] || result[1] || result[2]))
				{
					return true;
				}
				else if(( result[0].length != 2 || (result[0] > 12 || result[0] < 0) )){
					// numeric check if greater not than 31 - Month.
					return true;
				}
				else if( result[1].length != 2 || (result[1] > 31 || result[1] < 1) ){
					// numeric check if Date.
					return true;
				}
				else if( result[2].length != 4 ){
					return true;
				}
				else if(month==2){
					if (!isLeap && day==29) {
						return true;
					}
					else if (!isLeap && day>29) {
						return true;
					}
					else if (isLeap && day>29) {
						return true;
					}
				}
				else if (month31.contains(month) && day > 31)
				{
					return true;
				}
				else if (month30.contains(month) && day > 30)
				{
					return true;
				}
			} else {
				return true;
			}
		}
	}

