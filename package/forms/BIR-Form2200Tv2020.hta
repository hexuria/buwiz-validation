	function getRdo()
	{
		var data = "<select class='iceSelOneMnu' id='frm2200Tv2020:rdoCode' name='frm2200Tv2020:rdoCode' size='1' ><option value='000'> </option>";

		for(var i = 0; i < rdoList.length; i++) {
			var rdo = rdoList[i];
			data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";

