<script type="text/javascript">
	//Declare global variable
	var isSubmitFinal = false;
	var isSubmit = false;

	var str;
	var gIsReadOnly = false;
	var fileName = "";
	var existingXMLFileName = "";
	var fileNameToExport = "";

	var savedReturn = "";
	var p3Compromise = "";
	var p3Surcharge = "";
	var p3Interest = "";
	var p3IsAmended = "";
	var p3FilingDate = "";
	var p3ReturnPeriod = "";
	var p3ReturnPeriodEnd = "";
	var p3ReturnPeriodMonth = "";
	var p3ReturnPeriodDay = "";
	var p3ReturnPeriodYear = "";

	var p3BasicTax = "";
	var p3TotalPenalties = "";
	var p3TotalAmountPayable = "";

	var p3TPTIN1 = "";
	var p3TPTIN2 = "";
	var p3TPTIN3 = "";
	var p3TPTIN = "";
	var p3TPBranchCode = "";
	var p3TPRDOCode = "";
	var p3TPName = "";
	var p3TPTelNum = "";
	var p3TPAddress = "";
	var p3TPZip = "";   var globalEmail = "";

	var retYear = "";

	var currentPage;
	var MaxPage = 3;

	str = setInterval("sleeptime()", 300);


	function sleeptime()
	{
		clearInterval(str);
		init();

		loadXMLProvince('xml/province.xml');
		loadArrayCity();

		var bgFileName =  qs('xmlBGInfoFileName');
		if (bgFileName != null && bgFileName.indexOf('.xml') > -1) {
			loadBGXML(bgFileName);
		}

		fileName =  qs('xmlFileName');
		if (fileName != null && fileName.indexOf('.xml') > -1) {
			loadXML(fileName);
			var tin = fileName.split("/")[1].split("-");
			loadBGXML("profile/"+ tin[0]+".xml");

			// d.getElementById('frm2200Tv2020:txtYear').disabled = true;

			existingXMLFileName = fileName;
			if (gIsReadOnly) {
			window.setTimeout("disableAllElementIDs(); d.getElementById('btnUpload').disabled = false;",1000);
			}
		} else {
			window.setTimeout("$('#loader').hide('blind');",100);

			// no xml saved. populate fields with default values from profile
			d.getElementById('frm2200Tv2020:registeredName_2').value = d.getElementById('frm2200Tv2020:registeredName').value;
			d.getElementById('frm2200Tv2020:registeredName_3').value = d.getElementById('frm2200Tv2020:registeredName').value;


			d.getElementById('frm2200Tv2020:tinA_2').value = d.getElementById('frm2200Tv2020:tinA').value;
			d.getElementById('frm2200Tv2020:tinB_2').value = d.getElementById('frm2200Tv2020:tinB').value;
			d.getElementById('frm2200Tv2020:tinC_2').value = d.getElementById('frm2200Tv2020:tinC').value;
			d.getElementById('frm2200Tv2020:branchCode_2').value = d.getElementById('frm2200Tv2020:branchCode').value;

			d.getElementById('frm2200Tv2020:tinA_3').value = d.getElementById('frm2200Tv2020:tinA').value;
			d.getElementById('frm2200Tv2020:tinB_3').value = d.getElementById('frm2200Tv2020:tinB').value;
			d.getElementById('frm2200Tv2020:tinC_3').value = d.getElementById('frm2200Tv2020:tinC').value;
			d.getElementById('frm2200Tv2020:branchCode_3').value = d.getElementById('frm2200Tv2020:branchCode').value;
		}

		if ( $('#printMenu').css('display') != 'none' ) {
			$('#printMenu').hide('blind');
		}

		d.getElementById('frm2200Tv2020:tinA').disabled = true;
		d.getElementById('frm2200Tv2020:tinB').disabled = true;
		d.getElementById('frm2200Tv2020:tinC').disabled = true;
		d.getElementById('frm2200Tv2020:branchCode').disabled = true;
		d.getElementById('frm2200Tv2020:rdoCode').disabled = true;
		d.getElementById('frm2200Tv2020:registeredName').disabled = true;
		d.getElementById('frm2200Tv2020:registeredAddress').disabled = true;
		d.getElementById('frm2200Tv2020:zipCode').disabled = true;
		d.getElementById('frm2200Tv2020:phoneNumber').disabled = true;
		d.getElementById('frm2200Tv2020:txtEmail').disabled = true;




		// d.getElementById('frm2200Tv2020:tinA_2').disabled = true;
		// d.getElementById('frm2200Tv2020:tinB_2').disabled = true;
		// d.getElementById('frm2200Tv2020:tinC_2').disabled = true;
		// d.getElementById('frm2200Tv2020:branchCode_2').disabled = true;
		// d.getElementById('frm2200Tv2020:registeredName_2').disabled = true;

		// retYear = d.getElementById('frm2200Tv2020:txtYear').value;

		onAmendedClick();
		onTreatyClick();
		changePayment();


		 window.setTimeout("checkFinalCopyBtn('2200Tv2020');" +
			"d.getElementById('frm2200Tv2020:btnPrevPage').disabled=false;" +
			"d.getElementById('frm2200Tv2020:txtCurrentPage').disabled=false;" +
			"d.getElementById('frm2200Tv2020:btnNextPage').disabled=false;", 2000);
	}

	function rdoPropertyJS(rdoCode, description)
	{
		this.rdoCode=rdoCode;
		this.description=description;
	}

	var rdoList = new Array();

	function regionPropertyJS(regionCode, description)
	{
		this.regionCode=regionCode;
		this.description=description;
	}

	function provincePropertyJS(regionCode, provinceCode, description)
	{
		this.regionCode=regionCode;
		this.provinceCode=provinceCode;
		this.description=description;
	}

	function cityPropertyJS(regionCode, provinceCode, cityCode, description)
	{
		this.regionCode=regionCode;
		this.provinceCode=provinceCode;
		this.cityCode=cityCode;
		this.description=description;
	}

