							<tr>
								<td>
									<table width="920" border="0" cellspacing="0" cellpadding="0" class="tblForm fullWidth rightInput">
										<tr>
											<td class="tblFormTd">
												<table width="100%" border="1" cellspacing="0" cellpadding="0">
													<col width="34%"/>
													<col width="33%"/>
													<col width="33%"/>

													<tr>
														<td colspan="2">
															<font size="2" style="font-weight:bold;">&nbsp;16&nbsp;</font>
															<font size="1">Excise Tax Due (From Part V, Schedule 1)&nbsp;</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtExciseDue" name="frm2200Tv2020:txtExciseDue" type="text"value="0.00" disabled/>
														</td>
													</tr>

													<tr>
														<td colspan="2">
															<font size="2" style="font-weight:bold;">&nbsp;17&nbsp;</font>
															<font size="1">Less:</font>
															<font size="2" style="font-weight:bold;">&nbsp;17A&nbsp;</font>
															<font size="1">Balance Carried Over from Previous Return&nbsp;</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtLess_Balance" name="frm2200Tv2020:txtLess_Balance" type="text" value="0.00" onkeypress="return numbersonly(this, event)" onblur="round(this,2);blockNegativeNumber(this);calculate_Part3();"/>
														</td>
													</tr>

													<tr>
														<td colspan="2">
															&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp&nbsp;&nbsp;
															<font size="2" style="font-weight:bold;">&nbsp;17B&nbsp;</font>
															<font size="1">Creditable Excise Tax, if applicable</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtLess_Excise" name="frm2200Tv2020:txtLess_Excise" type="text" value="0.00" onkeypress="return numbersonly(this, event)" onblur="round(this,2);blockNegativeNumber(this);calculate_Part3();"/>
														</td>
													</tr>

													<tr>
														<td colspan="2">
															&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp&nbsp;&nbsp;
															<font size="2" style="font-weight:bold;">&nbsp;17C&nbsp;</font>
															<font size="1">Total (Sum of Items 17A and 17B)&nbsp;</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtLess_Tot" name="frm2200Tv2020:txtLess_Tot" type="text"value="0.00" disabled/>
														</td>
													</tr>

													<tr>
														<td colspan="2">
															<font size="2" style="font-weight:bold;">&nbsp;18&nbsp;</font>
															<font size="1">Net Tax Due/(Overpayment) (Item 16 less Item 17C)&nbsp;</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtNetTaxDue" name="frm2200Tv2020:txtNetTaxDue" type="text"value="0.00" disabled/>
														</td>
													</tr>

													<tr>
														<td colspan="2">
															<font size="2" style="font-weight:bold;">&nbsp;19&nbsp;</font>
															<font size="1">Less: Payment on Return Previously Filed for the Same Period, if amended return&nbsp;</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtPrevReturn" name="frm2200Tv2020:txtPrevReturn" type="text" value="0.00" onkeypress="return numbersonly(this, event)" onblur="round(this,2);blockNegativeNumber(this);calculate_Part3();" disabled />
														</td>
													</tr>

													<tr>
														<td colspan="2">
															<font size="2" style="font-weight:bold;">&nbsp;20&nbsp;</font>
															<font size="1">Tax Still Due/(Overpayment) (Item 18 less Item 19)&nbsp;</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtStillDue" name="frm2200Tv2020:txtStillDue" type="text"value="0.00" disabled/>
														</td>
													</tr>

													<tr>
														<td colspan="2">
															<font size="2" style="font-weight:bold;">&nbsp;21&nbsp;</font>
															<font size="1">Add: Penalties</font>
															<font size="2" style="font-weight:bold;">&nbsp;21A&nbsp;</font>
															<font size="1">Surcharge&nbsp;</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtPen_Surcharge" name="frm2200Tv2020:txtPen_Surcharge" type="text" value="0.00" onkeypress="return numbersonly(this, event)" onblur="round(this,2);blockNegativeNumber(this);calculate_Part3();"/>
														</td>
													</tr>

													<tr>
														<td colspan="2">
															&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
															<font size="2" style="font-weight:bold;">&nbsp;21B&nbsp;</font>
															<font size="1">Interest</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtPen_Interest" name="frm2200Tv2020:txtPen_Interest" type="text" value="0.00" onkeypress="return numbersonly(this, event)" onblur="round(this,2);blockNegativeNumber(this);calculate_Part3();"/>
														</td>
													</tr>

													<tr>
														<td colspan="2">
															&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
															<font size="2" style="font-weight:bold;">&nbsp;21C&nbsp;</font>
															<font size="1">Compromise</font>
														</td>

														<td>
															<input id="frm2200Tv2020:txtPen_Compromise" name="frm2200Tv2020:txtPen_Compromise" type="text" value="0.00" onkeypress="return numbersonly(this, event)" onblur="round(this,2);blockNegativeNumber(this);calculate_Part3();"/>
														</td>
													</tr>

