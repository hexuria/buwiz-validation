	<style>
		.atcNames { font-weight:bold; }
		tr.atc td { border-bottom: 1px #e1e1e1 solid; }
		tr.atc:hover td { background:#FFC; }
		td.atc { padding:4px; }
		.labels { background: #FFF; font-size:8px; width:auto !important; display:inline; height:10px; border:2px inset #FFF; padding:0 2px 0 2px; }

		#container {
			margin-top:40px;
		}

		.fullWidth input[type='text']{
			width: 98%;
			height: 100%;
		}

		.rightInput input[type='text']{
			text-align: right;
		}

		input[type='text'].defaultTb{
			text-align: left;
			width: auto;
		}

		ol.a1 {
			list-style-type: none;
			counter-reset: elem;
			padding-left: 0;
		}

		ol.a1 li:before {
			content: "a." counter(elem) " ";
			counter-increment: elem;
		}

		ol.b1 {
			list-style-type: none;
			counter-reset: elem;
			padding-left: 0;
		}

		ol.b1 li:before {
			content: "b." counter(elem) " ";
			counter-increment: elem;
		}
	</style>
