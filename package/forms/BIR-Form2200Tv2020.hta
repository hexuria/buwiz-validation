			<div id="wrapper" style="margin: 0 auto; position: relative; width: 926px;" >
				<div id = "formPaper">



					<div id="Page1Content">
					<!-- <div id="Page1Content" style="display:none;"> -->
						<table width="926" border="0" cellspacing="0" cellpadding="0">
							<tr>
								<td>
									<table width="800" border="0" cellspacing="0" cellpadding="0">
										<tr>
											<td width="300" valign="bottom"><p><img src="../img/bcs_new.png" width="80" /></p></td>
											<td><p><img src="../img/header_logo.png" width="210" height="50px" /> </p></td>
											<td><p style="padding:8px;border:solid;width:70px;text-align:center;"><b>Annex "B"</b></p></td>
										</tr>
									</table>
								</td>
							</tr>

							<tr>
								<td>
									<table width="800" border="1" cellspacing="0" cellpadding="0">
										<tr>
											<td width="120" valign="middle" style="text-align: center;">
												<font face="Arial" size="1px">BIR Form No.</font>
												<br/><font size="5px" style="font-weight:bold;">2200-T</font>
												<br/><font face="Arial" size="1px">January 2020</font>
												<br/><font face="Arial" size="1px" style="font-weight:bold;">Page 1</font>
											</td>
											<td width="0" valign="center" style="text-align: center;">
												<font size="5px" style="font-weight:bold;">EXCISE TAX RETURN</font>

												<br/>
												<font size="3px" style="font-weight:bold;">for Tobacco, Heated Tobacco and Vapor Products</font>

												<br/>
												<font face="Arial" size="1px">Enter all required information in CAPITAL LETTERS using BLACK ink. Mark all applicable boxes with<br/>an "X". Two copies MUST be filed with the BIR and one held by the Taxpayer.</font>
											</td>
											<td width="200" valign="center">
												<p><img src="../img/2200Tv2020_BarCode/2200Tv2020_p1.png" width="220" height="75px" /> </p>
											</td>
										</tr>
									</table>
								</td>
							</tr>

							<tr>
								<td>
									<table width="920" border="0" cellspacing="0" cellpadding="0" class="tblForm">
										<tr>
											<td width="30%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0" class="rightInput">
													<tr>
														<td width="11"><font size="2" style="font-weight:bold;">&nbsp;1&nbsp;&nbsp;&nbsp;</font></td>
														<td><font size="1">Date (MM/DD/YYYY)</font></td>
														<td>
															<input id="frm2200Tv2020:txtDateMonth" name="frm2200Tv2020:txt[DateMonth]" maxlength="2" size="1" type="text" onKeyPress="return wholenumber(this, event)" onblur="addZeroPadding(this);enableSaveButton();" value="" />

															<input id="frm2200Tv2020:txtDateDay" name="frm2200Tv2020:txt[DateDay]" maxlength="2" size="1" type="text" onKeyPress="return wholenumber(this, event)" onblur="addZeroPadding(this);enableSaveButton();" value="" />

															<input id="frm2200Tv2020:txtDateYear" name="frm2200Tv2020:txt[DateYear]" maxlength="4" size="1" type="text" onKeyPress="return wholenumber(this, event)" onblur="addZeroPadding(this);enableSaveButton();" value="" />
														</td>
													</tr>
												</table>
											</td>
											<td width="36%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td width="8%"><font size="2" style="font-weight:bold;">&nbsp;2</font></td>
														<td width="32%"><font size="1">Amended Return?</font></td>
														<td width="60%">
															<table border="0" cellpadding="0" cellspacing="0" class="iceSelOneRb-dis fieldText1-dis">
																<tr>
																	<td>
																		<input type="radio" value="Y" name="frm2200Tv2020:amendedRtn" id="frm2200Tv2020:amendedRtn_1" onclick="onAmendedClick()" />
																		<font size="1">Yes</font>
																		&nbsp;&nbsp;&nbsp;
																	</td>
																	<td>
																		<input type="radio" value="N" name="frm2200Tv2020:amendedRtn" id="frm2200Tv2020:amendedRtn_2" onclick="onAmendedClick()" checked="checked" />
																		<font size="1">No</font>
																	</td>
																</tr>
															</table>
														</td>
													</tr>
												</table>
											</td>
											<td width="33%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td width="11"><font size="2" style="font-weight:bold;">&nbsp;3&nbsp;&nbsp;&nbsp;</font></td>
														<td><font size="1">No. of Sheets Attached
																<input type="text" value="0" style="text-align: right;" size="4" name="frm2200Tv2020:txtSheets" maxlength="2" id="frm2200Tv2020:txtSheets" class="iceInpTxt-dis" onkeypress="return wholenumber(this, event)" />
															</font>
														</td>
													</tr>
												</table>
											</td>
										</tr>
									</table>
								</td>
							</tr>

							<tr>
								<td>
									<table border="0" cellspacing="0" cellpadding="0" class="tblForm">
										<tr><td class="tblFormTdPart"></td></tr>
										<tr>
											<td class="tblFormTdPart">
												<div align="center">
													<font face="Arial, Helvetica, sans-serif" size="1.5px">
														<b>Part I - Background Information</b>
													</font>
												</div>
											</td>
										</tr>
									</table>
								</td>
							</tr>

							<tr>
								<td>
									<table width="920" border="0" cellpadding="0" cellspacing="0" class="tblForm">
										<tr>
											<td width="70%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td width="11"><font size="2" style="font-weight:bold">&nbsp;4&nbsp;</font></td>
														<td>
															<font size="1">Taxpayer Identification Number (TIN)&nbsp;</font>
															<font size="2" face="Arial">
																<input type="text" value="" size="2" name="frm2200Tv2020:tinA" maxlength="3" id="frm2200Tv2020:tinA" onkeypress="return wholenumber(this, event)" onblur ="enableSaveButton();" />
																<input type="text" value="" size="2" name="frm2200Tv2020:tinB" maxlength="3" id="frm2200Tv2020:tinB" onkeypress="return wholenumber(this, event)"  onblur ="enableSaveButton();"/>
																<input type="text" value="" size="2" name="frm2200Tv2020:tinC" maxlength="3" id="frm2200Tv2020:tinC" onkeypress="return wholenumber(this, event)"  onblur ="enableSaveButton();"/>
																<input type="text" value="" size="2" name="frm2200Tv2020:branchCode" maxlength="5" id="frm2200Tv2020:branchCode" onkeypress="return letternumber(event)" />
															</font>
														</td>
													</tr>
												</table>
											</td>
											<td width="30%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td width="80"><font size="2" style="font-weight:bold">&nbsp;5&nbsp;</font><font size="1">RDO Code&nbsp;</font></td>
														<td id="rdoSelect"></td>
													</tr>
												</table>
											</td>
										</tr>
									</table>
								</td>
							</tr>

							<tr>
								<td>
									<table width="920" border="0" cellspacing="0" cellpadding="0" class="tblForm">
										<tr>
											<td width="100%" valign="top" class="tblFormTd">
												<table width="547" border="0" cellpadding="0" cellspacing="0">
													<tr>
														<td width="529">
															<table border="0" cellspacing="0" cellpadding="0">
																<tr>
																	<td width="11"><font size="2" style="font-weight:bold;">&nbsp;6&nbsp;</font></td>
																	<td><font size="1">Taxpayer's Name (Last Name, First Name, Middle Name for Individuals OR Registered Name for Non-Individuals)</font></td>
																</tr>
															</table>
														</td>
													</tr>
													<tr>
														<td>
															<table border="0" cellspacing="0" cellpadding="0">
																<tr>
																	<td width="2x`">&nbsp;</td>
																	<td><input type="text" value=""  size="125" name="frm2200Tv2020:registeredName" maxlength="70" id="frm2200Tv2020:registeredName" onblur="return capital(this, event)" /></td>
																</tr>
															</table>
														</td>
													</tr>
												</table>
											</td>
										</tr>
									</table>
