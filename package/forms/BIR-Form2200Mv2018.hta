        schedule3 = {};
        OtherTaxableIncomeNotSubjectToFinalTax = {};
        OtherTaxableIncomeNotSubjectToFinalTaxList = [];
        // Page 4 Schedule 4
        schedule4 = {};
        amortization = {};
        amortizationList = [];
        others = {};
