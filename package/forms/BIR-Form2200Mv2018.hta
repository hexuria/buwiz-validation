    }

    var rdoList = new Array();

    var XMLrdoFile = ''; //Object Type

    var rdoCount = 0;

    function loadXMLrdo(fileLocation) {
        try {
            //This will load the Region file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLrdoFile = fsoXML.OpenTextFile(fileLocation, 1);

            if (XMLrdoFile.AtEndOfStream)
                data = "";
            else {
                var responseRdo = d.getElementById('responseRdo'); //render file and write to hidden div
                responseRdo.innerHTML = XMLrdoFile.ReadAll(); //remove XML tag
                //responseRdo = replaceHtml(responseRdo, XMLrdoFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
            }
            XMLrdoFile.Close(); //alert( responseRdo.innerHTML ); //Debug           
            loadRdo(); /*This will load ATC onto an array*/
        } catch (e) {
            msg.innerHTML = ""; //"Region File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadRdo() {
        /*This will load data onto an array*/
        var response = document.getElementById("responseRdo");

        var rdoCnt = String(response.innerHTML).split('rdoCount=');
        rdoCount = rdoCnt[1];

        var k = 0;
        //loads rdoList from xml
        for (var i = 1; i <= rdoCount; i++) {
            var rdo = String(response.innerHTML).split('rdo' + i + ':');
            var rdoStr = rdo[1];

            //Ensure that before writing to rdoPropertyJS the formType 2200C is traceable in rdoStr
            if (rdoStr.indexOf('2200C') >= 0) {
                var rdoValues = rdoStr.split('~');
                var rdoCode = rdoValues[0];
                var description = rdoValues[1];

                var objRdo = new rdoPropertyJS(rdoCode, description);
                rdoList[k] = objRdo;
                k++;
            } else {
                //alert('2200C not found in array #'+i);
                continue;
            }
        }

    }

    function loadXMLCity(fileLocation) {
        try {
            //This will load the City file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLCityFile = fsoXML.OpenTextFile(fileLocation, 1);

            if (XMLCityFile.AtEndOfStream)
                data = "";
            else {
                var responseCity = d.getElementById('responseCity'); //render file and write to hidden div
                //responseCity.innerHTML = XMLCityFile.ReadAll(); //remove XML tag
                responseCity = replaceHtml(responseCity, XMLCityFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
            }
            XMLCityFile.Close(); //alert( responseCity.innerHTML ); //Debug         
            loadCity(); /*This will load ATC onto an array*/
        } catch (e) {
            msg.innerHTML = ""; //"Region File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadXMLProvince(fileLocation) {
        try {
            //This will load the Province file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLProvinceFile = fsoXML.OpenTextFile(fileLocation, 1);

            if (XMLProvinceFile.AtEndOfStream)
                data = "";
            else {
                var responseProvince = d.getElementById('responseProvince'); //render file and write to hidden div
                //responseProvince.innerHTML = XMLProvinceFile.ReadAll(); //remove XML tag
                responseProvince = replaceHtml(responseProvince, XMLProvinceFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
            }
            XMLProvinceFile.Close(); //alert( responseProvince.innerHTML ); //Debug         
            loadProvince(); /*This will load ATC onto an array*/
        } catch (e) {
            msg.innerHTML = ""; //"Region File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadXMLRegion(fileLocation) {
        try {
            //This will load the Region file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLRegionFile = fsoXML.OpenTextFile(fileLocation, 1);

            if (XMLRegionFile.AtEndOfStream)
                data = "";
            else {
                var responseRegion = d.getElementById('responseRegion'); //render file and write to hidden div
                //responseRegion.innerHTML = XMLRegionFile.ReadAll(); //remove XML tag
                responseRegion = replaceHtml(responseRegion, XMLRegionFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
            }
            XMLRegionFile.Close(); //alert( responseRegion.innerHTML ); //Debug         
            loadRegion();   /*This will load ATC onto an array*/
        } catch (e) {
            msg.innerHTML = ""; //"Region File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    var regionCount = 0;
    var provinceCount = 0;
    var cityCount = 0;

    function loadCity() {
        /*This will load data onto an array*/
        var response = d.getElementById("responseCity");

        var cityCnt = String(response.innerHTML).split('cityCount=');
        cityCount = cityCnt[1];

        var k = 0;
        //loads cityList from xml
        for (var i = 1; i <= cityCount; i++) {

            var city = String(response.innerHTML).split('city' + i + ':');
            var cityStr = city[1];

            //Ensure that before writing to provincePropertyJS the formType 2200A is traceable in cityStr
            if (cityStr.indexOf('2200C') >= 0) {
                var cityValues = cityStr.split('~');
                var regionCode = cityValues[0];
                var provinceCode = cityValues[1];
                var cityCode = cityValues[2];
                var description = cityValues[3];

                var objCity = new cityPropertyJS(regionCode, provinceCode, cityCode, description);
                cityList[k] = objCity;
                k++;
                //alert('2200A successfully created array #'+i);

            } else {
                //alert('2200A not found in array #'+i);
                continue;
            }
        }
    }

    function loadProvince() {
        /*This will load data onto an array*/
        var response = d.getElementById("responseProvince");

        var provinceCnt = String(response.innerHTML).split('provinceCount=');
        provinceCount = provinceCnt[1];

        var k = 0;
        //loads provinceList from xml
        for (var i = 1; i <= provinceCount; i++) {

            var province = String(response.innerHTML).split('province' + i + ':');
            var provinceStr = province[1];

            //Ensure that before writing to provincePropertyJS the formType 2200A is traceable in provinceStr
            if (provinceStr.indexOf('2200C') >= 0) {
                var provinceValues = provinceStr.split('~');
                var regionCode = provinceValues[0];
                var provinceCode = provinceValues[1];
                var description = provinceValues[2];

                var objProvince = new provincePropertyJS(regionCode, provinceCode, description);
                provinceList[k] = objProvince;
                k++;
                //alert('2200A successfully created array #'+i);

            } else {
                //alert('2200A not found in array #'+i);
                continue;
            }
        }
    }

    function loadRegion() {
        /*This will load data onto an array*/
        var response = d.getElementById("responseRegion");

        var regionCnt = String(response.innerHTML).split('regionCount=');
        regionCount = regionCnt[1];

        var k = 0;
        //loads regionList from xml
        for (var i = 1; i <= regionCount; i++) {

            var region = String(response.innerHTML).split('region' + i + ':');
            var regionStr = region[1];

            //Ensure that before writing to regionPropertyJS the formType 2200A is traceable in regionStr
            if (regionStr.indexOf('2200C') >= 0) {
                var regionValues = regionStr.split('~');
                var regionCode = regionValues[0];
                var description = regionValues[1];

                var objRegion = new regionPropertyJS(regionCode, description);
                regionList[k] = objRegion;
                k++;
                //alert('2200A successfully created array #'+i);

            } else {
                //alert('2200A not found in array #'+i);
                continue;
            }
        }
    }

    function regionPropertyJS(regionCode, description) {
        this.regionCode = regionCode;
        this.description = description;
    }

    function provincePropertyJS(regionCode, provinceCode, description) {
        this.regionCode = regionCode;
        this.provinceCode = provinceCode;
        this.description = description;
    }

    function cityPropertyJS(regionCode, provinceCode, cityCode, description) {
        this.regionCode = regionCode;
        this.provinceCode = provinceCode;
        this.cityCode = cityCode;
        this.description = description;
    }

