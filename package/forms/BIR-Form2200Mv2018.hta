    function isFieldEmpty(field){
        if(field.value != ''){
            this.value = round(field);
        }
    }

    function getFieldRowNum(id){
        var IDArr = id.split('');
        var secondToTheLastIndex = IDArr[IDArr.length - 2];
        var lastIndex = IDArr[IDArr.length - 1];

        if(secondToTheLastIndex > 0){
            return secondToTheLastIndex + lastIndex;
        }
        return lastIndex;
    }

    function loadRow(){
        var fixedRow = 7;
        var lastRow = d.getElementById('sched1Description').rows.length + fixedRow;
        sched1RowTemplate(lastRow); 
    }

  
    function addRowSched1(){
        var fixedRow = 7;
        var addedRowCount = d.getElementById('frm2200M:sched1AddedRowCount').value * 1;
        var lastRow = d.getElementById('sched1Description').rows.length + fixedRow;

        if(!isPrevRowValid(lastRow-1)){
            return false;
        }

        if(isPrevRowValid(lastRow)){
            sched1RowTemplate(lastRow);
            d.getElementById('frm2200M:sched1AddedRowCount').value = addedRowCount + 1;
        }
    }

    function delRowSched1(){
        var row = 0;
        var addedRowCount = d.getElementById('frm2200M:sched1AddedRowCount').value * 1;

        $('input[id^=frm2200M\\:chkBoxSched1Description]').each(function () {
            if($(this).is(':checked')){
                row = getFieldRowNum(this.id);
                if(row == 9 || row == 10){
                    alert('Row # '+ row + ' cannot be deleted');
                }else{
                    sched1TableDeleteRow(row);
                    d.getElementById('frm2200M:sched1AddedRowCount').value = addedRowCount - 1;
                }
            }
        });
        reArrangeId()
    }

    function sched1TableDeleteRow(row){

        //Table 1
        $('#frm2200M\\:txtSched1ATC'+row).closest('.row').remove();
        $('#frm2200M\\:chkBoxSched1Description'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_description'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_PlaceOfRemoval'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_VOMRITaxableA'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_VOMRIExemptB'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_LocallyExtractedRateC'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_LocallyExtractedRateD'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_LocallyExtractedTaxRateE'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_LocallyExtractedTaxDueF'+row).closest('.row').remove();

        //Table 2 Continuation
        $('#frm2200M\\:txtSched1_descriptionCont'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_ImportedTaxableG'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_ImportedExemptH'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_ImportedTaxRate'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_ImportedTaxDue'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_TaxDueAdjustment'+row).closest('.row').remove();
        $('#frm2200M\\:txtSched1_TotalTaxDue'+row).closest('.row').remove();


    }

    function sched1RowTemplate(lastRow)
    {
        var row = lastRow + 1;
        
        //Table 1
        $('#sched1ATC').append("<span class='row' style='display: none;'><input id='frm2200M:txtSched1ATC"+ row +"'name='frm2200M:txtSched1ATC10"+ row +"'type='text' value='XM060' style='width: 90%;text-align: center; font-size: 8pt' align='middle'/></span>");
        $('#sched1Description').append("<tr class='row'><td><table class='RowSubTable, tblForm'><tr><td style='width: 10%'><input type='checkbox' id='frm2200M:chkBoxSched1Description"+ row +"'name='frm2200M:chkBoxSched1Description"+ row +"'value=''/></td><td><input id='frm2200M:txtSched1_description"+ row +"'name='frm2200M:txtSched1_description"+ row +"'type='text' onblur='capitalize(this); populateTable2Desc(this);' maxlength='20' style='width: 90%; text-align: center; font-size: 8pt' align='middle'/></td></tr></table></td></tr>");
        $('#Sched1PlaceOfRemoval').append("<tr class='row'><td><input id='frm2200M:txtSched1_PlaceOfRemoval"+ row +"'name='frm2200M:txtSched1_PlaceOfRemoval"+ row +"'type='text' onblur='return capitalize(this);' maxlength='20' style='width: 98%;text-align: center; font-size: 8pt' align='middle'/></td></tr>");
        $('#sched1VOMRITaxable').append("<tr class='row'><td><input id='frm2200M:txtSched1_VOMRITaxableA"+ row +"'name='frm2200M:txtSched1_VOMRITaxableA"+ row +"'type='text' onblur='isFieldEmpty(this);' onkeypress='return numbersonly(this, event)' maxlength='20' style='width: 90%; text-align: center; font-size: 8pt' /></td></tr>");
        $('#sched1VOMRITExempt').append("<tr class='row'><td><input id='frm2200M:txtSched1_VOMRIExemptB"+ row +"'name='frm2200M:txtSched1_VOMRIExemptB"+ row +"'type='text' onblur='isFieldEmpty(this);' onkeypress='return numbersonly(this, event)' maxlength='20' style='width: 90%; text-align: center; font-size: 8pt' /></td></tr>");
        $('#sched1LocalExtractedRateC').append("<tr class='row'><td><input id='frm2200M:txtSched1_LocallyExtractedRateC"+ row +"'name='frm2200M:txtSched1_LocallyExtractedRateC"+ row +"'type='text' onblur='isFieldEmpty(this);' onkeypress='return numbersonly(this, event)' maxlength='20' style='width: 90%; text-align: center; font-size: 8pt' /></td></tr>");
        $('#sched1LocalExtractedRateD').append("<tr class='row'><td><input id='frm2200M:txtSched1_LocallyExtractedRateD"+ row +"'name='frm2200M:txtSched1_LocallyExtractedRateD"+ row +"'type='text' onblur='isFieldEmpty(this);' onkeypress='return numbersonly(this, event)' maxlength='20' style='width: 90%; text-align: center; font-size: 8pt' /></td></tr>");
        $('#sched1LocalExtractedTaxRate').append("<tr class='row'><td><input id='frm2200M:txtSched1_LocallyExtractedTaxRateE"+ row +"'name='frm2200M:txtSched1_LocallyExtractedTaxRateE"+ row +"'type='text' onblur='isFieldEmpty(this);' onkeypress='return numbersonly(this, event)' maxlength='20' style='width: 90%; text-align: center; font-size: 8pt' /></td></tr>");
        $('#sched1LocalExtractedTaxDue').append("<tr class='row'><td> <input id='frm2200M:txtSched1_LocallyExtractedTaxDueF"+ row +"'name='frm2200M:txtSched1_LocallyExtractedTaxDueF"+ row +"'type='text' onblur='isFieldEmpty(this); computeTotalTaxDue();' onkeypress='return numbersonly(this, event)' maxlength='20' style='width: 90%; text-align: center; font-size: 8pt' />  </td></tr>");
		
        //Table 2 - Continuation
        $('#sched1ContDescription').append("<tr class='row'><td><input id='frm2200M:txtSched1_descriptionCont"+ row +"'name='frm2200M:txtSched1_descriptionCont"+ row +"'type='text' maxlength='20' style='width: 90%; text-align: center; font-size: 8pt' align='middle' disabled='disable'/></td></tr>");
