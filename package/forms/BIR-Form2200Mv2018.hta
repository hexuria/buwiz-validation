    function rdoPropertyJS(rdoCode, description) {
        this.rdoCode = rdoCode;
        this.description = description;
    }

    function getRdo() {

        var data = "<select id='frm2200M:rdoPg1Pt1I6RDO' name='frm2200M:rdoPg1Pt1I6RDO' size='1'><option value='000'>000</option>";

        for (var i = 0; i < rdoList.length; i++) {
            var rdo = rdoList[i];
            data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";
        }
        data = data + "</select>"

        //var data = "<select id='frm2200M:rdoPg1Pt1I6RDO' name='frm2200M:rdoPg1Pt1I6RDO' size='1'><option value='000'> </option>";
        $('#rdoContainer').html(data);

    }

    // load profile.xml
    function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = "";
            } else {
                var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag            
            }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug                
            loadBGData(); /*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = "";
        }
    }

    // load data on controls based on profile.xml
    function loadBGData() {
        /*This will load data onto Background Information fields*/
        var responseBG = d.getElementById("responseBG");

        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '2200Mv2018') {
            var fnVal = String(responseBG.innerHTML).split('fn=');
            d.getElementById('frm2200M:txtPg1Pt1I6RegisteredName').value = unescape(fnVal[1]).toUpperCase();

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            //d.getElementById('frm2200M:txtPg1TIN1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            // d.getElementById('frm2200M:txtPg1TIN2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            //d.getElementById('frm2200M:txtPg1TIN3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            //d.getElementById('frm2200M:txtPg1TIN4').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm2200M:txtPg1I5RDO').value = rdoVal[1];

            if (rdoVal != "") {
                $('select[id="frm2200M:rdoPg1Pt1I6RDO"] option[value = ' + rdoVal[1] + ']').attr("selected", "selected");
                document.getElementById("frm2200M:rdoPg1Pt1I6RDO").disabled = true;
            }

            //            var data = "<select id='frm2200M:rdoPg1Pt1I6RDO' name='frm2200M:rdoPg1Pt1I6RDO' disabled='disabled' size='1'><option value='" + rdoVal[1] + "' selected>" + rdoVal[1] + "</option>";
            //            $('#rdoContainer').html(data);
            //if(rdoVal != "")
            //d.getElementById('frm2200M:rdoPg1Pt1I6RDO').value = rdoVal;

            // Store the value of Main Line of Business for the parent window (frm2200M:txtPg1Pt1I13MainLine)
            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm2200M:txtLOB').value = unescape(lobVal[1]);

            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
            regAddrVal[1] = unescape(regAddrVal[1].substring(0, regAddrVal[1].length));
            //if (regAddrVal[1].length > 80 && regAddrVal[1].length <= 160) {
			if (regAddrVal[1].length > 80) {
                d.getElementById('frm2200M:txtPg1Pt1I7RegisteredAddress').value = regAddrVal[1].substring(0, 80);
                //d.getElementById('frm2200M:txtPg1Pt1I7RegisteredAddress2').value = regAddrVal[1].substring(80, regAddrVal[1].length);
				d.getElementById('frm2200M:txtPg1Pt1I7RegisteredAddress2').value = regAddrVal[1].substring(80, 160);
            }
            else if (regAddrVal[1].length <= 80) {
                d.getElementById('frm2200M:txtPg1Pt1I7RegisteredAddress').value = regAddrVal[1];   
                d.getElementById('frm2200M:txtPg1Pt1I7RegisteredAddress2').value = "";
            }

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            d.getElementById('frm2200M:txtPg1Pt1I8ContactNumber').value = telNoVal[1];

            var zipVal = String(responseBG.innerHTML).split('zip=');
            document.getElementById('frm2200M:txPg1I7ZipCode').value = zipVal[1];
            p3TPZip = zipVal[1];

            if (rdoVal[1] == "000") {
                d.getElementById('frm2200M:rdoPg1Pt1I6RDO').disabled = false;
            }
                        
            //set TIN & TaxFiler's Name across the page
            var TIN1 = d.getElementsByName('frm2200M:TIN1');
            var TIN2 = d.getElementsByName('frm2200M:TIN2');
            var TIN3 = d.getElementsByName('frm2200M:TIN3');
            var TIN4 = d.getElementsByName('frm2200M:TIN4');
            TaxFiler = d.getElementsByName('frm2200M:RegName');

            for (var i = 0; i < TIN1.length; i++) {
                TIN1[i].value = tin1Val[1];
                TIN2[i].value = tin2Val[1];
                TIN3[i].value = tin3Val[1];
                TIN4[i].value = tin4Val[1];
               // TaxFiler[i].value = fnVal[1].toUpperCase();
            }
        }
        var emailVal = String(responseBG.innerHTML).split('email=');
            if(emailVal[1] === undefined)
            {
                document.getElementById('frm2200M:txtPg1Pt1I9Email').value = "";
            }
            else
            {
                document.getElementById('frm2200M:txtPg1Pt1I9Email').value = emailVal[1];
                globalEmail = emailVal[1];
            }
    }

