		txtPg5S4I39Col2,
		otherList,
		getAmount("frm2200M:txtPg5S4I40TotalAllowableDeduction"));

		var txtPg3Pt6S2I4Col2 = getValue("frm2200M:txtPg3Pt6S2I4LegalBasis");
		var txtPg3Pt6S2I4Col3 = getAmount("frm2200M:txtPg3Pt6S2I4Amount");
		//Schedule5 Iteration
		var i = Pg3Pt6S2I4_Col1.length;
		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfSpecialAllowableItemizedDeductions(Pg3Pt6S2I4_Col1[x], Pg3Pt6S2I4_Col2[x], fixAmount(Pg3Pt6S2I4_Col3[x]));
			}
			txtPg3Pt6S2I4Col1 = Pg3Pt6S2I4_Col1[0];
			txtPg3Pt6S2I4Col2 = Pg3Pt6S2I4_Col2[0];
			txtPg3Pt6S2I4Col3 = fixAmount(Pg3Pt6S2I4_Col3[0]);
		}
		//Schedule5 
		populateSchedule5(getValue("frm2200M:txtPg3Pt6S2I1Description"),
        getValue("frm2200M:txtPg3Pt6S2I1LegalBasis"),
        getAmount("frm2200M:txtPg3Pt6S2I1Amount"),

        getValue("frm2200M:txtPg3Pt6S2I2Description"),
        getValue("frm2200M:txtPg3Pt6S2I2LegalBasis"),
        getAmount("frm2200M:txtPg3Pt6S2I2Amount"),

        getValue("frm2200M:txtPg3Pt6S2I3Description"),
        getValue("frm2200M:txtPg3Pt6S2I3LegalBasis"),
        getAmount("frm2200M:txtPg3Pt6S2I3Amount"),

        txtPg3Pt6S2I4Col1,
        txtPg3Pt6S2I4Col2,
        txtPg3Pt6S2I4Col3,

        getAmount("frm2200M:txtPg5S5I5TotalAllowable"),
        specialAllowableItemizedDeductionsList);


		var txtPg3Pt6S3I3Col2 = getAmount("frm2200M:txtPg3Pt6S3I3Col2");
		//Schedule6 non-deductible expense Iteration
		var i = Pg3Pt6S3I3_Col1.length;
		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfNonDeductibleExpensesItem(Pg3Pt6S3I3_Col1[x], fixAmount(Pg3Pt6S3I3_Col2[x]));
			}
			txtPg3Pt6S3I3Col1 = Pg3Pt6S3I3_Col1[0];
			txtPg3Pt6S3I3Col2 = fixAmount(Pg3Pt6S3I3_Col2[0]);
		}

		var txtPg3Pt6S3I6Col1 = getValue("frm2200M:txtPg3Pt6S3I6Col1");
		//Schedule6 non-taxable Income Iteration
		var i = Pg3Pt6S3I6_Col1.length;
		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfNonTaxableAndSpDeductionsItem(Pg3Pt6S3I6_Col1[x], fixAmount(Pg3Pt6S3I6_Col2[x]));
			}
			txtPg3Pt6S3I6Col1 = Pg3Pt6S3I6_Col1[0];
			txtPg3Pt6S3I6Col2 = fixAmount(Pg3Pt6S3I6_Col2[0]);
		}

		var txtPg3Pt6S3I8Col1 = getValue("frm2200M:txtPg3Pt6S3I8Col1");
		//Schedule6 special deductions Iteration
		var i = Pg3Pt6S3I8_Col1.length;
		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfSpecialDeductionsItem(Pg3Pt6S3I8_Col1[x], fixAmount(Pg3Pt6S3I8_Col2[x]));
			}
			txtPg3Pt6S3I8Col1 = Pg3Pt6S3I8_Col1[0];
			txtPg3Pt6S3I8Col2 = fixAmount(Pg3Pt6S3I8_Col2[0]);
		}

		execute();
		initSoap();
        }
        else {
            alert("No internet connection detected. Submit the form again.");
            initSoap();
        }

    }

    function initSoap() {
        taxpayer = {};
        totalTaxPayable = {};
        // Page 2
        ComputationOfTaxBean = {};
        taxReliefAvailment = {};
        externalAuditorAccreditedTaxAgentBean = {};
        // Page 3
        salesRevenueBean = {};
