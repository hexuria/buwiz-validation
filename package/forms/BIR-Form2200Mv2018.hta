        getAmount("frm2200M:txtPg3S2I4LessMerch"),
        getAmount("frm2200M:txtPg3S2I5CostSales"),
        getAmount("frm2200M:txtPg3S2I6DirectMaterials"),
        getAmount("frm2200M:txtPg3S2I7AddPurchases"),
        getAmount("frm2200M:txtPg3S2I8MaterialsAvailable"),
        getAmount("frm2200M:txtPg3S2I9DirectMaterials"),
        getAmount("frm2200M:txtPg3S2I10RawMaterials"),
        getAmount("frm2200M:txtPg3S2I11DirectLabor"),
        getAmount("frm2200M:txtPg3S2I12ManOverhead"),
        getAmount("frm2200M:txtPg3S2I13TotalMan"),
        getAmount("frm2200M:txtPg3S2I14WorkProcess"),
        getAmount("frm2200M:txtPg3S2I15LessWork"),
        getAmount("frm2200M:txtPg3S2I16CostOfGoods"),
        getAmount("frm2200M:txtPg3S2I17FinishedGoods"),
        getAmount("frm2200M:txtPg3S2I18LessFinished"),
        getAmount("frm2200M:txtPg3S2I19GoodsManAndSold"),
        getAmount("frm2200M:txtPg3S2I20DirectWage"),
        getAmount("frm2200M:txtPg3S2I21DirectMaterials"),
        getAmount("frm2200M:txtPg3S2I22DirectDepreciation"),
        getAmount("frm2200M:txtPg3S2I23DirectRental"),
        getAmount("frm2200M:txtPg3S2I24DirectOutside"),
        getAmount("frm2200M:txtPg3S2I25DirectOthers"),
        getAmount("frm2200M:txtPg3S2I26TotalCostServices"),
        getAmount("frm2200M:txtPg3S2I27TotalCostSales"));

		var txtPg3Pt6S1I17Col1 = getValue("frm2200M:txtPg3Pt6I17OthersIDesc");
		//Schedule4P1 Iteration
		var i = Pg3Pt6S1I17_Col1.length;

		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfAmortization(Pg3Pt6S1I17_Col1[x], fixAmount(Pg3Pt6S1I17_Col2[x]));
			}
			txtPg3Pt6S1I17Col1 = Pg3Pt6S1I17_Col1[0];
			txtPg3Pt6S1I17Col2 = fixAmount(Pg3Pt6S1I17_Col2[0]);
		}
		var txtPg5S4I39Col1 = getValue("frm2200M:txtPg5S4I39Col1");
		//Schedule4P2 Iteration
		var i = Pg5S4I39_Col1.length;
		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfOthers(Pg5S4I39_Col1[x], fixAmount(Pg5S4I39_Col2[x]));
			}
			txtPg5S4I39Col1 = Pg5S4I39_Col1[0];
			txtPg5S4I39Col2 = fixAmount(Pg5S4I39_Col2[0]);
		}
		//Schedule4
