        getValue("frm2200M:txtPg2Pt6I46TinC4"),
        getValue("frm2200M:txtPg2Pt6I48TinC4"));

            //Schedule1                     
            populateSalesRevenueBean(getAmount("frm2200M:txtPg3S1I1GoodsProp"),
        getAmount("frm2200M:txtPg3S1I2SaleServices"),
