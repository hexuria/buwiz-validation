    function isPrevRowValid(currRow){
        var row = currRow;
        var fieldsArr = [];

        var description = d.getElementById('frm2200M:txtSched1_description' +row).value;
        var PlaceofRemoval = d.getElementById('frm2200M:txtSched1_PlaceOfRemoval' +row).value;
        var VOMRITaxableA = d.getElementById('frm2200M:txtSched1_VOMRITaxableA' +row).value;
        var VOMRIExemptB = d.getElementById('frm2200M:txtSched1_VOMRIExemptB' +row).value;
        var LocallyExtractedRateC = d.getElementById('frm2200M:txtSched1_LocallyExtractedRateC' +row).value;
        var LocallyExtractedRateD = d.getElementById('frm2200M:txtSched1_LocallyExtractedRateD' +row).value;
        var LocallyExtractedTaxRateE = d.getElementById('frm2200M:txtSched1_LocallyExtractedTaxRateE' +row).value;
        var LocallyExtractedTaxDueF = d.getElementById('frm2200M:txtSched1_LocallyExtractedTaxDueF' +row).value;
        var ImportedTaxableG = d.getElementById('frm2200M:txtSched1_ImportedTaxableG' +row).value;
        var ImportedExemptH = d.getElementById('frm2200M:txtSched1_ImportedExemptH' +row).value;
        var ImportedTaxRate = d.getElementById('frm2200M:txtSched1_ImportedTaxRate' +row).value;
        var ImportedTaxDue = d.getElementById('frm2200M:txtSched1_ImportedTaxDue' +row).value;
        var TaxDueAdjustment = d.getElementById('frm2200M:txtSched1_TaxDueAdjustment' +row).value;
        var TotalTaxDue = d.getElementById('frm2200M:txtSched1_TotalTaxDue' +row).value;

        if(description == ''){
            alert("Description is required in row #"+row);
            return false;
        }

        fieldsArr = [PlaceofRemoval, VOMRITaxableA, VOMRIExemptB, LocallyExtractedRateC, LocallyExtractedRateD, LocallyExtractedTaxDueF, ImportedTaxableG,ImportedExemptH, ImportedTaxDue, TaxDueAdjustment, TotalTaxDue, LocallyExtractedTaxRateE, ImportedTaxRate];

        if(!checkPartVRow(fieldsArr, row)) return false;

        return true;
    }

