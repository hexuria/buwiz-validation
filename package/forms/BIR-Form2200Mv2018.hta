    function validate() {

        if (validateAll()) {
            alert("Validation successful. Click on Edit if you wish to modify your entries.");
            getDisabledText();
            disableAllControl();
            document.getElementById("frm2200M:btnEdit").disabled = false;
            document.getElementById("btnUpload").disabled = false;
            document.getElementById("frm2200M:btnFinalCopy").disabled = false;
            document.getElementById("frm2200M:btnValidate").disabled = true;
            document.getElementById("frm2200M:btnPrevPage").disabled = false;
            document.getElementById("frm2200M:btnNextPage").disabled = false;
            document.getElementById("btnSave").disabled = false;
            document.getElementById("btnPrint").disabled = false;
            document.getElementById("btnCancelSubmit").disabled = false;
            document.getElementById("CloseGuidlinesPage").disabled = false;    
            d.getElementById('mnuPrint').disabled = false;
            document.getElementById("ebironline").disabled = false;
            document.getElementById("efps").disabled = false;
            //document.onmouseup();
            return;
        }
        else {
            document.getElementById("frm2200M:btnEdit").disabled = true;
            document.getElementById("btnUpload").disabled = true;
            document.getElementById("frm2200M:btnFinalCopy").disabled = true;
            document.getElementById("btnPrint").disabled = true;
            d.getElementById('mnuPrint').disabled = true;
        };
        
    }

    function initialValidateBeforeSave() {
        //validation here
        //return true to save
		if (d.getElementById('frm2200M:txtPg1I1Month').value === "" || d.getElementById('frm2200M:txtPg1I1Month').value === "00" ||
			d.getElementById('frm2200M:txtPg1I1Day').value === "" || d.getElementById('frm2200M:txtPg1I1Day').value === "00" || d.getElementById('frm2200M:txtPg1I1Year').value === "") { alert("Please enter correct date on Item 1."); return false; }
		if (!validateDate()) {return false; }


		if (d.getElementById('frm2200M:rdoPg1Pt1I6RDO').value === "000") { alert("Please enter a valid RDO Code on Item 6."); return false; }
        if (!checkMandatory("frm2200M:txtPg1Pt1I6RegisteredName", "Please enter a valid name on Page 1 Item 7.")) return false;
        if (!checkMandatory("frm2200M:txtPg1Pt1I7RegisteredAddress", "Please enter a valid Registered Address on Page 1 Item 8.")) return false;
        if (!checkMandatory("frm2200M:txtPg1Pt1I8ContactNumber", "Please enter a valid Contact Number on Page 1 Item 9.")) return false;

        return true;
    }

    //topNav
    $(document).ready(function () {

        $("ul.subnav").parent().append("<span></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)  
        $("ul.topnav li span").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
        $("ul.topnav .toplevel").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
    });


    function createXMLProfileName() {
        try {
            var xmlFileName = "";

            var titleTin1 = d.getElementById('frm2200M:txtPg1TIN1');
            var titleTin2 = d.getElementById('frm2200M:txtPg1TIN2');
            var titleTin3 = d.getElementById('frm2200M:txtPg1TIN3');
            var titleBranchCode = d.getElementById('frm2200M:txtPg1TIN4');
            var titleTPName = d.getElementById('frm2200M:txtPg1Pt1I6RegisteredName');
            var formType = "2200Mv2018";

            xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";

            return xmlFileName;
        } catch (e) {
            alert('Exception : ' + e.description);
        }
    }

    function saveXMLProfile(isFinalCopy) {
        if (gIsReadOnly == false) {
            var xmlFileName = createXMLProfileName();

            msg.innerHTML = 'Generating File...';
            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFile = fileSys.CreateTextFile(xmlFileName); //(saveWhere);

            var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break            

            allXML += "<div>fn=" + escape(d.getElementById('frm2200M:txtPg1Pt1I6RegisteredName').value) + "fn=</div>" + tab;
            allXML += "<div>tin2=" + d.getElementById('frm2200M:txtPg1TIN2').value + "tin2=</div>" + tab;
            allXML += "<div>tin3=" + d.getElementById('frm2200M:txtPg1TIN3').value + "tin3=</div>" + tab;
            allXML += "<div>tin1=" + d.getElementById('frm2200M:txtPg1TIN1').value + "tin1=</div>" + tab;
            allXML += "<div>tin4=" + d.getElementById('frm2200M:txtPg1TIN4').value + "tin4=</div>" + tab;
            allXML += "<div>rdo=" + d.getElementById('frm2200M:txtPg1I5RDO').value + "rdo=</div>" + tab;
            allXML += "<div>lob=" + d.getElementById('frm2200M:txtLOB').value + "lob=</div>" + tab;
            allXML += "<div>regAddr=" + escape(d.getElementById('frm2200M:txtPg1Pt1I7RegisteredAddress').value)
                                      //+ escape(d.getElementById('frm2200M:txtPg1Pt1I7RegisteredAddress2').value)
                                      + escape(d.getElementById('frm2200M:txtPg1Pt1I7RegisteredAddress2').value)+ "regAddr=</div>" + tab;

            //No Zip for 2200C, just get it from var p3TPZip
            allXML += "<div>zip=" + p3TPZip + "zip=</div>" + tab;

            allXML += "<div>telNo=" + d.getElementById('frm2200M:txtPg1Pt1I8ContactNumber').value + "telNo=</div>" + tab;
            allXML += "<div>email="+document.getElementById('frm2200M:txtPg1Pt1I9Email').value+"email=</div>"+tab;allXML += "<div>confirmemail="+document.getElementById('frm2200M:txtPg1Pt1I9Email').value+"confirmemail=</div>"+tab;
            allXML += "<div>confirmtin1=" + d.getElementById('frm2200M:txtPg1TIN1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm2200M:txtPg1TIN2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm2200M:txtPg1TIN3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm2200M:txtPg1TIN4').value + "confirmtin4=</div>" + tab;
            allXML += "<div>formType=2200Mv2018formType=</div>" + tab;

            allXML += tab + d.getElementById('xmlClose').innerHTML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (isFinalCopy == false) {
                alert('Background information saved/updated successfully as : ' + xmlFileName);
            }
        }
    }
