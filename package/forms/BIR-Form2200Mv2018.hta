					if (String(elem[i].id).indexOf('frm2200M:txtPg1Pt1I10Region') != -1 || String(elem[i].id).indexOf('frm2200M:txtPg1Pt1I10Province') != -1) {
                        elem[i].onchange();
                    }

                    if (String(elem[i].id).indexOf('frm2200M:txtPg1Pt1I11Region') != -1 || String(elem[i].id).indexOf('frm2200M:txtPg1Pt1I11Province') != -1) {
                        elem[i].onchange();
