        getValue("frm2200M:txtPg2Pt6I49BIRAccreditedNoC1") + getValue("frm2200M:txtPg2Pt6I49BIRAccreditedNoC2") + getValue("frm2200M:txtPg2Pt6I49BIRAccreditedNoC3") + getValue("frm2200M:txtPg2Pt6I49BIRAccreditedNoC4"),
        convertDateXML("txtPg2Pt6I50IssueDate"),
