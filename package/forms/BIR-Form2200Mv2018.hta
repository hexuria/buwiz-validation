<!--2200C validation -->
<script>

    //after xml populate

    //on validation click
    function validateAll() {
		var dateOkay = false;
        //empty mandatory
        if (d.getElementById('frm2200M:txtPg1I1Month').value == '00'){
			alert("Month field on Page 1 Item 1 is required.");
			dateOkay = false;
			return false;
		}
		else dateOkay = true;
		
		if (!checkMandatory("frm2200M:txtPg1I1Day", "Day field on Page 1 Item 1 is required.")){
			dateOkay = false;
			return false;
		}
		else dateOkay = true;
		
		if (!checkMandatory("frm2200M:txtPg1I1Year", "Year field on Page 1 Item 1 is required.")){
			dateOkay = false;
			return false;
		}
		else dateOkay = true;

		if (dateOkay && !validateDate()) return false;

        if (d.getElementById('frm2200M:txtPg1I5RDO').value === "000") { alert("Please enter a valid RDO Code on Page 1 Item 6."); return false; }
        if (!checkMandatory("frm2200M:txtPg1Pt1I6RegisteredName", "Name field on Page 1 Item 7 is required.")) return false;
        if (!checkMandatory("frm2200M:txtPg1Pt1I7RegisteredAddress", "Registered Address field on Page 1 Item 8 is required.")) return false;
        if (!checkMandatory("frm2200M:txPg1I7ZipCode", "Zip Code field on Page 1 Item 8A is required.")) return false;
        if (!checkMandatory("frm2200M:txtPg1Pt1I8ContactNumber", "Contact Number field on Page 1 Item 9 is required.")) return false;
        if (!checkMandatory("frm2200M:txtPg1Pt1I9Email", "E-mail address on page 1 item 10 is required.")) return false;
        //Place of Production
        if (d.getElementById('frm2200M:txtPg1Pt1I10Region').value === "00") { alert("Region field on Page 1 Item 10 (Place of Production) is required."); return false; }
		if (d.getElementById('frm2200M:txtPg1Pt1I10Province').value === "00") { alert("Province field on Page 1 Item 10 (Place of Production) is required."); return false; }
		if (d.getElementById('frm2200M:txtPg1Pt1I10City').value === "00") { alert("City field on Page 1 Item 10 (Place of Production) is required."); return false; }
        //Place of Removal
		if (d.getElementById('frm2200M:txtPg1Pt1I11Region').value === "00") { alert("Region field on Page 1 Item 11 (Place of Removal) is required."); return false; }
		if (d.getElementById('frm2200M:txtPg1Pt1I11Province').value === "00") { alert("Province field on Page 1 Item 11 (Place of Removal) is required."); return false; }
		if (d.getElementById('frm2200M:txtPg1Pt1I11City').value === "00") { alert("City field on Page 1 Item 11 (Place of Removal) is required."); return false; }

		if (d.getElementById('frm2200M:rdoPg1I12TaxReliefYes').checked == false &&
			d.getElementById('frm2200M:rdoPg1I12TaxReliefNo').checked == false) { 
			alert("Availing of Tax Relief field on Page 1 Item 12 is required."); 
			return false;
		}

		if (d.getElementById('frm2200M:rdoPg1I12TaxReliefYes').checked == true &&
			d.getElementById('frm2200M:txtPg1I12TaxReliefSpecify').value == ''){
			alert("Specify Tax Relief field on Page 1 Item 12A is required."); 
			return false;
		}

		if (d.getElementById('frm2200M:rdoPg1Pt2MOPPaymentActual').checked == false &&
			d.getElementById('frm2200M:rdoPg1Pt2MOPPrepayment').checked == false &&
			d.getElementById('frm2200M:rdoPg1Pt2MOPOther').checked == false) { 
			alert("Manner of Payment on Page 1 Part II is required."); 
			return false;
		}

		if (d.getElementById('frm2200M:rdoPg1Pt2MOPOther').checked == true &&
			d.getElementById('frm2200M:txtPg1Pt2MOPOtherDesc').value == ''){
			alert("Specfy Manner of Payment field on Page 1 Part II Item 15 is required."); 
			return false;
		}

        if((NumWithComma(d.getElementById("frm2200M:txtPg1P3I24BalToCarryOver").value) * 1) > 0){
            alert('YOU HAVE INSUFICIENT FUND. PLEASE APPLY DEPOSIT TO PROCEED');
            return false;
        }

		if (!checkPartVFields()) return false;

        return true;
    }


    function checkEmptyTIN(tin) {
        var isEmpty = false;
        var tinID = "frm2200M:" + tin;
        if (document.getElementById(tinID + "1").value == "" && document.getElementById(tinID + "2").value == "" && document.getElementById(tinID + "3").value == "" && document.getElementById(tinID + "4").value == "") {
            isEmpty = true;
            return true;
        }
        else if (document.getElementById(tinID + "1").value != "" || document.getElementById(tinID + "2").value != "" || document.getElementById(tinID + "3").value != "" || document.getElementById(tinID + "4").value != "") {
            isEmpty = false;
            return false;
        }
        // console.log(isEmpty);

    }
    function validateTIN(tin, msg, i) {

        var tinID = "frm2200M:" + tin;
        var isValid = true;
        if (document.getElementById(tinID + "1").value != "" || document.getElementById(tinID + "2").value != "" || document.getElementById(tinID + "3").value != "" || document.getElementById(tinID + "4").value != "") {

            if (document.getElementById(tinID + "1").value.length != document.getElementById(tinID + "1").getAttribute("maxlength") ||
                document.getElementById(tinID + "2").value.length != document.getElementById(tinID + "2").getAttribute("maxlength") ||
                document.getElementById(tinID + "3").value.length != document.getElementById(tinID + "3").getAttribute("maxlength") ||
                document.getElementById(tinID + "4").value.length != document.getElementById(tinID + "4").getAttribute("maxlength")) {
                alert('Please check TIN numbers on Page' + msg + i);
                isValid = false;
                return false;
            }

        }
        return isValid;
    }

    function checkMandatory(elem, msg) {
        var myMandatory = document.getElementById(elem).value;
        if ($.trim(myMandatory) == "") {
            alert(msg);
            return false;
        }
        else {
            return true;
        }
    }

