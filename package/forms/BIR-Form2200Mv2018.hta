        premium = {};
        // Page 7 Schedule 10I
        personalPropertyReceived = {};
        personalPropertyReceivedList = [];
        // Page 7 Schedule 10II
        otherExemptIncome = {};
        otherExemptIncomeList = [];
    }

</script>
