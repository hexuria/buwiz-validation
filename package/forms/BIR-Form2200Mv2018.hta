    function init() {

        //located in string-util.js
        getDrives();

		loadXMLRegion('xml/region.xml');
		getRegion();
        loadXMLrdo('xml/rdo.xml');
        getRdo();


        document.getElementById("frm2200M:btnEdit").disabled = true;
