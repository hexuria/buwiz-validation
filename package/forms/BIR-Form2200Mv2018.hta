    //    });

    $('input[maxlength="10"]').keydown(function () {
        dateMasking(this);
    });


    // Disable pasting
    $(document).ready(function () {
        $('input[id="frm2200M:txtPg1Pt2I23CommunityTax"], input[maxlength="3"], input[id*=frm2200M\\:txtPg2Pt6I49BIRAccreditedNo] ').bind('paste', function (e) {
