	<form id="frmMain" name="frmMain">
		<div id="container">
			<div id="wrapper" style="margin: 0 auto; position: relative; width: 926px;" >
				<div id = "formPaper">



					<div id="Page1Content">
						<table width="926" border="0" cellspacing="0" cellpadding="0">
							<tr>
								<td>
									<table width="800" border="0" cellspacing="0" cellpadding="0">
										<tr>
											<td width="300" valign="bottom"><p><img src="../img/bcs_new.png" width="80" /></p></td>
											<td><p><img src="../img/header_logo.png" width="210" height="50px" /></p></td>
										</tr>
									</table>
								</td>
							</tr>

							<tr>
								<td>
									<table width="800" border="1" cellspacing="0" cellpadding="0">
										<tr>
											<td width="120" valign="middle" style="text-align: center;">
												<font face="Arial" size="1px">BIR Form No.</font>
												<br/><font size="5px" style="font-weight:bold;">1621</font>
												<br/><font face="Arial" size="1px">January 2019</font>
												<br/><font face="Arial" size="1px" style="font-weight:bold;">Page 1</font>
											</td>
											<td width="0" valign="center" style="text-align: center;">
												<font size="5px" style="font-weight:bold;">Quarterly Remittance Return</font>
												<br/>
												<font size="3px" style="font-weight:bold;">
													of Tax Withheld on the Amount Withdrawin from<br/>
													Decedent's Deposit Account
												</font>
												<br/>
												<font face="Arial" size="1px">Enter all required information in CAPITAL LETTERS using BLACK ink. Mark all applicable boxes with<br/>an "X". Two copies MUST be filed with the BIR and one held by the Taxpayer.</font>
											</td>
											<td width="200" valign="center">
												<p><img src="../img/1621_BarCode/1621_p1.png" width="220" height="75px" /> </p>
											</td>
										</tr>
									</table>
								</td>
							</tr>

							<tr>
								<td>
									<table width="920" border="0" cellspacing="0" cellpadding="0" class="tblForm">
										<tr>
											<td width="10%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td>
															<font size="2" style="font-weight:bold;">&nbsp;1</font>
															<font size="1">For the Year</font>
														</td>
													</tr>
													<tr>
														<td align="center">
															<input type="text" value="" size="5" name="frm1621:txtYear" maxlength="4" id="frm1621:txtYear" onkeypress="return wholenumber(this, event)" onblur="blockletterWithout2Decimal(this);ValidateYear(this);"/>
														</td>
													</tr>
												</table>
											</td>

											<td width="35%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td>
															<font size="2" style="font-weight:bold;">&nbsp;2</font>
															<font size="1">Quarter</font>
														</td>
													</tr>
													<tr>
														<td style="text-align:center">
															<table border="0" cellpadding="0" cellspacing="0" class="iceSelOneRb-dis fieldText1-dis">
																<tr>
																	<td>
																		<input type="radio" value="1" name="frm1621:quarter" id="frm1621:quarter_1" />
																		<font size="1">1st</font>
																	</td>
																	<td>
																		<input type="radio" value="2" name="frm1621:quarter" id="frm1621:quarter_2" />
																		<font size="1">2nd</font>
																	</td>
																	<td>
																		<input type="radio" value="3" name="frm1621:quarter" id="frm1621:quarter_3" />
																		<font size="1">3rd</font>
																	</td>
																	<td>
																		<input type="radio" value="4" name="frm1621:quarter" id="frm1621:quarter_4" />
																		<font size="1">4th</font>
																	</td>
																</tr>
															</table>
														</td>
													</tr>
												</table>
											</td>

											<td width="20%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td>
															<font size="2" style="font-weight:bold;">&nbsp;3</font>
															<font size="1">Amended Return?</font>
														</td>
													</tr>
													<tr>
														<td style="text-align:center">
															<table border="0" cellpadding="0" cellspacing="0" class="iceSelOneRb-dis fieldText1-dis">
																<tr>
																	<td>
																		<input type="radio" value="Y" name="frm1621:amendedRtn" id="frm1621:amendedRtn_1" onclick="onAmendedClick()" />
																		<font size="1">Yes</font>
																		&nbsp;&nbsp;&nbsp;
																	</td>
																	<td>
																		<input type="radio" value="N" name="frm1621:amendedRtn" id="frm1621:amendedRtn_2" onclick="onAmendedClick()" checked="checked" />
																		<font size="1">No</font>
																	</td>
																</tr>
															</table>
														</td>
													</tr>
												</table>
											</td>

											<td width="20%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td>
															<font size="2" style="font-weight:bold;">&nbsp;4</font>
															<font size="1">Any Taxes Withheld?</font>
														</td>
													</tr>
													<tr>
														<td style="text-align:center">
															<table border="0" cellpadding="0" cellspacing="0" class="iceSelOneRb-dis fieldText1-dis">
																<tr>
																	<td>
																		<input type="radio" value="Y" name="frm1621:taxWithheld" id="frm1621:taxWithheld_1" onclick="enableSched1Fields()" />
																		<font size="1">Yes</font>
																		&nbsp;&nbsp;&nbsp;
																	</td>
																	<td>
																		<input type="radio" value="N" name="frm1621:taxWithheld" id="frm1621:taxWithheld_2" onclick="enableSched1Fields()" checked="checked" />
																		<font size="1">No</font>
																	</td>
																</tr>
															</table>
														</td>
													</tr>
												</table>
											</td>

											<td width="15%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td>
															<font size="2" style="font-weight:bold;">&nbsp;5</font>
															<font size="1">No. of Sheets Attached</font>
														</td>
													</tr>
													<tr>
														<td align="center">
															<input type="text" value="0" style="text-align: right;" size="4" name="frm1621:txtSheets" maxlength="2" id="frm1621:txtSheets" class="iceInpTxt-dis" onkeypress="return wholenumber(this, event)" />
														</td>
													</tr>
												</table>
											</td>
										</tr>
									</table>
								</td>
							</tr>
							<tr>
								<td>

									<table border="0" cellspacing="0" cellpadding="0" class="tblForm">
										<tr><td class="tblFormTdPart"></td></tr>
										<tr>
											<td class="tblFormTdPart">
												<div align="center">
													<font face="Arial, Helvetica, sans-serif" size="1.5px">
														<b>Part I - Background Information</b></font>
												</div>
											</td>
										</tr>
									</table>
								</td>
							</tr>
							<tr>
								<td>
									<table width="920" border="0" cellpadding="0" cellspacing="0" class="tblForm">
										<tr>
											<td width="70%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td width="11"><font size="2" style="font-weight:bold">&nbsp;6&nbsp;</font></td>
														<td>
															<font size="1">Taxpayer Identification Number (TIN)&nbsp;</font>
															<font size="2" face="Arial">
																<input type="text" value="" size="2" name="frm1621:tinA" maxlength="3" id="frm1621:tinA" onkeypress="return wholenumber(this, event)" />
																<input type="text" value="" size="2" name="frm1621:tinB" maxlength="3" id="frm1621:tinB" onkeypress="return wholenumber(this, event)" />
																<input type="text" value="" size="2" name="frm1621:tinC" maxlength="3" id="frm1621:tinC" onkeypress="return wholenumber(this, event)" />
																<input type="text" value="" size="2" name="frm1621:branchCode" maxlength="5" id="frm1621:branchCode" onkeypress="return letternumber(event)" />
															</font>
														</td>
													</tr>
												</table>
											</td>
											<td width="30%" valign="top" class="tblFormTd">
												<table width="100%" border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td width="80"><font size="2" style="font-weight:bold">&nbsp;7&nbsp;</font><font size="1">RDO Code&nbsp;</font></td>
														<td id="rdoSelect"></td>
													</tr>
												</table>
											</td>
										</tr>
									</table>
								</td>
							</tr>
							<tr>
								<td>
									<table width="920" border="0" cellspacing="0" cellpadding="0" class="tblForm">
										<tr>
											<td width="100%" valign="top" class="tblFormTd">
												<table border="0" cellpadding="0" cellspacing="0">
													<tr>
														<td>
															<table border="0" cellspacing="0" cellpadding="0">
																<tr>
																	<td><font size="2" style="font-weight:bold;">&nbsp;8&nbsp;</font></td>
																	<td><font size="1">Withholding Agent's Name (Last Name, First Name, Middle Name for Individuals OR Registered Name for Non-Individuals)</font></td>
																</tr>
															</table>
														</td>
													</tr>
													<tr>
														<td>
															<table border="0" cellspacing="0" cellpadding="0">
																<tr>
																	<td width="2x`">&nbsp;</td>
																	<td><input type="text" value="" size="125" name="frm1621:registeredName" maxlength="70" id="frm1621:registeredName" style="text-transform: uppercase;" onblur="return capital(this, event)" /></td>
																</tr>
															</table>
