	function uploadXMLFile () {
		var binDataURL;

		//Dev Note: frmMainSrc contains the HTML and content of the form
		//frmMainSrc should get the print preview version
		// $('#frmMain').html(); //content of the loop
		printme();

		if (savedReturn != null && savedReturn.length > 0) {
			var intervalCnt = 1000;

			var xmlFileForUpload = savedReturn.replace(/&nbsp;/g,"<span style='padding-left:0.25em'> </span>");
			xmlFileForUpload = xmlFileForUpload.replace(/&amp;/g,"AND");
			xmlFileForUpload = xmlFileForUpload.replace(/&/g,"_AND_");
			xmlFileForUpload = xmlFileForUpload.replace(/\+/g,"_PLUS_");
			var savedReturnLen = xmlFileForUpload.length;

			//Loop Begin - create submit_return_data records, related to Created Upload File -
			var numOfSRLoops = Math.ceil(savedReturnLen*1 / intervalCnt);
			var loopSRCnt = numOfSRLoops+1;
			var startSRPost = 0;
			var endSRPost = intervalCnt;
			var partSRCnt = 1;

			for(var i = 0; i < numOfSRLoops; i++) {

				binDataURL = rbURL + "/rest/api/create2?sessionId="+sessionId+"&objName=submit_return_data&useIds=false&index_="+partSRCnt+"&name=1621_part"+partSRCnt+"&R95607586="+create2Id+"&content="+xmlFileForUpload.substring(startSRPost, endSRPost);
				var binDataUploadXML = new XMLHttpRequest();
				// binDataUploadXML.open( "GET", encodeURI(binDataURL) , false);
				// binDataUploadXML.send(null);

				binDataUploadXML.open( "POST", encodeURI(binDataURL) , false);
				binDataUploadXML.send();

				//xmlFn.writeLine(xmlFileInBase64.substring(startSRPost, endSRPost)+"\n\ncompleted\n\n");
				//alert('i = '+i+' startSRPost = '+startSRPost+' endSRPost = '+endSRPost);

				startSRPost = startSRPost + intervalCnt;
				if (i == numOfSRLoops-1) {
					endSRPost = savedReturnLen;
				} else {
					endSRPost = endSRPost + intervalCnt;
				}
				partSRCnt++;
			}
			//alert("A total of "+loopSRCnt+" iterations are uploaded in 'submit_return_data' object for this form!");
			cancel();
			disableAllElementIDs();
			//Open a new page, displaying the created form
			//alert("Finished Loading REST 'create2' request for FORMS object.");

			//getDisplayPageURL() is defined in string-util2014.js
			var redirectURL = x.window.location.href;
			var formURL = getDisplayPageURL(redirectURL, create2Id);
			if( parseInt(create2Id) > 0 ) window.open(formURL,'Login_Screen','resizable=1,scrollbars=1,height=850,width=900');
		} else {
			alert("Tax Return file does not exists. Cannot proceed with submission.");
			return;
		}

	//xmlFn.close();

	}

	function validateDate(element) {
		var strmmddyyyy = element.value;
		var isValid = true;
		var currentDate = new Date();
		var inputDate = new Date();

		if (strmmddyyyy != "") {
			var result = strmmddyyyy.split("/");
			var isLeap = new Date(result[2], 1, 29).getMonth() === 1;
			var month31 = (['01', '03', '05', '07', '08', '10', '12']);
			var month30 = (['04', '06', '09', '11']);
			var month = result[0];
			var day = result[1];
			if (result.length === 3) {
				if (isNaN(result[0] || result[1] || result[2])) {
					isValid = false;
				}
				else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 1))) {
					// numeric check if greater not than 31 - Month.
					isValid = false;
				}
				else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
					// numeric check if Date.
					isValid = false;
				}
				else if (result[2].length != 4) {
					isValid = false;
				}
				else if (month == 2) {
					if (!isLeap && day == 29) {
						isValid = false;
					}
					else if (!isLeap && day > 29) {
						isValid = false;
					}
					else if (isLeap && day > 29) {
						isValid = false;
					}
				}
				else if (month31.contains(month) && day > 31) {
					isValid = false;
				}
				else if (month30.contains(month) && day > 30) {
					isValid = false;
				}

				inputDate = new Date(result[2], month - 1, day);

			}
			else {
				isValid = false;
			}
		}

		if (!isValid) {
			alert('Please provide a valid date. (MM/DD/YYYY format)');
			element.value = '';
			element.focus();
		}
		else if (inputDate > currentDate) {
			alert('This date cannot be a future date.');
			element.value = '';
			element.focus();
		}
		// else if (inputDate.getFullYear() < 2018) {
		// 	alert('This date cannot be prior to 2018.');
		// 	element.value = '';
		// 	element.focus();
		// }

		return isValid;
	}


	function onAmendedClick(){
		var isAmended = d.getElementById('frm1621:amendedRtn_1').checked;

		// Part II item 17 disabled if not amended
		d.getElementById('frm1621:txtRemittance_Prev').disabled = !isAmended;
		if(!isAmended){
			d.getElementById('frm1621:txtRemittance_Prev').value = '0.00';
			calculate_Part2();
		}
	}

	function valToFloat(value){
		return parseFloat(value.replace(/,/g, ''));
	}

	function amtFormat(number){
		return number.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",")
	}

	function calculate_Part2(){
		d.getElementById("frm1621:txtRemittance_Tot").value = amtFormat(valToFloat(d.getElementById("frm1621:txtRemittance_1").value) + 
			valToFloat(d.getElementById("frm1621:txtRemittance_2").value) + 
			valToFloat(d.getElementById("frm1621:txtRemittance_Prev").value));

		d.getElementById("frm1621:txtStillDue").value = amtFormat(valToFloat(d.getElementById("frm1621:txtTaxWithheld").value) - 
			valToFloat(d.getElementById("frm1621:txtRemittance_Tot").value));

		d.getElementById("frm1621:txtPen_Tot").value = amtFormat(valToFloat(d.getElementById("frm1621:txtPen_Surcharge").value) + 
			valToFloat(d.getElementById("frm1621:txtPen_Interest").value) + 
			valToFloat(d.getElementById("frm1621:txtPen_Compromise").value));

		d.getElementById("frm1621:txtStillDue_tot").value = amtFormat(valToFloat(d.getElementById("frm1621:txtStillDue").value) + 
			valToFloat(d.getElementById("frm1621:txtPen_Tot").value));

		// fix for UAT issue: No off-setting of penalty to the Tax Still Due.
		if(valToFloat(d.getElementById("frm1621:txtStillDue").value) >= 0){
			// If Tax Still Due > 0, Total Amount Still Due = Tax Still Due + Total Penalties.
			d.getElementById("frm1621:txtStillDue_tot").value = amtFormat(valToFloat(d.getElementById("frm1621:txtStillDue").value) + 
				valToFloat(d.getElementById("frm1621:txtPen_Tot").value));
		}else{
			// If Tax Still Due < 0, Total Amount Still Due = Total Penalties
			d.getElementById("frm1621:txtStillDue_tot").value = amtFormat(valToFloat(d.getElementById("frm1621:txtPen_Tot").value));
		}
	}

	function percentStringToFloat(str) {
		var cleaned = str.replace('%', '').replace(/^\s+|\s+$/g, ''); // Remove % and trim spaces
		var num = parseFloat(cleaned);
		if (isNaN(num)) {
			return 0; // fallback if input is invalid
		}
		return num / 100;
	}

	function calculate_Part4(){
		// fix for UAT issue: Tax Withheld should be 6% of Withdrawn Amount
		var withdrawn_total = 0;
		var withheld_total = 0;
		for(var x = 1; x <= count_TaxWithheld; x++){
			d.getElementById('frm1621:txtSched1_'+x+'_Withheld').value = amtFormat(valToFloat(d.getElementById('frm1621:txtSched1_'+x+'_Withdrawn').value) * percentStringToFloat(d.getElementById("frm1621:txtTaxRate").value)); //0.06 = 6% frm1621:txtTaxRate
			alert(percentStringToFloat(d.getElementById("frm1621:txtTaxRate").value));
			withdrawn_total += valToFloat(d.getElementById("frm1621:txtSched1_"+x+"_Withdrawn").value);
 			withheld_total += valToFloat(d.getElementById("frm1621:txtSched1_"+x+"_Withheld").value);
		}

		d.getElementById("frm1621:txtSched1_Total_Withdrawn").value = amtFormat(withdrawn_total);
		d.getElementById("frm1621:txtSched1_Total_Withheld").value = amtFormat(withheld_total);

		d.getElementById("frm1621:txtTaxBase").value = d.getElementById("frm1621:txtSched1_Total_Withdrawn").value;
		d.getElementById("frm1621:txtTaxWithheld").value = d.getElementById("frm1621:txtSched1_Total_Withheld").value;

		calculate_Part2();
	}


	// 	Iterating tables
	var count_TaxWithheld = 0;
	function addRow_TaxWithheld(){
		count_TaxWithheld++;

		var tbl = d.getElementById('tbl_TaxWithheld').getElementsByTagName('tbody')[0];
		var row = tbl.insertRow(tbl.rows.length-1);
		row.className = 'dataRow';

		row.insertCell().innerHTML = "<font size='2' style='font-weight:bold;''>&nbsp;&nbsp;&nbsp;&nbsp;" + count_TaxWithheld + "</font>";
		row.insertCell().innerHTML = "<input id='frm1621:txtSched1_" + count_TaxWithheld + "_Name' name='frm1621:txtSched1_" + count_TaxWithheld + "_Name' type='text'>";
		row.insertCell().innerHTML = "<input id='frm1621:txtSched1_" + count_TaxWithheld + "_Tin' name='frm1621:txtSched1_" + count_TaxWithheld + "_Tin' type='text'>";
		row.insertCell().innerHTML = "<input id='frm1621:txtSched1_" + count_TaxWithheld + "_DateDeath' name='frm1621:txtSched1_" + count_TaxWithheld + "_DateDeath' type='text' onkeypress='return dateOnly(this, event)' onkeydown='dateMasking(this);' onblur='validateDate(this);'>";
		row.insertCell().innerHTML = "<input id='frm1621:txtSched1_" + count_TaxWithheld + "_Withdrawn' name='frm1621:txtSched1_" + count_TaxWithheld + "_Withdrawn' type='text' value='0.00' class='iceInpTxt' maxlength='25' size='25' style='text-align: right; font-size: 9pt;' onkeypress='return numbersonly(this, event)' onblur='round(this,2);blockNegativeNumber(this);calculate_Part4()' >";
		row.insertCell().innerHTML = "<input id='frm1621:txtSched1_" + count_TaxWithheld + "_Withheld' name='frm1621:txtSched1_" + count_TaxWithheld + "_Withheld' type='text' value='0.00' class='iceInpTxt' maxlength='25' size='25' style='text-align: right; font-size: 9pt;' onkeypress='return numbersonly(this, event)' onblur='round(this,2);blockNegativeNumber(this);calculate_Part4()' disabled>";
		row.insertCell().innerHTML = "<input id='frm1621:txtSched1_" + count_TaxWithheld + "_DateWithheld' name='frm1621:txtSched1_" + count_TaxWithheld + "_DateWithheld' type='text' onkeypress='return dateOnly(this, event)' onkeydown='dateMasking(this);' onblur='validateDate(this);'>";

		d.getElementById('TaxWithheld_Total').getElementsByTagName('font')[0].innerHTML = "&nbsp;&nbsp;&nbsp;&nbsp;" + (count_TaxWithheld+1) + "&nbsp; Total Taxes Withheld";
		d.getElementById('TaxWithheld_Total').getElementsByTagName('font')[1].innerHTML = "(Sum of Items 1 to " + count_TaxWithheld + ") <a href='' onclick='linkTo(this,1);'>(To Part II Item 13)</a>"
	}

	function delRow_TaxWithheld(){
		if(count_TaxWithheld > 5){
			count_TaxWithheld--;

			var tbl = d.getElementById('tbl_TaxWithheld').getElementsByTagName('tbody')[0];
			tbl.deleteRow(tbl.rows.length-2);

			d.getElementById('TaxWithheld_Total').getElementsByTagName('font')[0].innerHTML = "&nbsp;&nbsp;&nbsp;&nbsp;" + (count_TaxWithheld+1) + "&nbsp; Total Taxes Withheld";
			d.getElementById('TaxWithheld_Total').getElementsByTagName('font')[1].innerHTML = "(Sum of Items 1 to " + count_TaxWithheld + ") <a href='' onclick='linkTo(this,1);'>(To Part II Item 13)</a>"
		}
	}



//--------------------------END: Rollbase REST API using 'create2' and 'setBinaryData' --------------------------

</script>
