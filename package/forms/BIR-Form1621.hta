	var existingXMLFileName = "";
	var fileNameToExport = "";

	var savedReturn = "";
	var p3Compromise = "";
	var p3Surcharge = "";
	var p3Interest = "";
	var p3IsAmended = "";
	var p3FilingDate = "";
	var p3ReturnPeriod = "";
	var p3ReturnPeriodEnd = "";

	var p3BasicTax = "";
	var p3TotalPenalties = "";
	var p3TotalAmountPayable = "";

	var p3TPTIN1 = "";
	var p3TPTIN2 = "";
	var p3TPTIN3 = "";
	var p3TPTIN = "";
	var p3TPBranchCode = "";
	var p3TPRDOCode = "";
	var p3TPName = "";
	var p3TPTelNum = "";
	var p3TPAddress = "";
	var p3TPZip = "";
	var globalEmail = "";

	var retYear = "";

	var currentPage;
	var MaxPage = 2;


	str = setInterval("sleeptime()", 300);
	function sleeptime()
	{
		clearInterval(str);
		init();

		var bgFileName = qs('xmlBGInfoFileName');
		if (bgFileName != null && bgFileName.indexOf('.xml') > -1) {
			loadBGXML(bgFileName);
		}

		fileName = qs('xmlFileName');
		if (fileName != null && fileName.indexOf('.xml') > -1) {
			loadXML(fileName); var tin = fileName.split("/")[1].split("-"); loadBGXML("profile/"+ tin[0]+".xml");

			d.getElementById('frm1621:txtYear').disabled = true;

			existingXMLFileName = fileName;
			if (gIsReadOnly) {
			window.setTimeout("disableAllElementIDs(); d.getElementById('btnUpload').disabled = false;",1000);
			}
		} else {
			window.setTimeout("$('#loader').hide('blind');",100);

			// no xml saved. populate fields with default values from profile
			d.getElementById('frm1621:registeredName_2').value = d.getElementById('frm1621:registeredName').value;

			d.getElementById('frm1621:tinA_2').value = d.getElementById('frm1621:tinA').value;
			d.getElementById('frm1621:tinB_2').value = d.getElementById('frm1621:tinB').value;
			d.getElementById('frm1621:tinC_2').value = d.getElementById('frm1621:tinC').value;
			d.getElementById('frm1621:branchCode_2').value = d.getElementById('frm1621:branchCode').value;


			// add default iterating fields
			for(var i = 0; i < 5; i++){
				addRow_TaxWithheld();

				// addRow_RealProp();
				// addRow_Fam();
				// addRow_Stock();
				// addRow_Other();
				// addRow_Transfer();
				// addRow_Business();
			}
		}

		if ( $('#printMenu').css('display') != 'none' ) {
			$('#printMenu').hide('blind');
		}
		d.getElementById('frm1621:tinA').disabled = true;
		d.getElementById('frm1621:tinB').disabled = true;
		d.getElementById('frm1621:tinC').disabled = true;
		d.getElementById('frm1621:branchCode').disabled = true;
		d.getElementById('frm1621:rdoCode').disabled = true;
		d.getElementById('frm1621:registeredName').disabled = true;
		d.getElementById('frm1621:registeredAddress').disabled = true;
		d.getElementById('frm1621:zipCode').disabled = true;
		d.getElementById('frm1621:telephoneNumber').disabled = true;
		d.getElementById('txtEmail').disabled = true;

		retYear = d.getElementById('frm1621:txtYear').value;

		onAmendedClick();

		enableSched1Fields();

		// window.setTimeout("checkFinalCopyBtn('1621')", 2000);
		window.setTimeout("checkFinalCopyBtn('1621');" +
			"d.getElementById('frm1621:btnPrevPage').disabled=false;" +
			"d.getElementById('frm1621:txtCurrentPage').disabled=false;" +
			"d.getElementById('frm1621:btnNextPage').disabled=false;", 2000);
	}


	function linkTo(link,pageNumber) {
		if (link.disabled == false || (typeof link === "string")) {
		
			$('#Page' + pageNumber + "Content").show('blind');
			$('#Page' + currentPage + "Content").hide('blind');
			d.getElementById("frm1621:txtCurrentPage").value = pageNumber;
			currentPage = d.getElementById("frm1621:txtCurrentPage").value;
		}
	}

	function ValidateYear(input){
		if(retYear != input.value){
			if((d.getElementById('frm1621:txtYear').value == "")){
				alert("Please enter a valid year on Item 1.");
				input.value = retYear;
				return;
			}

			var dt = new Date();
			if(d.getElementById('frm1621:txtYear').value*1 > dt.getFullYear()*1){
				alert("Invalid data entry on Item no. 1. Entry should be current or prior year but not be earlier than effectivity date of January 2018.");
				input.value = retYear;
				return;
			}
			if(d.getElementById('frm1621:txtYear').value*1 < 2018){
				// alert("Invalid date entry on Item no.1. Entry should not be lower than 1900.");
				alert("Invalid date entry on Item no.1. Entry should not be earlier than effectivity date of January 2018.");
				input.value = retYear;
				return;
			}

			if(retYear !== ""){
				if (confirm("Changing the return period will clear all entered computed data.\n\nDo you want to continue?")){
					retYear = input.value;

					d.getElementById('frm1621:txtTaxBase').value = '0.00';
					d.getElementById('frm1621:txtTaxWithheld').value = '0.00';
					d.getElementById('frm1621:txtRemittance_1').value = '0.00';
					d.getElementById('frm1621:txtRemittance_2').value = '0.00';
					d.getElementById('frm1621:txtRemittance_Prev').value = '0.00';
					d.getElementById('frm1621:txtRemittance_Tot').value = '0.00';
					d.getElementById('frm1621:txtStillDue').value = '0.00';
					d.getElementById('frm1621:txtPen_Surcharge').value = '0.00';
					d.getElementById('frm1621:txtPen_Interest').value = '0.00';
					d.getElementById('frm1621:txtPen_Compromise').value = '0.00';
					d.getElementById('frm1621:txtPen_Tot').value = '0.00';
					d.getElementById('frm1621:txtStillDue_tot').value = '0.00';

					for(var x = 1; x <= count_TaxWithheld; x++){
						d.getElementById('frm1621:txtSched1_' + x + '_Name').value = '';
						d.getElementById('frm1621:txtSched1_' + x + '_Tin').value = '';
						d.getElementById('frm1621:txtSched1_' + x + '_DateDeath').value = '';
						d.getElementById('frm1621:txtSched1_' + x + '_Withdrawn').value = '0.00';
						d.getElementById('frm1621:txtSched1_' + x + '_Withheld').value = '0.00';
						d.getElementById('frm1621:txtSched1_' + x + '_DateWithheld').value = '';
					}

					d.getElementById('frm1621:txtSched1_Total_Withdrawn').value = '0.00';
					d.getElementById('frm1621:txtSched1_Total_Withheld').value = '0.00';

				}else{
					input.value = retYear;
				}
			}else{
				retYear = input.value;
			}
		}
	}

	function rdoPropertyJS(rdoCode, description)
	{
		this.rdoCode=rdoCode;
		this.description=description;
	}

	var rdoList = new Array();

	/*----------------------------------*/
	//Added by MPISCOSO
	var d=document,XMLBGFile='',data='',XMLFile='',msg = d.getElementById('msg');
	var loader=d.getElementById('loader');
	/*----------------------------------*/



	/*--------------------------------------------------------------*/
	function loadXML(loadWhere) {
		try {
			//This will load the file with filename loadWhere if it exists
			var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
			XMLFile = fsoXML.OpenTextFile(loadWhere,1);

			if (XMLFile.AtEndOfStream)
				data = "";
			else {
				var response = d.getElementById('response'); //render file and write to hidden div
				response.innerHTML = XMLFile.ReadAll(); //remove XML tag
			}
			XMLFile.Close(); //alert( response.innerHTML ); //Debug
			loadData();	/*This will load data onto fields*/

			if (response.innerHTML.indexOf("All Rights Reserved BIR 2012.0") >= 0) {
				gIsReadOnly = true;
			}

			if (gIsReadOnly) {
				d.getElementById('frm1621:cmdValidate').disabled = true;
				d.getElementById('btnSave').disabled = true;
			}

			window.setTimeout("$('#loader').hide('blind');",2000);
		} catch(e) {
			msg.innerHTML = ""; //"Save File not Found.";
		} //this will Alert File not Found if it doesn't exist
	}

	function loadData() {
		/*This will load data onto fields*/
		var response = d.getElementById("response");

		var countSched1 = (response.innerHTML.match(/<DIV>frm1621:txtSched1_[0-9]{1,}_Name+/g) || []).length;
		if(countSched1 < 5)
			countSched1 = 5;

		for(var i = 0; i < countSched1; i++)
			addRow_TaxWithheld();

		var elem = document.getElementById('frmMain').elements;
		for(var i = 0; i < elem.length; i++)
		{
			try{
				if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&
					if (elem[i].type == 'text' || elem[i].type == 'select-one') {
						var fieldVal = String( $("#response").html() ).split(elem[i].id+'=');
						if(elem[i].id == 'frm1621:registeredName' || elem[i].id == 'frm1621:registeredAddress' || elem[i].id == 'frm1621:txtLineBus'){
							elem[i].value = unescape(fieldVal[1]);
						}
						else if (elem[i].className.indexOf("FinalFlag") > -1) {
						elem[i].value = typeof (fieldVal[1]) === "undefined" ? "3" : fieldVal[1];
					}
						else{
							elem[i].value = fieldVal[1]; //all select-one and text values
						}
					}
					if (elem[i].type == 'radio') {
						var rdoVal = String( $("#response").html() ).split(elem[i].id+'=');
						if (rdoVal[1] == 'true') {
							elem[i].checked = rdoVal[1];
							elem[i].onclick();
						}
					}
					if (elem[i].type == 'checkbox') {
						var chkboxVal = String( $("#response").html() ).split(elem[i].id+'=');
						if (chkboxVal[1] == 'true') {
							elem[i].checked = chkboxVal[1];
						}
					}

				}
			} catch(e) {
				//alert('exception thrown : e : '+e.description);
			}

		}

		document.getElementById('frm1621:txtCurrentPage').value = 1;
		document.getElementById('txtEmail').value = globalEmail;
	}

	function createEncXMLFileName(subFolder) {
		var xmlFileName = "";
		var titleTin1 = d.getElementById('frm1621:tinA');
		var titleTin2 = d.getElementById('frm1621:tinB');
		var titleTin3 = d.getElementById('frm1621:tinC');
		var titleBranchCode = d.getElementById('frm1621:branchCode');
		var titleTPName = d.getElementById('frm1621:registeredName');

		//YYYY : 1621, 1604E, {1700}, {1701}, {1702}
		var returnPeriod = d.getElementById('frm1621:txtYear').value;



			xmlFileName = subFolder + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
			"-1621-" +
			returnPeriod +
			".xml";


		fileName = titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
		"-1621-" +
		returnPeriod +
		".xml";

		return xmlFileName;
	}

	function createXMLFileName(subFolder) {
		var xmlFileName = "";
		var titleTin1 = d.getElementById('frm1621:tinA');
		var titleTin2 = d.getElementById('frm1621:tinB');
		var titleTin3 = d.getElementById('frm1621:tinC');
		var titleBranchCode = d.getElementById('frm1621:branchCode');
		var titleTPName = d.getElementById('frm1621:registeredName');
		var isAmendedReturn = isItAnAmendedReturn();

		//YYYY : 1621, 1604E, {1700}, {1701}, {1702}
		var returnPeriod = d.getElementById('frm1621:txtYear').value;

		if (existingXMLFileName != null && existingXMLFileName.length > 0) {
			xmlFileName = existingXMLFileName;

		} else {
				xmlFileName = subFolder + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
				"-1621-" +
				returnPeriod +
				".xml";
		}
			fileName = titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value +
			"-1621-" +
			returnPeriod +
			".xml";

		return xmlFileName;
	}

	 function saveEncryptedProfile(isFromSubmit) {
		var isSaveSuccessful = saveXML(true);
			//saveXMLProfile(true);
		var fnNew = "";

		if (isSaveSuccessful) {

			if (existingXMLFileName.indexOf('/') > -1) { //Means existingXMLFileName is the same as the preloaded file yyy
				fnNew = existingXMLFileName.substring(existingXMLFileName.indexOf('/')+1, existingXMLFileName.length);
			} else {
				if (fileName.indexOf('/') > -1) { //Means fileName is the same as the preloaded file
					fnNew = fileName.substring(fileName.indexOf('/')+1, fileName.length);
				} else {
					fnNew = fileName;
				}
			}
			}else {
			return;
		}

			if(document.getElementById('txtFinalFlag').value == "3"){ fnNew = fnNew.split(".xml")[0] + "#" + globalEmail + "#.xml"; }
			var xmlFileName = "IAF_RDO_Copy/" + fnNew; //createXMLFileName("IAF_RDO_Copy/");//
			msg.innerHTML='Generating File...';
			var fileSys = new ActiveXObject("Scripting.FileSystemObject");
			var xmlFile = "";
			//dgarfin todo: alert user that it will overwrite existing zzz
			if (doesFileExists(xmlFileName)) {
				//alert("File '"+xmlFileName+"' already exists!\n\nThis will overwrite existing data.");
			}
			xmlFile = fileSys.CreateTextFile(xmlFileName);
			fileNameToExport = fnNew;
			var allXML = "<?xml version='1.0'?>",tab=d.getElementById('xmlFormat').innerHTML;
			allXML += tab; //adds line break

			/*--------------------- follow this format for parsing --------------------------- */
			var elem = document.getElementById('frmMain').elements;
			for(var i = 0; i < elem.length; i++)
			{
				if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
					if (elem[i].type == 'text' || elem[i].type == 'select-one') {
						allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab; //all select-one and text values
					}
					if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
						allXML += "<div>"+elem[i].id+"=" +elem[i].checked+elem[i].id+"=</div>"+tab; //all radio and checkbox values
					}

				}
			}
			/*--------------------- follow this format for parsing --------------------------- */

			allXML += tab+d.getElementById('xmlClose').innerHTML+"0";

			//Encryption of data content 'allXML'
			//var encryptedAllXML = encrypt(allXML);

			 xmlFile.write(allXML);
			xmlFile.close();
			// External compression and encryption
			var succ = EncryptFile(xmlFileName);
			msg.innerHTML = '';
			if (typeof(isFromSubmit) === "undefined") {
				if (confirm('File saved and encrypted.\nDo you want to save this in USB flash drive or CD-RW?')) {
					//alert("Make sure you already inserted your USB flash drive or CD-RW before proceeding.");
					//show modal "Have Disk"...
					showModalExport();
					//window.history.go(0);
				} else { // return; //cancel finalcopy
					//exportTPFileInC();
					//alert("You have not saved the file to either your USB flash drive or CD-RW.\n\n In case you want to submit it via email,\nyou may locate it under : 'C:\\IAF_RDO_Copy'");
					//window.history.go(0);

					//refresh HTA page here. to address:
					//Issue#380: A return tagged as final copy should not be edited by tp, rdo, rdc. Currently, user can still modify entries.
					//document.location.reload(true);
					disableAllElementIDs();
					d.getElementById('btnUpload').disabled = false;
				}
			}
			else{
					disableAllElementIDs();
					d.getElementById('btnUpload').disabled = false;

			}
			return fileSys.GetAbsolutePathName(xmlFileName);
	}

	 function doesFileExists(xmlFile) {
		var fileSysObj = new ActiveXObject("Scripting.FileSystemObject");
		if (fileSysObj.FileExists(xmlFile)) {
			return true;
		} else {
			return false;
		}
	}

	function isItAnAmendedReturn(xmlFile) {
		if(d.getElementById('frm1621:amendedRtn_1').checked) {
			return true;
		} else {
			return false;
		}
	}

	function isItAFinalCopy(xmlFile) {
			var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
			fn = fsoXML.OpenTextFile(xmlFile,1);
			var fnContent = fn.ReadAll();
			fn.Close();

			if (fnContent.indexOf("All Rights Reserved BIR 2012.0") >= 0) {
				return true;
			} else {
				return false;
			}
	}

	function createNewXMLFileName(subFolder, xmlFileName) {
		//Conditions met here: (isFileExists && isFinalCopy && isAmendedReturn)
		var fso = new ActiveXObject("Scripting.FileSystemObject");
		var fileNm = "";
		var newFileNm = "";

		if (xmlFileName.indexOf('V') == -1) {
			fileNm = xmlFileName.substring(xmlFileName.indexOf('/')+1, xmlFileName.indexOf('.xml'));
		} else {
			fileNm = xmlFileName.substring(xmlFileName.indexOf('/')+1, xmlFileName.indexOf('V'));
		}

		var sameFileNameCtr = 0;
		var subFileName = "";
		var version = 0;
		//if (fso.FileExists(xmlFileName)) {
			if(subFolder.length>0 && fso.FolderExists(subFolder)) {
				var objEnum = new Enumerator(fso.GetFolder(subFolder).Files);
				for(i=0;!objEnum.atEnd();objEnum.moveNext()) {
					if (objEnum.item().name.indexOf(fileNm) > -1 && objEnum.item().name.indexOf("V") > -1) {
						//sameFileNameCtr++;
						//as of 10/21/2016
						//no longer counts the file but gets the highest version number and add plus 1
						var isAFinalCopy = isItAFinalCopy(subFolder+objEnum.item().name);
						//if (isAFinalCopy && document.getElementById('txtFinalFlag').value == '0') {
							subFileName = objEnum.item().name.substring(objEnum.item().name.indexOf('V')+1, objEnum.item().name.indexOf('.xml'));
								version = parseInt(subFileName);
							if (version >= sameFileNameCtr) {
								sameFileNameCtr = version+1;
							}
						//}
					}
				}

				if (sameFileNameCtr > 0) {
					newFileNm = subFolder + fileNm + "V" + sameFileNameCtr + ".xml";
				} else {
					//amended default
					newFileNm = subFolder + fileNm + "V1.xml";
				}
				return newFileNm;
			}
		//} else {
			//unlikely to happend since saveXML() altered filtered out the scenario that will call this function
		//}
	}


	function saveXML(isFinalCopy) {
		var isFileExists = false;
		var isAmendedReturn = false;
		var isAFinalCopy = false;

		if (gIsReadOnly && document.getElementById("txtFinalFlag").value != "2") {
			if (confirm('You will no longer be allowed to modify since this is already the final copy.\nDo you want to save this in USB flash drive or CD-RW instead?')) {
				var xmlFileName = createEncXMLFileName("IAF_RDO_Copy/");
				msg.innerHTML='Generating File...';
				var fileSys = new ActiveXObject("Scripting.FileSystemObject");
				var xmlFile=fileSys.CreateTextFile(xmlFileName); //(saveWhere);
				//
				fileNameToExport = fileName;
				var allXML = "<?xml version='1.0'?>",tab=d.getElementById('xmlFormat').innerHTML;
				allXML += tab; //adds line break

				/*--------------------- follow this format for parsing --------------------------- */
				var elem = document.getElementById('frmMain').elements;
				for(var i = 0; i < elem.length; i++)
				{
					if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
						if (elem[i].type == 'text' || elem[i].type == 'select-one') {
							if(elem[i].id == 'frm1621:registeredName' || elem[i].id == 'frm1621:registeredAddress'){
								allXML += "<div>"+elem[i].id+"=" +escape(elem[i].value)+elem[i].id+"=</div>"+tab;
							}
							else{
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab; //all select-one and text values
							}
						}
						if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].checked+elem[i].id+"=</div>"+tab; //all radio and checkbox values
						}

					}
				}
				/*--------------------- follow this format for parsing --------------------------- */

				allXML += tab+d.getElementById('xmlClose').innerHTML+"0";

				//Encryption of data content 'allXML'
				//var encryptedAllXML = encrypt(allXML);

				 xmlFile.write(allXML);
				xmlFile.close();
				// External compression and encryption
			var succ = EncryptFile(xmlFileName);
				msg.innerHTML = '';

				showModalExport();
				saveXMLProfile(true);
				// saveXML(true);
			} else {
				return false;
			}
		} else {
			var valid = initialValidateBeforeSave();

			if (valid == true) {

				var xmlFileName = createXMLFileName("savefile/");
				msg.innerHTML='Generating File...';
				var fileSys = new ActiveXObject("Scripting.FileSystemObject");
				var xmlFile = "";
				var xmlFileNameValidate = "";
				var isFinalFlag2 = false;
				//---------------------------------------------------------------
				//START: New logic in handling amended returns
				isFileExists = doesFileExists(xmlFileName);
				isAmendedReturn = isItAnAmendedReturn();

				//as of 10/21/2016
				//if there is already amended filed and will file a not amended,
				//it will restrict it
				if (isAmendedReturn == false) {

					if (xmlFileName.indexOf('V') == -1) {
						xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/')+1, xmlFileName.indexOf('.xml'));
					} else {
						xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/')+1, xmlFileName.indexOf('V'));
					}

					var hasVersion = false;
					var objEnum = new Enumerator(fileSys.GetFolder("savefile/").Files);
					for(i=0;!objEnum.atEnd();objEnum.moveNext()) {
						if (objEnum.item().name.indexOf(xmlFileNameValidate) > -1 && objEnum.item().name.indexOf("V") > -1) {
							hasVersion = true;
						}
					}
					if (hasVersion) {
						if (!onExit)
							alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'.");
						return false;
					}
				}

				if (isFileExists) {
					isAFinalCopy = isItAFinalCopy(xmlFileName);
					if(document.getElementById('txtFinalFlag').value == '2'){
						isAFinalCopy = false;
						isFinalFlag2 = true;
					}
				}

				//1) check if fileExists, if not regular routine
				if (isFileExists == false) {
					//as of 10/21/2016
						if (isAmendedReturn) {
							var fn = createNewXMLFileName("savefile/", xmlFileName);
							xmlFile = fileSys.CreateTextFile(fn);
							xmlFileName = fn;
							existingXMLFileName = fn;
						}
						else
					xmlFile = fileSys.CreateTextFile(xmlFileName); //xmlFileName should be the newly created xml filename here.
				}
				//2) if (fileExists && FinalCopy && Amended) {versionFile}
				else if (isFileExists && isAFinalCopy && isAmendedReturn) {
				//as of 10/21/2016
					if (existingXMLFileName != null && existingXMLFileName.length > 0) {
						xmlFile = fileSys.CreateTextFile(xmlFileName); //xmlFileName should be the preloaded xml filename here.
						}
						else {
					//versionFile xxx

					var fn = createNewXMLFileName("savefile/", xmlFileName);
					xmlFile = fileSys.CreateTextFile(fn);
					xmlFileName = fn;
					existingXMLFileName = fn;
					}
				}
				//3)if (fileExists && FinalCopy && Not Amended) {throw error message: "If your intention is to make an amended return, kindly tick Amended Return to 'Yes'".}
				else if (isFileExists && isAFinalCopy && isAmendedReturn == false && document.getElementById('txtFinalFlag').value != '3') {
					if (!onExit)
						 alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'.");
					return false;
				}
				//4) if (fileExists && Not FinalCopy && Not Amended/Amended) {regular routine}
				else if (isFileExists && isAFinalCopy == false) {
					//as of 10/21/2016
					if (existingXMLFileName != null && existingXMLFileName.length > 0) {
						xmlFile = fileSys.CreateTextFile(xmlFileName); //xmlFileName should be the preloaded xml filename here.
						}
						else {
					if (isAmendedReturn && isFinalFlag2 == false) {
						var fn = createNewXMLFileName("savefile/", xmlFileName);
						xmlFile = fileSys.CreateTextFile(fn);
						xmlFileName = fn;
						existingXMLFileName = fn;
					}
					else
					xmlFile = fileSys.CreateTextFile(xmlFileName); //xmlFileName should be the preloaded xml filename here.
					}
				}
				else {
					xmlFile = fileSys.CreateTextFile(xmlFileName);
				}
				//END: New logic in handling amended returns
				//---------------------------------------------------------------
				//
				var allXML = "<?xml version='1.0'?>",tab=d.getElementById('xmlFormat').innerHTML;
				allXML += tab; //adds line break

				/*--------------------- follow this format for parsing --------------------------- */
				var elem = document.getElementById('frmMain').elements;
				for(var i = 0; i < elem.length; i++)
				{
					if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
						if (elem[i].type == 'text' || elem[i].type == 'select-one') {
							if (elem[i].id == 'frm1621:registeredName') {
								allXML += "<div>"+elem[i].id+"=" +escape(elem[i].value)+elem[i].id+"=</div>"+tab;
								p3TPName = escape(elem[i].value);
							}
							else if (elem[i].id == 'frm1621:registeredAddress') {
								allXML += "<div>"+elem[i].id+"=" +escape(elem[i].value)+elem[i].id+"=</div>"+tab;
								p3TPAddress = escape(elem[i].value);
							}

							//Get surcharge, compromise, interest, returnPeriod, filingDate
							//basicTax, total penalties, total amount payable
							//TIN, branchCode, rdoCode, TPClass, LOB, TPName, TelNo, Addr, Zip
							else if (elem[i].id == 'frm1621:tinA') {
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
								p3TPTIN1 = elem[i].value;
							} else if (elem[i].id == 'frm1621:tinB') {
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
								p3TPTIN2 = elem[i].value;
							} else if (elem[i].id == 'frm1621:tinC') {
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
								p3TPTIN3 = elem[i].value;
							} else if (elem[i].id == 'frm1621:branchCode') {
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
								p3TPBranchCode = elem[i].value;
							} else if (elem[i].id == 'frm1621:rdoCode') {
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
								p3TPRDOCode = elem[i].value;
							}
							else if (elem[i].id == 'frm1621:telephoneNumber') {
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
								p3TPTelNum = elem[i].value;
							}
							/*else if (elem[i].id == 'frm1621:registeredAddress') {
								p3TPAddress = escape(elem[i].value);
							} */
							else if (elem[i].id == 'frm1621:zipCode') {
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
								p3TPZip = elem[i].value;
							}
							else{
								allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab; //all select-one and text values
							}
						}
						if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].checked+elem[i].id+"=</div>"+tab; //all radio and checkbox values
							if (d.getElementById('frm1621:amendedRtn_1').checked == true) {
								p3IsAmended = "Yes";
							} else if (d.getElementById('frm1621:amendedRtn_2').checked == true) {
								p3IsAmended = "No";
							}
						}

					}
				}
				var retPeriodSubStr = xmlFileName.substring(xmlFileName.lastIndexOf('-')+1, xmlFileName.indexOf('.xml')); //111111111111-0605-09122011115519.xml (09/12/2011 11:55:19)
				p3ReturnPeriod = retPeriodSubStr.substring(0,4);

				//Dev Note: Since GP is fixed at Jan31 of the following year, we can likewise just fix MM/DD to '12/31'
				p3ReturnPeriodEnd = "01/31/" + p3ReturnPeriod;

				p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;
				/*--------------------- follow this format for parsing --------------------------- */

				if (isFinalCopy) {
					allXML += tab+d.getElementById('xmlClose').innerHTML+"0";
					gIsReadOnly = true;
				} else {
					allXML += tab+d.getElementById('xmlClose').innerHTML;
				}

				//Phase 3: This 'savefile' will be uploaded to IAF Infra for DI processing
				savedReturn = allXML;

				xmlFile.write(allXML);
				xmlFile.close();
				msg.innerHTML = '';

				if (isFinalCopy == false) {
					alert('BIR Form saved successfully as : '+xmlFileName);
				}
				saveXMLProfile(false);
				return true;
			}
		}
		return true;
	}

	function saveXMLsubmit(submit){
		var valid = initialValidateBeforeSave();
		var isBFinalCopy = false;
		if (valid == true) {

			var xmlFileName = createXMLFileName("savefile/");
			msg.innerHTML='Generating File...';
			var fileSys = new ActiveXObject("Scripting.FileSystemObject");
			var xmlFile = "";
			var xmlFileNameValidate = "";
			//---------------------------------------------------------------
			//START: New logic in handling amended returns
			isFileExists = doesFileExists(xmlFileName);
			isAmendedReturn = isItAnAmendedReturn();

			//as of 10/21/2016
			//if there is already amended filed and will file a not amended,
			//it will restrict it
			if (isAmendedReturn == false) {
					if (xmlFileName.indexOf('V') == -1) {
						xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/')+1, xmlFileName.indexOf('.xml'));
					} else {
						xmlFileNameValidate = xmlFileName.substring(xmlFileName.indexOf('/')+1, xmlFileName.indexOf('V'));
					}

				var hasVersion = false;
				var objEnum = new Enumerator(fileSys.GetFolder("savefile/").Files);
				for(i=0;!objEnum.atEnd();objEnum.moveNext()) {
					if (objEnum.item().name.indexOf(xmlFileName) > -1 && objEnum.item().name.indexOf("V") > -1) {
						hasVersion = true;
					}
				}
				if (hasVersion) {
					if (!onExit && !isSubmit)
						alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'.");
					return false;
				}
			}

			if (isFileExists) {
				if(document.getElementById('txtFinalFlag').value == '2'){isAFinalCopy = false;}
			}

			//1) check if fileExists, if not regular routine
			if (isFileExists == false) {

				xmlFile = fileSys.CreateTextFile(xmlFileName); //xmlFileName should be the newly created xml filename here.
			}
			//2) if (fileExists && FinalCopy && Amended) {versionFile}
			else if (isFileExists && isBFinalCopy && isAmendedReturn) {
				//versionFile xxx

				var fn = createNewXMLFileName("savefile/", xmlFileName);
				xmlFile = fileSys.CreateTextFile(fn);
				xmlFileName = fn;
				existingXMLFileName = fn;
			}
			//3)if (fileExists && FinalCopy && Not Amended) {throw error message: "If your intention is to make an amended return, kindly tick Amended Return to 'Yes'".}
			else if (isFileExists && isBFinalCopy && isAmendedReturn == false && document.getElementById('txtFinalFlag').value != '3') {
				if (!onExit && !isSubmit){
					 alert("If your intention is to make an amended return, kindly tick Amended Return to 'Yes' before hitting 'Save' or 'Final Copy' or 'Submit'.");
					return false;
				}
				else {
					xmlFile = fileSys.CreateTextFile(xmlFileName);
				}
			}
			//4) if (fileExists && Not FinalCopy && Not Amended/Amended) {regular routine}
			else if (isFileExists && isBFinalCopy == false) {

				xmlFile = fileSys.CreateTextFile(xmlFileName); //xmlFileName should be the preloaded xml filename here.
			}
			else {
				xmlFile = fileSys.CreateTextFile(xmlFileName);
			}
			//END: New logic in handling amended returns
			//---------------------------------------------------------------
			//
			var allXML = "<?xml version='1.0'?>",tab=d.getElementById('xmlFormat').innerHTML;
			allXML += tab; //adds line break

			/*--------------------- follow this format for parsing --------------------------- */
			var elem = document.getElementById('frmMain').elements;
			for(var i = 0; i < elem.length; i++)
			{
				if (elem[i].type != 'button' && elem[i].type != 'hidden' && elem[i].type != 'undefined') {
					if (elem[i].type == 'text' || elem[i].type == 'select-one') {
						if (elem[i].id == 'frm1621:registeredName') {
							allXML += "<div>"+elem[i].id+"=" +escape(elem[i].value)+elem[i].id+"=</div>"+tab;
							p3TPName = escape(elem[i].value);
						}
						else if (elem[i].id == 'frm1621:registeredAddress') {
							allXML += "<div>"+elem[i].id+"=" +escape(elem[i].value)+elem[i].id+"=</div>"+tab;
							p3TPAddress = escape(elem[i].value);
						}

						//Get surcharge, compromise, interest, returnPeriod, filingDate
						//basicTax, total penalties, total amount payable
						//TIN, branchCode, rdoCode, TPClass, LOB, TPName, TelNo, Addr, Zip
						else if (elem[i].id == 'frm1621:tinA') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
							p3TPTIN1 = elem[i].value;
						} else if (elem[i].id == 'frm1621:tinB') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
							p3TPTIN2 = elem[i].value;
						} else if (elem[i].id == 'frm1621:tinC') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
							p3TPTIN3 = elem[i].value;
						} else if (elem[i].id == 'frm1621:branchCode') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
							p3TPBranchCode = elem[i].value;
						} else if (elem[i].id == 'frm1621:rdoCode') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
							p3TPRDOCode = elem[i].value;
						}
						else if (elem[i].id == 'frm1621:telephoneNumber') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
							p3TPTelNum = elem[i].value;
						}
						/*else if (elem[i].id == 'frm1621:registeredAddress') {
							p3TPAddress = escape(elem[i].value);
						} */
						else if (elem[i].id == 'frm1621:zipCode') {
							allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab;
							p3TPZip = elem[i].value;
						}
						else{
							allXML += "<div>"+elem[i].id+"=" +elem[i].value+elem[i].id+"=</div>"+tab; //all select-one and text values
						}
					}
					if (elem[i].type == 'radio' || elem[i].type == 'checkbox') {
						allXML += "<div>"+elem[i].id+"=" +elem[i].checked+elem[i].id+"=</div>"+tab; //all radio and checkbox values
						if (d.getElementById('frm1621:amendedRtn_1').checked == true) {
							p3IsAmended = "Yes";
						} else if (d.getElementById('frm1621:amendedRtn_2').checked == true) {
							p3IsAmended = "No";
						}
					}

				}
			}
			var retPeriodSubStr = xmlFileName.substring(xmlFileName.lastIndexOf('-')+1, xmlFileName.indexOf('.xml')); //111111111111-0605-09122011115519.xml (09/12/2011 11:55:19)
			p3ReturnPeriod = retPeriodSubStr.substring(0,4);

			//Dev Note: Since GP is fixed at Jan31 of the following year, we can likewise just fix MM/DD to '12/31'
			p3ReturnPeriodEnd = "01/31/" + p3ReturnPeriod;

			p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;
			/*--------------------- follow this format for parsing --------------------------- */

			if (submit) {
				allXML += tab+d.getElementById('xmlClose').innerHTML+"0";
			} else {
				allXML += tab+d.getElementById('xmlClose').innerHTML;
			}

			//Phase 3: This 'savefile' will be uploaded to IAF Infra for DI processing
			savedReturn = allXML;

			xmlFile.write(allXML);
			xmlFile.close();
			msg.innerHTML = '';

			if (submit == false) {
				alert('BIR Form saved successfully as : '+xmlFileName);
			}

		}
		return true;
	}
	var XMLrdoFile='';

	function loadXMLrdo(fileLocation) {
		try {
			//This will load the Region file with filename 'fileLocation' if it exists
			var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
			XMLrdoFile = fsoXML.OpenTextFile(fileLocation,1);

			if (XMLrdoFile.AtEndOfStream)
				data = "";
			else {
				var responseRdo = d.getElementById('responseRdo'); //render file and write to hidden div
				responseRdo.innerHTML = XMLrdoFile.ReadAll(); //remove XML tag
				//responseRdo = replaceHtml(responseRdo, XMLrdoFile.ReadAll()); //Pattern: el = replaceHtml(el, newHtml)
			}
			XMLrdoFile.Close(); //alert( responseRdo.innerHTML ); //Debug
			loadRdo();	/*This will load ATC onto an array*/
		} catch(e) {
			msg.innerHTML = ""; //"Region File not Found.";
		} //this will Alert File not Found if it doesn't exist
	}

	var rdoCount=0;

	function loadRdo() {
		/*This will load data onto an array*/
		var response = d.getElementById("responseRdo");

		var rdoCnt = String(response.innerHTML).split('rdoCount=');
		rdoCount = rdoCnt[1];



		var k = 0;
		//loads rdoList from xml
		for (var i = 1; i <= rdoCount; i++) {

			var rdo = String(response.innerHTML).split('rdo'+i+':');
			var rdoStr = rdo[1];

			//Ensure that before writing to rdoPropertyJS the formType 1621 is traceable in rdoStr
			if (rdoStr.indexOf('1621') >= 0) {
				var rdoValues = rdoStr.split('~');
				var rdoCode = rdoValues[0];
				var description = rdoValues[1];

				var objRdo = new rdoPropertyJS(rdoCode, description);
				rdoList[k] = objRdo;
				k++;
				//alert('1621 successfully created array #'+i);

			} else {
				//alert('1621 not found in array #'+i);
				continue;
			}
		}
	}

	/*--------------------------------------------------------------*/
	function init()
	{
		currentPage = 1;
		d.getElementById('frm1621:txtCurrentPage').value = currentPage;
		d.getElementById('frm1621:txtSheets').disabled = false;
		
		// var date = new Date();
		// d.getElementById('frm1621:txtYear').value = date.getFullYear() - 1;


		d.getElementById('frm1621:amendedRtn_1').disabled = false;
		d.getElementById('frm1621:amendedRtn_2').disabled = false;

		d.getElementById('btnPrint').disabled = true;
		d.getElementById('frm1621:cmdEdit').disabled = true;
		d.getElementById('frm1621:btnFinalCopy').disabled = true;
		d.getElementById('btnUpload').disabled = true;

		getDrives();
		loadXMLrdo('xml/rdo.xml');
		getRdo();
	}

	function goToPage() {
		var newVal = document.getElementById("frm1621:txtCurrentPage").value;
		//var printType = !isFromPrint ? "Page" : "Print";
		var printType = "Page";

		if ((newVal <= MaxPage) && (newVal > 0) && (newVal !== currentPage.toString())) {
			$('#' + printType + currentPage + 'Content').hide('blind');
			$('#' + printType + newVal + 'Content').show('blind');
			currentPage = (document.getElementById("frm1621:txtCurrentPage").value) * 1;
		}
		else if ((newVal > MaxPage) || (newVal <= 0)) {
			alert("Invalid page");

			document.getElementById("frm1621:txtCurrentPage").value = currentPage;
		}
	}

	function processPrev() {
		if (currentPage == 1){
			currentPage = 1;
		} else {
			currentPage--;
			$('#Page' + currentPage + 'Content').show('blind');
			$('#Page' + (currentPage + 1) + 'Content').hide('blind');
			document.getElementById('frm1621:txtCurrentPage').value = currentPage;

		}
	}
	function processNext() {
		if (currentPage == MaxPage) {
		} else {
			currentPage++;
			$('#Page' + currentPage + 'Content').show('blind');
			$('#Page' + (currentPage - 1) + 'Content').hide('blind');
			document.getElementById('frm1621:txtCurrentPage').value = currentPage;
		}
	}

	function blockletter(e)
	{
		var number = parseFloat(e.value).toFixed(2);
		if(isNaN(number))
		{
			var zero = 0;
			e.value = parseFloat(zero).toFixed(2);
		}else {
			e.value = '' + number;
		}
	}

	function blockNegativeNumber(e)
	{
		if(e.value < 0){
			e.value = "0.00";
		}
	}

	function blockletterWithout2Decimal(e)
	{
		var number = parseFloat(e.value);
		if(isNaN(number))
		{
			e.value = "";
		} else {
			e.value = '' + number.toFixed(0);
		}
	}

	function blockLetterInt(e)
	{
		var number = e.value;
		if(isNaN(number))
		{
			e.value = "";
		} else {
			e.value = '' + number;
		}
	}

	function enableSched1Fields() {
    	var isYes = document.getElementById("frm1621:taxWithheld_1").checked; // Y = Yes, N = No
    	var count = count_TaxWithheld; // same variable used in loop

		for (var x = 1; x <= count; x++) {
			var nameField = document.getElementById('frm1621:txtSched1_' + x + '_Name');
			var tinField = document.getElementById('frm1621:txtSched1_' + x + '_Tin');
			var dateDeathField = document.getElementById('frm1621:txtSched1_' + x + '_DateDeath');
			var withdrawnField = document.getElementById('frm1621:txtSched1_' + x + '_Withdrawn');
			var withheldField = document.getElementById('frm1621:txtSched1_' + x + '_Withheld');
			var dateWithheldField = document.getElementById('frm1621:txtSched1_' + x + '_DateWithheld');

			// Disable if "No" selected, enable if "Yes"
			var disabled = !isYes;
			nameField.disabled = disabled;
			tinField.disabled = disabled;
			dateDeathField.disabled = disabled;
			withdrawnField.disabled = disabled;
			withheldField.disabled = disabled;
			dateWithheldField.disabled = disabled;

			// Always disabled withheld field
			withheldField.disabled = true;

			// Clear fields when disabled
			if (disabled) {
				nameField.value = "";
				tinField.value = "";
				dateDeathField.value = "";
				withdrawnField.value = "0.00";
				withheldField.value = "0.00";
				dateWithheldField.value = "";
			}
		}
	}

	function validateForm()
	{
		var dt = new Date();

		if((d.getElementById('frm1621:txtYear').value == ""))
		{
			alert("Please enter a valid year on Item 1.");
			return;
		}
		if(d.getElementById('frm1621:txtYear').value*1 > dt.getFullYear()*1)
		{
			//alert("Invalid date entry on Item no.1. Entry should not be later than Current Date.")
			alert("Invalid data entry on Item no. 1. Entry should be current or prior year but not be earlier than effectivity date of January 2018.")
			return;
		}
		if(d.getElementById('frm1621:txtYear').value*1 < 1900)
		{
			alert("Invalid date entry on Item no.1. Entry should not be lower than 1900.")
			return;
		}

		if(!d.getElementById('frm1621:quarter_1').checked && !d.getElementById('frm1621:quarter_2').checked && !d.getElementById('frm1621:quarter_3').checked && !d.getElementById('frm1621:quarter_4').checked)
		{
			alert("Please choose a quarter on item 2.");
			return;
		}

		if( (d.getElementById('frm1621:tinA').value == "" || d.getElementById('frm1621:tinB').value == "" || d.getElementById('frm1621:tinC').value == "" || d.getElementById('frm1621:branchCode').value == "") )
		{
			alert("Please enter a valid TIN number on Item 4.");
			return;
		}
		//if( (d.getElementById('frm1621:rdoCode').value == "") )
		if( (d.getElementById('frm1621:rdoCode').selectedIndex == 0) )
		{
			alert("Please enter a valid RDO Code on Item 5.");
			return;
		}
		if( (d.getElementById('frm1621:registeredName').value == "") )
		{
			alert("Please enter a valid Taxpayer's Name on Item 6.");
			return;
		}
		if( (d.getElementById('frm1621:registeredAddress').value == "") )
		{
			alert("Please enter Taxpayer's Registered Address on Item 7.");
			return;
		}
		if(d.getElementById('frm1621:categoryAgent_1').checked == false && d.getElementById('frm1621:categoryAgent_2').checked == false)
		{
			alert("Please select an option for Item 11.");
			return;
		}
		if( (d.getElementById('frm1621:telephoneNumber').value == "") )
		{
			alert("Please enter a valid Telephone Number on Item 9.");
			return;
		}
		if( (d.getElementById('frm1621:zipCode').value == "") )
		{
			alert("Please enter Taxpayer's Zip Code on Item 10.");
			return;
		}

		// fix for UAT issue: Form shall not validate successfully if details are not complete in all columns.
		// for(var x = 1; x <= 5; x++){
		// for(var x = 1; x <= count_TaxWithheld; x++){
		// 	if(!(d.getElementById('frm1621:txtSched1_'+x+'_Name').value == "" &&
		// 		d.getElementById('frm1621:txtSched1_'+x+'_Tin').value == "" &&
		// 		d.getElementById('frm1621:txtSched1_'+x+'_DateDeath').value == "" &&
		// 		d.getElementById('frm1621:txtSched1_'+x+'_Withdrawn').value == "0.00" &&
		// 		d.getElementById('frm1621:txtSched1_'+x+'_Withheld').value == "0.00" &&
		// 		d.getElementById('frm1621:txtSched1_'+x+'_DateWithheld').value == "")
		// 		&& !(d.getElementById('frm1621:txtSched1_'+x+'_Name').value != "" &&
		// 		d.getElementById('frm1621:txtSched1_'+x+'_Tin').value != "" &&
		// 		d.getElementById('frm1621:txtSched1_'+x+'_DateDeath').value != "" &&
		// 		d.getElementById('frm1621:txtSched1_'+x+'_DateWithheld').value != "")
		// 	){
		// 		alert("Please fill out all fields on Schedule 1 - Details of Tax Withheld for Seq. No. " + x + ".");
		// 		return;
		// 	}
		// }

		// Modify the existing code block above for additional validation 110725
		var taxWithheldYes = false;
		var taxWithheldRadio = d.getElementById("frm1621:taxWithheld_1");
		var hasAtLeastOneRow = false;

		if (taxWithheldRadio && taxWithheldRadio.checked) {
			taxWithheldYes = true;
		}

		for (var x = 1; x <= count_TaxWithheld; x++) {
			var name = d.getElementById('frm1621:txtSched1_' + x + '_Name').value;
			var tin = d.getElementById('frm1621:txtSched1_' + x + '_Tin').value;
			var dateDeath = d.getElementById('frm1621:txtSched1_' + x + '_DateDeath').value;
			var withdrawn = d.getElementById('frm1621:txtSched1_' + x + '_Withdrawn').value;
			var withheld = d.getElementById('frm1621:txtSched1_' + x + '_Withheld').value;
			var dateWithheld = d.getElementById('frm1621:txtSched1_' + x + '_DateWithheld').value;
			var yearFiled = d.getElementById('frm1621:txtYear').value.replace(/^\s+|\s+$/g, '');
			var q1 = d.getElementById("frm1621:quarter_1");
			var q2 = d.getElementById("frm1621:quarter_2");
			var q3 = d.getElementById("frm1621:quarter_3");
			var q4 = d.getElementById("frm1621:quarter_4");
			var isQ1 = q1 && q1.checked;
			var isQ2 = q2 && q2.checked;
			var isQ3 = q3 && q3.checked;
			var isQ4 = q4 && q4.checked;

			// ✅ New validation: Must atleast 1 Row in Schedule 1 if Tax Withheld is YES 020926
			if (name !== "" || tin !== "" || dateDeath !== "" || withdrawn !== "0.00" || withheld !== "0.00" || dateWithheld !== "") {
				hasAtLeastOneRow = true;
			}

			if (taxWithheldYes && !hasAtLeastOneRow) {
				alert("You selected 'Tax Withheld = Yes'. Please enter at least one row in Schedule 1.");
				return;
			}

			// Existing validation
			if (!(name == "" && tin == "" && dateDeath == "" && withdrawn == "0.00" && withheld == "0.00" && dateWithheld == "") &&
				!(name != "" && tin != "" && dateDeath != "" && dateWithheld != "")) {
				alert("Please fill out all fields on Schedule 1 - Details of Tax Withheld for Seq. No. " + x + ".");
				return;
			}

			// ✅ New validation: Name must be alphabetic only (letters and spaces)
			if (name !== "" && !/^[A-Za-z\s]+$/.test(name)) {
				alert("Schedule 1 Name for Seq. No. " + x + " must contain alphabetic characters only.");
				return;
			}

			// ✅ New validation: TIN must be exactly 14 digits (numeric only)
			if (tin !== "" && !/^\d{14}$/.test(tin)) {
				alert("Schedule 1 TIN for Seq. No. " + x + " must contain exactly 14 numeric digits.");
				return;
			}

			// ✅ New validation: DateDeath should not be earlier than Jan 01, 2018
			if (dateDeath !== "") {
				// Try to parse the date in a consistent way
				var parts = dateDeath.split(/[-\/]/); // supports YYYY-MM-DD or MM/DD/YYYY
				var deathDate;

				if (parts[0].length === 4) {
					// format: YYYY-MM-DD
					deathDate = new Date(parts[0], parts[1] - 1, parts[2]);
				} else {
					// format: MM/DD/YYYY
					deathDate = new Date(parts[2], parts[0] - 1, parts[1]);
				}

				var minDate = new Date(2018, 0, 1); // Jan 1, 2018

				if (deathDate < minDate) {
					alert("Schedule 1 Date of Death for Seq. No. " + x + " should not be earlier than January 01, 2018.");
					return;
				}
			}

			// ✅ New validation: Date Withheld should not be earlier than Date of Death
			if (dateDeath !== "" && dateWithheld !== "") {
				var partsDeath = dateDeath.split(/[-\/]/);
				var partsWithheld = dateWithheld.split(/[-\/]/);
				var deathDate = (partsDeath[0].length === 4)
					? new Date(partsDeath[0], partsDeath[1] - 1, partsDeath[2])
					: new Date(partsDeath[2], partsDeath[0] - 1, partsDeath[1]);
				var withheldDate = (partsWithheld[0].length === 4)
					? new Date(partsWithheld[0], partsWithheld[1] - 1, partsWithheld[2])
					: new Date(partsWithheld[2], partsWithheld[0] - 1, partsWithheld[1]);

				if (withheldDate < deathDate) {
					alert("Schedule 1 Date Withheld for Seq. No. " + x + " should not be earlier than Date of Death.");
					return;
				}

				// ✅ New validation: Year of Date Withheld must match Year Filed
				var withheldYear = withheldDate.getFullYear().toString();
				if (yearFiled !== "" && withheldYear !== yearFiled) {
					alert("Schedule 1 Date Withheld Year " + withheldYear + " for Seq. No. " + x + " must match the Year Filed " + yearFiled + ".");
					return;
				}
			}

			// ✅ New validation: Date Withheld month must match selected quarter 020926
			if (dateWithheld !== "") {
				var monthWithheld = withheldDate.getMonth() + 1; // 1–12

				if (isQ1 && (monthWithheld < 1 || monthWithheld > 3)) {
					alert("Schedule 1 Date Withheld for Seq. No. " + x + " must be within January to March for Quarter 1.");
					return;
				}

				if (isQ2 && (monthWithheld < 4 || monthWithheld > 6)) {
					alert("Schedule 1 Date Withheld for Seq. No. " + x + " must be within April to June for Quarter 2.");
					return;
				}

				if (isQ3 && (monthWithheld < 7 || monthWithheld > 9)) {
					alert("Schedule 1 Date Withheld for Seq. No. " + x + " must be within July to September for Quarter 3.");
					return;
				}

				if (isQ4 && (monthWithheld < 10 || monthWithheld > 12)) {
					alert("Schedule 1 Date Withheld for Seq. No. " + x + " must be within October to December for Quarter 4.");
					return;
				}
			}
		}

		d.getElementById('frm1621:cmdValidate').disabled = true;
		d.getElementById('btnPrint').disabled = false;
		d.getElementById('frm1621:cmdEdit').disabled = false;
		d.getElementById('btnUpload').disabled = false;

		enabledDisabledControls(true);

		alert("Validation successful. Click on Edit if you wish to modify your entries.");
		return;
	}

