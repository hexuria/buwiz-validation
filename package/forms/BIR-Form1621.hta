		// d.getElementById('frm1621:registeredAddress').disabled = param;
		// d.getElementById('frm1621:zipCode').disabled = param;


		d.getElementById('frm1621:quarter_1').disabled = param;
		d.getElementById('frm1621:quarter_2').disabled = param;
		d.getElementById('frm1621:quarter_3').disabled = param;
		d.getElementById('frm1621:quarter_4').disabled = param;

		d.getElementById('frm1621:taxWithheld_1').disabled = param;
		d.getElementById('frm1621:taxWithheld_2').disabled = param;


		d.getElementById('frm1621:txtRemittance_1').disabled = param;
		d.getElementById('frm1621:txtRemittance_2').disabled = param;
		d.getElementById('frm1621:txtRemittance_Prev').disabled = param;
		d.getElementById('frm1621:txtPen_Surcharge').disabled = param;
		d.getElementById('frm1621:txtPen_Interest').disabled = param;
		d.getElementById('frm1621:txtPen_Compromise').disabled = param;

		var input = d.getElementById('tbl_TaxWithheld').getElementsByTagName('input');
		for(var x = 0; x < input.length; x++){
			if(input[x].id != 'frm1621:txtSched1_Total_Withdrawn' && input[x].id != 'frm1621:txtSched1_Total_Withheld' && input[x].id != 'frm1621:txtSched1'+ (x+1) +'_Withheld')
				input[x].disabled = param;
		}

		d.getElementById('frm1621:btnFinalCopy').disabled = !param;
		d.getElementById('btnSave').disabled = !param;

		if(!param){
			onAmendedClick();
			// onTreatyClick();
			// changePayment();
		}

		if (qs('xmlFileName') != null && qs('xmlFileName').indexOf('.xml') > -1) {
			d.getElementById('frm1621:txtYear').disabled = true;
		}

		disableElem;
		enableElem;
	}

	function getRdo()
	{
		var data = "<select class='iceSelOneMnu' id='frm1621:rdoCode' name='frm1621:rdoCode' size='1' ><option value='000'> </option>";

		for(var i = 0; i < rdoList.length; i++) {
			var rdo = rdoList[i];
			data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";

		}
		data = data + "</select>"

		$('#rdoSelect').html(data);
	}

	function initialValidateBeforeSave() {
		if( (d.getElementById('frm1621:tinA').value == "" || d.getElementById('frm1621:tinB').value == "" || d.getElementById('frm1621:tinC').value == "" || d.getElementById('frm1621:branchCode').value == "") )
		{
			alert("Please enter a valid TIN number on Item 6.");
			return false;
		}
		if ((d.getElementById('frm1621:rdoCode').value == "000")) {
			alert("Please enter a valid RDO Code on Item 7.");
			return false;
		}
		if( (d.getElementById('frm1621:registeredName').value == "") )
		{
			alert("Please enter a valid Taxpayer Name on Item 8.");
			return false;
		}
		return true;
	}

