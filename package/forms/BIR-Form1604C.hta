	var XMLrdoFile='';

	function loadXMLrdo(fileLocation) {
		try {
			//This will load the Region file with filename 'fileLocation' if it exists
			var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
			XMLrdoFile = fsoXML.OpenTextFile(fileLocation,1);	
	
			if (XMLrdoFile.AtEndOfStream)
				data = "";
			else {
				var responseRdo = d.getElementById('responseRdo'); //render file and write to hidden div
				responseRdo.innerHTML = XMLrdoFile.ReadAll(); //remove XML tag
				//responseRdo = replaceHtml(responseRdo, XMLrdoFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
			}
			XMLrdoFile.Close(); //alert( responseRdo.innerHTML ); //Debug			
			loadRdo();	/*This will load ATC onto an array*/	
		} catch(e) {
			msg.innerHTML = ""; //"Region File not Found.";
		} //this will Alert File not Found if it doesn't exist
	}
	
	var rdoCount=0;

	function loadRdo() {
		/*This will load data onto an array*/
		var response = d.getElementById("responseRdo");
		
		var rdoCnt = String(response.innerHTML).split('rdoCount=');
		rdoCount = rdoCnt[1]; 
	
		var k = 0;
		//loads rdoList from xml
		for (var i = 1; i <= rdoCount; i++) { 
			
			var rdo = String(response.innerHTML).split('rdo'+i+':');
			var rdoStr = rdo[1];
		
			//Ensure that before writing to rdoPropertyJS the formType 1604C is traceable in rdoStr
			if (rdoStr.indexOf('1604C') >= 0) {
				var rdoValues = rdoStr.split('~');							
				var rdoCode = rdoValues[0];
				var description = rdoValues[1];				
				
				var objRdo = new rdoPropertyJS(rdoCode, description);
				rdoList[k] = objRdo; 
				k++;
				//alert('1604C successfully created array #'+i);
				
			} else {		
				//alert('1604C not found in array #'+i);
				continue;
			}
		}					
	}
	
	/*--------------------------------------------------------------*/	
	function init()
	{
		var date = new Date();

		d.getElementById('frm1604c:txtYear').value = date.getFullYear() - 1;
		
		
		d.getElementById('frm1604c:amendedRtn_1').disabled = false;
		d.getElementById('frm1604c:amendedRtn_2').disabled = false;
		
		/*d.getElementById('frm1604c:tinA').disabled = true;
		d.getElementById('frm1604c:tinB').disabled = true;
		d.getElementById('frm1604c:tinC').disabled = true;
		d.getElementById('frm1604c:branchCode').disabled = true;
		d.getElementById('frm1604c:rdoCode').disabled = true;
		d.getElementById('frm1604c:registeredName').disabled = true;
		d.getElementById('frm1604c:telephoneNumber').disabled = true;
		d.getElementById('frm1604c:registeredAddress').disabled = true;*/
		d.getElementById('frm1604c:txtSheets').disabled = false;
		//d.getElementById('frm1604c:zipCode').disabled = true;
		
		d.getElementById('frm1604c:txtRefMonth').disabled = true;
		d.getElementById('frm1604c:txtRefDate').disabled = true;
		d.getElementById('frm1604c:txtRefYear').disabled = true;
		// d.getElementById('frm1604c:txt12').disabled = true;
		d.getElementById('frm1604c:select13').disabled = true;

		d.getElementById('btnPrint').disabled = true;
		d.getElementById('frm1604c:cmdEdit').disabled = true;
		d.getElementById('frm1604c:btnFinalCopy').disabled = true;
		d.getElementById('btnUpload').disabled = true;



		var x = 1;
		while(x <= 12){
			d.getElementById('frm1604c:txtSched1TotalAmt' + x).disabled = true;
			x++;
		}

		x = 1;
		while(x < 2){
			if(x == 1){
				d.getElementById('frm1604c:txtSched' + x + 'AdjTotal').disabled = true;
			}
			d.getElementById('frm1604c:txtSched' + x + 'TaxWheldTotal').disabled = true;
			d.getElementById('frm1604c:txtSched' + x + 'PenTotal').disabled = true;
			d.getElementById('frm1604c:txtSched' + x + 'Total').disabled = true;

			// d.getElementById('frm1604c:txtSched4TotalAmt' + x).disabled = true;
			x++;
		}
		getDrives();
		loadXMLrdo('xml/rdo.xml');
		getRdo();
	}

	function changeRefund()
	{
		if(d.getElementById('frm1604c:releasedOfFunds_1').checked == true){
			//refundFields(false);
			d.getElementById('frm1604c:txtRefMonth').disabled = false;
			d.getElementById('frm1604c:txtRefDate').disabled = false;
			d.getElementById('frm1604c:txtRefYear').disabled = false;
			d.getElementById('frm1604c:txt12').disabled = false;
			d.getElementById('frm1604c:select13').disabled = false;
		}else {
			//refundFields(true);
			d.getElementById('frm1604c:txtRefMonth').disabled = true;
			d.getElementById('frm1604c:txtRefDate').disabled = true;
			d.getElementById('frm1604c:txtRefYear').disabled = true;
			d.getElementById('frm1604c:txt12').disabled = true;
			d.getElementById('frm1604c:select13').disabled = true;
		
			d.getElementById('frm1604c:txtRefMonth').value = "00";
			d.getElementById('frm1604c:txtRefDate').value = "";
			d.getElementById('frm1604c:txtRefYear').value = "";
			d.getElementById('frm1604c:txt12').value = "";
			d.getElementById('frm1604c:select13').value = "00";
		}
	}

	function disable11and12()
	{
		d.getElementById('frm1604c:txtRefMonth').disabled = true;
		d.getElementById('frm1604c:txtRefDate').disabled = true;
		d.getElementById('frm1604c:txtRefYear').disabled = true;
		d.getElementById('frm1604c:txt12').disabled = true;
		d.getElementById('frm1604c:select13').disabled = true;
	}
	
	function enable11and12()
	{
		if(d.getElementById('frm1604c:releasedOfFunds_1').checked == true){
			d.getElementById('frm1604c:txtRefMonth').disabled = false;
			d.getElementById('frm1604c:txtRefDate').disabled = false;
			d.getElementById('frm1604c:txtRefYear').disabled = false;
			d.getElementById('frm1604c:txt12').disabled = false;
			d.getElementById('frm1604c:select13').disabled = false;
		}else {
			d.getElementById('frm1604c:txtRefMonth').disabled = true;
			d.getElementById('frm1604c:txtRefDate').disabled = true;
			d.getElementById('frm1604c:txtRefYear').disabled = true;
			d.getElementById('frm1604c:txt12').disabled = true;
			d.getElementById('frm1604c:select13').disabled = true;
		}
	}

	function computeTotalWithheld(sched)
	{
		var x = 1;
		var totalWithheld = 0;
		if(sched == '4'){
			while(x <= 4){
				totalWithheld = (totalWithheld*1) + (NumWithComma(d.getElementById('frm1604c:txtSched' + sched + 'TaxWheld' + x).value)*1);

				x++;
			}
		}else {
			while(x <= 12){
				totalWithheld = (totalWithheld*1) + (NumWithComma(d.getElementById('frm1604c:txtSched' + sched + 'TaxWheld' + x).value)*1);

				x++;
			}
		}
		d.getElementById('frm1604c:txtSched' + sched + 'TaxWheldTotal').value = formatCurrency(totalWithheld);

		computeTotal(sched);
	}

	function computeTotalPenalties(sched)
	{
		var x = 1;
		var totalPenalties = 0;
		if(sched == '4'){
			while(x <= 4){
				totalPenalties = (totalPenalties*1) + (NumWithComma(d.getElementById('frm1604c:txtSched' + sched + 'Pen' + x).value)*1);

				x++;
			}
		}else {
			while(x <= 12){
				totalPenalties = (totalPenalties*1) + (NumWithComma(d.getElementById('frm1604c:txtSched' + sched + 'Pen' + x).value)*1);

				x++;
			}
		}
		d.getElementById('frm1604c:txtSched' + sched + 'PenTotal').value = formatCurrency(totalPenalties);

		computeTotal(sched);
		capital();
	}

	function computeTotal(sched)
	{
		var total = 0;
		if(sched == '1'){
			var x = 1;
			var amt = 0;
			while(x <= 12){
				amt = NumWithComma(d.getElementById('frm1604c:txtSched' + sched + 'TotalAmt' + x).value);
				if(amt > 0){
					total = (total*1) + (amt*1);
				}
				x++;
			}
		}else {
			total = (NumWithComma(d.getElementById('frm1604c:txtSched' + sched + 'TaxWheldTotal').value)*1) + (NumWithComma(d.getElementById('frm1604c:txtSched' + sched + 'PenTotal').value)*1);
		}
		
		d.getElementById('frm1604c:txtSched' + sched + 'Total').value = formatCurrency(total);
		capital();
	}

	function computeTotalAdjustment(){
		var x = 1;
		var totalAdjustment = 0;
		while(x <= 12){
			totalAdjustment = (totalAdjustment*1) + NumWithComma(d.getElementById('frm1604c:txtSched1Adj' + x).value)*1;

			x++;
		}
		d.getElementById('frm1604c:txtSched1AdjTotal').value = formatCurrency(totalAdjustment);

		computeTotal('1');
		capital();
	}

	function computeTotalAmount(a,b)
	{
		var totalRemit = 0;
		totalRemit = NumWithComma(d.getElementById('frm1604c:txtSched' + a + 'TaxWheld' + b).value)*1 + NumWithComma(d.getElementById('frm1604c:txtSched' + a + 'Pen' + b).value)*1;
		if(a == '1'){
			totalRemit = (totalRemit*1) + NumWithComma(d.getElementById('frm1604c:txtSched' + a + 'Adj' + b).value)*1;
		}
		d.getElementById('frm1604c:txtSched' + a + 'TotalAmt' + b).value = formatCurrency(totalRemit);

		computeTotal(a);
		capital();
	}

	function blockletter(e)
	{
		var number = parseFloat(e.value).toFixed(2);
		if(isNaN(number))
		{
			var zero = 0;
			e.value = parseFloat(zero).toFixed(2);
		}else {
			e.value = '' + number;
		}
	}

	function blockNegativeNumber(e)
	{
		if(e.value < 0){
			e.value = "0.00";
		}
	}

	function blockletterWithout2Decimal(e)
	{
		var number = parseFloat(e.value);
		if(isNaN(number))
		{
			e.value = "";
		} else {
			e.value = '' + number.toFixed(0);
		}
	}

	function blockLetterInt(e)
	{
		var number = e.value;
		if(isNaN(number))
		{
			e.value = "";
		} else {
			e.value = '' + number;
		}
	}

	function validateForm()
	{
		var dt = new Date();

		if((d.getElementById('frm1604c:txtYear').value == ""))
		{
			alert("Please enter a valid year on Item 1.");
			return;
		}
		if(d.getElementById('frm1604c:txtYear').value*1 > dt.getFullYear()*1)
		{
			//alert("Invalid date entry on Item no.1. Entry should not be later than Current Date.")
			alert("Invalid data entry on Item no. 1. Entry should be current or prior year but not be earlier than effectivity date of January 2018.")
			return;
		}
		if(d.getElementById('frm1604c:txtYear').value*1 < 1900)
