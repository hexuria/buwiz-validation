		// 		if(validateMonthDayYearDate(d.getElementById('frm1604c:txtSched1Date' + y).value)){
		// 			alert("Invalid date entry on Part 2, Column 1 Row " + y + ". Format is mm/dd/yyyy.");
		// 			return;
		// 		}
		// 	}
		// 	y++;
		// }


		// var rows = getElementsByClassName(d.getElementById('tbl_RealProp'), 'dataRow');
		// check = 0; // 0 = not set; 1 = blank; 2 = has value

		// for(var x = 0; x < rows.length; x++){
		// 	for(var y = 0; y < rows[x].cells.length; y++){
		// 		var value = rows[x].cells[y].firstChild.value;

		// 		if(value != "0.00"){
		// 			if(check == 0){
		// 				check = (value == "") ? 1 : 2;
		// 			}else if((check == 1 && value != "") || (check == 2 && value == "")){
		// 				alert("Incomplete values on Schedule 2A, Row " + (x+1) + ".");
		// 				return;
		// 			}
		// 		}
		// 	}

		// 	check = 0;
		// }





		// var input = d.getElementById('tblPt2').getElementsByTagName('input');
		// var row2 = d.getElementById('tblPt2_1').getElementsByTagName('input');

		var rows = d.getElementById('tblPt2').getElementsByTagName('tr');
		var rows2 = d.getElementById('tblPt2_1').getElementsByTagName('tr');
		var check = 0; // 0 = not set; 1 = blank; 2 = has value


