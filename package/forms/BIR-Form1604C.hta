	function enabledDisabledControls(param)
	{
		d.getElementById('frm1604c:amendedRtn_1').disabled = param;
		d.getElementById('frm1604c:amendedRtn_2').disabled = param;
		d.getElementById('frm1604c:txtYear').disabled = param;

		d.getElementById('frm1604c:topAgent_1').disabled = param;
		d.getElementById('frm1604c:topAgent_2').disabled = param;

		d.getElementById('frm1604c:categoryAgent_1').disabled = param;
		d.getElementById('frm1604c:categoryAgent_2').disabled = param;
		d.getElementById('frm1604c:releasedOfFunds_1').disabled = param;
		d.getElementById('frm1604c:releasedOfFunds_2').disabled = param;
		d.getElementById('frm1604c:txtSheets').disabled = param;
		d.getElementById('frm1604c:tinA').disabled = param;
		d.getElementById('frm1604c:tinB').disabled = param;
		d.getElementById('frm1604c:tinC').disabled = param;
		d.getElementById('frm1604c:branchCode').disabled = param;
		d.getElementById('frm1604c:rdoCode').disabled = param;
		d.getElementById('frm1604c:registeredName').disabled = param;
		d.getElementById('frm1604c:telephoneNumber').disabled = param;
		d.getElementById('frm1604c:registeredAddress').disabled = param;
		d.getElementById('frm1604c:zipCode').disabled = param;


		d.getElementById('frm1604c:btnFinalCopy').disabled = !param;
		d.getElementById('btnSave').disabled = param;
		
		//changeRefund();
		// if(!param){
		// 	checkCategory();
		// }


		var y = 1;
		while(y <= 12){
			d.getElementById('frm1604c:txtSched1Date' + y).disabled = param;
			d.getElementById('frm1604c:txtSched1BankVal' + y).disabled = param;
			d.getElementById('frm1604c:txtTra' + y).disabled = param;
			d.getElementById('frm1604c:txtSched1TaxWheld' + y).disabled = param;
			d.getElementById('frm1604c:txtSched1Adj' + y).disabled = param;
			d.getElementById('frm1604c:txtSched1Pen' + y).disabled = param;
			y++;
		}
		
		if (qs('xmlFileName') != null && qs('xmlFileName').indexOf('.xml') > -1) {
			d.getElementById('frm1604c:txtYear').disabled = true;
		}
		
		disableElem;
		enableElem;
	}
	
	function getRdo()
	{
		var data = "<select class='iceSelOneMnu' id='frm1604c:rdoCode' name='frm1604c:rdoCode' size='1' ><option value='000'> </option>";
		
		for(var i = 0; i < rdoList.length; i++) {
			var rdo = rdoList[i];
			data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";
			
		}
		data = data + "</select>"
		
		$('#rdoSelect').html(data);		
		
	}
	
