		// 	if(NumWithComma(d.getElementById('frm1604c:txtSched1TaxWheld' + y).value) > 0 || NumWithComma(d.getElementById('frm1604c:txtSched1Pen' + y).value) > 0 || NumWithComma(d.getElementById('frm1604c:txtSched1Adj' + y).value) > 0){
