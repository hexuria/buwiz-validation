		// var rows2 = getElementsByClassName(d.getElementById('tblPt2_1'), 'iceInpTxt');
		// var check = 0; // 0 = not set; 1 = blank; 2 = has value


		for(var x = 1; x < rows.length-2; x++){
			for(var y = 0; y < rows[x].cells.length; y++){
				var input = rows[x].cells[y].getElementsByTagName('input');

				if(input.length > 0){
					if(!input[0].disabled && input[0].value != "0.00"){
						if(check == 0){
							check = (input[0].value == "") ? 1 : 2;
						}else if((check == 1 && input[0].value != "") || (check == 2 && input[0].value == "")){
							alert("Incomplete values on Part II, Row " + x + ".")

							// alert("1. check = " + check + " || val = " + input[0].value + " || y = " + y);
							return;
						}
					}
				}
			}

			for(var y = 0; y < rows2[x].cells.length; y++){
				var input = rows2[x].cells[y].getElementsByTagName('input');

				if(input.length > 0){
					if(!input[0].disabled && input[0].value != "0.00"){
						if(check == 0){
							check = (input[0].value == "") ? 1 : 2;
						}else if((check == 1 && input[0].value != "") || (check == 2 && input[0].value == "")){
							alert("Incomplete values on Part II (Continuation), Row " + x + ".")
							// alert("2. check = " + check + " || val = " + input[0].value + " || y = " + y);
							return;
						}
					}
				}
			}

			check = 0;
		}

		d.getElementById('frm1604c:cmdValidate').disabled = true;
		d.getElementById('btnPrint').disabled = false;
		d.getElementById('frm1604c:cmdEdit').disabled = false;
		d.getElementById('btnUpload').disabled = false;
		disable11and12();
		
		enabledDisabledControls(true);

		alert("Validation successful. Click on Edit if you wish to modify your entries.");
		return;
	}


	function getElementsByClassName(node, classname) {
		var a = [];
		var re = new RegExp('(^| )'+classname+'( |$)');
		var els = node.getElementsByTagName("*");
		for(var i=0,j=els.length; i<j; i++)
			if(re.test(els[i].className))a.push(els[i]);
		return a;
	}

