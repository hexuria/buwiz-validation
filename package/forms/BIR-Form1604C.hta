	str = setInterval("sleeptime()", 300);
	function sleeptime()
	{
		clearInterval(str);
		init();
		
		var bgFileName =  qs('xmlBGInfoFileName'); 
		if (bgFileName != null && bgFileName.indexOf('.xml') > -1) {
			loadBGXML(bgFileName);	
		} 
		
		fileName =  qs('xmlFileName'); 
		if (fileName != null && fileName.indexOf('.xml') > -1) {
			loadXML(fileName);   var tin = fileName.split("/")[1].split("-");   loadBGXML("profile/"+ tin[0]+".xml");
			
			d.getElementById('frm1604c:txtYear').disabled = true;
			
			existingXMLFileName = fileName;
			if (gIsReadOnly) { 
			window.setTimeout("disableAllElementIDs(); d.getElementById('btnUpload').disabled = false;",1000); 
			}
		} else {
			window.setTimeout("$('#loader').hide('blind');",100);
		}
		
		if ( $('#printMenu').css('display') != 'none' ) {	
			$('#printMenu').hide('blind');
		}
		d.getElementById('frm1604c:tinA').disabled = true;	
		d.getElementById('frm1604c:tinB').disabled = true;	
		d.getElementById('frm1604c:tinC').disabled = true;	
		d.getElementById('frm1604c:branchCode').disabled = true;
		d.getElementById('frm1604c:rdoCode').disabled = true;
		d.getElementById('frm1604c:registeredName').disabled = true;
		d.getElementById('frm1604c:registeredAddress').disabled = true;
		d.getElementById('frm1604c:zipCode').disabled = true;
		d.getElementById('frm1604c:telephoneNumber').disabled = true;
		d.getElementById('txtEmail').disabled = true;

		retYear = d.getElementById('frm1604c:txtYear').value;

		 window.setTimeout("checkFinalCopyBtn('1604C')", 2000);

		 
	}


	function ValidateYear(input){
		if(retYear != input.value){
			if((d.getElementById('frm1604c:txtYear').value == "")){
				alert("Please enter a valid year on Item 1.");
				input.value = retYear;
				return;
			}

			var dt = new Date();
			if(d.getElementById('frm1604c:txtYear').value*1 > dt.getFullYear()*1){
				alert("Invalid data entry on Item no. 1. Entry should be current or prior year but not be earlier than effectivity date of January 2018.");
				input.value = retYear;
				return;
			}
			if(d.getElementById('frm1604c:txtYear').value*1 < 2018){
				// alert("Invalid date entry on Item no.1. Entry should not be lower than 1900.");
				alert("Invalid date entry on Item no.1. Entry should not be earlier than effectivity date of January 2018.");
				input.value = retYear;
				return;
			}

			if (confirm("Changing the return period will clear all entered computed data.\n\nDo you want to continue?")){
				retYear = input.value;

				var x = 1;
				for(var x = 1; x <= 12; x++){

					d.getElementById('frm1604c:txtSched1Date' + x).value = '';
					d.getElementById('frm1604c:txtSched1BankVal' + x).value = '';
					d.getElementById('frm1604c:txtTra' + x).value = '';

					d.getElementById('frm1604c:txtSched1TaxWheld' + x).value = '0.00';
					d.getElementById('frm1604c:txtSched1Adj' + x).value = '0.00';
					d.getElementById('frm1604c:txtSched1Pen' + x).value = '0.00';
					d.getElementById('frm1604c:txtSched1TotalAmt' + x).value = '0.00';
				}

				d.getElementById('frm1604c:txtSched1TaxWheldTotal').value = '0.00';
				d.getElementById('frm1604c:txtSched1AdjTotal').value = '0.00';
				d.getElementById('frm1604c:txtSched1PenTotal').value = '0.00';
				d.getElementById('frm1604c:txtSched1Total').value = '0.00';
			}else{
				input.value = retYear;
			}
		}
	}

	// function checkCategory(){
	// 	var isEnabled = !(d.getElementById('frm1604c:categoryAgent_1').checked);

	// 	d.getElementById('frm1604c:topAgent_1').disabled = isEnabled;
