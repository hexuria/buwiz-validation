                   document.getElementById('txtFinalFlag').value = "1";updateFinalFlagOnSaveFile(fileNameEmail);alert("Submit Successful. Subject to validation by BIR.\n\n" +      "A notification will be sent to your email (" + emailTaxPayer + "). Please print or save the email as an evidence of efiled return.\n\n" +      "Note: There will be some delays on email sending of confirmation, please bear with us.\n\n" +      "In case of delay or non-receipt of system generated email confirmation from eBirforms, please check on the following possible reasons:\n\n" +      "1. Invalid email address / Inactive email account\n" +      "2. Email account quota exceeded\n" +      "3. Email confirmation is diverted to Spam and/or Junk emails folder\n" +      "4. Company firewall policy restricts receipt of email from ebirforms-noreply@bir.gov.ph");
                    $('#paymentOption').show();
					$('#paymentOptionCloseBtn').prop('disabled', false);
				    $('#paymentOptionCloseBtn').on('click', function () {
