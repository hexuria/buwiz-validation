                        "<td> <input type='text' id='frm1600PT:txtPg1P2TaxRate"+i+"' style='text-align: center' value='' disabled /><font size='2' style='font-weight:bold'>&nbsp;%</font>&nbsp;&nbsp;&nbsp;&nbsp;</td>"+
                        "<td> <input type='text' id='frm1600PT:txtPg1P2TaxWithheld"+i+"' style='text-align:right; width:16em !important' value='0.00' disabled /> </td>" +
                        "</tr>") ;
                        iCtr++;
                    }
                }

            }else{
