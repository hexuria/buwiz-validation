	function checkATCButton(){
		if (d.getElementById('frm1600PT:rdoPg1I3TaxWithheldYes').checked == true &&
			(d.getElementById('frm1600PT:rdoPg1I10CategoryofWthholdAgentPriv').checked == true ||
			 d.getElementById('frm1600PT:rdoPg1I10CategoryofWthholdAgentGovt').checked == true)){
