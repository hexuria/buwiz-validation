                        waitstr = setTimeout("setInputTextControl_NumberFormatter('frm1600PT:txtPg1P2TaxWithheld"+iCtr+"', 15, 2); getRequiredWithheld(" + iCtr + ");", 100);
                        iCtr++; 
                    }
