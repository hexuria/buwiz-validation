<!--to eFPS-->
<script>
    function submitOnline(){
        if(confirm("You will now be redirected to eFPS Online.")){
            submitToEFPS();
        }
    }

    function checkconnection() {
        var status = navigator.onLine;
        if (status) {
            return true;
        } else {
            return false;
        }
    }

    function submitToEFPS() {

        if (checkconnection()) {
            var formVersion = Form2200C.version;
            function getValue(stringId) {
                
                var alpha = document.getElementById(stringId).value;
                
                alpha = alpha.replace(/&/g, '&amp;');
                alpha = alpha.replace(/</g, '&lt;');
                alpha = alpha.replace(/>/g, '&gt;');
                
                return alpha;
                //if (!document.getElementById(stringId)) {
                //  console.error(stringId);
                //}
            }

            function convertDateXML(element) {
                //alert(d.getElementById('frm1600PT:'+element).value);
                var date = '';
                var dateSplit = d.getElementById('frm1600PT:' + element).value.split('/');
                var date = dateSplit[2] + '-' + dateSplit[0] + '-' + dateSplit[1];

                return date;
            }

            function getAmount(stringId) {
                return ((document.getElementById(stringId).value.indexOf(')') > 0 ? "-" : "") + document.getElementById(stringId).value.replace(/[\(\)\,]/gi, "")) * 1;
                //if (!document.getElementById(stringId)) {
                //  console.error(stringId);
                //  }
            }

            function fixAmount(elemValue) {
                return ((elemValue.indexOf(')') > 0 ? "-" : "") + elemValue.replace(/[\(\)\,]/gi, "")) * 1;
            }

            function returnPeriod() {
                var yyyyR = "20" + d.getElementById('frm1600PT:txtPg1I1Year').value;
                var mmR = (d.getElementById('frm1600PT:txtPg1I1Month').value.toString());
                var ddR = new Date(yyyyR, mmR, 0).getDate();
                var returnPeriodFormat = yyyyR + "-" + (mmR) + "-" + ddR;

                return returnPeriodFormat;
            }

            var endedyear = '20' + getValue("frm1600PT:txtPg1I1Year");
            populateTaxpayer(getValue("frm1600PT:txtPg1TIN4"), '',
        '', '', '', '',
        '', convertDateXML("txtPg1Pt1I8DateofIncorporation"), '', '', '', getValue("frm1600PT:txtPg1TIN1"),
        getValue("frm1600PT:txtPg1TIN2"), getValue("frm1600PT:txtPg1TIN3"), getValue("frm1600PT:txtPg1Pt1I8RegisteredAddress"), '', '',
        returnPeriod(), getValue("frm1600PT:txtPg1Pt1I11Email"), '', (document.getElementById("frm1600PT:rdoPg1I2AmendedYes").checked == true ? "Y" : "N"), '',
        '', (document.getElementById("frm1600PT:rdoPg1I4ShortPeriodYes").checked == true ? "Y" : "N"), (document.getElementById("frm1600PT:rdoPg1I5ATCR1C3").checked == true ? "IC011" : "IC021"),
        getValue("frm1600PT:txtPg1Pt2NumberofPagesFiled"), getValue("frm1600PT:txtPg1Pt1I9ContactNumber"), '',
        '', /*(document.getElementById("frm1600PT:rdoPg1I1Calendar").checked == true ? "C" : "F"),*/ getValue("frm1600PT:txtPg1I1Month"), endedyear, getValue("frm1600PT:rdoPg1Pt1I6RDO"),
        /*getValue("frm1600PT:txtPg1Pt1I16RegisteredActivity"),*/ '', '', getValue("frm1600PT:txtPg1Pt1I7WithholdingAgentsName"), (document.getElementById("frm1600PT:rdoPg1CTC").checked == true ? "CTC" : "SEC"),
        (document.getElementById("frm1600PT:rdoPg1I2AmendedYes").checked == true ? "Y" : "N"), (document.getElementById("frm1600PT:rdoPg1I5ATCR1C3").checked == true ? "true" : "false"), /*(document.getElementById("frm1600PT:rdoPg1I5ATCR2C3").checked == true ? "true" : "false"),*/ convertDateXML("txtPg1Pt1I19EffectivityFrom"),
        convertDateXML("txtPg1Pt1I19EffectivityTo"), /*getValue("frm1600PT:txtPg1Pt1I14LegalBasis"), getValue("frm1600PT:txtPg1Pt1I15Investment"),*/
        '', '', '', formVersion);

            //alert(endedyear);
            //alert(getValue("frm1600PT:txtPg1I1Month"));
            populateTotalTaxPayable(
        getAmount("frm1600PT:txtPg1Pt2I20TotalIncome"),
        getAmount("frm1600PT:txtPg1Pt2I21AddPenalty"),
        getAmount("frm1600PT:txtPg7Sc9I19TotalFinalTax"),
        getValue("frm1600PT:txtPg1Pt2I23CommunityTax"),
        convertDateXML("txtPg1Pt1I24DateofIssue"),
        getValue("frm1600PT:txtPg1Pt1I25PlaceofIssue"),
        getAmount("frm1600PT:txtPg1Pt1I26Amount"),
        getAmount("frm1600PT:txtPg1Pt2I22TotalAmount"),
        getAmount("frm1600PT:txtPg7Sc10I8TotalIncome"));

            populateComputationOfTaxBean(getAmount("frm1600PT:txtPg2Pt4I32LessCost"),
        getAmount("frm1600PT:txtPg2Pt4I33GrossIncome"),
            '0',
            '0',
            '0',
            '0',
        getAmount("frm1600PT:txtPg2Pt4I31NetSales"),
            '0',
        getAmount("frm1600PT:txtPg2Pt4I39NetTaxable"),
