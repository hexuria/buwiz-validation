                                "<td> <input type='text' id='frm1600PT:txtPg1P2TaxWithheld"+iCtr1+"' style='text-align:right; width:16em !important' value='0.00' readonly /> </td>" +
                                "</tr>") ;
                            setTimeout("d.getElementById('frm1600PT:txtAtcCd"+iCtr1+"').disabled = true; setInputTextControl_HorizontalAlignment('frm1600PT:txtPg1P2TaxBase"+iCtr1+"', 4);" +
