    var rdoList = new Array();

    var XMLrdoFile = ''; //Object Type

    var rdoCount = 0;

    function loadXMLrdo(fileLocation) {
        try {
            //This will load the Region file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLrdoFile = fsoXML.OpenTextFile(fileLocation, 1);

            if (XMLrdoFile.AtEndOfStream)
                data = "";
            else {
                var responseRdo = d.getElementById('responseRdo'); //render file and write to hidden div
                responseRdo.innerHTML = XMLrdoFile.ReadAll(); //remove XML tag
                //responseRdo = replaceHtml(responseRdo, XMLrdoFile.ReadAll()); //Pattern:  el = replaceHtml(el, newHtml)
            }
            XMLrdoFile.Close(); //alert( responseRdo.innerHTML ); //Debug           
            loadRdo(); /*This will load ATC onto an array*/
        } catch (e) {
            msg.innerHTML = ""; //"Region File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadRdo() {
        /*This will load data onto an array*/
        var response = document.getElementById("responseRdo");

        var rdoCnt = String(response.innerHTML).split('rdoCount=');
        rdoCount = rdoCnt[1];

        var k = 0;
        //loads rdoList from xml
        for (var i = 1; i <= rdoCount; i++) {
            var rdo = String(response.innerHTML).split('rdo' + i + ':');
            var rdoStr = rdo[1];

            //Ensure that before writing to rdoPropertyJS the formType 2200C is traceable in rdoStr
            if (rdoStr.indexOf('2200C') >= 0) {
                var rdoValues = rdoStr.split('~');
                var rdoCode = rdoValues[0];
                var description = rdoValues[1];

                var objRdo = new rdoPropertyJS(rdoCode, description);
                rdoList[k] = objRdo;
                k++;
            } else {
                //alert('2200C not found in array #'+i);
                continue;
            }
        }

    }


    function rdoPropertyJS(rdoCode, description) {
        this.rdoCode = rdoCode;
        this.description = description;
    }

    function getRdo() {

        var data = "<select id='frm1600PT:rdoPg1Pt1I6RDO' name='frm1600PT:rdoPg1Pt1I6RDO' size='1'><option value='000'>000</option>";

        for (var i = 0; i < rdoList.length; i++) {
            var rdo = rdoList[i];
            data = data + "<option value='" + rdo.rdoCode + "'>" + rdo.description + "</option>";
        }
        data = data + "</select>"

        //var data = "<select id='frm1600PT:rdoPg1Pt1I6RDO' name='frm1600PT:rdoPg1Pt1I6RDO' size='1'><option value='000'> </option>";
        $('#rdoContainer').html(data);

    }

    // load profile.xml
    function loadBGXML(loadWhere) {
        try {
            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLBGFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLBGFile.AtEndOfStream) {
                data = "";
            } else {
                var responseBG = d.getElementById('responseBG'); //render file and write to hidden div
                responseBG.innerHTML = XMLBGFile.ReadAll(); //remove XML tag            
            }
            XMLBGFile.Close();
            //alert( responseBG.innerHTML ); //Debug                
            loadBGData(); /*This will load data onto fields*/
        } catch (e) {
            msg.innerHTML = "";
        }
    }

    // load data on controls based on profile.xml
    function loadBGData() {
        /*This will load data onto Background Information fields*/
        var responseBG = d.getElementById("responseBG");

        var formTypeVal = String(responseBG.innerHTML).split('formType='); //form_type

        if (formTypeVal[1] == '1600PTv2018') {
            var fnVal = String(responseBG.innerHTML).split('fn=');
            d.getElementById('frm1600PT:txtPg1Pt1I7WithholdingAgentsName').value = unescape(fnVal[1]).toUpperCase();

            var tin1Val = String(responseBG.innerHTML).split('tin1=');
            //d.getElementById('frm1600PT:txtPg1TIN1').value = tin1Val[1];

            var tin2Val = String(responseBG.innerHTML).split('tin2=');
            // d.getElementById('frm1600PT:txtPg1TIN2').value = tin2Val[1];

            var tin3Val = String(responseBG.innerHTML).split('tin3=');
            //d.getElementById('frm1600PT:txtPg1TIN3').value = tin3Val[1];

            var tin4Val = String(responseBG.innerHTML).split('tin4=');
            //d.getElementById('frm1600PT:txtPg1TIN4').value = tin4Val[1];

            var rdoVal = String(responseBG.innerHTML).split('rdo=');
            d.getElementById('frm1600PT:txtPg1I6RDO').value = rdoVal[1];

            if (rdoVal != "") {
                $('select[id="frm1600PT:rdoPg1Pt1I6RDO"] option[value = ' + rdoVal[1] + ']').attr("selected", "selected");
                document.getElementById("frm1600PT:rdoPg1Pt1I6RDO").disabled = true;
            }

            //            var data = "<select id='frm1600PT:rdoPg1Pt1I6RDO' name='frm1600PT:rdoPg1Pt1I6RDO' disabled='disabled' size='1'><option value='" + rdoVal[1] + "' selected>" + rdoVal[1] + "</option>";
            //            $('#rdoContainer').html(data);
            //if(rdoVal != "")
            //d.getElementById('frm1600PT:rdoPg1Pt1I6RDO').value = rdoVal;

            // Store the value of Main Line of Business for the parent window (frm1600PT:txtPg1Pt1I13MainLine)
            var lobVal = String(responseBG.innerHTML).split('lob=');
            d.getElementById('frm1600PT:txtLOB').value = unescape(lobVal[1]);

            var regAddrVal = String(responseBG.innerHTML).split('regAddr=');
            regAddrVal[1] = unescape(regAddrVal[1].substring(0, regAddrVal[1].length));
            //if (regAddrVal[1].length > 80 && regAddrVal[1].length <= 160) {
			if (regAddrVal[1].length > 80) {
                d.getElementById('frm1600PT:txtPg1Pt1I8RegisteredAddress').value = regAddrVal[1].substring(0, 80);
                //d.getElementById('frm1600PT:txtPg1Pt1I8RegisteredAddress2').value = regAddrVal[1].substring(80, regAddrVal[1].length);
				d.getElementById('frm1600PT:txtPg1Pt1I8RegisteredAddress2').value = regAddrVal[1].substring(80, 160);
            }
            else if (regAddrVal[1].length <= 80) {
                d.getElementById('frm1600PT:txtPg1Pt1I8RegisteredAddress').value = regAddrVal[1];   
                d.getElementById('frm1600PT:txtPg1Pt1I8RegisteredAddress2').value = "";
            }

            var telNoVal = String(responseBG.innerHTML).split('telNo=');
            d.getElementById('frm1600PT:txtPg1Pt1I9ContactNumber').value = telNoVal[1];

            var zipVal = String(responseBG.innerHTML).split('zip=');
            document.getElementById('frm1600PT:txPg1I8ZipCode').value = zipVal[1];
            p3TPZip = zipVal[1];

            if (rdoVal[1] == "000") {
                d.getElementById('frm1600PT:rdoPg1Pt1I6RDO').disabled = false;
            }
                        
            //set TIN & TaxFiler's Name across the page
            var TIN1 = d.getElementsByName('frm1600PT:TIN1');
            var TIN2 = d.getElementsByName('frm1600PT:TIN2');
            var TIN3 = d.getElementsByName('frm1600PT:TIN3');
            var TIN4 = d.getElementsByName('frm1600PT:TIN4');
            TaxFiler = d.getElementsByName('frm1600PT:RegName');

            for (var i = 0; i < TIN1.length; i++) {
                TIN1[i].value = tin1Val[1];
                TIN2[i].value = tin2Val[1];
                TIN3[i].value = tin3Val[1];
                TIN4[i].value = tin4Val[1];
               // TaxFiler[i].value = fnVal[1].toUpperCase();
            }
        }
        var emailVal = String(responseBG.innerHTML).split('email=');
            if(emailVal[1] === undefined)
            {
                document.getElementById('frm1600PT:txtPg1Pt1I11Email').value = "";
            }
            else
            {
                document.getElementById('frm1600PT:txtPg1Pt1I11Email').value = emailVal[1];
                globalEmail = emailVal[1];
            }
    }

    // if file is already existing
    function loadData() {
        /*This will load data onto fields*/
        var response = d.getElementById("response");
        var elem = d.getElementById('frmMain').elements;
       
        var rdoCode;
        for (var i = 0; i < elem.length; i++) {

            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {  //elem[i].type != 'button' &&           
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String($("#response").html()).split(elem[i].id + '=');
                    if (elem[i].id == 'frm1600PT:txtPg1Pt1I7WithholdingAgentsName' || elem[i].id == 'frm1600PT:txtPg1Pt1I13MainLine' || elem[i].id == 'frm1600PT:txtPg1Pt1I8RegisteredAddress') {
                        elem[i].value = unescape(fieldVal[1]);
                    }
                    else if (elem[i].className.indexOf("FinalFlag") > -1) {
                        elem[i].value = typeof (fieldVal[1]) === "undefined" ? "3" : fieldVal[1];
                    }  else if (elem[i].id == 'frm1600PT:txPg1I8ZipCode') {
                        p3TPZip = fieldVal[1];
                        elem[i].value = fieldVal[1];
                        //alert("2==" + p3TPZip);
                    }
                    else {
                        elem[i].value = fieldVal[1]; //all select-one and text values               
                    }

                    if (elem[i].id == 'frm1600PT:rdoPg1Pt1I6RDO') {
                        rdoCode = fieldVal[1];
                    }

					if (String(elem[i].id).indexOf('frm1600PT:txtPg1Pt1I11Region') != -1 || String(elem[i].id).indexOf('frm1600PT:txtPg1Pt1I11Province') != -1) {
                        elem[i].onchange();
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String($("#response").html()).split(elem[i].id + '=');
                    if (rdoVal[1] == 'true') {
                        elem[i].checked = rdoVal[1];
                        //elem[i].onclick(); dgarfin: commented since it hinders the rest of the elements to load its values 
						if (elem[i].id == 'frm1600PT:rdoPg1I10CategoryofWthholdAgentPriv' || elem[i].id == 'frm1600PT:rdoPg1I10CategoryofWthholdAgentGovt') {
							elem[i].onclick();
						}
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String($("#response").html()).split(elem[i].id + '=');
                    if (chkboxVal[1] == 'true') {
                        elem[i].checked = chkboxVal[1];
                    }
                }
                //dgarfin: temporarily commented until modalAtc popup show/hide 
                //if (elem[i].type == 'button' && elem[i].id == 'btnOkPop') {
                //  elem[i].onclick();              
                //}                 
            }

        }

        var data = "<select id='frm1600PT:rdoPg1Pt1I6RDO' name='frm1600PT:rdoPg1Pt1I6RDO' disabled='disabled' size='1'><option value='" + rdoCode + "' selected>" + rdoCode + "</option>";
        $('#rdoContainer').html(data);

        document.getElementById('frm1600PT:txtPg1Pt1I11Email').value = globalEmail;
        document.getElementById('frm1600PT:txtPg1Pt1I11Email').disabled = true;
		
		isAmended();
		availTaxRelief();
		checkATCButton();
		getATCCode();
		window.setTimeout("loadDataATCRow();",105);
    }
	
	function loadDataATCRow() {
		/*This will load data onto fields*/
		var response = d.getElementById("response");
        var elem = document.getElementById('frmMain').elements;
        for(var i = 0; i < elem.length; i++) {

			if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {	//elem[i].type != 'button' &&
				if (elem[i].type == 'text' || elem[i].type == 'select-one') {
					if(elem[i].id != 'frm1600PT:txtPg1Pt1I8RegisteredAddress2'){
						fieldVal = String( $("#response").html() ).split(elem[i].id+'=');
					}else{
						fieldVal = String( $("#response").html() ).split("frm1600PT:txtPg1Pt1I8RegisteredAddress=");
					}

                    if (fieldVal != null && fieldVal.length > 1) {
                        if(elem[i].id == 'frm1600PT:txtPg1Pt1I7WithholdingAgentsName'){
								elem[i].value = unescape(fieldVal[1]);
						}else if(elem[i].id == 'frm1600PT:txtPg1Pt1I8RegisteredAddress'){
								if(fieldVal[1].length <= 127){
									elem[i].value = unescape(fieldVal[1]);
								}
								else {
									elem[i].value = unescape(fieldVal[1].substring(0, 127));
								}
						}else if(elem[i].id == 'frm1600PT:txtPg1Pt1I8RegisteredAddress2'){
								if(fieldVal[1].length <= 127){
									elem[i].value = '';
								}
								else {
									elem[i].value = unescape(fieldVal[1].substring(127, fieldVal[1].length));
								}
						}else if (elem[i].className.indexOf("FinalFlag") > -1) {
                            elem[i].value = typeof (fieldVal[1]) === "undefined" ? "3" : fieldVal[1];
                    	}else{
							elem[i].value = fieldVal[1]; //all select-one and text values		 		
						}
					}		 		
                }
			}
        }
		document.getElementById('frm1600PT:txtPg1Pt1I11Email').value = globalEmail;
	}

    function loadXMLWellFormed(loadWhere) {
        try {

            //This will load the file with filename loadWhere if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLFile = fsoXML.OpenTextFile(loadWhere, 1);
            if (XMLFile.AtEndOfStream)
                data = "";
            else {
                var response = d.getElementById('response'); //render file and write to hidden div
                response.innerHTML = XMLFile.ReadAll(); //remove XML tag
            }
            XMLFile.Close(); //alert( response.innerHTML ); //Debug             
            loadWFData(); /*This will load data onto fields*/
            if (response.innerHTML.indexOf("All Rights Reserved BIR 2014.0") >= 0) {
                gIsReadOnly = true;
            }

            if (gIsReadOnly) {
                d.getElementById('frm1600PT:btnValidate').disabled = true;
                d.getElementById('btnSave').disabled = true;
            }
            window.setTimeout("$('#loader').hide('blind');", 2000);
        } catch (e) {
            //msg.innerHTML = "Save File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadWFData() {
        /*This will load data onto fields*/
        var response = d.getElementById("response");
        var elem = d.getElementById('frmMain').elements;
        for (var i = 0; i < elem.length; i++) {

            if (elem[i].type != 'hidden' && elem[i].type != 'undefined') {  //elem[i].type != 'button' &&           
                if (elem[i].type == 'text' || elem[i].type == 'select-one') {
                    var fieldVal = String(response.innerHTML).split(elem[i].id + '>');
                    // elem[i].value = fieldVal[1]; //all select-one and text values         
                    if (fieldVal != null && fieldVal.length > 1) {
                        elem[i].value = fieldVal[1].substring(0, fieldVal[1].indexOf("</"));
                    }
                }
                if (elem[i].type == 'radio') {
                    var rdoVal = String(response.innerHTML).split(elem[i].id + '>');
                    if (rdoVal[1] == 'true') {
                        // elem[i].checked = rdoVal[1];
                        if (rdoVal != null && rdoVal.length > 1) {
                            elem[i].value = rdoVal[1].substring(0, rdoVal[1].indexOf("</"));
                        }
                        //elem[i].onclick(); dgarfin: commented since it hinders the rest of the elements to load its values 
                    }
                }
                if (elem[i].type == 'checkbox') {
                    var chkboxVal = String(response.innerHTML).split(elem[i].id + '>');
                    if (chkboxVal[1] == 'true') {
                        // elem[i].checked = chkboxVal[1];
                        if (chkboxVal != null && chkboxVal.length > 1) {
                            elem[i].value = chkboxVal[1].substring(0, chkboxVal[1].indexOf("</"));
                        }
                    }
                }
                //dgarfin: temporarily commented until modalAtc popup show/hide 
                //if (elem[i].type == 'button' && elem[i].id == 'btnOkPop') {
                //  elem[i].onclick();              
                //}                 
            }

        }
    }

    var atcList = new Array();

    function atcPropertyJS(formType, atcCode, description, rate, category, base, compType, constTaxDue, minimum, maximum)
    {
        this.formType=formType;
        this.atcCode=atcCode;
        this.description=description;
        this.rate=rate;
        this.category=category;
        this.base=base;
        this.compType=compType;
        this.constTaxDue=constTaxDue;
        this.minimum=minimum;
        this.maximum=maximum;
    }

    function loadXMLATC(fileLocation) {
        try {
            //This will load the ATC file with filename 'fileLocation' if it exists
            var fsoXML = new ActiveXObject("Scripting.FileSystemObject");
            XMLATCFile = fsoXML.OpenTextFile(fileLocation,1);	
	
            if (XMLATCFile.AtEndOfStream)
                data = "";
            else {
                var responseATC = d.getElementById('responseATC'); //render file and write to hidden div
                responseATC.innerHTML = XMLATCFile.ReadAll(); //remove XML tag
            }
            XMLATCFile.Close(); //alert( responseATC.innerHTML ); //Debug			
            loadATC();	/*This will load ATC onto an array*/	
        } catch(e) {
            msg.innerHTML = "ATC File not Found.";
        } //this will Alert File not Found if it doesn't exist
    }

    function loadATC() {
		/*This will load data onto an array*/
		var response = d.getElementById("responseATC");
		
		var atcCnt = String(response.innerHTML).split('atcCount=');
		atcCount = atcCnt[1];
		
		var j = 0;
		//loads atcList from xml
		for (var i = 1; i <= atcCount; i++) { 
			
			var atc = String(response.innerHTML).split('atc'+i+':');
			var atcStr = atc[1];

			if (atcStr.indexOf('1600PTv2018') >= 0) {
			    var atcValues = atcStr.split('~');				
				
				var formType = "1600PTv2018";
				var atcCode = atcValues[0];
				var description = atcValues[1];
				var rate = atcValues[2];
				var category = atcValues[3];
				
				var base = '';
				var compType = '';
				var constTaxDue = '';
				var minimum = '';
				var maximum = '';
				
				var objATC = new atcPropertyJS(formType, atcCode, description, rate, category, base, compType, constTaxDue, minimum, maximum);
				atcList[j] = objATC; 
				j++;
				
			} else {		
				continue;
			}
		}
	}

    function changedrpATCList(elem){
        var i;

        if(elem == "P")
        {  // change ATClist
            getPrivateWithholdingAgentATC();
			//resetAllPartIIATC(false);
        }else if(elem == "G")
        {
            // change ATClist
            getGovernmentWithholdingAgentATC();
			//resetAllPartIIATC(false);
        }
        
