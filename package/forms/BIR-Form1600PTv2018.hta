																		</br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Not over 25%
																		</br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Over 25% but not exceeding 33 1/3%
																		</br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Over 33 1/3%</span>
																</td>
																<td align="center" style="width: 15%; border-left: #000000 1px solid; border-bottom: #000000 1px solid; border-right: #000000 1px solid;">
																	<span style="font-size: 8pt"></br>4%</br>2%</br>1%</br></span>
																</td>
																<td align="center" style="width: 15%; border-left: #000000 1px solid; border-bottom: #000000 1px solid; border-right: #000000 1px solid;">
																	<span style="font-size: 8pt"></br>WB 201</br>WB 202</br>WB 203</br></span>
																</td>
															</tr>
															<tr>
																<td align="left" style="width: 70%; border-left: #000000 1px solid; border-bottom: #000000 1px solid; border-right: #000000 1px solid;">
