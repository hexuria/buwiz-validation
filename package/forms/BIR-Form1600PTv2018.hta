                                " <input type='text' id='frm1600PT:txtAtcCd"+iCtr+"' style='text-align: center; width:10em !important' value='"+ d.getElementById('AtcCode'+i).value + "' readonly/>&nbsp;&nbsp;&nbsp;</td>" +
                            "<td> <input type='text' id='frm1600PT:txtPg1P2TaxBase"+iCtr+"' style='width:17em !important; text-align:right' onkeypress='return numbersonly(this, event)' onblur='getRequiredWithheld("+iCtr+");round(this,2);' value='"+ taxbasetemp + "'/> </td>" +
                            "<td> <input type='text' id='frm1600PT:txtPg1P2TaxRate"+iCtr+"' style='text-align: center' onkeypress='return numbersonly(this, event)' onblur='getRequiredWithheld("+iCtr+"); round(this,2);' value='"+ d.getElementById('txtRate'+i).innerHTML +"' readonly/><font size='2' style='font-weight:bold'>&nbsp;%</font>&nbsp;&nbsp;&nbsp;&nbsp;</td>"+
                            "<td> <input type='text' id='frm1600PT:txtPg1P2TaxWithheld"+iCtr+"' style='text-align:right; width:16em !important' value='0.00' readonly /> </td>" +
