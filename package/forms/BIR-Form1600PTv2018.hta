    $(document).ready(function () {
        $('input[id="frm1600PT:txtPg1Pt2I23CommunityTax"], input[maxlength="3"], input[id*=frm1600PT\\:txtPg2Pt6I49BIRAccreditedNo] ').bind('paste', function (e) {
