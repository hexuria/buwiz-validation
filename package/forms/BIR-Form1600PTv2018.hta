							}
							waitstr = setTimeout("setInputTextControl_NumberFormatter('frm1600PT:txtPg1P2TaxBase"+iCtr2+"', 15, 2); d.getElementById('frm1600PT:txtPg1P2TaxBase"+iCtr2+"').value = '" + taxbasetemp + "'" , 100);
							waitstr = setTimeout("setInputTextControl_NumberFormatter('frm1600PT:txtPg1P2TaxWithheld"+iCtr2+"', 15, 2); getRequiredWithheld(" + iCtr2 + ");", 100);
							iCtr2++;
                        }
                    }
                }
            }
			
            setTimeout("computeTotalOtherWithheldTax()", 100);
			setTimeout("pageOneTaxWithheldComputation()", 100);
            cancelPartIIATC();
        }catch(e){
            alert('exception : '+e.message);
        }
    }



