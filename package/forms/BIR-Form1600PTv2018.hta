        getAmount("frm1600PT:txtPg5S5I5TotalAllowable"),
        specialAllowableItemizedDeductionsList);


		var txtPg3Pt6S3I3Col2 = getAmount("frm1600PT:txtPg3Pt6S3I3Col2");
