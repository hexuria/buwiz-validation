    <form id="frmMain" name="frmMain">
    <div id="container">
        <div id="wrapper" style="margin: 0 auto; position: relative; width: 800px;">
            <table border="0" cellspacing="0" style="width:800px" cellpadding="0" align="center" cellspacing="0" style="background-image: url(../img/frmbg.png);
                background-repeat: repeat-x;">
                <tr>
                    <td>
                        <div id="formPaper">
                            <div id="containerPage">
                                <div id="Page1Content" style="margin: 0; display: block; position: relative; width: 820px;" class="noCellSpace">
                                    <table style="width: 820px;" border="0" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <td>
                                                <table border="0" cellspacing="0" cellpadding="0" style="height: 0px;">
                                                    <tr>
                                                        <td>
                                                            <table width="800" border="0" cellspacing="0" cellpadding="0">
                                                                <tr>
                                                                    <td width="300" valign="bottom">
                                                                        <p><img src="../img/bcs_new.png" width="80" /> </p>
                                                                    </td>
                                                                    <td>
                                                                        <p><img src="../img/header_logo.png" width="210" height="50px" /> </p>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <table class="FormHeader" border="0" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td>
                                                            <span class="FormHeader2">BIR Form No.<br />
                                                            </span><span class="FormHeader1" style="font-weight: bold;">1600-PT</span><br />
                                                            <span class="FormHeader2">January 2018</span>
                                                            <!--<span class="FormHeader2" style="font-weight: bold;">v2</span>-->
															<br />
                                                            <span class="FormHeader2" style="font-weight: bold;">Page 1</span>
                                                        </td>
                                                        <td style="border-right: 1px solid black;">
                                                            <span class="FormHeader1" style="font-weight: bold;">Monthly Remittance Return</span><br />
                                                            <span class="FormHeader1" style="font-weight: bold;">of Other Percentage Taxes Withheld</span><br />
                                                            <span class="FormHeader3" style="font-style: italic;">Enter all required information in CAPITAL LETTERS using BLACK ink. Mark applicable boxes with an "X".<br />
                                                                Two copies MUST be filled with the BIR and one held by the Taxpayer.</span>
                                                        </td>
                                                        <td>
                                                            <img alt="barcode" src="../img/1600PTv2018_BarCode/1600PTv2018_p1.png" style="height: 45px; width: 200px" />
                                                            <span class="xsmallBold">
                                                            	</br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
																&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
																&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1600-PT 01/18 P1</span>
														</td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <table class="tblForm" cellpadding="0" cellspacing="0">
                                                    <tr>
                                                        <td class="RowSubTable" valign="top" colspan="4">
                                                            <table class="RowSubTable" >
                                                                <tr>
                                                                    <td class="RowSubTable" valign="top">
                                                                        <table class="RowSubTable" width="100%">
                                                                            <tr>
                                                                                <td>
                                                                                    <span class="ContentBold">1</span> 
                                                                                    <span class="xsmall">For the month </br>&nbsp;&nbsp;&nbsp;(MM/20YY)</span>
                                                                                </td>
                                                                                <td colspan="3">
                                                                                    <select id="frm1600PT:txtPg1I1Month" name="frm1600PT:txtPg1I1Month" onchange="checkDate();" size="1" >
                                                                                        <option selected="selected" value="00">00</option>
                                                                                        <option value="01">01</option>
                                                                                        <option value="02">02</option>
                                                                                        <option value="03">03</option>
                                                                                        <option value="04">04</option>
                                                                                        <option value="05">05</option>
                                                                                        <option value="06">06</option>
                                                                                        <option value="07">07</option>
                                                                                        <option value="08">08</option>
                                                                                        <option value="09">09</option>
                                                                                        <option value="10">10</option>
                                                                                        <option value="11">11</option>
                                                                                        <option value="12">12</option>
                                                                                    </select>
                                                                                    <span class="small" style="vertical-align: top;">/20</span>
                                                                                    <input id="frm1600PT:txtPg1I1Year" maxlength="2" name="frm1600PT:txtPg1I1Year"
                                                                                        size="1" type="text" value="" onkeypress="return wholenumber(this, event)" onblur="checkDate();" />
                                                                                </td>
                                                                            </tr>
                                                                        </table>
                                                                    </td>
                                                                    <td class="RowSubTable" valign="top">
                                                                        <table class="RowSubTable">
                                                                            <tr>
                                                                                <td class="Content" colspan="2">
                                                                                    <span class="ContentBold">2</span> <span class="xsmall">Amended Return?</span>
                                                                                    <input id="frm1600PT:rdoPg1I2AmendedYes" name="frm1600PT:rdoPg1I2Amended" type="radio"
                                                                                        value="Y" class="styled" onclick="isAmended();" />
                                                                                    Yes
                                                                                    <input checked="checked" id="frm1600PT:rdoPg1I2AmendedNo" name="frm1600PT:rdoPg1I2Amended"
                                                                                        type="radio" value="N" class="styled" onclick="isAmended();" />
                                                                                    No
                                                                                </td>
                                                                            </tr>
                                                                        </table>
                                                                    </td>
                                                                    <td class="RowSubTable" valign="top">
                                                                        <table class="RowSubTable">
                                                                            <tr>
                                                                                <td class="Content" colspan="2">
                                                                                    <span class="ContentBold">3</span> <span class="xsmall">Any Tax Withheld?</span>
                                                                                    <input id="frm1600PT:rdoPg1I3TaxWithheldYes" name="frm1600PT:rdoPg1I3TaxWithheld"
                                                                                        type="radio" value="Y" class="styled" onclick="taxWheldFlag = true;checkATCButton();" />
                                                                                    <!-- DO POPUP EVENT (onclick) WHEN YES IS SELECTED -->
                                                                                    Yes
                                                                                    <input checked="checked" id="frm1600PT:rdoPg1I3TaxWithheldNo" name="frm1600PT:rdoPg1I3TaxWithheld"
                                                                                        type="radio" value="N" class="styled" onclick="changeTaxWithheldNO();" />
                                                                                    No
																				</td>
                                                                            </tr>
                                                                        </table>
                                                                    </td>
                                                                    <td class="RowSubTable" valign="top">
                                                                        <table class="RowSubTable">
                                                                            <tr>
                                                                                <td class="Content">
                                                                                    <span class="ContentBold">4</span> <span class="xsmall">Number of </br>&nbsp;&nbsp;&nbsp;&nbsp;Sheet/s Attached</span>
                                                                                </td>
																				<td align="center">
																					<input id="frm1600PT:txtPg1I4NoOfSheets" maxlength="2" name="frm1600PT:txtPg1I4NoOfSheets"
                                                                                        size="1" type="text" value="0" onkeypress="return wholenumber(this, event)" style="text-align: center;" />
																				</td>
                                                                            </tr>
                                                                        </table>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="tblFormTdPart" style="border-bottom: #000000 2px solid; border-top: #000000 2px solid;">
                                                            <table class="ContentHeader">
                                                                <tr>
                                                                    <td width="100%">
                                                                        <div align="center">
                                                                            <font size="2" style="font-weight:bold;">Part I - Background Information </font>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="RowSubTable" colspan="5">
                                                            <span class="ContentBold">5</span>
                                                            <span class="small">Taxpayer Identification Number (TIN)</span>
                                                            <input id="frm1600PT:txtPg1TIN1" name="frm1600PT:TIN1" size="4" disabled="disabled" />
															<span class="xlarge">-</span>
                                                            <input id="frm1600PT:txtPg1TIN2" name="frm1600PT:TIN2" size="4" disabled="disabled" />
															<span class="xlarge">-</span>
                                                            <input id="frm1600PT:txtPg1TIN3" name="frm1600PT:TIN3" size="4" disabled="disabled" />
                                                            <span class="xlarge">-</span> 
                                                            <input id="frm1600PT:txtPg1TIN4" name="frm1600PT:TIN4" size="4" disabled="disabled" />
															<!-- <span style="display: none;">
															<input id="BranchMask" value="00000" size="4" disabled="disabled" /> -->
                                                            </span>
                                                            
                                                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                                            <span class="ContentBold">6</span>
                                                            <span class="small">RDO Code</span>
                                                            <input type="text" id="frm1600PT:txtPg1I6RDO" name="frm1600PT:txtPg1I6RDO"
                                                                style="display: none;" />
                                                            <div id="rdoContainer" style="display: inline;">
                                                            </div>
                                                        </td>
                                                    </tr>                                  
                                                    <tr>
                                                        <td class="RowSubTable" colspan="5">
                                                            <table class="RowSubTable">
                                                                <tr>
