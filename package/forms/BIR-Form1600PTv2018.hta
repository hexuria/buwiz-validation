                            "<td> <input type='text' id='frm1600PT:txtPg1P2TaxBase"+iCtr2+"' style='width:17em !important; text-align:right' onkeypress='return numbersonly(this, event)' onblur='round(this,2); getRequiredWithheld("+iCtr2+"); pageOneComputation(); computeTotalOtherWithheldTax();' value='"+ taxbasetemp + "'/> </td>" +
                            "<td> <input type='text' id='frm1600PT:txtPg1P2TaxRate"+iCtr2+"' style='text-align: center' onkeypress='return numbersonly(this, event)' onblur='round(this,2); getRequiredWithheld("+iCtr2+"); pageOneComputation(); computeTotalOtherWithheldTax()' value='"+ d.getElementById('txtRate'+i).innerHTML +"' readonly /><font size='2' style='font-weight:bold'>&nbsp;%</font>&nbsp;&nbsp;&nbsp;&nbsp;</td>"+
