		txtPg5S4I39Col2,
		otherList,
		getAmount("frm1600PT:txtPg5S4I40TotalAllowableDeduction"));

		var txtPg3Pt6S2I4Col2 = getValue("frm1600PT:txtPg3Pt6S2I4LegalBasis");
		var txtPg3Pt6S2I4Col3 = getAmount("frm1600PT:txtPg3Pt6S2I4Amount");
		//Schedule5 Iteration
		var i = Pg3Pt6S2I4_Col1.length;
		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfSpecialAllowableItemizedDeductions(Pg3Pt6S2I4_Col1[x], Pg3Pt6S2I4_Col2[x], fixAmount(Pg3Pt6S2I4_Col3[x]));
			}
