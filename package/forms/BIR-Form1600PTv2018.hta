    function validate() {

        if (validateAll()) {
            alert("Validation successful. Click on Edit if you wish to modify your entries.");
            getDisabledText();
            disableAllControl();
            document.getElementById("frm1600PT:btnEdit").disabled = false;
            document.getElementById("btnUpload").disabled = false;
            document.getElementById("frm1600PT:btnFinalCopy").disabled = false;
            document.getElementById("frm1600PT:btnValidate").disabled = true;
            document.getElementById("frm1600PT:btnPrevPage").disabled = false;
            document.getElementById("frm1600PT:btnNextPage").disabled = false;
            document.getElementById("btnSave").disabled = false;
            document.getElementById("btnPrint").disabled = false;
            document.getElementById("btnCancelSubmit").disabled = false;
            document.getElementById("CloseGuidlinesPage").disabled = false;    
            d.getElementById('mnuPrint').disabled = false;
            document.getElementById("ebironline").disabled = false;
            document.getElementById("efps").disabled = false;
            //document.onmouseup();
            return;
        }
        else {
            document.getElementById("frm1600PT:btnEdit").disabled = true;
            document.getElementById("btnUpload").disabled = true;
            document.getElementById("frm1600PT:btnFinalCopy").disabled = true;
            document.getElementById("btnPrint").disabled = true;
            d.getElementById('mnuPrint').disabled = true;
        };
        
    }

    function initialValidateBeforeSave() {
        //validation here
        //return true to save
		if (d.getElementById('frm1600PT:txtPg1I1Month').value === "00" || d.getElementById('frm1600PT:txtPg1I1Year').value === "") { alert("Please enter date on Item 1."); return false; }
        if (d.getElementById('frm1600PT:rdoPg1Pt1I6RDO').value === "000") { alert("Please enter a valid RDO Code on Item 6."); return false; }
        if (!checkMandatory("frm1600PT:txtPg1Pt1I7WithholdingAgentsName", "Please enter a valid name on Page 1 Item 7.")) return false;
        if (!checkMandatory("frm1600PT:txtPg1Pt1I8RegisteredAddress", "Please enter a valid Registered Address on Page 1 Item 8.")) return false;
        if (!checkMandatory("frm1600PT:txtPg1Pt1I9ContactNumber", "Please enter a valid Contact Number on Page 1 Item 9.")) return false;
		if (d.getElementById('frm1600PT:rdoPg1I10CategoryofWthholdAgentPriv').checked == false && 
			d.getElementById('frm1600PT:rdoPg1I10CategoryofWthholdAgentGovt').checked == false){alert("Please select category of agent on Item 10."); return false; }

        return true;
    }

    //topNav
    $(document).ready(function () {

        $("ul.subnav").parent().append("<span></span>"); //Only shows drop down trigger when js is enabled (Adds empty span tag after ul.subnav*)  
        $("ul.topnav li span").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
        $("ul.topnav .toplevel").click(function () { //When trigger is clicked...            
            //Following events are applied to the subnav itself (moving subnav up and down)  
            $(this).parent().find("ul.subnav").slideDown('fast').show(); //Drop down the subnav on click    
            $(this).parent().hover(function () {
            }, function () {
                $(this).parent().find("ul.subnav").slideUp('slow'); //When the mouse hovers out of the subnav, move it back up  
            });
            //Following events are applied to the trigger (Hover events for the trigger)  
        }).hover(function () {
            $(this).addClass("subhover"); //On hover over, add class "subhover"  
        }, function () {  //On Hover Out  
            $(this).removeClass("subhover"); //On hover out, remove class "subhover"  
        });
    });


    function createXMLProfileName() {
        try {
            var xmlFileName = "";

            var titleTin1 = d.getElementById('frm1600PT:txtPg1TIN1');
            var titleTin2 = d.getElementById('frm1600PT:txtPg1TIN2');
            var titleTin3 = d.getElementById('frm1600PT:txtPg1TIN3');
            var titleBranchCode = d.getElementById('frm1600PT:txtPg1TIN4');
            var titleTPName = d.getElementById('frm1600PT:txtPg1Pt1I7WithholdingAgentsName');
            var formType = "1600PTv2018";

            xmlFileName = "profile/" + titleTin1.value + titleTin2.value + titleTin3.value + titleBranchCode.value + ".xml";

            return xmlFileName;
        } catch (e) {
            alert('Exception : ' + e.description);
        }
    }

    function saveXMLProfile(isFinalCopy) {
        if (gIsReadOnly == false) {
            var xmlFileName = createXMLProfileName();

            msg.innerHTML = 'Generating File...';
            var fileSys = new ActiveXObject("Scripting.FileSystemObject");
            var xmlFile = fileSys.CreateTextFile(xmlFileName); //(saveWhere);

            var allXML = "<?xml version='1.0'?>", tab = d.getElementById('xmlFormat').innerHTML;
            allXML += tab; //adds line break            

            allXML += "<div>fn=" + escape(d.getElementById('frm1600PT:txtPg1Pt1I7WithholdingAgentsName').value) + "fn=</div>" + tab;
            allXML += "<div>tin2=" + d.getElementById('frm1600PT:txtPg1TIN2').value + "tin2=</div>" + tab;
            allXML += "<div>tin3=" + d.getElementById('frm1600PT:txtPg1TIN3').value + "tin3=</div>" + tab;
            allXML += "<div>tin1=" + d.getElementById('frm1600PT:txtPg1TIN1').value + "tin1=</div>" + tab;
            allXML += "<div>tin4=" + d.getElementById('frm1600PT:txtPg1TIN4').value + "tin4=</div>" + tab;
            allXML += "<div>rdo=" + d.getElementById('frm1600PT:txtPg1I6RDO').value + "rdo=</div>" + tab;
            allXML += "<div>lob=" + d.getElementById('frm1600PT:txtLOB').value + "lob=</div>" + tab;
            allXML += "<div>regAddr=" + escape(d.getElementById('frm1600PT:txtPg1Pt1I8RegisteredAddress').value)
                                      //+ escape(d.getElementById('frm1600PT:txtPg1Pt1I8RegisteredAddress2').value)
                                      + escape(d.getElementById('frm1600PT:txtPg1Pt1I8RegisteredAddress2').value)+ "regAddr=</div>" + tab;

            //No Zip for 2200C, just get it from var p3TPZip
            allXML += "<div>zip=" + p3TPZip + "zip=</div>" + tab;

            allXML += "<div>telNo=" + d.getElementById('frm1600PT:txtPg1Pt1I9ContactNumber').value + "telNo=</div>" + tab;
            allXML += "<div>email="+document.getElementById('frm1600PT:txtPg1Pt1I11Email').value+"email=</div>"+tab;allXML += "<div>confirmemail="+document.getElementById('frm1600PT:txtPg1Pt1I11Email').value+"confirmemail=</div>"+tab;
            allXML += "<div>confirmtin1=" + d.getElementById('frm1600PT:txtPg1TIN1').value + "confirmtin1=</div>" + tab;
            allXML += "<div>confirmtin2=" + d.getElementById('frm1600PT:txtPg1TIN2').value + "confirmtin2=</div>" + tab;
            allXML += "<div>confirmtin3=" + d.getElementById('frm1600PT:txtPg1TIN3').value + "confirmtin3=</div>" + tab;
            allXML += "<div>confirmtin4=" + d.getElementById('frm1600PT:txtPg1TIN4').value + "confirmtin4=</div>" + tab;
            allXML += "<div>formType=2200Cv2018formType=</div>" + tab;

            allXML += tab + d.getElementById('xmlClose').innerHTML;

            xmlFile.write(allXML);
            xmlFile.close();
            msg.innerHTML = '';

            if (isFinalCopy == false) {
                alert('Background information saved/updated successfully as : ' + xmlFileName);
            }
        }
    }
