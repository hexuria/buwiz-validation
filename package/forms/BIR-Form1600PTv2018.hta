        getAmount("frm1600PT:txtPg2Pt4I35OrdinaryAllowable"),
        true,
        getAmount("frm1600PT:txtPg2Pt4I33AddOther"),
        getAmount("frm1600PT:txtPg2Pt4I36SpecialAllowable"),
        true,
            '0',
        getAmount("frm1600PT:txtPg2Pt4I34TotalGross"),
        getAmount("frm1600PT:txtPg2Pt4I41TotalIncome"),
        getAmount("frm1600PT:txtPg2Pt4I37TotalItemized"),
            '0');

            populateTaxReliefAvailment(getAmount("frm1600PT:txtPg2Pt5I42RegularIncome"),
        getAmount("frm1600PT:txtPg2Pt5I43SpecialAllowable"),
        getAmount("frm1600PT:txtPg2Pt5I44TotalTax"));

            populateExternalAuditorAccreditedTaxAgentBean(getValue("frm1600PT:txtPg2Pt6I45NameofExternalAuditor"),
        getValue("frm1600PT:txtPg2Pt6I46TinC1") + getValue("frm1600PT:txtPg2Pt6I46TinC2") + getValue("frm1600PT:txtPg2Pt6I46TinC3"),
        getValue("frm1600PT:txtPg2Pt6I47NameofSigningPartner"),
        getValue("frm1600PT:txtPg2Pt6I48TinC1") + getValue("frm1600PT:txtPg2Pt6I48TinC2") + getValue("frm1600PT:txtPg2Pt6I48TinC3"),
        getValue("frm1600PT:txtPg2Pt6I49BIRAccreditedNoC1") + getValue("frm1600PT:txtPg2Pt6I49BIRAccreditedNoC2") + getValue("frm1600PT:txtPg2Pt6I49BIRAccreditedNoC3") + getValue("frm1600PT:txtPg2Pt6I49BIRAccreditedNoC4"),
        convertDateXML("txtPg2Pt6I50IssueDate"),
        convertDateXML("txtPg2Pt6I51ExpiryDate"),
        getValue("frm1600PT:txtPg2Pt6I46TinC4"),
        getValue("frm1600PT:txtPg2Pt6I48TinC4"));

            //Schedule1                     
            populateSalesRevenueBean(getAmount("frm1600PT:txtPg3S1I1GoodsProp"),
        getAmount("frm1600PT:txtPg3S1I2SaleServices"),
        getAmount("frm1600PT:txtPg3S1I3LeaseProp"),
        getAmount("frm1600PT:txtPg3S1I4Total"),
        getAmount("frm1600PT:txtPg3S1I5LessSales"),
        getAmount("frm1600PT:txtPg3S1I6NetSales"));

            //Schedule2                     
            populateCostOfSaleBean(getAmount("frm1600PT:txtPg3S2I1MerchInventory"),
        getAmount("frm1600PT:txtPg3S2I2AddPurchases"),
        getAmount("frm1600PT:txtPg3S2I3TotalGoods"),
        getAmount("frm1600PT:txtPg3S2I4LessMerch"),
        getAmount("frm1600PT:txtPg3S2I5CostSales"),
        getAmount("frm1600PT:txtPg3S2I6DirectMaterials"),
        getAmount("frm1600PT:txtPg3S2I7AddPurchases"),
        getAmount("frm1600PT:txtPg3S2I8MaterialsAvailable"),
        getAmount("frm1600PT:txtPg3S2I9DirectMaterials"),
        getAmount("frm1600PT:txtPg3S2I10RawMaterials"),
        getAmount("frm1600PT:txtPg3S2I11DirectLabor"),
        getAmount("frm1600PT:txtPg3S2I12ManOverhead"),
        getAmount("frm1600PT:txtPg3S2I13TotalMan"),
        getAmount("frm1600PT:txtPg3S2I14WorkProcess"),
        getAmount("frm1600PT:txtPg3S2I15LessWork"),
        getAmount("frm1600PT:txtPg3S2I16CostOfGoods"),
        getAmount("frm1600PT:txtPg3S2I17FinishedGoods"),
        getAmount("frm1600PT:txtPg3S2I18LessFinished"),
        getAmount("frm1600PT:txtPg3S2I19GoodsManAndSold"),
        getAmount("frm1600PT:txtPg3S2I20DirectWage"),
        getAmount("frm1600PT:txtPg3S2I21DirectMaterials"),
        getAmount("frm1600PT:txtPg3S2I22DirectDepreciation"),
        getAmount("frm1600PT:txtPg3S2I23DirectRental"),
        getAmount("frm1600PT:txtPg3S2I24DirectOutside"),
        getAmount("frm1600PT:txtPg3S2I25DirectOthers"),
        getAmount("frm1600PT:txtPg3S2I26TotalCostServices"),
        getAmount("frm1600PT:txtPg3S2I27TotalCostSales"));

		var txtPg3Pt6S1I17Col1 = getValue("frm1600PT:txtPg3Pt6I17OthersIDesc");
		//Schedule4P1 Iteration
		var i = Pg3Pt6S1I17_Col1.length;

		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfAmortization(Pg3Pt6S1I17_Col1[x], fixAmount(Pg3Pt6S1I17_Col2[x]));
			}
			txtPg3Pt6S1I17Col1 = Pg3Pt6S1I17_Col1[0];
			txtPg3Pt6S1I17Col2 = fixAmount(Pg3Pt6S1I17_Col2[0]);
		}
		var txtPg5S4I39Col1 = getValue("frm1600PT:txtPg5S4I39Col1");
		//Schedule4P2 Iteration
		var i = Pg5S4I39_Col1.length;
		if (i > 1) {
			for (x = 1; x < i; x++) {
				populateListOfOthers(Pg5S4I39_Col1[x], fixAmount(Pg5S4I39_Col2[x]));
			}
			txtPg5S4I39Col1 = Pg5S4I39_Col1[0];
			txtPg5S4I39Col2 = fixAmount(Pg5S4I39_Col2[0]);
		}
		//Schedule4
		populateSchedule4(getAmount("frm1600PT:txtPg4S4I1AdsAndPromotions"),
