        for (var i = 0; i < rows.length; i++) {
            if (rows[i].cells.length < 3) continue;

            var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
            var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

            var description = manualTrim(descriptionInput.value);
            var amount = manualTrim(amountInput.value);

            if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                count += 1; // Increment count for invalid rows
            } else {
                specify56ToCommit.push({
                    txtSpecifyNo56Description: description,
                    txtSpecifyNo56Amount: parseFloat(amount).toFixed(2)
                });
