    // NUMBER 5 - AMENDED RETURN 
    function validateAmendedReturn() {
        if (d.getElementById('frm2550qv2024:amendedReturnYesNo5').checked) {
            d.getElementById('frm2550qv2024:vatPaidReturn').disabled = false;
        } else if (d.getElementById('frm2550qv2024:amendedReturnNo5').checked) {
            d.getElementById('frm2550qv2024:vatPaidReturn').disabled = true;
            d.getElementById('frm2550qv2024:vatPaidReturn').value = "0.00";
        }
    }

    function RtnPeriodFromNo4(elem) {
        var month = d.getElementById('frm2550qv2024:selectedMonthNo2');

        if (elem.id == "frm2550qv2024:calendarNo1") {
            month.value = "12";
            month.disabled = true;
        } else {
            month.value = "0";
            month.disabled = false;
        }
    }


    function changeYear() {
        var month = d.getElementById('frm2550qv2024:selectedMonthNo2');
        var year = d.getElementById('frm2550qv2024:txtYearNo2');
        var days = daysInMonth((month.value - 1), year.value);

        if (year.value != "") {
            // Check if the calendar year is selected
            if (d.getElementById('frm2550qv2024:calendarNo1').checked) {

                // Check if no quarter is selected
                if (!d.getElementById('frm2550qv2024:OptQuarter1').checked &&
                    !d.getElementById('frm2550qv2024:OptQuarter2').checked &&
                    !d.getElementById('frm2550qv2024:OptQuarter3').checked &&
                    !d.getElementById('frm2550qv2024:OptQuarter4').checked) {
                    // No quarter selected, so clear the return period fields
                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = "";
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = "";
                    return;  // Exit the function early, since no quarter is selected
                }

                var selectedMonth = parseInt(month.value, 10);
                var selectedYear = parseInt(year.value, 10);

                // Calculate the first quarter's start and end months dynamically
                var firstQuarterStartMonth = selectedMonth + 1; // Start from the month after the selected month
                if (firstQuarterStartMonth > 12) {
                    firstQuarterStartMonth = 1; // If it exceeds December, start from January of next year
                }

                // End month of the first quarter is 2 months after the start month
                var firstQuarterEndMonth = firstQuarterStartMonth + 2;
                if (firstQuarterEndMonth > 12) {
                    firstQuarterEndMonth -= 12; // Wrap around the year
                }

                // Set the return period for the first quarter
                var firstQuarterStartDate = firstQuarterStartMonth + "/01/" + selectedYear;
                var firstQuarterEndDate = firstQuarterEndMonth + "/" + daysInMonth(firstQuarterEndMonth - 1, selectedYear) + "/" + selectedYear;

                // Handle quarter 1 return period if selected
                if (d.getElementById('frm2550qv2024:OptQuarter1').checked) {
                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = firstQuarterStartDate;
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = firstQuarterEndDate;
                }

                // Handle second, third, and fourth quarters similarly, adjusting months based on selected first quarter
                if (d.getElementById('frm2550qv2024:OptQuarter2').checked) {
                    var secondQuarterStartMonth = firstQuarterEndMonth + 1;
                    if (secondQuarterStartMonth > 12) {
                        secondQuarterStartMonth -= 12;
                    }
                    var secondQuarterEndMonth = secondQuarterStartMonth + 2;
                    if (secondQuarterEndMonth > 12) {
                        secondQuarterEndMonth -= 12;
                    }

                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = secondQuarterStartMonth + "/01/" + selectedYear;
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = secondQuarterEndMonth + "/" + daysInMonth(secondQuarterEndMonth - 1, selectedYear) + "/" + selectedYear;
                } else if (d.getElementById('frm2550qv2024:OptQuarter3').checked) {
                    var thirdQuarterStartMonth = firstQuarterEndMonth + 4;
                    if (thirdQuarterStartMonth > 12) {
                        thirdQuarterStartMonth -= 12;
                    }
                    var thirdQuarterEndMonth = thirdQuarterStartMonth + 2;
                    if (thirdQuarterEndMonth > 12) {
                        thirdQuarterEndMonth -= 12;
                    }

                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = thirdQuarterStartMonth + "/01/" + selectedYear;
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = thirdQuarterEndMonth + "/" + daysInMonth(thirdQuarterEndMonth - 1, selectedYear) + "/" + selectedYear;
                } else if (d.getElementById('frm2550qv2024:OptQuarter4').checked) {
                    var fourthQuarterStartMonth = firstQuarterEndMonth + 7;
                    if (fourthQuarterStartMonth > 12) {
                        fourthQuarterStartMonth -= 12;
                    }
                    var fourthQuarterEndMonth = fourthQuarterStartMonth + 2;
                    if (fourthQuarterEndMonth > 12) {
                        fourthQuarterEndMonth -= 12;
                    }

                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = fourthQuarterStartMonth + "/01/" + selectedYear;
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = fourthQuarterEndMonth + "/" + daysInMonth(fourthQuarterEndMonth - 1, selectedYear) + "/" + selectedYear;
                }

            } else if (d.getElementById('frm2550qv2024:fiscalNo1').checked) {
                var testMonthValue = d.getElementById('frm2550qv2024:selectedMonthNo2').value;

                var monthFrom = parseFloat(testMonthValue);
                var yearFrom = parseInt(year.value) - 1;
                var monthTo;
                var yearTo;
                var tempMonthDay;

                if (d.getElementById('frm2550qv2024:OptQuarter1').checked) {

                    monthFrom = monthFrom + 1;
                    if (monthFrom > 12) {
                        monthFrom = (monthFrom - 12);
                        monthTo = monthFrom + 2;
                        yearFrom = yearFrom + 1;
                    }

                    if (monthFrom == 11) {
                        monthTo = 1;
                    } else if (monthFrom == 12) {
                        monthTo = 2;
                    } else {
                        monthTo = monthFrom + 2;
                    }

                    if (monthFrom > monthTo) {
                        yearTo = yearFrom + 1;
                    } else {
                        yearTo = yearFrom;
                    }

                    monthFrom = addzero(monthFrom);
                    monthTo = addzero(monthTo);

                    tempMonthDay = monthTo - 1;

                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = monthFrom + "/01/" + yearFrom;
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = monthTo + "/" + daysInMonth(tempMonthDay, yearTo) + "/" + yearTo;
                } else if (d.getElementById('frm2550qv2024:OptQuarter2').checked) {
                    monthFrom = monthFrom + 4;
                    if (monthFrom > 12) {
                        monthFrom = (monthFrom - 12);
                        monthTo = monthFrom + 2;
                        yearFrom = yearFrom + 1;
                    }

                    if (monthFrom == 11) {
                        monthTo = 1;
                    } else if (monthFrom == 12) {
                        monthTo = 2;
                    } else {
                        monthTo = monthFrom + 2;
                    }

                    if (monthFrom > monthTo) {
                        yearTo = yearFrom + 1;
                    } else {
                        yearTo = yearFrom;
                    }

                    monthFrom = addzero(monthFrom);
                    monthTo = addzero(monthTo);

                    tempMonthDay = monthTo - 1;

                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = monthFrom + "/01/" + yearFrom;
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = monthTo + "/" + daysInMonth(tempMonthDay, yearTo) + "/" + yearTo;
                } else if (d.getElementById('frm2550qv2024:OptQuarter3').checked) {
                    monthFrom = monthFrom + 7;
                    if (monthFrom > 12) {
                        monthFrom = (monthFrom - 12);
                        monthTo = monthFrom + 2;
                        yearFrom = yearFrom + 1;
                    }

                    if (monthFrom == 11) {
                        monthTo = 1;
                    } else if (monthFrom == 12) {
                        monthTo = 2;
                    } else {
                        monthTo = monthFrom + 2;
                    }

                    if (monthFrom > monthTo) {
                        yearTo = yearFrom + 1;
                    } else {
                        yearTo = yearFrom;
                    }

                    monthFrom = addzero(monthFrom);
                    monthTo = addzero(monthTo);

                    tempMonthDay = monthTo - 1;

                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = monthFrom + "/01/" + yearFrom;
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = monthTo + "/" + daysInMonth(tempMonthDay, yearTo) + "/" + yearTo;
                } else if (d.getElementById('frm2550qv2024:OptQuarter4').checked) {
                    monthFrom = monthFrom + 10;
                    if (monthFrom > 12) {
                        monthFrom = (monthFrom - 12);
                        monthTo = monthFrom + 2;
                        yearFrom = yearFrom + 1;
                    }

                    if (monthFrom == 11) {
                        monthTo = 1;
                    } else if (monthFrom == 12) {
                        monthTo = 2;
                    } else {
                        monthTo = monthFrom + 2;
                    }

                    if (monthFrom > monthTo) {
                        yearTo = yearFrom + 1;
                    } else {
                        yearTo = yearFrom;
                    }

                    monthFrom = addzero(monthFrom);
                    monthTo = addzero(monthTo);

                    tempMonthDay = monthTo - 1;

                    d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = monthFrom + "/01/" + yearFrom;
                    d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = monthTo + "/" + daysInMonth(tempMonthDay, yearTo) + "/" + yearTo;
                }
            }

        }
    }





    function daysInMonth(month, year) {
        return new Date(year, month + 1, 0).getDate();
    }




    function addzero(num) {
        if (parseInt(num) < 10) {
            num = "0" + num;
        }
        return num;
    }






    function initialValidateBeforeSave() {
        if (d.getElementById('frm2550qv2024:txtTIN1').value == "" || d.getElementById('frm2550qv2024:txtTIN2').value == "" || d.getElementById('frm2550qv2024:txtTIN3').value == "" || d.getElementById('frm2550qv2024:branchCode').value == "") {
            alert("Please enter a valid TIN number on Item 7.");
            return false;
        }
        if (d.getElementById('frm2550qv2024:txtRDOCode').value == "000") {
            alert("Please enter a valid RDO Code on Item 8.");
            return false;
        }
        if ((d.getElementById('frm2550qv2024:taxpayerName').value == "")) {
            alert("Please enter a valid Withholding Agent's Name on Item 9.");
            return false;
        }

        return true;
    }

