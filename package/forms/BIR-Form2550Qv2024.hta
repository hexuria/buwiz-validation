                "<td width='30%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo42Amount" + i + "' style='width: 150px; text-align: right;' value='" + specify42ToCommit[i].txtSpecifyNo42Amount + "' onblur='round(this,2); computeOtherCreditsNo42();' maxlength='25'> </td>" +
