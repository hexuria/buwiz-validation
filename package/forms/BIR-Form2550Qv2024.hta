    function blockletterWithout2Decimal(e) {
        var number = parseFloat(e.value);
        if (isNaN(number)) {
            //var zero = 0;
            //e.value = parseFloat(zero).toFixed(2);
            e.value = "";
        } else {
            e.value = '' + number.toFixed(0);
        }
    }


    // NEW FUNCTION FOR SCHEDULE 1 - ALDRIN =====================================================================================================================================================================

    // LETTERS ONLY
    function onlyLetters(input, e) {
        var keyCode = e.keyCode || e.which;
        var keyValue = String.fromCharCode(keyCode);
        var pattern = /^[a-z]$/i; // allow only letters a-z (both lowercase and uppercase)
        if (!pattern.test(keyValue)) {
            e.preventDefault();
            return false;
        }
        return true;
    }

    // ALPHA NUMERIC ONLY
    function onlyAlphaNumeric(input, e) {
        var keyCode = e.keyCode || e.which;
        var keyValue = String.fromCharCode(keyCode);
        var pattern = /^[a-z0-9]$/i; // allow only alphanumeric characters (both lowercase and uppercase)
        if (!pattern.test(keyValue)) {
            e.preventDefault();
            return false;
        }
        return true;
    }

    // COMPUTATION FOR SCHEDULE 1
    function computeSched1() {
        var size = sched1ToCommit.length;
        var balanceInputTaxFromPreviousPeriod = 0;
        var recognizedLife = 0;
        var totalAllowableInput = 0;
        var balanceInputTaxToBeCarried = 0;
        var totalBalanceInputTaxToBeCarried = 0;

        if (size === 0) {
            // Update UI elements to show 0
            d.getElementById('txtTotalAmountOfBalanceofInputTaxFromPrevious').value = '0.00';
            d.getElementById('txtTotalAmountOfBalanceofInputTaxToBeCarried').value = '0.00';
            return; // Exit function early since there are no items to process
        }

        for (var i = 0; i < size; i++) {
            balanceInputTaxFromPreviousPeriod += NumWithComma(d.getElementById('txtInputTax1' + i).value);
            recognizedLife = NumWithComma(d.getElementById('txtRecognizedLife1' + i).value);

            var inputDate = d.getElementById('txtDatePurchase1' + i).value;
            var result = inputDate.split("/");

            if (result.length === 3) {
                var month = parseInt(result[0], 10);
                var day = parseInt(result[1], 10);
                var year = parseInt(result[2], 10);

                // Validate that the date is on or before December 31, 2021
                if (year > 2021 || (year === 2021 && (month > 12 || (month === 12 && day > 31)))) {
                    d.getElementById('txtDatePurchase1' + i).value = "";
                    alert("Only dates on or before December 31, 2021 are allowed.");
                    continue;
                }

                if (month === 1 || month === 4 || month === 7 || month === 10) {
                    document.getElementById('txtAllowedInputTax1' + i).value = formatCurrency(
                        NumWithComma(document.getElementById('txtInputTax1' + i).value) / recognizedLife * 3
                    );
                } else if (month === 2 || month === 5 || month === 8 || month === 11) {
                    document.getElementById('txtAllowedInputTax1' + i).value = formatCurrency(
                        NumWithComma(document.getElementById('txtInputTax1' + i).value) / recognizedLife * 3
                    );
                } else {
                    document.getElementById('txtAllowedInputTax1' + i).value = formatCurrency(
                        NumWithComma(document.getElementById('txtInputTax1' + i).value) / recognizedLife * 3
                    );
                }

                totalAllowableInput = NumWithComma(d.getElementById('txtAllowedInputTax1' + i).value);
            } else {
                alert("Date Purchase cannot be an empty field.");
                continue;
            }

            d.getElementById('txtBalanceInputTax1' + i).value = formatCurrency(
                NumWithComma(d.getElementById('txtInputTax1' + i).value) - totalAllowableInput
            );

            balanceInputTaxToBeCarried += NumWithComma(d.getElementById('txtBalanceInputTax1' + i).value);

            d.getElementById('txtTotalAmountOfBalanceofInputTaxFromPrevious').value = formatCurrency(balanceInputTaxFromPreviousPeriod);
            d.getElementById('sched1TotalBalPrev').value = d.getElementById('txtTotalAmountOfBalanceofInputTaxFromPrevious').value;

            totalBalanceInputTaxToBeCarried += NumWithComma(d.getElementById('txtBalanceInputTax1' + i).value);
            d.getElementById('txtTotalAmountOfBalanceofInputTaxToBeCarried').value = formatCurrency(totalBalanceInputTaxToBeCarried);
            d.getElementById('sched1TotalBalNext').value = d.getElementById('txtTotalAmountOfBalanceofInputTaxToBeCarried').value;
        }

        compute39AB();
        compute52AB();
    }




