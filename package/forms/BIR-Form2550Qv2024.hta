    // CHECK IF INPUT FIELD IS NULL
    function checkInputFieldNewSched3() {
        var size = sched3ToCommit.length;
        for (var i = 0; i < size; i++) {
            if
                (
                d.getElementById('txtDateCovered3' + i).value == "" ||
                d.getElementById('txtNameWithHoldingAgent3' + i).value == "" ||
                d.getElementById('txtIncomePayment3' + i).value == "" ||
                d.getElementById('txtTotalTaxWithHeld3' + i).value == ""
            ) {
                alert("Empty fields are not allowed ");
                return;
            }

            inputDate = d.getElementById('txtDateCovered3' + i).value;

            // DATE VALIDATION
            if (inputDate != "") {
                var result = inputDate.split("/")
                if (result.length == 3) {
                    var month = result[0];
                    var day = result[1];
                    var year = result[2];
                    var isLeap = new Date(year, 1, 29).getMonth() == 1;

                    if (isNaN(month) || isNaN(day) || isNaN(year)) {
                        alert("Please enter a valid date for Date of Purchase on row " + (i + 1) + "\n" + "Please enter a date in the MM/DD/YYYY format. 1");
                        return;
                    }
                    else {
                        if (month == 2) {
                            if (!isLeap && day == 29) {
                                alert("Invalid entry on row " + (i + 1) + ". Date of Purchase must be within the Return Period only. Must be below 29");
                                return;
                            }
                            if (!isLeap && day > 29) {
                                alert("Invalid entry on row " + (i + 1) + ". Date of Purchase must be within the Return Period only. Must be below 29");
                                return;
                            }
                            if (isLeap && day > 29) {
                                alert("Invalid entry on row " + (i + 1) + ". Date of Purchase must be within the Return Period only. Must be below 29");
                                return;
                            }
                        }
                    }
                }
                else {
                    alert("Invalid entry on row " + (i + 1) + " Please enter a date in the MM/DD/YYYY format.");
                    return;
                }
            }
        }
        return true;
    }

    // FOR SCHEDULE 4 - ALDRIN =====================================================================================================================================================================

    // VALIDATION FOR DATE OF SCHEDULE 4
    function dateSched4() {
        var size = sched4ToCommit.length;

        // Retrieve the return period range
        var RtnPeriodFromNo4 = document.getElementById('frm2550qv2024:RtnPeriodFromNo4').value;
        var RtnPeriodToNo4 = document.getElementById('frm2550qv2024:RtnPeriodToNo4').value;

        if (!RtnPeriodFromNo4 || !RtnPeriodToNo4) {
            alert("Return Period must be defined.");
            return;
        }

        // Parse the return period dates
        var returnFromDateParts = RtnPeriodFromNo4.split("/");
        var returnToDateParts = RtnPeriodToNo4.split("/");
        var returnStartDate = new Date(returnFromDateParts[2], returnFromDateParts[0] - 1, returnFromDateParts[1]);
        var returnEndDate = new Date(returnToDateParts[2], returnToDateParts[0] - 1, returnToDateParts[1]);

        for (var i = 0; i < size; i++) {
            var inputDate = document.getElementById('txtDate4' + i).value;
            var inputDateTo = document.getElementById('txtDate4To' + i).value;

            // Ensure both dates are filled
            if (!inputDate || !inputDateTo) {
                alert("Date fields cannot be empty.");
                continue;
            }

            // Parse the input dates
            var inputDateParts = inputDate.split("/");
            var inputDateToParts = inputDateTo.split("/");
            var fromDate = new Date(inputDateParts[2], inputDateParts[0] - 1, inputDateParts[1]);
            var toDate = new Date(inputDateToParts[2], inputDateToParts[0] - 1, inputDateToParts[1]);

            // Validate if the dates are within the return period
            if (fromDate < returnStartDate || fromDate > returnEndDate || toDate < returnStartDate || toDate > returnEndDate) {
                document.getElementById('txtDate4' + i).value = "";
                document.getElementById('txtDate4To' + i).value = "";
                alert("Dates must fall within the Return Period: " + RtnPeriodFromNo4 + " to " + RtnPeriodToNo4);
                continue;
            }

            // Ensure "From" date is not after "To" date
            if (fromDate > toDate) {
                document.getElementById('txtDate4' + i).value = "";
                document.getElementById('txtDate4To' + i).value = "";
                alert("'From' date cannot be after 'To' date.");
                continue;
            }
        }
    }



    // COMPUTATION FOR SCHEDULE 4
    function computeSched4() {
        var size = sched4ToCommit.length;
        var amountPaid = 0;

        if (size === 0) {
            d.getElementById('txtAmountPaidSched4').value = '0.00';
        }

        for (i = 0; i < size; i++) {
            amountPaid = amountPaid * 1 + (NumWithComma(d.getElementById('txtAmountPaid4' + i).value));

            // GET TOTAL AMOUNT OF Amount Paid
            d.getElementById('txtAmountPaidSched4').value = formatCurrency(amountPaid);
            d.getElementById('sched4AmountPaid').value = d.getElementById('txtAmountPaidSched4').value;
        }
        compute17();
    }


