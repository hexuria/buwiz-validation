                        if (d.getElementById('frm2550qv2024:amendedReturnYesNo5').checked == true) {
                            p3IsAmended = "Yes";
                        } else if (d.getElementById('frm2550qv2024:amendedReturnNo5').checked == true) {
                            p3IsAmended = "No";
                        }
                    }
                }
                p3ReturnPeriodEnd = p3ReturnPeriod;
                p3TPTIN = p3TPTIN1 + p3TPTIN2 + p3TPTIN3;
            }
            /*--------------------- follow this format for parsing --------------------------- */
            var currentDate = new Date();
            var formattedDate = currentDate.getFullYear() + "/" + ("0" + (currentDate.getMonth() + 1)).slice(-2) + "/" + ("0" + currentDate.getDate()).slice(-2);
            allXML += "<div>dateFiled=" + formattedDate + "dateFiled=</div>\n";
            if (submit) {
                allXML += tab + d.getElementById('xmlClose').innerHTML + "0";
