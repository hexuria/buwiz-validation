            specify19ToCommit[size] = new NewSpecifyNo19();
            specify19ToCommit[size].txtSpecifyNo19Description = externalInputValueDescription;
            specify19ToCommit[size].txtSpecifyNo19Amount = externalInputValueTotal
        }


        specify19ToCommit.splice(index, 1);
        $('#tbodyNo19').html("");
        for (var i = 0; i < specify19ToCommit.length; i++) {
            $('#tbodyNo19').append(
                "<tr>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px'>19." + (i + 1) + "</td>" +
                "<td width='50%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo19Description" + i + "' style='width: 450px;' value='" + specify19ToCommit[i].txtSpecifyNo19Description + "' maxlength='50'> </td>" +
                "<td width='30%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo19Amount" + i + "' style='width: 150px; text-align: right;' value='" + specify19ToCommit[i].txtSpecifyNo19Amount + "' onblur='round(this,2); computeOtherCreditsNo19();' maxlength='25'> </td>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px;'> <button id='deleteId1" + i + "' onclick='deleteRowNo19(" + i + ")' style='padding: 2px'>Remove</button> </td>" +
                "</tr>"
            );
        }
        computeOtherCreditsNo19();
    }

    // VALIDATE INPUT NUMBER 19
    function validationSpecify19() {
        var size = specify19ToCommit.length;
        for (var i = 0; i < size; i++) {
            if (d.getElementById('frm2550qv2024:totalTaxPayableNo19Description' + i).value == "" ||
                d.getElementById('frm2550qv2024:totalTaxPayableNo19Amount' + i).value == "0.00") {
                alert("Empty fields are not allowed");
                return;
            }
        }
        return true;
    }

    // COMPUTE NUMBER 19
    // Function to compute and update fields
    function computeOtherCreditsNo19() {
        var inputField = d.getElementById('frm2550qv2024:otherCreditsNo19');
        var resultField = d.getElementById('resultOtherCreditsNo19');

        // Update resultField immediately with inputField value
        resultField.value = inputField.value;

        // Call calculation logic to handle additional items if needed
        var size = specify19ToCommit.length;
        var otherCredits = 0;

        if (size === 0) {
            inputField.value = "0.00";
            resultField.value = "0.00";
        } else {
            for (var i = 0; i < size; i++) {
                otherCredits += NumWithComma(d.getElementById('frm2550qv2024:totalTaxPayableNo19Amount' + i).value);
            }
            var formattedOtherCredits = formatCurrency(otherCredits);
            inputField.value = formattedOtherCredits;
            resultField.value = formattedOtherCredits;
        }
    }



    // NUMBER 20
    function compute20() {
        var rowCount = d.getElementById('tblSpecifyNo19').rows.length

        if (rowCount == 1) {
            d.getElementById('frm2550qv2024:totalTaxCredits').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:creditableVat').value) +
                NumWithComma(d.getElementById('frm2550qv2024:advVatPayment').value) + NumWithComma(d.getElementById('frm2550qv2024:vatPaidReturn').value) +
                NumWithComma(d.getElementById('frm2550qv2024:otherCreditsNo19').value)
            );

            compute21();
        }

        else if (rowCount > 1) {
            d.getElementById('frm2550qv2024:totalTaxCredits').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:creditableVat').value) +
                NumWithComma(d.getElementById('frm2550qv2024:advVatPayment').value) + NumWithComma(d.getElementById('frm2550qv2024:vatPaidReturn').value) +
                NumWithComma(d.getElementById('frm2550qv2024:otherCreditsNo19').value)
            );
            computeOtherCreditsNo19();
            compute21();
        }
    }

    // NUMBER 21
    function compute21() {
        d.getElementById('frm2550qv2024:excessCredits').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:excessInputTax').value) -
            NumWithComma(d.getElementById('frm2550qv2024:totalTaxCredits').value));
        compute26();
    }

    // NUMBER 25
    function compute25() {
        d.getElementById('frm2550qv2024:penalties').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:surcharge').value) +
            NumWithComma(d.getElementById('frm2550qv2024:interest').value) + NumWithComma(d.getElementById('frm2550qv2024:compromise').value));
        compute26();
    }

    // NUMBER 26
    function compute26() {
        // Retrieve values from the form fields and handle large values
        var totalTaxPayableNo21 = parseFloat(d.getElementById('frm2550qv2024:excessCredits').value.replace(/,/g, '')) || 0;
        var totalTaxPayableNo25 = parseFloat(d.getElementById('frm2550qv2024:penalties').value.replace(/,/g, '')) || 0;

        // Check if the value of No21 is negative and No25 is greater than 0
        if (totalTaxPayableNo21 < 0 && totalTaxPayableNo25 > 0) {
            // Set the value of No26 to No25
            d.getElementById('frm2550qv2024:totalPayable').value = formatCurrency(totalTaxPayableNo25);
        } else {
            // Calculate the sum of No21 and No25 and set it to No26
            var total = totalTaxPayableNo21 + totalTaxPayableNo25;
            d.getElementById('frm2550qv2024:totalPayable').value = formatCurrency(total);
        }
    }

    // NUMBER 31
    function compute31AB() {
        d.getElementById('frm2550qv2024:outputVatSales').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:vatableSales').value) * 0.12);
        d.getElementById('frm2550qv2024:outputTaxDue').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:vatableSales').value) * 0.12);
    }

    // NUMBER 34
    function compute34AB() {
        d.getElementById('frm2550qv2024:totalSales').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:vatableSales').value) +
            NumWithComma(d.getElementById('frm2550qv2024:zeroRatedSales').value) + NumWithComma(d.getElementById('frm2550qv2024:exemptSales').value));
        computeTotalSales();
        compute37AB();
    }

    // NUMBER 37
    function compute37AB() {
        d.getElementById('frm2550qv2024:totalAdjOutput').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:outputTaxDue').value) -
            NumWithComma(d.getElementById('frm2550qv2024:lessOutputVat').value) + NumWithComma(d.getElementById('frm2550qv2024:addOutputVat').value));
        compute61AB();
    }

    // NUMBER 39
    function compute39AB() {
        d.getElementById('frm2550qv2024:inputTaxDeferred').value = d.getElementById('txtTotalAmountOfBalanceofInputTaxFromPrevious').value;
        compute43AB();
    }

