    function changeMonth() {
        var month = d.getElementById('frm2550qv2024:selectedMonthNo2');

        // Clear any selected quarter when the month changes
        d.getElementById('frm2550qv2024:OptQuarter1').checked = false;
        d.getElementById('frm2550qv2024:OptQuarter2').checked = false;
        d.getElementById('frm2550qv2024:OptQuarter3').checked = false;
        d.getElementById('frm2550qv2024:OptQuarter4').checked = false;

        // Clear the return period fields
        d.getElementById('frm2550qv2024:RtnPeriodFromNo4').value = "";
        d.getElementById('frm2550qv2024:RtnPeriodToNo4').value = "";

        // Call changeYear or any additional logic if needed
        changeYear();
    }







