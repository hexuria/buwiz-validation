        if (document.getElementById('frm2550qv2024:addSpecifyNo47').value != "" && document.getElementById('frm2550qv2024:otherSpecify47').value != "0.00" && document.getElementById('frm2550qv2024:addSpecifyNo42').value != "VARIOUS") {

