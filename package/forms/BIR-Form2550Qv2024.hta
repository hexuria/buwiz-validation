        document.getElementById('frm2550qv2024:txtTIN2').disabled = true;
        document.getElementById('frm2550qv2024:txtTIN3').disabled = true;
        document.getElementById('frm2550qv2024:branchCode').disabled = true;



        window.setTimeout("checkFinalCopyBtn('2550Qv2024');" +
            "d.getElementById('frm2550qv2024:btnPrevPage').disabled=false;" +
            "d.getElementById('frm2550qv2024:btnNextPage').disabled=false;"
