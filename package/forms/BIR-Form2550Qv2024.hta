    // SAVE NUMBER 19
    function savingNo19() {

        var tableBody = document.getElementById('tbodyNo19');
        var rows = tableBody.getElementsByTagName('tr');
        var specify19ToCommit = [];
        var count = 0;

        function manualTrim(str) {
            return str.replace(/^\s+|\s+$/g, '');
        }

        for (var i = 0; i < rows.length; i++) {
            var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
            var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

            var description = manualTrim(descriptionInput.value);
            var amount = manualTrim(amountInput.value);

            if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                count += 1; // Increment count for invalid rows
            } else {
                specify19ToCommit.push({
                    txtSpecifyNo19Description: description,
                    txtSpecifyNo19Amount: parseFloat(amount).toFixed(2)
                });
            }
        }
    }

    // CANCEL NUMBER 19

    function cancelNo19() {
        // Function to manually trim whitespace
        function manualTrim(str) {
            return str.replace(/^\s+|\s+$/g, '');
        }

        // Get the table body element
        var tableBody = document.getElementById('tbodyNo19');
        if (!tableBody) {
            console.error("Table body element not found.");
            return;
        }

        var rows = tableBody.getElementsByTagName('tr');
        var specify19ToCommit = [];
        var count = 0;

        // Iterate over each row in the table body
        for (var i = 0; i < rows.length; i++) {
            // Skip empty rows or rows that don't have the correct structure
            if (rows[i].cells.length < 3) continue;

            var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
            var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

            if (!descriptionInput || !amountInput) {
                console.error("Input elements not found in row " + i);
                continue;
            }

            var description = manualTrim(descriptionInput.value);
            var amount = manualTrim(amountInput.value);

            // Validate the inputs
            if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                count += 1; // Increment count for invalid rows
            } else {
                // Add valid rows to specify19ToCommit array
                specify19ToCommit.push({
                    txtSpecifyNo19Description: description,
                    txtSpecifyNo19Amount: parseFloat(amount).toFixed(2)
                });
            }
            deleteRowNo19();
        }
    }



    // SAVE AND CLOSE NO 19
    function saveAndCloseNo19() {
        function manualTrim(str) {
            return str.replace(/^\s+|\s+$/g, '');
        }

        var tableBody = document.getElementById('tbodyNo19');
        var rows = tableBody.getElementsByTagName('tr');
        var specify19ToCommit = [];
        var count = 0;

        for (var i = 0; i < rows.length; i++) {
            if (rows[i].cells.length < 3) continue;

            var descriptionInput = rows[i].cells[1].getElementsByTagName('input')[0];
            var amountInput = rows[i].cells[2].getElementsByTagName('input')[0];

            var description = manualTrim(descriptionInput.value);
            var amount = manualTrim(amountInput.value);

            if (description === "" || amount === "" || parseFloat(amount) <= 0) {
                count += 1; // Increment count for invalid rows
            } else {
                specify19ToCommit.push({
                    txtSpecifyNo19Description: description,
                    txtSpecifyNo19Amount: parseFloat(amount).toFixed(2)
                });
            }
        }

        if (count === 0) {
            alert('Data has been saved successfully!');

            closeModalNo19();
        } else {
            alert('Please fill up all required fields and ensure amounts are greater than zero.');
        }
    }


    // DELETE NUMBER 19
    function deleteRowNo19(index) {
        var size = specify19ToCommit.length;
        var externalInputValueDescription = document.getElementById('frm2550qv2024:addSpecifyNo19').value;
        var externalInputValueTotal = document.getElementById('frm2550qv2024:otherCreditsNo19').value;

