        else if (rowCount > 1) {
            d.getElementById('frm2550qv2024:totalCurPurchase').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:domesticPurchase').value) +
                NumWithComma(d.getElementById('frm2550qv2024:servicesPurchase').value) + NumWithComma(d.getElementById('frm2550qv2024:importPurchase').value) +
                NumWithComma(d.getElementById('frm2550qv2024:otherSpecify47').value) + NumWithComma(d.getElementById('frm2550qv2024:domesticPurchaseNoTax').value) +
                NumWithComma(d.getElementById('frm2550qv2024:vatExemptImports').value) + NumWithComma(d.getElementById('frm2550qv2024:txtVatableSales47A.1').value)
            );

            d.getElementById('frm2550qv2024:totalCurInputTax').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:domesticInputTax').value) +
                NumWithComma(d.getElementById('frm2550qv2024:serviceInputTax').value) + NumWithComma(d.getElementById('frm2550qv2024:importInputTax').value) +
                NumWithComma(d.getElementById('otherSpecify47B').value)
            );
