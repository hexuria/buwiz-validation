                "<td width='50%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo47Description" + i + "' style='width: 450px;' value='" + specify47ToCommit[i].txtSpecifyNo47Description + "' maxlength='50'> </td>" +
                "<td width='30%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo47Amount" + i + "' style='width: 150px; text-align: right;' value='" + specify47ToCommit[i].txtSpecifyNo47Amount + "' onblur='round(this,2); computeOtherCreditsNo47();' maxlength='25'> </td>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px;'> <button id='deleteId47" + i + "' onclick='deleteRowNo47(" + i + ")' style='padding: 2px'>Remove</button> </td>" +
