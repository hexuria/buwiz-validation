                    "d.getElementById('btnAdd2B').disabled = true;" +
                    "d.getElementById('btnAdd3B').disabled = true;" +
                    "d.getElementById('btnAdd4B').disabled = true;" +
                    "d.getElementById('btnAdd5B').disabled = true;" +
                    "d.getElementById('btnAdd6B').disabled = false;" +
                    "d.getElementById('btnAdd2C').disabled = true;" +
                    "d.getElementById('btnAdd3C').disabled = true;" +
                    "d.getElementById('btnAdd4C').disabled = true;" +
                    "d.getElementById('btnAdd5C').disabled = true;" +
                    "d.getElementById('btnAdd6C').disabled = false;" +
                    "d.getElementById('btnAddSpecify19').disabled = false;" +
                    "d.getElementById('btnAddSpecify42').disabled = false;" +
                    "d.getElementById('btnAddSpecify47').disabled = false;" +
                    "d.getElementById('btnAddSpecify56').disabled = false;" +
                    "d.getElementById('btnUpload').disabled = false;"
