                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + "\n";
                            p3TPTelNum = elem[i].value;
                        }
                        else if (elem[i].id == 'frm2550qv2024:taxpayerZip') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + "\n";
                            p3TPZip = elem[i].value;
                        } else if (elem[i].id == 'frm2550qv2024:RtnPeriodToNo4') {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + "\n";
                            p3ReturnPeriod = elem[i].value;
                        }
                        else {
                            allXML += "<div>" + elem[i].id + "=" + elem[i].value + elem[i].id + "=</div>" + "\n"; //all select-one and text values
                        }
                    }
