    // CLOSE MODAL NUMBER 47
    function closeModalNo47() {
        d.getElementById('mainContent').style.display = 'block';
        if ($('#modalNo47').css('display') != 'none') {
            $('#modalNo47').hide('blind');
        }

        var size = specify47ToCommit.length;

        if (size > 1) {
            for (var i = 0; i < size; i++) {
                specify47ToCommit[i].txtSpecifyNo47Description = d.getElementById('frm2550qv2024:totalTaxPayableNo47Description' + i).value;
                specify47ToCommit[i].txtSpecifyNo47Amount = d.getElementById('frm2550qv2024:totalTaxPayableNo47Amount' + i).value;
            }

            document.getElementById('frm2550qv2024:addSpecifyNo47').value = "VARIOUS"
            document.getElementById('frm2550qv2024:addSpecifyNo47').disabled = true
            document.getElementById('frm2550qv2024:otherSpecify47').disabled = true
            var latestValue = d.getElementById('resultOtherCreditsNo47').value;
            d.getElementById('frm2550qv2024:otherSpecify47').value = latestValue;
        }
        if (size == 1) {
            for (var i = 0; i < size; i++) {
                specify47ToCommit[i].txtSpecifyNo47Description = d.getElementById('frm2550qv2024:totalTaxPayableNo47Description' + i).value;
                specify47ToCommit[i].txtSpecifyNo47Amount = d.getElementById('frm2550qv2024:totalTaxPayableNo47Amount' + i).value;
            }

            document.getElementById('frm2550qv2024:addSpecifyNo47').value = specify47ToCommit[0].txtSpecifyNo47Description;
            document.getElementById('frm2550qv2024:addSpecifyNo47').disabled = false
            document.getElementById('frm2550qv2024:otherSpecify47').disabled = false
        }
        if (size < 1) {
            document.getElementById('frm2550qv2024:addSpecifyNo47').value = "";
            d.getElementById('frm2550qv2024:otherSpecify47').value = "0.00"
            document.getElementById('frm2550qv2024:addSpecifyNo47').disabled = false
            document.getElementById('frm2550qv2024:otherSpecify47').disabled = true


        }
        compute50AB();
    }

