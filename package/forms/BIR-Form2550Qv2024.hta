    // VALIDATE INPUT NUMBER 42
    function validationSpecify42() {
        var size = specify42ToCommit.length;
        for (var i = 0; i < size; i++) {
            if (d.getElementById('frm2550qv2024:totalTaxPayableNo42Description' + i).value == "" ||
                d.getElementById('frm2550qv2024:totalTaxPayableNo42Amount' + i).value == "0.00") {
                alert("Empty fields are not allowed");
                return;
            }
        }
        return true;
    }

    // COMPUTE NUMBER 42
    function computeOtherCreditsNo42() {
        var inputField = document.getElementById('frm2550qv2024:otherSpecify42').value;
        var resultField = document.getElementById('resultOtherCreditsNo42');

        // Update resultField immediately with inputField value
        resultField.value = inputField.value;

        // Call calculation logic to handle additional items if needed
        var size = specify42ToCommit.length;
        var otherCredits = 0;

        if (size === 0) {
            inputField.value = "0.00";
            resultField.value = "0.00";
        } else {
            for (var i = 0; i < size; i++) {
                otherCredits += NumWithComma(document.getElementById('frm2550qv2024:totalTaxPayableNo42Amount' + i).value);
            }
            var formattedOtherCredits = formatCurrency(otherCredits);
            inputField.value = formattedOtherCredits;
            resultField.value = formattedOtherCredits;
        }
    }

    // NUMBER 43
    function compute43AB() {
        var rowCount = d.getElementById('tblSpecifyNo42').rows.length

        if (rowCount == 1) {
            d.getElementById('frm2550qv2024:total43').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:inputTaxCarried').value) +
                NumWithComma(d.getElementById('frm2550qv2024:inputTaxDeferred').value) + NumWithComma(d.getElementById('frm2550qv2024:transitionalInputTax').value) +
                NumWithComma(d.getElementById('frm2550qv2024:presumptiveInputTax').value) + NumWithComma(d.getElementById('frm2550qv2024:otherSpecify42').value)
            );
            compute51AB();
        }

        else if (rowCount > 1) {
            d.getElementById('frm2550qv2024:total43').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:inputTaxCarried').value) +
                NumWithComma(d.getElementById('frm2550qv2024:inputTaxDeferred').value) + NumWithComma(d.getElementById('frm2550qv2024:transitionalInputTax').value) +
                NumWithComma(d.getElementById('frm2550qv2024:presumptiveInputTax').value) + NumWithComma(d.getElementById('frm2550qv2024:otherSpecify42').value)
                + NumWithComma(d.getElementById('frm2550qv2024:totalTaxPayableNo42.1').value)
            );

            compute51AB();
        }
    }

