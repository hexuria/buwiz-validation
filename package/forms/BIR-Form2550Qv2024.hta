    function loadSpecify47() {
        specify47ToCommit = []; // Clear existing array
        var response = $("#response").html();
        var index = 0;
        var continueSearching = true;

        // Keep searching while we find matching pairs
        while (continueSearching) {
            var descriptionId = "frm2550qv2024:totalTaxPayableNo47Description" + index;
            var amountId = "frm2550qv2024:totalTaxPayableNo47Amount" + index;

            var descriptionParts = response.split(descriptionId + "=");
            var amountParts = response.split(amountId + "=");

            // Check if we found both description and amount
            if (descriptionParts.length > 1 && amountParts.length > 1) {
                specify47ToCommit[index] = new NewSpecifyNo47();
                specify47ToCommit[index].txtSpecifyNo47Description = descriptionParts[1].split(descriptionId)[0];
                specify47ToCommit[index].txtSpecifyNo47Amount = amountParts[1].split(amountId)[0];

                index++;
            } else {
                continueSearching = false;
            }
        }


    }

    function showModalNo47() {
        d.getElementById('mainContent').style.display = 'none';


        // Clear existing table content
