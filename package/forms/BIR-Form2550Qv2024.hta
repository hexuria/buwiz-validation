                "<td width='10%' style='border: 1px solid black; padding: 2px'>56." + (i + 1) + "</td>" +
                "<td width='50%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo56Description" + i + "' style='width: 450px;' value='" + specify56ToCommit[i].txtSpecifyNo56Description + "' maxlength='50'> </td>" +
                "<td width='30%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo56Amount" + i + "' style='width: 150px; text-align: right;' value='" + specify56ToCommit[i].txtSpecifyNo56Amount + "' onblur='round(this,2); computeOtherCreditsNo56(); compute57AB();' maxlength='25'> </td>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px;'> <button id='deleteId1" + i + "' onclick='deleteRowNo56(" + i + ")' style='padding: 2px'>Remove</button> </td>" +
                "</tr>"
            );
        }
        computeOtherCreditsNo56();
    }

    // VALIDATE INPUT NUMBER 56
    function validationSpecify56() {
        var size = specify56ToCommit.length;
        for (var i = 0; i < size; i++) {
            if (d.getElementById('frm2550qv2024:totalTaxPayableNo56Description' + i).value == "" ||
                d.getElementById('frm2550qv2024:totalTaxPayableNo56Amount' + i).value == "0.00") {
                alert("Empty fields are not allowed");
                return;
            }
        }
        return true;
    }

    // COMPUTE NUMBER 56
    function computeOtherCreditsNo56() {
        var inputField = document.getElementById('frm2550qv2024:otherSpecify56');
        var resultField = document.getElementById('resultOtherCreditsNo56');

        // Update resultField immediately with inputField value
        resultField.value = inputField.value;

        // Call calculation logic to handle additional items if needed
        var size = specify56ToCommit.length;
        var otherCredits = 0;

        if (size === 0) {
            inputField.value = "0.00";
            resultField.value = "0.00";
        } else {
            for (var i = 0; i < size; i++) {
                otherCredits += NumWithComma(document.getElementById('frm2550qv2024:totalTaxPayableNo56Amount' + i).value);
            }
            var formattedOtherCredits = formatCurrency(otherCredits);
            inputField.value = formattedOtherCredits;
            resultField.value = formattedOtherCredits;

        }
    }

    // NUMBER 57
    function compute57AB() {
        var rowCount = d.getElementById('tblSpecifyNo56').rows.length

        if (rowCount == 1) {
            d.getElementById('frm2550qv2024:totalDeductions').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:importCapitalInputTax').value) +
                NumWithComma(d.getElementById('frm2550qv2024:inputTaxAttr').value) + NumWithComma(d.getElementById('frm2550qv2024:vatRefund').value) +
                NumWithComma(d.getElementById('frm2550qv2024:inputVatUnpaid').value) + NumWithComma(d.getElementById('frm2550qv2024:otherSpecify56').value)
            );

            compute59AB();

        }

        else if (rowCount > 1) {
            d.getElementById('frm2550qv2024:totalDeductions').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:importCapitalInputTax').value) +
                NumWithComma(d.getElementById('frm2550qv2024:inputTaxAttr').value) + NumWithComma(d.getElementById('frm2550qv2024:vatRefund').value) +
                NumWithComma(d.getElementById('frm2550qv2024:inputVatUnpaid').value) + NumWithComma(d.getElementById('frm2550qv2024:otherSpecify56').value) +
                NumWithComma(d.getElementById('frm2550qv2024:totalTaxPayableNo56.1').value)
            );

            compute59AB();
        }
    }

    // NUMBER 59
    function compute59AB() {
        d.getElementById('frm2550qv2024:adjDeductions').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:totalDeductions').value) + NumWithComma(d.getElementById('frm2550qv2024:addInputVat').value));
        compute60AB();
    }

    // NUMBER 60
    function compute60AB() {
        d.getElementById('frm2550qv2024:totalAllowInputTax').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:totalAvailInputTax').value) -
            NumWithComma(d.getElementById('frm2550qv2024:adjDeductions').value));
        compute61AB();
    }

    // NUMBER 61
    function compute61AB() {
        d.getElementById('frm2550qv2024:netVatPayable').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:totalAdjOutput').value) -
            NumWithComma(d.getElementById('frm2550qv2024:totalAllowInputTax').value));
        d.getElementById('frm2550qv2024:excessInputTax').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:totalAdjOutput').value) -
            NumWithComma(d.getElementById('frm2550qv2024:totalAllowInputTax').value));
        compute15();
    }

    function computeVATExemptSale() {
        d.getElementById('frm2550qv2024:sched2VatExemptSale').value = d.getElementById('frm2550qv2024:exemptSales').value;
    }

    function computeTotalSales() {
        d.getElementById('frm2550qv2024:sched2TotalSales').value = d.getElementById('frm2550qv2024:totalSales').value;
    }

    function computeAmountInputTax() {
        d.getElementById('frm2550qv2024:sched2TotalRatable').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:sched2VatExemptSale').value) / NumWithComma(d.getElementById('frm2550qv2024:sched2TotalSales').value)
            * NumWithComma(d.getElementById('frm2550qv2024:sched2AmountInputTax').value));
        computeTotalTaxInput();
    }

    function computeTotalTaxInput() {
        d.getElementById('frm2550qv2024:sched2TotalAttr').value = formatCurrency(NumWithComma(d.getElementById('frm2550qv2024:sched2InputTaxDirect').value) + NumWithComma(d.getElementById('frm2550qv2024:sched2TotalRatable').value));
        compute53AB();
    }

    // END OF NEW COMPUTATIONNNNNN - ALDRIN ====================================================================================================================================

    function enableShortPeriod(answer) {
        if (answer == "yes") {
            if (confirm("Choosing Yes means you are filing for a short-period \n" +
                "return. You are required to change the Month field to \n" +
                "correspond with your New quarter period. Please \n" +
                "update your Registration details by filing BIR \n" +
                "Form 1905 at the RDO where you are registered.")) {
                d.getElementById('frm2550qv2024:selectedMonthNo2').disabled = false;
                d.getElementById('frm2550qv2024:OptQuarter1').disabled = false;
                d.getElementById('frm2550qv2024:OptQuarter2').disabled = false;
                d.getElementById('frm2550qv2024:OptQuarter3').disabled = false;
                d.getElementById('frm2550qv2024:OptQuarter4').disabled = false;
                d.getElementById('frm2550qv2024:RtnPeriodFromNo4').disabled = false;
                d.getElementById('frm2550qv2024:RtnPeriodToNo4').disabled = false;
            } else {
                d.getElementById('frm2550qv2024:OptShortPrd2').checked = true;
            }
        } else {
            d.getElementById('frm2550qv2024:selectedMonthNo2').disabled = false;
            d.getElementById('frm2550qv2024:OptQuarter1').disabled = false;
            d.getElementById('frm2550qv2024:OptQuarter2').disabled = false;
            d.getElementById('frm2550qv2024:OptQuarter3').disabled = false;
            d.getElementById('frm2550qv2024:OptQuarter4').disabled = false;
            d.getElementById('frm2550qv2024:RtnPeriodFromNo4').disabled = true;
            d.getElementById('frm2550qv2024:RtnPeriodToNo4').disabled = true;
            d.getElementById('frm2550qv2024:OptShortPrd2').disabled = false; // Disable OptShortPrd2
        }
    }


    function validate() {
        var d = document;
        var rtnPeriodItem4 = d.getElementById('frm2550qv2024:RtnPeriodToNo4').value; // Return period (MM/DD/YYYY)
        var yearEnded = parseInt(d.getElementById('frm2550qv2024:txtYearNo2').value, 10); // Year ended

        // Split the return period into year, month, and day
        var rtnPeriodParts = rtnPeriodItem4.split("/");
        var rtnPeriodYear = parseInt(rtnPeriodParts[2], 10);
        var rtnPeriodMonth = parseInt(rtnPeriodParts[0], 10);
        var rtnPeriodDay = parseInt(rtnPeriodParts[1], 10);

        // Get today's date for comparison
        var today = new Date();
        var currentYear = today.getFullYear();
        var currentMonth = today.getMonth() + 1; // JS months are 0-based (0 = Jan, 11 = Dec)
        var currentDay = today.getDate();

        // Convert return period and current date to JavaScript Date objects
        var returnPeriodDate = new Date(rtnPeriodYear, rtnPeriodMonth - 1, rtnPeriodDay);
        var currentDate = new Date(currentYear, currentMonth - 1, currentDay);

        // ITEM 1 Validation (Year type selection)
        if (!d.getElementById('frm2550qv2024:calendarNo1').checked &&
            !d.getElementById('frm2550qv2024:fiscalNo1').checked) {
            alert("Please choose a year type on Item 1.");
            return;
        }

        // ITEM 3 Validation (Quarter selection)
        if (!d.getElementById('frm2550qv2024:OptQuarter1').checked &&
            !d.getElementById('frm2550qv2024:OptQuarter2').checked &&
            !d.getElementById('frm2550qv2024:OptQuarter3').checked &&
            !d.getElementById('frm2550qv2024:OptQuarter4').checked) {
            alert("Item 3 is a required field.");
            return;
        }

        // ITEM 4 Validation: Prevent advance filing but allow valid return periods
        if (returnPeriodDate > currentDate) {
            // Exception: Allow 4th Quarter 2024 (Nov 2024 - Jan 2025) for year-ended 2025
            if (yearEnded === 2025 && ((rtnPeriodMonth === 11 && rtnPeriodYear === 2024) ||
                (rtnPeriodMonth === 12 && rtnPeriodYear === 2024) ||
                (rtnPeriodMonth === 1 && rtnPeriodYear === 2025))) {
                // Allowed filing
            } else {
                alert("Should not accept advance filing.");
                return;
            }
        }



        // ITEM 7
        if (d.getElementById('frm2550qv2024:txtTIN1').value == "" || d.getElementById('frm2550qv2024:txtTIN2').value == "" || d.getElementById('frm2550qv2024:txtTIN3').value == "" || d.getElementById('frm2550qv2024:branchCode').value == "") {
            alert("Please enter a valid TIN number on Item 7.");
            return;
        }
        // ITEM 8
        if (d.getElementById('frm2550qv2024:txtRDOCode').value == "") {
            alert("Please enter a valid RDO Code on Item 8.");
            return;
        }
        // ITEM 9
        if ((d.getElementById('frm2550qv2024:taxpayerName').value == "")) {
            alert("Please enter a valid Taxpayer Name on Item 9.");
            return;
        }
        // ITEM 10
        if ((d.getElementById('frm2550qv2024:taxpayerAddress').value == "")) {
            alert("Please enter a valid Taxpayer's Registered Address on Item 10.");
            return;
        }
        // ITEM 10A
        if (d.getElementById('frm2550qv2024:taxpayerZip').value == "") {
            alert("Please enter a valid Taxpayer's ZIP Code on Item 10A.");
            return;
        }
        // ITEM 11
        if (d.getElementById('frm2550qv2024:taxpayerContactNumber').value == "") {
            alert("Please enter a valid Taxpayer's Contact Number on Item 11.");
            return;
        }
        // ITEM 12
        if (d.getElementById('frm2550qv2024:taxpayerEmailAddress').value == "") {
            alert("Please enter a valid Taxpayer's Email Address on Item 12.");
            return;
        }
        // ITEM 13
        if (!d.getElementById('frm2550qv2024:taxPayerClassification1').checked && !d.getElementById('frm2550qv2024:taxPayerClassification2').checked && !d.getElementById('frm2550qv2024:taxPayerClassification3').checked && !d.getElementById('frm2550qv2024:taxPayerClassification4').checked) {
            alert("Please choose taxpayer classification on Item 13.");
            return;
        }
        // ITEM 14
        if (d.getElementById('frm2550qv2024:internationalTreatyYn').checked && d.getElementById('frm2550qv2024:specifyInternationalTreaty').value == "") {
            alert("Specify cannot be empty field on item 14A.");
            return;
        }


        // ITEM 19
        var addSpecifyNo19 = d.getElementById('frm2550qv2024:addSpecifyNo19').value;
        var otherCreditsNo19 = parseFloat(d.getElementById('frm2550qv2024:otherCreditsNo19').value);

        // Ensure otherCreditsNo19 is a valid number
        if (isNaN(otherCreditsNo19)) {
            alert("Other Credits (Item 19) is a required field");
            return;
        }

        // Condition 1: addSpecifyNo19 is empty and otherCreditsNo19 > 0
        if (addSpecifyNo19 === "" && otherCreditsNo19 > 0) {
            alert("Item 19 specify is a required field.");
            return;
        }

        // Condition 2: addSpecifyNo19 is not empty and otherCreditsNo19 == 0
        if (addSpecifyNo19 !== "" && otherCreditsNo19 === 0) {
            alert("Item 19 value is required when specify is provided.");
            return;
        }

        // Condition 3: addSpecifyNo19 is empty and otherCreditsNo19 > 1000
        if (addSpecifyNo19 === "" && otherCreditsNo19 > 1000) {
            return;
        }





        // Item 42

        // Get the values for Item 42 fields
        var addSpecifyNo42 = d.getElementById('frm2550qv2024:addSpecifyNo42').value;
        var otherSpecify42 = parseFloat(d.getElementById('frm2550qv2024:otherSpecify42').value);

        // Ensure otherSpecify42 is a valid number
        if (isNaN(otherSpecify42)) {
            alert(" (Item 42) is a required field");
            return;
        }

        // Condition 1: addSpecifyNo42 is empty and otherSpecify42 > 0
        if (addSpecifyNo42 === "" && otherSpecify42 > 0) {
            alert("Specify field (Item 42) is required ");
            return;
        }

        // Condition 2: addSpecifyNo42 is not empty and otherSpecify42 == 0
        if (addSpecifyNo42 !== "" && otherSpecify42 === 0) {
            alert(" (Item 42) value is required when Specify field is provided.");
            return;
        }



        // Item 47
        // Get the values for Item 47 fields
        var addSpecifyNo47 = d.getElementById('frm2550qv2024:addSpecifyNo47').value;
        var otherSpecify47 = parseFloat(d.getElementById('frm2550qv2024:otherSpecify47').value);

        // Ensure otherSpecify47 is a valid number
        if (isNaN(otherSpecify47)) {
            alert(" (Item 47) is a required field.");
            return;
        }

        // Condition 1: addSpecifyNo47 is empty and otherSpecify47 > 0
        if (addSpecifyNo47 === "" && otherSpecify47 > 0) {
            alert("Specify field (Item 47) is required field.");
            return;
        }

        // Condition 2: addSpecifyNo47 is not empty and otherSpecify47 == 0
        if (addSpecifyNo47 !== "" && otherSpecify47 === 0) {
            alert(" (Item 47) value is required when Specify field is provided.");
            return;
        }


        // Get the values for Item 56 fields
        var addSpecifyNo56 = d.getElementById('frm2550qv2024:addSpecifyNo56').value;
        var otherSpecify56 = d.getElementById('frm2550qv2024:otherSpecify56').value;

        // Parse otherSpecify56 as a float and validate
        var otherSpecify56Value = parseFloat(otherSpecify56);

        // Ensure otherSpecify56 is a valid number
        if (otherSpecify56 !== "" && isNaN(otherSpecify56Value)) {
            alert(" (Item 56) must be a valid number.");
            return;
        }

        // Condition 1: addSpecifyNo56 is empty and otherSpecify56 > 0
        if (addSpecifyNo56 === "" && otherSpecify56Value > 0) {
            alert("Specify field (Item 56) is required field.");
            return;
        }

        // Condition 2: addSpecifyNo56 is not empty and otherSpecify56 == 0
        if (addSpecifyNo56 !== "" && (otherSpecify56 === "" || otherSpecify56Value === 0)) {
            alert("(Item 56) value is required when Specify field is provided.");
            return;
        }




        AllControlDisabled(true);

        alert("Validation successful. Click on Edit if you wish to modify your entries.");
        return;
    }

