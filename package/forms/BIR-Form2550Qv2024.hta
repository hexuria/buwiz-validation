    // CHECK IF INPUT FIELD IS NULL
    function checkInputFieldNewSched1() {
        var size = sched1ToCommit.length;
        for (var i = 0; i < size; i++) {
            if
                (
                d.getElementById('txtDatePurchase1' + i).value == "" ||
                d.getElementById('txtSourceCode1' + i).value == "" ||
                d.getElementById('txtDescription1' + i).value == "" ||
                d.getElementById('txtAmountPurchase1' + i).value == 0 ||
                d.getElementById('txtInputTax1' + i).value == 0 ||
                d.getElementById('txtEstimatedLife1' + i).value == "" ||
                d.getElementById('txtRecognizedLife1' + i).value == "" ||
                d.getElementById('txtAllowedInputTax1' + i).value == "" ||
                d.getElementById('txtBalanceInputTax1' + i).value == ""
            ) {
                alert("Empty fields are not allowed ");
                return;
            }

            inputDate = d.getElementById('txtDatePurchase1' + i).value;

            // DATE VALIDATION
            if (inputDate != "") {
                var result = inputDate.split("/")
                if (result.length == 3) {
                    var month = result[0];
                    var day = result[1];
                    var year = result[2];
                    var isLeap = new Date(year, 1, 29).getMonth() == 1;

                    if (isNaN(month) || isNaN(day) || isNaN(year)) {
                        alert("Please enter a valid date for Date of Purchase on row " + (i + 1) + "\n" + "Please enter a date in the MM/DD/YYYY format. 1");
                        return;
                    }
                    else {
                        if (month == 2) {
                            if (!isLeap && day == 29) {
                                alert("Invalid entry on row " + (i + 1) + ". Date of Purchase must be within the Return Period only. Must be below 29");
                                return;
                            }
                            if (!isLeap && day > 29) {
                                alert("Invalid entry on row " + (i + 1) + ". Date of Purchase must be within the Return Period only. Must be below 29");
                                return;
                            }
                            if (isLeap && day > 29) {
                                alert("Invalid entry on row " + (i + 1) + ". Date of Purchase must be within the Return Period only. Must be below 29");
                                return;
                            }

                        }
                    }
                }
                else {
                    alert("Invalid entry on row " + (i + 1) + " Please enter a date in the MM/DD/YYYY format.");
                    return;
                }
            }
        }
        return true;
    }

    // NEW FUNCTION FOR SCHEDULE 2 - ALDRIN =====================================================================================================================================================================

    function enableDataInput() {
        if (d.getElementById('frm2550qv2024:exemptSales').value <= 0) {
            d.getElementById('frm2550qv2024:sched2InputTaxDirect').disabled = true;
            d.getElementById('frm2550qv2024:sched2AmountInputTax').disabled = true;
        } else {
            d.getElementById('frm2550qv2024:sched2InputTaxDirect').disabled = false;
            d.getElementById('frm2550qv2024:sched2AmountInputTax').disabled = false;
        }
    }

    // FOR SCHEDULE 3 - ALDRIN =====================================================================================================================================================================

    // COMPUTATION FOR SCHEDULE 3
    function dateSched3() {
        var size = sched3ToCommit.length;

        // Retrieve the return period range
        var RtnPeriodFromNo4 = document.getElementById('frm2550qv2024:RtnPeriodFromNo4').value;
        var RtnPeriodToNo4 = document.getElementById('frm2550qv2024:RtnPeriodToNo4').value;

        if (!RtnPeriodFromNo4 || !RtnPeriodToNo4) {
            alert("Return Period must be defined.");
            return;
        }

        // Parse the return period dates
        var returnFromDateParts = RtnPeriodFromNo4.split("/");
        var returnToDateParts = RtnPeriodToNo4.split("/");
        var returnStartDate = new Date(returnFromDateParts[2], returnFromDateParts[0] - 1, returnFromDateParts[1]);
        var returnEndDate = new Date(returnToDateParts[2], returnToDateParts[0] - 1, returnToDateParts[1]);

        for (var i = 0; i < size; i++) {
            var inputDate = document.getElementById('txtDateCovered3' + i).value;
            var inputDateTo = document.getElementById('txtDateCovered3To' + i).value;

            // Check if both dates are provided
            if (!inputDate || !inputDateTo) {
                alert("Date fields cannot be empty.");
                continue;
            }

            // Parse the input dates
            var inputDateParts = inputDate.split("/");
            var inputDateToParts = inputDateTo.split("/");
            var fromDate = new Date(inputDateParts[2], inputDateParts[0] - 1, inputDateParts[1]);
            var toDate = new Date(inputDateToParts[2], inputDateToParts[0] - 1, inputDateToParts[1]);

            // Validate if the dates are within the return period
            if (fromDate < returnStartDate || fromDate > returnEndDate || toDate < returnStartDate || toDate > returnEndDate) {
                document.getElementById('txtDateCovered3' + i).value = "";
                document.getElementById('txtDateCovered3To' + i).value = "";
                alert("Dates must fall within the Return Period: " + RtnPeriodFromNo4 + " to " + RtnPeriodToNo4);
                continue;
            }

            // Ensure "From" date is not after "To" date
            if (fromDate > toDate) {
                document.getElementById('txtDateCovered3' + i).value = "";
                document.getElementById('txtDateCovered3To' + i).value = "";
                alert("'From' date cannot be after 'To' date.");
                continue;
            }
        }
    }


    function computeSched3() {
        var size = sched3ToCommit.length;
        var incomePayment = 0;
        var taxWithHeld = 0;

        if (size === 0) {
            d.getElementById('txtTotalAmountofIncomePayment').value = '0.00';
            d.getElementById('txtTotalAmoungOfTaxWithHeld').value = '0.00';
            return; // Exit function early since there are no items to process
        }



        for (i = 0; i < size; i++) {

            incomePayment = incomePayment * 1 + (NumWithComma(d.getElementById('txtIncomePayment3' + i).value));
            taxWithHeld = taxWithHeld * 1 + (NumWithComma(d.getElementById('txtTotalTaxWithHeld3' + i).value));

            // GET TOTAL AMOUNT OF Income Payment
            d.getElementById('txtTotalAmountofIncomePayment').value = formatCurrency(incomePayment);
            d.getElementById('sched3TotalIncome').value = d.getElementById('txtTotalAmountofIncomePayment').value

            // GET TOTAL AMOUNF OF Balance of Tax WithHEld
            d.getElementById('txtTotalAmoungOfTaxWithHeld').value = formatCurrency(taxWithHeld);
