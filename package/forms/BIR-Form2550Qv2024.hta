        }

        if (size < 1) {
            specify56ToCommit[size] = new NewSpecifyNo56();
            specify56ToCommit[size].txtSpecifyNo56Description = externalInputValueDescription;
            specify56ToCommit[size].txtSpecifyNo56Amount = externalInputValueTotal;
        }

        specify56ToCommit.splice(index, 1);
        $('#tbodyNo56').html("");
        for (var i = 0; i < specify56ToCommit.length; i++) {
