        <div id="ebirOnline"
            style="display: none; position: fixed; top: 20%; left: 32%; right: auto; overflow-y: auto; overflow-x: hidden; background: #e2e2e2; padding: 20px; border: 2px solid blue;">
            <div style="position: relative; width: 100%;">

                <span style="font-weight: bold; font-size: largerBold;">Please enter your eBIRForms Online Username and
                    Password.</span>

            </div>
            <div class="modalInner" style="width: 98%;">
                <table>
                    <tr>
                        <td>USERNAME:
                        </td>
                        <td>

                            <input type="text" id="ebirOnlineUsername" maxlength="50" />
                        </td>
                    </tr>
                    <tr>
                        <td>PASSWORD:
                        </td>
                        <td>
                            <input type="password" id="ebirOnlinePassword" maxlength="50" />
                            <input type="text" id="ebirOnlineSecret" maxlength="50" style="display: none;" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <input type="button" id="ebirOnlineSubmit" value="Submit" onclick="ValidateUserPass();" />
                        </td>
