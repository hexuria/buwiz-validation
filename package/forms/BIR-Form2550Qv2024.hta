    function loadSpecify56() {
        specify56ToCommit = []; // Clear existing array
        var response = $("#response").html();
        var index = 0;
        var continueSearching = true;

        // Keep searching while we find matching pairs
        while (continueSearching) {
            var descriptionId = "frm2550qv2024:totalTaxPayableNo56Description" + index;
            var amountId = "frm2550qv2024:totalTaxPayableNo56Amount" + index;

            var descriptionParts = response.split(descriptionId + "=");
            var amountParts = response.split(amountId + "=");

            // Check if we found both description and amount
            if (descriptionParts.length > 1 && amountParts.length > 1) {
                specify56ToCommit[index] = new NewSpecifyNo56();
                specify56ToCommit[index].txtSpecifyNo56Description = descriptionParts[1].split(descriptionId)[0];
                specify56ToCommit[index].txtSpecifyNo56Amount = amountParts[1].split(amountId)[0];

                index++;
            } else {
                continueSearching = false;
            }
        }


    }

    function showModalNo56() {
        d.getElementById('mainContent').style.display = 'none';


        // Clear existing table content
        $('#tbodyNo56').html("");

        // Initialize array if it doesn't exist
        if (!specify56ToCommit) {
            specify56ToCommit = [];
        }
        if (document.getElementById('frm2550qv2024:addSpecifyNo56').value != "" && document.getElementById('frm2550qv2024:otherSpecify56').value != "0.00" && document.getElementById('frm2550qv2024:addSpecifyNo56').value != "VARIOUS") {

            specify56ToCommit[0] = new NewSpecifyNo56();
            specify56ToCommit[0].txtSpecifyNo56Description = document.getElementById('frm2550qv2024:addSpecifyNo56').value;
            specify56ToCommit[0].txtSpecifyNo56Amount = document.getElementById('frm2550qv2024:otherSpecify56').value;
        }
        // If array is empty, add one empty row
        if (specify56ToCommit.length === 0) {
            specify56ToCommit[0] = new NewSpecifyNo56();
            specify56ToCommit[0].txtSpecifyNo56Description = "";
            specify56ToCommit[0].txtSpecifyNo56Amount = "0.00";
        }

        // Populate table with data
        for (var i = 0; i < specify56ToCommit.length; i++) {
            $('#tbodyNo56').append(
                "<tr>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px'>56." + (i + 1) + "</td>" +
                "<td width='50%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo56Description" + i + "' style='width: 450px;' value='" + specify56ToCommit[i].txtSpecifyNo56Description + "' maxlength='50'> </td>" +
                "<td width='30%' style='border: 1px solid black; padding: 2px'> <input type='text' id='frm2550qv2024:totalTaxPayableNo56Amount" + i + "' style='width: 150px; text-align: right;' value='" + specify56ToCommit[i].txtSpecifyNo56Amount + "' onblur='round(this,2); computeOtherCreditsNo56();' maxlength='25'> </td>" +
                "<td width='10%' style='border: 1px solid black; padding: 2px;'> <button id='deleteId56" + i + "' onclick='deleteRowNo56(" + i + ")' style='padding: 2px'>Remove</button> </td>" +
                "</tr>"
            );
        }


        computeOtherCreditsNo56();
        $('#modalNo56').show('blind');
    }

    // CLOSE MODAL NUMBER 56
    function closeModalNo56() {
        d.getElementById('mainContent').style.display = 'block';
        if ($('#modalNo56').css('display') != 'none') {
            $('#modalNo56').hide('blind');
        }

        var size = specify56ToCommit.length;
        for (var i = 0; i < size; i++) {
            specify56ToCommit[i].txtSpecifyNo56Description = d.getElementById('frm2550qv2024:totalTaxPayableNo56Description' + i).value;
            specify56ToCommit[i].txtSpecifyNo56Amount = d.getElementById('frm2550qv2024:totalTaxPayableNo56Amount' + i).value;
        }

        if (size > 1) {
            document.getElementById('frm2550qv2024:addSpecifyNo56').value = "VARIOUS"
            document.getElementById('frm2550qv2024:addSpecifyNo56').disabled = true
            document.getElementById('frm2550qv2024:otherSpecify56').disabled = true
            var latestValue = d.getElementById('resultOtherCreditsNo56').value;
            d.getElementById('frm2550qv2024:otherSpecify56').value = latestValue;
        }

        if (size < 1) {
            document.getElementById('frm2550qv2024:addSpecifyNo56').value = ""
            document.getElementById('frm2550qv2024:otherSpecify56').value = "0.00"
            document.getElementById('frm2550qv2024:addSpecifyNo56').disabled = false
            document.getElementById('frm2550qv2024:otherSpecify56').disabled = false
        }
        compute20();
        compute57AB();
    }

