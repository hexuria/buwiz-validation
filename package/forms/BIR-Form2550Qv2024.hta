    // SHOW MODAL NUMBER 19
    function showModalNo19() {
        d.getElementById('mainContent').style.display = 'none';


        // Clear existing table content
        $('#tbodyNo19').html("");

        // Initialize array if it doesn't exist
        if (!specify19ToCommit) {
            specify19ToCommit = [];
        }

        // If array is empty, add one empty row
        if (specify19ToCommit.length === 0) {
            specify19ToCommit[0] = new NewSpecifyNo19();
            specify19ToCommit[0].txtSpecifyNo19Description = "";
            specify19ToCommit[0].txtSpecifyNo19Amount = "0.00";
        }
        if (document.getElementById('frm2550qv2024:addSpecifyNo19').value != "" && document.getElementById('frm2550qv2024:otherCreditsNo19').value != "0.00" && document.getElementById('frm2550qv2024:addSpecifyNo19').value != "VARIOUS") {

            specify19ToCommit[0] = new NewSpecifyNo19();
            specify19ToCommit[0].txtSpecifyNo19Description = document.getElementById('frm2550qv2024:addSpecifyNo19').value;
            specify19ToCommit[0].txtSpecifyNo19Amount = document.getElementById('frm2550qv2024:otherCreditsNo19').value;
        }
        // Populate table with data
        for (var i = 0; i < specify19ToCommit.length; i++) {
            $('#tbodyNo19').append(
