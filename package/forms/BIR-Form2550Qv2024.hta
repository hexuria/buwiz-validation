    function sendEmail(sourceElement) {

        var isRegisteredTP = (sourceElement.id !== "ebirOnlineConfirmSubmit") ? "N" : "Y"; if (isRegisteredTP == "Y" && (ValidateConfirm() == false)) { return; }
        var isAutoEnroll = (sourceElement.id == "ebirEnrollYes") ? "Y" : "N";
