    for(var j = 0; j < rowCount; j++ ) {
        if(!d.getElementById("chkSchedule1ADelete" + j).checked) {
            scheduleTemp[i++] = schedule1ToCommit[j];
        }
    }

    if(scheduleTemp.length > 0) {
        schedule1ToCommit = new Array();
        
        $('#tblSched1A').html("");

        for(i = 0; i < scheduleTemp.length; i++) {
            schedule1ToCommit[i] = scheduleTemp[i];

            $('#tblSched1A').html(d.getElementById('tblSched1A').innerHTML + "<tr>" +
            "<td width='5%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkSchedule1ADelete" + i + "'onclick='Schedule1A_Checked("+i+")'></font>&nbsp;"+ (i+1) +"</td>" + 
            "<td align='center'><input onblur='' type='text' value='" + schedule1ToCommit[i].txtOCTNo + "' style='color: black; text-align: right;' size='11' maxlength='50' id='frm2000OT:sched1A:txtOCTNo" + i + "' /></td>" +
            "<td align='center'><input type='text' value='" + schedule1ToCommit[i].txtTaxDecNo + "' style='color: black; text-align: right;' size='18' maxlength='50' id='frm2000OT:sched1A:txtTaxDecNo" + i + "' /></td>" + 
            "<td align='center'><input type='text' value='" + schedule1ToCommit[i].txtLoc + "' style='color: black; text-align: right;' size='71' maxlength='50' id='frm2000OT:sched1A:txtLoc" + i + "' /></td>" +
            "</tr>");
        }
    } else {
        schedule1ToCommit = new Array();
        $('#tblSched1A').html("");
    }
    TaxComputation();
} 

function deleteSchedule1A_2() {

    var scheduleTemp = new Array();
    var rowCount = d.getElementById("tblSched1A1").rows.length;
    for(var i = 0; i < rowCount; i++ ) {
        
        schedule1_2ToCommit[i] = new Schedule1_2();
