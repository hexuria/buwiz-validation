                if (checkNetConnection() === true) {

                    HideContainer("container");
                    if (document.getElementById('txtFinalFlag').value == "3") {

                        document.getElementById('txtFinalFlag').value = "2";
                    }
                    else {

                        document.getElementById('txtFinalFlag').value = "0";
                    }

                    initializeOnOpenAlertEmail();
                    ShowContainer("ebirEnroll");
                }
                else {

                    alert("The system detected that you have no internet connection.\nPlease contact your internet service provider.");
                    document.getElementById('txtFinalFlag').value = "3";
                    saveEncryptedProfile();
                    checkFinalCopyBtn('2000OTv2018');
                    ShowContainer('container');
                }
