    function validate() {
       
        if(d.getElementById("frm2000OT:txtTransactionDate").value.length == ""){
            alert("Please enter a valid date on Item 1.");
            d.getElementById('frm2000OT:txtTransactionDate').focus();
            return;
        }
			enableSaveButton();
        if (d.getElementById('frm2000OT:ATC_1').checked == false && d.getElementById('frm2000OT:ATC_2').checked == false && d.getElementById('frm2000OT:ATC_3').checked == false) {
            alert("Please choose an ATC on item 3.");
            return;
        }     

        if( (d.getElementById('frm2000OT:txtTIN1').value == "" || d.getElementById('frm2000OT:txtTIN2').value == "" || d.getElementById('frm2000OT:txtTIN3').value == "" || d.getElementById('frm2000OT:txtBranchCode').value == "")  )
        {
            alert("Please enter a valid TIN number on Item 5.");
            return;
        }       

        if( (d.getElementById('frm2000OT:txtRDOCode').value == "")  )
        {
            alert("Please enter a valid RDO Code on Item 6.");
            return;
        }       
  
        if( (d.getElementById('frm2000OT:txtTaxpayerName').value == "")  )
        {
            alert("Please enter a valid Taxpayer Name on Item 7.");
            return;
        }
        if( (d.getElementById('frm2000OT:txtTelNum').value == "")  )
        {
            alert("Please enter a valid Telephone Number on Item 9.");
            return;
        }
        if( (d.getElementById('frm2000OT:txtAddress').value == "")  )
        {
            alert("Please enter Taxpayer's Registered Address on Item 8.");
            return;
        }     

        if( (d.getElementById('frm2000OT:txtZipCode').value == "")  )
        {
            alert("Please enter Taxpayer's Zip Code on Item 8A.");
            return;
        }

        if (d.getElementById('frm2000OT:optParty_1').checked == false && d.getElementById('frm2000OT:optParty_2').checked == false) {
            alert("Please choose one (1) Other Party to the transaction on item 11.");
            return;
        }

        if( (d.getElementById('frm2000OT:txtOtherName').value == "")  )
        {
            alert("Please enter a name for item 11A. The name that you will enter corresponds to your choice in item 11.");
            return;
        }

        if( (d.getElementById('frm2000OT:txtOtherTIN').value == "")  )
        {
            alert("Please enter TIN for item 11B. The TIN that you will enter is the TIN of your entry in item 11A.");
            return;
        }

        if (d.getElementById("frm2000OT:rbTransNature_1").checked == false && d.getElementById("frm2000OT:rbTransNature_2").checked == false && d.getElementById("frm2000OT:rbTransNature_3").checked == false) {
            alert("Please choose one (1) Nature of Transaction on item 12.");
            return;
        }

        if (d.getElementById("frm2000OT:rbTransNature_2").checked == true && d.getElementById("frm2000OT:txtRealLocation").value == "") {
            alert("Please enter the address of the Location of Real Property in item 13.");
            return;
        }

        if (d.getElementById("frm2000OT:rbTransNature_3").checked == true && d.getElementById("frm2000OT:txtRealLocation").value == "") {
            alert("Please enter the address of the Location of Real Property in item 13.");
            return;
        }
        
        disableAllControl();

        alert("Validation successful. Click on 'Edit' if you wish to modify your entries.");
        return;
    }

