function ProcessAmended() {
    if (d.getElementById("frm2000OT:AmendedRtn_1").checked) {
        d.getElementById("frm2000OT:txtTax18").disabled = false;
        TaxComputation();
    } else {
        d.getElementById("frm2000OT:txtTax18").value = "0.00"
        d.getElementById("frm2000OT:txtTax18").disabled = true;
        TaxComputation();
    }
}

function ProcessAmended2() {
    if (d.getElementById("frm2000OT:AmendedRtn_1").checked) {
        d.getElementById("frm2000OT:txtTax18").disabled = false;
    } else {
        d.getElementById("frm2000OT:txtTax18").disabled = true;
    }
}

function TaxComputation(){
    //TAX DUE
    var ATC = ATC_Selected;

    var TaxBase14 = ComputeSharesOfStock(ATC);
    // d.getElementById("frm2000OT:txtTax14").value = formatCurrency(NumWithComma(TaxBase14.toFixed(2).toString()));
    // var TaxBase14 = NumWithComma(d.getElementById("frm2000OT:txtTax14").value);
    var TaxBase15 = ComputeRealProperty(ATC);
    //var TaxRate = NumWithComma(d.getElementById("frm2000OT:txtTax16").value)
	
    if (d.getElementById('frm2000OT:rbTransNature_1').checked == false && d.getElementById('frm2000OT:rbTransNature_2').checked == false && d.getElementById('frm2000OT:rbTransNature_3').checked == false) {
    } else {
        if (d.getElementById('frm2000OT:rbTransNature_1').checked == true) {
            switch (ATC){
                case "DO102":
                    if(TaxBase14 !== 0){
                        // Remove +1 to correct the computation 020926
                        var RoundTaxBase = (Math.floor(TaxBase14 / 200) * 1.50);
                        d.getElementById("frm2000OT:txtTax17").value = formatCurrency(NumWithComma(RoundTaxBase.toFixed(2).toString()));
                    }else{
                        d.getElementById("frm2000OT:txtTax17").value = formatCurrency("0.00");
                    }
                    break;
               

                case "DO122":
                    var RoundTaxBase = Math.round(TaxBase14 / 1000) * 0;
                    d.getElementById("frm2000OT:txtTax17").value = formatCurrency(NumWithComma(RoundTaxBase.toFixed(2).toString()));
                    break;
                case "DO125":
                    var RoundTaxBase = TaxBase14 * 0.50;
                    d.getElementById("frm2000OT:txtTax17").value = formatCurrency(NumWithComma(RoundTaxBase.toFixed(2).toString()));
                    break;
            }
        } else if (d.getElementById('frm2000OT:rbTransNature_2').checked == true || d.getElementById('frm2000OT:rbTransNature_3').checked == true)  {
            switch (ATC){
                case "DO102":
                    var RoundTaxBase = Math.round(TaxBase15 / 200) * 0;
                    d.getElementById("frm2000OT:txtTax17").value = formatCurrency(NumWithComma(RoundTaxBase.toFixed(2).toString()));
                    break;
                case "DO122":
                    var RoundTaxBase = Math.round(TaxBase15 / 1000) * 15;
                    d.getElementById("frm2000OT:txtTax17").value = formatCurrency(NumWithComma(RoundTaxBase.toFixed(2).toString()));
                    break;
                case "DO125":
                    var RoundTaxBase = TaxBase15 * 0;
                    d.getElementById("frm2000OT:txtTax17").value = formatCurrency(NumWithComma(RoundTaxBase.toFixed(2).toString()));
                    break;
            }
        }
    }

    //TAX STILL DUE / OVERPAYMENT
    var TaxStillDue = NumWithComma(d.getElementById("frm2000OT:txtTax17").value) - NumWithComma(d.getElementById("frm2000OT:txtTax18").value);
    d.getElementById('frm2000OT:txtTax19').value = formatCurrency(NumWithComma(TaxStillDue.toFixed(2).toString()));

    //TOTAL PENALTIES
    var TotalPenalties = NumWithComma(d.getElementById("frm2000OT:txtTax20A").value) + NumWithComma(d.getElementById("frm2000OT:txtTax20B").value) + NumWithComma(d.getElementById("frm2000OT:txtTax20C").value);
    d.getElementById('frm2000OT:txtTax20D').value = formatCurrency(NumWithComma(TotalPenalties.toFixed(2).toString()));

    //TOTAL AMOUNT PAYABLE
    // var TotalAmountPayable = NumWithComma(d.getElementById("frm2000OT:txtTax19").value) + NumWithComma(d.getElementById("frm2000OT:txtTax20D").value);
    // d.getElementById('frm2000OT:txtTax21').value = formatCurrency(NumWithComma(TotalAmountPayable.toFixed(2).toString()));
    
    // ✅ New validation: no offsetting of penalties, if item 19 if negative 020926
    var tax19 = NumWithComma(d.getElementById("frm2000OT:txtTax19").value.replace(/,/g, ""));
    var tax20D = NumWithComma(d.getElementById("frm2000OT:txtTax20D").value.replace(/,/g, ""));

    if (tax19 < 0) {
        tax19 = 0;
    }
    var TotalAmountPayable = tax19 + tax20D;
    d.getElementById("frm2000OT:txtTax21").value =formatCurrency(NumWithComma(TotalAmountPayable.toFixed(2)));

}




function ComputeSharesOfStock(ATC){

    var StockWithParValue = 0;
    var StockWithoutParValue = 0;

    for(var i=0;i<d.getElementById("tblSched1B").rows.length;i++) {
        
        //GETTING THE TOTAL OF APPLICABLE COLUMN
        StockWithParValue += NumWithComma(d.getElementById("frm2000OT:sched1B:txtParValOfShares"+i).value);
        StockWithoutParValue += NumWithComma(d.getElementById("frm2000OT:sched1B:txtDSTPaid"+i).value);
    }

    switch (ATC){

        case "DO102":
            d.getElementById("frm2000OT:txtTax14").value = formatCurrency(NumWithComma(StockWithParValue.toFixed(2).toString()));
            return StockWithParValue
            break;

        case "DO122":
            // d.getElementById("frm2000OT:txtTax14").value = "0.00"
            break;

        case "DO125":
            d.getElementById("frm2000OT:txtTax14").value = formatCurrency(NumWithComma(StockWithoutParValue.toFixed(2).toString()));
            return StockWithoutParValue
            break;
    }
}

function ComputeRealProperty(ATC){
    
    var TaxableBaseRealProperty = 0;
    var FMVTotal = 0;

    for(var i=0;i<d.getElementById("tblSched1A1").rows.length;i++) {
        if (NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+i).value) >= NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+i).value) ){
            d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value = formatCurrency(NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+i).value));
            FMVTotal += NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value);
            d.getElementById("frm2000OT:sched1A:txtFMVTotal").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
            d.getElementById("frm2000OT:Sched2:txtTotalFairMarket").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
        } else if (NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+i).value) > NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+i).value)) {
            d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value = formatCurrency(NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+i).value));
            FMVTotal += NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value);
            d.getElementById("frm2000OT:sched1A:txtFMVTotal").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
            d.getElementById("frm2000OT:Sched2:txtTotalFairMarket").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
        }

    }
    
    switch (ATC){

        case "DO102":
            break;

        case "DO122":
            // d.getElementById("frm2000OT:txtTax14").value = "0.00"

            d.getElementById("frm2000OT:sched1A:txtFMVTotal").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
            d.getElementById("frm2000OT:Sched2:txtTotalFairMarket").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
            
            //COMPARE A, B and C
            if (d.getElementById("frm2000OT:Sched2:txtOthers").value == "" && d.getElementById("frm2000OT:Sched2:txtOthersAmount").value == "0.00"){
                if (NumWithComma(d.getElementById("frm2000OT:Sched2:txtGrossSellingPrice").value) >= NumWithComma(d.getElementById("frm2000OT:Sched2:txtTotalFairMarket").value) ){
                    TaxableBaseRealProperty = (NumWithComma(d.getElementById("frm2000OT:Sched2:txtGrossSellingPrice").value))
                    d.getElementById("frm2000OT:Sched2:txtTaxableBase").value = formatCurrency(NumWithComma(TaxableBaseRealProperty.toFixed(2).toString()));
                } else {
                    TaxableBaseRealProperty = (NumWithComma(d.getElementById("frm2000OT:Sched2:txtTotalFairMarket").value))
                    d.getElementById("frm2000OT:Sched2:txtTaxableBase").value = formatCurrency(NumWithComma(TaxableBaseRealProperty.toFixed(2).toString()));
                }
            } else {
                TaxableBaseRealProperty = (NumWithComma(d.getElementById("frm2000OT:Sched2:txtOthersAmount").value))
                d.getElementById("frm2000OT:Sched2:txtTaxableBase").value = formatCurrency(NumWithComma(TaxableBaseRealProperty.toFixed(2).toString()));
            }   

            d.getElementById("frm2000OT:txtTax15").value = formatCurrency(NumWithComma(TaxableBaseRealProperty.toFixed(2).toString()));
            return TaxableBaseRealProperty;
            break;

        case "DO125":
            break;
    }
}


function ComputeFMVAddDel() {
    var FMVTotal = 0;
    for(var i=0;i<d.getElementById("tblSched1A1").rows.length;i++) {
        if (NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+i).value) >= NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+i).value) ){
            d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value = formatCurrency(NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+i).value));
            FMVTotal += NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value);
            d.getElementById("frm2000OT:sched1A:txtFMVTotal").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
            d.getElementById("frm2000OT:Sched2:txtTotalFairMarket").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
        } else if (NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+i).value) > NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+i).value)) {
            d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value = formatCurrency(NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+i).value));
            FMVTotal += NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value);
            d.getElementById("frm2000OT:sched1A:txtFMVTotal").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
            d.getElementById("frm2000OT:Sched2:txtTotalFairMarket").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
        }      
    }
}

function ComputeFMV(x){
    var FMVTotal = 0;

    //COMPARE WHICH COLUMN HAS THE HIGHER VALUE
    if (NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+x).value) >= NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+x).value) ){
        d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+x).value = formatCurrency(NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+x).value));
    } else if (NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+x).value) > NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol1"+x).value)) {
        d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+x).value = formatCurrency(NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVCol2"+x).value));
    }   

    //GET TOTAL OF FMV
    for(var i=0;i<d.getElementById("tblSched1A1").rows.length;i++) {
        FMVTotal += NumWithComma(d.getElementById("frm2000OT:sched1A:txtFMVSubTot"+i).value);
        d.getElementById("frm2000OT:sched1A:txtFMVTotal").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
        d.getElementById("frm2000OT:Sched2:txtTotalFairMarket").value = formatCurrency(NumWithComma(FMVTotal.toFixed(2).toString()));
    }
}

function addSchedule1A() {

    var rowCount = d.getElementById("tblSched1A").rows.length;
    for(var i = 0; i < rowCount; i++ ) {
        
        schedule1ToCommit[i] = new Schedule1();
        schedule1ToCommit[i].txtOCTNo = d.getElementById("frm2000OT:sched1A:txtOCTNo"+i).value;
        schedule1ToCommit[i].txtTaxDecNo = d.getElementById("frm2000OT:sched1A:txtTaxDecNo"+i).value;
        schedule1ToCommit[i].txtLoc = d.getElementById("frm2000OT:sched1A:txtLoc"+i).value;
    }

    i = schedule1ToCommit.length;
    schedule1ToCommit[i] = new Schedule1();
    $('#tblSched1A').html("");
    
    for(i = 0; i < schedule1ToCommit.length; i++) {

        $('#tblSched1A').html(d.getElementById('tblSched1A').innerHTML + "<tr>" +
        "<td width='5%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkSchedule1ADelete" + i + "'onclick='Schedule1A_Checked("+i+")'></font>&nbsp;"+ (i+1) +"</td>" + 
