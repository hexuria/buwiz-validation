function deleteSchedule1B(){

    var scheduleTemp = new Array();
    var rowCount = d.getElementById("tblSched1B").rows.length;
    for(var i = 0; i < rowCount; i++ ) {
        
        schedule1BToCommit[i] = new Schedule1B();
        schedule1BToCommit[i].txtNameOfCorpStock = d.getElementById("frm2000OT:sched1B:txtNameOfCorpStock"+i).value;
        schedule1BToCommit[i].txtNoOfSharesSold = d.getElementById("frm2000OT:sched1B:txtNoOfSharesSold"+i).value;
        schedule1BToCommit[i].txtStockCertNo = d.getElementById("frm2000OT:sched1B:txtStockCertNo"+i).value;
        schedule1BToCommit[i].txtParValOfShares = d.getElementById("frm2000OT:sched1B:txtParValOfShares"+i).value;
        schedule1BToCommit[i].txtDSTPaid = d.getElementById("frm2000OT:sched1B:txtDSTPaid"+i).value;
    }

    i = 0;
    for(var j = 0; j < rowCount; j++ ) {
        if(!d.getElementById("chkSchedule1BDelete" + j).checked) {
            scheduleTemp[i++] = schedule1BToCommit[j];
        }
    }

    if(scheduleTemp.length > 0) {
        schedule1BToCommit = new Array();
        
        $('#tblSched1B').html("");

        for(i = 0; i < scheduleTemp.length; i++) {
            schedule1BToCommit[i] = scheduleTemp[i];

            $('#tblSched1B').html(d.getElementById('tblSched1B').innerHTML + "<tr>" +
                "<td width='3%'><font size='1' style='font-weight:bold'><input type='checkbox' id='chkSchedule1BDelete" + i + "'></font></td>" + 
                "<td align='center'><input type='text' value='" + schedule1BToCommit[i].txtNameOfCorpStock + "' style='color: black; text-align: right;' size='35' maxlength='50' id='frm2000OT:sched1B:txtNameOfCorpStock" + i + "' /></td>" +
                "<td align='center'><input type='text' value='" + schedule1BToCommit[i].txtNoOfSharesSold + "' style='color: black; text-align: right;' size='8' maxlength='50' id='frm2000OT:sched1B:txtNoOfSharesSold" + i + "' /></td>" + 
                "<td align='center'><input type='text' value='" + schedule1BToCommit[i].txtStockCertNo + "' style='color: black; text-align: right;' size='8' maxlength='50' id='frm2000OT:sched1B:txtStockCertNo" + i + "' /></td>" +
                "<td align='center'><input type='text' value='" + schedule1BToCommit[i].txtParValOfShares + "' style='color: black; text-align: right;' size='13' maxlength='50' id='frm2000OT:sched1B:txtParValOfShares" + i + "' onkeypress='return numbersonly(this, event)' onblur='round(this,2);TaxComputation()' /></td>" +
                "<td align='center'><input type='text' value='" + schedule1BToCommit[i].txtDSTPaid + "' style='color: black; text-align: right;' size='25' maxlength='50' id='frm2000OT:sched1B:txtDSTPaid" + i + "' onkeypress='return numbersonly(this, event)' onblur='round(this,2);TaxComputation()' /></td>" +
                "</tr>");
        }
    } else {
        schedule1BToCommit = new Array();
        $('#tblSched1B').html("");
    }
    TaxComputation();
} 


function loadSchedule1() {

    //SCHEDULE1A
    var OCTNo = String($("#response").html()).split("frm2000OT:sched1A:txtOCTNo");
    var TaxDecNo = String($("#response").html()).split("frm2000OT:sched1A:txtTaxDecNo");
    var Loc = String($("#response").html()).split("frm2000OT:sched1A:txtLoc");

    //SCHEDULE1A1
    var Lot = String($("#response").html()).split("frm2000OT:sched1A:txtLot");
    var Classification = String($("#response").html()).split("frm2000OT:sched1A:txtClassification");
    var Area = String($("#response").html()).split("frm2000OT:sched1A:txtArea");
    var FMVCol1 = String($("#response").html()).split("frm2000OT:sched1A:txtFMVCol1");
    var FMVCol2 = String($("#response").html()).split("frm2000OT:sched1A:txtFMVCol2");
    var FMVSubTot = String($("#response").html()).split("frm2000OT:sched1A:txtFMVSubTot");

    //SCHEDULE 1A (START)
    $('#tblSched1A').html("");

    var i = 0;
    for(var j = 0; j < OCTNo.length; j++) {
        if (j % 2 != 0) {//to not get other div splits
    
            //get values
            schedule1ToCommit[i] = new Schedule1();
            schedule1ToCommit[i].txtOCTNo = OCTNo[j].split('=')[1];
            schedule1ToCommit[i].txtTaxDecNo = TaxDecNo[j].split('=')[1];
            schedule1ToCommit[i].txtLoc = Loc[j].split('=')[1];
            
            i++;
        }
    }

    for (x=0;x< schedule1ToCommit.length;x++) {  

        $('#tblSched1A').html(d.getElementById('tblSched1A').innerHTML + "<tr>" +
            "<td width='5%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkSchedule1ADelete" + x + "'onclick='Schedule1A_Checked("+x+")'></font>&nbsp;"+ (x+1) +"</td>" + 
            "<td align='center'><input onblur='' type='text' value='" + schedule1ToCommit[x].txtOCTNo + "' style='color: black; text-align: right;' size='11' maxlength='50' id='frm2000OT:sched1A:txtOCTNo" + x + "' /></td>" +
            "<td align='center'><input type='text' value='" + schedule1ToCommit[x].txtTaxDecNo + "' style='color: black; text-align: right;' size='18' maxlength='50' id='frm2000OT:sched1A:txtTaxDecNo" + x + "' /></td>" + 
            "<td align='center'><input type='text' value='" + schedule1ToCommit[x].txtLoc + "' style='color: black; text-align: right;' size='71' maxlength='50' id='frm2000OT:sched1A:txtLoc" + x + "' /></td>" +
            "</tr>");

    }
    //SCHEDULE 1A (END)

    //SCHEDULE 1A1 (START)
    $('#tblSched1A1').html("");

    var i = 0;
    for(var j = 0; j < Lot.length; j++) {
        if (j % 2 != 0) {//to not get other div splits
    
            //get values
            schedule1_2ToCommit[i] = new Schedule1();
            schedule1_2ToCommit[i].txtLot = Lot[j].split('=')[1];
            schedule1_2ToCommit[i].txtClassification = Classification[j].split('=')[1];
            schedule1_2ToCommit[i].txtArea = Area[j].split('=')[1];
            schedule1_2ToCommit[i].txtFMVCol1 = FMVCol1[j].split('=')[1];
            schedule1_2ToCommit[i].txtFMVCol2 = FMVCol2[j].split('=')[1];
            schedule1_2ToCommit[i].txtFMVSubTot = FMVSubTot[j].split('=')[1];
            
            i++;
        }
    }

    for (x=0;x< schedule1ToCommit.length;x++) {  

        $('#tblSched1A1').html(d.getElementById('tblSched1A1').innerHTML + "<tr>" +
            "<td width='5%'><font size='1' style='font-weight:bold'><input type='checkbox'  id='chkSchedule1A1Delete" + x + "'onclick='Schedule1A1_Checked("+x+")'></font>&nbsp;"+ (x+1) +"</td>" + 
            "<td align='center'><input onblur='' type='text' value='" + schedule1_2ToCommit[x].txtLot + "' style='color: black; text-align: right;' size='11' maxlength='50' id='frm2000OT:sched1A:txtLot" + x + "' /></td>" +
            "<td align='center'><input type='text' value='" + schedule1_2ToCommit[x].txtClassification + "' style='color: black; text-align: right;' size='5' maxlength='50' id='frm2000OT:sched1A:txtClassification" + x + "' /></td>" + 
            "<td align='center'><input type='text' value='" + schedule1_2ToCommit[x].txtArea + "' style='color: black; text-align: right;' size='5' maxlength='50' id='frm2000OT:sched1A:txtArea" + x + "' /></td>" +
            "<td align='center'><input type='text' value='" + schedule1_2ToCommit[x].txtFMVCol1 + "' style='color: black; text-align: right;' size='18' maxlength='16' id='frm2000OT:sched1A:txtFMVCol1" + x + "' onkeypress='return numbersonly(this, event)' onblur='round(this,2);TaxComputation()' /></td>" +
            "<td align='center'><input type='text' value='" + schedule1_2ToCommit[x].txtFMVCol2 + "' style='color: black; text-align: right;' size='18' maxlength='16' id='frm2000OT:sched1A:txtFMVCol2" + x + "' onkeypress='return numbersonly(this, event)' onblur='round(this,2);TaxComputation()' /></td>" +
            "<td align='center'><input type='text' value='" + schedule1_2ToCommit[x].txtFMVSubTot + "' style='color: black; text-align: right;' size='18' maxlength='32' id='frm2000OT:sched1A:txtFMVSubTot" + x + "' onkeypress='return numbersonly(this, event)' onblur='round(this,2)' disabled /></td>" +
            "</tr>");

    }
    //SCHEDULE 1A1 (END)
}

