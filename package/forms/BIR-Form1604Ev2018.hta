//-------------------------- FUNCTIONS ADDED BY LCSJ --------------------------------------
function validateDate(element) {
        var strmmddyyyy = element.value;
        var isValid = true;
        var currentDate = new Date();
        var inputDate = new Date();

        if (strmmddyyyy != "") {
            var result = strmmddyyyy.split("/");
            var isLeap = new Date(result[2], 1, 29).getMonth() === 1;
            var month31 = (['01', '03', '05', '07', '08', '10', '12']);
            var month30 = (['04', '06', '09', '11']);
            var month = result[0];
            var day = result[1];
            if (result.length === 3) {
                if (isNaN(result[0] || result[1] || result[2])) {
                    isValid = false;
                }
                else if ((result[0].length != 2 || (result[0] > 12 || result[0] < 1))) {
                    // numeric check if greater not than 31 - Month.
                    isValid = false;
                }
                else if (result[1].length != 2 || (result[1] > 31 || result[1] < 1)) {
                    // numeric check if Date.
                    isValid = false;
                }
                else if (result[2].length != 4) {
                    isValid = false;
                }
                else if (month == 2) {
                    if (!isLeap && day == 29) {
                        isValid = false;
                    }
                    else if (!isLeap && day > 29) {
                        isValid = false;
                    }
                    else if (isLeap && day > 29) {
                        isValid = false;
                    }
                }
                else if (month31.contains(month) && day > 31) {
                    isValid = false;
                }
                else if (month30.contains(month) && day > 30) {
                    isValid = false;
                }

                inputDate = new Date(result[2], month - 1, day);            

            }
            else {
                isValid = false;
            }
        }

        if (!isValid) {
            alert('Please provide a valid date. (MM/DD/YYYY format)');
            element.value = '';
            element.focus();
        }
        else if (inputDate > currentDate) {
            alert('This date cannot be a future date.');
            element.value = '';
            element.focus();
        }
        else if (inputDate.getFullYear() < 2018) {
            alert('This date cannot be prior to 2018.');
            element.value = '';
            element.focus();
        }

        return isValid;
    }

    function validateYear() {

        var currentYear = new Date().getYear();
        if (d.getElementById("frm1604e:txtYear").value < 2018) {
            // alert("Please file using the old version of the form.");
            alert("Invalid data entry on item no. 1. \nEntry should be current or prior year but not be earlier than the effectivity date of January 2018.");
            d.getElementById("frm1604e:txtYear").value = "2018";
        }
        if (d.getElementById("frm1604e:txtYear").value > currentYear) {
            // alert("Invalid year. Year should not be later than the current year.");
            alert("Invalid data entry on item no. 1. \nEntry should be current or prior year but not be earlier than the effectivity date of January 2018.");
            d.getElementById("frm1604e:txtYear").value = currentYear;
        }
    }

    function computeSched1(objtax, objpenalties, objsubtotal)
    {
        var amount = NumWithComma(d.getElementById(objtax).value);
        var taxRate = NumWithComma(d.getElementById(objpenalties).value);
 
        var taxWithheld = amount + taxRate;

        d.getElementById(objsubtotal).value = formatCurrency(taxWithheld); 

        computeSched1Total();
    }

    function computeSched1Total()
    {
        var totaltaxwithheld = NumWithComma(d.getElementById('frm1604e:txtSched1TaxWithheld1').value) + 
        NumWithComma(d.getElementById('frm1604e:txtSched1TaxWithheld2').value) +
        NumWithComma(d.getElementById('frm1604e:txtSched1TaxWithheld3').value) + 
        NumWithComma(d.getElementById('frm1604e:txtSched1TaxWithheld4').value);

        var totalpentalties = NumWithComma(d.getElementById('frm1604e:txtSched1Penalties1').value) + 
        NumWithComma(d.getElementById('frm1604e:txtSched1Penalties2').value) +
        NumWithComma(d.getElementById('frm1604e:txtSched1Penalties3').value) + 
        NumWithComma(d.getElementById('frm1604e:txtSched1Penalties4').value);

        var totalamountremitted = NumWithComma(d.getElementById('frm1604e:txtSched1TotRemAmt1').value) + 
        NumWithComma(d.getElementById('frm1604e:txtSched1TotRemAmt2').value) +
        NumWithComma(d.getElementById('frm1604e:txtSched1TotRemAmt3').value) + 
        NumWithComma(d.getElementById('frm1604e:txtSched1TotRemAmt4').value);

        d.getElementById('frm1604e:txtSched1TaxWithheldTtl').value = formatCurrency(totaltaxwithheld);
        d.getElementById('frm1604e:txtSched1PenaltiesTtl').value = formatCurrency(totalpentalties);
        d.getElementById('frm1604e:txtSched1TotRemAmtTtl').value = formatCurrency(totalamountremitted);

    } 

