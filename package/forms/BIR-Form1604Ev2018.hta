	function enableSaveButton(){
	
		if(d.getElementById("frm1604e:txtYear").value.length == 0 || d.getElementById("frm1604e:txtYear").value.length == '' || (d.getElementById('frm1604e:txtTIN1').value == "" || d.getElementById('frm1604e:txtTIN2').value == "" || d.getElementById('frm1604e:txtTIN3').value == "" || d.getElementById('frm1604e:txtBranchCode').value == "")  ){
			d.getElementById("btnSave").disabled = true;
			
		} else {
			d.getElementById("btnSave").disabled = false;
			
		} 

		
	}

