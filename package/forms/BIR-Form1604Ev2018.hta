    function openAlertEmail() {       
        var tinNumber = $('#frm1604e\\:txtTIN1').val() + $('#frm1604e\\:txtTIN2').val() + $('#frm1604e\\:txtTIN3').val();
        conService.initConConfig(tinNumber, '1604Ev2018');

