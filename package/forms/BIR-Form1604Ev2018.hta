    function validateScheduleFields(x, i){
        
        if (d.getElementById('frm1604e:txtSched'+x+'RemDate'+i).value == ""){
            if (d.getElementById('frm1604e:txtSched'+x+'BankCode'+i).value != ""){
                return "Q1-1";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'TRANo'+i).value != ""){
                return "Q1-1";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'TaxWithheld'+i).value != "0.00"){
                return "Q1-1";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'Penalties'+i).value != "0.00"){
                return "Q1-1";
            }
            return true;
        }

        if (d.getElementById('frm1604e:txtSched'+x+'BankCode'+i).value == ""){
            if (d.getElementById('frm1604e:txtSched'+x+'RemDate'+i).value != ""){
                return "Q1-2";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'TRANo'+i).value != ""){
                return "Q1-2";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'TaxWithheld'+i).value != "0.00"){
                return "Q1-2";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'Penalties'+i).value != "0.00"){
                return "Q1-2";
            }
            return true;
        }

        if (d.getElementById('frm1604e:txtSched'+x+'TRANo'+i).value == ""){
            if (d.getElementById('frm1604e:txtSched'+x+'RemDate'+i).value != ""){
                return "Q1-3";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'BankCode'+i).value != ""){
                return "Q1-3";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'TaxWithheld'+i).value != "0.00"){
                return "Q1-3";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'Penalties'+i).value != "0.00"){
                return "Q1-3";
            }
            return true;
        }

        if (d.getElementById('frm1604e:txtSched'+x+'TaxWithheld'+i).value == "0.00") {
            if (d.getElementById('frm1604e:txtSched'+x+'RemDate'+i).value != ""){
                return "Q1-4";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'BankCode'+i).value != ""){
                return "Q1-4";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'TRANo'+i).value != ""){
                return "Q1-4";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'Penalties'+i).value == "0.00"){
                return "Q1-4";
            }
        }

        // if (d.getElementById('frm1604e:txtSched'+x+'Penalties'+i).value == "0.00") {  
        //     if (d.getElementById('frm1604e:txtSched'+x+'RemDate'+i).value != ""){
        //         return "Q1-5";
        //     }
        //     if (d.getElementById('frm1604e:txtSched'+x+'BankCode'+i).value != ""){
        //         return "Q1-5";
        //     }
        //     if (d.getElementById('frm1604e:txtSched'+x+'TRANo'+i).value != ""){
        //         return "Q1-5";
        //     }
        //     if (d.getElementById('frm1604e:txtSched'+x+'TaxWithheld'+i).value != "0.00"){
        //         return "Q1-5";
        //     }
        // }

        // if (d.getElementById('frm1604e:txtSched'+x+'TaxWithheld'+i).value != "0.00"){
        //     return true;
        // } else if (d.getElementById('frm1604e:txtSched'+x+'TaxWithheld'+i).value != "0.00") {
        //     if (d.getElementById('frm1604e:txtSched'+x+'RemDate'+i).value != ""){
        //         return "Q1-4";
        //     }
        //     if (d.getElementById('frm1604e:txtSched'+x+'BankCode'+i).value != ""){
        //         return "Q1-4";
        //     }
        //     if (d.getElementById('frm1604e:txtSched'+x+'TRANo'+i).value != ""){
        //         return "Q1-4";
        //     }
        //     if (d.getElementById('frm1604e:txtSched'+x+'Penalties'+i).value == "0.00"){
        //         return "Q1-4";
        //     }
        // }

        if (d.getElementById('frm1604e:txtSched'+x+'Penalties'+i).value != "0.00"){
            return true;
        }  else if (d.getElementById('frm1604e:txtSched'+x+'Penalties'+i).value != "0.00") {  
            if (d.getElementById('frm1604e:txtSched'+x+'RemDate'+i).value != ""){
                return "Q1-5";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'BankCode'+i).value != ""){
                return "Q1-5";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'TRANo'+i).value != ""){
                return "Q1-5";
            }
            if (d.getElementById('frm1604e:txtSched'+x+'TaxWithheld'+i).value != "0.00"){
                return "Q1-5";
            }
        }
    }

