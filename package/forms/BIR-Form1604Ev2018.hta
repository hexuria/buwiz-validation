    function validate() {
        // var dt = new Date();
        // var year =  parseInt(d.getElementById("frm1604e:txtYear").value);
       
	 
		
        if(d.getElementById("frm1604e:txtYear").value.length ==0){
            alert("Please enter a valid year on Item 1.");
            d.getElementById('frm1604e:txtYear').focus();
            return;
        }  

        if( (d.getElementById('frm1604e:txtTIN1').value == "" || d.getElementById('frm1604e:txtTIN2').value == "" || d.getElementById('frm1604e:txtTIN3').value == "" || d.getElementById('frm1604e:txtBranchCode').value == "")  )
        {
            alert("Please enter a valid TIN number on Item 4.");
            return;
        }       

        if( (d.getElementById('frm1604e:txtRDOCode').value == "")  )
        {
            alert("Please enter a valid RDO Code on Item 5.");
            return;
        }       
    
        if( (d.getElementById('frm1604e:txtWthhldngAgntsNme').value == "")  )
        {
            alert("Please enter a valid Taxpayer Name on Item 6.");
            return;
        }
        if( (d.getElementById('frm1604e:txtTelNum').value == "")  )
        {
            alert("Please enter a valid Telephone Number on Item 9.");
            return;
        }
        if( (d.getElementById('frm1604e:txtAddress').value == "")  )
        {
            alert("Please enter Taxpayer's Registered Address on Item 7.");
            return;
        }           
        if( (d.getElementById('frm1604e:txtZipCode').value == "")  )
        {
            alert("Please enter Taxpayer's Zip Code on Item 7A.");
            return;
        }
        if (d.getElementById('frm1604e:WthldngAgntCtgry_1').checked == false && d.getElementById('frm1604e:WthldngAgntCtgry_2').checked == false) {
            alert("Please select an option in Item 8.");
            return;
        }

        // SCHEDULE 1 Validation
        var valid = validateSchedule1();
        if (valid != true){
            return;
        }

        // SCHEDULE 2 Validation
        var valid = validateSchedule2();
        if (valid != true){
            return;
        }

        disableAllControl();

        alert("Validation successful. Click on 'Edit' if you wish to modify your entries.");
        return;
    }

